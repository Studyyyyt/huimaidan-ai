# 惠买单后端本地开发镜像（macOS ARM64 兼容）
# 基于 PHP 7.3 + Swoole 4.5，加载 swoole_loader73 以解密 CRMEB 加密代码

FROM --platform=linux/amd64 phpswoole/swoole:4.5.11-php7.3

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Debian buster 已归档，需切换源
RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list \
    && sed -i 's|http://security.debian.org/debian-security|http://archive.debian.org/debian-security|g' /etc/apt/sources.list \
    && apt-get update -o Acquire::Check-Valid-Until=false

# 安装系统依赖和 PHP 扩展
RUN apt-get update && apt-get install -y --no-install-recommends \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libpng-dev \
    libzip-dev \
    libwebp-dev \
    unzip \
    git \
    libssl-dev \
    && docker-php-ext-configure gd --with-freetype-dir=/usr --with-jpeg-dir=/usr --with-png-dir=/usr --with-webp-dir=/usr \
    && docker-php-ext-install -j$(nproc) gd pdo_mysql mysqli zip bcmath pcntl \
    && pecl install redis-5.3.7 \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

# 安装 Composer
COPY --from=composer:2.2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1

# 复制 swoole_loader73 解密扩展
COPY install/swoole-loader/swoole_loader73.so /usr/local/lib/php/extensions/no-debug-non-zts-20180731/swoole_loader73.so
RUN echo "extension=swoole_loader73.so" > /usr/local/etc/php/conf.d/99-swoole-loader.ini

# 工作目录
WORKDIR /var/www

# 暴露 Swoole 服务端口
EXPOSE 8324

# 启动 Swoole 服务（docker-compose 会覆盖 command，这里作为默认值）
CMD ["php", "think", "swoole", "start"]
