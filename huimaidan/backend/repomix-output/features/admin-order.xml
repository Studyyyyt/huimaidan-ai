1399:     /**
1400:      *  修改订单价格
1401:      * @param int $id
1402:      * @param array $data
1403:      * @author Qinii
1404:      * @day 12/15/20
1405:      */
1406:     public function eidt(int $id, array $data, $service_id = 0)
1407:     {
1408: 
1409:         /**
1410:          * 1 计算出新的实际支付价格
1411:          *      1.1 计算邮费
1412:          *      1.2 计算商品总价
1413:          * 2 修改订单信息
1414:          * 3 计算总单数据
1415:          * 4 修改总单数据
1416:          * 5 修改订单商品单价
1417:          *
1418:          * pay_price = total_price - coupon_price + pay_postage
1419:          */
1420:         $order = $this->dao->get($id);
1421:         if ($order->activity_type == 2) {
1422:             throw new ValidateException('预售订单不支持改价');
1423:         }
1424:         $extension_total = (float)bcadd($order->extension_one, $order->extension_two, 2);
1425:         $data['pay_price'] = $this->bcmathPrice($data['total_price'], $order['coupon_price'], $data['pay_postage']);
1426:         if ($data['pay_price'] < 0) {
1427:             throw new ValidateException('实际支付金额不能小于0');
1428:         } else if ($data['pay_price'] < $extension_total) {
1429:             throw new ValidateException('实际支付金额不能小于佣金' . $extension_total);
1430:         }
1431:         $make = app()->make(StoreGroupOrderRepository::class);
1432:         $orderGroup = $make->dao->getWhere(['group_order_id' => $order['group_order_id']]);
1433: 
1434:         //总单总价格
1435:         $_group['total_price'] = $this->bcmathPrice($orderGroup['total_price'], $order['total_price'], $data['total_price']);
1436:         //总单实际支付价格
1437:         $_group['pay_price'] = $this->bcmathPrice($orderGroup['pay_price'], $order['pay_price'], $data['pay_price']);
1438:         //总单实际支付邮费
1439:         $_group['pay_postage'] = $this->bcmathPrice($orderGroup['pay_postage'], $order['pay_postage'], $data['pay_postage']);
1440:         //计算赠送积分
1441:         $data['give_integral'] = $_group['give_integral'] = $this->recalculateGiveIntegral($order, $_group['pay_price']);
1442:         event('order.changePrice.before', compact('order', 'data'));
1443:         //订单记录
1444:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
1445: 
1446:         $orderStatus = [
1447:             'order_id' => $order->order_id,
1448:             'order_sn' => $order->order_sn,
1449:             'type' => $storeOrderStatusRepository::TYPE_ORDER,
1450:             'change_message' => '订单价格:' . $order['pay_price'] . '修改为:' . $data['pay_price'],
1451:             'change_type' => $storeOrderStatusRepository::ORDER_STATUS_CHANGE,
1452:         ];
1453: 
1454:         Db::transaction(function () use ($id, $data, $orderGroup, $order, $_group, $storeOrderStatusRepository, $orderStatus, $service_id) {
1455:             $orderGroup->total_price = $_group['total_price'];
1456:             $orderGroup->pay_price = $_group['pay_price'];
1457:             $orderGroup->pay_postage = $_group['pay_postage'];
1458:             $orderGroup->give_integral = $_group['give_integral'];
1459:             $orderGroup->group_order_sn = $this->getNewOrderId(StoreOrderRepository::TYPE_SN_ORDER) . '0';
1460:             $orderGroup->save();
1461: 
1462:             $this->dao->update($id, $data);
1463:             $this->changOrderProduct($id, $data);
1464: 
1465:             if ($service_id) {
1466:                 $storeOrderStatusRepository->createServiceLog($service_id, $orderStatus);
1467:             } else {
1468:                 $storeOrderStatusRepository->createAdminLog($orderStatus);
1469:             }
1470:             if ($data['pay_price'] != $order['pay_price']) Queue::push(SendSmsJob::class, ['tempId' => 'PRICE_REVISION_CODE', 'id' => $id]);
1471:         });
1472:         event('order.changePrice', compact('order', 'data'));
1473:     }
