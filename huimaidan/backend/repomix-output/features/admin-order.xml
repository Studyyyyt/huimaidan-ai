 75:         // 执行分页查询，并附加指定的字段，返回查询结果。
 76:         $list = $query->page($page, $limit)->append($append)->select();
 77: 
 78:         // 返回数据列表和总条数的组合。
 79:         return compact('list', 'count');
 80:     }
 81: 
 82:     /**
 83:      * 计算并处理退款金额
 84:      *
 85:      * 此方法用于根据退款订单、原价格和商家退款金额，执行具体的退款金额计算和处理逻辑。
 86:      * 它调用了另一个方法`refundPresallPrice`来实现这一功能。
 87:      *
 88:      * @param StoreRefundOrder $refundOrder 退款订单对象，包含退款订单的相关信息。
 89:      * @param float $price 原价格，即商品的原始购买价格。
 90:      * @param float $refundMerPrice 商家退款金额，即商家实际退还给用户的金额。
 91:      */
 92:     public function refundPrice(StoreRefundOrder $refundOrder, $price, $refundMerPrice)
 93:     {
 94:         // 调用退款预计算方法，进行退款金额的计算和处理。
 95:         $this->refundPresallPrice($refundOrder, $price, $refundMerPrice, true);
 96:     }
 97: 
 98:     /**
 99:      * 根据预售订单或普通订单类型，进行退款分账处理。
100:      * 此函数主要用于处理订单退款时的分账逻辑，根据订单类型的不同，退款金额将被相应地添加到分账退款金额中，
101:      * 并相应地更新商户的分账金额。如果退款金额超过了原始的分账金额，将标记分账订单状态为无效。
102:      *
103:      * @param StoreRefundOrder $refundOrder 退款订单对象，包含相关的订单信息。
104:      * @param float $price 用户退款的金额，用于更新分账退款金额。
105:      * @param float $refundMerPrice 商户退款的金额，用于更新商户的分账金额。
106:      * @param bool $order 指示当前处理的是普通订单还是预售订单，默认为false表示预售订单。
107:      * @throws ValidateException 如果找不到相应的分账订单，则抛出异常。
108:      */
109:     public function refundPresallPrice(StoreRefundOrder $refundOrder, $price, $refundMerPrice, $order = false)
110:     {
111:         // 根据订单类型选择正确的分账订单模型
112:         $model = $order ? $refundOrder->order->firstProfitsharing : $refundOrder->order->presellProfitsharing;
113: 
114:         // 如果找不到对应的分账订单模型，则抛出异常
115:         if (!$model)
116:             throw new ValidateException('分账订单不存在');
117: 
118:         // 更新分账订单的退款金额和商户退款金额
119:         $model->profitsharing_refund = bcadd($model->profitsharing_refund, $price, 2);
120:         $model->profitsharing_mer_price = bcsub($model->profitsharing_mer_price, $refundMerPrice, 2);
121: 
122:         // 如果分账退款金额大于等于原始分账金额，则将分账订单状态设置为无效
123:         if ($model->profitsharing_refund >= $model->profitsharing_price) {
124:             $model->status = -1;
125:         }
126: 
127:         // 保存更新后的分账订单信息
128:         $model->save();
129:     }
130: 
131:     /**
132:      * 分享利润订单处理函数
133:      *
134:      * 本函数用于处理店铺订单的利润分享。它遍历订单中的每个利润分享项，
135:      * 并调用利润分享功能来处理这些分享项。
136:      *
137:      * @param StoreOrder $storeOrder 包含利润分享信息的店铺订单对象。
138:      */
139:     public function profitsharingOrder(StoreOrder $storeOrder)
140:     {
141:         // 遍历订单中的每个利润分享项，并进行处理
142:         foreach ($storeOrder->profitsharing as $profitsharing) {
143:             $this->profitsharing($profitsharing);
144:         }
145:     }
146: 
147:     /**
148:      * 分享利润处理函数
149:      * 该函数用于处理店铺订单的利润分享操作。根据利润分享金额和商家分成金额的比较，决定是发起利润分享订单还是结束利润分享订单。
150:      *
151:      * @param StoreOrderProfitsharing $profitsharing 利润分享对象，包含利润分享的相关信息。
152:      * @return bool 返回操作是否成功的标志。成功返回true，失败返回false。
153:      */
154:     public function profitsharing(StoreOrderProfitsharing $profitsharing)
155:     {
156:         // 初始化状态变量
157:         $status = 2;
158:         $error_msg = '';
159:         $flag = true;
160: 
161:         if ($profitsharing->is_combine == 2) {
162:             $server = new Pay('partner');
163:         } else {
164:             $server = WechatService::create()->combinePay();
165:         }
166:         try {
167:             // 判断利润分享金额是否大于商家分成金额
168:             if (bcsub($profitsharing->profitsharing_price, $profitsharing->profitsharing_mer_price, 2) > 0) {
169:                 // 分账并解冻
170:                 $res = $server->profitsharingOrder($profitsharing->getProfitsharingParmas($profitsharing->is_combine), true);
171:             } else {
172:                 // 直接解冻
173:                 $res = $server->profitsharingFinishOrder($profitsharing->getProfitsharingFinishParmas($profitsharing->is_combine));
174:             }
175:             // 更新利润分账时间
176:             $profitsharing->profitsharing_time = date('Y-m-d H:i:s');
177:             $status = 1;
178:         } catch (\Exception $e) {
179:             // 捕获异常，更新状态变量为失败
180:             $status = -2;
181:             $error_msg = $e->getMessage();
182:             $flag = false;
183:         }
184: 
185:         // 更新利润分享对象的状态和错误信息
186:         $profitsharing->status = $status;
187:         $profitsharing->error_msg = $error_msg;
188:         // 保存更新后的利润分享对象
189:         $profitsharing->save();
190: 
191:         return $flag;
192:     }
193: 
194:     public function profitsharingStatus(StoreOrderProfitsharing $profitsharing)
195:     {
196:         if ($profitsharing->is_combine == 1)
197:             return ;
198:         $options = [
199:             'sub_mchid' => $profitsharing->merchant->applyment_id,
200:             'out_order_no' => $profitsharing->profitsharing_sn,
201:             'transaction_id' => $profitsharing->transaction_id,
202:         ];
203:         $services = new Pay('partner');
204:         $res = $services->profitsharingStatus($options);
205:         if (isset($res['state']) && $res['state'] == 'FINISHED') {
206:             if (isset($res['receivers'][0])) {
207:                 $profitsharing->profitsharing_time = $res['receivers'][0]['finish_time'];
208:                 $profitsharing->profitsharing_mer_price = ($res['receivers'][0]['amount'] / 100);
209:             }
210:             $profitsharing->status = 1;
211:             $profitsharing->save();
212:         }
213:     }
214: 
215: }
