3855:         // 判断订单状态是否为待派单或待服务
3856:         if(!in_array($order->status,[OrderStatus::ORDER_STATUS_PENDING_SHIPMENT, OrderStatus::ORDER_STATUS_PENDING_RECEIPT])){
3857:             throw new ValidateException('订单状态异常，请检查');
