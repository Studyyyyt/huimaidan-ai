384:     public function batchUpdatePrice(array $params)
385:     {
386:         $cartList = $this->dao->cartIbByData($params['cart_ids'], $params['uid'], null)->where('mer_id', $params['merId'])->append(['checkCartProduct', 'UserPayCount', 'ActiveSku','spu']);
387: 
388:         try {
389:             Db::transaction(function () use ($cartList, $params) {
390:                 $make = app()->make(StoreCartPriceDao::class);
391: 
392:                 [$newPayPrice, $changeFeeRate, $updatePriceFlag] = $this->getNewPayPrice($params);
393:                 $remainingPrice = $newPayPrice;
394:                 $productPrice = 0;
395: 
396:                 foreach ($cartList as $key => $item) {
397:                     // 整单改价后，给每个商品分摊改价后金额，最后一个商品使用剩余金额
398:                     $cartNum = $item['cart_num'];
399:                     $oldPrice = $productPrice = (float)bcmul($item['productAttr']['price'], $cartNum, 2);
400:                     if ($updatePriceFlag && $changeFeeRate != 1) {
401:                         if ((count($cartList) == $key + 1)) {
402:                             $newPrice = $remainingPrice;
403:                         } else {
404:                             $newPrice = (float)bcmul($productPrice, $changeFeeRate, 2);
405:                             $remainingPrice = max((float)bcsub($remainingPrice, $newPrice, 2), 0);
406:                         }
407:                     }
408: 
409:                     if($params['change_fee_type'] == 1) {
410:                         $reducePrice = bcsub($oldPrice, $newPrice, 2);
411:                     }
412: 
413:                     $cartId = $item['cart_id'];
414:                     $data['cart_id'] = $item['cart_id'];
415:                     $data['old_price'] = $oldPrice;
416:                     $data['type'] = $params['change_fee_type'];
417:                     $data['reduce_price'] = isset($reducePrice) ? $reducePrice : 0;
418:                     $data['discount_rate'] = $params['discount_rate'] ?? 0;
419:                     $data['new_price'] = $newPrice;
420:                     $data['is_batch'] = 1;
421:                     $data['update_time'] = date('Y-m-d H:i:s', time());
422: 
423:                     if($info = $make->getCartPriceInfo($cartId)) {
424:                         if($info['is_batch'] == 0) {
425:                             throw new ValidateException('已经存在单商品改价信息，不能再次整单改价, cart_id: ' . $cartId);
426:                         }
427: 
428:                         $res = $make->edit($info['cart_price_id'], $cartId, $data, true);
429:                         if(!$res) {
430:                             throw new ValidateException('更新购物车改价信息失败, cart_id: ' . $cartId);
431:                         }
432:                         continue;
433:                     }
434:                     $res = $make->add($cartId, $data, true);
435:                     if(!$res) {
436:                         throw new ValidateException('添加购物车改价信息失败, cart_id: ' . $cartId);
437:                     }
438:                 }
439:             });
440:         } catch (ValidateException $e) {
441:             throw new ValidateException($e->getMessage());
442:         }
443: 
444:         return true;
445:     }
446:     /**
447:      * 计算整单改价后的价格
448:      *
449:      * @param array $data
450:      * @return float
451:      */
452:     private function getNewPayPrice(array $data) : array
453:     {
454:         $updatePriceFlag = 0;
455:         // 判断是否改价了，如果没有改价，则返回默认值
456:         if(!isset($data['change_fee_type']) || $data['change_fee_type'] === '') {
457:             return [0, 1, $updatePriceFlag];
458:         }
459: 
460:         $newPayPrice = $data['new_pay_price'] ?? 0;
461:         if($data['change_fee_type'] == 1){ // 立减
462:             $newPayPrice = bcsub($data['old_pay_price'], $data['reduce_price'], 2);
463:         }
464:         if($data['change_fee_type'] == 2){ // 折扣
465:             $newPayPrice = bcmul($data['old_pay_price'], $data['discount_rate']/100, 4);
466:         }
467:         $changeFeeRate = bcdiv($newPayPrice, $data['old_pay_price'], 4);
468:         $updatePriceFlag = 1;
469: 
470:         return [(float)$newPayPrice, (float)$changeFeeRate, $updatePriceFlag];
471:     }
472: }
