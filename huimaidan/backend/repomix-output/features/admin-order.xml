 240:     /**
 241:      * 生成并验证验证码
 242:      *
 243:      * 本函数用于生成一个唯一的验证码，并检查这个验证码是否已经存在。
 244:      * 如果验证码已存在，将重新生成并检查，确保返回的验证码是唯一的。
 245:      * 这种方法可以避免验证码被重复使用，提高系统的安全性。
 246:      *
 247:      * @return string 唯一的验证码
 248:      */
 249:     public function verifyCode()
 250:     {
 251:         // 生成一个唯一的验证码字符串
 252:         $code = substr(uniqid('', true), 15) . substr(microtime(), 2, 8);
 253: 
 254:         // 检查生成的验证码是否已存在于数据库中
 255:         if ($this->dao->existsWhere(['verify_code' => $code])) {
 256:             // 如果验证码已存在，则重新生成验证码
 257:             return $this->verifyCode();
 258:         } else {
 259:             // 如果验证码不存在，则返回该验证码
 260:             return $code;
 261:         }
 262:     }
