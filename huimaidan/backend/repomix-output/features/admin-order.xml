 11: namespace app\common\repositories\store\order;
 12: 
 13: use think\facade\Db;
 14: use think\facade\Cache;
 15: use think\facade\Queue;
 16: use crmeb\jobs\SendSmsJob;
 17: use crmeb\services\PayStatusService;
 18: use crmeb\services\SwooleTaskService;
 19: use think\exception\ValidateException;
 20: use app\common\repositories\system\RecordRepository;
 21: use app\common\repositories\system\merchant\MerchantRepository;
 22: use app\common\repositories\store\coupon\StoreCouponUserRepository;
 23: use app\common\repositories\store\product\{
 24:     ProductAttrValueRepository,
 25:     ProductRepository
 26: };
 27: use app\common\repositories\user\{
 28:     UserAddressRepository,
 29:     UserBillRepository,
 30:     UserRepository
 31: };
 32: 
 33: class MerchantOrderCreateRepository extends StoreOrderRepository
 34: {
 35:     use MerchantOrderTrait;
 36: 
 37:     const CACHE_KEY = 'order_create_cache';
 38: 
 39:     private function getUserRepository(): UserRepository
 40:     {
 41:         return app()->make(UserRepository::class);
 42:     }
 43:     private function getUserAddressRepository(): UserAddressRepository
 44:     {
 45:         return app()->make(UserAddressRepository::class);
 46:     }
 47:     private function getStoreCartRepository(): StoreCartRepository
 48:     {
 49:         return app()->make(StoreCartRepository::class);
 50:     }
 51:     private function getStoreCouponUserRepository(): StoreCouponUserRepository
 52:     {
 53:         return app()->make(StoreCouponUserRepository::class);
 54:     }
 55:     private function getMerchantRepository(): MerchantRepository
 56:     {
 57:         return app()->make(MerchantRepository::class);
 58:     }
 59:     private function getProductRepository(): ProductRepository
 60:     {
 61:         return app()->make(ProductRepository::class);
 62:     }
 63:     private function getProductAttrValueRepository(): ProductAttrValueRepository
 64:     {
 65:         return app()->make(ProductAttrValueRepository::class);
 66:     }
 67:     private function getStoreGroupOrderRepository(): StoreGroupOrderRepository
 68:     {
 69:         return app()->make(StoreGroupOrderRepository::class);
 70:     }
 71:     private function getUserBillRepository(): UserBillRepository
 72:     {
 73:         return app()->make(UserBillRepository::class);
 74:     }
 75:     private function getStoreOrderStatusRepository(): StoreOrderStatusRepository
 76:     {
 77:         return app()->make(StoreOrderStatusRepository::class);
 78:     }
 79:     private function getStoreOrderProductRepository(): StoreOrderProductRepository
 80:     {
 81:         return app()->make(StoreOrderProductRepository::class);
 82:     }
 83:     private function getRecordRepository(): RecordRepository
 84:     {
 85:         return app()->make(RecordRepository::class);
 86:     }
 87:     public function merchantInfo($merId)
 88:     {
 89:         $merchant = $this->getMerchantRepository()->get($merId);
 90:         if (!$merchant) {
 91:             throw new ValidateException('商家不存在');
 92:         }
 93:         return $merchant;
 94:     }
 95:     /**
 96:      * 检查订单
 97:      *
 98:      * @return array
 99:      */
100:     public function checkOrder(array $params): ?array
101:     {
102:         $result = [];
103:         $uid = $params['uid'];
104:         $key = md5(json_encode($params)) . $uid;
105:         // 校验用户信息
106:         $user = $this->validUser($uid);
107:         $svipStatus = (isset($user) && $user['is_svip'] > 0 && systemConfig('svip_switch_status') == '1');
108:         $userIntegral = $user['integral'] ?? 0;
109:         // 校验地址信息
110:         $address = $this->validAddress($params['address_id'], $uid);
111:         // 校验购物车信息
112:         $cartList = $this->validCartList($user, $params['merId'], $params['cart_ids'], $address);
113:         // 获取优惠券信息
114:         $userCoupons = $this->fetchUserCoupons($uid, $params['merId']);
115:         // 处理运费模板
116:         $cartProductShippingFeeTemplate = $this->template(array_column(array_column($cartList, 'product'), 'temp'));
117: 
118:         $result['totalCartNum'] = 0;
119:         $result['totalPaymentPrice'] = 0;
120:         $result['totalOriginalPrice'] = 0;
121:         $result['updatedPriceFlag'] = 0;
122:         $result['discountDetail']['updatedDiscountAmount'] = 0;
123:         $result['discountDetail']['vipDiscountAmount'] = 0;
124:         foreach ($cartList as &$value) {
125:             $cartNum = $value['cart_num'];
126:             $value['productAttr']['org_price'] = $value['productAttr']['price'];
127:             $value['productAttr']['show_svip_price'] = false;
128:             // 原价
129:             $value['totalAmount'] = (float)bcmul($value['productAttr']['price'], $cartNum, 2);
130:             // 改价后金额
131:             $updatedPriceFlag = (isset($value['productAttr']['new_price']) || isset($value['updatedTotalAmount'])) ? 1 : 0;
132:             if($updatedPriceFlag) {
133:                 $value['updatedTotalAmount'] = $value['is_batch'] ? (float)$value['updatedTotalAmount'] : (float)bcmul($value['productAttr']['new_price'], $cartNum, 2);
134:             }
135:             // 会员权益后的金额
136:             $value['vipTotalAmount'] = ($svipStatus && !$updatedPriceFlag) ? (float)bcmul($value['productAttr']['svip_price'], $cartNum, 2) : 0;
137:             $value['productAttr']['show_svip_price'] = ($svipStatus && !$updatedPriceFlag) ? true : false;
138:             // 是否使用会员权益
139:             $value['useSvip'] = ($value['vipTotalAmount'] != 0) ? 1 : 0;
140:             // 实付价格：优先取改价后金额，若无改价后金额则取会员权益后的总金额，若无会员权益后的总金额则取原价
141:             $value['paymentPrice'] = ($updatedPriceFlag) ? $value['updatedTotalAmount'] : current(array_filter([$value['updatedTotalAmount'], $value['vipTotalAmount'], $value['totalAmount']]));
142:             // 计算优惠金额
143:             $value['updatedDiscountAmount'] = ($updatedPriceFlag) ? (float)bcsub($value['totalAmount'], $value['updatedTotalAmount'], 2) : 0;
144:             $value['vipDiscountAmount'] = (!$updatedPriceFlag && $value['vipTotalAmount'] != 0) ? (float)bcsub($value['totalAmount'], $value['vipTotalAmount'], 2) : 0;
145:             // 不免运费且为快递配送，则计算该商品的运费。【is_free_shipping : 0 不免运费，1 免运费】【delivery_way : 0 快递，1 自提】
146:             if ($params['is_free_shipping'] == 0 && $params['delivery_way'] == 0) {
147:                 $shippingFeeTemplate = $value['product']['temp'] ? $value['product']['temp']->toArray() : null;
148:                 // 判断是否符合免运费条件,free为空说明不免费，则计算运费
149:                 if ($shippingFeeTemplate && empty($shippingFeeTemplate['free'])) {
150:                     $cartProductShippingFeeTemplate[$value['product']['temp_id']]['aggregate'] += $this->productByTempNumber($value);
151:                 }
152:             }
153: 
154:             $value['productAttr']['price'] = current(array_filter([$value['productAttr']['new_price'], $value['productAttr']['new_batch_price'], $value['productAttr']['svip_price'], $value['productAttr']['price']]));
155:             $result['totalCartNum'] += $cartNum;
156:             // 原价总金额
157:             $result['totalOriginalPrice'] += $value['totalAmount'];
158:             $result['totalPaymentPrice'] += $value['paymentPrice'];
159:             $result['discountDetail']['updatedDiscountAmount'] += $value['updatedDiscountAmount'];
160:             $result['discountDetail']['vipDiscountAmount'] += $value['vipDiscountAmount'];
161:         }
162: 
163:         // 判断改价，单商品改价标记为1，整单改价标记为2
164:         $cartUpdatePrice = array_column($cartList, 'is_batch');
165:         if($cartUpdatePrice) {
166:             $result['updatedPriceFlag'] = (in_array(0, $cartUpdatePrice)) ? 1 : 2;
167:         }
168:         $result['totalPrice'] = $result['totalPaymentPrice'];
169:         // 计算优惠券
170:         $result = $this->calculateCoupon($result, $cartList, $userCoupons, $params['merId'], $params['use_coupon'], $user);
171:         // 计算积分
172:         $result = $this->calculateIntegral($result, $cartList, $params['merId'], $params['use_integral'], $userIntegral);
173:         // 计算运费
174:         $result['totalShippingAmount'] = $address ? (float)$this->calculateShippingCost($cartProductShippingFeeTemplate) : 0;
175:         // 总优惠金额
176:         $result['totalDiscountAmount'] = array_sum($result['discountDetail']);
177:         // 支付总金额：实付总金额 + 运费
178:         $result['totalPaymentPrice'] = (float)bcadd($result['totalPaymentPrice'], $result['totalShippingAmount'], 2);
179:         $result['key'] = $key;
180:         $result['carts'] = $cartList;
181:         $result['address'] = $address;
182: 
183:         Cache::set(self::CACHE_KEY . $uid . '_' . $key, $result, 600);
184:         return $result;
185:     }
186:     /**
187:      * 创建订单
188:      *
189:      * @param array $params
190:      * @return void
191:      */
192:     public function createOrder(array $params)
193:     {
194:         $uid = $params['uid'];
195:         $cacheKey = self::CACHE_KEY . $uid . '_' . $params['key'];
196:         $orderInfo = Cache::get($cacheKey);
197:         if (!$orderInfo) {
198:             throw new ValidateException('订单操作超时,请刷新页面');
199:         }
200:         // 验证价格
201:         if ($params['old_pay_price'] != $orderInfo['totalPaymentPrice']) {
202:             throw new ValidateException('支付金额异常，参数信息与缓存不一致');
203:         }
204:         if ($orderInfo['totalPaymentPrice'] > 1000000) {
205:             throw new ValidateException('支付金额超出最大限制');
206:         }
207:         // 组装优惠ids, 验证use_coupon
208:         $usedCouponIds = [];
209:         $usedCoupons = isset($orderInfo['usedCoupons']) ? $orderInfo['usedCoupons'] : [];
210:         foreach ($usedCoupons as $value) {
211:             $usedCouponIds = array_unique(array_merge($usedCouponIds, array_column($value, 'id')));
212:         }
213:         // 验证address
214:         $address = $orderInfo['address'];
215:         if(!$address && $params['address_id']) {
216:             $address = $this->validAddress($params['address_id'], $uid);
217:         }
218:         $userAddress = isset($address) ? ($address['province'] . $address['city'] . $address['district'] . $address['street'] . $address['detail']) : '';
219:         // 计算成本金额
220:         $cost = 0;
221:         foreach ($orderInfo['carts'] as $cart) {
222:             $cost += bcmul($cart['productAttr']['cost'], $cart['cart_num']);
223:         }
224:         // 订单数据
225:         $groupOrder = [
226:             'uid' => $uid,
227:             'group_order_sn' => ($this->getNewOrderId(StoreOrderRepository::TYPE_SN_ORDER) . '0'),
228:             'total_postage' => $orderInfo['totalShippingAmount'],
229:             'total_price' => $orderInfo['totalPrice'],
230:             'total_num' => $orderInfo['totalCartNum'],
231:             'real_name' => $address['real_name'] ?? '',
232:             'user_phone' => $address['phone'] ?? '',
233:             'user_address' => $userAddress,
234:             'pay_price' => $orderInfo['totalPaymentPrice'],
235:             'coupon_price' => $orderInfo['discountDetail']['couponsDiscountAmount'] ?? 0,
236:             'pay_postage' => $orderInfo['totalShippingAmount'],
237:             'cost' => $cost,
238:             'coupon_id' => (isset($orderInfo['usedCoupons']['platform'][0]['id']) ? $orderInfo['usedCoupons']['platform'][0]['id'] : 0),
239:             'pay_type' => array_search($params['pay_type'], MerchantOrderCreateRepository::PAY_TYPE),
240:             'integral' => $orderInfo['integral']['usedNum'] ?? 0,
241:             'integral_price' => $orderInfo['discountDetail']['integralDiscountAmount'] ?? 0,
242:             'is_behalf' => 1 // 代客下单订单标识
243:         ];
244:         // 子订单数据
245:         $order = [
246:             'order_sn' => ($this->getNewOrderId(StoreOrderRepository::TYPE_SN_ORDER) . '1'),
247:             'uid' => $uid,
248:             'real_name' => $address['real_name'] ?? '',
249:             'user_phone' => $address['phone'] ?? '',
250:             'user_address' => $userAddress,
251:             'cart_id' => implode(',', array_column($orderInfo['carts'], 'cart_id')),
252:             'total_num' => $orderInfo['totalCartNum'],
253:             'total_price' => $orderInfo['totalPrice'],
254:             'total_postage' => $orderInfo['totalShippingAmount'],
255:             'pay_price' => $orderInfo['totalPaymentPrice'],
256:             'pay_postage' => $orderInfo['totalShippingAmount'],
257:             'commission_rate' => $orderInfo['commission_switch'] ? $orderInfo['commission_rate'] : 0,
258:             'integral' => $orderInfo['integral']['usedNum'] ?? 0,
259:             'integral_price' => $orderInfo['discountDetail']['integralDiscountAmount'] ?? 0,
260:             'coupon_id' => implode(',', $usedCouponIds),
261:             'coupon_price' => $orderInfo['discountDetail']['couponsDiscountAmount'] ?? 0,
262:             'platform_coupon_price' => array_sum(array_column(isset($orderInfo['usedCoupons']['platform']) ? $orderInfo['usedCoupons']['platform'] : [], 'price')) ?? 0,
263:             'svip_discount' => $orderInfo['discountDetail']['vipDiscountAmount'] ?? 0,
264:             'order_type' => $params['delivery_way'] == 4 ? 1 : $params['delivery_way'], // 0:快递 1:自提 4:无需核销（前端融合在一个字段里，在此处拆分开）
265:             'behalf_no_verify' => $params['delivery_way'] == 4 ? 1: 0, // 代客下单订单是否无需核销
266:             'is_virtual' => 0,
267:             'mer_id' => $params['merId'],
268:             'mark' => $params['mark'],
269:             'cost' => $cost,
270:             'pay_type' => array_search($params['pay_type'], MerchantOrderCreateRepository::PAY_TYPE),
271:             'is_behalf' => 1 // 代客下单订单标识
272:         ];
273: 
274:         $carts = $orderInfo['carts'];
275:         $user = $this->validUser($uid);
276:         event('order.create.before', compact('groupOrder', 'order'));
277:         try {
278:             [$group, $storeOrder] = Db::transaction(function () use ($user, $params, $order, $groupOrder, $carts) {
279:                 $orderProduct = [];
280:                 $productRepository = $this->getProductRepository();
281:                 $productAttrValueRepository = $this->getProductAttrValueRepository();
282:                 // 1. 减库存,加销量,加使用积分抵扣金额总数 product_attr, attr_value,  product
283:                 $remainingPrice = $groupOrder['pay_price'];
284:                 foreach ($carts as $key => $cart) {
285:                     $productAttrValueRepository->descStock($cart['productAttr']['product_id'], $cart['productAttr']['unique'], $cart['cart_num']);
286:                     $productRepository->descStock($cart['product']['product_id'], $cart['cart_num']);
287:                     if ($cart['integral'] && $cart['integral']['use'] > 0) {
288:                         $productRepository->incIntegral($cart['product']['product_id'], $cart['integral']['use'], $cart['integral']['price']);
289:                     }
290:                     $orderProduct[] = [
291:                         'cart_id' => $cart['cart_id'],
292:                         'uid' => $user->uid ?? 0,
293:                         'product_id' => $cart['product_id'],
294:                         'total_price' => $cart['totalAmount'],
295:                         'product_price' => $cart['paymentPrice'],
296:                         'svip_discount' => $cart['vipTotalAmount'],
297:                         'cost' => $cart['productAttr']['cost'],
298:                         'coupon_price' => $cart['couponsDiscount'],
299:                         'platform_coupon_price' => $cart['platformCouponDiscountAmount'],
300:                         'product_sku' => $cart['productAttr']['unique'],
301:                         'product_num' => $cart['cart_num'],
302:                         'refund_num' => $cart['cart_num'],
303:                         'integral_price' => $cart['integral']['price'] ?? 0,
304:                         'integral' => $cart['integral']['use'] ?? 0,
305:                         'integral_total' => $cart['integral']['price'] ?? 0,
306:                         'product_type' => $cart['product_type'],
307:                         'cart_info' => json_encode($cart),
308:                         'refund_switch' => $cart['product']['refund_switch'],
309:                     ];
310:                 }
311:                 // 2. 修改购物车状态 store_cart
312:                 $cartIds = array_column($carts, 'cart_id');
313:                 $this->getStoreCartRepository()->updates($cartIds, ['is_pay' => 1]);
314:                 // 3. 使用优惠券 user_coupon
315:                 if (!empty($order['coupon_id'])) {
316:                     $this->getStoreCouponUserRepository()->updates(explode(',', $order['coupon_id']), [
317:                         'use_time' => date('Y-m-d H:i:s'),
318:                         'status' => 1
319:                     ]);
320:                 }
321:                 // 4. 主订单表 group_order
322:                 $groupOrder = $this->getStoreGroupOrderRepository()->create($groupOrder);
323:                 // 5. 生成账单记录，减积分 user, user_bill
324:                 if ($groupOrder['integral'] > 0) {
325:                     // 生成用户账单记录
326:                     $this->getUserBillRepository()->decBill($user['uid'], 'integral', 'deduction', [
327:                         'link_id' => $groupOrder['group_order_id'],
328:                         'status' => 1,
329:                         'title' => '购买商品',
330:                         'number' => $groupOrder['integral'],
331:                         'mark' => '购买商品使用积分抵扣' . floatval($groupOrder['integral_price']) . '元',
332:                         'balance' => $user->integral
333:                     ]);
334:                     // 减用户积分
335:                     $user->integral = bcsub($user->integral, $groupOrder['integral'], 0);
336:                     $user->save();
337:                 }
338:                 // 6. 子订单表 order
339:                 $order['group_order_id'] = $groupOrder->group_order_id;
340:                 $storeOrder = $this->dao->create($order);
341:                 // 7. 订单操作记录 order_status
342:                 $orderStatus[] = [
343:                     'order_id' => $storeOrder->order_id,
344:                     'order_sn' => $storeOrder->order_sn,
345:                     'type' => StoreOrderStatusRepository::TYPE_ORDER,
346:                     'change_message' => '订单生成',
347:                     'change_type' => StoreOrderStatusRepository::ORDER_STATUS_CREATE,
348:                     'uid' => $user->uid ?? 0,
349:                     'nickname' => $user->nickname ?? '游客',
350:                     'user_type' => StoreOrderStatusRepository::U_TYPE_USER,
351:                 ];
352:                 $this->getStoreOrderStatusRepository()->batchCreateLog($orderStatus);
353:                 // 8. 订单商品记录 order_product
354:                 foreach ($orderProduct as $key => &$value) {
355:                     $value['order_id'] = $storeOrder->order_id;
356:                     $value['postage_price'] = $key == 0 ? $groupOrder['total_postage'] : 0;
357:                 }
358:                 $this->getStoreOrderProductRepository()->insertAll($orderProduct);
359:                 // 9. 记录地址使用次数
360:                 if ($params['address_id']) {
361:                     $this->getRecordRepository()->addRecord(
362:                         RecordRepository::TYPE_ADDRESS_RECORD,
363:                         [
364:                             'address_id' => $params['address_id'],
365:                             'num' => 1
366:                         ]
367:                     );
368:                 }
369: 
370:                 event('order.create', compact('groupOrder'));
371:                 return [$groupOrder, $storeOrder];
372:             });
373:         } catch (\Exception $e) {
374:             throw new ValidateException($e->getMessage());
375:         };
376:         // 库存不足提醒商家
377:         foreach ($carts as $cart) {
378:             if (($cart['productAttr']['stock'] - $cart['cart_num']) < (int)merchantConfig($params['merId'], 'mer_store_stock')) {
379:                 SwooleTaskService::merchant(
380:                     'notice',
381:                     [
382:                         'type' => 'min_stock',
383:                         'data' => [
384:                             'title' => '库存不足',
385:                             'message' => $cart['product']['store_name'] . '(' . $cart['productAttr']['sku'] . ')库存不足',
386:                             'id' => $cart['product']['product_id']
387:                         ]
388:                     ],
389:                     $params['merId']
390:                 );
391:             }
392:         }
393:         // 通知
394:         Queue::push(SendSmsJob::class, ['tempId' => 'ORDER_CREATE', 'id' => $group->group_order_id]);
395:         // 自动打印订单
396:         $this->autoPrinter($storeOrder->order_id, $params['merId'], 2);
397:         Cache::delete($cacheKey);
398: 
399:         return $group;
400:     }
401:     /**
402:      * 支付
403:      * alipayQr 支付宝二维码支付
404:      * weixinQr 微信二维码支付
405:      * balance 余额支付
406:      * weixinBarCode 微信扫码枪支付
407:      * alipayBarCode 支付宝扫码枪支付
