 412:      * @email 442384644@qq.com
 413:      * @date 2024/7/16
 414:      */
 415:     public function searchAll(array $where, $sysDel = 0, $is_points = null)
 416:     {
 417:         $query = StoreOrder::getDB()->alias('StoreOrder');
 418:         $query->when(($sysDel !== null), function ($query) use ($sysDel) {
 419:             $query->where('is_system_del', $sysDel);
 420:         });
 421:         $query->when(!is_null($is_points), function ($query) use ($is_points) {
 422:             if ($is_points) {
 423:                 $query->where('activity_type', 20);
 424:             } else {
 425:                 $query->where('activity_type', '<>', 20);
 426:             }
 427:         });
 428:         $query->when(isset($where['order_type']) && $where['order_type'] >= 0 && $where['order_type'] !== '', function ($query) use ($where) {
 429:             if ($where['order_type'] == 2) {
 430:                 $query->where('is_virtual', 1);
 431:             } else if ($where['order_type'] == 0) { //实体发货订单
 432:                 $query->where('order_type', 0)->where('is_virtual', 0);
 433:             } else if ($where['order_type'] == 3) { //发货订单
 434:                 $query->where('order_type', 0);
 435:             } else {
 436:                 $query->where('order_type', $where['order_type']);
 437:             }
 438:         });
 439:         // 分组权限
 440:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
 441:             $query->whereIn('StoreOrder.mer_id', $region);
 442:         }
 443:         $query->when(isset($where['activity_type']) && $where['activity_type'] !== '', function ($query) use ($where) {
 444:             $query->where('activity_type', $where['activity_type']);
 445:         })
 446:             ->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
 447:                 switch ($where['status']) {
 448:                     case 0 :
 449:                         $query->whereIn('StoreOrder.status', [0, 9])->where('paid', 1)->where('is_del', 0);
 450:                         break;
 451:                     case -2 :
 452:                         $query->whereNotIn('StoreOrder.status', [10, 11])->where('is_del', 0);
 453:                         break;
 454:                     case -3 :
 455:                         $query->where('paid', 0)->where('is_del', 0);
 456:                         break;
 457:                     case 10 :
 458:                         $query->where('paid', 1)->whereIn('StoreOrder.status', [10, 11])->where('is_del', 0);
 459:                         break;
 460:                     default:
 461:                         $query->where('StoreOrder.status', $where['status'])->where('is_del', 0);
 462:                         break;
 463:                 }
 464: 
 465:             })
 466:             ->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
 467:                 $query->where('StoreOrder.uid', $where['uid']);
 468:             })
 469:             ->when(isset($where['is_user']) && $where['is_user'] !== '', function ($query) use ($where) {
 470:                 $query->where(function ($query) {
 471:                     $query->where('order_type', 0)->whereOr(function ($query) {
 472:                         $query->where('order_type', 1)->where('main_id', 0);
 473:                     });
 474:                 });
 475:             })
 476:             //待核销订单
 477:             ->when(isset($where['is_verify']) && $where['is_verify'], function ($query) use ($where) {
 478:                 $query->where('StoreOrder.order_type', 1)->where('StoreOrder.status', 0);
 479:             })
 480:             ->when(isset($where['pay_type']) && $where['pay_type'] !== '', function ($query) use ($where) {
 481:                 $query->where('StoreOrder.pay_type', $where['pay_type']);
 482:             })
 483:             ->when(isset($where['order_ids']) && $where['order_ids'] !== '', function ($query) use ($where) {
 484:                 $query->whereIn('order_id', $where['order_ids']);
 485:             })
 486:             ->when(isset($where['order_id']) && $where['order_id'] !== '', function ($query) use ($where) {
 487:                 $query->where('order_id', $where['order_id']);
 488:             })
 489:             ->when(isset($where['take_order']) && $where['take_order'] != '', function ($query) use ($where) {
 490:                 $query->where('order_type', 1)->whereNotNull('verify_time');
 491:             })
 492:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
 493:                 getModelTime($query, $where['date'], 'StoreOrder.create_time');
 494:             })
 495:             ->when(isset($where['order_sn']) && $where['order_sn'] !== '', function ($query) use ($where) {
 496:                 $query->where('order_sn', 'like', '%' . $where['order_sn'] . '%');
 497:             })
 498:             ->when(isset($where['paid']) && $where['paid'] !== '', function ($query) use ($where) {
 499:                 $query->where('StoreOrder.paid', $where['paid']);
 500:             })
 501:             ->when(isset($where['is_del']) && $where['is_del'] !== '', function ($query) use ($where) {
 502:                 $query->where('StoreOrder.is_del', $where['is_del']);
 503:             })
 504:             ->when(isset($where['service_id']) && $where['service_id'] !== '', function ($query) use ($where) {
 505:                 $query->where('service_id', $where['service_id']);
 506:             })
 507:             ->when(isset($where['username']) && $where['username'] !== '', function ($query) use ($where) {
 508:                 $query->join('User U', 'StoreOrder.uid = U.uid')
 509:                     ->where(function ($query) use ($where) {
 510:                         $query->where('nickname', 'like', "%{$where['username']}%")
 511:                             ->whereOr('phone', 'like', "%{$where['username']}%")
 512:                             ->whereOr('user_phone', 'like', "%{$where['username']}%");
 513:                     });
 514:             })
 515:             ->when(isset($where['nickname']) && $where['nickname'] !== '', function ($query) use ($where) {
 516:                 $query->whereLike('StoreOrder.real_name', "%" . $where['nickname'] . "%");
 517:             })
 518:             ->when(isset($where['phone']) && $where['phone'] !== '', function ($query) use ($where) {
 519:                 $query->join('User U', 'StoreOrder.uid = U.uid')->where('phone', 'like', "%{$where['phone']}%");
 520:             })
 521:             ->when(isset($where['store_name']) && $where['store_name'] !== '', function ($query) use ($where) {
 522:                 $orderId = StoreOrderProduct::alias('op')
 523:                     ->join('storeProduct sp', 'op.product_id = sp.product_id')
 524:                     ->whereLike('store_name', "%{$where['store_name']}%")
 525:                     ->when((isset($where['sp.mer_id']) && $where['mer_id'] !== ''), function ($query) use ($where) {
 526:                         $query->where('mer_id', $where['mer_id']);
 527:                     })->column('order_id');
 528:                 $query->whereIn('order_id', $orderId ?: '');
 529:             })
 530:             ->when(isset($where['search']) && $where['search'] !== '', function ($query) use ($where) {
 531:                 $orderId = StoreOrderProduct::alias('op')
 532:                     ->join('storeProduct sp', 'op.product_id = sp.product_id')
 533:                     ->whereLike('store_name', "%{$where['search']}%")
 534:                     ->when((isset($where['sp.mer_id']) && $where['mer_id'] !== ''), function ($query) use ($where) {
 535:                         $query->where('mer_id', $where['mer_id']);
 536:                     })->column('order_id');
 537:                 $query->where(function ($query) use ($orderId, $where) {
 538:                     $query->whereIn('order_id', $orderId ? $orderId : '')
 539:                         ->whereOr('order_sn', 'like', "%{$where['search']}%")
 540:                         ->whereOr('user_phone', 'like', "%{$where['search']}%");
 541:                 });
 542:             })
 543:             ->when(isset($where['product_id']) && $where['product_id'] !== '', function ($query) use ($where) {
 544:                 $orderId = StoreOrderProduct::alias('op')
 545:                     ->join('storeProduct sp', 'op.product_id = sp.product_id')
 546:                     ->where('sp.product_id', $where['product_id'])
 547:                     ->column('order_id');
 548:                 $query->whereIn('order_id', $orderId ? $orderId : '');
 549:             })
 550:             ->when(isset($where['group_order_sn']) && $where['group_order_sn'] !== '', function ($query) use ($where) {
 551:                 $query->join('StoreGroupOrder GO', 'StoreOrder.group_order_id = GO.group_order_id')->where('group_order_sn', $where['group_order_sn']);
 552:             })
 553:             ->when(isset($where['keywords']) && $where['keywords'] !== '', function ($query) use ($where) {
 554:                 $query->where(function ($query) use ($where) {
 555:                     $query->whereLike('StoreOrder.real_name|StoreOrder.user_phone|order_sn', "%" . $where['keywords'] . "%");
 556:                 });
 557:             })
 558:             ->order('StoreOrder.create_time DESC');
 559: 
 560:         return $query;
 561:     }
