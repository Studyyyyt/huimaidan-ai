122:                     $merchantData = $merchantInfoData[$item['mer_id']] ?? ['mer_id' => 0];
123: //                    $merchantData = $item['merchant'] ? $item['merchant']->toarray(): ['mer_id' => 0];
124:                     if ($hasCoupon)
125:                         $merchantData['hasCoupon'] = $coupon_make->validMerCouponExists($item['mer_id'], $hasCoupon);
126:                     $arr[$item['mer_id']] = $merchantData;
127:                 }
