26:    /**
27:     * 根据条件搜索数据。
28:     *
29:     * 本函数用于根据提供的条件搜索数据库中的记录。它支持两种条件：'reconciliation_id' 和 'type'。
30:     * 只有当条件存在且不为空时，才会在查询中添加相应的 WHERE 子句。
31:     *
32:     * @param array $where 包含搜索条件的数组。可能的条件键包括 'reconciliation_id' 和 'type'。
33:     * @return \Illuminate\Database\Eloquent\Builder|static 返回构建器对象，可用于进一步的查询操作或数据检索。
34:     */
35:    public function search($where)
36:    {
37:        // 获取模型对应的数据库实例
38:        return ($this->getModel()::getDB())->when(
39:            // 检查是否有 'reconciliation_id' 条件，并且它不是空的
40:            isset($where['reconciliation_id']) && $where['reconciliation_id'] !== '',
41:            function ($query) use ($where) {
42:                // 如果存在 'reconciliation_id'，则在查询中添加对应的 WHERE 条件
43:                $query->where('reconciliation_id', $where['reconciliation_id']);
44:            }
45:        )->when(
46:            // 检查是否有 'type' 条件，并且它不是空的
47:            isset($where['type']) && $where['type'] !== '',
48:            function ($query) use ($where) {
49:                // 如果存在 'type'，则在查询中添加对应的 WHERE 条件
50:                $query->where('type', $where['type']);
51:            }
52:        );
