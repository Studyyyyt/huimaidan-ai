 349:     /**
 350:      * 处理退款后的操作
 351:      * 此函数在退款申请后执行，用于记录退款状态变更、发送通知，并根据不同的用户类型执行相应的操作。
 352:      * @param object $refund 退款信息对象，包含退款订单ID等信息
 353:      * @param object $order 原订单信息对象，包含订单ID等信息
 354:      */
 355:     public function applyRefundAfter($refund, $order)
 356:     {
 357:         // 通过退款订单ID获取退款详情
 358:         $refund = $this->dao->get($refund->refund_order_id);
 359:         // 触发退款创建事件，携带退款和订单信息
 360:         event('refund.create', compact('refund', 'order'));
 361:         // 取消同城配送的订单记录
 362:         if($order->order_type == 2 && isset($order->deliveryOrder) && $order->deliveryOrder->status != -1) {
 363:             $deliveryOrderId = $order->deliveryOrder->delivery_order_id;
 364:             $reason = $refund->mark ?? '';
 365:             app()->make(DeliveryOrderRepository::class)->cancel($deliveryOrderId, $order->mer_id, $reason);
 366:         }
 367: 
 368:         // 实例化订单状态仓库
 369:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
 370: 
 371:         // 构建退款状态日志数组
 372:         $refundStatus = [
 373:             'order_id'       => $refund->refund_order_id,
 374:             'order_sn'       => $refund->refund_order_sn,
 375:             'type'           => $storeOrderStatusRepository::TYPE_REFUND,
 376:             'change_message' => '创建退款单',
 377:             'change_type'    => $storeOrderStatusRepository::ORDER_STATUS_CREATE,
 378:         ];
 379: 
 380:         // 构建订单状态日志数组
 381:         $orderStatus = [
 382:             'order_id'       => $order->order_id,
 383:             'order_sn'       => $order->order_sn,
 384:             'type'           => $storeOrderStatusRepository::TYPE_ORDER,
 385:             'change_message' => '申请退款',
 386:             'change_type'    => $storeOrderStatusRepository::CHANGE_REFUND_CREATGE,
 387:         ];
 388: 
 389:         // 根据用户类型执行不同的操作
 390:         switch ($refund['user_type']) {
 391:             case 1:
 392:                 // 用户类型为1时，记录用户日志，并推送退款创建短信通知
 393:                 $storeOrderStatusRepository->createUserLog($order->uid, $refundStatus);
 394:                 $storeOrderStatusRepository->createUserLog($order->uid,$orderStatus);
 395:                 Queue::push(SendSmsJob::class, ['tempId' => 'ADMIN_RETURN_GOODS_CODE', 'id' => $refund->refund_order_id]);
 396:                 break;
 397:             case 3:
 398:                 // 用户类型为3时，记录管理员日志
 399:                 $refundStatus['change_message'] = '商户创建退款';
 400:                 $orderStatus['change_message']  = '商户发起退款';
 401:                 $storeOrderStatusRepository->createAdminLog($refundStatus);
 402:                 $storeOrderStatusRepository->createAdminLog($orderStatus);
 403:                 break;
 404:             case 4:
 405:                 // 用户类型为4时，记录客服日志
 406:                 $refundStatus['change_message'] = '客服创建退款';
 407:                 $orderStatus['change_message']  = '客服发起退款';
 408:                 $storeOrderStatusRepository->createServiceLog($refund->admin_id, $refundStatus);
 409:                 $storeOrderStatusRepository->createServiceLog($refund->admin_id, $orderStatus);
 410:                 break;
 411:         }
 412: 
 413:         if ($order->is_stock_up === 1)
 414:             app()->make(StoreOrderRepository::class)->cancelShipment($order, $order->mer_id,'订单申请退款');
 415: 
 416:         // 发送商户通知，告知有新的退款单
 417:         SwooleTaskService::merchant('notice', [
 418:             'type' => 'new_refund_order',
 419:             'data' => [
 420:                 'title'   => '新退款单',
 421:                 'message' => '您有一个新的退款单',
 422:                 'id'      => $refund->refund_order_id
 423:             ]
 424:         ], $order->mer_id);
 425:         // 售后自动审核
 426:         $refundAutoApprove = merchantConfig($order['mer_id'], 'refund_auto_approve');
 427:         if ($refundAutoApprove && $order['status'] == 0) {
 428:             $this->agree($refund->refund_order_id);
 429:         }
 430:     }
