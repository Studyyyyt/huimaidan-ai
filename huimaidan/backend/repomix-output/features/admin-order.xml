1807:     /**
1808:      * 计算退款金额中商家实际应退金额。
1809:      * 此函数主要用于处理订单退款时，根据退款金额和订单中的额外费用（如手续费）计算商家实际应退的金额。
1810:      * 考虑到订单可能有佣金的情况，还会计算并扣除相应的佣金部分。
1811:      *
1812:      * @param StoreRefundOrder $refundOrder 退款订单对象，包含订单退款的相关信息。
1813:      * @param null $refundPrice 退款金额，如果为null，则使用退款订单中的退款金额。
1814:      * @return string 商家实际应退金额，以字符串形式返回，保留两位小数。
1815:      */
1816:     public function getRefundMerPrice(StoreRefundOrder $refundOrder, $refundPrice = null)
1817:     {
1818:         // 如果未指定退款金额，则使用退款订单中的退款金额。
1819:         if ($refundPrice === null) {
1820:             $refundPrice = $refundOrder->refund_price;
1821:             // 初始化扩展字段一和扩展字段二，用于后续计算。
1822:             $extension_one = $refundOrder['extension_one'];
1823:             $extension_two = $refundOrder['extension_two'];
1824:         } else {
1825:             // 计算退款比例，用于按比例计算扩展字段的退款金额。
1826:             $rate = bcdiv($refundPrice, $refundOrder->refund_price, 3);
1827:             // 根据退款比例计算扩展字段一和扩展字段二的退款金额。
1828:             $extension_one = $refundOrder['extension_one'] > 0 ? bcmul($rate, $refundOrder['extension_one'], 2) : 0;
1829:             $extension_two = $refundOrder['extension_two'] > 0 ? bcmul($rate, $refundOrder['extension_two'], 2) : 0;
1830:         }
1831:         // 计算扩展字段的总退款金额。
1832:         $extension = bcadd($extension_one, $extension_two, 3);
1833:         // 获取订单的佣金比例，用于计算佣金退款金额。
1834:         $commission_rate = bcdiv($refundOrder->order->commission_rate, '100', 6);
1835:         // 初始化佣金退款金额。
1836:         $_refundRate = 0;
1837:         // 如果订单有佣金，则计算佣金退款金额。
1838:         if ($refundOrder->order->commission_rate > 0) {
1839:             $_refundRate = bcmul($commission_rate, bcsub($refundPrice, $extension, 2), 2);
1840:         }
1841:         // 计算商家实际应退金额，即总退款金额减去扩展字段退款金额和佣金退款金额。
1842:         return bcsub(bcsub($refundPrice, $extension, 2), $_refundRate, 2);
1843:     }
