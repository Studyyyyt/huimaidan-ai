1492:     /**
1493:      * 根据订单退款情况更新商品退款状态
1494:      *
1495:      * @param object $res 订单退款信息
1496:      * @param int $status 退款状态：1表示同意，其他表示拒绝
1497:      * @param bool $after 是否为退款后操作，默认为false表示退款前
1498:      * @return bool 更新操作是否成功
1499:      */
1500:     public function getProductRefundNumber($res, $status, $after = false)
1501:     {
1502:         /**
1503:          * 1.同意退款
1504:          *   1.1 仅退款
1505:          *      1.1.1 是 , 如果退款数量 等于 购买数量 is_refund = 3 全退退款 不等于 is_refund = 2 部分退款
1506:          *      1.1.2 否, is_refund = 1 退款中
1507:          *   1.2 退款退货 is_refund = 1
1508:          *
1509:          * 2. 拒绝退款
1510:          *   2.1 如果退款数量 等于 购买数量 返还可退款数 is_refund = 0
1511:          *   2.2 商品总数小于可退数量 返还可退数 以商品数为准
1512:          *   2.3 是否存在其他图款单,是 ,退款中 ,否, 部分退款
1513:          */
1514:         // 获取订单退款数量
1515:         $refundId = $this->getRefundCount($res->order_id, $res['refund_order_id']);
1516:         // 实例化退款产品仓库
1517:         $make = app()->make(StoreRefundProductRepository::class);
1518: 
1519:         // 遍历退款商品列表，更新每个商品的退款状态
1520:         foreach ($res['refundProduct'] as $item) {
1521:             // 获取商品当前的退款状态
1522:             $is_refund = $item->product->is_refund;
1523: 
1524:             // 同意退款的处理逻辑
1525:             if ($status == 1) {
1526:                 // 退款后操作的逻辑
1527:                 if ($after) {
1528:                     // 全部退款或部分退款的判断
1529:                     $is_refund = ($item->refund_num == $item->product->product_num) ? 3 : 2;
1530:                 } // 退款前操作的逻辑，仅在退款类型为退款退货时执行
1531:                 else if ($res['refund_type'] == 1) {
1532:                     // 全部退款或部分退款的判断
1533:                     $is_refund = ($item->refund_num == $item->product->product_num) ? 3 : 2;
1534:                 }
1535:             } // 拒绝退款的处理逻辑
1536:             else {
1537:                 // 计算返还可退款数量
1538:                 $refund_num = $item->refund_num + $item->product->refund_num;
1539:                 // 全部可退时，设置退款状态为0
1540:                 if ($item->product->product_num == $refund_num) {
1541:                     $is_refund = 0;
1542:                 }
1543:                 // 可退数量小于商品总数时，调整可退数量
1544:                 if ($item->product->product_num < $refund_num) {
1545:                     $refund_num = $item->product->product_num;
1546:                 }
1547:                 // 更新商品的可退数量
1548:                 $item->product->refund_num = $refund_num;
1549:             }
1550: 
1551:             // 检查是否有其他退款单中包含当前商品，如果有，则设置退款状态为1（退款中）
1552:             if (!empty($refundId)) {
1553:                 $has = $make->getWhereCount([['refund_order_id', 'in', $refundId], ['order_product_id', '=', $item->product->order_product_id]]);
1554:                 if ($has) {
1555:                     $is_refund = 1;
1556:                 }
1557:             }
1558: 
1559:             // 更新商品的退款状态
1560:             $item->product->is_refund = $is_refund;
1561:             // 保存更新后的商品退款状态
1562:             $item->product->save();
1563:         }
1564: 
1565:         // 更新操作成功，返回true
1566:         return true;
1567:     }
