1713:     /**
1714:      * 同城配送费用计算
1715:      *
1716:      * @param float $totalPrice
1717:      * @param array $merchantCart
1718:      * @param array $address
1719:      * @return float
1720:      */
1721:     protected function getDeliveryFee(float $totalPrice, $merchantCart, $address) : float
1722:     {
1723:         // 计算重量
1724:         $totalWeight = 0;
1725:         foreach($merchantCart['list'] as $item) {
1726:             $totalWeight += $item['productAttr']['weight'] * $item['cart_num'];
1727:         }
1728:         $deliveryConfigRepository = app()->make(DeliveryConfigRepository::class);
1729:         $deliverySettings = $deliveryConfigRepository->getDeliveryConfig($merchantCart['mer_id']);
1730:         if (!$deliverySettings) {
1731:             throw new ValidateException('商户：【' . $deliverySettings['merchant']['mer_name'] . '】，未设置配送费用信息，无法计算配送费，请切换其他配送方式');
1732:         }
1733:         // 是否到达起送价
1734:         if ($totalPrice < $deliverySettings['min_delivery_amount']) {
1735:             throw new ValidateException('商户：【' . $deliverySettings['merchant']['mer_name'] . '】，订单金额不能低于起送价，起送价：¥' . $deliverySettings['min_delivery_amount']);
1736:         }
1737:         // 是否到达免配送费金额
1738:         if ($totalPrice >= $deliverySettings['free_shipping_amount']) {
1739:             return 0;
1740:         }
1741:         return $deliveryConfigRepository->deliveryFee(
1742:             $merchantCart['take_id'],
1743:             $totalWeight,
1744:             $deliverySettings->toArray(),
1745:             $address->toArray()
1746:         );
1747:     }
