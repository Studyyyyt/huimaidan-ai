2928:      * 该函数用于根据订单信息生成微信支付二维码。二维码的内容是根据订单号和特定格式生成的URL，
2929:      * 用于在微信支付中进行扫码支付。如果二维码图片已存在，则直接返回图片URL；否则，生成新的二维码图片
2930:      * 并保存，然后返回新图片的URL。
2931:      *
2932:      * @param string $orderId 订单号
2933:      * @param object $order 订单对象，包含订单的相关信息
2934:      * @return string 二维码图片的URL
2935:      */
2936:     public function wxQrcode($orderId, $order)
2937:     {
2938:         // 从订单对象中获取验证码和商家ID
2939:         $verify_code = $order->verify_code;
2940:         $mer_id = $order->mer_id;
2941: 
2942:         // 获取网站的根URL，用于构造二维码的链接
2943:         $siteUrl = systemConfig('site_url');
2944: 
2945:         // 根据订单号、当前日期和固定字符串生成唯一的二维码文件名
2946:         $name = md5('owx' . $orderId . date('Ymd')) . '.jpg';
2947: 
2948:         // 获取附件仓库实例，用于后续操作二维码图片
2949:         $attachmentRepository = app()->make(AttachmentRepository::class);
2950: 
2951:         // 根据文件名查询已存在的二维码图片信息
2952:         $imageInfo = $attachmentRepository->getWhere(['attachment_name' => $name]);
