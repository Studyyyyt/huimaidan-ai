1495:     /**
1496:      *  改价后重新计算每个商品的单价
1497:      * @param int $orderId
1498:      * @param array $data
1499:      * @author Qinii
1500:      * @day 12/15/20
1501:      */
1502:     public function changOrderProduct(int $orderId, array $data)
1503:     {
1504:         $make = app()->make(StoreOrderProductRepository::class);
1505:         $ret = $make->getSearch(['order_id' => $orderId])->field('order_product_id,product_num,product_price')->select();
1506:         $count = $make->getSearch(['order_id' => $orderId])->sum('product_price');
1507:         $_count = (count($ret->toArray()) - 1);
1508:         $pay_price = $data['total_price'];
1509:         foreach ($ret as $k => $item) {
1510:             $_price = 0;
1511:             /**
1512:              *  比例 =  单个商品总价 / 订单原总价；
1513:              *
1514:              *  新的商品总价 = 比例 * 订单修改总价
1515:              *
1516:              *  更新数据库
1517:              */
1518:             if ($k == $_count) {
1519:                 $_price = $pay_price;
1520:             } else {
1521:                 $_reta = bcdiv($item->product_price, $count, 3);
1522:                 $_price = bcmul($_reta, $data['total_price'], 2);
1523:             }
1524: 
1525:             $item->product_price = $_price;
1526:             $item->save();
1527: 
1528:             $pay_price = $this->bcmathPrice($pay_price, $_price, 0);
1529:         }
1530:     }
