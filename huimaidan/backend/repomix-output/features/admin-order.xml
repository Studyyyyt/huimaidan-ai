 169:     /**
 170:      * 创建退款订单
 171:      *
 172:      * @param StoreOrder $order 退款的订单
 173:      * @param int $refund_type 退款类型，默认为1（普通退款）
 174:      * @param string $refund_message 退款原因，默认为'自动发起退款'
 175:      * @param bool $refund_postage 是否退款邮费，默认为true
 176:      * @return mixed 退款订单信息
 177:      */
 178:     public function createRefund(StoreOrder $order, $refund_type = 1, $refund_message = '自动发起退款', $refund_postage = true)
 179:     {
 180:         $products            = $order->orderProduct;
 181:         $ids                 = array_column($products->toArray(), 'order_product_id');
 182:         $productRefundPrices = app()->make(StoreRefundProductRepository::class)->userRefundPrice($ids);
 183: 
 184:         $totalRefundPrice         = 0;
 185:         $totalRefundNum           = 0;
 186:         $total_extension_one      = 0;
 187:         $total_extension_two      = 0;
 188:         $totalIntegral            = 0;
 189:         $totalPlatformRefundPrice = 0;
 190:         $totalPostage             = 0;
 191:         $refundProduct            = [];
 192:         $refund_order_id          = 0;
 193:         foreach ($products as $product) {
 194:             $productRefundPrice = $productRefundPrices[$product['order_product_id']] ?? [];
 195:             if ($product['extension_one'] > 0)
 196:                 $total_extension_one = bcadd($total_extension_one, bcmul($product['refund_num'], $product['extension_one'], 2), 2);
 197:             if ($product['extension_two'] > 0)
 198:                 $total_extension_two = bcadd($total_extension_two, bcmul($product['refund_num'], $product['extension_two'], 2), 2);
 199:             $postagePrice   = ($refund_postage || !$order->status || $order->status == 9) ? bcsub($product['postage_price'], $productRefundPrice['refund_postage'] ?? 0, 2) : 0;
 200:             $totalRefundNum += $product['refund_num'];
 201:             $refundPrice    = 0;
 202:             //计算可退金额
 203:             if ($product['product_price'] > 0) {
 204:                 $refundPrice = bcsub($product['product_price'], bcsub($productRefundPrice['refund_price'] ?? 0, $productRefundPrice['refund_postage'] ?? 0, 2), 2);
 205:             }
 206:             $platform_refund_price = 0;
 207:             //计算退的平台优惠券金额
 208:             if ($product['platform_coupon_price'] > 0) {
 209:                 $platform_refund_price = bcsub($product['platform_coupon_price'], $productRefundPrice['platform_refund_price'] ?? 0, 2);
 210:             }
 211:             $integral = 0;
 212:             if ($product['integral'] > 0) {
 213:                 $integral = bcsub($product['integral_total'], $productRefundPrice['refund_integral'] ?? 0, 0);
 214:             }
 215: 
 216:             $totalPostage             = bcadd($totalPostage, $postagePrice, 2);
 217:             $totalRefundPrice         = bcadd($totalRefundPrice, $refundPrice, 2);
 218:             $totalPlatformRefundPrice = bcadd($totalPlatformRefundPrice, $platform_refund_price, 2);
 219:             $totalIntegral            = bcadd($totalIntegral, $integral, 2);
 220: 
 221:             $refundProduct[] = [
 222:                 'refund_order_id'       => &$refund_order_id,
 223:                 'refund_num'            => $product['refund_num'],
 224:                 'order_product_id'      => $product['order_product_id'],
 225:                 'platform_refund_price' => $platform_refund_price,
 226:                 'refund_integral'       => $integral,
 227:                 'refund_price'          => $refundPrice,
 228:                 'refund_postage'        => $postagePrice,
 229:             ];
 230:         }
 231:         $data                          = compact('refund_message', 'refund_type');
 232:         $data['order_id']              = $products[0]['order_id'];
 233:         $data['uid']                   = $products[0]['uid'];
 234:         $data['mer_id']                = $order['mer_id'];
 235:         $data['refund_order_sn']       = app()->make(StoreOrderRepository::class)->getNewOrderId(StoreOrderRepository::TYPE_SN_REFUND);
 236:         $data['refund_num']            = $totalRefundNum;
 237:         $data['extension_one']         = $total_extension_one;
 238:         $data['extension_two']         = $total_extension_two;
 239:         $data['refund_price']          = bcadd($totalPostage, $totalRefundPrice, 2);
 240:         $data['integral']              = $totalIntegral;
 241:         $data['platform_refund_price'] = $totalPlatformRefundPrice;
 242:         $data['refund_postage']        = $totalPostage;
 243:         //退款订单记录
 244:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
 245: 
 246:         return Db::transaction(function () use ($refundProduct, $data, $products, $order, &$refund_order_id, $storeOrderStatusRepository, $refund_message) {
 247:             event('refund.creates.before', compact('data'));
 248:             $refund          = $this->dao->create($data);
 249:             $refund_order_id = $refund->refund_order_id;
 250:             foreach ($products as $product) {
 251:                 $product->refund_num = 0;
 252:                 $product->is_refund  = 1;
 253:                 $product->save();
 254:             }
 255:             $orderStatus = [
 256:                 'order_id'       => $refund->refund_order_id,
 257:                 'order_sn'       => $order->order_sn,
 258:                 'type'           => $storeOrderStatusRepository::TYPE_REFUND,
 259:                 'change_message' => $refund_message,
 260:                 'change_type'    => $storeOrderStatusRepository::ORDER_STATUS_CREATE,
 261:             ];
 262:             $storeOrderStatusRepository->createSysLog($orderStatus);
 263:             app()->make(StoreRefundProductRepository::class)->insertAll($refundProduct);
 264:             return $refund;
 265:         });
 266:     }
 267: 
 268:     /**
 269:      * 计算订单的退款总金额
 270:      *
 271:      * 本函数用于根据订单中的商品及其退款情况，计算出订单的总退款金额，包括商品退款金额和邮费退款金额。
 272:      * 在计算过程中，会考虑到商品是否支持退款、订单状态以及具体的退款金额和邮费。
 273:      *
 274:      * @param object $order 订单对象，包含订单的相关信息。
 275:      * @param Collection $products 商品集合，包含需要退款的商品详细信息。
 276:      * @param int $refund_switch 退款开关，默认为1，表示支持退款。如果不支持退款，则会抛出异常。
 277:      * @return float 订单的总退款金额，包括商品退款金额和邮费退款金额。
 278:      * @throws ValidateException 如果部分商品不支持退款，则抛出此异常。
 279:      */
 280:     public function getRefundsTotalPrice($order, $products, $refund_switch = 1)
 281:     {
 282:         // 通过依赖注入获取退款产品仓库，用于查询商品的退款价格信息。
 283:         $productRefundPrices = app()->make(StoreRefundProductRepository::class)->userRefundPrice($products->column('order_product_id'));
 284: 
 285:         // 初始化邮费退款总额和商品退款总额
 286:         $totalPostage     = 0;
 287:         $totalRefundPrice = 0;
 288: 
 289:         // 遍历商品集合，计算每个商品的退款金额和邮费退款金额
 290:         foreach ($products as $product) {
 291:             // 如果商品不支持退款，但全局退款开关打开，则抛出异常
 292:             if (!$product['refund_switch'] && $refund_switch) throw new ValidateException('部分商品不支持退款');
 293: 
 294:             // 获取商品的退款价格信息
 295:             $productRefundPrice = $productRefundPrices[$product['order_product_id']] ?? [];
 296: 
 297:             // 计算商品的邮费退款金额，根据订单状态和退款邮费来确定
 298:             $postagePrice = (!$order->status || $order->status == 9) ? bcsub($product['postage_price'], $productRefundPrice['refund_postage'] ?? 0, 2) : 0;
 299: 
 300:             // 计算商品的退款金额，考虑商品价格、商品退款价格和邮费退款金额
 301:             $refundPrice = 0;
 302:             if ($product['product_price'] > 0) {
 303:                 $refundPrice = bcsub($product['product_price'], bcsub($productRefundPrice['refund_price'] ?? 0, $productRefundPrice['refund_postage'] ?? 0, 2), 2);
 304:             }
 305: 
 306:             // 累加邮费退款总额和商品退款总额
 307:             $totalPostage     = bcadd($totalPostage, $postagePrice, 2);
 308:             $totalRefundPrice = bcadd($totalRefundPrice, $refundPrice, 2);
 309:         }
 310: 
 311:         // 返回邮费退款总额和商品退款总额的总和
 312:         return bcadd($totalPostage, $totalRefundPrice, 2);
 313:     }
 314: 
 315:     /**
 316:      * 计算订单中商品的退款总金额和退款邮费。
 317:      * 此函数用于处理用户发起的退款请求，根据订单和商品信息，计算出应退给用户的总金额和邮费。
 318:      *
 319:      * @param object $order 订单对象，包含订单的相关信息。
 320:      * @param collection $products 商品集合，包含用户申请退款的商品详情。
 321:      *
 322:      * @return array 返回一个包含总退款金额和退款邮费的数组。
 323:      * @throws ValidateException 如果商品不支持退款，则抛出验证异常。
 324:      */
 325:     public function getRefundTotalPrice($order, $products)
 326:     {
 327:         // 获取所有申请退款商品的退款价格信息
 328:         $productRefundPrices = app()->make(StoreRefundProductRepository::class)->userRefundPrice($products->column('order_product_id'));
 329: 
 330:         // 取出第一个商品用于后续判断和计算
 331:         $product = $products[0];
 332: 
 333:         // 如果商品不支持退款，则抛出异常
 334:         if (!$product['refund_switch']) throw new ValidateException('商品不支持退款');
 335: 
 336:         // 获取当前商品的具体退款价格信息
