1936:                 'order_sn' => $order->order_sn,
1937:                 'type' => $statusRepository::TYPE_ORDER,
1938:                 'change_message' => '虚拟发货后',
1939:                 'change_type' => $statusRepository::ORDER_STATUS_TAKE,
1940:             ];
1941:             $statusRepository->createSysLog($orderStatus);
1942: 
1943:         }
