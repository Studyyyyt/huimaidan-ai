409:      * @return void
410:      */
411:     public function merchantPay(array $params, $user, $groupOrder)
412:     {
413:         $authCode = isset($params['auth_code']) && !empty($params['auth_code']) ? $params['auth_code'] : '';
414:         //$combine = $params['pay_type'] == 'weixinQr' ? true : false;
