 481:     /**
 482:      *  商户发起退款操作
 483:      * @param StoreOrder $order
 484:      * @param array $refund
 485:      * @param array $data
 486:      * @param int $isCreate
 487:      * @param int $userType
 488:      * @return \think\response\Json|void
 489:      * @author Qinii
 490:      * @day 2023/7/11
 491:      */
 492:     public function merRefund(StoreOrder $order, array $refund, array $data)
 493:     {
 494:         $productIds = array_keys($refund);
 495:         $nums       = array_values($refund);
 496:         $orderId    = $order->order_id;
 497:         $uid        = $order->uid;
 498: 
 499:         if (count($productIds) == 1) {
 500:             $res = $this->refund($order, $productIds[0], $nums[0], $uid, $data, 0);
 501:         } else {
 502:             $products = app()->make(StoreOrderProductRepository::class)->userRefundProducts($productIds, $uid, $orderId, 0);
 503:             if (empty($products->toArray())) throw new ValidateException('请选择正确的退款商品');
 504:             $refund_status = true;
 505:             foreach ($products as $product) {
 506:                 if ($product['refund_num'] !== $refund[$product['order_product_id']]) {
 507:                     $refund_status = false;
 508:                     break;
 509:                 }
 510:             }
 511:             if ($refund_status) {
 512:                 $res = $this->refunds($order, $productIds, $uid, $data, 1, $nums);
 513:             } else {
 514:                 $res = $this->refundEach($order, $refund, $data, $products);
 515:             }
 516:         }
 517:         $refundAutoApprove = merchantConfig($order['mer_id'], 'refund_auto_approve');
 518:         if ($res && !($refundAutoApprove && $order['status'] == 0)) {
 519:             $this->agree($res->refund_order_id, ['status' => 1]);
 520:         }
 521: 
 522:         return $res;
 523:     }
