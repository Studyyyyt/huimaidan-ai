234:      * 该方法用于记录用户的操作日志。它通过接收一个数据数组，然后在这个数组中添加用户类型、用户ID和用户昵称等信息。
235:      * 如果能够成功获取到用户信息，则正常添加到数组中；如果获取用户信息失败，则标记为异常情况。
236:      * 最后，将这个填充好的数据数组提交给DAO层，进行实际的日志创建操作。
237:      *
238:      * @param array $data 用户操作日志的数据数组，需要包含相关信息。
239:      * @return bool 创建日志的操作结果，成功返回true，失败返回false。
240:      */
241:     public function createUserLog($uid, array $data)
242:     {
243:         // 设置用户类型为普通用户
244:         $data['user_type'] = self::U_TYPE_USER;
245: 
246:         try {
247:             $user = app()->make(UserRepository::class)->get($uid);
248:             // 尝试获取当前请求的用户ID和昵称，并添加到数据数组中
249:             $data['uid'] = $user->uid;
250:             $data['nickname'] = $user->nickname;
251:         } catch (\Exception $exception) {
252:             // 如果获取用户信息失败，将用户ID标记为-1，昵称为空字符串
253:             $data['uid'] = -1;
254:             $data['nickname'] = '';
255:         }
256: 
257:         // 调用DAO层的create方法，尝试创建用户日志
258:         return $this->dao->create($data);
259:     }
260: 
261:     /**
262:      * 创建系统日志
263:      *
264:      * 该方法用于生成系统的操作日志记录。它通过指定的日志数据数组，填充特定的字段值，
265:      * 然后调用DAO层的方法来创建日志记录。系统日志主要包含用户类型、用户ID、用户昵称等信息。
266:      *
267:      * @param array $data 日志数据数组，包含日志的具体内容。
268:      * @return bool|int 返回创建操作的结果，通常是新插入记录的ID或布尔值（操作成功或失败）。
269:      */
270:     public function createSysLog(array $data)
271:     {
272:         // 设置日志的用户类型为系统
273:         $data['user_type'] = self::U_TYPE_SYSTEM;
274:         // 设置日志的用户ID为0，表示系统操作
275:         $data['uid'] = 0;
276:         // 设置日志的用户昵称为“系统”
277:         $data['nickname'] = '系统';
278: 
279:         // 调用DAO层的create方法，插入日志数据
280:         return $this->dao->create($data);
281:     }
282: 
283:     /**
284:      * 批量创建日志记录。
285:      *
286:      * 本函数用于处理给定数据集的日志记录批量创建。如果传入的数据集不为空，
287:      * 则通过调用DAO层的insertAll方法将所有日志数据插入数据库。此方法的设计
288:      * 旨在减少数据库交互次数，提高数据插入的效率。
289:      *
290:      * @param array $data 包含日志数据的数组。每个元素都应该是一个日志条目的数组。
291:      *                   数组的每个元素应该包含日志记录的所有必要字段。
292:      * @return bool|void 如果$data不为空，返回DAO层的insertAll方法的执行结果，通常是布尔值，
293:      *                   表示插入操作是否成功。如果$data为空，则不执行插入操作，也不返回任何值。
294:      */
295:     public function batchCreateLog($data)
296:     {
297:         // 检查传入的数据集是否为空
298:         if(!empty($data)) {
299:             // 如果数据集不为空，调用DAO层的insertAll方法插入所有日志数据
300:             return $this->dao->insertAll($data);
301:         }
302:     }
303: }
