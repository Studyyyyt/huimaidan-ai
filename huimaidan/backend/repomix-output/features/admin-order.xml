 432:     /**
 433:      *  根据商品ID和退款数量计算可退金额
 434:      * @param StoreOrder $order
 435:      * @param array $refund
 436:      * @return int|string
 437:      * @author Qinii
 438:      * @day 2023/8/7
 439:      */
 440:     public function compute(StoreOrder $order, array $refund)
 441:     {
 442:         $productIds = array_keys($refund);
 443:         $orderId    = $order->order_id;
 444:         $uid        = $order->uid;
 445:         if (empty($productIds)) {
 446:             throw new ValidateException('请选择正确的退款商品');
 447:         }
 448:         $products = app()->make(StoreOrderProductRepository::class)->userRefundProducts($productIds, $uid, $orderId, 0);
 449:         if (empty($products->toArray())) throw new ValidateException('请选择正确的退款商品');
 450: 
 451:         $productRefundPriceData = app()->make(StoreRefundProductRepository::class)->userRefundPrice($productIds);
 452:         $data['refund_price']   = 0;
 453:         $totalRefundPrice       = 0;
 454:         foreach ($products as $product) {
 455:             $num       = $refund[$product['order_product_id']];
 456:             $productId = $product['order_product_id'];
 457:             if ($product['refund_num'] < $num) throw new ValidateException('可退款商品不足' . floatval($num) . '件');
 458:             $productRefundPrice = $productRefundPriceData[$productId] ?? [];
 459:             [$refundOrder, $refundProduct, $total] = $this->getRefundData($order, $product, $data, $num, $productRefundPrice);
 460:             $totalRefundPrice = bcadd($totalRefundPrice, $total, TOP_PRECISION);
 461:         }
 462:         $isDisplayPostage = false;
 463:         if($order->order_type == 2) {
 464:             // 已经申请退款的总数量
 465:             $refundTotalNum = 0;
 466:             $refundInfo = $this->getSearch(['order_id' => $order->order_id])->whereIn('status',[0,1,2,3])->with('refundProduct')->select()->toArray();
 467:             foreach($refundInfo as $item) {
 468:                 $refundTotalNum += array_sum(array_column($item['refundProduct'],'refund_num'));
 469:             }
 470:             // 订单总数量
 471:             $orderGroupTotalNum = app()->make(StoreGroupOrderRepository::class)->getSearch(['group_order_id' => $order->group_order_id])->sum('total_num');
 472:             // 如果申请退款的总数量加上当前要退款的数量等于订单分组总数量，说明是全退，同城配送全退才包含运费
 473:             if(bcadd($refundTotalNum, array_sum(array_values($refund))) == $orderGroupTotalNum) {
 474:                 $totalRefundPrice += $order->total_postage;
 475:                 $isDisplayPostage = true;
 476:             }
 477:         }
 478:         return [$totalRefundPrice, $isDisplayPostage];
 479:     }
