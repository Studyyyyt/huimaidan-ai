2474:     private function createRefundService(int $serverType)
2475:     {
2476:         if ($serverType == 0) {
2477:             return null;
2478:         } else if ($serverType == self::TYPE_IS_PARTNER) {
2479:             return new Pay('partner');
2480:         } elseif ($serverType == self::TYPE_IS_COMBINE ) {
2481:             return WechatService::create()->combinePay();
2482:         } elseif ( $serverType == 2) {
2483:             return MiniProgramService::create();
2484:         } elseif (in_array($serverType, [4, 5, 9])) {
2485:             return AlipayService::create();
2486:         } else {
2487:             return WechatService::create();
2488:         }
2489:     }
2490: 
2491:     /**
2492:      * 处理退款流程
2493:      */
2494:     private function processRefund($refundOrder, $refundData, $refundService, $serverType): array
2495:     {
2496:         $merchantRepository = app()->make(MerchantRepository::class);
2497:         $totalItems = count($refundData);
2498:         $refundPriceAll = 0;
2499:         $refundRate = 0;
2500:         $totalExtension = bcadd($refundOrder['extension_one'], $refundOrder['extension_two'], 2);
2501:         $processedExtension = 0;
2502: 
2503:         foreach ($refundData as $index => $item) {
2504:             if ($this->isValidRefundItem($item)) {
2505:                 $result = $this->processSingleRefund(
2506:                     $refundOrder,
2507:                     $item,
2508:                     $index,
2509:                     $totalItems,
2510:                     $totalExtension,
2511:                     $processedExtension,
2512:                     $refundService,
2513:                     $merchantRepository,
2514:                     $serverType
2515:                 );
2516: 
2517:                 $refundPriceAll = bcadd($refundPriceAll, $result['refundPrice'], 2);
2518:                 $refundRate = bcadd($refundRate, $result['refundRate'], 2);
2519:                 $processedExtension = bcadd($processedExtension, $result['extension'], 2);
2520:             }
2521:         }
2522: 
2523:         return [
2524:             'refundPriceAll' => $refundPriceAll,
2525:             'refundRate' => $refundRate
2526:         ];
2527:     }
2528: 
2529:     /**
2530:      * 处理单笔退款
2531:      */
2532:     private function processSingleRefund($refundOrder, $item, $index, $totalItems, $totalExtension, $processedExtension, $refundService, $merchantRepository, $serverType): array
2533:     {
2534:         $refundPrice = $this->getRefundMerPrice($refundOrder, $item['data']['refund_price']);
2535: 
2536:         // 计算分佣
2537:         $extension = $this->calculateExtension(
2538:             $refundOrder,
2539:             $item,
2540:             $index,
2541:             $totalItems,
2542:             $totalExtension,
2543:             $processedExtension
2544:         );
2545: 
2546:         $refundRate = $this->calculateRefundRate($refundOrder, $item, $extension);
2547: 
2548:         // 执行退款
2549:         if($item['type'] != 7) {
2550:             $this->executeRefund($refundOrder, $item, $refundService, $merchantRepository, $serverType, $refundPrice);
2551:         }
2552: 
2553:         return [
2554:             'refundPrice' => $refundPrice,
2555:             'refundRate' => $refundRate,
2556:             'extension' => $extension
2557:         ];
2558:     }
2559: 
2560:     /**
2561:      * 计算分佣金额
2562:      */
2563:     private function calculateExtension($refundOrder, $item, $index, $totalItems, $totalExtension, $processedExtension): string
2564:     {
2565:         if ($refundOrder->order->commission_rate <= 0) {
2566:             return '0.00';
2567:         }
2568: 
2569:         if ($index == ($totalItems - 1)) {
2570:             return bcsub($totalExtension, $processedExtension, 2);
2571:         }
2572: 
2573:         $ratio = bcdiv($item['data']['refund_price'], $refundOrder->refund_price, 2);
2574:         return bcmul($ratio, $totalExtension, 2);
2575:     }
2576: 
2577:     /**
2578:      * 计算退款费率
2579:      */
2580:     private function calculateRefundRate($refundOrder, $item, $extension): string
2581:     {
2582:         if ($refundOrder->order->commission_rate <= 0) {
2583:             return '0.00';
2584:         }
2585: 
2586:         $commissionRate = bcdiv($refundOrder->order->commission_rate, 100, 6);
2587:         $refundBase = bcsub($item['data']['refund_price'], $extension, 2);
2588: 
2589:         return bcmul($commissionRate, $refundBase, 2);
2590:     }
2591: 
2592:     /**
2593:      * 执行退款操作
2594:      */
2595:     private function executeRefund($refundOrder, $item, $refundService, $merchantRepository, $serverType, $refundPrice): void
2596:     {
2597:         try {
2598:             $orderType = isset($item['presell']) && $item['presell'] ? 'presell' : 'order';
2599:             if ($item['type'] == 0) {
2600:                 $this->refundBill($item, $refundOrder->uid, $refundOrder->refund_order_id);
2601:                 $merchantRepository->subLockMoney($refundOrder->mer_id, $orderType, $item['id'], $refundPrice);
2602:             } else {
2603:                 $refundService->payOrderRefund($item['sn'], $item['data']);
2604:                 if (in_array($item['type'],[self::TYPE_IS_COMBINE,self::TYPE_IS_PARTNER])) {
2605:                     $this->handleCombineRefund($refundOrder, $item, $orderType, $refundPrice);
2606:                 } else {
2607:                     $merchantRepository->subLockMoney($refundOrder->mer_id, $orderType, $item['id'], $refundPrice);
2608:                 }
2609:             }
2610:         } catch (Exception $e) {
2611:             throw new ValidateException($e->getMessage());
2612:         }
2613:     }
2614: 
2615:     /**
2616:      * 处理合并支付退款
2617:      */
2618:     private function handleCombineRefund($refundOrder, $item, $orderType, $refundPrice): void
2619:     {
2620:         $profitsharingRepo = app()->make(StoreOrderProfitsharingRepository::class);
2621: 
2622:         if ($orderType === 'presell') {
2623:             $profitsharingRepo->refundPresallPrice($refundOrder, $item['data']['refund_price'], $refundPrice);
2624:         } else {
2625:             $profitsharingRepo->refundPrice($refundOrder, $item['data']['refund_price'], $refundPrice);
2626:         }
2627:     }
2628: 
2629:     /**
2630:      * 记录财务交易
2631:      */
2632:     private function recordFinancialTransactions($refundOrder, $refundResult): void
2633:     {
2634:         $financialRepo = app()->make(FinancialRecordRepository::class);
2635:         $user = $refundOrder->user;
2636: 
2637:         // 记录退款金额
2638:         $financialRepo->inc([
2639:             'order_id' => $refundOrder->refund_order_id,
2640:             'order_sn' => $refundOrder->refund_order_sn,
2641:             'user_info' => $user->nickname ?? '',
2642:             'user_id' => $refundOrder->uid ?? 0,
2643:             'financial_type' => 'refund_true',
2644:             'number' => $refundResult['refundPriceAll'],
2645:             'type' => 1,
2646:             'pay_type' => $refundOrder->order->pay_type,
2647:         ], $refundOrder->mer_id);
2648: 
2649:         // 记录退款手续费
2650:         $financialRepo->inc([
2651:             'order_id' => $refundOrder->refund_order_id,
2652:             'order_sn' => $refundOrder->refund_order_sn,
2653:             'user_info' => $user->nickname ?? '',
2654:             'user_id' => $refundOrder->uid ?? 0,
2655:             'type' => 1,
2656:             'financial_type' => 'refund_charge',
2657:             'number' => $refundResult['refundRate'],
2658:             'pay_type' => $refundOrder->order->pay_type
2659:         ], $refundOrder->mer_id);
2660:     }
2661: 
2662:     /**
2663:      * 检查退款项是否有效
2664:      */
2665:     private function isValidRefundItem(array $item): bool
2666:     {
2667:         return ($item['data']['pay_price'] > 0 && $item['data']['refund_price'] > 0);
2668:     }
2669: }
