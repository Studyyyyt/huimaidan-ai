1568:             if ($order_model && $k) throw new ValidateException('虚拟商品必须单独购买');
1569:             if ($order_model == 4 && !$this->validateReservation($cart))
1570:                 throw new ValidateException('当前时间已经预约满了～');
1571:             if ($order_type == 0 ) {
1572:                 if ($cart['product']['pay_limit'] == 1) {
1573:                     if ($cart['product']['once_max_count'] < $cart['cart_num']) {
1574:                         throw new ValidateException('[超出单次限购数：' . $cart['product']['once_max_count'] . ']' . mb_substr($cart['product']['store_name'], 0, 10) . '...');
1575:                     }
1576:                 } else if ($cart['product']['pay_limit'] == 2) {
1577:                     $count = $productNum[$cart['product_id']];
