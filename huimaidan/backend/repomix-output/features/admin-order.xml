 651:     /**
 652:      * 生成新的订单ID
 653:      *
 654:      * 本函数旨在生成一个唯一的、含有时间戳和随机数的订单ID，以确保订单ID的唯一性和可追踪性。
 655:      * 使用了微秒级时间戳和随机数来增加订单ID的唯一性，避免了在高并发场景下的重复问题。
 656:      *
 657:      * @param string $type 订单类型前缀。用于区分不同类型的订单，如商品订单、服务订单等。
 658:      * @return string 返回新的订单ID。订单ID由类型前缀、微秒级时间戳和随机数组成。
 659:      */
 660:     public function getNewOrderId($type)
 661:     {
 662:         // 获取当前时间的微秒和秒部分
 663:         list($msec, $sec) = explode(' ', microtime());
 664: 
 665:         // 将微秒和秒转换为毫秒，并去掉小数点，用于提高ID的唯一性
 666:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
 667: 
 668:         // 生成订单ID：类型前缀 + 毫秒时间戳 + 随机数
 669:         // 随机数生成考虑了微秒时间戳的值，以避免在高并发情况下产生相同的随机数
 670:         $orderId = $type . $msectime . mt_rand(10000, max(intval($msec * 10000) + 10000, 98369));
 671: 
 672:         return $orderId;
 673:     }
