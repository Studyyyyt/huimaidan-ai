266:                 'reconciliation_id' => $reconciliation_id,
267:                 'type' => 0, // 订单类型标识。
268:             ];
269:         }
270: 
271:         // 遍历退款ID列表，构建退款类型的调账数据，并加入到数据数组中。
272:         foreach ($refund_ids as $item) {
273:             $data[] = [
