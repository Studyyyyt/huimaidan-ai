3873:         $orderProduct->reservation_time_part = $data['part_start'] .' - ' .$data['part_end'];
3874: 
3875:         try {
3876:             Db::transaction(function () use ($order, $groupOrder, $orderProduct, $serviceId) {
3877:                 $order->save();
3878:                 $groupOrder->save();
3879:                 $orderProduct->save();
3880:                 // 构建订单状态变更信息
3881:                 $orderStatus = [
