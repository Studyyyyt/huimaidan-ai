 30:         return StoreCart::class;
 31:     }
 32: 
 33:     /**
 34:      * 检查购物车项是否有效并存在交叉
 35:      *
 36:      * 本函数用于验证给定的购物车ID列表中，是否存在属于特定用户（$uid）且满足特定条件（如未删除、未失败、未支付）的购物车项。
 37:      * 如果提供了$merId，则还会检查这些购物车项是否属于指定的商家。
 38:      *
 39:      * @param array $ids 购物车ID列表
 40:      * @param int $uid 用户ID
 41:      * @param int|null $merId 商家ID（可选），用于过滤属于特定商家的购物车项
 42:      * @return array 有效并存在交叉的购物车ID列表
 43:      */
 44:     public function validIntersection(array $ids, $uid, int $merId = null, string $touristUniqueKey = ''): array
 45:     {
 46:         // 从数据库中获取满足条件的购物车项的cart_id列
 47:         return StoreCart::getDB()->whereIn('cart_id', $ids)
 48:             // 如果提供了商家ID，则进一步过滤出属于该商家的购物车项
 49:             ->when($merId, function ($query, $merId) {
 50:                 $query->where('mer_id', $merId);
 51:             })
 52:             ->when($touristUniqueKey, function ($query, $touristUniqueKey) {
 53:                 $query->where('tourist_unique_key', $touristUniqueKey);
 54:             })
 55:             // 过滤出未删除、未失败、未支付的购物车项
 56:             ->where('is_del', 0)->where('is_fail', 0)->where('is_pay', 0)
 57:             // 过滤出属于指定用户的购物车项
 58:             ->where('uid', $uid)->column('cart_id');
 59:     }
 60: 
 61:     /**
 62:      * 获取用户的所有购物车商品
 63:      *
 64:      * 本函数用于根据用户ID查询该用户购物车中所有未删除、未标记为新、未支付的商品。
 65:      * 查询时会包括商品的基本信息、属性信息，以及（注释掉的）商家信息。
 66:      * 查询结果按照创建时间降序排列，并限制返回结果的数量。
 67:      *
 68:      * @param int $uid 用户ID
 69:      * @return \think\Paginator 返回查询结果的分页器对象
 70:      */
 71:     public function getAll(int $uid)
