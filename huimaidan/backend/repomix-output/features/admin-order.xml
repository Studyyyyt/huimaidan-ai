2864:     /**
2865:      * 核验并核销订单。
2866:      *
2867:      * 本函数用于验证订单的存在性、支付状态，并对指定的订单进行核销操作。
2868:      * 核销操作包括分割订单、更新订单状态、记录订单变更，并触发相关的事件。
2869:      *
2870:      * @param int $id 订单ID
2871:      * @param int $merId 商家ID
2872:      * @param array $data 包含验证码和待核销商品数量的数据
2873:      * @param int $serviceId 服务人员ID，默认为0表示管理员操作
2874:      * @throws ValidateException 如果订单不存在、未支付或已全部核销，则抛出验证异常
2875:      */
2876:     public function verifyOrder($order, array $data, $serviceId = 0)
2877:     {
2878:         // 构建待核销商品的数量映射
2879:         foreach ($data['data'] as $v) {
2880:             $splitData[$v['id']] = $v['num'];
2881:         }
2882:         // 调用订单分割函数进行订单核销操作，并更新订单对象
2883:         $spl = app()->make(StoreOrderSplitRepository::class)->splitOrder($order, $splitData, $serviceId, 1);
2884:         if ($spl) $order = $spl;
2885: 
2886:         // 更新订单状态为已核销，并设置核销时间和服务人员ID
2887:         $order->status = 2;
2888:         $order->verify_time = date('Y-m-d H:i:s');
2889:         $order->verify_service_id = $serviceId;
2890: 
2891:         // 触发订单核销前的事件
2892:         event('order.verify.before', compact('order'));
2893: 
2894:         // 实例化订单状态仓库，用于后续订单状态的变更记录
2895:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
2896:         // 使用事务处理订单状态的更新和订单变更日志的记录
2897:         Db::transaction(function () use ($order, $storeOrderStatusRepository, $serviceId) {
2898:             // 执行订单核销后的处理逻辑
2899:             $this->takeAfter($order, $order->user);
2900:             // 保存更新后的订单信息
2901:             $order->save();
2902:             // 构建订单状态变更信息
2903:             $orderStatus = [
2904:                 'order_id' => $order->order_id,
2905:                 'order_sn' => $order->order_sn,
2906:                 'type' => $storeOrderStatusRepository::TYPE_ORDER,
2907:                 'change_message' => '订单已核销',
2908:                 'change_type' => $storeOrderStatusRepository::ORDER_STATUS_TAKE,
2909:             ];
2910:             // 根据服务人员ID是否存在，分别记录服务人员日志或管理员日志
2911:             if ($serviceId) {
2912:                 $storeOrderStatusRepository->createServiceLog($serviceId, $orderStatus);
2913:             } else {
2914:                 $storeOrderStatusRepository->createAdminLog($orderStatus);
2915:             }
2916:         });
2917: 
2918:         // 触发订单核销完成后的事件
2919:         event('order.verify', compact('order'));
2920:         // 触发小程序发货管理事件，用于后续的发货操作
2921:         // 小程序发货管理
2922:         event('mini_order_shipping', ['product', $order, OrderStatus::DELIVER_TYPE_VERIFY, '', '']);
2923:     }
