 212:     /**
 213:      * 修改订单支付方式
 214:      *
 215:      * 本函数用于更改订单组的支付方式。通过使用数据库事务，确保在更改订单组的支付类型时，订单组内所有订单的支付方式都能一致地更新。
 216:      * 这样可以维护数据的一致性和完整性，避免因单个订单更新失败而导致整个订单组的数据不一致。
 217:      *
 218:      * @param StoreGroupOrder $groupOrder 订单组对象，包含需要更改支付方式的所有订单。
 219:      * @param int $pay_type 新的支付方式标识，用于更新订单的支付方式。
 220:      */
 221:     public function changePayType(StoreGroupOrder $groupOrder, int $pay_type)
 222:     {
 223:         // 开启数据库事务处理
 224:         Db::transaction(function () use ($groupOrder, $pay_type) {
 225:             // 直接更新订单组的支付方式
 226:             $groupOrder->pay_type = $pay_type;
 227: 
 228:             // 遍历订单组中的每个订单，逐一更新支付方式
 229:             foreach ($groupOrder->orderList as $order) {
 230:                 $order->pay_type = $pay_type;
 231:                 // 保存每个订单的更改，确保每个订单的支付方式都被更新
 232:                 $order->save();
 233:             }
 234: 
 235:             // 保存订单组的更改，完成支付方式的更新
 236:             $groupOrder->save();
 237:         });
 238:     }
