 85:      * 主要用于统计或处理超时未完成配送的订单。
 86:      *
 87:      * @param string $start 查询开始时间，格式为日期字符串
 88:      * @param string $end 查询结束时间，格式为日期字符串
 89:      * @return array 返回符合条件的订单ID列表
 90:      */
 91:     public function getTimeoutDeliveryOrder($start, $end)
 92:     {
 93:         // 使用数据库查询语言构造查询语句
 94:         return StoreOrderStatus::getDB()->alias('A')->leftJoin('StoreOrder B', 'A.order_id = B.order_id')
 95:             ->whereIn('A.change_type', [StoreOrderStatusRepository::ORDER_DELIVERY_SELF, StoreOrderStatusRepository::ORDER_DELIVERY_NOTHING, StoreOrderStatusRepository::ORDER_DELIVERY_COURIER])
 96:             ->where('A.type', 'order')
 97:             ->whereBetweenTime('A.change_time', $start, $end)
 98:             ->where('B.paid', 1)->where('B.status', 1)
 99:             ->column('A.order_id');
100:     }
101: }
