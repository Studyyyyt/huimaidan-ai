2309:      *
2310:      * @param array $where 查询条件
2311:      * @param int $page 分页页码
2312:      * @param int $limit 分页限制条数
2313:      * @return array 返回包含总数和列表的数据数组
2314:      */
2315:     public function reconList($where, $page, $limit)
2316:     {
2317:         // 根据条件获取订单ID列表
2318:         $ids = app()->make(MerchantReconciliationOrderRepository::class)->getIds($where);
2319: 
2320:         // 构建查询订单的查询构建器
2321:         $query = $this->dao->search([], null)->whereIn('order_id', $ids);
2322: 
2323:         // 计算符合条件的订单总数
2324:         $count = $query->count();
2325: 
2326:         // 分页查询订单，并处理每条订单数据
2327:         $list = $query->with(['orderProduct'])->page($page, $limit)->select()->each(function ($item) {
2328:             // 计算订单的佣金比例
2329:             //(实付金额 - 一级佣金 - 二级佣金) * 抽成
2330:             $commission_rate = ($item['commission_rate'] / 100);
2331:             // 计算订单的扩展费用（一级佣金 + 二级佣金）
2332:             // 佣金
2333:             $_order_extension = bcadd($item['extension_one'], $item['extension_two'], 3);
2334:             // 计算订单的手续费
2335:             // 手续费 =  (实付金额 - 一级佣金 - 二级佣金) * 比例
2336:             $_order_rate = bcmul(bcsub($item['pay_price'], $_order_extension, 3), $commission_rate, 3);
2337:             // 对扩展费用和手续费四舍五入到小数点后两位
2338:             $item['order_extension'] = round($_order_extension, 2);
2339:             $item['order_rate'] = round($_order_rate, 2);
2340:             return $item;
2341:         });
2342: 
2343:         // 返回订单总数和列表的数组
2344:         return compact('count', 'list');
2345:     }
