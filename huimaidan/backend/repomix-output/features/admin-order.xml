 525:     /**
 526:      *  多个商品 指定数量申请退款操作
 527:      * @param StoreOrder $order
 528:      * @param array $refund
 529:      * @param array $data
 530:      * @param $products
 531:      * @param int $isCreate
 532:      * @param int $userType
 533:      * @return mixed
 534:      * @author Qinii
 535:      * @day 2023/7/13
 536:      */
 537:     public function refundEach(StoreOrder $order, array $refund, array $data, $products)
 538:     {
 539:         $productIds              = array_keys($refund);
 540:         $nums                    = array_values($refund);
 541:         $orderId                 = $order->order_id;
 542:         $uid                     = $order->uid;
 543:         $productRefundPriceData  = app()->make(StoreRefundProductRepository::class)->userRefundPrice($productIds);
 544:         $data['order_id']        = $orderId;
 545:         $data['uid']             = $uid;
 546:         $data['mer_id']          = $order->mer_id;
 547:         $data['refund_order_sn'] = app()->make(StoreOrderRepository::class)->getNewOrderId(StoreOrderRepository::TYPE_SN_REFUND);
 548:         $refund_order_id         = 0;
 549:         $data['refund_num'] = 0;
 550:         foreach ($products as $product) {
 551:             $num       = $refund[$product['order_product_id']];
 552:             $productId = $product['order_product_id'];
 553:             if ($product['refund_num'] < $num) throw new ValidateException('可退款商品不足' . floatval($num) . '件');
 554:             $productRefundPrice = $productRefundPriceData[$productId] ?? [];
 555:             [$refundOrder, $refundProduct, $total] = $this->getRefundData($order, $product, $data, $num, $productRefundPrice);
 556:             $data['refund_postage']           = bcadd($data['refund_postage'] ?? 0, $refundOrder['refund_postage'], TOP_PRECISION);
 557:             $data['platform_refund_price']    = bcadd($data['platform_refund_price'] ?? 0, $refundOrder['platform_refund_price'], TOP_PRECISION);
 558:             $data['integral']                 = $data['integral'] ?? 0 + $refundOrder['integral'];
 559:             $data['refund_num']               += $refundOrder['refund_num'];
 560:             $data['extension_one']            = bcadd($data['extension_one'] ?? 0, $refundOrder['extension_one'], TOP_PRECISION);
 561:             $data['extension_two']            = bcadd($data['extension_two'] ?? 0, $refundOrder['extension_two'], TOP_PRECISION);
 562:             $totalRefundPrice                 = bcadd($totalRefundPrice ?? 0, $total, TOP_PRECISION);
 563:             $refundProduct['refund_order_id'] = &$refund_order_id;
 564:             $refundProducts[]                 = $refundProduct;
 565:         }
 566: 
 567:         if($order->order_type == 2) {
 568:             $data['refund_postage'] = 0;
 569:             // 已经申请退款的总数量
 570:             $refundTotalNum = 0;
 571:             $refundInfo = $this->getSearch(['order_id' => $order->order_id])->whereIn('status',[0,1,2,3])->with('refundProduct')->select()->toArray();
 572:             foreach($refundInfo as $item) {
 573:                 $refundTotalNum += array_sum(array_column($item['refundProduct'],'refund_num'));
 574:             }
 575:             // 订单总数量
 576:             $orderGroupTotalNum = app()->make(StoreGroupOrderRepository::class)->getSearch(['group_order_id' => $order->group_order_id])->sum('total_num');
 577:             // 如果申请退款的总数量加上当前要退款的数量等于订单分组总数量，说明是全退，同城配送全退才包含运费
 578:             if(bcadd($refundTotalNum, array_sum($nums)) == $orderGroupTotalNum) {
 579:                 $data['refund_postage'] = $order->total_postage;
 580:             }
 581:         }
 582: 
 583:         if ($totalRefundPrice < $data['refund_price'])
 584:             throw new ValidateException('最高可退款' . floatval($totalRefundPrice) . '元');
 585:         $storeRefundProductRepository = app()->make(StoreRefundProductRepository::class);
 586:         return Db::transaction(function () use ($order, $data, $products, $refundProducts, &$refund_order_id, $storeRefundProductRepository, $refund) {
 587:             event('refund.create.before', compact('data'));
 588:             $refundCreate    = $this->dao->create($data);
 589:             $refund_order_id = $refundCreate->refund_order_id;
 590:             $storeRefundProductRepository->insertAll($refundProducts);
 591:             // 是否退款 0:未退款 1:退款中 2:部分退款 3=全退
 592:             foreach ($products as $product) {
 593:                 $num                 = $refund[$product['order_product_id']];
 594:                 $product->refund_num -= $num;
 595:                 $product->is_refund  = 1;
 596:                 $product->save();
 597:             }
 598:             $this->applyRefundAfter($refundCreate, $order);
 599:             return $refundCreate;
 600:         });
 601:     }
