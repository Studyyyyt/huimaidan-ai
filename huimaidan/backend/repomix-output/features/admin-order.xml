115:      * 主要用于在系统中查询用户的特定订单详情，特别是涉及到优惠券发放等附加信息时。
116:      *
117:      * @param int $uid 用户ID，用于指定查询的用户。
118:      * @param int $id 订单ID，用于指定查询的订单。
119:      * @return object 返回包含订单信息，如果找不到订单则为NULL。
120:      */
121:     public function status($uid, $id)
122:     {
123:         // 根据用户ID和订单ID查询订单信息，并附加'give_coupon'信息
124:         return $this->search(['uid' => $uid])->where('group_order_id', $id)->append(['give_coupon'])->find();
125:     }
126: 
127: 
128:     /**
129:      * 根据订单组ID获取已取消订单的详细信息
130:      *
131:      * 本函数旨在查询特定订单组中被取消的订单详情。它通过指定的订单组ID过滤数据，
132:      * 并返回满足条件（未支付且已删除）的第一个订单记录。查询结果包括订单的基本信息
133:      * 以及订单中的产品详情。
134:      *
135:      * @param int $id 订单组的ID
136:      * @return \think\Model|null 返回满足条件的订单模型对象，如果找不到符合条件的订单则返回null
137:      */
138:     public function getCancelDetail($id)
139:     {
140:         // 使用where方法指定查询条件（订单未支付且已删除），并指定订单组ID
141:         // 使用with方法加载订单列表中的产品信息
142:         // 最后使用find方法查询并返回满足条件的第一个订单记录
143:         return $this->search(['paid' => 0, 'is_del' => 1])->where('group_order_id', $id)->with(['orderList.orderProduct'])->find();
144:     }
145: 
146:     /**
147:      * 取消团单功能
148:      * 此函数用于取消未支付的团单。如果团单已支付，则无法取消。
149:      * @param int $id 团单ID
150:      * @param int|null $uid 用户ID，可选参数，用于指定操作用户
151:      * @throws ValidateException 如果团单不存在或已支付，则抛出验证异常
152:      */
153:     public function cancel($id, $uid = null)
154:     {
155:         // 查询未支付的团单信息，包括订单列表
156:         $groupOrder = $this->search(['paid' => 0, 'uid' => $uid ?? ''])->where('group_order_id', $id)->with(['orderList'])->find();
157:         // 如果团单不存在，则抛出异常
158:         if (!$groupOrder)
159:             throw new ValidateException('订单不存在');
160:         // 如果团单已支付，则抛出异常
161:         if ($groupOrder['paid'] != 0)
162:             throw new ValidateException('订单状态错误,无法删除');
163:         Log::info('取消订单ID：' . $id.',uid:'.$uid);
164:         // 使用事务处理来确保操作的完整性
165:         Db::transaction(function () use ($groupOrder, $id, $uid) {
166:             // 标记团单为已删除
167:             $groupOrder->is_del = 1;
168:             $orderStatus = [];
169: 
170:             // 如果团单涉及积分，退回积分给用户
171:             // 退回积分
172:             if ($groupOrder->integral > 0) {
173:                 $make = app()->make(UserRepository::class);
174:                 // 更新用户积分
175:                 $make->update($groupOrder->uid, ['integral' => Db::raw('integral+' . $groupOrder->integral)]);
176:                 // 记录积分变动
177:                 app()->make(UserBillRepository::class)->incBill($groupOrder->uid, 'integral', 'cancel', [
178:                     'link_id' => $groupOrder['group_order_id'],
179:                     'status' => 1,
180:                     'title' => '退回积分',
181:                     'number' => $groupOrder['integral'],
182:                     'mark' => '订单自动关闭,退回' . intval($groupOrder->integral) . '积分',
183:                     'balance' => $make->get($groupOrder->uid)->integral
184:                 ]);
185:             }
186: 
187:             // 遍历团单中的每个订单，进行处理
188:             // 订单记录
189:             $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
190:             foreach ($groupOrder->orderList as $order) {
191:                 // 如果订单是预售订单，则将预售订单状态重置
192:                 if ($order->activity_type == 3 && $order->presellOrder) {
193:                     $order->presellOrder->status = 0;
194:                     $order->presellOrder->save();
195:                 }
196:                 // 标记订单为已删除
197:                 $order->is_del = 1;
198:                 $order->save();
199:                 // 记录订单状态变更
200:                 $orderStatus[] = [
201:                     'order_id' => $order->order_id,
202:                     'order_sn' => $order->order_sn,
203:                     'type' => $storeOrderStatusRepository::TYPE_ORDER,
204:                     'change_message' => '取消订单',
205:                     'change_type' => $storeOrderStatusRepository::ORDER_STATUS_CANCEL,
206:                     'uid' => $uid ?:0 ,
207:                     'nickname' => $uid ? $order->user->nickname : '系统',
208:                     'user_type' => $uid ? $storeOrderStatusRepository::U_TYPE_USER : $storeOrderStatusRepository::U_TYPE_SYSTEM,
209:                 ];
210:             }
211:             // 更新团单信息
212:             $groupOrder->save();
213:             // 批量创建订单状态日志
214:             $storeOrderStatusRepository->batchCreateLog($orderStatus);
215:         });
216: 
217:         // 将团单取消操作加入队列，异步处理
218:         Queue::push(CancelGroupOrderJob::class, $id);
219:     }
220: 
221: 
222:     /**
223:      * 检查是否为VIP优惠券
224:      *
225:      * 本函数用于确定传入的团购订单所使用的优惠券是否为VIP专属优惠券。
226:      * 它首先检查订单是否关联了优惠券ID，然后查询该优惠券的详细信息，最后判断该优惠券的类型是否为VIP专属。
227:      *
228:      * @param \App\Models\GroupOrder $groupOrder 团购订单对象，包含优惠券ID
229:      * @return bool 如果优惠券是VIP专属，则返回true；否则返回false。
230:      */
231:     public function isVipCoupon($groupOrder)
232:     {
233:         // 检查订单是否关联了优惠券ID，如果没有，则不是VIP优惠券，直接返回false
234:         if (!$groupOrder->coupon_id) {
235:             return false;
236:         }
237: 
238:         // 通过优惠券用户仓库查询优惠券ID，这一步是为了确认优惠券是否存在并有效
239:         $cid = app()->make(StoreCouponUserRepository::class)->query(['coupon_user_id' => $groupOrder->coupon_id])->value('coupon_id');
240: 
241:         // 如果查询到了优惠券ID，进一步通过优惠券仓库查询该优惠券的发送类型，以确定是否为VIP专属
242:         if ($cid) {
243:             return app()->make(StoreCouponRepository::class)->query(['coupon_id' => $cid])->value('send_type') === StoreCouponRepository::GET_COUPON_TYPE_SVIP;
244:         }
245: 
246:         // 如果没有查询到优惠券ID，或者查询的优惠券不是VIP专属，则返回false
247:         return false;
248:     }
249: 
250:     /**
251:      * 验证用户是否下了第一个订单
252:      *
253:      * 本函数用于判断指定用户的订单中是否存在已支付的第一个订单。
254:      * 如果存在已支付的订单，则说明用户已经下了第一个订单，返回0。
255:      * 如果不存在已支付的订单，则说明用户尚未下第一个订单，返回1。
256:      *
257:      * @param int $uid 用户ID
258:      *               用户的唯一标识符，用于查询订单信息。
259:      * @return int 返回0或1，表示用户是否已下第一个订单。
260:      *             0表示已下第一个订单，1表示尚未下第一个订单。
261:      */
262:     public function validateOrderIsFirst(int $uid)
263:     {
264:         // 查询已支付的订单数量
265:         // 如果返回值大于0，则说明存在已支付的订单，即用户已下第一个订单。
266:         // 如果返回值为0，则说明不存在已支付的订单，即用户尚未下第一个订单。
267:         return $this->search(['uid' => $uid, 'paid' => 1])->count() > 0 ? 0 : 1;
268:     }
269: 
270: }
