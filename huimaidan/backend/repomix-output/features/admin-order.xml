181:                 $newOrder['total_num'] += $newProduct['product_num'];
182:                 $newOrder['total_price'] = bcadd($newOrder['total_price'], $newProduct['total_price'], 2);
183:                 $newOrder['total_postage'] = bcadd($newOrder['total_postage'], $newProduct['postage_price'], 2);
184:                 $newOrder['pay_postage'] = $newOrder['total_postage'];
185:                 $newOrder['extension_one'] = bcadd($newOrder['extension_one'], $extension_one, 2);
