1708:         $deliveryStation = $deliveryStationRepository->deliveryStationInfo($merchantCart['take_id'], $merchantCart['mer_id']);
1709: 
1710:         $checkMethod = self::RANGE_TYPE_METHOD[$deliveryStation['range_type']];
