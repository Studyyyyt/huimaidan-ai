3819:                     'change_type' => StoreOrderStatusRepository::RESERVATION_ORDER_DISPATCH,
3820:                 ];
3821:                 // 根据服务人员ID是否存在，分别记录服务人员日志或管理员日志
3822:                 $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
3823:                 if ($serviceId) {
3824:                     $storeOrderStatusRepository->createServiceLog($serviceId, $orderStatus);
3825:                 } else {
3826:                     $storeOrderStatusRepository->createAdminLog($orderStatus);
3827:                 }
3828:             });
