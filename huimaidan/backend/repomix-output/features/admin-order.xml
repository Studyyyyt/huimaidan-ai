1582:                     if (($count + $pay_count) > $cart['product']['once_max_count']) {
1583:                         throw new ValidateException('[超出限购总数：' . $cart['product']['once_max_count'] . ']' . mb_substr($cart['product']['store_name'], 0, 10) . '...');
1584:                     }
1585:                 } else {
1586:                     if ($cart['product']['once_min_count'] > 0 && $cart['product']['once_min_count'] > $cart['cart_num']) {
1587:                         throw new ValidateException('[低于起购数:' . $cart['product']['once_min_count'] . ']' . mb_substr($cart['product']['store_name'], 0, 10) . '...');
1588:                     }
1589:                 }
1590:             } else {
1591:                 if (($order_type != 10 && $k != 0) || (count($data['merIds']) != 1) ) {
1592:                     throw new ValidateException('活动商品必须单独购买');
1593:                 }
1594:             }
1595:         }
1596:         return [$order_type, $order_model, $mer_form_id];
