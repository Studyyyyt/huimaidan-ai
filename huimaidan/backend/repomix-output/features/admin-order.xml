 48:                         break;
 49:                     case 4: // 待评价
 50:                         $query->where('StoreOrder.status',2)->where('StoreOrder.is_del',0);
 51:                         break;
 52:                     case 5: // 交易完成
 53:                         $query->where('StoreOrder.status',3)->where('StoreOrder.is_del',0);
 54:                         break;
 55:                     case 6: // 已退款
 56:                         $query->where('StoreOrder.status',-1)->where('StoreOrder.is_del',0);
 57:                         break;
 58:                     case 7: // 已删除
 59:                         $query->where('StoreOrder.is_del',1);
 60:                         break;
 61:                     case 8: // 全部
 62:                         $query->where('StoreOrder.is_del', 0);
 63:                         break;
 64:                     default:
 65:                         $query->where(true);
 66:                         break;
 67:                 }
 68:                 // 当关键字存在时，搜索订单号、真实姓名或用户电话中包含关键字的记录
 69:                 $query->when(isset($where['keyword']) && $where['keyword'] !== '' ,function($query)use($where){
 70:                     $query->whereLike("order_sn|real_name|user_phone","%{$where['keyword']}%");
 71:                 });
 72:             });
 73:         }else{
 74:             // 如果没有指定订单类型和关键字，直接查询所有订单收据
 75:             $query = StoreOrderReceipt::alias('StoreOrderReceipt');
 76:         }
 77: 
 78:         // 根据状态筛选
 79:         $query->when(isset($where['status']) && $where['status'] !== '' ,function($query)use($where){
 80:             $query->where('StoreOrderReceipt.status',$where['status']);
 81:         });
 82:         // 根据日期范围筛选
 83:         $query->when(isset($where['date']) && $where['date'] !== '' ,function($query)use($where){
 84:             getModelTime($query,$where['date'],'StoreOrderReceipt.create_time');
 85:         });
 86:         // 根据收据号筛选
 87:         $query->when(isset($where['receipt_sn']) && $where['receipt_sn'] !== '' ,function($query)use($where){
 88:             $query->where('StoreOrderReceipt.receipt_sn',$where['receipt_sn']);
 89:         });
 90:         // 根据用户名筛选
 91:         $query->when(isset($where['username']) && $where['username'] !== '' ,function($query)use($where){
 92:             $uid = User::whereLike('nickname|phone',"%{$where['username']}%")->column('uid');
 93:             $query->where('StoreOrderReceipt.uid','in',$uid);
 94:         });
 95:         $query->when(isset($where['phone']) && $where['phone'] !== '' ,function($query)use($where){
 96:             $uid = User::whereLike('phone',"%{$where['phone']}%")->column('uid');
 97:             $query->whereIn('StoreOrderReceipt.uid',$uid);
 98:         });
 99:         $query->when(isset($where['nickname']) && $where['nickname'] !== '' ,function($query)use($where){
100:             $uid = User::whereLike('nickname',"%{$where['nickname']}%")->column('uid');
101:             $query->where('StoreOrderReceipt.uid','in',$uid);
102:         });
103:         // 根据商户ID筛选
104:         $query->when(isset($where['mer_id']) && $where['mer_id'] !== '' ,function($query)use($where){
105:             $query->where('StoreOrderReceipt.mer_id',$where['mer_id']);
106:         });
107:         // 根据用户ID筛选
108:         $query->when(isset($where['uid']) && $where['uid'] !== '' ,function($query)use($where){
109:             $query->where('StoreOrderReceipt.uid',$where['uid']);
110:         });
111: 
112:         // 按创建时间降序排序
113:         return $query->order('StoreOrderReceipt.create_time DESC');
