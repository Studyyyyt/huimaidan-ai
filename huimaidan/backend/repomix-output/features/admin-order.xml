 60:         'key.require' => '订单操作超时,请刷新页面'
 61:     ];
 62: 
 63:     protected $scene = [
 64:         'orderCheck'  =>  ['uid', 'cart_ids', 'address_id', 'delivery_way', 'use_coupon', 'is_free_shipping', 'use_integral'],
 65:         'config' => ['uid'],
 66:         'orderCreate' => [
 67:             'uid',
 68:             'cart_ids',
 69:             'address_id',
 70:             'delivery_way',
 71:             'use_coupon',
 72:             'key',
 73:             'pay_type',
 74:             'mark',
 75:             'old_pay_price'
 76:         ],
 77:         'orderPay' => ['id', 'uid', 'pay_type', 'phone', 'sms_code', 'auth_code'],
 78:         'payStatus' => ['id', 'uid', 'pay_type'],
 79:         'reschedule' => ['order_type', 'real_name', 'user_phone', 'user_address', 'order_extend','reservation_date','part_start', 'part_end'],
 80:         'reservation_time' => ['reservation_date', 'part_start', 'part_end']
 81:     ];
 82: 
 83:     public function sceneCheck(array $data): bool
 84:     {
 85:         if (!$this->scene('orderCheck')->check($data)) {
 86:             return false;
 87:         }
 88: 
 89:         if ($data['uid'] != 0 && !empty($data['tourist_unique_key'])) {
 90:             $this->error = '用户id和游客唯一标识不能同时存在';
 91:             return false;
 92:         }
 93: 
 94:         if ($data['uid'] == 0 && empty($data['tourist_unique_key'])) {
 95:             $this->error = '游客唯一标识不能为空';
 96:             return false;
 97:         }
 98: 
 99:         return true;
100:     }
101: 
102:     public function sceneCreate(array $data, $merchant): bool
103:     {
104:         if (!$this->scene('orderCreate')->check($data)) {
105:             return false;
106:         }
107:         if ($data['uid'] != 0 && !empty($data['tourist_unique_key'])) {
108:             $this->error = '用户id和游客唯一标识不能同时存在';
109:             return false;
110:         }
111:         if ($data['uid'] == 0 && empty($data['tourist_unique_key'])) {
112:             $this->error = '游客唯一标识不能为空';
113:             return false;
114:         }
115:         if ($data['delivery_way'] == 0 && empty($data['address_id'])) {
116:             $this->error = '地址id不能为空';
117:             return false;
118:         }
119:         if ($data['pay_type'] == 'offline') {
120:             if (!systemConfig('offline_switch')) {
121:                 $this->error = '未开启线下支付功能';
122:                 return false;
123:             }
124:             if (!(($merchant['offline_switch']) ?? '')) {
125:                 $this->error = '该店铺未开启线下支付';
126:                 return false;
127:             }
128:         }
129: 
130:         return true;
131:     }
132: 
133:     public function scenePayConfig(array $data): bool
134:     {
135:         if (!$this->scene('config')->check($data)) {
136:             return false;
137:         }
138: 
139:         return true;
140:     }
141: 
142:     public function scenePay(array $data, $groupOrder): bool
143:     {
144:         if (!$this->scene('orderPay')->check($data)) {
145:             return false;
146:         }
147:         if (!in_array($data['pay_type'], MerchantOrderCreateRepository::PAY_TYPE)) {
148:             $this->error = '请选择正确的支付方式';
149:             return false;
150:         }
151:         if (!$groupOrder) {
152:             $this->error = '订单不存在或已支付';
153:             return false;
154:         }
155:         if ($data['pay_type'] == 'offline') {
156:             if (count($groupOrder['orderList']) > 1) {
157:                 $this->error = '线下支付仅支持同店铺商品';
158:                 return false;
159:             }
160:             if (!systemConfig('offline_switch')) {
161:                 $this->error = '未开启线下支付功能';
162:                 return false;
163:             }
164:             if (!(($groupOrder['orderList'][0]->merchant['offline_switch']) ?? '')) {
165:                 $this->error = '该店铺未开启线下支付';
166:                 return false;
167:             }
168:         }
169:         if ($data['pay_type'] == 'balance' && $data['uid'] == 0) {
170:             $this->error = '游客不能使用余额支付，请检查支付方式';
171:             return false;
172:         }
173: 
174:         return true;
175:     }
176: 
177:     public function sceneStatus(array $data): bool
178:     {
179:         if (!$this->scene('payStatus')->check($data)) {
180:             return false;
181:         }
182:         return true;
183:     }
184: 
185:     public function sceneReservationReschedule(array $data): bool
186:     {
187:         if (!$this->scene('reschedule')->check($data)) {
188:             return false;
189:         }
190:         return true;
191:     }
192: 
193:     public function sceneOnlyReservationTime(array $data): bool
194:     {
195:         if (!$this->scene('reservation_time')->check($data)) {
196:             return false;
197:         }
198:         return true;
199:     }
200: }
