 167:     /**
 168:      * 使用余额支付用户订单
 169:      *
 170:      * 该方法用于处理用户使用余额支付订单的逻辑。它首先检查余额支付是否已开启，然后确保用户余额充足，
 171:      * 接着在事务中更新用户余额并记录消费记录，最后标记订单支付成功。
 172:      *
 173:      * @param User $user 当前进行支付的用户对象
 174:      * @param StoreGroupOrder $groupOrder 待支付的订单对象
 175:      * @return json 返回支付成功的响应信息，包括订单ID
 176:      * @throws ValidateException 如果支付方式未开启或用户余额不足，将抛出验证异常
 177:      */
 178:     public function payBalance(User $user, StoreGroupOrder $groupOrder)
 179:     {
 180: 
 181:         // 检查余额支付是否开启，如果没有开启则抛出异常
 182:         if (!systemConfig('yue_pay_status'))
 183:             throw new ValidateException('未开启余额支付');
 184:         $user = app()->make(UserRepository::class)->get($user->uid);
 185:         // 检查用户余额是否足够支付订单，如果不足则抛出异常
 186:         if ($user['now_money'] < $groupOrder['pay_price'])
 187:             throw new ValidateException('余额不足，请更换支付方式');
 188:         // 使用数据库事务来确保支付过程的原子性
 189:         Db::transaction(function () use ($user, $groupOrder) {
 190:             // 更新用户余额，这里使用bcsub确保金额精确减法
 191:             $user->now_money = bcsub($user->now_money, $groupOrder['pay_price'], 2);
 192:             $user->save();
 193: 
 194:             // 创建用户账单记录，记录用户的消费行为
 195:             $userBillRepository = app()->make(UserBillRepository::class);
 196:             $userBillRepository->decBill($user['uid'], 'now_money', 'pay_product', [
 197:                 'link_id' => $groupOrder['group_order_id'],
 198:                 'status' => 1,
 199:                 'title' => '购买商品',
 200:                 'number' => $groupOrder['pay_price'],
 201:                 'mark' => '余额支付支付' . floatval($groupOrder['pay_price']) . '元购买商品',
 202:                 'balance' => $user->now_money
 203:             ]);
 204:             // 标记订单支付成功，这可能包括更新订单状态等操作
 205:             $this->paySuccess($groupOrder);
 206:         });
 207: 
 208:         // 返回支付成功的响应信息，包括订单ID
 209:         return app('json')->status('success', '余额支付成功', ['order_id' => $groupOrder['group_order_id']]);
 210:     }
