247:      * @param int $mer_id
248:      * @param $type 统计类型 金额/数量/支付时间
249:      * @param $date 统计时间段
250:      * @param $limit
251:      * @return mixed
252:      * @author Qinii
253:      * @day 2023/11/28
254:      */
255:     public function getProductRate(int $mer_id, $date = '', $type = 'number', $limit = 10, string $group = 'P.product_id')
256:     {
257:         $query = StoreOrderProduct::getDB()->alias('P')->leftJoin('StoreOrder O', 'O.order_id = P.order_id')
258:             ->leftJoin('StoreProduct sp', 'sp.product_id = P.product_id')
259:             ->with(['product' => function ($query) {
260:                 $query->field('product_id,store_name,image');
261:             }])->where('O.paid', 1);
262:         switch($type){
263:             case 'number':
264:                 $field = "P.product_id,O.pay_price as number,sum(P.product_num) as count,P.create_time, P.order_id,O.mer_id";
265:                 break;
266:             case 'count':
267:                 $field = "P.product_id,sum(P.product_num) as count,O.pay_price as number,P.create_time, P.order_id,O.mer_id";
268:                 break;
269:             case 'paytime':
270:                 $field = 'P.product_id,O.pay_time paytime,O.pay_price as number,P.create_time, P.order_id,O.mer_id';
271:                 break;
272:             default:
273:                 $field = 'P.*';
274:                 break;
275:         }
276:         $query->when($mer_id, function ($query) use($mer_id) {
277:             $query->where('O.mer_id', $mer_id);
278:         })->when($date, function($query) use ($date) {
279:             getModelTime($query, $date,'P.create_time');
280:         })->whereNotNull('sp.product_id');
281: 
282:         return $query->field($field)->when(!empty($group), function ($query) use ($group) {
283:             $query->group($group);
284:         })->order("$type DESC,P.create_time DESC")->limit($limit)->select();
285:     }
