120:     /**
121:      * 计算订单金额
122:      * @return array
123:      * @author Qinii
124:      * @day 2023/4/20
125:      */
126:     public function validateMerchantList($merchantCartList)
127:     {
128:         $deliveryStatus = true;
129:         $order_total_num = 0;
130:         $order_total_price = 0;
131:         $order_total_integral = 0;
132:         $order_total_cost = 0;
133:         $order_pay_price = 0;
134:         foreach ($merchantCartList as &$merchantCart) {
135:             //每个商户的订单金额等
136:             //合计支付金额
137:             $total_price = 0;
138:             //合计商品数量
139:             $total_num = 0;
140:             //合计运费
141:             $postage_price = 0;
142:             //合计使用积分
143:             $total_integral = 0;
144:             //合计出厂价
145:             $total_cost = 0;
146:             //合计实际支付金额
147:             $pay_price = 0;
148:             //每个商户的商品列表，计算
149:             foreach ($merchantCart['list'] as $cart) {
150:                 if ($cart['cart_num'] <= 0) throw new ValidateException('购买商品数必须大于0');
151:                 $price = bcmul($cart['cart_num'], $cart['productAttr']['price'], 2);
152:                 $integral = bcmul($cart['cart_num'], $cart['productAttr']['ot_price'], 2);
153:                 $cost = bcmul($cart['cart_num'], $cart['productAttr']['cost'], 2);
154:                 $total_num += $cart['cart_num'];
155:                 $total_price = bcadd($total_price, $price, 2);
156:                 $total_integral = bcadd($total_integral, $integral, 2);
157:                 $total_cost = bcadd($total_cost, $cost, 2);
158:                 $pay_price = bcadd($pay_price, $price, 2);
159: 
160:                 $cart['true_price'] = $price;
161:                 $cart['total_price'] = $price;
162:                 $cart['postage_price'] = 0;
163:                 $cart['integral'] = (int)$integral;
164:                 $cart['extension_one'] = 0;
165:                 $cart['extension_two'] = 0;
166:                 $cart['cost'] = $total_cost;
167:             }
168:             unset($cart);
169:             if (count($merchantCartList) > 1 || count($merchantCart['list']) > 1) {
170:                 $orderDeliveryStatus = $orderDeliveryStatus && $deliveryStatus;
171:             }
172:             $order_total_num += $total_num;
173:             $order_total_price = bcadd($order_total_price,$total_price, 2);
174:             $order_total_cost = bcadd($order_total_cost,$total_cost,2);
175:             $order_pay_price = bcadd($order_pay_price,$pay_price,  2);
176:             $order_total_integral = bcadd($order_total_integral,$total_integral,2);
177:             $merchantCart['order'] = [
178:                 'total_num'  => $total_num,
179:                 'total_price'=> $total_price,
180:                 'total_cost' => $total_cost,
181:                 'pay_price'  => $pay_price,
182:                 'total_integral'=> $total_integral,
183:                 'postage_price' => $postage_price,
184:             ];
185:         }
186:         unset($merchantCart);
187:         return [
188:             'order_total_num' => $order_total_num,
189:             'order_pay_price' => $order_pay_price,
190:             'order_total_price' => $order_total_price,
191:             'order_total_integral' => (int)$order_total_integral,
192:             'order_total_cost' => $order_total_cost,
193:             'order_delivery_status' => $deliveryStatus,
194:             'order' => $merchantCartList
195:         ];
196:     }
