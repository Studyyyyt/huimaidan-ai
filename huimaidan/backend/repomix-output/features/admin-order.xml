2101:     public function applyPlatformIntervene($refundOrderId, $uid)
2102:     {
2103:         if (!systemConfig('platform_intervention')) {
2104:             throw new Exception('已关闭平台介入功能');
2105:         }
2106:         //状态 0:待审核 -1:审核未通过 1:待退货 2:待收货 3:已退款 4:平台介入
2107:         $refund = $this->dao->getWhere(['refund_order_id' => $refundOrderId, 'uid' => $uid], '*', ['refundProduct.product']);
2108:         if (!$refund) {
