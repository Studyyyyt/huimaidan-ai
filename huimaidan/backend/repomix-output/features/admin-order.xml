 702:     /**
 703:      * 根据商品类型获取购物车中商品的价格
 704:      *
 705:      * 本函数用于根据商品的不同类型，从购物车项中提取对应的价格。
 706:      * 商品类型包括预售价、辅助销售价格、活动价格和普通价格。
 707:      *
 708:      * @param array $cart 购物车项的数据数组，包含商品类型和相应的价格信息。
 709:      * @return float 返回对应的商品价格。如果商品类型不匹配任何预定义类型，则返回默认商品价格。
 710:      */
 711:     public function cartByPrice($cart)
 712:     {
 713:         // 检查商品类型是否为预售价
 714:         if ($cart['product_type'] == '2') {
 715:             return $cart['productPresellAttr']['presell_price'];
 716:             // 检查商品类型是否为辅助销售价格
 717:         } else if ($cart['product_type'] == '3') {
 718:             return $cart['productAssistAttr']['assist_price'];
 719:             // 检查商品类型是否为活动价格
 720:         } else if ($cart['product_type'] == '4') {
 721:             return $cart['activeSku']['active_price'];
 722:             // 默认情况下返回普通商品价格
 723:         } else {
 724:             return $cart['productAttr']['price'];
 725:         }
 726:     }
