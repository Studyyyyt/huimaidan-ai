425:                     'financial_pm' => 1,
426:                     'type' => 0,
427:                     'number' => $order->order->firstProfitsharing->profitsharing_mer_pric,
428:                     'mer_id' => $order->mer_id,
429:                     'financial_record_sn' => $sn . '1'
430:                 ], [
431:                     'order_id' => $order->order->order_id,
432:                     'order_sn' => $order->order->order_sn,
433:                     'user_info' => $order->user->nickname,
434:                     'user_id' => $order->uid,
