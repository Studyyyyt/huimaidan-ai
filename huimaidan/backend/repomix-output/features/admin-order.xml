100:         // 返回按照创建时间降序排序的查询构建器，用于进一步的查询操作或数据获取
101:         return $query->order('create_time DESC');
102:     }
103: 
104:     /**
105:      * 获取超时订单ID列表
106:      * 此函数用于查询并返回在指定时间之前创建的、未支付的订单ID列表。如果指定了需要提醒的订单，则只返回尚未提醒的订单ID。
107:      *
108:      * @param int $time 查询的截止时间，以时间戳形式表示。
109:      * @param bool $is_remind 是否查询需要提醒的订单，默认为false，表示不查询需要提醒的订单。
110:      * @return array 返回符合条件的订单ID列表。
111:      */
112:     public function getTimeOutIds($time, $is_remind = false)
113:     {
114:         // 根据条件构造查询语句，查询未删除、未支付的订单
115:         return StoreGroupOrder::getDB()->where('is_del', 0)->where('paid', 0)
116:             // 如果需要提醒，添加额外的查询条件，查询未提醒的订单
117:             ->when($is_remind, function ($query) {
118:                 $query->where('is_remind', 0);
119:             })
120:             // 查询创建时间早于等于指定时间的订单
121:             ->where('create_time', '<=', $time)
122:             // 返回满足条件的订单的group_order_id列
123:             ->column('group_order_id');
124:     }
125: 
126: 
127:     /**
128:      * 设置团购订单的提醒状态
129:      *
130:      * 本函数用于将指定团购订单的提醒状态设置为已提醒（1）。通过传入订单ID，查询到该订单后进行状态更新。
131:      * 主要用于在用户需要时，对特定团购订单设置提醒标记，以便系统或用户知道该订单已经进行过提醒操作。
132:      *
133:      * @param int $id 团购订单的ID
134:      * @return bool 更新操作的结果，成功返回true，失败返回false
135:      * @throws \think\db\exception\DbException
136:      */
137:     public function isRemind($id)
138:     {
139:         // 使用StoreGroupOrder类的静态方法getDB来获取数据库操作对象，并根据group_order_id为$id更新is_remind字段为1
140:         return StoreGroupOrder::getDB()->where('group_order_id', $id)->update(['is_remind' => 1]);
141:     }
142: 
143:     /**
144:      * 计算用户当前未支付订单的总金额
145:      *
146:      * 本函数通过查询数据库中指定用户的未支付订单，计算出这些订单的总支付价格。
147:      * 未支付订单是指支付类型（pay_type）为0的订单。
148:      *
149:      * @param int $uid 用户ID
150:      * @return float|int 返回用户未支付订单的总金额，如果没有未支付订单则返回0。
151:      */
152:     public function totalNowMoney($uid)
153:     {
154:         // 使用StoreGroupOrder的数据库实例，并指定查询条件为支付类型为0且用户ID为$uid的订单，计算这些订单的支付价格总和
155:         return StoreGroupOrder::getDB()->where('pay_type', 0)->where('uid', $uid)->sum('pay_price') ?: 0;
156:     }
157: }
