19: 
20: class StoreRefundProductDao extends BaseDao
21: {
22: 
23:     protected function getModel(): string
24:     {
25:         return StoreRefundProduct::class;
26:     }
27: 
28:     /**
29:      * 根据条件搜索订单。
30:      *
31:      * 本函数用于根据提供的条件数组搜索订单。它支持通过订单ID进行筛选，并且总是按照创建时间对结果进行排序。
32:      * 这种方法的设计允许灵活地添加更多的搜索条件，而不需要修改函数的主体结构。
33:      *
34:      * @param array $where 包含搜索条件的数组。其中可能包含订单ID等用于筛选订单的键值对。
35:      * @return \Illuminate\Database\Eloquent\Builder|static 返回一个构建器对象，用于进一步的查询操作或数据检索。
36:      */
37:     public function search(array $where)
38:     {
39:         // 从模型中获取数据库实例，并根据条件应用订单ID的筛选。
40:         $query = $this->getModel()::getDB()
41:             ->when(isset($where['order_id']) && $where['order_id'] !== '', function($query) use ($where) {
42:                 // 如果提供了订单ID，并且不为空，则在查询中添加订单ID的条件。
43:                 $query->where('order_id', $where['order_id']);
44:             });
45: 
46:         // 按照创建时间对查询结果进行排序。
47:         return $query->order('create_time');
48:     }
49: 
50:     /**
51:      * 根据订单产品ID数组，计算退款详情
52:      *
53:      * 本函数通过查询订单退款详情和退款订单信息，统计指定订单产品ID数组中每个订单产品的退款总金额、平台退款金额、退款邮费、退款积分等信息。
54:      * 主要用于在用户退款时，快速汇总相关退款数据。
55:      *
56:      * @param array $ids 订单产品ID数组
57:      * @return array 返回一个键为订单产品ID，值为包含各种退款详情的数组
58:      */
59:     public function userRefundPrice(array $ids)
60:     {
61:         // 构建查询语句，左连接退款订单表，筛选出状态大于-1的退款记录，按订单产品ID分组，计算各项退款金额和积分
62:         $lst = $this->getModel()::getDB()->alias('A')->leftJoin('StoreRefundOrder B', 'A.refund_order_id = B.refund_order_id')
63:             ->where('B.status', '>', -1)
64:             ->whereIn('A.order_product_id', $ids)->group('A.order_product_id')
65:             ->field('A.order_product_id, SUM(A.refund_price) as refund_price, SUM(A.platform_refund_price) as platform_refund_price, SUM(A.refund_postage) as refund_postage, SUM(A.refund_integral) as refund_integral')
66:             ->select()->toArray();
67: 
68:         // 将查询结果重新组织为以订单产品ID为键的数组，方便后续根据订单产品ID快速查找退款详情
69:         $data = [];
70:         foreach ($lst as $item) {
71:             $data[$item['order_product_id']] = $item;
72:         }
73: 
74:         // 返回重新组织后的数据数组
75:         return $data;
76:     }
77: }
