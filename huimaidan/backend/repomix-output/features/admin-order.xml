104: 
105: 
106:     /**
107:      *  创建对账单
108:      * @param $id
109:      * @param $data
110:      * @author Qinii
111:      * @day 2020-06-15
112:      */
113:     public function create(int $id, array $data)
114:     {
115:         $orderMake = app()->make(StoreOrderRepository::class);
116:         $refundMake = app()->make(StoreRefundOrderRepository::class);
117: 
118:         $bank = merchantConfig($id, 'bank');
119:         $bank_name = merchantConfig($id, 'bank_name');
120:         $bank_number = merchantConfig($id, 'bank_number');
121:         $bank_address = merchantConfig($id, 'bank_address');
122:         if (!$bank || !$bank_name || !$bank_number || !$bank_address)
123:             throw  new ValidateException('商户未填写银行卡信息');
124: 
125:         $order_ids = $data['order_ids'];
126:         $refund_order_ids = $data['refund_order_ids'];
127:         if ($data['order_type']) { //全选
128:             $order_ids = $orderMake->search([
129:                 'date' => $data['date'],
130:                 'mer_id' => $id,
131:                 'paid' => 1,
132:                 'order_id'
133:             ], null
134:             )->whereNotIn('order_id', $data['order_out_ids'])->column('order_id');
135:         }
136:         if ($data['refund_type']) { //全选
137:             $refund_order_ids = $refundMake->search([
138:                 'date' => $data['date'],
139:                 'mer_id' => $id,
140:                 'reconciliation_type' => 0,
141:                 'status' => 3
142:             ])->whereNotIn('refund_order_id', $data['refund_out_ids'])->column('refund_order_id');
143:         }
144:         if (is_array($order_ids) && (count($order_ids) < 1) && is_array($refund_order_ids) && (count($refund_order_ids) < 1)) {
145:             throw new ValidateException('没有数据可对账');
146:         }
147:         $compute = $this->compute($id, $order_ids, $refund_order_ids);
148:         $createData = [
149:             'status' => 0,
150:             'mer_id' => $id,
151:             'is_accounts' => 0,
152:             'mer_admin_id' => 0,
153:             'bank' => $bank,
154:             'bank_name' => $bank_name,
155:             'bank_number' => $bank_number,
156:             'bank_address' => $bank_address,
157:             'admin_id' => $data['adminId'],
158:             'price' => round($compute['price'], 2),
