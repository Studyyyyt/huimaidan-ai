 675:     /**
 676:      * 根据商品临时类型计算购物车中商品的总量。
 677:      * 该方法主要用于根据商品的不同类型（如重量型或体积型），来计算购物车中商品的总量。
 678:      * 对于重量型商品，总量是商品数量乘以重量；对于体积型商品，总量是商品数量乘以体积。
 679:      *
 680:      * @param array $cart 购物车数据，包含商品信息和数量。
 681:      * @return mixed 返回计算得到的商品总量，如果商品没有临时类型，则直接返回商品数量。
 682:      */
 683:     public function productByTempNumber($cart)
 684:     {
 685:         // 尝试获取商品的临时类型
 686:         $type = $cart['product']['temp']['type'] ?? null;
 687:         // 获取购物车中商品的数量
 688:         $cartNum = $cart['cart_num'];
 689: 
 690:         // 如果商品没有临时类型，则直接返回商品数量
 691:         if (!$type) {
 692:             return $cartNum;
 693:         } else if ($type == 2) {
 694:             // 如果商品是体积型，返回商品数量乘以体积
 695:             return bcmul($cartNum, $cart['productAttr']['volume'], 2);
 696:         } else {
 697:             // 如果商品是重量型，返回商品数量乘以重量
 698:             return bcmul($cartNum, $cart['productAttr']['weight'], 2);
 699:         }
 700:     }
