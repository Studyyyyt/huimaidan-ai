205:     /**
206:      * 检查订单是否满足开票条件
207:      *
208:      * 本函数用于验证一组订单是否可以合并开具发票，以及这些订单是否已支付。
209:      * 它首先通过订单ID查询相关订单信息，然后检查这些订单是否都已支付。
210:      * 如果所有订单都已支付，它还会检查这些订单的开票信息是否一致。
211:      * 如果开票信息不一致，或者有任何订单未支付，将抛出异常。
212:      * 最后，如果所有条件都满足，函数将返回唯一的开票信息数组。
213:      *
214:      * @param string $ids 订单ID的字符串，多个ID用逗号分隔
215:      * @return array 通过验证的唯一开票信息数组
216:      * @throws ValidateException 如果订单未支付或开票信息不一致，抛出此异常
217:      */
218:     public function check(string $ids)
219:     {
220:         // 根据订单ID查询订单及其支付状态
221:         $query = $this->dao->getSearch(['order_receipt_ids' => $ids])->with(['storeOrder' => function($query){
222:             $query->field('order_id,paid');
223:         }]);
224:         $result = $query->select();
225: 
226:         // 遍历查询结果，检查所有订单是否已支付
227:         foreach ($result as $item){
228:             if(!$item->storeOrder['paid']) throw new ValidateException('订单未支付不可开发票');
229:         }
230: 
231:         // 提取所有订单的开票信息
232:         $data = $query->column('receipt_info');
233: 
234:         // 去除重复的开票信息
235:         $arr = array_unique($data);
236: 
237:         // 如果存在重复的开票信息，抛出异常
238:         if(count($arr) > 1) throw new ValidateException('开票信息不相同，无法合并');
239: 
240:         // 返回唯一的开票信息数组
241:         return $arr;
242:     }
