  98:     /**
  99:      * 处理支付请求。
 100:      *
 101:      * 根据支付类型和用户信息，生成支付配置，支持多种支付方式包括余额支付、微信支付、支付宝支付等。
 102:      * 支持组合支付功能，以及移动端支付的特殊配置。在支付前会触发一个事件，允许其他功能模块对支付行为进行干预或附加操作。
 103:      *
 104:      * @param string $type 支付方式类型，包括'balance'（余额支付）、'weixin'（微信支付）、'alipay'（支付宝支付）等。
 105:      * @param User $user 进行支付的用户对象。
 106:      * @param StoreGroupOrder $groupOrder 需要支付的订单对象。
 107:      * @param string $return_url 支付成功后返回的URL，主要用于支付宝支付。
 108:      * @param bool $isApp 是否为APP支付，影响支付方式的后缀命名。
 109:      * @param null|string $combine 是否使用组合支付，如果为null，则从系统配置中获取。
 110:      * @return array 返回包含支付配置和订单ID的信息。
 111:      */
 112:     public function pay(string $type, ?User $user, StoreGroupOrder $groupOrder, $return_url = '', $isApp = false, $combine = null, $authCode = '')
 113:     {
 114:         // 如果支付方式为余额支付，则直接调用余额支付方法
 115:         if ($type === 'balance') {
 116:             return $this->payBalance($user, $groupOrder);
 117:         }
 118:         // 如果是APP支付，且支付方式为微信或支付宝，则在支付方式后添加App后缀
 119:         if (in_array($type, ['weixin', 'alipay'], true) && $isApp) {
 120:             $type .= 'App';
 121:         }
 122: 
 123:         // 判断是否使用组合支付，如果未指定，则从系统配置中获取默认值
 124:         if (is_null($combine)) {
 125:             $config = systemConfig(['open_wx_combine','wechat_service_tool']);
 126:             $combine = $config['open_wx_combine'];
 127:             if (
 128:                 $combine &&
 129:                 in_array($type, ['weixin', 'weixinApp', 'routine', 'h5', 'weixinQr','weixinBarCode'])
 130:             ) {
 131:                 if ($config['wechat_service_tool']) {
 132:                     if (
 133:                         $groupOrder['activity_type'] != 20 &&
 134:                         count($groupOrder['orderList']->toArray()) == 1 &&
 135:                         $groupOrder->orderList[0]->merchant->applyment_id && $groupOrder->orderList[0]->merchant->applyment_switch
 136:                     ) { $combine = true; }else{ $combine = false; }
 137:                 }
 138:             } else {
 139:                 $combine = false;
 140:             }
 141:         }
 142:         // 在支付前触发一个事件，允许其他功能模块对支付行为进行干预或附加操作
 143:         event('order.pay.before', compact('groupOrder', 'type', 'isApp'));
 144:         if ($combine) {
 145:             if ($config['wechat_service_tool']) {
 146:                 $service = new Pay('partner');
 147:                 $config = $service->pay($user,$type,$groupOrder->getTransactionsPayParams($authCode));
 148:             } else {
 149:                 $service = new CombinePayService($type, $groupOrder->getCombinePayParams());
 150:                 $config = $service->pay($user);
 151:             }
 152:             return app('json')->status($type, $config + ['order_id' => $groupOrder['group_order_id'], 'pay_price' => $groupOrder['pay_price']]);
 153:         } else {
 154:             $service = new PayService($type, $groupOrder->getPayParams($type === 'alipay' ? $return_url : '', $authCode));
 155:             // 生成支付配置
 156:             $config = $service->pay($user);
 157:             if($authCode && $config['paid'] == 1) {
 158:                 $orders['transaction_id'] = $config['transaction_id'];
 159:                 $this->paySuccess($groupOrder, 0, $orders);
 160:             }
 161: 
 162:             // 返回支付配置和订单ID，支付配置中包含支付方式的状态信息
 163:             return app('json')->status($type, $config + ['order_id' => $groupOrder['group_order_id'], 'pay_price' => $groupOrder['pay_price']]);
 164:         }
 165:     }
