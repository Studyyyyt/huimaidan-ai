 72:             $newOrder['total_num'] = 0;
 73:             $newOrder['total_price'] = 0;
 74:             $newOrder['total_postage'] = 0;
 75:             $newOrder['pay_price'] = 0;
 76:             $newOrder['pay_postage'] = 0;
 77:             $newOrder['extension_one'] = 0;
 78:             $newOrder['extension_two'] = 0;
 79:             $newOrder['coupon_price'] = 0;
 80:             $newOrder['platform_coupon_price'] = 0;
