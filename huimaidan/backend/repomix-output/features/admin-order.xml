316:                 'order_id' => $order->order->order_id,
317:                 'order_sn' => $order->order->order_sn,
318:                 'user_info' => $order->user->nickname,
319:                 'user_id' => $order->uid,
320:                 'financial_type' => 'presell_true',
321:                 'financial_pm' => 1,
322:                 'type' => 2,
