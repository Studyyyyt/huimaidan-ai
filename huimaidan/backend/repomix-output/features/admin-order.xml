 42: /**
 43:  * Class PresellOrderRepository
 44:  * @package app\common\repositories\store\order
 45:  * @author xaboy
 46:  * @day 2020/10/27
 47:  * @mixin PresellOrderDao
 48:  */
 49: class PresellOrderRepository extends BaseRepository
 50: {
 51:     public function __construct(PresellOrderDao $dao)
 52:     {
 53:         $this->dao = $dao;
 54:     }
 55: 
 56:     /**
 57:      * 创建订单
 58:      *
 59:      * 本函数用于创建一个新的订单。它通过收集用户ID、订单ID、价格以及订单的开始和结束时间，
 60:      * 来构造订单的基本信息。此外，它还会为预售价订单生成一个新的订单号。
 61:      *
 62:      * @param int $uid 用户ID。标识订单所属的用户。
 63:      * @param string $orderId 订单ID。用于唯一标识订单。
 64:      * @param float $price 订单价格。表示订单的总金额。
 65:      * @param int $final_start_time 订单开始时间。表示订单的有效起始时间。
 66:      * @param int $final_end_time 订单结束时间。表示订单的有效结束时间。
 67:      * @return bool|object 返回创建的订单对象或false，如果创建失败。
 68:      */
 69:     public function createOrder($uid, $orderId, $price, $final_start_time, $final_end_time)
 70:     {
 71:         // 通过DAO层创建订单，传入包括用户ID、订单ID、开始时间、结束时间、价格以及预售价订单号等信息。
 72:         return $this->dao->create([
 73:             'uid' => $uid,
 74:             'order_id' => $orderId,
 75:             'final_start_time' => $final_start_time,
 76:             'final_end_time' => $final_end_time,
 77:             'pay_price' => $price,
 78:             'presell_order_sn' => app()->make(StoreOrderRepository::class)->getNewOrderId(StoreOrderRepository::TYPE_SN_PRESELL)
 79:         ]);
 80:     }
 81: 
 82:     /**
 83:      * 处理预售订单的支付逻辑。
 84:      *
 85:      * 根据支付方式的不同，选择不同的支付处理方式。支持余额支付以及微信、支付宝等第三方支付。
 86:      * 对于移动端支付，会根据支付类型添加App后缀以区分支付渠道。
 87:      * 在支付前，会触发一个事件，允许其他功能模块在支付前进行额外的操作或校验。
 88:      * 根据支付类型和系统配置，选择使用合并支付服务或普通支付服务来生成支付配置。
 89:      *
 90:      * @param string $type 支付方式，可以是余额(balance)、微信(weixin)、支付宝(alipay)等。
 91:      * @param User $user 进行支付的用户对象。
 92:      * @param PresellOrder $order 预售订单对象。
 93:      * @param string $return_url 支付宝支付时的回调URL，可选。
 94:      * @param bool $isApp 是否为APP支付，用于区分微信支付的普通支付和APP支付。
 95:      * @return array 返回包含支付配置和订单ID的信息。
 96:      */
 97:     public function pay($type, User $user, PresellOrder $order, $return_url = '', $isApp = false)
 98:     {
 99:         // 如果是余额支付，则直接调用余额支付方法
100:         if ($type === 'balance') {
101:             return $this->payBalance($user, $order);
102:         }
103: 
104:         // 如果是微信或支付宝支付，并且是APP支付，则在支付方式后添加App后缀
105:         if (in_array($type, ['weixin', 'alipay'], true) && $isApp) {
106:             $type .= 'App';
107:         }
108: 
109:         // 在支付前触发一个事件，允许其他功能模块进行额外的操作或校验
110:         event('order.presell.pay.before', compact('order', 'type', 'isApp'));
111: 
112:         // 根据支付类型和系统配置，选择使用合并支付服务或普通支付服务
113:         if (in_array($type, ['weixin', 'weixinApp', 'routine', 'h5', 'weixinQr'], true) && systemConfig('open_wx_combine')) {
114:             $service = new CombinePayService($type, $order->getCombinePayParams());
115:         } else {
116:             $service = new PayService($type, $order->getPayParams($type === 'alipay' ? $return_url : ''), 'presell');
117:         }
118: 
119:         // 生成支付配置
120:         $config = $service->pay($user);
121: 
122:         // 返回支付配置和订单ID，供前端进行支付操作
123:         return app('json')->status($type, $config + ['order_id' => $order['presell_order_id']]);
124:     }
125: 
126: 
127:     /**
128:      * 使用余额支付预售价订单。
129:      *
130:      * 此方法处理用户使用余额支付预售价订单的流程。它首先检查余额支付是否已开启，然后确保用户余额充足。
131:      * 如果条件满足，它将在数据库事务中执行支付操作，包括更新用户余额、记录账单和标记订单为支付成功。
132:      *
133:      * @param User $user 当前进行支付的用户对象。
134:      * @param PresellOrder $order 需要支付的预售价订单对象。
135:      * @throws ValidateException 如果支付方式未开启或用户余额不足，则抛出验证异常。
136:      * @return json 返回支付成功的响应。
137:      */
138:     public function payBalance(User $user, PresellOrder $order)
139:     {
140:         // 检查余额支付是否开启，如果没有开启则抛出异常。
141:         if (!systemConfig('yue_pay_status'))
142:             throw new ValidateException('未开启余额支付');
143: 
144:         // 检查用户余额是否足够支付订单，如果不足则抛出异常。
145:         if ($user['now_money'] < $order['pay_price'])
146:             throw new ValidateException('余额不足，请更换支付方式');
147: 
148:         // 使用数据库事务来确保支付操作的原子性。
149:         Db::transaction(function () use ($user, $order) {
150:             // 更新用户的余额，并保存更改。
151:             $user->now_money = bcsub($user->now_money, $order['pay_price'], 2);
152:             $user->save();
153: 
