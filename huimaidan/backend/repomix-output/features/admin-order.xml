2110:         }
2111:         if ($refund->status != self::REFUND_STATUS_REFUSED) {
2112:             throw new Exception('当前状态不允许申请平台介入');
2113:         }
2114:         $daysToAdd = (int)systemConfig('platform_intervention_time');
2115:         if (time() <= strtotime("{$refund->status_time} +{$daysToAdd} days")) {
2116:             throw new Exception('申请平台介入时间已过');
2117:         }
2118: 
2119:         //退款订单记录
2120:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
2121:         $orderStatus                = [
2122:             'order_id'       => $refund->order_id,
2123:             'order_sn'       => $refund->order->order_sn,
2124:             'type'           => $storeOrderStatusRepository::TYPE_ORDER,
2125:             'change_message' => '用户申请平台介入退款',
2126:             'change_type'    => $storeOrderStatusRepository::CHANGE_REFUND_PLATFORM_INTERVENE,
2127:         ];
2128: 
2129:         $orderRefundStatus = [
2130:             'order_id'       => $refund->refund_order_id,
2131:             'order_sn'       => $refund->refund_order_sn,
2132:             'type'           => $storeOrderStatusRepository::TYPE_REFUND,
2133:             'change_message' => '申请平台介入',
2134:             'change_type'    => $storeOrderStatusRepository::CHANGE_REFUND_PLATFORM_INTERVENE,
2135:         ];
2136: 
2137:         Db::transaction(function () use ($refundOrderId, $refund, $storeOrderStatusRepository, $orderStatus, $orderRefundStatus) {
2138:             $this->dao->update($refundOrderId, ['status_time' => date('Y-m-d H:i:s'), 'status' => self::REFUND_PLATFORM_INTERVENE]);
2139:             $storeOrderStatusRepository->createUserLog($refund->uid,$orderRefundStatus);
2140:             $storeOrderStatusRepository->createUserLog($refund->uid,$orderStatus);
2141:             foreach($refund['refundProduct'] as $item) {
2142:                 $orderProduct = $item['product'];
2143:                 $orderProduct->refund_num -= $item['refund_num'];
2144:                 $orderProduct->is_refund  = 1;
2145:                 $orderProduct->save();
2146:             }
2147:         });
2148:     }
