 844:             'deliveryOrder' => function ($query) {
 845:                 return $query->with(['deliveryService' => function ($query) {
 846:                     return $query->field('service_id,name,phone,avatar');
 847:                 }]);
 848:             }
 849:         ];
 850: 
 851:         // 根据是否提供用户ID，调整查询条件
 852:         if ($uid) {
 853:             $where['uid'] = $uid; // 如果提供用户ID，添加到查询条件中
 854:         } else {
 855:             // 如果不提供用户ID，关联查询用户信息
 856:             $with['user'] = function ($query) {
 857:                 return $query->field('uid,nickname,avatar,is_svip'); // 用户ID和昵称
 858:             };
 859:         }
 860: 
 861:         // 执行订单查询，包括订单本身的信息以及关联信息
 862:         $order = $this->dao->search($where)
 863:             ->where('order_id', $id)
 864:             ->where('StoreOrder.is_del', 0)
 865:             ->with($with)
 866:             ->append(['refund_status', 'open_receipt'])
 867:             ->find();
 868: 
 869:         // 如果订单不存在，返回null
 870:         if (!$order) {
 871:             return null;
 872:         }
 873: 
 874:         $config = merchantConfig($order['mer_id'],['mer_take_address','mer_take_day','mer_take_time','mer_take_phone']);
 875:         $order['merchant']['mer_take_address'] = $config['mer_take_address'];
 876:         $order['merchant']['mer_take_day'] = $config['mer_take_day'];
 877:         $order['merchant']['mer_take_time'] = $config['mer_take_time'];
 878:         $order['merchant']['mer_take_phone'] = $config['mer_take_phone'];
 879: 
 880:         // 处理预售订单的特殊情况，计算预售订单的最终价格
 881:         if ($order->activity_type == 2) {
 882:             if ($order->presellOrder) {
 883:                 $order->presellOrder->append(['activeStatus']); // 预售订单的状态
 884:                 $order->presell_price = bcadd($order->pay_price, $order->presellOrder->pay_price, 2); // 计算预售订单的最终支付价格
 885:             } else {
 886:                 $order->presell_price = $order->pay_price; // 如果不是预售订单，则预售价格等于支付价格
 887:             }
 888:         }
 889:         $order['cancel_status'] = false;
 890:         if ($order->is_virtual == 4 && $order->is_cancel) {
 891:             $reservation = $order['orderProduct'][0]['cart_info']['reservation'] ?? '';
 892:             if ($reservation && $reservation['is_cancel_reservation'] == 1) {
 893:                 $star = explode('-',$order['orderProduct'][0]['reservation_time_part']);
 894:                 $cancelTime = strtotime($order['orderProduct'][0]['reservation_date'] . ' ' .$star[0]);
 895:                 $cancelTime = $cancelTime - time() >= $reservation['cancel_reservation_time'] * 3600;
 896:                 $order['cancel_status'] = $cancelTime && ($order->status !== 2 ? true : false);
 897:             }
 898:         }
 899:         // 返回订单详情
 900:         return $order;
 901:     }
