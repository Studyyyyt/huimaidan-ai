129:                     $couponIds = $storeCouponProductRepository->productByCouponId([$item['product']['product_id']]);
130:                     $arr[$item['mer_id']]['hasCoupon'] = count($couponIds) ? $coupon_make->validProductCouponExists([$item['product']['product_id']], $hasCoupon) : 0;
