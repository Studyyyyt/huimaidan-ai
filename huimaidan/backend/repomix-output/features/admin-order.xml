3808:         }
3809: 
3810:         try {
3811:             Db::transaction(function () use ($order, $serviceId) {
3812:                 $order->save();
3813:                 // 构建订单状态变更信息
3814:                 $orderStatus = [
3815:                     'order_id' => $order->order_id,
