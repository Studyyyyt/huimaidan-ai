 50:      */
 51:     public function search($where)
 52:     {
 53:         // 获取数据库实例，并通过链式调用进行条件构建
 54:         $query = ($this->getModel()::getDB())
 55:             // 当'id'字段在$where数组中存在且不为空时，添加where条件查询订单号
