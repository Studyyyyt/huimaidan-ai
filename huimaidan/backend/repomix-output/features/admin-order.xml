3797:             }
3798:         }
3799:         $order->staffs_id = $data['staffs_id'];
3800:         $order->status = OrderStatus::ORDER_STATUS_PENDING_RECEIPT;
3801:         $order->enable_assigned = $enableAssigned;
3802:         // 如果是上门订单并且打卡配置未开启，则将订单状态设置为服务中
3803:         if ($order->order_type == 0) {
3804:             $config = merchantConfig($merId,['enable_checkin']);
3805:             if (!$config['enable_checkin']) {
3806:                 $order->status = OrderStatus::RESERVATION_ORDER_STATUS_INSERVICE;
