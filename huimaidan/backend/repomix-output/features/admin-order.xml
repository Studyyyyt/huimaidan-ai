1945: 
1946:         // 小程序发货管理
1947:         event('mini_order_shipping', ['product', $order, $data['delivery_type'], $data['delivery_id'], $data['delivery_name']]);
1948: 
1949:         event('order.delivery', compact('order', 'data'));
1950:         return $data;
1951:     }
