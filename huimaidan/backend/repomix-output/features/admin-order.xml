279: 
280:         $orderList = $this->merOrderList($user,$merchantCartList, $pay_type, $user_address, $address,$orderInfo['order_type'],$orderInfo['order_model'],$mark);
281:         $storeOrderRepository = app()->make(StoreOrderRepository::class);
282:         $groupOrder = [
283:             'uid' => $user->uid,
284:             'group_order_sn' => count($orderList) === 1 ? $orderList['orderList'][0]['order_sn'] : ($storeOrderRepository->getNewOrderId(StoreOrderRepository::TYPE_SN_ORDER) . '20'),
