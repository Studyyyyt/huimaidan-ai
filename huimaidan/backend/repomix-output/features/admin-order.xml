2266:     /**
2267:      * 处理定金订单退款逻辑
2268:      */
2269:     private function handleDepositRefund(StoreRefundOrder $refundOrder, float $refundPrice): array
2270:     {
2271:         $result = [];
2272:         $order = $refundOrder->order;
2273: 
2274:         // 剩余定金金额
2275:         $remainingDeposit = bcsub($order->pay_price, $refundPrice, 2);
2276:         $refundComparison = bccomp($remainingDeposit, $refundOrder->refund_price, 2);
2277: 
2278:         $serverType = $this->getServerType($order);
2279: 
2280:         if ($refundComparison >= 0) {
2281:             // 情况2.2：当前退款金额 <= 剩余定金金额，只退定金
2282:             $result[] = $this->buildDepositOrderData($refundOrder, $serverType);
2283:         } else {
2284:             // 情况2.1：当前退款金额 > 剩余定金金额，需要分两次退款
2285:             $result = $this->buildSplitRefundData($refundOrder, $remainingDeposit, $serverType);
2286:         }
2287: 
2288:         return $result;
2289:     }
