1041:     /**
1042:      * 处理订单领取操作。
1043:      *
1044:      * 本函数在数据库事务中执行一系列操作，以确保订单状态的原子性更新。
1045:      * 主要包括：
1046:      * 1. 如果提供了用户信息，则计算与用户相关的订单数据。
1047:      * 2. 发送两条短信通知，分别通知用户和管理员关于订单的领取情况。
1048:      * 3. 更新商家的锁定资金。
1049:      * 4. 保存更新后的订单信息。
1050:      *
1051:      * @param StoreOrder $order 待处理的订单对象。
1052:      * @param User $user 可选的用户对象，如果提供，将进行相关计算。
1053:      */
1054:     public function takeAfter(StoreOrder $order, ?User $user)
1055:     {
1056:         // 使用数据库事务来确保操作的原子性
1057:         Db::transaction(function () use ($user, $order) {
1058:             // 如果提供了用户信息，则计算与用户相关的订单数据
1059:             if ($user) {
1060:                 $this->computed($order, $user);
1061:             }
1062:             // 保存更新后的订单信息到数据库
1063:             $order->save();
1064:         });
1065:         // 发送短信通知用户订单已被领取
1066:         Queue::push(SendSmsJob::class, ['tempId' => 'ORDER_TAKE_SUCCESS', 'id' => $order->order_id]);
1067:         // 发送短信通知管理员订单领取情况
1068:         Queue::push(SendSmsJob::class, ['tempId' => 'ADMIN_TAKE_DELIVERY_CODE', 'id' => $order->order_id]);
1069: 
1070:         $main_id =  $order->main_id ?: $order->order_id;
1071:         $count = $this->dao->getSearch([])->where('status', 'NotIn', [
1072:             OrderStatus::ORDER_STATUS_PENDING_REVIEW,
1073:             OrderStatus::ORDER_STATUS_COMPLETED,
1074:             OrderStatus::ORDER_STATUS_REFUND
1075:         ])->where(function($query) use ($main_id) {
1076:             $query->where('order_id', $main_id)->whereOr('main_id', $main_id);
1077:         })->count();
1078: 
1079:         if (!$count) {
1080:             // 根据主订单ID获取具体的订单信息
1081:             if ($order->main_id) {
1082:                 $order = $this->dao->getWhere(['order_id' =>$main_id]);
1083:             }
1084:             // 更新商家的锁定资金状态
1085:             app()->make(MerchantRepository::class)->computedLockMoney($order);
1086:         }
1087:     }
