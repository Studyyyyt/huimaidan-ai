247:      * @author Qinii
248:      * @day 2020-10-17
249:      */
250:     public function receiptSn()
251:     {
252:         list($msec, $sec) = explode(' ', microtime());
253:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
254:         $orderId = 'PT' . $msectime . mt_rand(10000, max(intval($msec * 10000) + 10000, 98369));
255:         return $orderId;
256:     }
