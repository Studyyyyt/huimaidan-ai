 64:      * 通过判断返回的记录数是否大于0来确定是否存在符合条件的未结算记录。
 65:      *
 66:      * @param int $id 对应的reconciliation_id，用于查询记录。
 67:      * @param int $merId 商家ID，用于查询特定商家的记录。
 68:      * @return bool 如果存在符合条件的未结算记录则返回true，否则返回false。
 69:      */
 70:     public function merWhereCountById($id, $merId)
 71:     {
 72:         // 定义查询条件，包括reconciliation_id、mer_id、is_accounts和status
 73:         $where = ['reconciliation_id' => $id, 'mer_id' => $merId, 'is_accounts' => 0, 'status' => 0];
 74: 
 75:         // 调用dao层的getWhereCount方法查询符合条件的记录数，并检查是否大于0
 76:         return ($this->dao->getWhereCount($where) > 0);
 77:     }
 78: 
 79:     /**
 80:      *  列表
 81:      * @param $where
 82:      * @param $page
 83:      * @param $limit
 84:      * @return array
 85:      * @author Qinii
 86:      * @day 2020-06-15
 87:      */
 88:     public function getList($where, $page, $limit)
 89:     {
 90:         $query = $this->dao->search($where)->with([
 91:             'merchant' => function ($query) {
 92:                 $query->field('mer_id,mer_name');
 93:             },
 94:             'admin' => function ($query) {
 95:                 $query->field('admin_id,real_name');
 96:             }]);
 97:         $count = $query->count();
 98:         $list = $query->page($page, $limit)->select()->append(['charge'])->each(function ($item) {
 99:             if ($item->type == 1) return $item->price = '-' . $item->price;
100:         });
