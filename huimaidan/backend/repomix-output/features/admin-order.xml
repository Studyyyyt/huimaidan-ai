311:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
312:         $userMerchantRepository = app()->make(UserMerchantRepository::class);
313:         $userBillRepository = app()->make(UserBillRepository::class);
314:         $_orderList = $orderList['orderList'];
315:         return Db::transaction(function () use (
316:             $user,
317:             $cartId,
318:             $groupOrder,
319:             $_orderList,
320:             $orderInfo,
321:             $attrValueRepository,
322:             $productRepository,
323:             $storeCartRepository,
324:             $storeGroupOrderRepository,
325:             $storeOrderStatusRepository,
326:             $userMerchantRepository,
327:             $storeOrderProductRepository,
328:             $storeOrderRepository,
329:             $userBillRepository
330:         ) {
331:             //减库存
