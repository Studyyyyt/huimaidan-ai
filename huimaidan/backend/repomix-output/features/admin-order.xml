1532:     /**
1533:      *  计算的重复利用
1534:      * @param $total
1535:      * @param $old
1536:      * @param $new
1537:      * @return int|string
1538:      * @author Qinii
1539:      * @day 12/15/20
1540:      */
1541:     public function bcmathPrice($total, $old, $new)
1542:     {
1543:         $_bcsub = bcsub($total, $old, 2);
1544:         $_count = (bccomp($_bcsub, 0, 2) == -1) ? 0 : $_bcsub;
1545:         $count = bcadd($_count, $new, 2);
1546:         return (bccomp($count, 0, 2) == -1) ? 0 : $count;
1547:     }
