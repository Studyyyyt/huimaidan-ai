2293:      */
2294:     private function buildDepositOrderData(StoreRefundOrder $refundOrder, int $serverType): array
2295:     {
2296:         $order = $refundOrder->order;
2297:         $groupOrder = $order->groupOrder;
2298: 
2299:         if ($groupOrder->is_combine) {
2300:             return [
2301:                 'type' => $serverType,
2302:                 'id' => $order->order_id,
2303:                 'sn' => $order->order_sn,
2304:                 'data' => $refundOrder->getCombineRefundParams($serverType)
2305:             ];
2306:         }
2307: 
2308:         return [
2309:             'type' => $serverType,
2310:             'id' => $order->order_id,
2311:             'sn' => $groupOrder->group_order_sn,
2312:             'data' => [
2313:                 'refund_id' => $refundOrder->refund_order_sn,
2314:                 'pay_price' => $order->pay_price,
2315:                 'refund_price' => $refundOrder->refund_price
2316:             ]
2317:         ];
2318:     }
