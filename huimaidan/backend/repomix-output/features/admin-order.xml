2183:         $this->validateRefundOrder($refundOrder);
2184:         if ($refundOrder->refund_price <= 0) {
2185:             return $refundOrder;
2186:         }
2187: 
2188:         // 获取需要推荐的数据 和 退款需要执行的服务类型
2189:         [$refundData, $serverType] = $this->prepareRefundData($refundOrder, $refundPrice);
2190: 
2191:         //根据不同的服务类型 找到对应的服务类
2192:         $refundService = $this->createRefundService($serverType);
2193:         //执行退款操作
2194:         $refundResult = $this->processRefund($refundOrder, $refundData, $refundService, $serverType);
2195: 
2196:         //退款后记录等操作
2197:         $this->recordFinancialTransactions($refundOrder, $refundResult);
2198: 
2199:         return $refundOrder;
