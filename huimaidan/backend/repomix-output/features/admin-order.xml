184:     /**
185:      *  计算对账单金额
186:      * @param $merId
187:      * @param $order_ids
188:      * @param $refund_order_ids
189:      * @return array
190:      * @author Qinii
191:      * @day 2020-06-23
192:      */
193:     public function compute($merId, $order_ids, $refund_order_ids)
194:     {
195:         $order_price = $refund_price = $order_extension = $refund_extension = $order_rate = $refund_rate = 0;
196:         $orderMake = app()->make(StoreOrderRepository::class);
197:         $refundMake = app()->make(StoreRefundOrderRepository::class);
198: 
199:         foreach ($order_ids as $item) {
200:             if (!$order = $orderMake->getWhere(['order_id' => $item, 'mer_id' => $merId, 'paid' => 1]))
201:                 throw new ValidateException('订单信息不存在或状态错误');
202: 
203:             if ($order['reconciliation_id']) throw new ValidateException('订单重复提交');
204: 
205:             //(实付金额 - 一级佣金 - 二级佣金) * 抽成
206:             $commission_rate = ($order['commission_rate'] / 100);
207:             //佣金
208:             $_order_extension = bcadd($order['extension_one'], $order['extension_two'], 3);
209:             $order_extension = bcadd($order_extension, $_order_extension, 3);
210: 
211:             //手续费 =  (实付金额 - 一级佣金 - 二级佣金) * 比例
212:             $_order_rate = bcmul(bcsub($order['pay_price'], $_order_extension, 3), $commission_rate, 3);
213:             $order_rate = bcadd($order_rate, $_order_rate, 3);
214: 
215:             //金额
216:             $_order_price = bcsub(bcsub($order['pay_price'], $_order_extension, 3), $_order_rate, 3);
217:             $order_price = bcadd($order_price, $_order_price, 3);
218:         }
219: 
220:         foreach ($refund_order_ids as $item) {
221:             if (!$refundOrder = $refundMake->getWhere(['refund_order_id' => $item, 'mer_id' => $merId, 'status' => 3], '*', ['order']))
222:                 throw new ValidateException('退款订单信息不存在或状态错误');
223:             if ($refundOrder['reconciliation_id']) throw new ValidateException('退款订单重复提交');
224: 
225:             //退款金额 + 一级佣金 + 二级佣金
226:             $refund_commission_rate = ($refundOrder['order']['commission_rate'] / 100);
227:             //佣金
228:             $_refund_extension = bcadd($refundOrder['extension_one'], $refundOrder['extension_two'], 3);
229:             $refund_extension = bcadd($refund_extension, $_refund_extension, 3);
230: 
231:             //手续费
232: //            $_refund_rate = bcmul(bcsub($refundOrder['refund_price'],$_refund_extension,3),$refund_commission_rate,3);
233: //            $refund_rate = bcadd($refund_rate,$_refund_rate,3);
234: 
235:             //金额
236:             $_refund_price = bcadd($refundOrder['refund_price'], $_refund_extension, 3);
237:             $refund_price = bcadd($refund_price, $_refund_price, 3);
238:         }
239: 
240:         $price = bcsub($order_price, $refund_price, 3);
241: 
242:         return compact('price', 'refund_price', 'order_extension', 'refund_extension', 'order_price', 'order_rate');
243:     }
