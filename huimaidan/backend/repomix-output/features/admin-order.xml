3236:     /**
3237:      * 删除订单
3238:      *
3239:      * 本函数用于逻辑上删除一个订单。这里的“删除”指的是标记订单为已删除，而不是从数据库中物理删除。
3240:      * 删除订单时，会进行以下操作：
3241:      * 1. 更新订单状态，标记为已删除。
3242:      * 2. 如果订单未支付，将订单中的商品库存回滚，即增加商品的可用库存。
3243:      * 3. 记录订单状态的变更。
3244:      *
3245:      * @param object $order 待删除的订单对象。
3246:      * @param string $info 订单删除原因的描述，默认为'订单删除'。
3247:      */
3248:     public function delOrder($order, $info = '订单删除')
3249:     {
3250:         // 创建订单状态仓库实例，用于后续操作订单状态
3251:         //订单记录
3252:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
3253: 
3254:         // 构建订单状态变更信息
3255:         $orderStatus = [
3256:             'order_id' => $order->order_id,
3257:             'order_sn' => $order->order_sn,
3258:             'type' => $storeOrderStatusRepository::TYPE_ORDER,
3259:             'change_message' => $info,
3260:             'change_type' => $storeOrderStatusRepository::ORDER_STATUS_DELETE,
3261:         ];
3262: 
3263:         // 创建商品仓库实例，用于后续操作商品库存
3264:         $productRepository = app()->make(ProductRepository::class);
3265: 
3266:         // 使用事务确保订单状态更新和库存回滚的操作原子性
3267:         Db::transaction(function () use ($info, $order, $orderStatus, $storeOrderStatusRepository, $productRepository) {
3268:             // 标记订单为已删除
3269:             $order->is_del = 1;
3270:             $order->save();
3271: 
3272:             // 记录订单状态变更
3273:             $storeOrderStatusRepository->createUserLog($order->uid,$orderStatus);
3274: 
3275:             // 如果订单未支付（状态不为3），则回滚订单中商品的库存
3276:             if ($order->status != 3) {
3277:                 foreach ($order->orderProduct as $cart) {
3278:                     $productRepository->orderProductIncStock($order, $cart);
3279:                 }
3280:             }
3281:         });
3282:     }
