261:      * 该方法用于在购物车中添加新的项目。如果添加的项目不是新的（即$is_new标志为false），它会首先检查当前用户购物车中已有的非新、未支付、未失败的项目数量。
262:      * 如果数量超过了预设的限制，则会删除最旧的项目以保证总数在限制范围内。然后，无论是否进行了删除操作，都会继续添加新的购物车项目。
263:      *
264:      * @param array $data 添加到购物车的数据，包括商品信息和用户信息等。
265:      * @return bool|mixed 返回添加操作的结果，可能是新项目的ID或其他数据，也可能是false表示操作失败。
266:      */
267:     public function create(array $data)
268:     {
269:         // 使用事务处理来确保数据的一致性
270:         return Db::transaction(function() use($data) {
271:             // 如果数据标记为非新项目
272:             if (!$data['is_new']) {
273:                 // 查询当前用户购物车中符合条件的项目数量
274:                 // 查询现有多少条数据
275:                 $query = $this->dao->getSearch(['uid' => $data['uid'],'is_new' => 0,'is_pay' => 0,'is_fail' => 0 ])->order('create_time DESC');
276:                 $count = $query->count();
277:                 // 定义购物车项目数量的限制
278:                 $limit = self::CART_LIMIT_COUNT;
279:                 // 如果当前项目数量超过限制
280:                 //超过总限制的条数全部删除
281:                 if ($count >= $limit) {
282:                     // 获取需要删除的项目ID
283:                     $cartId = $query->limit($limit,$count)->column('cart_id');
284:                     // 删除超出数量限制的购物车项目
285:                     $this->dao->updates($cartId,['is_del' => 1]);
286:                 }
287:             }
288:             // 继续添加新的购物车项目
289:             return $this->dao->create($data);
290:         });
291:     }
