207:      * 具体来说，它查询了两种情况：一是退款类型为1且状态为0的订单；
208:      * 二是退款类型为2且状态为2的订单。
209:      * @param int $time 用于比较的超时时间点，订单状态时间必须小于等于这个时间才算超时。
210:      * @return array 返回一个包含超时退款订单ID的数组。
211:      */
212:     public function getTimeOutIds($time)
213:     {
214:         // 从模型中获取数据库实例，并构造查询条件
215:         // 首先筛选status_time小于等于指定时间的记录
216:         return ($this->getModel()::getDB())->where('status_time', '<=', $time)
217:             // 然后通过嵌套的where子句，分别查询两种特定条件的订单
218:             ->where(function ($query) {
219:                 // 第一种条件：退款类型为1，且状态为0
220:                 $query->where(function ($query) {
221:                     $query->where('refund_type', 1)->where('status', 0);
222:                 })->whereOr(function ($query) {
223:                     // 第二种条件：退款类型为2，且状态为2
224:                     $query->where('refund_type', 2)->where('status', 2);
225:                 });
226:             })->column('refund_order_id');
227:         // 最终返回满足条件的订单的退款订单ID列表
228:     }
229: 
230: 
231:     /**
232:      * 用于调和数据更新的函数。
233:      * 此函数旨在将指定的调和ID列表中的所有调和ID更新为0。
234:      * 这是一个具体的操作数据库的函数，它依赖于getModel方法来获取数据库实例。
235:      *
236:      * @param array $reconciliation_id 调和ID的数组，这些ID将被更新为0。
237:      * @return int 返回影响的行数，表示更新操作的结果。
238:      */
239:     public function reconciliationUpdate($reconciliation_id)
240:     {
241:         // 通过模型获取数据库实例，并使用whereIn方法指定更新条件，然后更新reconciliation_id为0
242:         return ($this->getModel()::getDB())->whereIn('reconciliation_id', $reconciliation_id)->update(['reconciliation_id' => 0]);
243:     }
244: 
245: 
246:     /**
247:      * 根据订单ID数组计算退款总额
248:      *
249:      * 本函数通过查询数据库，计算指定订单ID列表中状态为3（假设代表已退款）的订单的退款总额。
250:      * 使用了whereIn和where方法来筛选订单ID和订单状态，sum方法用于计算退款金额总和。
251:      *
252:      * @param array $orderIds 订单ID数组，用于查询指定订单的退款金额
253:      * @return float 返回计算得到的退款总额
254:      */
255:     public function refundPirceByOrder(array $orderIds)
256:     {
257:         // 调用getModel方法获取模型实例，然后通过该实例的getDB方法获取数据库连接
258:         // 使用whereIn方法筛选出订单ID在指定数组中的记录，再使用where方法筛选出状态为3的记录
259:         // 最后使用sum方法计算这些记录的refund_price列的总和，并返回该值
260:         return $this->getModel()::getDB()->whereIn('order_id', $orderIds)->where('status', 3)->sum('refund_price');
261:     }
262: 
263: 
264: }
