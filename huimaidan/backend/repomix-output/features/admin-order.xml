 794:     /**
 795:      *  单个商品指定数量退款操作
 796:      * @param StoreOrder $order
 797:      * @param $productId
 798:      * @param $num
 799:      * @param $uid
 800:      * @param array $data
 801:      * @return mixed
 802:      * @throws DataNotFoundException
 803:      * @throws DbException
 804:      * @throws ModelNotFoundException
 805:      * @author xaboy
 806:      * @day 2020/6/17
 807:      */
 808:     public function refund(StoreOrder $order, $productId, $num, $uid, array $data, $refund_switch = 1)
 809:     {
 810:         $orderId = $order->order_id;
 811:         // 订单状态生成佣金
 812:         $products = app()->make(StoreOrderProductRepository::class)->userRefundProducts([$productId], $uid, $orderId, $refund_switch);
 813:         if (empty($products->toArray()))
 814:             throw new ValidateException('请选择正确的退款商品');
 815:         $product = $products[0];
 816:         if ($product['refund_num'] < $num)
 817:             throw new ValidateException('可退款商品不足' . floatval($num) . '件');
 818:         $productRefundPrice = app()->make(StoreRefundProductRepository::class)->userRefundPrice([$productId])[$productId] ?? [];
 819: 
 820:         //计算可退运费
 821:         $postagePrice = (!$order->status || $order->status == 9) ? bcsub($product['postage_price'], $productRefundPrice['refund_postage'] ?? 0, 2) : 0;
 822:         if($order->order_type == 2) {
 823:             // 已经申请退款的总数量
 824:             $refundTotalNum = 0;
 825:             $refundInfo = $this->getSearch(['order_id' => $order->order_id])->whereIn('status',[0,1,2,3])->with('refundProduct')->select()->toArray();
 826:             foreach($refundInfo as $item) {
 827:                 $refundTotalNum += array_sum(array_column($item['refundProduct'],'refund_num'));
 828:             }
 829:             // 订单总数量
 830:             $orderGroupTotalNum = app()->make(StoreGroupOrderRepository::class)->getSearch(['group_order_id' => $order->group_order_id])->sum('total_num');
 831:             // 如果申请退款的总数量加上当前要退款的数量等于订单分组总数量，说明是全退，同城配送全退才包含运费
 832:             if(bcadd($refundTotalNum, $num) == $orderGroupTotalNum) {
 833:                 $postagePrice = $order->total_postage;
 834:             }
 835:         }
 836: 
 837:         $refundPrice = 0;
 838:         //计算可退金额
 839:         if ($product['product_price'] > 0) {
 840:             if ($product['refund_num'] == $num) {
 841:                 $refundPrice = bcsub($product['product_price'], bcsub($productRefundPrice['refund_price'] ?? 0, $productRefundPrice['refund_postage'] ?? 0, 2), 2);
 842:             } else {
 843:                 $refundPrice = bcmul(bcdiv($product['product_price'], $product['product_num'], 2), $num, 2);
 844:             }
 845:         }
 846:         $totalRefundPrice = bcadd($refundPrice, $postagePrice, 2);
 847:         if ($totalRefundPrice < $data['refund_price'])
 848:             throw new ValidateException('最高可退款' . floatval($totalRefundPrice) . '元');
 849: 
 850:         $data['refund_postage'] = 0;
 851: 
 852:         if ($data['refund_price'] > $refundPrice) {
 853:             $data['refund_postage'] = bcsub($data['refund_price'], $refundPrice, 2);
 854:         }
 855: 
 856:         $data['order_id'] = $product['order_id'];
 857: 
 858:         $platform_refund_price = 0;
 859:         //计算退的平台优惠券金额
 860:         if ($product['platform_coupon_price'] > 0) {
 861:             if ($product['refund_num'] == $num) {
 862:                 $platform_refund_price = bcsub($product['platform_coupon_price'], $productRefundPrice['platform_refund_price'] ?? 0, 2);
 863:             } else {
 864:                 $platform_refund_price = bcmul(bcdiv($product['platform_coupon_price'], $product['product_num'], 2), $num, 2);
 865:             }
 866:         }
 867: 
 868:         $data['platform_refund_price'] = $platform_refund_price;
 869: 
 870:         $integral = 0;
 871:         if ($product['integral'] > 0) {
 872:             if ($product['refund_num'] == $num) {
 873:                 $integral = bcsub($product['integral_total'], $productRefundPrice['refund_integral'] ?? 0, 0);
 874:             } else {
 875:                 $integral = bcmul($product['integral'], $num, 0);
 876:             }
 877:         }
 878: 
 879:         $data['integral'] = $integral;
 880: 
 881:         $total_extension_one = 0;
 882:         $total_extension_two = 0;
 883:         if ($product['extension_one'] > 0)
 884:             $total_extension_one = bcmul($num, $product['extension_one'], 2);
 885:         if ($product['extension_two'] > 0)
 886:             $total_extension_two = bcmul($num, $product['extension_two'], 2);
 887: 
 888:         $data['uid']             = $product['uid'];
 889:         $data['mer_id']          = $order['mer_id'];
 890:         $data['refund_order_sn'] = app()->make(StoreOrderRepository::class)->getNewOrderId(StoreOrderRepository::TYPE_SN_REFUND);
 891:         $data['refund_num']      = $num;
 892:         $data['extension_one']   = $total_extension_one;
 893:         $data['extension_two']   = $total_extension_two;
 894: 
 895:         return Db::transaction(function () use ($order, $data, $product, $productId, $num) {
 896:             event('refund.create.before', compact('data'));
 897:             $refund = $this->dao->create($data);
 898:             app()->make(StoreRefundProductRepository::class)->create([
 899:                 'refund_num'            => $num,
 900:                 'refund_order_id'       => $refund->refund_order_id,
 901:                 'order_product_id'      => $productId,
 902:                 'platform_refund_price' => $data['platform_refund_price'],
 903:                 'refund_price'          => $data['refund_price'],
 904:                 'refund_integral'       => $data['integral'],
 905:                 'refund_postage'        => $data['refund_postage'],
 906:             ]);
 907:             $product->refund_num -= $num;
 908:             $product->is_refund  = 1;
 909:             $product->save();
 910:             $this->applyRefundAfter($refund, $order);
 911:             return $refund;
 912:         });
 913:     }
