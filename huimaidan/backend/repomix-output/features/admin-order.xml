1905:                 if (!$exprss) throw new ValidateException('快递公司不存在');
1906:                 $data['delivery_name'] = $exprss['name'];
1907:                 $change_type = $statusRepository::ORDER_DELIVERY_COURIER;
1908:                 $change_message = '订单已配送【快递名称】:' . $exprss['name'] . '; 【快递单号】：' . $data['delivery_id'];
1909:                 $temp_code = 'DELIVER_GOODS_CODE';
1910:                 break;
1911:         }
1912: 
1913:         event('order.delivery.before', compact('order', 'data'));
1914:         $this->dao->update($order->order_id, $data);
1915: 
1916:         $orderStatus = [
1917:             'order_id' => $order->order_id,
1918:             'order_sn' => $order->order_sn,
1919:             'type' => $statusRepository::TYPE_ORDER,
1920:             'change_message' => $change_message,
