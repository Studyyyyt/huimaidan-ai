 603:     /**
 604:      *  订单商品循环处理获取可退款金额
 605:      * @param $order
 606:      * @param $product
 607:      * @param $data
 608:      * @param $num
 609:      * @param $productRefundPrice
 610:      * @return array
 611:      * @author Qinii
 612:      * @day 2023/7/13
 613:      */
 614:     public function getRefundData($order, $product, $data, $num, $productRefundPrice)
 615:     {
 616:         //计算可退运费
 617:         $postagePrice = (!$order->status || $order->status == 9) ? bcsub($product['postage_price'], $productRefundPrice['refund_postage'] ?? 0, 2) : 0;
 618:         $refundPrice  = 0;
 619:         //计算可退金额
 620:         if ($product['product_price'] > 0) {
 621:             if ($product['refund_num'] == $num) {
 622:                 $refundPrice = bcsub($product['product_price'], bcsub($productRefundPrice['refund_price'] ?? 0, $productRefundPrice['refund_postage'] ?? 0, 2), 2);
 623:             } else {
 624:                 $refundPrice = bcmul(bcdiv($product['product_price'], $product['product_num'], 2), $num, 2);
 625:             }
 626:         }
 627:         $totalRefundPrice = bcadd($refundPrice, $postagePrice, 2);
 628: //        if ($totalRefundPrice < $data['refund_price'])
 629: //            throw new ValidateException('最高可退款' . floatval($totalRefundPrice) . '元');
 630: 
 631:         $data['refund_postage'] = 0;
 632: 
 633:         if($order->order_type !== 2 && $data['refund_price'] > $refundPrice) {
 634:             $data['refund_postage'] = bcsub($data['refund_price'], $refundPrice, 2);
 635:         }
 636: 
 637:         $data['order_id'] = $product['order_id'];
 638: 
 639:         $platform_refund_price = 0;
 640:         //计算退的平台优惠券金额
 641:         if ($product['platform_coupon_price'] > 0) {
 642:             if ($product['refund_num'] == $num) {
 643:                 $platform_refund_price = bcsub($product['platform_coupon_price'], $productRefundPrice['platform_refund_price'] ?? 0, 2);
 644:             } else {
 645:                 $platform_refund_price = bcmul(bcdiv($product['platform_coupon_price'], $product['product_num'], 2), $num, 2);
 646:             }
 647:         }
 648: 
 649:         $data['platform_refund_price'] = $platform_refund_price;
 650: 
 651:         $integral = 0;
 652:         if ($product['integral'] > 0) {
 653:             if ($product['refund_num'] == $num) {
 654:                 $integral = bcsub($product['integral_total'], $productRefundPrice['refund_integral'] ?? 0, 0);
 655:             } else {
 656:                 $integral = bcmul($product['integral'], $num, 0);
 657:             }
 658:         }
 659: 
 660:         $data['integral'] = $integral;
 661: 
 662:         $total_extension_one = 0;
 663:         $total_extension_two = 0;
 664:         if ($product['extension_one'] > 0)
 665:             $total_extension_one = bcmul($num, $product['extension_one'], 2);
 666:         if ($product['extension_two'] > 0)
 667:             $total_extension_two = bcmul($num, $product['extension_two'], 2);
 668: 
 669:         $data['uid']             = $product['uid'];
 670:         $data['mer_id']          = $order['mer_id'];
 671:         $data['refund_order_sn'] = app()->make(StoreOrderRepository::class)->getNewOrderId(StoreOrderRepository::TYPE_SN_REFUND);
 672:         $data['refund_num']      = $num;
 673:         $data['extension_one']   = $total_extension_one;
 674:         $data['extension_two']   = $total_extension_two;
 675:         $refundProduct           = [
 676:             'refund_num'            => $num,
 677:             'order_product_id'      => $product['order_product_id'],
 678:             'platform_refund_price' => $data['platform_refund_price'],
 679:             'refund_price'          => bcmul(bcdiv($product['product_price'], $product['product_num'], 2), $num, 2),
 680:             'refund_integral'       => $data['integral'],
 681:             'refund_postage'        => $data['refund_postage'],
 682:         ];
 683:         return [$data, $refundProduct, $totalRefundPrice];
 684:     }
