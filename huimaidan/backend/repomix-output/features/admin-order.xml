 11: namespace app\common\repositories\store\order;
 12: 
 13: use think\Model;
 14: use think\exception\ValidateException;
 15: 
 16: trait MerchantOrderTrait
 17: {
 18:     /**
 19:      * 计算整单改价后的价格
 20:      *
 21:      * @param array $data
 22:      * @return float
 23:      */
 24:     private function getNewPayPrice(array $data) : array
 25:     {
 26:         $updatePriceFlag = 0;
 27:         // 判断是否改价了，如果没有改价，则返回默认值
 28:         if(!isset($data['change_fee_type']) || $data['change_fee_type'] === '') {
 29:             return [0, 1, $updatePriceFlag];
 30:         }
 31: 
 32:         $newPayPrice = $data['new_pay_price'] ?? 0;
 33:         if($data['change_fee_type'] == 1){ // 立减
 34:             $newPayPrice = bcsub($data['old_pay_price'], $data['reduce_price'], 2);
 35:         }
 36:         if($data['change_fee_type'] == 2){ // 折扣
 37:             $newPayPrice = bcmul($data['old_pay_price'], $data['discount_rate']/100, 2);
 38:         }
 39:         $changeFeeRate = bcdiv($newPayPrice, $data['old_pay_price'], 2);
 40:         $updatePriceFlag = 1;
 41: 
 42:         return [(float)$newPayPrice, (float)$changeFeeRate, $updatePriceFlag];
 43:     }
 44:     /**
 45:      * 运费模版
 46:      *
 47:      * @param array $template
 48:      * @return array
 49:      */
 50:     private function template(array $template): array
 51:     {
 52:         $cartProductShippingFeeTemplate = [];
 53:         foreach ($template as $temp) {
 54:             $cartProductShippingFeeTemplate[$temp['shipping_template_id']] = $temp;
 55:         }
 56: 
 57:         return $cartProductShippingFeeTemplate;
 58:     }
 59:     /**
 60:      * 计算积分
 61:      *
 62:      * @param array $result
 63:      * @param $cartList
 64:      * @param integer $merId
 65:      * @param integer $useIntegral
 66:      * @param integer $userIntegral
 67:      * @return array
 68:      */
 69:     private function calculateIntegral(array $result, $cartList, int $merId, int $useIntegral, int $userIntegral): array
 70:     {
 71:         $usedNum = 0;
 72:         $config = $this->getMerchantConfig($merId);
 73:         $sysIntegralConfig = systemConfig(['integral_money', 'integral_status', 'integral_order_rate']);
 74:         $integralFlag = ($sysIntegralConfig['integral_status'] == 1 && (isset($config['config']['mer_integral_status']) && $config['config']['mer_integral_status'] == 1)  && $userIntegral > 0) ? 1 : 0;
 75: 
 76:         if ($integralFlag && $useIntegral) {
 77:             $result['totalPaymentPrice'] = 0;
 78:             $result['discountDetail']['integralDiscountAmount'] = 0;
 79:             foreach ($cartList as $value) {
 80:                 // 积分抵扣比例，优先取商品设置的积分抵扣比例，若无则取商户默认设置的积分抵扣比例
 81:                 $integralRate = ($value['product']['integral_rate'] > 0) ? $value['product']['integral_rate'] : $config['config']['mer_integral_rate'];
 82:                 $integralRate = min(bcdiv($integralRate, 100, 4), 1);
 83:                 // 根据比例计算商品积分抵扣金额
 84:                 $productIntegralPrice = min((float)bcmul($value['paymentPrice'], $integralRate, 2), $value['paymentPrice']);
 85:                 if ($productIntegralPrice > 0) {
 86:                     // 计算商品积分数，若商品积分数大于用户积分数，则取用户积分数，否则取商品积分数
 87:                     $productIntegral = ceil(bcdiv($productIntegralPrice, $sysIntegralConfig['integral_money'], 2));
 88:                     if ($productIntegral > $userIntegral) {
 89:                         $use = $userIntegral;
 90:                         $useIntegralPrice = bcmul($userIntegral, $sysIntegralConfig['integral_money'], 0);
 91:                         $userIntegral = 0;
 92:                     } else {
 93:                         $use = $productIntegral;
 94:                         $useIntegralPrice = $productIntegralPrice;
 95:                         $userIntegral = (float)bcsub($userIntegral, $productIntegral, 0);
 96:                     }
 97:                     // 各商品积分使用详情
 98:                     $value['integral'] = [
 99:                         'use' => $use,
100:                         'price' => $useIntegralPrice,
101:                         'userIntegral' => $userIntegral
102:                     ];
103:                     // 更新商品实付金额
104:                     $value['paymentPrice'] = max((float)bcsub($value['paymentPrice'], $useIntegralPrice, 2), 0);
105:                     // 更新总支付金额和积分抵扣金额
106:                     $result['totalPaymentPrice'] += $value['paymentPrice'];
107:                     $result['discountDetail']['integralDiscountAmount'] += $value['integral']['price'];
108:                     $usedNum += $use;
109:                 }
110:             }
111:         }
112: 
113:         $result['commission_rate'] = $config['commission_rate'];
114:         $result['commission_switch'] = $config['commission_switch'];
115:         $result['integral']['flag'] = $integralFlag;
116:         $result['integral']['usedNum'] = $usedNum;
117:         $result['integral']['userIntegral'] = $userIntegral;
118:         $result['integral']['deductionAmount'] = (float)bcmul($userIntegral, $sysIntegralConfig['integral_money'], 2);
119: 
120:         return $result;
121:     }
122:     /**
123:      * 获取商户配置信息
124:      *
125:      * @param integer $merId
126:      * @return array
127:      */
128:     private function getMerchantConfig(int $merId): array
129:     {
130:         $configFiled = [
131:             'mer_integral_status',      // 商户积分开关
132:             'mer_integral_rate',        // 商户积分比例
133:             'mer_store_stock',          // 库存警戒
134:             'mer_take_status',          // 自提开关
135:             'mer_take_name',            // 自提门店名称
136:             'mer_take_phone',           // 自提电话
137:             'mer_take_address',         // 自提地址
138:             'mer_take_location',        // 自提店铺经纬度
139:             'mer_take_day',             // 自提营业日期
140:             'svip_coupon_merge',        // svip合并优惠券
141:             'mer_take_time',             // 自提时间段
142:         ];
143:         $merchantInfoData = $this->getMerchantRepository()->getSearch([])->where('mer_id', $merId)
144:             ->with([
145:                 'config' => function ($query) use ($configFiled) {
146:                     $query->whereIn('config_key', $configFiled);
147:                 }
148:             ])->field('mer_id,category_id,mer_name,mer_state,mer_avatar,is_trader,type_id,delivery_way,commission_rate,commission_switch')
149:             ->find()
150:             ->append(['openReceipt'])
151:             ->toArray();
152: 
153:         foreach ($merchantInfoData['config'] as $key => $config) {
154:             $merchantInfoData['config'][$config['config_key']] = $config['value'];
155:             unset($merchantInfoData['config'][$key]);
156:         }
157: 
158:         return $merchantInfoData;
159:     }
160:     /**
161:      * 计算优惠券优惠金额，并更新实付总金额和优惠详情中的优惠券优惠金额字段
162:      *
163:      * @param array $result
164:      * @param $cartList
165:      * @param $userCoupons
166:      * @param integer $totalPaymentPrice
167:      * @return array
168:      */
169:     private function calculateCoupon(array $result, $cartList, $userCoupons, int $merId, array $useCouponData, $user): array
170:     {
171:         if (empty($userCoupons) || empty($user)) {
172:             return $result;
173:         }
174: 
175:         // 会员和优惠券是否叠加
176:         $svipCouponMerge = merchantConfig($merId, 'svip_coupon_merge');
177:         $usePlatformCoupons = (isset($useCouponData[0]) && !empty($useCouponData[0])) ? [end($useCouponData[0])] : [];
178:         $useMerchantCoupons = (isset($useCouponData[1]) && !empty($useCouponData[1])) ? [end($useCouponData[1])] : [];
179:         $useProductCoupons = (isset($useCouponData[2]) && !empty($useCouponData[2])) ? $useCouponData[2] : [];
180:         $useCoupon = array_unique(array_merge($usePlatformCoupons, $useMerchantCoupons, $useProductCoupons));
181: 
182:         // 校验优惠券信息,校验优惠券是否可用
183:         $result['couponList'] = $this->getStoreCouponUserRepository()->validCoupon($userCoupons->toArray(), $useCoupon, $cartList, $result['totalPaymentPrice'], $merId);
184: 
185:         $usedCoupons = [];
186:         $couponRemainingPrice = [];
187:         $oldTotalPrice = $result['totalPaymentPrice'];
188:         $result['totalPaymentPrice'] = 0;
189:         $result['discountDetail']['couponsDiscountAmount'] = 0;
190:         foreach ($cartList as $key => $cart) {
191:             $defaultMerCoupon = 0;
192:             $defaultProCoupon = 0;
193:             $defaultPlaCoupon = 0;
194:             $paymentPrice = $cart['paymentPrice'];
195:             // 判断优惠券和会员是否可叠加使用
196:             $isNotOverlay = ($svipCouponMerge == 0 && $cart['useSvip']);
197:             foreach ($result['couponList'] as &$coupon) {
198:                 if($cart['paymentPrice'] > 0 && !$coupon['disabled']) {
199:                     $coupon['checked'] = false;
200:                     if($useCoupon) {
201:                         if ($isNotOverlay) {
202:                             $result['totalPaymentPrice'] = $oldTotalPrice;
203:                             throw new ValidateException('优惠券和会员不可叠加使用');
204:                             continue;
205:                         }
206:                         if (!in_array($coupon['coupon_user_id'], $useCoupon)) {
207:                             continue;
208:                         }
209:                         $coupon['checked'] = true;
210:                     }
211: 
212:                     // 平台券
213:                     if(in_array($coupon['coupon']['type'], [10, 11, 12]) && !$defaultPlaCoupon && !isset($useCouponData[0])) {
214:                         $coupon['checked'] = true;
215:                         $defaultPlaCoupon = $coupon['coupon_user_id'];
216:                     }
217:                     // 店铺券
218:                     if($coupon['coupon']['type'] == 0 && !$defaultMerCoupon && !isset($useCouponData[1])) {
219:                         $coupon['checked'] = true;
220:                         $defaultMerCoupon = $coupon['coupon_user_id'];
221:                     }
222:                     // 商品券
223:                     if($coupon['coupon']['type'] == 1 && !$defaultProCoupon && !isset($useCouponData[2])) {
224:                         $coupon['checked'] = true;
225:                         $defaultProCoupon = $coupon['coupon_user_id'];
226:                     }
227: 
228:                     // 计算选择的优惠券金额
229:                     if($coupon['checked']) {
230:                         // 商品券
231:                         if (!$coupon['product'] && $coupon['coupon']['type'] == 1) {
232:                             // 如果该优惠券已经被使用，则跳过当前循环
233:                             $usedProductCoupons = isset($usedCoupons['product']) ? array_column($usedCoupons['product'], 'id') : [];
234:                             if (in_array($coupon['coupon_user_id'], $usedProductCoupons)) {
235:                                 continue;
236:                             }
237:                             // 商品券，只对指定商品进行优惠
238:                             $coupon = $coupon->toArray();
239:                             $couponProductIds = array_column($coupon['product'], 'product_id');
240:                             if (in_array($cart['product_id'], $couponProductIds)) {
241:                                 $fee = max((float)bcsub($cart['paymentPrice'], $coupon['coupon_price'], 2), 0);
242:                                 $productCouponPrice = ($fee == 0) ? $cart['paymentPrice'] : $coupon['coupon_price'];
243:                                 $usedCoupons = $this->recodeUseCoupon($usedCoupons, $coupon['coupon_user_id'], $productCouponPrice, $coupon['coupon']['type'], $cart);
244:                                 $cart['paymentPrice'] = $fee;
245:                             }
246:                             continue;
247:                         }
248:                         // 平台券和店铺券，对所有商品进行优惠，按比例分配优惠金额
249:                         $rate = bcdiv($coupon['coupon_price'], $oldTotalPrice, 4);
250:                         if ($rate > 1) {
251:                             $usedCoupons = $this->recodeUseCoupon($usedCoupons, $coupon['coupon_user_id'], $cart['paymentPrice'], $coupon['coupon']['type'], $cart);
252:                             $cart['paymentPrice'] = 0;
253:                             continue;
254:                         }
255:                         // 是否为最后一个商品，则将剩余的优惠券优惠金额分配给最后一个商品
256:                         if (count($cartList) >1 && (count($cartList) == $key + 1) && isset($couponRemainingPrice[$coupon['coupon_id']])) {
257:                             $cart['paymentPrice'] = (float)bcsub($cart['paymentPrice'], $couponRemainingPrice[$coupon['coupon_id']], 2);
258:                             $usedCoupons = $this->recodeUseCoupon($usedCoupons, $coupon['coupon_user_id'], $couponRemainingPrice[$coupon['coupon_id']], $coupon['coupon']['type'], $cart);
259:                             continue;
260:                         }
261:                         $couponPrice = (count($cartList) == 1) ? $coupon['coupon_price'] : bcmul($cart['paymentPrice'], $rate, 2);
262:                         $cart['paymentPrice'] = (float)bcsub($cart['paymentPrice'], $couponPrice, 2);
263:                         // 计算剩余优惠金额，用于下一个商品的优惠券分配
264:                         $couponRemainingPrice[$coupon['coupon_id']] = (float)bcsub($couponRemainingPrice[$coupon['coupon_id']] ?? $coupon['coupon_price'], $couponPrice, 2);
265:                         $usedCoupons = $this->recodeUseCoupon($usedCoupons, $coupon['coupon_user_id'], $couponPrice, $coupon['coupon']['type'], $cart);
266:                     }
267:                 }
268:             }
269:             $cart['couponsDiscount'] = (float)bcsub($paymentPrice, $cart['paymentPrice'], 2);
270: 
271:             $result['totalPaymentPrice'] += $cart['paymentPrice']; // 实付总金额
272:             $result['discountDetail']['couponsDiscountAmount'] += $cart['couponsDiscount']; // 优惠券优惠金额
273:             $result['usedCoupons'] = $usedCoupons;
274:         }
275: 
276:         if(!$usedCoupons) {
277:             // 如果使用了优惠券则再次校验优惠券信息
278:             $result['couponList'] = $this->getStoreCouponUserRepository()->validCoupon($result['couponList'], $useCoupon, $cartList, $result['totalPaymentPrice'], $merId);
279:         }
280: 
281:         return $result;
282:     }
283:     /**
284:      * 记录使用的优惠券信息，并区分店铺券、商品券和平台券
285:      *
286:      * @param array $usedCoupons
287:      * @param integer $couponId
288:      * @param float $couponPrice
289:      * @param integer $type
290:      * @param $cart
291:      * @return void
292:      */
293:     private function recodeUseCoupon(array $usedCoupons, int $couponId, float $couponPrice, int $type, $cart)
294:     {
295:         switch ($type) {
296:             case 0: // 店铺券
297:                 $key = 'merchant';
298:                 break;
299:             case 1: // 商品券
300:                 $key = 'product';
301:                 break;
302:             default: // 平台券
303:                 $key = 'platform';
304:                 break;
305:         }
306:         $usedCoupons[$key][] = [
307:             'id' => $couponId,
308:             'cartId' => $cart['cart_id'],
309:             'price' => $couponPrice
310:         ];
311: 
312:         $cart["{$key}CouponDiscountAmount"] += $couponPrice;
313: 
314:         return $usedCoupons;
315:     }
316:     /**
317:      * 根据运费模板计算运费金额
318:      * $regionRule 运费规则数组
319:      * $aggregate 商品规格属性总量，type为0时，表示总数量；type为2时，表示总重量，type为3时，表示总体积。
320:      *
321:      * @param array $cartProductShippingFeeTemplate 运费模板数组
322:      * @return string
323:      */
324:     private function calculateShippingCost(array $cartProductShippingFeeTemplate): string
325:     {
326:         $fee = 0;
327:         foreach ($cartProductShippingFeeTemplate as $value) {
328:             if (empty($value['aggregate'])) {
329:                 continue;
330:             }
331:             $value = $value->toArray();
332:             $region = $value['region'] ?? null;
333:             if (!$region) {
334:                 continue;
335:             }
336:             $regionRule = array_shift($region);
337:             $aggregate = $value['aggregate'];
338:             $fee += $aggregate > 0 ? bcadd($regionRule['first_price'], bcmul(bcdiv(bcsub($aggregate, $regionRule['first'], 2), $regionRule['continue'], 2), $regionRule['continue_price'], 2), 2) : $regionRule['first_price'];
339:         }
340: 
341:         return $fee;
342:     }
343:     /**
344:      * 验证用户信息是否有效
345:      *
346:      * @param integer $uid
347:      * @return Model|null
348:      */
349:     private function validUser(int $uid): ?Model
350:     {
351:         if (!$uid) {
352:             return null;
353:         }
354: 
355:         $user = $this->getUserRepository()->userInfo($uid);
356:         if (empty($user)) {
357:             throw new ValidateException('用户不存在');
358:         }
359: 
360:         return $user;
361:     }
362:     /**
363:      * 验证地址信息是否有效
364:      *
365:      * @param [type] $addressId
366:      * @param [type] $uid
367:      * @return Model|null
368:      */
369:     private function validAddress($addressId, int $uid): ?Model
370:     {
371:         if (empty($addressId)) {
372:             return null;
373:         }
374:         $where['address_id'] = $addressId;
375:         if ($uid) {
376:             $where['uid'] = $uid;
377:         }
378: 
379:         $address = $this->getUserAddressRepository()->getWhere($where);
380:         if (empty($address)) {
381:             throw new ValidateException('地址不存在');
382:         }
383: 
384:         return $address;
385:     }
386:     /**
387:      * 验证购物车信息是否有效
388:      * 若存在失效商品则抛出异常
389:      * 若超出限购数也抛出异常
390:      * 若存在非正常商品也抛出
391:      *
392:      * @param $user
393:      * @param integer $merId
394:      * @param array $cartIds
395:      * @param $address
396:      * @return array
397:      */
398:     private function validCartList($user, int $merId, array $cartIds, $address): ?array
399:     {
400:         $res = $this->getStoreCartRepository()->getMerchantList($user, $merId, $cartIds, $address);
401:         if (count($res['fail'])) {
402:             throw new ValidateException('存在已失效商品，请检查');
403:         }
404: 
405:         return $res['list'];
406:     }
407:     /**
408:      * 获取优惠券信息
409:      *
410:      * @param integer $uid
411:      * @param integer $merId
412:      * @param array $useCoupon
413:      * @return void
414:      */
415:     private function fetchUserCoupons(int $uid, int $merId)
416:     {
417:         return $this->getStoreCouponUserRepository()->validUserCoupon($uid, $merId);
418:     }
419: }
