1090:     /**
1091:      * 处理订单的领取操作。
1092:      * 此函数主要用于将订单状态更新为已领取，同时记录相应的日志。
1093:      *
1094:      * @param int $id 订单ID。
1095:      * @param User|null $user 当前操作的用户对象，如果为null，则表示是系统操作。
1096:      * @throws ValidateException 如果订单不存在或状态不正确，则抛出验证异常。
1097:      */
1098:     public function takeOrder($id, ?User $user = null, $isApi = false)
1099:     {
1100:         // 根据订单ID和用户ID（如果存在）查询订单，排除已删除的订单。
1101:         $order = $this->dao->searchAll(!$user ? [] : ['uid' => $user->uid])->where('order_id', $id)->where('StoreOrder.is_del', '<>', 1)->find();
1102:         // 如果订单不存在，则抛出验证异常。
1103:         if (!$order)
1104:             throw new ValidateException('订单不存在');
1105:         // 如果订单状态不为待领取（1）或订单类型不为特定值（20），则抛出验证异常。
1106:         if ($order['status'] != 1)
1107:             throw new ValidateException('订单状态有误');
1108:         if ($order['order_type'] && !in_array($order['order_type'], [2,20])) // 2:同城配送、20:积分订单
1109:             throw new ValidateException('订单类型有误');
1110:         // 确定日志记录函数的名字，如果没有用户，则使用系统日志记录函数。
1111:         if (!$user) {
1112:             $user = $order->user;
1113:         }
1114:         // 根据订单的活动类型，更新订单状态为待评价（2）或已完成（3）。
1115:         // 订单状态（0：待发货；1：待收货；2：待评价；3：已完成； 9: 拼团中 10:  待付尾款 11:尾款超时未付 -1：已退款）
1116:         $order->status = $order->activity_type == 20 ? 3 : 2;
1117:         // 设置订单的确认收货时间。
1118:         $order->verify_time = date('Y-m-d H:i:s');
1119:         // 触发订单领取前的事件。
1120:         event('order.take.before', compact('order'));
1121:         // 创建订单状态更新对象。
1122:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
1123:         $orderStatus = [
1124:             'order_id' => $order->order_id,
1125:             'order_sn' => $order->order_sn,
1126:             'type' => $storeOrderStatusRepository::TYPE_ORDER,
1127:             'change_message' => '已收货',
1128:             'change_type' => $storeOrderStatusRepository::ORDER_STATUS_TAKE,
1129:         ];
1130:         // 使用事务处理订单状态的更新和日志的记录。
1131:         Db::transaction(function () use ($order, $user, $storeOrderStatusRepository, $orderStatus, $isApi) {
1132:             // 执行领取后的处理逻辑。
1133:             $this->takeAfter($order, $user);
1134: 
1135:             if($order['order_type'] == 2 && $order->deliveryOrder) {
1136:                 $order->deliveryOrder->status = 4;
1137:                 $order->deliveryOrder->save();
1138:             }
1139:             // 保存订单的更新。
1140:             $order->save();
1141:             // 调用相应的日志记录函数。
1142:             if($isApi) {
1143:                 $storeOrderStatusRepository->createUserLog($user->uid, $orderStatus);
1144:             }else{
1145:                 $storeOrderStatusRepository->createSysLog($orderStatus);
1146:             }
1147:         });
1148:         // 触发订单领取后的事件。
1149:         event('order.take', compact('order'));
1150:     }
