 30:     /**
 31:      * 分拆订单
 32:      *
 33:      * 本函数用于将一个订单按照指定的规则进行分拆处理。它首先构建一个锁服务的实例，以确保订单分拆的操作是原子性的，
 34:      * 避免并发操作导致的数据不一致问题。然后，通过调用内部的execSplitOrder方法，实际执行订单的分拆逻辑。
 35:      *
 36:      * @param StoreOrder $order 待分拆的订单对象
 37:      * @param array $rule 分拆规则，具体结构和内容根据业务需求定义
 38:      * @param int $service_id 服务ID，用于指定特定的服务进行订单分拆，默认为0，表示使用默认服务
 39:      * @param null $type 分拆类型，用于指定订单分拆的具体类型，可为空，具体含义根据业务需求定义
 40:      * @return mixed 返回订单分拆操作的结果，具体类型和结构根据业务逻辑而定
 41:      */
 42:     public function splitOrder(StoreOrder $order, array $rule, $service_id = 0,$type = null)
 43:     {
 44:         // 使用依赖注入获取锁服务实例，并执行订单分拆的锁定操作
 45:         return app()->make(LockService::class)->exec('order.split.' . $order->order_id, function () use ($rule, $order,$service_id,$type) {
 46:             // 调用内部方法实际执行订单分拆逻辑
 47:             return $this->execSplitOrder($order, $rule, $service_id,$type);
 48:         });
 49:     }
