158:     /**
159:      * 检查传入的发票ID是否全部属于指定的商家
160:      *
161:      * 此函数用于验证一个或多个发票ID是否属于指定的商家ID。它通过分解发票ID字符串，然后逐一检查每个发票ID是否与指定的商家ID相关联。
162:      * 如果任何一个发票ID不属于指定的商家ID，则抛出一个验证异常，表示数据有误。
163:      * 这个函数确保了只有属于商家的发票才能被商家操作，增强了系统的数据安全性和业务逻辑的正确性。
164:      *
165:      * @param string $ids 发票ID的字符串，多个ID用逗号分隔。
166:      * @param int $merId 商家ID，用于检查发票是否属于这个商家。
167:      * @return bool 如果所有发票ID都属于指定商家，则返回true；否则抛出ValidateException异常。
168:      * @throws ValidateException 如果任何一个发票ID不属于指定的商家，则抛出此异常。
169:      */
170:     public function merExists(string $ids,int $merId)
171:     {
172:         // 将发票ID字符串分解为数组
173:         $ids = explode(',',$ids);
174: 
175:         // 遍历发票ID数组，检查每个ID是否与指定的商家ID相关联
176:         foreach ($ids as $id) {
