185:                 if ($this->product->product_type !==  0 || $this->product->is_show !== 1 || $this->productAttr->stock < $this->cart_num || $this->product->is_used !== 1) {
186:                     return false;
187:                 }
188:                 break;
189:             case 1: //秒杀商品
190:                 if ($this->product->product_type !== 1 || $this->product->is_show !== 1) return false;
191:                 //结束时间
192:                 if ($this->product->seckill_status !== 1) return false;
193:                 //限量
194:                 $order_make = app()->make(StoreOrderRepository::class);
195:                 $count = $order_make->seckillOrderCounut($this->product->active_id, $this->product_id);
196:                 if ($this->productAttr->stock <= $count) return false;
197: 
198:                 //原商品sku库存
199:                 $value_make = app()->make(ProductAttrValueRepository::class);
200:                 $sku = $value_make->getWhere(['sku' => $this->productAttr->sku, 'product_id' => $this->product->old_product_id]);
201:                 if (!$sku || $sku['stock'] <= 0) return false;
202: 
203:                 break;
204: 
205:             case 2: //预售商品
206:                 if($this->source !== 2 || $this->product->product_type !== 2) return false;
207:                 if($this->productPresell->status !== 1 ||
208:                     $this->productPresell->is_show !== 1 ||
209:                     $this->productPresell->is_del !== 0 ||
210:                     $this->productPresell->presell_status !== 1)
211:                 {$this->is_fail = 1;$this->save();return false;}
212: 
213:                 $sku = $this->ActiveSku;
214:                 if(!$sku || !$sku->sku()) {$this->is_fail = 1; $this->save(); return false; }
215: 
216:                 //库存不足
217:                 if($sku->stock < $this->cart_num || $sku->sku->stock < $this->cart_num) return false;
218:                 break;
219: 
220:             case 3: //助力商品
221:                 if($this->source !== 3 ||  $this->product->product_type !== 3 || ($this->productAssistSet->assist_count !== $this->productAssistSet->yet_assist_count)) return false;
222:                 if(
223:                     $this->productAssistSet->stop_time < time() ||
224:                     $this->productAssistSet->sataus === -1 ||
225:                     !$this->productAssistSet->assist->is_show ||
226:                     $this->productAssistSet->assist->is_del !== 0 ||
227:                     $this->productAssistSet->assist->status !== 1)
228:                 {$this->is_fail = 1;$this->save();return false;}
229:                 $sku = $this->ActiveSku;
230:                 if(!$sku || !$sku->sku()) { $this->is_fail = 1; $this->save(); return false; }
231:                 //库存不足
232:                 if($sku->stock < $this->cart_num || $sku->sku->stock < $this->cart_num) return false;
233:                 break;
234:             case 4:
235:                 if($this->source !== 4 ||  $this->product->product_type !== 4 ) return false;
236:                 $sku = $this->ActiveSku;
237:                 if(!$sku || !$sku->sku()) { $this->is_fail = 1; $this->save(); return false; }
238:                 //库存不足
239:                 if($sku->stock < $this->cart_num || $sku->sku->stock < $this->cart_num) return false;
240:                 break;
241:         }
242:         return true;
243:     }
244: 
245:     /**
246:      *
247:      * @return bool
248:      * @author Qinii
249:      * @day 2020-10-29
250:      */
251:     public function getUserPayCountAttr()
252:     {
253:         $make = app()->make(StoreOrderRepository::class);
254:         switch ($this->product_type)
255:         {
256:             case 1: //秒杀
257:                 if(!$make->getDayPayCount($this->uid,$this->product_id,$this->cart_num) || !$make->getPayCount($this->uid,$this->product_id,$this->cart_num))
258:                     return false;
259:                 break;
260:             case 2: //预售
261:                 $count = $this->productPresell->pay_count;
262:                 if($count == 0) return true;
263:                 $tattend = [
264:                     'activity_id' => $this->source_id,
265:                     'product_type' => 2,
266:                 ];
267:                 $pay_count = $make->getTattendCount($tattend,$this->uid)->sum('total_num');
268:                 if($pay_count < $count) return false;
269:                 if (($count - $pay_count)  < $this->cart_num) return false;
270:                 break;
271:             case 3: //助力
272:                 $tattend = [
273:                     'activity_id' => $this->source_id,
274:                     'product_type' => 3,
275:                 ];
276:                 $pay_count = $make->getTattendCount($tattend,$this->uid)->count();
277:                 if($pay_count) return false;
278: 
279:                 $count = $this->productAssistSet->assist->pay_count;
280:                 if($count !== 0){
281:                     $_tattend = [
282:                         'exsits_id' => $this->productAssistSet->assist->product_assist_id,
283:                         'product_type' => 3,
284:                     ];
285:                     $_count = $make->getTattendCount($_tattend,$this->uid)->count();
286:                     if($_count >= $count) return false;
287:                 }
288:                 break;
289:             case 4:
290:                 $tattend = [
291:                     'exsits_id' => $this->product_id,
292:                     'product_type' => 4,
293:                 ];
294:                 $pay_count = $make->getTattendCount($tattend,$this->uid)->count();
295:                 if($pay_count) return false;
296:                 $count = $this->product->productGroup->pay_count;
297:                 if($count !== 0){
298:                     $_tattend = [
299:                         'exsits_id' => $this->product_id,
300:                         'product_type' => 34,
301:                     ];
302:                     $_count = $make->getTattendCount($_tattend,$this->uid)->count();
303:                     if($_count >= $count) return false;
304:                 }
305:                 break;
306:         }
307:         return true;
308:     }
