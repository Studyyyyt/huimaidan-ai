 77:                         'record_sn' => $this->getSn(),
 78:                         'order_id' => $orderInfo->order_id,
 79:                         'order_sn' => $orderInfo->order_sn,
 80:                         'user_id' => $orderInfo->uid,
 81:                         'user_info' => $orderInfo->user->nickname ?? '游客',
 82:                         'amount' => $amount
 83:                     ];
 84:                 }
 85:             }
 86:             $circleName = $firstCircle->name . '/';
 87:         }
 88:         if ($circle->level == 2) { // 三层
 89:             // 一级商圈
 90:             $firstCircle = $circle->parent->parent;
 91:             $firstCircleAgent = $firstCircle->circleAgent;
 92:             if ($firstCircleAgent && $firstCircle && $firstCircle->status) {
 93:                 $amount = bcmul($commissionPrice, bcdiv(bcsub($firstCircle->commission_rate, $circle->parent->commission_rate), 100, 2), 2);
 94:                 if($firstCircle->type == 0) {
 95:                     $data[] = [
 96:                         'circle_id' => $firstCircle->circle_id,
 97:                         'circle_name' => $firstCircle->name,
 98:                         'mer_id' => $merchant->mer_id,
 99:                         'mer_name' => $merchant->mer_name,
100:                         'agent_id' => $firstCircleAgent->circle_agent_id,
101:                         'agent_name' => $firstCircleAgent->name,
102:                         'record_sn' => $this->getSn(),
103:                         'order_id' => $orderInfo->order_id,
104:                         'order_sn' => $orderInfo->order_sn,
105:                         'user_id' => $orderInfo->uid,
106:                         'user_info' => $orderInfo->user->nickname ?? '游客',
107:                         'amount' => $amount
108:                     ];
109:                 }
110:             }
111:             // 二级商圈
112:             $secondCircle = $circle->parent;
113:             $secondCircleAgent = $secondCircle->circleAgent;
114:             if ($secondCircleAgent && $secondCircle && $secondCircle->status) {
115:                 $amount = bcmul($commissionPrice, bcdiv(bcsub($secondCircle->commission_rate, $circle->commission_rate), 100, 2), 2);
116:                 if($secondCircle->type == 0) {
117:                     $data[] = [
