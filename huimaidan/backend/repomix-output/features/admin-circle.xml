 39:     public function insertAll($orderInfo)
 40:     {
 41:         if ($orderInfo->pay_price == 0) {
 42:             return false;
 43:         }
 44:         // 商户信息
 45:         $merchant = $orderInfo->merchant;
 46:         if(!$merchant) {
 47:             return false;
 48:         }
 49:         // 计算平台抽成
 50:         $commissionRate = (float)($merchant->commission_switch ? bcdiv($merchant->commission_rate, 100, 2) : $merchant->merchantCategory->commission_rate);
 51:         if (!$commissionRate) {
 52:             return false;
