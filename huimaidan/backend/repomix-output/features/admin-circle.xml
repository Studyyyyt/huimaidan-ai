196:         return Db::transaction(function () use ($id, $info) {
197:             if($info['circle_agent_id']) {
198:                 // 清除原商圈管理员所属商圈ID
199:                 $this->updateAdminRegionIds($info['circle_agent_id'], $id, false);
200:             }
201:             // 商圈删除后释放商户所属商圈
202:             app()->make(MerchantRepository::class)->search(['region_id' => $info['circle_id']])->update(['region_id' => 0]);
203:             $this->dao->delete($id);
204: 
205:             return true;
206:         });
207:     }
208:     /**
209:      * 切换组织状态
210:      *
211:      * @param integer $id
212:      * @param array $data
213:      * @return void
214:      */
215:     public function switch(int $id, array $data)
216:     {
217:         $info = $this->dao->get($id);
218:         if (!$info) {
219:             throw new ValidateException('记录不存在!');
220:         }
221: 
222:         $info->status = $data['status'];
223: 
224:         return $info->save();
225:     }
226:     /**
227:      * 获取商圈下关联的店铺列表
228:      *
229:      * @param integer $id
230:      * @param integer $page
231:      * @param integer $limit
232:      * @param array $where
233:      * @return void
234:      */
235:     public function associatedMerchantList($id, $page, $limit, $where)
236:     {
237:         $info = $this->dao->get($id);
238:         if (!$info) {
239:             throw new ValidateException('商圈记录不存在!');
240:         }
241:         if($info['type'] == CircleDao::TYPE['REGION']) {
242:             $where['region_id'] = $id;
243:         }
244:         if($info['type'] == CircleDao::TYPE['MERCHANT']) {
245:             $where['business_id'] = $id;
246:         }
247:         $query = app()->make(MerchantRepository::class)->search($where);
248: 
249:         $count = $query->count();
250:         $list = $query->page($page, $limit)->field('mer_id, mer_name, real_name ,mer_phone, region_id,status,mer_state')->select();
251: 
252:         return compact('list', 'count');
253:     }
254:     /**
255:      * 更新商圈管理员所属商圈ID
256:      *
257:      * @param integer $circleAgentId
258:      * @param integer $regionIds
259:      * @param integer $roleId
260:      * @param bool $isAdd
261:      * @return void
262:      */
263:     protected function updateAdminRegionIds(int $circleAgentId, int $regionIds, bool $isAdd = true)
264:     {
265:         $adminRepository = app()->make(AdminRepository::class);
266:         $adminInfo = $adminRepository->getSearch(['circle_agent_id' => $circleAgentId])->find();
267: 
268:         $adminRegionIds = $adminInfo->region_ids ?: [];
269:         if (in_array($regionIds, $adminRegionIds) && !$isAdd) {
270:             $adminRegionIds = array_diff($adminRegionIds, [$regionIds]);
271:         } else {
272:             $adminRegionIds[] = $regionIds;
273:         }
274: 
275:         $adminInfo->region_ids = implode(',', $adminRegionIds);
276: 
277:         return $adminInfo->save();
278:     }
279:     /**
280:      * 检查身份权限数据
281:      *
282:      * @param array $data
283:      * @return void
284:      */
285:     private function checkRole(array $data)
286:     {
287:         // 检查身份权限数据
288:         $role = app()->make(RoleRepository::class)->get($data['role_id']);
289:         if (!$role) {
290:             throw new ValidateException('身份权限数据不存在!');
291:         }
292:         if (self::IS_AGENT[$data['type']] != $role['is_agent']) {
293:             throw new ValidateException('组织类型和身份权限类型不匹配!');
294:         }
295:     }
296:     /**
297:      * 检查提成比例
298:      *
299:      * @param array $data
300:      * @param integer $id
301:      * @param array $info
302:      * @return void
303:      */
304:     private function checkRate($data, $id = 0, $info = null)
305:     {
306:         if($data['type'] == CircleDao::TYPE['MERCHANT']) {
307:             return false;
308:         }
309:         if ($data['pid'] && $data['commission_type']) {
310:             $this->checkParentLevelRate($data['commission_rate'], $data['pid']);
311:         }
312:         // 存在子级时，检查当前层级提成比例是否低于子级层级提成比例
313:         if ($id && $info['level'] != 2) {
314:             $this->checkChildLevelRate($data['commission_rate'], $id);
315:         }
316:     }
317:     /**
318:      * 检查父级层级提成比例
319:      *
320:      * @param float $rate
321:      * @param int $pid
322:      * @return void
323:      */
324:     private function checkParentLevelRate(float $rate, int $pid)
325:     {
326:         $parentRateInfo = $this->dao->getWhere(['circle_id' => $pid], 'commission_type, commission_rate, level');
327:         if($rate > $parentRateInfo['commission_rate']) {
328:             throw new ValidateException("子级提成比例【{$rate}】不能大于父级提成比例【{$parentRateInfo['commission_rate']}】，请重新设置!");
329:         }
330: 
331:         return true;
332:     }
333:     /**
334:      * 检查子级层级提成比例
335:      *
336:      * @param float $rate
337:      * @param int $id
338:      * @return void
339:      */
340:     private function checkChildLevelRate(float $rate, int $id)
341:     {
342:         $childRateInfo = $this->dao->getSearch(['pid' => $id])->field('circle_id, name, commission_type, commission_rate, level')->select()->toArray();
343:         if(!$childRateInfo) {
344:             return true;
345:         }
346: 
347:         foreach ($childRateInfo as $child) {
348:             if($child['commission_rate'] > $rate) {
349:                 throw new ValidateException("当前层级提成比例【{$rate}】不能小于子级【{$child['name']}】的提成比例【{$child['commission_rate']}】，请先修改子级设置!");
350:             }
351:         }
352: 
353:         return true;
354:     }
355: }
