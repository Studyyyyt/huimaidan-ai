160:     public function defrost($order)
161:     {
162:         $recodes = $this->dao->getSearch(['order_id' => $order->order_id, 'status' => 0])->select();
163:         if ($recodes->isEmpty()) {
164:             return false;
165:         }
166: 
167:         Db::transaction(function () use ($recodes) {
168:             foreach ($recodes as $recod) {
169:                 // 解冻流水
170:                 $recod->status = 1;
171:                 $recod->save();
172:                 // 增加商圈代理商余额
173:                 $circleAgent = $recod->circleAgent;
174:                 if ($circleAgent) {
175:                     $circleAgent->balance += $recod->amount;
176:                     $circleAgent->update_time = date('Y-m-d H:i:s');
177:                     $circleAgent->save();
178:                 }
179:             }
180:         });
181:     }
182: 
183:     public function invalid($order)
184:     {
185:         $recodes = $this->dao->getSearch(['order_id' => $order->order_id, 'status' => 0])->select();
186:         if ($recodes->isEmpty()) {
187:             return false;
188:         }
189: 
190:         Db::transaction(function () use ($recodes, $order) {
191:             foreach ($recodes as $recod) {
192:                 // 作废流水
193:                 $recod->status = -1;
194:                 $recod->save();
195:             }
196:             // 部分退款重新计算商圈提成
197:             if ($order->status == 0) {
198:                 $newOrder = $order;
199:                 $orderProduct = $newOrder->orderProduct;
200:                 $refundPrice = 0;
201:                 foreach ($orderProduct as $product) {
202:                     if (in_array($product->is_refund, [2, 3])) {
203:                         $unitPrice = bcdiv($product->total_price, $product->product_num, 2); // 单价
204:                         // 已退款金额 = 单价 * （总数量 - 可退数量）
205:                         $refundPrice += bcmul($unitPrice, bcsub($product->product_num, $product->refund_num), 2);
206:                     }
207:                 }
208:                 // 更新订单总价，减去已退款金额
209:                 $newOrder->total_price = bcsub($newOrder->total_price, $refundPrice, 2);
210:                 // 重新计算商圈提成
211:                 $this->insertAll($newOrder);
212:                 unset($newOrder);
213:             }
214:         });
215:     }
216: 
217:     protected function getSn()
218:     {
219:         // 获取当前时间的微秒和秒部分
220:         list($msec, $sec) = explode(' ', microtime());
221: 
222:         // 将微秒和秒转换为毫秒，并格式化为整数
223:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
224: 
225:         // 生成订单编号：前缀 + 毫秒时间戳 + 随机数
226:         // 保证随机数在特定范围内，避免生成重复的订单编号
227:         $orderId = 'cfr' . $msectime . mt_rand(10000, max(intval($msec * 10000) + 10000, 98369));
228: 
229:         return $orderId;
230:     }
231: }
