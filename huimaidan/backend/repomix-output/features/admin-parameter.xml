178:     /**
179:      *  验证参数
180:      * @param $isCreate
181:      * @return array
182:      * @author Qinii
183:      */
184:     public function checkParams($isCreate = 0)
185:     {
186:         $mer_id = $this->request->merId();
187:         $data = $this->request->params(['template_name', ['cate_ids', []], 'sort', 'params','delete_params']);
188:         app()->make(ParameterTemplateValidate::class)->check($data);
189:         if ($mer_id == 0 && empty($data['cate_ids'])) {
190:             throw new ValidateException('请选择商品分类');
191:         }
192:         if ($isCreate) {
193:             foreach ($data['params'] as $item) {
194:                 foreach ($item['values'] as &$subArray) {
195:                     if (isset($subArray['parameter_value_id'])) {
196:                         unset($subArray['parameter_value_id']);
197:                     }
198:                 }
199:                 if (isset($item['parameter_id'])) unset($item['parameter_id']);
200:                 if (isset($item['template_id'])) unset($item['template_id']);
201:                 $params[] = $item;
202:             }
203:             $data['params'] = $params;
204:         }
205:         return $data;
206:     }
