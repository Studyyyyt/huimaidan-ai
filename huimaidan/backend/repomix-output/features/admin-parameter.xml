 48:     public function lst()
 49:     {
 50:         [$page, $limit] = $this->getPage();
 51:         $where = $this->request->params(['template_name', 'cate_ids', 'mer_name', 'mer_id']);
 52:         $where['is_mer'] = $this->request->param('is_mer', 1);
 53:         if ($merId = $this->request->merId()) {
 54:             $where['mer_id'] = $merId;
 55:             unset($where['is_mer']);
 56:         }
 57:         // 处理分类id
 58:         if (!empty($where['cate_ids'])) {
 59:             $where['cate_id'] = end($where['cate_ids']);
 60:             if(count($where['cate_ids']) !== 3) {
 61:                 $cartWhere = [
 62:                     ['path', 'like', '%/'.$where['cate_id'].'/%'],
 63:                     ['is_show', '=', 1]
 64:                 ];
 65:                 $categories = app()->make(StoreCategoryRepository::class)->selectWhere($cartWhere, 'store_category_id')->toArray();
 66:                 $storeCategoryIds = array_column($categories, 'store_category_id');
 67:                 $where['cate_id'] = $storeCategoryIds;
 68:             }
 69:             unset($where['cate_ids']);
 70:         }
 71:         $data = $this->repository->getList($where, $page, $limit);
 72:         return app('json')->success($data);
 73:     }
