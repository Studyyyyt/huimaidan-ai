 26: 
 27: class ArticleDao extends BaseDao
 28: {
 29: 
 30:     /**
 31:      * @return BaseModel
 32:      * @author xaboy
 33:      * @day 2020-03-30
 34:      */
 35:     protected function getModel(): string
 36:     {
 37:         return Article::class;
 38:     }
 39: 
 40:     /**
 41:      * 获取全部文章
 42:      * @param int $mer_id
 43:      * @return Collection
 44:      * @throws DataNotFoundException
 45:      * @throws DbException
 46:      * @throws ModelNotFoundException
 47:      */
 48:     public function getAll($mer_id = 0)
 49:     {
 50:         return Article::getDB()->with('content')->where('mer_id', $mer_id)->select();
 51:     }
 52: 
 53:     /**
 54:      * 搜索列表
 55:      * @param $merId
 56:      * @param array $where
 57:      * @return BaseQuery
 58:      * @author Qinii
 59:      */
 60:     public function search($merId,array $where)
 61:     {
 62:         $query = Article::getDB();
 63:         if (isset($where['cid']) && $where['cid'] !== '') $query->where('cid', (int)$where['cid']);
 64:         if (isset($where['title']) && $where['title'] !== '') $query->whereLike('title', "%{$where['title']}%");
 65:         if (isset($where['status']) && $where['status'] !== '') $query->where('status', $where['status']);
 66:         if (isset($where['wechat_news_id']) && $where['wechat_news_id'] !== '') $query->where('wechat_news_id', $where['wechat_news_id']);
 67: 
 68:         if (isset($where['article_id']) && $where['article_id'] !== ''){
 69:             if (is_array($where['article_id'])) {
 70:                 $query->whereIn('article_id', $where['article_id']);
 71:             } else {
 72:                 $query->where('article_id', $where['article_id']);
 73:             }
 74: 
 75:         }
 76: 
 77: 
 78:         $query->with(['content','articleCategory']);
 79: 
 80:         return $query->where('mer_id',$merId)->order('sort DESC,create_time DESC');
 81:     }
 82: 
 83: 
 84: 
 85:     /**
 86:      * 根据 字段名查询
 87:      * @param int $merId
 88:      * @param $field
 89:      * @param $value
 90:      * @param null $except
 91:      * @return bool
 92:      * @author Qinii
 93:      */
 94:     public function merFieldExists(int $merId, $field, $value, $except = null)
 95:     {
 96:         return ($this->getModel())::getDB()->when($except, function ($query, $except) use ($field) {
 97:                 $query->where($field, '<>', $except);
 98:             })->where('mer_id', $merId)->where('wechat_news_id',0)->where($field, $value)->count() > 0;
 99:     }
100: 
101:     /**
102:      * @param int $id
103:      * @param int $merId
104:      * @return int
105:      * @throws DbException
106:      * @author xaboy
107:      * @day 2020-04-20
108:      */
109:     public function delete(int $id, int $merId = 0)
110:     {
111:         $result = ($this->getModel())::getDB()->where('mer_id', $merId)
112:             ->where($this->getPk(),$id)
113:             ->with('content')
114:             ->find();
115:         return $result->together(['content'])->delete();
116:     }
117: 
118: 
119:     /**
120:      * 关联添加
121:      * @param array $data
122:      * @return BaseDao|Model|void
123:      * @author Qinii
124:      */
125:     public function create(array $data)
126:     {
127:         Db::transaction(function()use($data){
128:             $content = $data['content'];
129:             unset($data['content']);
130:             $article = $this->getModel()::create($data);
131:             $article->content()->save(['content' => $content]);
132:         });
133:     }
134: 
135:     /**
136:      * 关联更新
137:      * @param int $id
138:      * @param array $data
139:      * @return int|void
140:      * @author Qinii
141:      */
142:     public function update(int $id, array $data)
143:     {
144:         Db::transaction(function()use($id,$data){
145:             $content = $data['content'];
146:             unset($data['content']);
147: 
148:             $this->getModel()::where($this->getPk(),$id)->update($data);
149: 
150:             $article = $this->getModel()::find($id);
151:             $article->content->content = $content;
152:             $article->together(['content'])->save();
153:         });
154:     }
155: 
156:     /**
157:      * 根据字段获取 主键值
158:      * @param int $vale
159:      * @param null $field
160:      * @return array
161:      * @author Qinii
162:      */
163:     public function getKey(int $vale,$field = null)
164:     {
165:         return ($this->getModel())::getDB()->where($field,$vale)->column($this->getPk());
166:     }
167: 
168:     /**
169:      * 查询微信图文消息
170:      * @param $id
171:      * @return array|Collection|BaseQuery[]
172:      * @throws DataNotFoundException
173:      * @throws DbException
174:      * @throws ModelNotFoundException
175:      * @author wuhaotian
176:      * @email 442384644@qq.com
177:      * @date 2024/7/12
178:      */
179:     public function wechatNewIdByData($id)
180:     {
181:         return ($this->getModel())::getDB()->where('wechat_news_id', $id)->select();
182:     }
183: 
184:     /**
185:      * 切换状态
186:      * @param $id
187:      * @param $data
188:      * @return int
189:      * @throws DbException
190:      * @author wuhaotian
191:      * @email 442384644@qq.com
192:      * @date 2024/7/12
193:      */
194:     public function switchStatus($id, $data)
195:     {
196:        return ($this->getModel())::getDB()->where($this->getPk(),$id)->update($data);
197:     }
198: 
199:     /**
200:      * 增加阅读量
201:      * @param $id
202:      * @author wuhaotian
203:      * @email 442384644@qq.com
204:      * @date 2024/7/12
205:      */
206:     public function incVisit($id)
