66:             return app('json')->fail('文章不存在');
67:         $data = $this->repository->getWith($id, ['content']);
68:         if ($this->request->isLogin()) {
69:             $uid = $this->request->uid();
70:             $make = app()->make(UserVisitRepository::class);
71:             $count = $make->search(['uid' => $uid, 'type' => 'article'])->where('type_id', $id)->whereTime('UserVisit.create_time', '>', date('Y-m-d H:i:s', strtotime('- 300 seconds')))->count();
72:             if (!$count) {
73:                 SwooleTaskService::visit(intval($uid), $id, 'article');
74:                 $this->repository->incField($id, 'visit');
75:             }
76:         }
77: 
78:         return app('json')->success($data);
