157:     protected function getOrder(&$redata, $date, $format, $merId = '')
158:     {
159:         $storeOrderRepository = app()->make(StoreOrderRepository::class);
160:         $field = Db::raw("from_unixtime(unix_timestamp(StoreOrder.create_time),'{$format}') as month,sum(total_num) as total_num");
161:         $query = $storeOrderRepository->search(['date' => $date, 'mer_id' => $merId])->field($field);
162: 
163:         $res = $query->group("month")->select()->toArray();
164:         foreach ($res as $re) {
165:             if(isset( $redata[$re['month']])) {
166:                 $redata[$re['month']]['total_num'] = (int)$re['total_num'];
167:             }
168:         }
169: 
170:         $ress = $query->where('paid',1)->group("month")->select()->toArray();
