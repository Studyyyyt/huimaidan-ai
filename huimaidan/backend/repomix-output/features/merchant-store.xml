108:         $parameterRepository = app()->make(ParameterRepository::class);
109:         $parameterProductRepository = app()->make(ParameterProductRepository::class);
110:         $ids = [];
111:         foreach ($id as $i) {
112:             $data = $parameterRepository->getWhere(['parameter_id' => $i, 'mer_id' => $merId]);
113:             if ($data) {$ids[] = $i;}
114:         }
115:         if ($ids) {
116:             return Db::transaction(function () use ($ids,$parameterRepository,$parameterProductRepository) {
117:                 $parameterRepository->getSearch([])->whereIn('parameter_id',$ids)->delete();
118:                 $query = $this->dao->getSearch(['parameter_id' => $ids]);
