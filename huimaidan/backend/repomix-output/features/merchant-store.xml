 90:      */
 91:     public function getCategorySearch($where)
 92:     {
 93:         // 实例化ProductRepository类，用于后续获取产品展示配置和品牌信息
 94:         $make = app()->make(ProductRepository::class);
 95:         // 将产品展示配置合并到查询条件中
 96:         $where = array_merge($where, $make->productShow());
 97:         // 根据分类条件获取品牌ID列表
 98:         $brandIds = app()->make(ProductRepository::class)->getBrandByCategory($where);
 99:         // 初始化品牌数量和品牌列表
100:         $count = 0;
101:         $list = [];
102:         // 如果有品牌ID，则进行查询
103:         if ($brandIds) {
104:             // 执行品牌搜索查询，条件为品牌ID列表
105:             $query = $this->dao->search(['ids' => $brandIds]);
