339:     public function checkMechantCartList($res, $user)
340:     {
341:         $arr = $fail = [];
342: 
343:         $productRepository = app()->make(ProductRepository::class);
344:         $storeCartPriceDao = app()->make(StoreCartPriceDao::class);
345:         foreach ($res as $item) {
