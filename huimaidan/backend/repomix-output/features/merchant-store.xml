 95:      * 本函数用于生成一个包含各种输入字段的表单，用于创建或编辑秒杀活动的配置信息。
 96:      * 表单字段包括标题、开始时间、结束时间、状态和图片等。根据传入的$id$参数决定是创建新记录还是编辑已有的记录。
 97:      *
 98:      * @param int|null $id 秒杀配置的ID，如果为null，则表示创建新记录；否则，表示编辑已有的记录。
 99:      * @param array $formData 表单的初始数据，用于填充表单字段的值。
100:      * @return \FormBuilder\Form|\think\form\Form
101:      */
102:     public function form(?int $id = null ,array $formData = [])
103:     {
104:         // 根据$id$的值决定表单的提交URL，如果是新建，则提交到创建URL；如果是编辑，则提交到更新URL。
105:         $form = Elm::createForm(is_null($id) ? Route::buildUrl('systemSeckillConfigCreate')->build() : Route::buildUrl('systemSeckillConfigUpdate', ['id' => $id])->build());
106: 
107:         // 设置表单的验证规则，包括各种输入字段的类型、必填项、占位符等。
108:         $form->setRule([
109:             // 设置标题输入字段的规则。
110:             Elm::input('title','场次名称：')->placeholder('请输入场次名称')->required('请输入场次名称'),
111:             // 设置开始时间选择字段的规则。
112:             Elm::select('start_time','开始时间：')->placeholder('请选择')->options($this->dao->getTime(1))->requiredNum('请选择开始时间'),
113:             // 设置结束时间选择字段的规则。
114:             Elm::select('end_time','结束时间：')->placeholder('请选择')->options($this->dao->getTime(0))->requiredNum('请选择结束时间'),
115:             // 设置状态开关字段的规则。
116:             Elm::switches('status','是否启用：')->activeValue(1)->inactiveValue(0)->inactiveText('关闭')->className('switch-width-double')->activeText('开启'),
117:             // 设置图片上传字段的规则，包括图片预览、上传配置等。
118:             Elm::frameImage('pic', '图片：', '/' . config('admin.admin_prefix') . '/setting/uploadPicture?field=pic&type=1')->width('1000px')->height('600px')->spin(0)->icon('el-icon-camera')->modal(['modal' => false])->props(['footer' => false])->appendRule('suffix', [
119:                 'type' => 'guidancePop',
120:                 'props' => [
121:                     'info' => '此图片将展示在移动端秒杀商品列表上方，(建议尺寸：710*300px)',
122:                 ]
123:             ]),
124:         ]);
125: 
126:         // 设置表单的标题和初始数据，然后返回表单对象。
127:         return $form->setTitle(is_null($id) ? '添加'  : '编辑')->formData($formData);
128:     }
