4217:      * @param integer $merId
4218:      * @return void
4219:      */
4220:     public function deliveryOrderSync(array $orderIds, int $merId)
4221:     {
4222:         $where['status'] = 0;
4223:         $where['mer_id'] = $merId;
4224:         $where['order_ids'] = $orderIds;
4225:         $orders = $this->dao->search($where)->with(['orderProduct'])->select();
4226:         foreach ($orders as $order) {
4227:             $res = $this->cityDelivery($order, $merId, $order->orderProduct->toArray());
4228:             if (!$res) {
4229:                 throw new ValidateException('同步失败, 订单号：'.$order['order_sn'].'，'.$order['merchant_take_info'][$merId]['sync_desc']);
4230:             }
4231:         }
4232:         return true;
4233:     }
4234: 
4235:     public function getDeliveryTrack(int $orderId)
4236:     {
4237:         // 同城配送订单并且是第三方配送
4238:         $where['order_type'] = 2; // 同城配送
4239:         $where['order_id'] = $orderId;
4240:         $orderInfo = $this->dao->getWhere(['order_id' => $orderId], 'order_id, order_sn order_type,merchant_take_id', ['deliveryOrder', 'take']);
4241:         if(!$orderInfo) return [];
4242: 
4243:         $deliveryTrack = [];
4244:         if($orderInfo->take->type && $orderInfo->deliveryOrder && $orderInfo->deliveryOrder['status'] > 0){
4245:             $deliveryTrack = app()->make(DeliveryOrderRepository::class)->getDeliveryTrack($orderInfo->deliveryOrder);
4246:             $address = lbs_address([], $orderInfo['user_address']);
4247:             $lat = $address['location']['lat'];
4248:             $lng = $address['location']['lng'];
4249: 
4250:             $distance = getDistance($lat, $lng, $deliveryTrack['lat'], $deliveryTrack['lng']) ?: 0;
4251:             // 距离单位转换
4252:             if ($distance < 0.9) {
4253:                 $distance = max(bcmul($distance, 1000, 0), 1).'m';
4254:                 if ($distance == '1m') {$distance = '100m以内';}
4255:             } else {
4256:                 $distance.= 'km';
4257:             }
4258: 
4259:             $deliveryTrack['distance'] = $distance;
4260:         }
4261: 
4262:         return $deliveryTrack;
4263:     }
