144:      * @day 1/11/21
145:      */
146:     public function checkStatus(?int $groupId)
147:     {
148:         $where = ['status' => 0, 'end_time' => time()];
149:         if ($groupId) $where = ['group_buying_id' => $groupId];
150:         $result = $this->dao->getSearch($where)->with([
151:             'groupUser' => function ($query) {
152:                 $query->where('uid', '>', 0)->where('is_del', 0);
153:             },
154:         ])->select();
155:         if (!$result) return true;
156:         foreach ($result as $res) {
157:             if ($res['yet_buying_num'] >= $res['buying_count_num']) {
158:                 $this->successChange($res);
159:             } else {
160:                 if ($res['end_time'] <= time()) {
161:                     if ($res['ficti_status'] && $res['yet_buying_num'] >= $res['buying_num']) {
162:                         $this->setFictiGroup($res);
163:                     } else {
164:                         $res->status = -1;
165:                         $res->save();
166:                         foreach ($res->groupUser as $item) {
167:                             Queue::push(CancelGroupBuyingJob::class, ['order_id' => $item['order_id'], 'message' => '拼团失败，自动退款']);
168:                         }
169:                     }
170:                 }
171:             }
172:         }
173:     }
