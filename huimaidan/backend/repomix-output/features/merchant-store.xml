 81:     /**
 82:      * 参团操作
 83:      * @param $userInfo
 84:      * @param int $activeId
 85:      * @param int $groupId
 86:      * @param int $orderId
 87:      * @author Qinii
 88:      * @day 1/11/21
 89:      */
 90:     public function create($userInfo, int $activeId, int $groupId, int $orderId)
 91:     {
 92:         /**
 93:          * 1. 活动商品是否在售，
 94:          * 2. 团是否存在，
 95:          *      2.1 存在是否可加入
 96:          *      2.2 不存在，创建团，标记为团长
 97:          * 3. 记录参团人信息
 98:          */
 99:         $active_make = app()->make(ProductGroupRepository::class);
100: 
101:         $where = $active_make->actionShow();
102:         $where['product_group_id'] = $activeId;
103:         $active = $active_make->search($where)->find();
104:         if (!$active) throw new ValidateException('活动商品已下架');
105:         if ($groupId && !$this->checkGroupStatus($groupId, $userInfo)) $groupId = 0;
106: 
107:         return Db::transaction(function () use ($userInfo, $active, $groupId, $activeId, $orderId) {
108:             if (!$groupId) {
109:                 $ficti_status = systemConfig('ficti_status') ? $active['ficti_status'] : 0;
110:                 $time = time() + $active['time'] * 3600;
111:                 $_group = [
112:                     'product_group_id' => $activeId,
113:                     'ficti_status' => $ficti_status,
114:                     'ficti_num' => $ficti_status ? $active['ficti_num'] : 0,
115:                     'buying_count_num' => $active['buying_count_num'],
116:                     'buying_num' => $active['buying_num'],
117:                     'end_time' => $time,
118:                     'mer_id' => $active['mer_id'],
119:                     'is_hidde' => $active['leader_extension']
120:                 ];
121:                 $group = $this->dao->create($_group);
122:                 $groupId = $group->group_buying_id;
123:                 $is_initiator = 1;
124:             }
125:             $_where = [
126:                 'product_group_id' => $activeId,
127:                 'group_buying_id' => $groupId,
128:                 'is_initiator' => $is_initiator ?? 0,
129:                 'order_id' => $orderId,
130:                 'is_leader' => 1,
131:             ];
132:             $user_make = app()->make(ProductGroupUserRepository::class);
133:             $user_make->create($userInfo, $_where);
134:             $this->dao->incField($groupId, 'yet_buying_num');
135:             if (!isset($is_initiator)) $this->checkStatus($groupId);
136:             return $groupId;
137:         });
138:     }
