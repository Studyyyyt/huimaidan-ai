 48:     /**
 49:      * 根据条件获取列表数据
 50:      *
 51:      * 本函数用于根据给定的条件数组 $where，以及分页信息 $page 和 $limit，从数据库中检索满足条件的数据列表。
 52:      * 它首先计算满足条件的数据总数，然后根据分页信息和排序条件获取具体的数据页。
 53:      * 数据返回时，会包含订单相关的详细信息，如订单ID、组订单ID、活动类型和支付价格，以及订单产品的详细信息。
 54:      *
 55:      * @param array $where 查询条件数组
 56:      * @param int $page 当前页码
 57:      * @param int $limit 每页数据数量
 58:      * @return array 返回包含数据总数和数据列表的数组
 59:      */
 60:     public function getList(array $where, $page, $limit)
 61:     {
 62:         // 根据条件搜索数据，此时不进行分页
 63:         $query = $this->search($where,0);
 64: 
 65:         // 计算满足条件的数据总数
 66:         $count = $query->count();
 67: 
 68:         // 设置查询时的关联加载，这里加载了订单列表，并指定了要加载的字段
 69:         // 同时，订单列表中还进一步加载了订单产品和预售订单的详细信息
 70:         $list = $query->with(['orderList' => function (Relation $query) {
 71:             $query->field('order_id,group_order_id,activity_type,pay_price')->with(['orderProduct','presellOrder']);
 72:         }])->page($page, $limit)->order('create_time DESC')->select();
 73: 
 74:         // 返回包含数据总数和数据列表的数组
 75:         return compact('count', 'list');
