4072:     protected function searchOrders(int $merId, $where)
4073:     {
4074:         $field = 'StoreOrder.order_id,StoreOrder.real_name,StoreOrder.user_phone,StoreOrder.user_address,StoreOrder.staffs_id,StoreOrder.status,StoreOrder.order_type,StoreOrder.create_time';
4075:         $with = [
4076:             'orderProduct' => function ($query) {
4077:                 $query->field('order_id,product_id,reservation_date,reservation_id,reservation_time_part,cart_info');
4078:             }
4079:         ];
4080:         $where['mer_id'] = $merId;
4081:         $where['paid'] = 1;
4082:         $where['staffs_id'] = $where['staff_id'];
4083:         // 构建查询语句
4084:         $query = $this->dao->reservationSearch($where)->field($field)->with($with);
4085: 
4086:         $count = $query->count();
4087:         $orders = $query->select()->toArray();
4088: 
4089:         $staffsOrder = []; // 已指派订单
4090:         $noStaffsOrder = []; // 未指派订单
4091:         array_map(function($order) use (&$staffsOrder, &$noStaffsOrder) {
4092:             // 处理订单商品信息
4093:             $orderProduct = array_shift($order['orderProduct']);
4094:             $cartInfo = array_pop($orderProduct);
4095:             // 构建商品信息
4096:             $productInfo = array_merge($orderProduct, [
4097:                 'store_name' => $cartInfo['product']['store_name'] ?? '',
4098:                 'sku_name' => $cartInfo['productAttr']['sku'] ?? ''
4099:             ]);
4100:             // 处理预约时间
4101:             [$productInfo['reservation_start'], $productInfo['reservation_end']] = explode('-', $orderProduct['reservation_time_part']);
4102:             unset($productInfo['reservation_time_part']);
4103:             // 更新订单信息
4104:             $order['productInfo'] = $productInfo;
4105:             unset($order['orderProduct']);
4106: 
4107:             if ($order['staffs_id'] == 0) {
4108:                 $noStaffsOrder[] = $order;
4109:             }
4110:             $staffsOrder[] = $order;
4111:         }, $orders);
4112: 
4113:         return [$noStaffsOrder, $staffsOrder, $count];
4114:     }
