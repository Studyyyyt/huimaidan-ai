 37:     /**
 38:      * 根据条件搜索信息。
 39:      *
 40:      * 本函数用于根据给定的商家ID和额外的搜索条件，从数据库中检索相关信息。
 41:      * 它支持根据商家名称和类型进行模糊搜索或精确搜索。
 42:      *
 43:      * @param int $merId 商家ID，用于限定搜索范围。
 44:      * @param array $where 搜索条件数组，包含可选的名称和类型条件。
 45:      * @return \think\db\Query 返回一个查询对象，该对象可用于进一步的查询操作或数据检索。
 46:      */
 47:     public function search(int $merId,array $where)
 48:     {
 49:         // 初始化查询，指定商家ID并按排序降序排列
 50:         $query = ($this->getModel()::getDB())->where('mer_id',$merId)->order('sort desc');
 51: 
 52:         // 如果指定了名称，并且名称不为空，则添加名称模糊搜索条件
 53:         if(isset($where['name']) && !empty($where['name'])) {
 54:             $query->where('name','like','%'.$where['name'].'%');
 55:         }
 56: 
 57:         // 如果指定了类型，并且类型不为空，则添加类型精确搜索条件
 58:         if(isset($where['type']) && !empty($where['type'])) {
 59:             $query->where('type',$where['type']);
 60:         }
 61: 
 62:         // 最终按排序降序排列，如果未指定排序则默认按照创建时间降序排列
 63:         return $query->order('sort DESC,create_time DESC');
 64:     }
