327:     /**
328:      * 检查购物车中的商品是否符合优惠套餐条件
329:      *
330:      * @param int $discountId 优惠套餐ID
331:      * @param array $products 购物车中的商品数组
332:      * @param object $userInfo 用户信息
333:      * @throws ValidateException 如果检查过程中发现任何问题，抛出异常
334:      * @return array 符合条件的商品数据数组
335:      */
336:     public function check($discountId, $products, $userInfo)
337:     {
338:         // 通过优惠套餐ID获取优惠套餐数据
339:         $discountData = $this->dao->get($discountId);
340:         // 如果优惠套餐数据不存在，则抛出异常
341:         if (!$discountData) throw new ValidateException('套餐活动已下架');
342:         // 检查优惠套餐状态，是否已下架或已删除
343:         if ($discountData['status'] !== 1 || $discountData['is_show'] !== 1 || $discountData['is_del'])
344:             throw new ValidateException('套餐活动已下架');
345:         // 检查优惠套餐是否已售罄
346:         if ($discountData['is_limit'] && $discountData['limit_num'] < 1) {
347:             throw new ValidateException('套餐已售罄');
348:         }
349:         // 检查优惠套餐是否在有效时间范围内
350:         if ($discountData['is_time']) {
351:             if ($discountData['start_time'] > time()) throw new ValidateException('套餐活动未开启');
352:             if ($discountData['stop_time'] < time()) throw new ValidateException('套餐活动已结束');
353:         }
354:         // 创建优惠套餐产品仓库实例
355:         $make = app()->make(StoreDiscountProductRepository::class);
356:         // 创建商品SKU仓库实例
357:         $productSkuRepository = app()->make(ProductSkuRepository::class);
358:         // 初始化产品ID数组和购物车数据数组
359:         $productId = [];
360:         $cartData = [];
361: 
362:         // 遍历购物车中的商品
363:         foreach ($products as $item) {
364:             // 检查商品ID是否已存在，防止重复
365:             if (in_array($item['product_id'], $productId))
366:                 throw new ValidateException('套餐商品不能重复');
367:             // 检查商品ID是否为空
368:             if (!$item['product_id'])
369:                 throw new ValidateException('商品ID不能为空');
370:             // 检查商品SKU是否为空
371:             if (!$item['product_attr_unique'])
372:                 throw new ValidateException('ID: '. $item['product_id'] .',商品SKU不能为空');
373:             // 检查购买数量是否正确
374:             if ($item['cart_num'] != 1)
375:                 throw new ValidateException('套餐商品每单只能购买1件');
376:             if ($item['cart_num'] <= 0)
377:                 throw new ValidateException('购买数量有误');
378: 
379:             // 根据优惠套餐ID和商品ID检查商品是否在优惠套餐中
380:             $ret = $make->getWhere(['discount_id' => $discountId, 'product_id' => $item['product_id']]);
381:             if (!$ret) throw new ValidateException('商品ID:'.$item['product_id'].',不在套餐内');
382:             // 根据SKU信息检查商品是否在优惠套餐中
383:             $sku = $productSkuRepository->getWhere(
384:                 [
385:                     'unique' => $item['product_attr_unique'],
386:                     'active_product_id' => $ret['discount_product_id'],
387:                 ],
388:                 '*',
389:                 ['attrValue']
390:             );
391:             // 检查SKU是否存在于优惠套餐中
392:             if (!$sku)
393:                 throw new ValidateException('商品ID:'.$item['product_id'].'的SKU不在套餐内');
394:             // 检查商品库存是否充足
395:             if (!$sku['attrValue']['stock'])
396:                 throw new ValidateException('商品ID:'.$item['product_id'].'的库存不足');
397:             // 将商品ID添加到产品ID数组中
398:             $productId[] = $item['product_id'];
399: 
400:             // 设置购物车数据数组中的商品信息
401:             $item['uid'] = $userInfo->uid;
402:             $item['mer_id'] = $discountData['mer_id'];
403:             $item['product_type'] = 10;
404:             $item['source'] = 10;
405:             $item['source_id'] = $discountId;
406: 
407:             // 将商品数据添加到购物车数据数组中
408:             $cartData[] = $item;
409:         }
410:         // 如果优惠套餐类型为1，检查优惠套餐是否包含主商品
411:         if ($discountData['type'] == 1){
412:             if (!in_array($discountData['product_ids'], $productId))
413:                 throw new ValidateException('此套餐必须包含主商品');
414:         }
415:         // 返回符合条件的购物车商品数据数组
416:         return $cartData;
417:     }
418: 
419: }
