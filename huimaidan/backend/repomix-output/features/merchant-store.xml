286:     /**
287:      * 替换详情页的图片地址
288:      * @param $images
289:      * @param $html
290:      * @return mixed|string|string[]|null
291:      * @author Qinii
292:      * @day 2022/11/11
293:      */
294:     public function getDescriptionImage($data)
295:     {
296:         $html = $data['content'];
297:         preg_match_all('#<img.*?src="([^"]*)"[^>]*>#i', $html, $match);
298:         if (isset($match[1])) {
299:             foreach ($match[1] as $item) {
300:                 $uploadValue = $this->getImageByUrl($item, $data['mer_id'] ?? 0, $data['admin_id'] ?? 0);
301:                 //下载成功更新数据库
302:                 if ($uploadValue) {
303:                     //替换图片
304:                     $html = str_replace($item, $uploadValue, $html);
305:                 } else {
306:                     //替换掉没有下载下来的图片
307:                     $html = preg_replace('#<img.*?src="' . $item . '"*>#i', '', $html);
308:                 }
309:             }
310:         }
311:         return $html;
312:     }
