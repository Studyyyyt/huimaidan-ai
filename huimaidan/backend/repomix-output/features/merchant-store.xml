237:      * 逐级向上查找其父分类，直到找到根分类为止。
238:      *
239:      * @param int $id 分类的ID
240:      * @return string 返回所有父分类名称的字符串，使用斜杠分隔
241:      */
242:     public function getAllFatherName($id)
243:     {
244:         // 通过ID获取分类信息
245:         $info = $this->dao->get($id);
246: 
247:         // 如果分类信息为空，则返回一个空格，避免返回null或false引起后续处理问题
248:         if (empty($info)) {
249:             return ' ';
250:         }
251: 
252:         // 如果当前分类有父分类（pid大于0），则递归调用本方法获取父分类的名称
253:         if ($info['pid'] > 0) {
254:             $parentName = $this->getAllFatherName($info['pid']);
255:             // 构建当前分类及其所有父分类的路径，并返回
256:             return $parentName . '/' . $info['cate_name'];
257:         } else {
258:             // 如果当前分类没有父分类（根分类），则直接返回当前分类的名称
259:             return $info['cate_name'];
260:         }
261:     }
