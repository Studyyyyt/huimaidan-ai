703:      * 表单中包含一个选择字段，用于选择可用的小助手。
704:      *
705:      * @param int $id 商家直播间的ID
706:      * @param int $merId 商家的ID
707:      * @return \EasyWeChat\Kernel\Messages\Miniprogram|Form
708:      *
709:      * @throws ValidateException 如果直播间未通过审核，则抛出异常
710:      */
711:     public function assistantForm(int $id, int $merId)
712:     {
713:         // 实例化广播助手仓库
714:         $make = app()->make(BroadcastAssistantRepository::class);
715:         // 根据ID获取直播间信息
716:         $get = $this->dao->get($id);
717:         // 如果直播间的状态不是2（未审核通过），则抛出异常
718:         if ($get->status !== 2) throw new ValidateException('直播间还未审核通过，无法操作');
719:         // 获取可选的助手列表
720:         $data = $make->options($merId);
721:         // 检查当前商家是否已添加过助手
722:         $has = $make->intersection($get->assistant_id, $merId);
723:         // 创建表单，设置表单的URL和标题，并添加选择助手的字段
724:         return Elm::createForm(Route::buildUrl('merchantBroadcastAddAssistant', compact('id'))->build(),
725:             [
726:                 Elm::selectMultiple('assistant_id', '小助手：')->options(function () use ($data) {
727:                     $options = [];
728:                     // 如果有可用的助手数据，遍历生成选项
729:                     if ($data) {
730:                         foreach ($data as $value => $label) {
731:                             $options[] = compact('value', 'label');
732:                         }
733:                     }
734:                     return $options;
735:                 })
736:             ])->setTitle('修改小助手');
737:     }
738: 
739:     /**
740:      * 编辑助手信息
741:      *
742:      * 该方法用于更新指定房间ID下的助手列表。它首先检查新提供的助手ID列表是否与现有列表有差异，
743:      * 然后根据差异添加或移除助手，并最终更新数据库中的助手ID组合。
744:      *
745:      * @param int $id 房间ID
746:      * @param int $merId 商家ID，用于权限控制或记录操作来源
747:      * @param array $data 新的助手ID列表
748:      */
749:     public function editAssistant(int $id, int $merId, array $data)
750:     {
751:         // 实例化广播助手仓库，用于后续的操作
752:         $make = app()->make(BroadcastAssistantRepository::class);
753:         // 检查传入的数据是否在数据库中全部存在，用于防止非法数据操作
754:         $make->existsAll($data, $merId);
755: 
756:         // 使用数据库事务来确保操作的原子性
757:         Db::transaction(function () use ($id, $data) {
758:             // 获取当前房间的信息
759:             $get = $this->dao->get($id);
760:             // 将现有的助手ID字符串转换为数组
761:             $old = explode(',', $get->assistant_id);
762: 
763:             // 计算需要移除的助手ID和需要添加的助手ID
764:             $remove = array_diff($old, $data);
765:             $add = array_diff($data, $old);
766: 
767:             // 分别调用方法来添加和移除助手
768:             $this->addAssistant($get->room_id, $add);
769:             $this->removeAssistant($get->room_id, $remove);
770: 
771:             // 更新房间的助手ID列表，并保存到数据库
772:             $get->assistant_id = implode(',', $data);
773:             $get->save();
774:         });
775: 
776:     }
777: 
778:     /**
779:      * 从指定的房间中移除助手。
780:      *
781:      * 本函数用于处理从特定房间中移除多个助手的操作。它首先通过提供的助手ID查询到相关助手的信息，
782:      * 然后依次调用接口将这些助手从指定的房间中移除。
783:      *
784:      * @param int $roomId 房间ID，指定要从哪个房间移除助手。
785:      * @param array $ids 助手ID数组，指定要移除的助手的ID列表。
786:      */
787:     public function removeAssistant($roomId, array $ids)
788:     {
789:         // 实例化广播助手仓库，用于后续查询助手信息。
790:         $make = app()->make(BroadcastAssistantRepository::class);
791: 
792:         // 根据提供的助手ID查询助手信息。
793:         $data = $make->getSearch(['assistant_ids' => $ids])->select();
794: 
795:         // 遍历查询到的助手信息，逐个从房间中移除助手。
796:         foreach ($data as $datum) {
797:             // 创建小程序服务实例，并调用其广播相关方法，实现在指定房间中移除助手的功能。
798:             MiniProgramService::create()->miniBroadcast()->removeAssistant($roomId, $datum->username);
799:         }
800:     }
801: 
802:     /**
803:      * 添加助手到直播间
804:      *
805:      * 本函数用于将指定的助手用户添加到指定的直播间中。它首先通过助手ID查询用户信息，
806:      * 然后将这些信息发送给小程序服务端，以在直播间中添加助手。
807:      *
808:      * @param int $roomId 直播间ID
809:      * @param array $ids 助手用户的ID列表
810:      */
811:     public function addAssistant($roomId, array $ids)
812:     {
813:         // 通过依赖注入获取广播助手仓库实例
814:         $make = app()->make(BroadcastAssistantRepository::class);
815: 
816:         // 根据助手ID查询用户用户名和昵称
817:         $data = $make->getSearch(['assistant_ids' => $ids])->column('username,nickname');
818: 
819:         // 构建添加助手的参数
820:         $params = [
821:             'roomId' => $roomId,
822:             'users' => $data
823:         ];
824: 
825:         // 调用小程序服务，添加助手到直播间
826:         MiniProgramService::create()->miniBroadcast()->addAssistant($params);
827:     }
828: 
829:     /**
830:      * 向特定房间的用户推送消息。
831:      *
832:      * 本函数旨在向小程序中特定房间的用户推送消息。它首先通过房间ID获取房间信息，
833:      * 然后分页获取该房间的所有关注者列表，并将消息推送给这些用户。
834:      *
835:      * @param int $id 房间的ID，用于定位要推送消息的特定房间。
836:      * @throws ValidateException 如果获取关注者列表或推送消息时发生错误，则抛出异常。
837:      */
838:     public function pushMessage(int $id)
839:     {
840:         // 通过房间ID获取房间信息
841:         $get = $this->dao->get($id);
842:         // 创建小程序服务实例，并初始化广播功能
843:         $make = MiniProgramService::create()->miniBroadcast();
844:         // 初始化分页标识
845:         $page_break = '';
846: 
847:         do {
848:             // 分页获取关注者列表
849:             $data = $make->getFollowers($page_break);
850:             $restult = [];
851:             // 检查是否有错误发生，如果有则抛出异常
852:             if ($data['errcode'] !== 0) throw new ValidateException($data['errmsg']);
853:             // 遍历关注者列表，筛选出属于指定房间的用户
854:             foreach ($data['followers'] as $datum) {
855:                 if ($datum['room_id'] == $get->room_id) {
856:                     $restult[] = $datum['openid'];
857:                 }
858:             }
859:             // 如果有符合的用户，则向他们推送消息
860:             if ($restult) {
861:                 $make->pushMessage($get->room_id, $restult);
862:             }
863:             // 更新分页标识，准备获取下一页数据
864:             $page_break = $data['page_break'] ?? '';
865:         } while ($page_break);
866:     }
867: }
