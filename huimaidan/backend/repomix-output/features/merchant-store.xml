644:      * 最后执行删除操作。
645:      *
646:      * @param int $id 主键ID，用于指定要删除的记录。
647:      * @param string $field 要用于删除条件的字段名称。
648:      */
649:     public function clear(int $id, string $field)
650:     {
651:         $this->getModel()::getDB()->where($field, $id)->delete();
652:     }
