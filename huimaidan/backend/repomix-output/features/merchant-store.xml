498:         if($data['assist_status'] !== 1)
499:             throw new ValidateException('商品不在活动时间内');
500:         // 如果活动SKU信息不存在，抛出异常
501:         if(!isset($data['assistSku'][0]['sku']))
502:             throw new ValidateException('商品SKU不存在');
503:         // 如果活动SKU库存不足，抛出异常
504:         if($data['assistSku'][0]['stock'] < 1 || $data['assistSku'][0]['sku']['stock'] < 1)
505:             throw new ValidateException('商品库存不足');
506:         // 返回验证通过的活动数据
507:         return $data;
508:     }
