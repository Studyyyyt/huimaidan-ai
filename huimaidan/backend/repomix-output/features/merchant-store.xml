517:      * @throws ValidateException 如果验证失败，抛出异常提示用户。
518:      */
519:     public function exportGoods($merId, array $ids, $roomId)
520:     {
521:         // 实例化直播商品仓库，用于查询商品信息。
522:         $broadcastGoodsRepository = app()->make(BroadcastGoodsRepository::class);
523:         // 验证所选商品是否存在并属于该商家。
524:         if (count($ids) != count($goods = $broadcastGoodsRepository->goodsList($merId, $ids)))
525:             throw new ValidateException('请选择正确的直播商品');
526:         // 验证直播间是否存在并处于有效状态。
527:         if (!$room = $this->dao->validRoom($roomId, $merId))
528:             throw new ValidateException('直播间状态有误');
529:         // 实例化直播房间商品仓库，用于查询直播间商品关联信息。
530:         $broadcastRoomGoodsRepository = app()->make(BroadcastRoomGoodsRepository::class);
531:         // 获取当前直播间已关联的商品ID列表。
532:         $goodsId = $broadcastRoomGoodsRepository->goodsId($room->broadcast_room_id);
533:         $ids = [];
534:         $data = [];
535:         // 遍历商品列表，找出未关联到当前直播间的商品，准备建立关联。
536:         foreach ($goods as $item) {
537:             if (!in_array($item->broadcast_goods_id, $goodsId)) {
538:                 $data[] = [
539:                     'broadcast_room_id' => $room->broadcast_room_id,
540:                     'broadcast_goods_id' => $item->broadcast_goods_id
541:                 ];
542:                 $ids[] = $item->goods_id;
543:             }
544:         }
545:         // 如果没有需要新增关联的商品，则直接返回。
546:         if (!count($ids)) return;
547:         // 使用事务确保数据操作的完整性。
548:         Db::transaction(function () use ($ids, $broadcastRoomGoodsRepository, $goods, $room, $data) {
549:             // 批量插入新的商品与直播间关联记录。
550:             $broadcastRoomGoodsRepository->insertAll($data);
551:             // 调用小程序服务，将商品添加到直播间（注意：这里的代码可能需要根据实际服务位置进行调整）。
552:             MiniProgramService::create()->miniBroadcast()->addGoods(['roomId' => $room->room_id, 'ids' => $ids]);
553:         });
554:     }
