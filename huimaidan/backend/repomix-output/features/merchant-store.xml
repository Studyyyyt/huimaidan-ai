 22: /**
 23:  * Class StoreServiceRepository
 24:  * @package app\common\repositories\store\service
 25:  * @author xaboy
 26:  * @day 2020/5/29
 27:  * @mixin StoreServiceUserDao
 28:  */
 29: class StoreServiceUserRepository extends BaseRepository
 30: {
 31:     /**
 32:      * StoreServiceRepository constructor.
 33:      * @param StoreServiceUserDao $dao
 34:      */
 35:     public function __construct(StoreServiceUserDao $dao)
 36:     {
 37:         $this->dao = $dao;
 38:     }
 39: 
 40:     /**
 41:      * 更新服务信息。
 42:      *
 43:      * 本函数用于根据提供的服务日志对象更新相关服务用户的信息。如果该服务用户不存在，则创建新记录；
 44:      * 如果存在，则根据是否为服务人员更新未读消息计数，并更新最后一条日志ID和时间戳。
 45:      *
 46:      * @param StoreServiceLog $log 服务日志对象，包含服务ID、用户ID和商家ID等信息。
 47:      * @param bool $isService 指示当前操作是否为服务人员的操作，用于区分更新哪一方的未读消息计数。
 48:      * @return StoreServiceLog 返回更新后的服务用户对象。
 49:      */
 50:     public function updateInfo(StoreServiceLog $log, $isService)
 51:     {
 52:         // 根据服务日志信息尝试获取已存在的服务用户记录
 53:         $serviceUser = $this->dao->getWhere(['service_id' => $log->service_id, 'uid' => $log->uid, 'mer_id' => $log->mer_id]);
 54: 
 55:         // 如果服务用户不存在，则创建新记录，并初始化相关字段
 56:         if (!$serviceUser) {
 57:             $serviceUser = $this->dao->create([
 58:                 'service_id' => $log->service_id,
 59:                 'uid' => $log->uid,
 60:                 'mer_id' => $log->mer_id,
 61:                 'service_unread' => $isService ? 1 : 0,
 62:                 'user_unread' => $isService ? 0 : 1,
 63:                 'is_online' => 1,
 64:                 'last_log_id' => $log->service_log_id,
 65:                 'last_time' => date('Y-m-d H:i:s')
 66:             ]);
 67:         } else {
 68:             // 如果服务用户已存在，根据$isService的值更新服务人员或用户的未读消息计数
 69:             $isService ? $serviceUser->service_unread++ : $serviceUser->user_unread++;
 70:             // 更新最后一条日志ID和时间戳
 71:             $serviceUser->last_log_id = $log->service_log_id;
 72:             $serviceUser->last_time = date('Y-m-d H:i:s');
 73:             // 设置在线状态为1
 74:             $serviceUser->is_online = 1;
 75:             // 保存更新后的服务用户信息
 76:             $serviceUser->save();
 77:         }
 78: 
 79:         // 返回更新或创建后的服务用户对象
 80:         return $serviceUser;
 81:     }
 82: 
 83:     /**
 84:      * 读取消息方法
 85:      * 该方法用于标记指定用户的消息为已读。它可以处理用户消息和客服消息两种类型。
 86:      *
 87:      * @param string $merId 商户ID，用于确定消息所属的商户。
 88:      * @param string $uid 用户ID，用于确定要标记已读消息的用户。
 89:      * @param bool $isService 是否为客服消息，默认为null，表示用户消息。如果设置为true，则表示处理客服消息。
 90:      */
 91:     public function read($merId, $uid, $isService = null)
 92:     {
 93:         // 根据$isService的值决定更新user_unread还是service_unread字段
 94:         $field = $isService ? 'service_unread' : 'user_unread';
 95: 
 96:         // 查询满足条件的记录并更新相应的未读消息字段为0，表示已读
 97:         $this->dao->search([
 98:             'mer_id' => $merId,
 99:             'uid' => $uid,
100:         ])->update([$field => 0]);
101:     }
102: 
103:     /**
104:      * 获取用户的商家列表
105:      *
106:      * 根据用户ID（$uid）获取该用户关注的商家列表，支持分页和数量限制。
107:      * 商家列表按照最后更新时间降序排列。同时，还包括每个商家的未读消息总数。
108:      *
109:      * @param int $uid 用户ID
110:      * @param int $page 当前页码
111:      * @param int $limit 每页显示数量
112:      * @return array 包含商家总数和商家列表的数组
113:      */
114:     public function userMerchantList($uid, $page, $limit)
115:     {
116:         // 构建查询条件，筛选出属于用户$uid的商家，按最后更新时间降序排列
117:         $query = $this->dao->search(['uid' => $uid])->group('mer_id')->order('last_time DESC');
118: 
119:         // 计算符合条件的商家总数
120:         $count = $query->count();
121: 
122:         // 查询商家列表，包括商家基本信息和最新的消息信息
123:         // 使用with语法加载关联数据，简化查询并优化性能
124:         $list = $query->with(['merchant' => function ($query) {
125:             // 仅加载商家ID、头像和名称，优化数据库查询性能
126:             $query->field('mer_id,mer_avatar,mer_name');
127:         }, 'last'])->page($page, $limit)->setOption('field', [])->field('*,max(last_log_id) as last_log_id,sum(user_unread) as num')->select()->toArray();
128: 
129:         // 加载系统配置，用于后续设置默认商家头像和名称
130:         $config = systemConfig(['site_logo', 'site_name']);
131: 
132:         // 遍历商家列表，对于默认商家（mer_id为0）设置系统默认头像和名称
133:         foreach ($list as &$item) {
134:             if ($item['mer_id'] == 0) {
135:                 $item['merchant'] = [
136:                     'mer_avatar' => $config['site_logo'],
137:                     'mer_name' => $config['site_name'],
138:                     'mer_id' => 0,
139:                 ];
140:             }
141:         }
142:         unset($item);
143: 
144:         // 返回商家总数和商家列表的数组
145:         return compact('count', 'list');
146:     }
147: 
148: 
149:     /**
150:      * 获取商家用户列表
151:      * 该方法用于根据商家ID和用户ID，以及分页信息，获取特定商家的用户列表。
152:      * 这是通过验证商家服务状态，并查询相应的用户列表来实现的。
153:      *
154:      * @param int $merId 商家ID，用于确定要查询的商家。
155:      * @param int $uid 用户ID，用于确定要查询的用户。
156:      * @param int $page 当前页码，用于分页查询。
157:      * @param int $limit 每页数量，用于分页查询。
158:      * @return array 返回符合查询条件的商家用户列表。
159:      * @throws ValidateException 如果没有查询权限或商家服务状态不在线，则抛出异常。
160:      */
161:     public function merUserList($merId, $uid, $page, $limit)
162:     {
163:         // 通过商家ID和用户ID获取商家服务实例
164:         $service = app()->make(StoreServiceRepository::class)->getService($uid, $merId);
165: 
166:         // 验证是否有查询权限，如果没有则抛出异常
167:         if (!$service)
168:             throw new ValidateException('没有权限');
169: 
170:         // 验证商家服务是否在线，如果离线则抛出异常
171:         if (!$service['status'])
172:             throw new ValidateException('客服已离线，请开启客服状态');
173: 
174:         // 调用内部方法查询商家用户列表，并返回结果
175:         return $this->serviceUserList(['service_id' => $service->service_id], $merId, $page, $limit);
176:     }
177: 
178:     /**
179:      * 获取服务人员列表
180:      * 根据给定的条件、分页和限制，查询服务人员列表及其相关信息。
181:      *
182:      * @param string $where 查询条件
183:      * @param int $merId 商家ID
184:      * @param int $page 当前页码
185:      * @param int $limit 每页记录数
186:      * @return array 返回包含总数和列表的数组
187:      */
188:     public function serviceUserList($where, $merId, $page, $limit)
189:     {
190:         // 构建查询语句，根据条件进行搜索，并按最后活跃时间降序排列
191:         $query = $this->dao->search($where)->group('uid')->order('last_time DESC');
192: 
193:         // 计算满足条件的总记录数
194:         $count = $query->count();
195: 
196:         // 分页查询，并加载关联数据，包括用户信息、标记信息和最后一条消息
197:         $list = $query->page($page, $limit)->with([
198:             'user' => function ($query) {
199:                 // 加载用户详细信息，包括用户类型、性别、是否推广员等，并加载推广人信息
200:                 $query->field('uid,avatar,nickname,user_type,sex,is_promoter,phone,now_money,phone,birthday,spread_uid')->with([
201:                     'spread' => function ($query) {
202:                         // 加载推广人的基本信息
203:                         $query->field('uid,avatar,nickname,cancel_time');
204:                     }
205:                 ]);
206:             },
207:             'mark' => function ($query) use ($merId) {
208:                 // 根据商家ID加载标记信息
209:                 $query->where('mer_id', $merId);
210:             },
211:             'last'
212:         ])->setOption('field', [])->field('*,max(last_log_id) as last_log_id,sum(service_unread) as num')->select()->toArray();
213:         foreach ($list as &$item) {
214:             $m = $item['mark']['extend_value'] ?? '';
215:             unset($item['mark']);
216:             $item['mark'] = $m;
217:         }
218: 
219:         // 如果列表中第一个元素的服务用户ID为null，则说明查询结果不正常，返回空列表
220:         if (count($list) && is_null($list[0]['service_user_id'])) {
221:             $list = [];
222:         }
223: 
224:         // 返回包含总数和列表的数组
225:         return compact('count', 'list');
226:     }
227: 
228:     /**
229:      * 更新用户在线状态
230:      *
231:      * 本函数用于根据用户ID更新用户的在线状态。它首先通过搜索找到特定用户，然后更新该用户的在线状态。
232:      * 在线状态通常是一个布尔值，表示用户当前是否在线。
233:      *
234:      * @param int $uid 用户ID。这是用于唯一标识用户的数值。
235:      * @param bool $online 用户的在线状态。true表示用户在线，false表示用户不在线。
236:      * @return bool 更新操作的结果。成功返回true，失败返回false。
237:      */
238:     public function online($uid, $online)
239:     {
240:         // 根据$uid搜索用户，并更新is_online字段为$online值
241:         return $this->dao->search(['uid' => $uid])->update(['is_online' => $online]);
242:     }
243: 
244: 
245:     /**
246:      * 将在线状态设置为离线
247:      *
248:      * 本函数用于更新指定记录的在线状态，将 `is_online` 字段的值从 1 更改为 0。
249:      * 它不接受任何参数，直接调用 DAO（数据访问对象）进行查询和更新操作。
250:      * 查询条件是 `is_online` 等于 1，这意味着只会影响之前处于在线状态的记录。
251:      *
252:      * @return int 返回影响的行数，这可以帮助判断操作是否成功。
253:      */
254:     public function onlineDown()
255:     {
256:         // 使用DAO的search方法初始化查询，然后通过where方法指定查询条件。
257:         // 最后，通过update方法更新查询结果集中的`is_online`字段为0，即将在线状态改为离线。
258:         return $this->dao->search([])->where(['is_online' => 1])->update(['is_online' => 0]);
259:     }
260: 
261: }
