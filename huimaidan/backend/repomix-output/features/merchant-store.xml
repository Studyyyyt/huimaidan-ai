276:             // 提取未配送处理方式的信息，默认为空字符串
277:             $undelives = $data['undelives'] ?? '';
278: 
279:             // 如果指定未配送处理方式为2（即开启状态），则清空未配送处理方式的数据
280:             if (isset($data['undelivery']) && $data['undelivery'] == 2) {
281:                 $data['undelives'] = [];//开启状态下过滤数据
282:             }
283: 
284:             // 移除不需要的字段，以准备创建配送模板
285:             unset($data['region'], $data['free'], $data['undelives'], $data['city_ids']);
286: 
287:             // 调用DAO层创建配送模板
