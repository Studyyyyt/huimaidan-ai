 181:      */
 182:     public function search($merId, array $where, $search = '')
 183:     {
 184:         // 初始化用于构建查询条件的数组
 185:         $keyArray = $whereArr = [];
 186:         // 定义需要排除的搜索字段
 187:         $out = ['soft', 'us_status', 'mer_labels', 'sys_labels', 'order', 'hot_type','cate_ids', 'is_action', 'seckill_active_id','spu_ids','activity_label_ids'];
 188: 
 189:         // 遍历搜索条件，构建查询字段和值的映射
 190:         foreach ($where as $key => $item) {
 191:             if ($item !== '' && !in_array($key, $out)) {
 192:                 $keyArray[] = $key;
 193:                 $whereArr[$key] = $item;
 194:             }
 195:         }
 196:         // 根据是否有软删除条件，构建查询对象
 197:         $query = isset($where['soft']) ? model::onlyTrashed()->alias('Product')->where('delete', 0) : model::alias('Product');
 198:         $query->where('Product.mer_status', 1);
 199:         if($search) {
 200:             $query->hasWhere('attrValue');
 201:             $query->where(function ($query) use($search) {
 202:                 $query->hasWhere('attrValue', ['bar_code_number' => $search])->whereOr("Product.store_name|Product.product_id", "like", "%{$search}%");
 203:             });
 204:         }
 205:         // 分组权限
 206:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
 207:             $query->whereIn('Product.mer_id', $region);
 208:         }
 209:         // 处理商家类型条件
 210:         if (isset($where['is_trader']) && $where['is_trader'] !== '') {
 211:             $query->hasWhere('merchant', function ($query) use ($where) {
 212:                 $query->where('is_trader', $where['is_trader']);
 213:             });
 214:         }
 215: 
 216:         // 处理搜索关键字和关联查询
 217:         $query->withSearch($keyArray, $whereArr)->Join('StoreSpu U', 'Product.product_id = U.product_id')->where('U.product_type', $where['product_type'] ?? 0);
 218: 
 219:         // 处理类别ID条件
 220:         $query->when((isset($where['spu_ids']) && !empty($where['spu_ids'])), function ($query) use ($where) {
 221:             $query->whereIn('spu_id',$where['spu_ids']);
 222:         });
 223: 
 224:         // 处理类别ID条件
 225:         $query->when((isset($where['cate_id']) && !empty($where['cate_id'])), function ($query) use ($where) {
 226:             $query->where(['cate_id' => $where['cate_id']]);
 227:         });
 228:         $query->when((isset($where['cate_ids']) && !empty($where['cate_ids'])), function ($query) use ($where) {
 229:             $cateIds = app()->make(StoreCategoryRepository::class)->allChildren($where['cate_ids']);
 230:             $query->whereIn('cate_id', $cateIds);
 231:         });
 232: 
 233:         // 处理秒杀活动ID条件
 234:         $query->when((isset($where['seckill_active_id']) && is_array($where['seckill_active_id']) && !empty($where['seckill_active_id'])), function ($query) use ($where) {
 235:             $query->whereIn('Product.active_id', $where['seckill_active_id']);
 236:         });
 237:         $query->when((isset($where['seckill_active_id']) && !is_array($where['seckill_active_id']) && $where['seckill_active_id']), function ($query) use ($where) {
 238:             $query->where('Product.active_id', $where['seckill_active_id']);
 239:         });
 240: 
 241:         // 处理商家ID条件
 242:         $query->when($merId, function ($query) use ($merId) {
 243:             if (is_array($merId)) {
 244:                 $query->whereIn('Product.mer_id', $merId);
 245:             } else if (!is_array($merId)) {
 246:                 $query->where('Product.mer_id', $merId);
 247:             }
 248:         })
 249:             // 处理热门类型条件
 250:             ->when(isset($where['hot_type']) && $where['hot_type'] !== '', function ($query) use ($where) {
 251:                 if ($where['hot_type'] == 'new')
 252:                     $query->where('is_new', 1);
 253:                 else if ($where['hot_type'] == 'hot')
 254:                     $query->where('is_hot', 1);
 255:                 else if ($where['hot_type'] == 'best')
 256:                     $query->where('is_best', 1);
 257:                 else if ($where['hot_type'] == 'good')
 258:                     $query->where('is_benefit', 1);
 259:             })
 260:             // 处理使用状态条件
 261:             ->when(isset($where['us_status']) && $where['us_status'] !== '', function ($query) use ($where) {
 262:                 if ($where['us_status'] == 0) {
 263:                     $query->where('Product.is_show', 0)->where('Product.is_used', 1)->where('Product.status', 1);
 264:                 }
 265:                 if ($where['us_status'] == 1) {
 266:                     $query->where('Product.is_show', 1)->where('Product.is_used', 1)->where('Product.status', 1);
 267:                 }
 268:                 if ($where['us_status'] == -1) {
 269:                     $query->where(function ($query) {
 270:                         $query->where('Product.is_used', 0)->whereOr('Product.status', '<>', 1);
 271:                     });
 272:                 }
 273:             })
 274:             // 处理标签条件
 275:             ->when(isset($where['mer_labels']) && $where['mer_labels'] !== '', function ($query) use ($where) {
 276:                 $query->whereLike('U.mer_labels', "%,{$where['mer_labels']},%");
 277:             })
 278:             // 处理活动商品条件
 279:             ->when(isset($where['is_action']) && $where['is_action'] !== '', function ($query) use ($where) {
 280:                 $query->where('type', '<>', 2);
 281:             })
 282:             // 处理系统标签条件
 283:             ->when(isset($where['sys_labels']) && $where['sys_labels'] !== '', function ($query) use ($where) {
 284:                 $query->whereLike('U.sys_labels', "%,{$where['sys_labels']},%");
 285:             })
 286:             // 处理VIP价格类型条件
 287:             ->when(isset($where['svip_price_type']) && $where['svip_price_type'] !== '', function ($query) use ($where) {
 288:                 $query->where('Product.svip_price_type', $where['svip_price_type']);
 289:             })
 290:             // 处理产品类型条件
 291:             ->when(isset($where['product_type']) && $where['product_type'] == 1, function ($query) use ($where) {
 292:                 $query->where('active_id', '>', 0);
 293:             })
 294:             // 处理排序条件
 295:             ->when(isset($where['order']), function ($query) use ($where, $merId) {
 296:                 if (in_array($where['order'], ['is_new', 'price_asc', 'price_desc', 'rate', 'sales'])) {
 297:                     if ($where['order'] == 'price_asc') {
 298:                         $where['order'] = 'price ASC';
 299:                     } else if ($where['order'] == 'price_desc') {
 300:                         $where['order'] = 'price DESC';
 301:                     } else {
 302:                         $where['order'] = $where['order'] . ' DESC';
 303:                     }
 304:                     $query->order($where['order'] . ',rank DESC ,create_time DESC ');
 305:                 } else if ($where['order'] !== '') {
 306:                     $query->order('U.' . $where['order'] . ' DESC,U.create_time DESC');
 307:                 } else {
 308:                     $query->order('U.create_time DESC');
 309:                 }
 310:             })
 311:             // 处理星级条件
 312:             ->when(isset($where['star']), function ($query) use ($where) {
 313:                 $query->when($where['star'] !== '', function ($query) use ($where) {
 314:                     $query->where('U.star', $where['star']);
 315:                 });
 316:                 $query->order('U.star DESC,U.rank DESC,Product.create_time DESC');
 317:             })
 318:             // 处理排序条件
 319:             ->when(isset($where['sort']), function ($query) use ($where) {
 320:                 $query->when($where['sort'] !== '', function ($query) use ($where) {
 321:                     $query->where('U.sort', $where['sort']);
 322:                 });
 323:                 $query->order('Product.sort DESC,Product.create_time DESC');
 324:             })
 325:             // 处理优质产品条件
 326:             ->when(isset($where['is_good']) && $where['is_good'] !== '', function ($query) use ($where) {
 327:                 $query->where('Product.is_good', $where['is_good']);
 328:             })
 329:             // 处理活动标签条件
 330:             ->when(isset($where['activity_label_ids']) && $where['activity_label_ids'] !== '', function ($query) use ($where) {
 331:                 $activityLabelIds = is_string($where['activity_label_ids']) ? explode(',',$where['activity_label_ids']) : $where['activity_label_ids'];
 332:                 foreach($activityLabelIds as $item) {
 333:                     $query->whereFindInSet('Product.activity_label_ids', $item);
 334:                 }
 335:             });
 336: 
 337:         return $query;
