 12: 
 13: namespace app\common\repositories\store;
 14: 
 15: 
 16: use app\common\repositories\BaseRepository;
 17: use think\facade\Cache;
 18: 
 19: class IntegralRepository extends BaseRepository
 20: {
 21:     const CACHE_KEY = 'sys_int_next_day';
 22: 
 23:     /**
 24:      * 获取下个月的第一天的日期戳
 25:      *
 26:      * 本函数用于计算当前日期所在月份结束后，下一个月的第一天的日期戳。
 27:      * 通过strtotime函数结合日期字符串计算得出，确保了计算结果的准确性。
 28:      *
 29:      * @return int 返回下一个月第一天的日期戳
 30:      */
 31:     public function getNextDay()
 32:     {
 33:         // 使用strtotime和日期字符串计算下个月的第一天的日期戳
 34:         return strtotime(date('Y-m-d', strtotime('first day of +1 month 00:00:00')));
 35:     }
 36: 
 37: 
 38:     /**
 39:      * 获取无效积分的截止日期
 40:      *
 41:      * 本函数用于计算无效积分的截止日期，即超过此日期的积分将被视为无效。截止日期是根据系统配置的积分清理时间
 42:      * （integral_clear_time）来确定的，它会返回距离当前时间最近的过去一个整月的最后一天的23:59:59的时间戳。
 43:      * 如果系统配置的积分清理时间小于等于0，则认为不进行积分清理，直接返回0。
 44:      *
 45:      * @return int 返回无效积分截止日期的时间戳，如果积分清理时间设置为0或负数，则返回0。
 46:      */
 47:     public function getInvalidDay()
 48:     {
 49:         // 从系统配置中获取积分清理时间，单位为月
 50:         $month = systemConfig('integral_clear_time');
 51: 
 52:         // 如果积分清理时间小于等于0，则不进行积分清理，直接返回0
 53:         if ($month <= 0) return 0;
 54: 
 55:         // 计算截止日期的时间戳，即上个月的最后一天的23:59:59
 56:         // 使用strtotime函数来解析日期字符串，并指定参考时间为基础时间戳减去1
 57:         return strtotime('last day of -' . $month . ' month 23:59:59', $this->getTimeoutDay() - 1);
 58:     }
 59: 
 60:     /**
 61:      * 获取缓存中的过期天数，如果缓存不存在或需要清除，则重新计算并设置缓存。
 62:      *
 63:      * 此方法主要用于获取或更新一个特定缓存键的值，该值表示距离某个事件的过期天数。
 64:      * 如果缓存已经存在且没有明确要求清除，则直接返回缓存值，以提高效率。
 65:      * 如果缓存不存在，或者通过参数明确要求清除缓存，则重新计算过期天数，并设置新的缓存值。
 66:      * 设置的缓存有效期为20天加12小时，以确保缓存不过期太快，同时允许一定的缓冲时间。
 67:      *
 68:      * @param bool $clear 是否清除缓存。如果设置为true，则无论缓存是否存在都会重新计算并设置缓存值。
 69:      * @return mixed 返回缓存中的过期天数。如果缓存不存在且无法设置新缓存，则可能返回false。
 70:      */
 71:     public function getTimeoutDay($clear = false)
 72:     {
 73:         // 使用文件缓存驱动器实例
 74:         $driver = Cache::store('file');
 75: 
 76:         // 检查缓存是否存在，或者是否需要清除缓存
 77:         if (!$driver->has(self::CACHE_KEY) || $clear) {
 78:             // 计算下一个过期天数，并设置缓存，有效期为20天加12小时
 79:             $driver->set(self::CACHE_KEY, $this->getNextDay(), (20 * 24 * 3600) + 3600 * 12);
 80:         }
 81: 
 82:         // 返回缓存中的过期天数
 83:         return $driver->get(self::CACHE_KEY);
 84:     }
 85: 
 86: 
 87:     /**
 88:      * 清除当天的定时任务执行时间缓存
 89:      *
 90:      * 本方法用于清除使用文件存储的缓存中特定键的值。特定键是预定义的常量，
 91:      * 代表了当天的定时任务执行时间。通过清除这个缓存，可以迫使系统重新计算
 92:      * 并存储定时任务的下次执行时间，以应对可能的配置更改或系统重启等情况。
 93:      *
 94:      * @return void 没有返回值
 95:      */
 96:     public function clearTimeoutDay()
 97:     {
 98:         // 使用文件缓存存储驱动，删除指定的缓存键
 99:         Cache::store('file')->delete(self::CACHE_KEY);
100:     }
101: 
102: }
</file>

