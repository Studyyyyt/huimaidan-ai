 473:      * @Date: 2020/5/20
 474:      * @param $id
 475:      * @param $spec_type
 476:      * @param $settleParams
 477:      * @param $content
 478:      * @return array|\think\Model|null
 479:      */
 480:     public function save($res, $settleParams, $content, $data = [], $productType = 0)
 481:     {
 482:         // 商品规格
 483: 
 484:         if (isset($settleParams['attr'])) {
 485:             $productAttrRepository = app()->make(ProductAttrRepository::class);
 486:             $productAttrRepository->clearAttr($res->product_id);
 487:             $productAttrRepository->insert($settleParams['attr']);
 488:         }
 489: 
 490:         if (isset($settleParams['cate'])){
 491:             // 商品商户分类
 492:             $productCateRepository = app()->make(ProductCateRepository::class);
 493:             $productCateRepository->clearAttr($res->product_id);
 494:             $productCateRepository->insert($settleParams['cate']);
 495:         }
 496: 
 497: 
 498:         if (isset($settleParams['attrValue'])) {
 499:             // 商品规格
 500:             $productAttrValueRepository = app()->make(ProductAttrValueRepository::class);
 501:             $productAttrValueRepository->clearAttr($res->product_id);
 502: 
 503:             if ($res->type == self::DEFINE_TYPE_CARD) {
 504:                 app()->make(CdkeyLibraryRepository::class)->cancel($res->product_id);
 505:             }else if ($res->type == self::DEFINE_TYPE_CLOUD) {
 506:                 app()->make(ProductCdkeyRepository::class)->clearAttr($res->product_id);
 507:             }
 508: 
 509:             $arr = array_chunk($settleParams['attrValue'], 30);
 510:             foreach ($arr as $item) {
 511:                 $productAttrValueRepository->add($item, $res->type);
 512:             }
 513:         }
 514: 
 515:         // 商品详情
 516:         if ($content) {
 517:             app()->make(ProductContentRepository::class)->clearAttr($res->product_id, $content['type']);
 518:             $this->dao->createContent($res->product_id, $content);
 519:         }
 520:         if (isset($data['admin_info'])) {
 521:             $admin_info = $data['admin_info'];
 522:             unset($data['admin_info']);
 523:         }
 524:         // 基础信息修改
 525:         $update_infos = $settleParams['update_infos'] ?? [];
 526:         if (isset($settleParams['data'])) $data = array_merge($data, $settleParams['data']);
 527:         if (!empty($data) ){
 528:             $this->dao->update($res->product_id, $data);
 529:         }
 530:         // 后台通知
 531:         if (isset($data['status']) && $data['status'] !== 1) {
 532:             $message = '您有1个新的' . ($productType ? '秒杀商品' : ($data['is_gift_bag'] ? '礼包商品' : '商品')) . '待审核';
 533:             $type = $productType ? 'new_seckill' : ($data['is_gift_bag'] ? 'new_bag' : 'new_product');
 534:             SwooleTaskService::admin('notice', [
 535:                 'type' => $type,
 536:                 'data' => ['title' => '商品审核', 'message' => $message, 'id' => $res->product_id]
 537:             ]);
 538:         }
 539: 
 540:         // 操作日志
 541:         if (!empty($admin_info) && !empty($update_infos)) {
 542:             event('create_operate_log', [
 543:                 'category' => OperateLogRepository::MERCHANT_EDIT_PRODUCT,
 544:                 'data' => ['product' => $res, 'admin_info' => $admin_info, 'update_infos' => $update_infos,],
 545:             ]);
 546:         }
 547: 
 548:         return $res;
 549:     }
