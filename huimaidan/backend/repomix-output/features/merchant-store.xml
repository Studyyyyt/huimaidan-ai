208:     /**
209:      * 根据商家ID获取打印机配置信息
210:      *
211:      * 本函数用于根据传入的商家ID，从数据库中查询该商家的打印机配置信息。
212:      * 如果商家未配置打印机或打印机配置无效，则会尝试从商家配置中获取相关信息。
213:      * 如果所有尝试都失败，则会抛出一个异常，提示打印功能未开启或未添加打印机。
214:      *
215:      * @param int $merId 商家ID，用于查询特定商家的打印机配置。
216:      * @return array 返回包含打印机配置信息的数组，每个元素代表一个打印机的配置。
217:      * @throws ValidateException 如果打印功能未开启或未添加打印机，则抛出此异常。
218:      */
219:     public function getPrinter(int $merId)
220:     {
221:         // 检查商家的打印功能是否开启，如果未开启则抛出异常
222:         if (!merchantConfig($merId, 'printing_status'))
223:             throw new ValidateException('打印功能未开启');
224: 
225:         // 从数据库中查询商家ID为$merId且状态为1的打印机配置，返回type, clientId, terminal, partner, apiKey列
226:         $res = $this->dao->getSearch(['mer_id' => $merId, 'status' => 1])->column('
227:         type,
228:         printer_appkey clientId,
229:         printer_terminal terminal,
230:         printer_appid partner,
231:         printer_secret apiKey
232:         ');
233: 
234:         // 如果查询结果为空，则尝试从商家配置中获取打印机配置信息
235:         if (!$res) {
236:             $config = [
237:                 'clientId' => merchantConfig($merId, 'printing_client_id'),
238:                 'apiKey' => merchantConfig($merId, 'printing_api_key'),
239:                 'partner' => merchantConfig($merId, 'develop_id'),
240:                 'terminal' => merchantConfig($merId, 'terminal_number')
241:             ];
242:             // 如果商家配置中存在不完整的打印机配置，则将该配置添加到查询结果中
243:             if (!$config['clientId'] || !$config['apiKey'] || !$config['partner'] || !$config['terminal']) {
244:                 $res[] = $config;
245:             }
246:         }
247: 
248:         // 如果最终仍未能获取到有效的打印机配置，则抛出异常
249:         if (!$res) throw new ValidateException('请添加打印机');
250:         // 返回获取到的打印机配置信息
251:         return $res;
252:     }
