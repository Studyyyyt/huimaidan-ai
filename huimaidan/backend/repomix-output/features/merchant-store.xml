58:      * 批量修改秒杀商品
59:      * @param $activeId
60:      * @param $productList
61:      * @return void
62:      * FerryZhao 2024/4/13
63:      */
64:     public function updateSeckillProduct($activeId,$productList,$merId = null)
65:     {
66:         if(!$activeId){
67:             throw new ValidateException('活动ID参数错误');
68:         }
69:         $seckillActive = app()->make(StoreSeckillActiveRepository::class);
70:         $activeInfo = $seckillActive->get($activeId);
71:         if(!$activeInfo)
72:             throw new ValidateException('活动不存在');
73:         if(!$activeInfo['status'] && $merId)
74:             throw new ValidateException('活动已关闭，无法参与');
75:         Db::transaction(function () use ($activeId, $productList,$merId) {
76:             app()->make(ProductRepository::class)->deleteActiveProduct($activeId,$merId);
77:             if(!empty($productList)){
78:                 $this->createSeckillProduct($activeId,$productList);
79:             }
80:         });
81:     }
82: }
