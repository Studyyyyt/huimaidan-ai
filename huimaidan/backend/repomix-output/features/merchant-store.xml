 58:     /**
 59:      * 检查用户是否有未发送的日志
 60:      *
 61:      * 本函数用于查询指定用户（$uid）在指定商户（$merId）下是否存在未发送类型的日志记录。
 62:      * 通过返回布尔值来表示查询结果，如果存在至少一条未发送的日志记录，则返回true，否则返回false。
 63:      * 这对于判断是否需要发送日志或者是否已完成所有日志发送等情况非常有用。
 64:      *
 65:      * @param int $uid 用户ID，用于指定查询哪个用户的日志记录。
 66:      * @param int $merId 商户ID，用于指定查询哪个商户的日志记录。
 67:      * @return bool 如果查询结果存在至少一条记录则返回true，否则返回false。
 68:      * @throws \think\db\exception\DbException
 69:      */
 70:     public function issetLog($uid, $merId)
 71:     {
 72:         // 使用数据库查询方法，根据$merId, $uid和send_type为0的条件，限制查询结果为一条，然后检查查询结果的数量是否大于0。
 73:         return StoreServiceLog::getDB()->where('mer_id', $merId)->where('uid', $uid)->where('send_type', 0)->limit(1)->count() > 0;
