 396:     /**
 397:      * 接收优惠券
 398:      *
 399:      * 本函数用于处理用户领取优惠券的逻辑。它首先验证优惠券是否有效且未被领取，
 400:      * 如果验证失败，则抛出异常提示用户。如果验证成功，则调用发送优惠券的函数，
 401:      * 将优惠券发送给用户。
 402:      *
 403:      * @param int $id 优惠券ID
 404:      * @param int $uid 用户ID
 405:      * @throws ValidateException 如果优惠券失效或已领取，则抛出此异常
 406:      */
 407:     public function receiveCoupon($id, $uid)
 408:     {
 409:         // 验证优惠券是否有效且未被领取
 410:         $coupon = $this->dao->validCoupon($id, $uid);
 411:         if (!$coupon)
 412:             throw new ValidateException('优惠券失效');
 413: 
 414:         // 检查优惠券是否已经发行，如果已发行则抛出异常
 415:         if (!is_null($coupon['issue']))
 416:             throw new ValidateException('优惠券已领取');
 417: 
 418:         // 发送优惠券给用户
 419:         $this->sendCoupon($coupon, $uid,StoreCouponUserRepository::SEND_TYPE_RECEIVE);
 420:     }
