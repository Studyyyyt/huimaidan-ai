234:     public function sltSku(array $data,int $ActiveId)
235:     {
236:         $make = app()->make(ProductAttrValueRepository::class);
237:         $sku = [];
238:         $price = 0;
239:         $old_price = 0;
240:         foreach ($data['attrValue'] as $item){
241:             $skuData = $make->getWhere(['unique' => $item['unique']]);
242:             if(!$skuData) throw new ValidateException('SKU不存在');
243:             if(bccomp($item['active_price'],$skuData['price'],2) == 1)
244:                 throw new ValidateException('活动价格不得大于原价');
245:             if(!$item['active_price'] || $item['active_price'] < 0)
246:                 throw new ValidateException('请正确填写金额');
247:             $sku[] = [
248:                 'product_group_id' => $ActiveId,
249:                 'product_id' => $data['product_id'],
250:                 'unique' => $item['unique'],
251:                 'stock' => $item['stock'],
252:                 'stock_count' => $item['stock'],
253:                 'active_price' => $item['active_price'],
254:             ];
255:             $price = ($price == 0 ) ? $item['active_price'] : (($price > $item['active_price']) ? $item['active_price']:$price) ;
256:             $old_price = ($old_price == 0 ) ? $item['price'] : (($old_price > $item['price']) ? $item['price']:$old_price) ;
257:         }
258:         return compact('sku','price','old_price');
259:     }
