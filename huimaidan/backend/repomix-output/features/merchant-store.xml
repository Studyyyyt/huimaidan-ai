248:      */
249:     protected function translateAttrResult(array $info) : array
250:     {
251:         $info['attr'] = [];
252:         $info['params'] = [];
253:         if(empty($info['attr_result'])) {
254:             unset($info['attr_result']);
255:             return $info;
256:         }
257: 
258:         $attrResult = json_decode($info['attr_result']['result'],true);
259:         unset($info['attr_result']);
260: 
261:         $info['attr'] = $attrResult['attr'];
262:         $info['params'] = $attrResult['params'];
263: 
264:         foreach ($info['attrValue'] as &$value) {
265:             $_sku = implode(',',array_values((array)$value['detail'] ?? []));
266:             $value['attr_arr'] = [$_sku];
267:         }
268:         foreach ($info['params'] as &$item) {
269:             $item['value'] = array_column($item['values'], 'value');
270:         }
271: 
272:         return $info;
273:     }
