 25:     /**
 26:      * 增加商品库存
 27:      * 该方法用于对指定商品的库存进行增加操作。如果商品设置了库存限制，会增加限制数量；如果商品销量大于1，会减少销量。
 28:      * @param integer $id 商品ID，用于查询特定商品的信息。
 29:      */
 30:     public function incStock($id)
 31:     {
 32:         // 通过ID查询商品信息
 33:         $res = $this->getModel()::getDb()->find($id);
 34:         // 检查商品是否存在
 35:         if ($res) {
 36:             // 如果商品设置了库存限制，增加限制数量
 37:             if ($res['is_limit']) $res->limit_num++;
 38:             // 如果商品销量大于1，减少销量
 39:             if ($res->sales > 1) $res->sales--;
 40:             // 保存更新后的商品信息
 41:             $res->save();
 42:         }
 43: 
 44:     }
 45: 
 46: 
 47:     /**
 48:      * 减少指定商品的库存
 49:      *
 50:      * 此方法用于处理商品库存的减少操作。它首先尝试根据商品ID查询数据库中的商品记录。
 51:      * 如果商品不存在，则返回false。如果商品存在，它将尝试减少商品的销售数量。
 52:      * 如果该商品是有限制库存的，它还会减少商品的库存限制数量。如果库存限制数量小于或等于0，
 53:      * 则表示商品库存不足，方法将返回false。否则，更新后的商品记录将被保存到数据库中，
 54:      * 并返回true表示操作成功。
 55:      *
 56:      * @param int $id 商品ID
 57:      * @return bool 操作成功返回true，否则返回false
 58:      */
 59:     public function decStock($id)
 60:     {
 61:         // 通过ID查询商品记录
 62:         $res = $this->getModel()::getDb()->find($id);
 63: 
 64:         // 如果商品不存在，则返回false
 65:         if (!$res) {
 66:             return false;
 67:         }
 68: 
 69:         // 增加商品销售数量
 70:         $res->sales++;
 71: 
 72:         // 如果商品有限制库存
 73:         if ($res['is_limit']) {
 74:             // 如果当前库存限制数量大于0，则减少库存限制数量
 75:             if ($res['limit_num'] > 0) {
 76:                 $res->limit_num--;
 77:             } else {
 78:                 // 如果库存限制数量小于或等于0，表示库存不足，返回false
 79:                 return false;
 80:             }
 81:         }
 82: 
 83:         // 保存更新后的商品记录到数据库
 84:         $res->save();
 85: 
 86:         // 返回true，表示操作成功
 87:         return true;
 88:     }
 89: 
