295:             'coupon_id' => '',
296:             'pay_type' => $pay_type,
297:             'give_coupon_ids' => 0,
298:             'integral' => $orderList['totalIntegral'],
299:             'integral_price' => $orderList['totalIntegral'],
300:             'give_integral' => 0,
301:             'is_combine' => 0,
302:             'activity_type' => $orderInfo['order_type'],
303:         ];
304: 
305:         //订单记录
306:         $storeGroupOrderRepository = app()->make(StoreGroupOrderRepository::class);
307:         $storeCartRepository = app()->make(StoreCartRepository::class);
308:         $attrValueRepository = app()->make(ProductAttrValueRepository::class);
309:         $productRepository = app()->make(ProductRepository::class);
310:         $storeOrderProductRepository = app()->make(StoreOrderProductRepository::class);
311:         $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
312:         $userMerchantRepository = app()->make(UserMerchantRepository::class);
313:         $userBillRepository = app()->make(UserBillRepository::class);
314:         $_orderList = $orderList['orderList'];
315:         return Db::transaction(function () use (
316:             $user,
317:             $cartId,
318:             $groupOrder,
319:             $_orderList,
320:             $orderInfo,
321:             $attrValueRepository,
322:             $productRepository,
323:             $storeCartRepository,
324:             $storeGroupOrderRepository,
325:             $storeOrderStatusRepository,
326:             $userMerchantRepository,
327:             $storeOrderProductRepository,
328:             $storeOrderRepository,
329:             $userBillRepository
330:         ) {
331:             //减库存
332:             foreach ($_orderList as $order) {
333:                 foreach ($order['cartInfo']['list'] as $cart) {
334:                     if (!isset($uniqueList[$cart['productAttr']['product_id'] . $cart['productAttr']['unique']]))
335:                         $uniqueList[$cart['productAttr']['product_id'] . $cart['productAttr']['unique']] = true;
336:                     else
337:                         throw new ValidateException('购物车商品信息重复');
338:                     try {
339:                         $attrValueRepository->descStock($cart['productAttr']['product_id'], $cart['productAttr']['unique'], $cart['cart_num']);
340:                         $productRepository->descStock($cart['product']['product_id'], $cart['cart_num']);
341:                         $productRepository->incIntegral($cart['product']['product_id'], $cart['integral'], $cart['integral']);
342:                     } catch (\Exception $e) {
343:                         throw new ValidateException('库存不足');
344:                     }
345:                 }
346:             }
347:             //修改购物车状态
348:             $storeCartRepository->updates($cartId, ['is_pay' => 1]);
349:             //创建订单
350:             $groupOrder = $storeGroupOrderRepository->create($groupOrder);
351:             if ($groupOrder['integral'] > 0) {
352:                 $user->integral = bcsub($user->integral, $groupOrder['integral'], 0);
353:                 $userBillRepository->decBill(
354:                     $user['uid'],
355:                     'integral',
356:                     'points_order',
357:                     [
358:                         'link_id' => $groupOrder['group_order_id'],
359:                         'status' => 1,
360:                         'title' => '积分商城兑换商品',
361:                         'number' => $groupOrder['integral'],
362:                         'mark' => '积分商城兑换商品使用积分' . floatval($groupOrder['integral']) ,
363:                         'balance' => $user->integral
364:                     ]
365:                 );
366:                 $user->save();
367:             }
368:             foreach ($_orderList as $k => $order) {
369:                 $_orderList[$k]['group_order_id'] = $groupOrder->group_order_id;
370:             }
371: 
372:             $orderProduct = [];
373:             $orderStatus = [];
374:             foreach ($_orderList as $order) {
375:                 $cartInfo = $order['cartInfo'];
376:                 unset($order['cartInfo']);
377:                 //创建子订单
378:                 $_order = $storeOrderRepository->create($order);
379:                 foreach ($cartInfo['list'] as $cart) {
380:                     $productPrice = $cart['true_price'];
381:                     $order_cart = [
382:                         'product' => $cart['product'],
383:                         'productAttr' => $cart['productAttr'],
384:                         'product_type' => $cart['product_type']
