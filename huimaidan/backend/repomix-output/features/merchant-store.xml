435:         // 检查助力任务是否已完成，如果未完成，抛出异常。
436:         if ($result['assist_count'] !== $result['yet_assist_count']) throw new ValidateException('快去邀请好友来助力吧');
437:         // 根据助力活动ID和用户ID检查助力活动的参与情况。
