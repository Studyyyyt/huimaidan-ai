23:     }
24: 
25:     /**
26:      * 根据条件搜索数据。
27:      *
28:      * 本函数用于根据提供的条件数组搜索相关数据。它支持两个主要的搜索条件：'mer_id' 和 'type'。
29:      * 'mer_id' 用于指定商家ID，'type' 用于指定数据类型。其中，'type' 条件支持 'copy' 类型的数据，
30:      * 这种情况下，搜索将包括 'taobao'、'jd' 和 'copy' 类型的数据。
31:      *
32:      * @param array $where 包含搜索条件的数组。可能包含 'mer_id' 和 'type' 键。
33:      * @return \Illuminate\Database\Eloquent\Builder|static 返回数据库查询构建器实例，用于进一步的查询操作或数据获取。
34:      */
35:     public function search(array $where)
36:     {
37:         // 获取模型对应的数据库实例。
38:         return $this->getModel()::getDB()
39:             // 当 'mer_id' 条件存在且不为空时，添加 'mer_id' 的查询条件。
40:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
41:                 $query->where('mer_id', $where['mer_id']);
42:             })
43:             // 当 'type' 条件存在且不为空时，根据 'type' 的值添加相应的查询条件。
44:             ->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
45:                 if ($where['type'] == 'copy') {
46:                     // 如果 'type' 为 'copy'，则查询 'type' 为 'taobao'、'jd' 或 'copy' 的数据。
47:                     $query->where('type', 'in', ['taobao', 'jd', 'copy']);
48:                 } else {
49:                     // 否则，直接查询指定 'type' 的数据。
50:                     $query->where('type', $where['type']);
51:                 }
52:             })
53:             // 按 'create_time' 降序排序。
54:             ->order('create_time DESC');
55:     }
56: 
57:     /**
58:      * 获取产品复制信息
59:      *
60:      * 本方法通过查询数据库，获取store_product_copy_id在398到467之间的产品复制信息。
61:      * 主要用于特定条件下的产品数据检索，以便于进一步的操作或展示。
62:      *
