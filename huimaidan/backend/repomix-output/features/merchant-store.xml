203:     public function getApiSearch($where, $page, $limit, $userInfo = null)
204:     {
205:         // 筛选商圈商家ID列表
206:         if(isset($where['region_id']) && !empty($where['region_id'])) {
207:             $merIds = $this->getMerIdsByRegin($where['region_id']);
208:             if (!$merIds) {
209:                 return [];
210:             }
211:             $where['mer_ids'] = $merIds; 
212:             unset($where['region_id']);
213:         }
214: 
215:         if (isset($where['keyword']) && !empty($where['keyword'])) {
216:             if (preg_match('/^(\/@[1-9]{1}).*\*\//', $where['keyword'])) {
217:                 $command = app()->make(CopyCommand::class)->getMassage($where['keyword']);
218:                 if (!$command || in_array($command['type'], [30, 40])) return ['count' => 0, 'list' => []];
219:                 if ($userInfo && $command['uid']) app()->make(UserRepository::class)->bindSpread($userInfo, $command['uid']);
