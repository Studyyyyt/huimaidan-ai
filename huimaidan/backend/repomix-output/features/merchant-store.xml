 978:     /**
 979:      * 计算并处理用户的推广佣金。
 980:      *
 981:      * 此方法用于根据订单信息和用户信息，计算并处理用户的推广佣金。它涉及到一级和二级推广佣金的计算，
 982:      * 根据订单的不同状态和用户的角色，决定佣金的分配和记录。
 983:      *
 984:      * @param StoreOrder $order 订单对象，包含订单的相关信息，如推广UID、一级佣金、二级佣金等。
 985:      * @param User $user 用户对象，包含用户的信息，如UID、昵称等。
 986:      */
 987:     public function computed(StoreOrder $order, User $user)
 988:     {
 989:         // 实例化用户账单仓库，用于处理用户账单相关操作。
 990:         $userBillRepository = app()->make(UserBillRepository::class);
 991: 
 992:         // 根据订单状态和用户角色，确定推广UID和顶级UID。
 993:         if ($order->spread_uid) {
 994:             $spreadUid = $order->spread_uid;
 995:             $topUid = $order->top_uid;
 996:         } else if ($order->is_selfbuy) {
 997:             $spreadUid = $user->uid;
 998:             $topUid = $user->spread_uid;
 999:         } else {
1000:             $spreadUid = $user->spread_uid;
1001:             $topUid = $user->top_uid;
1002:         }
1003: 
1004:         // 如果订单有一级佣金且推广UID存在，则处理一级佣金的增加和记录。
1005:         // 添加冻结佣金
1006:         $title = $order->activity_type == 4 ? '获得团长分佣' : '获得推广佣金';
1007:         if ($order->extension_one > 0 && $spreadUid) {
1008:             // 增加用户账单的一级佣金金额，并记录相关详细信息。
1009:             $userBillRepository->incBill($spreadUid, 'brokerage', 'order_one', [
1010:                 'link_id' => $order['order_id'],
1011:                 'status' => 0,
1012:                 'title' => $title,
1013:                 'number' => $order->extension_one,
1014:                 'mark' => $user['nickname'] . '成功消费' . floatval($order['pay_price']) . '元,奖励' . $title . floatval($order->extension_one),
1015:                 'balance' => 0
1016:             ]);
1017:             // 增加用户的一级佣金总额。
1018:             $userRepository = app()->make(UserRepository::class);
1019:             $userRepository->incBrokerage($spreadUid, $order->extension_one);
1020:             // 注释掉的代码部分原用于记录财务记录，现被省略。
1021:         }
1022: 
1023:         // 如果订单有二级佣金且顶级UID存在，则处理二级佣金的增加和记录。
1024:         if ($order->extension_two > 0 && $topUid) {
1025:             // 增加用户账单的二级佣金金额，并记录相关详细信息。
1026:             $userBillRepository->incBill($topUid, 'brokerage', 'order_two', [
1027:                 'link_id' => $order['order_id'],
1028:                 'status' => 0,
1029:                 'title' => '获得推广佣金',
1030:                 'number' => $order->extension_two,
1031:                 'mark' => $user['nickname'] . '成功消费' . floatval($order['pay_price']) . '元,奖励推广佣金' . floatval($order->extension_two),
1032:                 'balance' => 0
1033:             ]);
1034:             // 增加用户的二级佣金总额。
1035:             $userRepository = app()->make(UserRepository::class);
1036:             $userRepository->incBrokerage($topUid, $order->extension_two);
1037:             // 注释掉的代码部分原用于记录财务记录，现被省略。
1038:         }
1039:     }
