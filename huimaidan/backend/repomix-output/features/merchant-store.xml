1002:      * 然后针对每个优惠券，找出尚未收到该优惠券的SVIP用户，最后为这些用户发送优惠券。
1003:      */
1004:     public function sendSvipCoupon()
1005:     {
1006:         // 初始化数据数组，用于存储发送优惠券所需的信息
1007:         $data = ['mark' => [], 'is_all' => '', 'search' => '',];
1008: 
1009:         // 查询所有SVIP用户的UID
1010:         $uids = app()->make(UserRepository::class)->search(['is_svip' => 1])->column('uid');
1011: 
1012:         // 获取StoreCouponIssueUserRepository实例，用于后续检查用户是否已领取优惠券
1013:         $isMake = app()->make(StoreCouponIssueUserRepository::class);
1014: 
1015:         // 获取StoreCouponSendRepository实例，用于发送优惠券
1016:         $senMake = app()->make(StoreCouponSendRepository::class);
1017: 
1018:         // 查询可用的SVIP优惠券ID
1019:         $couponIds = $this->dao->validCouponQuery(null, StoreCouponRepository::GET_COUPON_TYPE_SVIP)->column('coupon_id');
1020: 
1021:         // 如果有可用的优惠券ID和SVIP用户，那么开始发送优惠券
1022:         if ($couponIds && $uids) {
1023:             foreach ($couponIds as $item) {
1024:                 // 查询已领取过该优惠券的用户UID
1025:                 $issUids = $isMake->getSearch([])->whereMonth('create_time')->whereIn('uid', $uids)->column('uid');
1026: 
1027:                 // 找出尚未领取该优惠券的SVIP用户UID
1028:                 $uids_ = array_values(array_diff($uids, $issUids));
1029: 
1030:                 // 为当前优惠券设置待发送的用户UID
1031:                 $data['coupon_id'] = $item;
1032:                 $data['uid'] = $uids_;
1033: 
1034:                 // 如果有用户尚未领取该优惠券，则发送优惠券
1035:                 if (!empty($data['uid'])) {
1036:                     return $senMake->create($data, 0);
1037:                 }
1038:             }
1039:         }
