18: class ProductCdkeyDao extends BaseDao
19: {
20:     protected function getModel(): string
21:     {
22:         return model::class;
23:     }
24: 
25:     /**
26:      * 根据条件搜索数据。
27:      *
28:      * 该方法通过动态构建查询条件来搜索数据库。它支持多个条件参数，
29:      * 并且只有在参数存在时才会添加相应的查询条件。这提高了查询的灵活性，
30:      * 允许根据不同的需求构建不同的查询。
31:      *
32:      * @param array $where 查询条件，包含多个可能的字段及其值。
33:      * @return \yii\db\Query 查询对象，可用于进一步的查询操作或获取结果。
34:      */
35:     public function search($where)
36:     {
37:         // 获取数据库连接对象
38:         $query = $this->getModel()::getDb();
39: 
40:         // 动态添加查询条件基于$where数组中的键值对
41:         $query
42:             ->when(isset($where['cdkey_id']) && $where['cdkey_id'] !== '', function ($query) use ($where) {
43:                 // 如果'cdkey_id'存在，添加到查询条件中
44:                 $query->where('cdkey_id', $where['cdkey_id']);
45:             })
46:             ->when(isset($where['cdkey_ids']) && $where['cdkey_ids'] !== '', function ($query) use ($where) {
47:                 // 如果'cdkey_id'存在，添加到查询条件中
48:                 $query->whereIn('cdkey_id', $where['cdkey_ids']);
49:             })
50:             ->when(isset($where['library_id']) && $where['library_id'] !== '', function ($query) use ($where) {
51:                 // 如果'library_id'存在，添加到查询条件中
52:                 $query->where('library_id', $where['library_id']);
53:             })
54:             ->when(isset($where['product_id']) && $where['product_id'] !== '', function ($query) use ($where) {
55:                 // 如果'product_id'存在，添加到查询条件中
56:                 $query->where('product_id', $where['product_id']);
57:             })
58:             ->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
59:                 // 如果'status'存在，添加到查询条件中
60:                 $query->where('status', $where['status']);
61:             })
62:             ->when(isset($where['is_type']) && $where['is_type'] !== '', function ($query) use ($where) {
63:                 // 如果'is_type'存在，添加到查询条件中
64:                 $query->where('is_type', $where['is_type']);
65:             })
66:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
67:                 // 如果'mer_id'存在，添加到查询条件中
68:                 $query->where('mer_id', $where['mer_id']);
69:             })
70:             ->when(isset($where['keys']) && $where['keys'] !== '', function ($query) use ($where) {
71:                 // 如果'keys'存在，使用其中的值作为查询条件
72:                 $query->whereIn('key', $where['keys']);
73:             });
74: 
75:         // 返回构建好的查询对象
76:         return $query;
77:     }
