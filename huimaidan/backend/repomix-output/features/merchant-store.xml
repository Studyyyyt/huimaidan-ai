181:     public function getMerchantUserList($merId)
182:     {
183:         // 通过StoreServiceLog的getDB方法获取数据库查询构建器，并指定查询条件为mer_id等于$merId
184:         return StoreServiceLog::getDB()->where('mer_id', $merId);
185:     }
