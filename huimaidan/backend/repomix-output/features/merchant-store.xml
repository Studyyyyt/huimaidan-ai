  87:     }
  88: 
  89:     /**
  90:      * 检查指定字段的值在数据库中是否存在。
  91:      *
  92:      * 此函数用于确定给定字段的特定值是否在数据库中出现。它支持排除特定值的检查，
  93:      * 以及针对特定商户ID的检查。这在处理数据唯一性或验证数据是否存在时非常有用。
  94:      *
  95:      * @param int|null $merId 商户ID，用于限定查询范围。如果为null，则不进行商户ID的筛选。
  96:      * @param string $field 要检查的字段名。
  97:      * @param string $value 要检查的字段值。
  98:      * @param string|null $except 排除的特定值，如果不为null，则查询时会排除这个值。
  99:      * @return bool 如果存在返回true，否则返回false。
 100:      * @throws DbException
 101:      */
 102:     public function merFieldExists(?int $merId, $field, $value, $except = null)
 103:     {
 104:         // 使用withTrashed()确保查询时包括已删除的数据
 105:         return model::withTrashed()->when($except, function ($query, $except) use ($field) {
 106:                 // 如果有需要排除的值，则添加不等于条件
 107:                 $query->where($field, '<>', $except);
 108:             })->when($merId, function ($query, $merId) {
 109:                 // 如果提供了商户ID，则添加条件筛选特定商户的数据
 110:                 $query->where('mer_id', $merId);
 111:             })->where($field, $value)->count() > 0;
 112:     }
 113: 
 114:     /**
 115:      * 检查指定字段的值在数据库中是否存在。
 116:      *
 117:      * 此函数用于通过字段值查询数据库记录，判断是否存在满足条件的记录。
 118:      * 它支持排除特定的值和特定的商户ID，同时确保查询的记录状态为有效。
 119:      *
 120:      * @param int $merId 商户ID，可选参数，用于限定查询的商户范围。
 121:      * @param string $field 要查询的字段名。
 122:      * @param mixed $value 字段的值，用于查询条件。
 123:      * @param mixed $except 排除的值，可选参数，用于不在指定值范围内的查询。
 124:      * @return bool 如果存在满足条件的记录，则返回true；否则返回false。
 125:      */
 126:     public function apiFieldExists(int $merId, $field, $value, $except = null)
 127:     {
 128:         // 获取数据库实例
 129:         $db = ($this->getModel())::getDB();
 130: 
 131:         // 如果有指定的排除值，添加不等于排除值的查询条件
 132:         $db->when($except, function ($query, $except) use ($field) {
 133:             $query->where($field, '<>', $except);
 134:         });
 135: 
 136:         // 如果指定了商户ID，添加商户ID的查询条件
 137:         $db->when($merId, function ($query, $merId) {
 138:             $query->where('mer_id', $merId);
 139:         });
 140: 
 141:         // 确保查询的状态为有效
 142:         $db->where(['status' => 1]);
 143: 
 144:         // 添加字段值的查询条件
 145:         $db->where($field, $value);
