 79:     public function validateCartList($cartId,$user,$address)
 80:     {
 81:         $storeCartRepository = app()->make(StoreCartRepository::class);
 82:         $list = $storeCartRepository->cartIbByData($cartId, $user->uid, $address);
 83:         $res = $storeCartRepository->checkCartList($list, $user, 0);
 84:         $merchantCartList = $res['list'];
 85:         $fail = $res['fail'];
 86:         //检查购物车失效数据
 87:         if (count($fail)) {
 88:             if ($fail[0]['is_fail'])
 89:                 throw new ValidateException('[已失效]' . mb_substr($fail[0]['product']['store_name'],0,10).'...');
 90:             if (in_array($fail[0]['product_type'], [1, 2, 3]) && !$fail[0]['userPayCount']) {
 91:                 throw new ValidateException('[超出限购数]' . mb_substr($fail[0]['product']['store_name'],0,10).'...');
 92:             }
 93:             throw new ValidateException('[已失效]' . mb_substr($fail[0]['product']['store_name'],0,10).'...');
 94:         }
 95:         $order_type = null;
 96:         $order_model = 2;
 97:         $order_extend = '';
 98:         //检查商品类型, 活动商品只能单独购买
 99:         foreach ($merchantCartList as $merchantCart) {
100:             foreach ($merchantCart['list'] as $cart) {
101:                 if (is_null($order_type)) $order_type = $cart['product_type'];
102:                 if (count($merchantCart['list']) != 1 || count($merchantCartList) != 1) {
103:                     throw new ValidateException('活动商品必须单独购买');
104:                 }
105:                 if ($cart['product']['pay_limit'] == 2){
106:                     //如果长期限购
107:                     //已购买数量
108:                     $count = app()->make(StoreOrderRepository::class)->getMaxCountNumber($cart['uid'],$cart['product_id']);
109:                     if (($cart['cart_num'] + $count) > $cart['product']['once_max_count'])
110:                         throw new ValidateException('[超出限购总数：'. $cart['product']['once_max_count'].']'.mb_substr($cart['product']['store_name'],0,10).'...');
111:                 }
112:                 if ($cart['product']['extend']) {
113:                     $order_extend = json_decode($cart['product']['extend'], true);
114:                 }
115:             }
116:         }
117:         return [$merchantCartList,$order_model,$order_extend,$order_type];
