201:     /**
202:      * 根据用户ID、产品类型和购买数量检查支付数量是否符合规则。
203:      * 此函数用于在用户支付前验证他们是否有资格购买指定数量的产品。
204:      * 它考虑了不同产品类型的特定购买限制，如单次购买最小数量、单次购买最大数量、每日购买限制等。
205:      *
206:      * @param array $ids 产品ID列表
207:      * @param int $uid 用户ID
208:      * @param int $productType 产品类型（0: 普通商品, 1: 促销商品）
209:      * @param int $cart_num 购买数量
210:      * @return bool 如果购买数量符合所有规则，则返回true；否则，抛出验证异常。
211:      * @throws ValidateException 如果购买数量不符合任何规则，则抛出此异常。
212:      */
213:     public function checkPayCountByUser($ids,$uid,$productType,$cart_num)
214:     {
215:         // 创建订单仓库和产品仓库实例
216:         $storeOrderRepository = app()->make(StoreOrderRepository::class);
217:         $productRepository = app()->make(ProductRepository::class);
218: 
219:         // 根据产品类型应用不同的购买限制检查
220:         switch ($productType) {
221:             // 普通商品的购买限制检查
222:             //普通商品
223:             case 0:
224:                 $products = $productRepository->getSearch([])->where('product_id',$ids)->select();
225:                 foreach ($products as $product) {
226:                     // 检查是否低于最小起购数量
227:                     if ($product['once_min_count'] > 0 &&  $product['once_min_count'] > $cart_num)
228:                         throw new ValidateException('[低于起购数:'.$product['once_min_count'].']'.mb_substr($product['store_name'],0,10).'...');
229:                     // 检查是否超过单次购买最大数量
230:                     if ($product['pay_limit'] == 1 && $product['once_max_count'] < $cart_num)
231:                         throw new ValidateException('[超出单次限购数：'.$product['once_max_count'].']'.mb_substr($product['store_name'],0,10).'...');
232:                     // 检查是否超过长期购买限制
233:                     if ($product['pay_limit'] == 2){
234:                         //如果长期限购
235:                         //已购买数量
236:                         $count = $storeOrderRepository->getMaxCountNumber($uid,$product['product_id']);
237:                         if (($cart_num + $count) > $product['once_max_count'])
238:                             throw new ValidateException('[超出限购总数：'. $product['once_max_count'].']'.mb_substr($product['store_name'],0,10).'...');
239:                     }
240:                 }
241:                 break;
242:             // 促销商品的购买限制检查
243:             case 1:
244:                 $products = $productRepository->getSearch([])->where('product_id',$ids)->select();
245:                 foreach ($products as $product) {
246:                     // 检查当天购买数量是否达到上限
247:                     if (!$storeOrderRepository->getDayPayCount($uid, $product['product_id'],$cart_num))
248:                         throw new ValidateException('本次活动您购买数量已达到上限');
249:                     // 检查活动期间购买数量是否达到上限
250:                     if (!$storeOrderRepository->getPayCount($uid, $product['product_id'],$cart_num))
251:                         throw new ValidateException('本次活动您该商品购买数量已达到上限');
252:                 }
253:                 break;
254:         }
255:         return true;
256:     }
