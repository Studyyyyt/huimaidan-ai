201:             ->leftJoin('User USER', 'StoreOrder.uid = USER.uid')
202:             ->leftJoin('StoreOrderProduct ORDERB', 'StoreOrder.order_id = ORDERB.order_id')
203:             ->when(isset($where['keyword']) && $where['keyword'], function ($query) use ($where) {
204:                 $query->whereLike('USER.uid|USER.nickname|USER.phone', "%{$where['keyword']}%");
205:             })
206:             ->when($merId, function ($query) use ($merId) {
207:                 $query->where('StoreOrder.mer_id', '=', $merId);
208:             })
209:             ->when(isset($where['date']) && $where['date'], function ($query) use ($where) {
210:                 getModelTime($query, $where['date'], 'StoreOrder.create_time');
211:             })
212:             ->where($orderWhere)->where($statusWhere);
213:         $count = $query->count();
214:         $list = $query->page($page, $limit)
215:             ->field('StoreOrder.order_sn,USER.nickname,USER.uid,StoreOrder.status,StoreOrder.pay_price,StoreOrder.total_num,StoreOrder.create_time,StoreOrder.pay_time,StoreOrder.is_del,StoreOrder.paid,StoreOrder.order_type')
