188:      * @return void
189:      * FerryZhao 2024/4/28
190:      */
191:     public function chartOrder($activeId, $merId = null, $where, $statusWhere = [], int $page = 1, int $limit = 10)
192:     {
193:         $storeOrderRepository = app()->make(StoreOrderRepository::class);
194:         $orderWhere = [
195:             'ORDERB.activity_id' => $activeId,
196:         ];
197:         if (isset($where['status']) && $where['status'] != '') {
198:             $orderWhere['StoreOrder.status'] = $where['status'];
