 44:      * 本函数用于构建查询条件，根据传入的$where数组，动态地添加查询条件到数据库查询中。
 45:      * 这样做的目的是为了提高代码的灵活性和可维护性，避免硬编码的查询条件，同时允许根据不同的条件进行数据检索。
 46:      *
 47:      * @param array $where 包含搜索条件的数组。数组的键是条件的字段名，值是条件的值。
 48:      *                    如果值为空字符串或者未设置，该条件将被忽略。
 49:      * @return \Illuminate\Database\Query\Builder|static 返回构建好的查询对象，可以进一步调用其他查询方法，比如获取数据。
 50:      */
 51:     public function search($where)
 52:     {
 53:         // 获取数据库实例，并通过链式调用进行条件构建
 54:         $query = ($this->getModel()::getDB())
 55:             // 当'id'字段在$where数组中存在且不为空时，添加where条件查询订单号
 56:             ->when(isset($where['id']) && $where['id'] !== '', function ($query) use ($where) {
 57:                 $query->where('order_id', $where['id']);
 58:             })
 59:             // 当'type'字段在$where数组中存在且不为空时，添加where条件查询类型
 60:             ->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
 61:                 $query->where('type', $where['type']);
 62:             })
 63:             // 当'user_type'字段在$where数组中存在且不为空时，添加where条件查询用户类型
 64:             ->when(isset($where['user_type']) && $where['user_type'] !== '', function ($query) use ($where) {
 65:                 $query->where('user_type', $where['user_type']);
 66:             })
 67:             // 当'user_type'字段在$where数组中存在且不为空时，添加where条件查询用户类型
 68:             ->when(isset($where['change_type']) && $where['change_type'] !== '', function ($query) use ($where) {
 69:                 is_array($where['change_type']) ? $query->whereIn('change_type', $where['change_type']) : $query->where('change_type', $where['change_type']);
 70:             })
 71:             // 当'date'字段在$where数组中存在且不为空时，调用getModelTime函数动态添加时间查询条件
 72:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
 73:                 getModelTime($query, $where['date'], 'change_time');
 74:             });
 75: 
 76:         // 返回构建好的查询对象
 77:         return $query;
