622:     /**
623:      * 更新SPU的排序信息。
624:      *
625:      * 该方法用于根据给定的ID和可选的商家ID来更新SPU的排序信息。它首先根据ID和可能的商家ID查询数据，
626:      * 如果数据不存在，则抛出一个验证异常。然后，它更新产品的信息，并最后调用另一个方法来更新SPU的排序。
627:      *
628:      * @param int $id 主键ID，用于定位特定的SPU。
629:      * @param int $merId 商家ID，可选，用于过滤属于特定商家的SPU。
630:      * @param array $data 包含要更新的SPU信息的数据数组。
631:      * @return mixed 返回更新排序后的结果。
632:      * @throws ValidateException 如果根据给定的ID找不到数据，则抛出此异常。
633:      */
634:     public function updateSort(int $id,?int $merId,array $data)
635:     {
636:         // 根据主键ID准备查询条件
637:         $where[$this->dao->getPk()] = $id;
638:         // 如果提供了商家ID，则添加到查询条件中
639:         if($merId) $where['mer_id'] = $merId;
640:         // 根据查询条件获取数据
641:         $ret = $this->dao->getWhere($where);
642:         // 如果查询结果为空，则抛出异常
643:         if(!$ret) throw new  ValidateException('数据不存在');
644:         // 更新产品的信息
645:         app()->make(ProductRepository::class)->update($ret['product_id'],$data);
646:         // 制造SPU仓库实例，用于更新SPU的排序
647:         $make = app()->make(SpuRepository::class);
648:         // 更新SPU的排序，并返回结果
649:         return $make->updateSort($ret['product_id'],$ret[$this->dao->getPk()],4,$data);
650:     }
651: 
652:     /**
653:      * 切换商品状态
654:      *
655:      * 本函数用于更改指定商品的状态，并触发相应的事件，同时发送通知给相关商户。
656:      * 主要用于处理商品的上架、下架、审核通过或不通过等状态变更。
657:      *
658:      * @param int $id 商品ID
659:      * @param array $data 包含商品状态的数据
660:      * @throws ValidateException 如果商品不存在，则抛出验证异常
661:      */
662:     public function switchStatus($id, $data)
663:     {
664:         // 将$data中的'status'值复制到'product_status'字段，以符合数据表结构
665:         $data['product_status'] = $data['status'];
666: 
667:         // 通过ID获取商品信息
668:         $ret = $this->dao->get($id);
669: 
670:         // 如果商品不存在，则抛出异常
671:         if (!$ret)
672:            throw new ValidateException('数据不存在');
673: 
674:         // 在状态切换前触发事件，允许其他组件或功能介入
675:         event('product.groupStatus.before', compact('id', 'data'));
676: 
677:         // 更新商品状态到数据库
678:         $this->dao->update($id, $data);
679: 
680:         // 状态切换后触发事件，允许其他组件或功能做出相应
681:         event('product.groupStatus', compact('id', 'data'));
682: 
683:         // 根据新的商品状态，确定通知类型和消息内容
684:         $type = ProductRepository::NOTIC_MSG[$data['status']][4];
685:         $message = '您有1个拼团'. ProductRepository::NOTIC_MSG[$data['status']]['msg'];
686: 
687:         // 发送通知给商户，关于商品状态的变更
688:         SwooleTaskService::merchant('notice', [
689:             'type' => $type,
690:             'data' => [
691:                 'title' => $data['status'] == -2 ? '下架提醒' : '审核结果',
692:                 'message' => $message,
693:                 'id' => $id
694:             ]
695:         ], $ret->mer_id);
696: 
697:         // 更新SPU的状态，这里的4代表状态的具体值，需要根据实际情况进行解读
698:         app()->make(SpuRepository::class)->changeStatus($id,4);
699:     }
700: 
701: }
