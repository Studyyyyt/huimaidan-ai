 51:     public function userRead($merId, $uid)
 52:     {
 53:         // 使用where子句构建查询条件，定位到特定商家、特定用户且类型不为1的服务记录，
 54:         // 然后将这些记录的类型更新为1，表示这些记录已被读取。
 55:         return StoreServiceLog::getDB()->where('mer_id', $merId)->where('uid', $uid)->where('type', '<>', 1)->update(['type' => 1]);
