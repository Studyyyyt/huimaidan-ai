183:         // 获取门店分组下关联的店铺id
184:         $merIds = app()->make(RelevanceRepository::class)->getSearch([])
185:             ->whereIn('left_id', $stroeGroupIds)
186:             ->where('type', RelevanceRepository::STORE_GROUP)
187:             ->column('right_id');
