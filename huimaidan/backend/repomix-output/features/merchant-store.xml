 551:     /**
 552:      *  优惠券发送费多用户
 553:      * @param $uid
 554:      * @param $id
 555:      * @author Qinii
 556:      * @day 2020-06-19
 557:      */
 558:     public function sendCouponByUser($uid, $id)
 559:     {
 560:         foreach ($uid as $item) {
 561:             $coupon = $this->dao->validCoupon($id, $item);
 562:             if (!$coupon || !is_null($coupon['issue']))
 563:                 continue;
 564:             if ($coupon->is_limited && 0 == $coupon->remain_count)
 565:                 continue;
 566:             $this->sendCoupon($coupon, $item,StoreCouponUserRepository::SEND_TYPE_RECEIVE);
 567:         }
 568:     }
