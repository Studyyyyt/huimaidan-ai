 81: 
 82:     /**
 83:      *  处理数据,批量增加
 84:      * @param array $data
 85:      * @param int $merId
 86:      * @return void
 87:      * @author Qinii
 88:      */
 89:     public function save(array $data, int $merId)
 90:     {
