472:      * @throws ValidateException 如果活动无效或不存在
473:      */
474:     public function checkAssist($id,$uid)
475:     {
476:         // 获取助力活动的查询条件
477:         $where = $this->dao->assistShow();
478:         // 将助力活动ID加入查询条件
479:         $where[$this->dao->getPk()] = $id;
480:         // 根据条件查询助力活动信息，并包含关联产品和SKU信息，以及附加购买状态
481:         $data = $this->dao->search($where)->with(['product','assistSku.sku'])->append(['assist_status'])->find();
482:         // 如果活动信息不存在，抛出异常
483:         if (!$data) throw new ValidateException('商品已下架或不在活动时间内');
484:         // 如果活动有限制购买次数，检查用户购买次数是否已达上限
485:         if($data['pay_count']){
486:             // 实例化订单仓库类
