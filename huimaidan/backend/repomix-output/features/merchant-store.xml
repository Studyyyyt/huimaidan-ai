143:             ['is_time', 0],
144:             ['time', []],
145:             ['sort', 0],
146:             ['free_shipping', 0],
147:             ['status', 0],
148:             ['is_show', 1],
149:             ['products', []],
150:             ['temp_id', 0],
151:         ];
152:         // 获取请求参数并校验
153:         $data = $this->request->params($params);
154:         app()->make(StoreDiscountsValidate::class)->check($data);
