 60:             $query = StoreCoupon::hasWhere('merchant',function($query)use($where){
 61:                 $query->where('is_trader',$where['is_trader']);
 62:             });
 63:         }else{
 64:             $query = StoreCoupon::getDB()->alias('StoreCoupon');
 65:         }
 66:         $query->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
 67:             $query->where('StoreCoupon.status', (int)$where['status']);
 68:         })->when(isset($where['coupon_name']) && $where['coupon_name'] !== '', function ($query) use ($where) {
 69:             $query->whereLike('title', "%{$where['coupon_name']}%");
 70:         })->when(isset($where['coupon_id']) && $where['coupon_id'] !== '', function ($query) use ($where) {
 71:             $query->where('coupon_id', (int)$where['coupon_id']);
 72:         })->when(isset($where['send_type']) && $where['send_type'] !== '', function ($query) use ($where) {
 73:             $query->where('send_type', (int)$where['send_type']);
 74:         })->when(isset($where['not_send_type']) && $where['not_send_type'] !== '', function ($query) use ($where) {
 75:             $query->whereNotIn('send_type', $where['not_send_type']);
 76:         })->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
 77:             $query->where('type', (int)$where['type']);
 78:         })->when($merId !== null, function ($query) use ($merId) {
 79:             $query->where('StoreCoupon.mer_id', $merId);
 80:         })->when(isset($where['is_mer']) &&  $where['is_mer'] !== '', function ($query) use ($merId) {
 81:             $query->where('type', '<', 10);
 82:         })->when(isset($where['coupon_ids']) && $where['coupon_ids'] !== '', function ($query) use ($where) {
 83:             $query->whereIn('coupon_id', $where['coupon_ids']);
 84:         });
 85:         return $query->where('StoreCoupon.is_del', 0)->order(($merId ? 'StoreCoupon.sort DESC,' : '') . 'coupon_id DESC');
 86:     }
