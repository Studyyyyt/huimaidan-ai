170:      * 如果传入的数量大于0，则增加库存；如果数量小于0，则减少库存。
171:      * 同时，更新产品属性值和产品的库存信息。
172:      *
173:      * @param int $libraryId 图书馆ID，用于定位特定的库存项
174:      * @param int $num 变更的库存数量，默认为1，可以为正数（增加）或负数（减少）
175:      */
176:     public function changeTotalNum($libraryId ,$num = 1)
177:     {
178:         // 实例化CDKey卡密库
179:         $cdkeyLibraryRepository = app()->make(CdkeyLibraryRepository::class);
180:         // 根据$num的正负值，决定是增加还是减少库存数量
181:         try{
182:             if ($num > 0) {
183:                 $cdkeyLibraryRepository->incTotalNum($libraryId, $num);
184:             } else {
185:                 $cdkeyLibraryRepository->decTotalNum($libraryId,-$num);
186:             }
187:         }catch (\Exception $e) {}
188:         // 实例化产品属性值仓库，用于获取和更新产品的库存信息
189:         $value = app()->make(ProductAttrValueRepository::class)->getWhere(['library_id' => $libraryId]);
190:         // 如果找到了对应的库存信息
191:         if ($value) {
192:             // 更新库存数量
193:             $value->stock = $value->stock + $num;
194:             $value->save();
195:             // 实例化产品仓库，用于获取和更新产品的整体库存信息
196:             $product = app()->make(ProductRepository::class)->getWhere(['product_id' => $value['product_id']]);
197:             // 如果找到了对应的产品信息
198:             if ($product) {
199:                 // 更新产品的库存数量
200:                 $product->stock = $product->stock + $num;
201:                 $product->save();
202:             }
203:         }
204:     }
205: }
