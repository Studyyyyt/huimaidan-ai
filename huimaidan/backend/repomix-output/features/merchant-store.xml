238:         if ($data && $orderIds) {
239:             Db::transaction(function () use ($storeOrderStatusRepository, $orderIds, $data, $res) {
240:                 $storeOrderStatusRepository->batchCreateLog($data);
241:                 app()->make(StoreOrderRepository::class)
242:                     ->getSearch([])
243:                     ->whereIn('order_id', $orderIds)
244:                     ->update(['status' => 0]);
245:                 Queue::push(SendSmsJob::class, ['tempId' => 'GROUP_BUYING_SUCCESS', 'id' => $res->group_buying_id]);
