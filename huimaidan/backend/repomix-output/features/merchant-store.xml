156:      * 获取展示状态为正常且可购买的产品分类路径列表
157:      *
158:      * 本函数通过查询产品组（ProductGroup）关联的产品（StoreProduct）及其分类（StoreCategory）
159:      * 来获取展示状态、动作状态及产品状态都为正常的产品的分类路径。
160:      * 使用了别名简化查询语句，通过连接（join）产品组、产品和分类表，筛选出符合条件的产品，
161:      * 并按产品ID分组，最后返回每个产品的分类路径列表。
162:      *
163:      * @return array 返回符合条件的产品的分类路径列表
164:      */
165:     public function category()
166:     {
167:         // 使用别名简化表名，并连接产品组、产品和分类表
168:         $query = ProductGroup::alias('G')->join('StoreProduct P','G.product_id = P.product_id')
169:             ->join('StoreCategory C','P.cate_id = C.store_category_id');
170: 
171:         // 筛选展示状态、动作状态及产品状态都为正常的产品
172:         $query->where('G.is_show',1)->where('G.action_status',1)->where('G.product_status',1);
173: 
174:         // 按产品ID分组，以确保每个产品只返回一个分类路径
175:         $query->group('G.product_id');
176: 
177:         // 返回查询结果中产品的分类路径列表
178:         return $query->column('path');
179:     }
180: 
181:     /**
182:      * 检查并更新过期活动的状态
183:      * 该方法用于定期检查所有活动的结束时间，如果活动已经结束，则将其状态设置为失效。
184:      * 同时，此方法还会更新关联的SPU的状态，将这些SPU的状态设置为不可用。
185:      *
186:      * @return void
187:      */
188:     public function valActiveStatus()
189:     {
190:         // 查询已结束且状态为有效的活动的ID
191:         $query = $this->getModel()::getDB()->whereTime('end_time','<=',time())->where('action_status',1);
192:         $id = $query->column($this->getPk());
193: 
194:         // 如果查询到已结束的活动ID
195:         if($id) {
196:             // 更新这些活动的状态为失效
197:             $this->getModel()::getDB()->where($this->getPk(),'in',$id)->update(['action_status' => -1]);
198: 
199:             // 准备更新关联SPU的状态
200:             $where = [
201:                 'product_type' => 4,
202:                 'activity_ids' => $id
203:             ];
204:             // 更新所有关联到这些活动的SPU的状态为不可用
205:             app()->make(SpuRepository::class)->getSearch($where)->update(['status' => 0]);
206:         }
207:     }
208: 
209: 
210:     /**
211:      * 软删除商户的所有商品
212:      * @param $merId
213:      * @author Qinii
214:      * @day 5/15/21
215:      */
216:     public function clearProduct($merId)
217:     {
218:         $this->getModel()::getDb()->where('mer_id', $merId)->update(['is_del' => 1]);
219:     }
220: }
