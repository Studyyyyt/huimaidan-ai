 50:     public function showMonth(int $productId, array $where)
 51:     {
 52:         /**
 53:          * 先获取本月的日历
 54:          * 获取商品可预约的类型
 55:          * 根据类型计算可预约时间
 56:          * 组合预约的时间和时间内的数量信息
 57:          */
 58:         $detail = $this->dao->search(['product_id' => $productId])->find();
 59:         if (!$detail) throw new ValidateException('数据不存在');
 60:         $date = $where['date'];
 61:         [$firstDay, $lastDay] = $this->getMonth($date);
 62:         if ($detail['sale_time_type'] == self::SALE_TIME_TYPE_DAY) {
 63:             $start = $firstDay;
 64:             $end = $lastDay;
 65:             $weeks = ['1', '2', '3', '4', '5', '6', '7'];
 66:         } elseif ($detail['sale_time_type'] == self::SALE_TIME_TYPE_CUSTOM) {
 67:             $start = $detail['sale_time_start_day'];
 68:             $end = $detail['sale_time_end_day'];
 69:             $weeks = $detail['sale_time_week'];
 70:         }
 71:         $days = [];
 72:         $today =  date('Y-m-d', time());
 73:         $currentDay = $firstDay < $today ? $today : $firstDay;
 74:         $show_num = $detail['show_reservation_days'] - 1;
 75:         $showDay = date('Y-m-d', strtotime("+ $show_num Day"));
 76:         $lastDay = $showDay <= $lastDay ? $showDay : $lastDay;
 77:         while ($currentDay <= $lastDay) {
 78:             $week = date('N', strtotime($currentDay));
 79:             if ($currentDay >= $start && $currentDay <= $end && in_array($week, $weeks)) {
 80:                 $days[] = [
 81:                     'date'  => date('Y-m-d', strtotime($currentDay)),
 82:                     'day'  => date('d', strtotime($currentDay)),
 83:                     'weeke' => $week,
 84:                 ];
 85:             }
 86:             $currentDay = date('Y-m-d', strtotime($currentDay . ' +1 day'));
 87:         }
 88:         return ['date' => $date, 'days' => $days];
 89:     }
 90: 
 91:     public function getMonth($date)
 92:     {
 93:         // 解析传入的日期，获取年月
 94:         $dateObj = new \DateTime($date);
 95:         $year = $dateObj->format('Y');
 96:         $month = $dateObj->format('m');
 97: 
 98:         // 获取当月第一天和最后一天
 99:         $firstDay = date('Y-m-01', strtotime("$year-$month-01"));
100:         $lastDay = date('Y-m-t', strtotime("$year-$month-01"));
101:         return [$firstDay, $lastDay];
102:     }
103: 
104: 
105:     public function showDay(int $productId, array $where)
106:     {
107:         /**
108:          * 获取预约时间信息
109:          * 获取时间段
110:          * 获取每个时间段的库存等
111:          */
112:         $detail = $this->dao->search(['product_id' => $productId])->find();
113:         $date = $where['date'] . '-' . $where['day'];
114:         $week = date('N', strtotime($date));
115:         if (!$detail) throw new ValidateException('数据不存在');
116:         $show_num = $detail['show_reservation_days'];
117:         $showDay = date('Y-m-d', strtotime("+ $show_num Day"));
118:         if ($date > $showDay)
119:             throw new ValidateException('[1]当前日期不可预约');
120:         if ($detail['sale_time_type'] == self::SALE_TIME_TYPE_CUSTOM) {
121:             $start = $detail['sale_time_start_day'];
122:             $end = $detail['sale_time_end_day'];
123:             $weeks = $detail['sale_time_week'];
124:             if ($date < $start || $date > $end || !in_array($week, $weeks)) {
125:                 throw new ValidateException('[2]当前日期不可预约');
126:             }
127:         }
128:         $firstTime = date('H:i', time());
129:         if ($date == date('Y-m-d', time()) && $detail['is_advance']) {
130:             $advance_time = $detail['advance_time'] * 60 * 60;
131:             $firstTime = date('H:i', time() + $advance_time);
132:         }
133:         $show = $detail['show_num_type'];
134: 
135:         $valueReservationRepository = app()->make(ProductAttrValueReservationRepository::class);
136:         $productRepository = app()->make(StoreOrderProductRepository::class);
137:         $list = $valueReservationRepository->getSearch(['attr_value_id' => $where['sku_id']])
138:             //->when($date == date('Y-m-d', time()) ,function($query) use($firstTime){
139:             //    $query->where('start_time','>=', $firstTime);
140:             //})
141:             ->field('start_time,end_time,stock,attr_value_id,attr_reservation_id')->select();
142: 
143:         foreach ($list as &$item) {
144:             $stock = $productRepository->getReservationSum($productId, $date, $item['attr_reservation_id']);
145:             $item['stock'] = $item['stock'] - $stock;
146:             $disable = $item['stock'] <= 0 ? true : false;
147:             if (!$disable && $date == date('Y-m-d', time())) {
148:                 $disable = ($item['start_time'] >= $firstTime) ? false : true;
149:             }
150:             $item['disable'] = $disable;
151:         }
152:         return compact('show', 'list');
153:     }
