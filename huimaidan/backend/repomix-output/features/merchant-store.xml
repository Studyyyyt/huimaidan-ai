286:     /**
287:      * 获取产品的回复率
288:      * 通过计算给定产品ID的所有评价中，评分在4到5分之间的评价数量占总评价数量的比例，来得到产品的回复率。
289:      * 使用缓存来提高数据检索的效率，如果缓存中已有数据，则直接返回，否则计算并存储到缓存中。
290:      *
291:      * @param int $productId 产品ID，用于查询产品的评价数据。
292:      * @return array 返回包含最佳评价数量、回复率和总评价数量的数据数组。
293:      */
294:     public function getReplyRate(int $productId)
295:     {
296:         // 生成缓存键的唯一标识，确保不同产品的评价率缓存不会相互覆盖
297:         $cache_unique = md5('reply_rate_' . json_encode([$productId]));
298: 
299:         // 尝试从缓存中获取评价率数据
300:         $res = Cache::get($cache_unique);
301:         if ($res) return json_decode($res,true);
302: 
303:         // 查询产品的所有非删除评价记录
304:         $res = $this->selectWhere(['product_id' => $productId,'is_del' =>0]);
305: 
306:         // 统计评分在4到5分之间的评价数量
307:         $best = $res->where('rate', '>=', 4)->where('rate', '<=', 5)->count();
308: 
309:         // 统计所有评价的数量
310:         $count = $res->count();
311: 
312:         // 根据最佳评价数量和总评价数量计算回复率，并保留两位小数
313:         $rate = '';
314:         if ($best && $count) $rate = bcdiv($best, $count, 2) * 100 . '%';
315: 
316:         // 将最佳评价数量、回复率和总评价数量打包成数组
317:         $res = compact('best', 'rate', 'count');
318: 
319:         // 将计算得到的评价率数据存储到缓存中，有效期1500秒
320:         Cache::set($cache_unique, json_encode($res), 1500);
321: 
322:         // 返回评价率数据数组
323:         return $res;
324:     }
