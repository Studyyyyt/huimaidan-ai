 43:     /**
 44:      * 检查团状态
 45:      * 本函数用于确认给定的团是否处于有效状态，以及用户是否已加入该团。
 46:      *
 47:      * @param int $groupId 团ID，用于查询团的信息。
 48:      * @param object $userInfo 用户信息，包含用户ID，用于检查用户是否已加入该团。
 49:      * @return bool 返回true表示团状态正常且用户未加入，返回false表示团状态异常或用户已加入。
 50:      */
 51:     public function checkGroupStatus(int $groupId, $userInfo)
 52:     {
 53:         // 检查团的状态是否正常
 54:         $this->checkStatus($groupId);
 55: 
 56:         // 查询数据库中团的基本信息
 57:         $data = $this->dao->getSearch([$this->dao->getPk() => $groupId, 'is_del' => 0])->find();
 58: 
 59:         // 如果提供了用户信息，则检查该用户是否已加入当前团
 60:         if ($userInfo) {
 61:             // 构建查询条件，检查用户是否已加入当前团
 62:             $_where = [
 63:                 'group_buying_id' => $groupId,
 64:                 'uid' => $userInfo->uid,
 65:                 'is_del' => 0
 66:             ];
 67:             // 执行查询，确认用户是否已加入团
 68:             $has = app()->make(ProductGroupUserRepository::class)->getWhere($_where);
 69:         }
 70: 
 71:         // 如果团信息不存在、团状态不为0，或者用户已加入，则返回false
 72:         if (!$data || ($data['status'] !== 0) || $has) {
 73:             return false;
 74:         }
 75: 
 76:         // 如果所有条件检查都通过，则返回true
 77:         return true;
 78:     }
