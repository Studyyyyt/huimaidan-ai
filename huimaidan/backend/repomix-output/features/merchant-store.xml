261:         // 遍历服务列表，为系统服务填充默认商户信息
262:         foreach ($list as &$item){
263:             if ($item['mer_id'] == 0 || !$item['merchant'] || $item['merchant']['status'] == 0) {
264:                 // 系统服务使用系统配置的Logo和名称
265:                 $item['merchant'] = [
266:                     'mer_avatar' => $config['site_logo'],
267:                     'mer_name' => $config['site_name'],
268:                     'mer_id' => 0,
269:                 ];
270:                 $item['mer_id'] = 0;
271:             }
272:         }
273:         unset($item); // 断开引用，避免潜在的引用问题
274: 
