575:     public function wxQrcode(int $uid, StoreActivity $activity)
576:     {
577:         // 生成二维码文件名，基于用户ID、活动ID和当前日期，确保唯一性
578:         $name = md5('wxactform_i' . $uid . $activity['activity_id'] . date('Ymd')) . '.jpg';
579: 
580:         // 构建二维码的key值，用于存储和检索
581:         $key = 'form_' . $activity['activity_id'] . '_' . $uid;
582: 
583:         // 调用二维码服务类，生成微信小程序二维码，并返回二维码的路径
584:         // 参数包括二维码文件名、二维码指向的URL、是否使用代理以及存储的key
585:         return app()->make(QrcodeService::class)->getWechatQrcodePath($name, '/pages/activity/registrate_activity/index?id=' . $activity['activity_id'] . '&spid=' . $uid, false, $key);
