608:     /**
609:      * 验证活动状态
610:      * @param StoreActivity|null $activity
611:      * @return true
612:      */
613:     public function verifyActivityStatus(?StoreActivity $activity, $isCreate = false)
614:     {
615:         if (empty($activity)) {
616:             throw new ValidateException('活动数据异常');
617:         }
618:         if (!$activity['is_show']) {
619:             throw new ValidateException('活动已被关闭');
620:         }
621:         if ($isCreate) {
622:             if ($activity['status'] == -1) {
623:                 throw new ValidateException('活动已结束');
624:             }
625:             if ($activity['status'] == 0) {
626:                 throw new ValidateException('活动未开始');
627:             }
628:             //如果存在结束时间，则判断当前时间是否大于结束时间
629:             $end_time = $activity['end_time'] ? (strtotime($activity['end_time']) <= time() ?: false) : false;
630:             if ($end_time)
631:                 throw new ValidateException('活动已结束');
632:             //如果没有结束时间 则判断总人数
633:             if ($activity['count'] > 0 && $activity['count'] <= $activity['total'])
634:                 throw new ValidateException('活动参与人数已满');
635:         }
636:         return true;
637:     }
