475:     public function activeProductAndList(&$list, &$onList,$active,$field,$push_key)
476:     {
477:         $_type = $this->typeData[$active['scope_type']];
478:         //获得所有商品的spuID
479:         $ids = array_column($onList, $field);
480:         $idss = array_unique($ids);
481:         if (count($idss) == 1 && !$idss[0]) return ;
482:         //以需求的字段为主键的数组
483:         $funList = [];
484:         if ($ids && $onList) $funList = array_combine($ids, $onList);
485:         if ($field == 'active_id') {
486:             //获取交集ID
487:             $intersectId = $ids;
488:         } else {
489:             $relevanceRepository = app()->make(RelevanceRepository::class);
490:             $params = ['type' => $_type, 'left_id' => $active['activity_id']];
491:             $rightIds = $relevanceRepository->getSearch($params)->whereIn('right_id', $ids)->select()->toArray();
492: 
493:             $rightIds = array_column($rightIds,'right_id');
494:             $intersectId = array_values(array_intersect($ids, $rightIds));
495:         }
496:         //存在交集则有符合条件的商品
497:         if (!empty($intersectId)) {
498:             $newList = array_map(function ($item) use ($intersectId, $active, $field, $push_key) {
499:                 if (
500:                     ($field !== 'active_id' || $item['active_id'] !== 0) &&
501:                     in_array($item[$field], $intersectId) && !isset($item[$push_key])
502:                 ) {
503:                     $item[$push_key] = $active['pic'];
504:                 }
505:                 return $item;
506:             }, $list);
507:             foreach ($intersectId as $spu_id) {
508:                 unset($funList[$spu_id]);
509:             }
510:             $list = $newList;
511:             $onList = array_values($funList);
512:         }
513:     }
