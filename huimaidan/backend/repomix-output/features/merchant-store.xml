314:     /**
315:      * 根据url下载图片
316:      * @param $data
317:      * @return array|mixed|string
318:      * @author Qinii
319:      * @day 2022/11/11
320:      */
321:     public function getImageByUrl($data, $merId = 0, $adminId = 0)
322:     {
323:         if (!$data) return '';
324:         $category = app()->make(AttachmentCategoryRepository::class)->findOrCreate([
325:             'attachment_category_enname' => $this->AttachmentCategoryPath,
326:             'attachment_category_name' => $this->AttachmentCategoryName,
327:             'mer_id' => $merId,
328:             'pid' => 0,
329:         ]);
330:         $make = app()->make(AttachmentRepository::class);
331:         $serve = app()->make(DownloadImageService::class);
332:         $type = (int)systemConfig('upload_type') ?: 1;
333: 
334:         if (is_array($data)) {
335:             foreach ($data as $datum) {
336:                 $arcurl = is_int(strpos($datum, 'http')) ? $datum : 'http://' . ltrim($datum, '\//');
337:                 $image = $serve->downloadImage($arcurl, $this->AttachmentCategoryPath);
338:                 $dir = $image['path'];
339:                 if ($type == 1 && strpos($image['path'], '//') !== 1) {
340:                     $dir = rtrim(systemConfig('site_url'), '/') . $image['path'];
341:                 }
342:                 $data = [
343:                     'attachment_category_id' => $category->attachment_category_id,
344:                     'attachment_name' => $image['name'],
345:                     'attachment_src' => $dir
346:                 ];
347:                 $make->create($type, $merId, $adminId, $data);
348:                 $res[] = $dir;
349:             }
350:         } else {
351:             $arcurl = is_int(strpos($data, 'http')) ? $data : 'http://' . ltrim($data, '\//');
352:             $image = $serve->downloadImage($arcurl, $this->AttachmentCategoryPath);
353: 
354:             $dir = $image['path'];
355:             if ($type == 1 && strpos($image['path'], '//') !== 1) {
356:                 $dir = rtrim(systemConfig('site_url'), '/') . $image['path'];
357:             }
358: 
359:             $data = [
360:                 'attachment_category_id' => $category->attachment_category_id,
361:                 'attachment_name' => $image['name'],
362:                 'attachment_src' => $dir
363:             ];
364:             $make->create($type, $merId, $adminId, $data);
365:             $res = $dir;
366:         }
367:         return $res;
368:     }
