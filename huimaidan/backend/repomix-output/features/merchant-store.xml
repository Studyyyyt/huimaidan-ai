301:             (app()->make(ShippingTemplateRegionRepository::class)->insertAll($settleRegion));
302: 
303:             // 如果指定了未配送处理方式为1（即开启状态），则处理未配送的处理方式与模板的关联
304:             if ($data['undelivery'] == 1) {
305:                 // 计算未配送处理方式
306:                 $settleUndelives = $this->settleUndelives($undelives, $temp['shipping_template_id']);
307:                 // 创建处理后的未配送处理方式
308:                 (app()->make(ShippingTemplateUndeliveRepository::class))->create($settleUndelives);
