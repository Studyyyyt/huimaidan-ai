337:     /**
338:      * 取消参团
339:      * @param int $groupId
340:      * @param $userInfo
341:      * @author Qinii
342:      * @day 1/13/21
343:      */
344:     public function cancelGroup(int $groupId, $userInfo)
345:     {
346:         $this->checkStatus($groupId);
347:         $res = $this->dao->get($groupId);
348:         if (!$res) throw new ValidateException('数据丢失');
349:         if ($res['status'] == 10) throw new ValidateException('已拼团成功，不可取消，请在订单详情中申请退款');
350:         if ($res['status'] == -1) throw new ValidateException('已拼团失败，不可取消，订单将会自动退款');
351:         $make = app()->make(ProductGroupUserRepository::class);
352:         $where = [
353:             'group_buying_id' => $groupId,
354:             'uid' => $userInfo->uid,
355:             'is_del' => 0
356:         ];
357:         $user = $make->getSearch($where)->find();
358:         if (!$user) throw new ValidateException('您没有参加此团');
359:         Db::transaction(function () use ($res, $user, $groupId, $make) {
360:             // 如果团成员少于两人 直接关闭此团
361:             if ($res['yet_buying_num'] < 2) {
362:                 $res->is_del = 1;
363:                 $res->status = -1;
364:                 $res->save();
365:             } else {
366:                 //返回团对数量
367:                 $this->dao->decField($groupId, 'yet_buying_num', 1);
368:                 //如果是团长，转移团长
369:                 if ($user['is_initiator']) $make->changeInitator($groupId, $user->uid);
370:                 $user->is_initiator = 0;
371:                 $user->is_del = 1;
372:                 $user->save();
373:             }
374:             app()->make(StoreRefundOrderRepository::class)->autoRefundOrder($user['order_id'], 1, '取消拼团，自动退款');
375:         });
376:     }
