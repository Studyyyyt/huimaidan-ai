280:         $cartData = app()->make(StoreCartRepository::class)->getList($userInfo);
281:         // 使用array_column构建商品ID到购物车数据的映射
282:         $productCarts = [];
283:         foreach ($cartData['list'] as $item) {
284:             $productCarts += array_column($item['list'], null, 'product_id');
285:         }
286:         // 一次性更新所有商品的购物车信息
287:         array_walk($list, function(&$item) use ($productCarts) {
