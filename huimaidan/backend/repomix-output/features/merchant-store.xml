268: 
269:     /**
270:      * 删除指定ID的记录及其相关参数和关联信息。
271:      *
272:      * 使用事务确保删除操作的原子性，即操作要么全部成功，要么全部失败。
273:      * 首先，删除指定ID的主记录，然后删除与该记录相关的所有参数记录，
274:      * 最后删除与产品参数相关的所有关联信息。
275:      *
276:      * @param int $id 需要删除的记录的ID。
277:      */
278:     public function delete($id)
279:     {
280:         // 创建参数仓库实例
281:         $paramMake = app()->make(ParameterRepository::class);
282:         // 创建关联仓库实例
283:         $releMake = app()->make(RelevanceRepository::class);
284: 
285:         // 使用事务处理删除操作
286:         Db::transaction(function () use ($id, $paramMake, $releMake) {
287:             // 删除主记录
288:             $this->dao->delete($id);
289:             // 删除与模板相关的所有参数
290:             $paramMake->getSearch(['template_id' => $id])->delete();
291:             // 批量删除与产品参数相关的所有关联信息
292:             $releMake->batchDelete($id, RelevanceRepository::PRODUCT_PARAMES_CATE);
293:         });
294:     }
295: 
296: 
297:     /**
298:      * 根据条件获取API列表。
299:      *
300:      * 本函数主要用于查询与商品分类相关的参数信息，可区分PC端和移动端的查询需求。
301:      * 通过传入的分类条件，首先获取对应分类的ID集合，然后根据这些分类ID查询相应的参数模板ID。
302:      * 最后，根据参数模板ID查询具体的参数信息，并根据需要（如PC端查询时）填充参数的值。
303:      *
304:      * @param array $where 查询条件，用于获取商品分类ID。
305:      * @param bool $isPc 是否为PC端查询，默认为false表示移动端。
306:      * @return array 返回查询到的参数信息列表。
307:      */
308:     public function getApiList($where, $isPc = false)
309:     {
310:         // 实例化商品仓库，用于获取商品分类ID
311:         /**
312:          *  通过筛选条件查询出商品的分类ID
313:          *  通过分类ID获取参数模板ID
314:          *  通过参数模板ID查询出参数
315:          */
316:         $productRepository = app()->make(ProductRepository::class);
317:         // 根据分类条件获取分类ID集合
318:         $template_id = $productRepository->getCateIdByCategory($where);
319:         // 根据分类ID集合查询对应的参数模板ID
320:         //$template_id = $this->dao->getSearch(['cate_id' => $cate_ids, 'mer_id' => 0])->column('template_id');
321:         // 实例化参数仓库，用于查询参数信息
322:         $parameterRepository = app()->make(ParameterRepository::class);
323:         // 根据参数模板ID查询参数信息，并按排序降序查询
324:         $query = $parameterRepository->getSearch(['template_id' => $template_id])->field('parameter_id,template_id,name')->order('sort DESC, create_time DESC,template_id DESC');
325:         // 执行查询并获取参数数据
326:         $data = $query->select();
327:         // 如果是PC端查询且有数据，则进一步处理参数的值
328:         //如果是pc端，需要同时返回参数的值
329:         if ($isPc && $data) {
330:             // 将查询结果转换为数组，并按参数名排序
331:             $data = $data->toArray();
332:             ksort($data);
333:             // 构建缓存键名
334:             $key = 'params_1' . json_encode($data);
335:             // 尝试从缓存中获取已处理的参数值
336:             $res = Cache::get($key);
337:             if ($res) {
338:                 // 如果缓存中存在，则直接使用缓存数据
339:                 $data = json_decode($res, true);
340:             } else {
341:                 // 实例化参数值仓库，用于获取参数的具体值
342:                 $parameterValueRepository = app()->make(ParameterValueRepository::class);
343:                 // 遍历参数数据，填充参数值
344:                 foreach ($data as &$datum) {
345:                     $datum['value'] = $parameterValueRepository->getOptions(['parameter_id' => $datum['parameter_id']]);
346:                 }
347:                 // 将处理后的参数值数据缓存起来，有效期60秒
348:                 Cache::set($key, json_encode($data), 60);
349:             }
350:         }
351:         // 返回最终的参数信息列表
352:         return $data;
353:     }
354: }
