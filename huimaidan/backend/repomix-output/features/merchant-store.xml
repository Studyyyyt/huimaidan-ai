20: class ProductSkuRepository extends BaseRepository
21: {
22:     public function __construct(ProductSkuDao $dao)
23:     {
24:         $this->dao = $dao;
25:     }
26: 
27:     const ACTIVE_TYPE_DISCOUNTS = 10;
28: 
29:     /**
30:      * 保存活动产品SKU信息
31:      *
32:      * 该方法用于将活动产品的SKU数据存储到数据库中。它首先通过唯一标识符检索现有的SKU数据，
33:      * 然后根据活动ID、产品ID和活动产品ID将活动SKU的信息插入数据库。
34:      * 如果找不到对应的SKU数据，则抛出一个验证异常。
35:      *
36:      * @param int $id 活动ID
37:      * @param int $productId 产品ID
38:      * @param array $data SKU数据数组，每个元素包含唯一标识和活动价格
39:      * @param int $activeProductId 活动产品ID，默认为0
40:      * @throws ValidateException 如果找不到SKU数据，则抛出此异常
41:      */
42:     public function save(int $id, int $productId, array $data, $activeProductId = 0)
43:     {
44:         // 实例化产品属性值仓库
45:         $storeProductServices = app()->make(ProductAttrValueRepository::class);
46: 
47:         // 遍历数据数组，处理每个SKU的信息
48:         foreach ($data as $item) {
49:             // 根据唯一标识搜索SKU数据
50:             $skuData = $storeProductServices->search(['unique' => $item['unique']])->find();
51: 
52:             // 如果找不到SKU数据，则抛出异常
53:             if (!$skuData) throw new ValidateException('属性规格不存在');
54: 
55:             // 构建活动SKU的数据数组
56:             $activeSku[] = [
57:                 'active_id'     => $id,
58:                 'active_product_id' => $activeProductId,
59:                 'product_id'    => $productId,
60:                 'active_type'   => self::ACTIVE_TYPE_DISCOUNTS,
61:                 'price'         => $skuData['price'],
62:                 'active_price'  => $item['active_price'] ?? $skuData['price'],
63:                 'unique'        => $item['unique'],
64:             ];
65:         }
66: 
67:         // 将所有活动SKU数据插入数据库
68:         $this->dao->insertAll($activeSku);
69:     }
70: }
