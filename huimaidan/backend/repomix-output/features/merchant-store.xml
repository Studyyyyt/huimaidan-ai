167:     public function checkRangeByType(int $merId, array $address)
168:     {
169:         $merReservationInfo = merchantConfig($merId, ['range_type', 'radius', 'region', 'fence']);
170:         $merReservationInfo['mer_id'] = $merId;
171:         if (!$merReservationInfo['range_type']) {
172:             throw new ValidateException('商户预约设置错误，请商家先配置服务范围');
173:         }
174:         $checkMethod = self::RANGE_TYPE_METHOD[$merReservationInfo['range_type']];
175: 
176:         return $this->$checkMethod($address, $merReservationInfo);
177:     }
178:     /**
179:      * 配送半径验证
180:      *
181:      * @param array $address
182:      * @param array $merReservationInfo
183:      * @return boolean
184:      */
185:     public function checkRadius(array $address, array $merReservationInfo): bool
186:     {
187:         $merchant = app()->make(MerchantRepository::class)->detail($merReservationInfo['mer_id'], null);
188:         if (!$merchant) {
189:             throw new ValidateException('商户不存在，无法进行预约');
190:         }
191:         // 根据经纬度计算距离
192:         $distance = $this->getAddressDistance($merchant['lat'], $merchant['long'], $address);
193:         // 配送半径验证
194:         if ($merReservationInfo['radius'] < $distance) {
195:             return false;
196:         }
197: 
198:         return true;
199:     }
200:     /**
201:      * 配送区域验证
202:      *
203:      * @param array $address
204:      * @param array $merReservationInfo
205:      * @return boolean
206:      */
207:     public function checkRegion(array $address, array $merReservationInfo): bool
208:     {
209:         $isRegion = false;
210:         $addresString = $address['province_id'] . ',' . $address['city_id'] . ',' . $address['district_id'];
211:         foreach ($merReservationInfo['region'] as $region) {
212:             $regionString = implode(',', $region);
213:             if (strpos($addresString, $regionString) !== false) {
214:                 $isRegion = true;
215:                 break;
216:             }
217:         }
218: 
219:         return $isRegion;
220:     }
221:     /**
222:      * 配送围栏验证
223:      *
224:      * @param array $address
225:      * @param array $merReservationInfo
226:      * @return boolean
227:      */
228:     public function checkFence(array $address, array $merReservationInfo): bool
229:     {
230:         $isFence = false;
231:         $addressDetail = $address['province'] . $address['city'] . $address['district'] . $address['street'] . $address['detail'];
232:         $addressLatAndLong = lbs_address([], $addressDetail);
233:         foreach ($merReservationInfo['fence'] as $fence) {
234:             $method = 'checkIn' . ucfirst($fence['type']);
235:             if (method_exists($this, $method)) {
236:                 if ($this->$method($fence, $addressLatAndLong)) {
237:                     $isFence = true;
238:                     break;
239:                 }
240:             }
241:         }
242: 
243:         return $isFence;
244:     }
245: }
