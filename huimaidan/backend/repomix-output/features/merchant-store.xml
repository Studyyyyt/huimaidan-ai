 415:         // 更新关联的SPU信息，将其标记为删除状态并禁用
 416:         app()->make(SpuRepository::class)->getSearch(['product_id' => $id])->update(['is_del' => 1, 'status' => 0]);
 417:         // 触发产品删除事件，传递删除的ID作为参数
 418:         event('product.delete', compact('id'));
 419:     }
