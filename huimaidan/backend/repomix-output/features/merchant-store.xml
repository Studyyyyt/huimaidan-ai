4168:         $orderStatus = [
4169:             'order_id' => $orderInfo->order_id,
4170:             'order_sn' => $orderInfo->order_sn,
4171:             'type' => $statusRepository::TYPE_ORDER
4172:         ];
4173:         $event = false;
4174:         try {
4175:             switch ($type) {
4176:                 case 'order_fail': //下单失败回调
4177:                     $orderStatus['change_message'] = '商家寄件订单创建失败';
4178:                     $orderStatus['change_type'] = $statusRepository::ORDER_DELIVERY_SHIPMENT_CANCEL;
4179:                     $orderInfo->task_id = '';
4180:                     $orderInfo->kuaidi_order_id = '';
4181:                     $orderInfo->is_stock_up = 0;
4182:                     break;
4183:                 case 'order_cancel': //取消回调
4184:                     $orderInfo->is_stock_up = 0;
4185:                     $this->cancelShipmentAfrer($orderInfo);
4186:                     $orderStatus = [];
4187:                     break;
4188:                 case 'order_take':   //取件回调
4189:                     $orderStatus['change_message'] = '商家寄件：快递已揽件';
4190:                     $orderStatus['change_type'] = $statusRepository::ORDER_DELIVERY_SHIPMENT_PACKAGE;
4191:                     $orderInfo->status = OrderStatus::ORDER_STATUS_PENDING_RECEIPT;
4192:                     $orderInfo->is_stock_up = 10;
4193:                     $event = true;
4194:                     break;
4195:                 case 'order_receipt': //快递签收回调
4196:                     $orderStatus['change_message'] = '商家寄件：快递已签收';
4197:                     $orderStatus['change_type'] = $statusRepository::ORDER_DELIVERY_SHIPMENT_SUCCESS;
4198:                     $orderInfo->status = OrderStatus::ORDER_STATUS_PENDING_REVIEW;
4199:                     break;
4200:                 default:
4201:                     $orderInfo->is_stock_up = 1;
4202:                     $orderStatus = [];
4203:                     break;
4204:             }
4205:             $orderInfo->save();
4206:             if (!empty($orderStatus)) $statusRepository->createAdminLog($orderStatus);
4207: 
4208:             if ($event) event('mini_order_shipping', ['product', $orderInfo, OrderStatus::DELIVER_TYPE_SHIP_MENT, '', '']);
4209:         }catch (\Exception $e) {
4210:             Log::info('商家寄件回调处理失败：'.$e->getMessage());
4211:         }
4212:     }
