111:             array_push($list, [
112:                 "brand_id" => 0,
113:                 "brand_category_id" => 0,
114:                 "brand_name" => "其他",
115:                 "sort" => 999,
116:                 "pic" => "",
117:                 "is_show" => 1,
118:                 "create_time" => "",
119:             ]);
