 24:     protected function getModel(): string
 25:     {
 26:         return model::class;
 27:     }
 28: 
 29: 
 30:     /**
 31:      * 获取所有品牌信息，包括品牌分类和品牌详情。
 32:      * 此方法专门设计用于获取品牌列表，列表中包括一个特殊的项代表“其他”品牌。
 33:      *
 34:      * @return array 返回一个包含所有品牌信息的数组，其中最后一个元素是特殊的“其他”品牌项。
 35:      */
 36:     public function getAll()
 37:     {
 38:         // 根据品牌分类中的"is_show"字段为1来筛选品牌分类
 39:         $query = $this->getModel()::hasWhere('brandCategory',function($query){
 40:             $query->where('is_show',1);
 41:         });
 42:         // 筛选品牌表中"is_show"字段为1的品牌
 43:         $query->where('StoreBrand.is_show',1);
 44:         // 按品牌的排序和创建时间降序排列，并获取所有符合条件的品牌数据
 45:         $list = $query->order('StoreBrand.sort DESC,StoreBrand.create_time DESC')->select()->toArray();
 46: 
 47:         // 向品牌列表中添加一个特殊的“其他”品牌项
 48:         array_push($list,[
 49:             "brand_id" => 0,
 50:             "brand_category_id" => 0,
 51:             "brand_name" => "其他",
 52:             "sort" => 999,
 53:             "pic" => "",
 54:             "is_show" => 1,
 55:             "create_time" => "",
 56:         ]);
 57: 
 58:         // 返回处理后的品牌列表
 59:         return $list;
 60:     }
 61: 
 62: 
 63: 
 64:     /**
 65:      * 检查指定字段是否存在特定值。
 66:      *
 67:      * 该方法用于查询数据库中指定字段的值是否已存在。它支持排除特定值的查询，
 68:      * 这使得可以在检查存在性时忽略特定的记录。
 69:      *
 70:      * @param string $field 要查询的字段名。
 71:      * @param mixed $value 要查询的字段值。
 72:      * @param mixed $except 可选参数，用于指定需要排除的值。
 73:      * @return bool 如果找到匹配的记录，则返回true；否则返回false。
 74:      */
 75:     public function merFieldExists($field, $value, $except = null)
 76:     {
 77:         // 从模型中获取数据库实例。
 78:         return ($this->getModel())::getDB()
 79:                 // 当$except有值时，添加一个不等于($field, '<>')的查询条件。
 80:                 ->when($except, function ($query, $except) use ($field) {
 81:                     $query->where($field, '<>', $except);
 82:                 })
 83:                 // 添加等于($field, $value)的查询条件。
 84:                 ->where($field, $value)
 85:                 // 统计符合条件的记录数，如果大于0，则表示存在。
 86:                 ->count() > 0;
 87:     }
 88: 
 89: 
 90:     /**
 91:      * 根据条件搜索品牌信息
 92:      *
 93:      * 本函数用于根据传入的条件数组搜索品牌的数据库记录。条件包括品牌分类ID、品牌名称和品牌ID列表。
 94:      * 查询结果将按照排序和创建时间倒序返回。
 95:      *
 96:      * @param array $where 搜索条件数组，包含品牌分类ID、品牌名称和品牌ID列表等条件。
 97:      * @return \think\db\Query 查询结果的查询对象，可用于进一步的查询操作或获取结果。
 98:      */
 99:     public function search(array $where)
100:     {
101:         // 获取数据库查询对象
102:         $query = $this->getModel()::getDB();
103: 
104:         // 如果条件数组中包含品牌分类ID，并且该ID不为空，则添加到查询条件中
105:         if(isset($where['brand_category_id']) && $where['brand_category_id'])
106:             $query->where('brand_category_id',$where['brand_category_id']);
107: 
108:         // 如果条件数组中包含品牌名称，并且该名称不为空，则添加到查询条件中，使用LIKE进行模糊匹配
109:         if(isset($where['brand_name']) && $where['brand_name'])
110:             $query->where('brand_name','like','%'.$where['brand_name'].'%');
111: 
112:         // 如果条件数组中包含品牌ID列表，并且该列表不为空，则添加到查询条件中，查询包含在列表中的品牌
113:         if((isset($where['ids']) && $where['ids']))
114:             $query->where($this->getPk(),'in',$where['ids']);
115: 
