3860:         if (!$product || !$unique) throw new ValidateException('参数错误');
3861:         if ($product->product_type != 1) throw new ValidateException('商品类型错误'.$product->product_type);
3862:         if (!$product->active_id) throw new ValidateException('秒杀活动不存在');
3863:         $key = self::SECKILL_STOCK_CACHE_KEY.'_'.$product->active_id . '_' . date('Y-m-d',time()) . '_' . $product->product_id;
