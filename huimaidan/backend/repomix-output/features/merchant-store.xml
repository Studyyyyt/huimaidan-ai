 11: namespace app\common\dao\store\product;
 12: 
 13: use app\common\dao\BaseDao;
 14: use app\common\model\store\product\Product;
 15: use app\common\model\store\product\ProductCate;
 16: use app\common\model\store\product\Spu;
 17: use app\common\model\store\StoreCategory;
 18: use app\common\model\store\parameter\ParameterProduct;
 19: use app\common\repositories\store\StoreCategoryRepository;
 20: use app\common\repositories\system\merchant\MerchantRepository;
 21: use crmeb\services\VicWordService;
 22: 
 23: class SpuDao extends  BaseDao
 24: {
 25:     public function getModel(): string
 26:     {
 27:         return Spu::class;
 28:     }
 29: 
 30: 
 31:     public function search($where)
 32:     {
 33:         // 1. 提前收集所有符合条件的 product_id
 34:         $productIds = $this->collectProductIds($where);
 35:         $query = Spu::alias('S')
 36:             ->join('store_product P', 'S.product_id = P.product_id', 'LEFT')
 37:             ->whereIn('S.product_id', $productIds);
 38: 
 39:         if ($productIds === false || empty($productIds)) {
 40:             // 返回空查询，避免后续执行
 41:             return $query;
 42:         }
 43: 
 44:         // 2. 主查询：只查主表
 45:         $query
 46:             ->when(isset($where['keyword']) && $where['keyword'] !== '',function($query)use($where){
 47:                 if (is_numeric($where['keyword'])) {
 48:                     $query->whereLike("S.store_name|S.keyword|S.product_id", "%{$where['keyword']}%");
 49:                 } else {
 50:                     $word = app()->make(VicWordService::class)->getWord($where['keyword']);
 51:                     $query->where(function ($query) use ($word) {
 52:                         foreach ($word as $item) {
 53:                             $query->whereOr('S.store_name|S.keyword', 'LIKE', "%$item%");
 54:                         }
 55:                     });
 56:                 }
 57:             })
 58:             ->when(isset($where['spu_id']) && $where['spu_id'] !== '', function ($query) use ($where) {
 59:                 $query->where('S.spu_id',$where['spu_id']);
 60:             })
 61:             ->when(isset($where['spu_ids']) && $where['spu_ids'] !== '', function ($query) use ($where) {
 62:                 $query->whereIn('S.spu_id',$where['spu_ids']);
 63:             })
 64:             ->when(isset($where['is_show']) && $where['is_show'] !== '', function ($query) use ($where) {
 65:                 $query->whereIn('P.is_show',$where['is_show']);
 66:             })
 67:             ->when(isset($where['common']) && $where['common'] !== '', function ($query) use ($where) {
 68:                 $query->whereIn('S.product_type', [0, 1]);
 69:             })
 70:             ->when(isset($where['price_on']) && $where['price_on'] !== '',function($query)use($where){
 71:                 $query->where('S.price','>=',$where['price_on']);
 72:             })
 73:             ->when(isset($where['price_off']) && $where['price_off'] !== '',function($query)use($where){
 74:                 $query->where('S.price','<=',$where['price_off']);
 75:             })
 76:             ->when(isset($where['product_type']) && $where['product_type'] !== '',function($query)use($where){
 77:                 $query->where('S.product_type',$where['product_type']);
 78:             })
 79:             ->when(isset($where['activity_id']) && $where['activity_id'] !== '',function($query)use($where){
 80:                 $query->where('S.activity_id',$where['activity_id']);
 81:             })
 82:             ->when(isset($where['product_id']) && $where['product_id'] !== '',function($query)use($where){
 83:                 $query->where('S.product_id',$where['product_id']);
 84:             })
 85:             ->when(isset($where['not_type']) && $where['not_type'] !== '',function($query)use($where){
 86:                 $query->whereNotIn('S.product_type',$where['not_type']);
 87:             })
 88:             ->when(isset($where['action']) && $where['action'] !== '',function($query)use($where){
 89:                 $query->where('S.product_type','>',0)->where('S.mer_id','<>',0);
 90:             })
 91:             ->when(isset($where['spu_status']) && $where['spu_status'] !== '',function($query)use($where){
 92:                 $query->where('S.status',$where['spu_status']);
 93:             })
 94:             ->when(isset($where['sys_labels']) && $where['sys_labels'] !== '',function($query)use($where){
 95:                 $query->whereLike('S.sys_labels',"%,{$where['sys_labels']},%");
 96:             })
 97:             ->when(isset($where['mer_labels']) && $where['mer_labels'] !== '',function($query)use($where){
 98:                 $query->whereLike('S.mer_labels',"%,{$where['mer_labels']},%");
 99:             })
100: 
101:             ->when(isset($where['store_label_id']) && $where['store_label_id'] !== '',function($query)use($where){
102:                 $lables = explode(',', $where['store_label_id']);
103:                 foreach ($lables as $item) {
104:                     $query->whereFindInSet('S.sys_labels', $item);
105:                 }
106:             })
107:             ->when(isset($where['mer_store_label_id']) && $where['mer_store_label_id'] !== '',function($query)use($where){
108:                 $lables = explode(',', $where['mer_store_label_id']);
109:                 foreach ($lables as $item) {
110:                     $query->whereFindInSet('S.mer_labels', $item);
111:                 }
112:             })
113:             ->when(isset($where['scope']) && $where['scope'] !== '', function ($query) use ($where) {
114:                 $scope = explode(',', $where['scope']);
115:                 if ($scope[1] <= 0) {
116:                     $query->where('S.ot_price','<',$where['scope']);
117:                 } else {
118:                     $query->where('S.ot_price','between',$scope);
119:                 }
120:             })
121:         ;
122:         $query->order($this->buildOrderSql($where));
123: 
124:         return $query;
125:     }
126: 
127: 
128:     private function collectProductIds($where)
129:     {
130:         $query = Product::alias('P')->where('P.is_del', 0)
131:             ->join('StoreProductReservation R', 'P.product_id = R.product_id', 'LEFT');
132: 
133:         if (isset($where['product_type']) && $where['product_type'] != 20){
134:             $query->join('Merchant M', 'P.mer_id = M.mer_id', 'LEFT')
135:                 ->where('M.status', 1)
136:                 ->where('M.mer_state', 1);
137:         }
138: 
139:         $query
140:             ->when(isset($where['is_del']) && $where['is_del'] !== '',function($query)use($where){
141:                 $query->where('P.is_del',$where['is_del']);
142:             })
143:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '',function($query)use($where){
144:                 $query->where('P.mer_id',$where['mer_id']);
145:             })
146:             ->when(isset($where['mer_ids']) && $where['mer_ids'] !== '',function($query)use($where){
147:                 $query->whereIn('P.mer_id',$where['mer_ids']);
148:             })
149:             ->when(isset($where['product_ids']) && $where['product_ids'] !== '',function($query)use($where){
150:                 $query->whereIn('P.product_id',$where['product_ids']);
151:             })
152:             ->when(isset($where['is_trader']) && $where['is_trader'] !== '',function($query)use($where){
153:                 $merId = app()->make(MerchantRepository::class)->search([
154:                     'is_trader' => $where['is_trader'],
155:                     'status' => 1,
156:                     'mer_state' => 1,
157:                     'is_del' => 1,
158:                 ])->column('mer_id');
159:                 $query->whereIn('P.mer_id',$merId);
160:             })
161:             ->when(isset($where['mer_type_id']) && $where['mer_type_id'] !== '',function($query)use($where){
162:                 $merId = app()->make(MerchantRepository::class)->search([
163:                     'type_id' => $where['mer_type_id'],
164:                     'status' => 1,
165:                     'mer_state' => 1,
166:                     'is_del' => 1,
167:                 ])->column('mer_id');
168:                 $query->whereIn('P.mer_id',$merId);
169:             })
170: 
171:             ->when(isset($where['cate_pid']) && $where['cate_pid'], function ($query) use ($where) {
172:                 $storeCategoryRepository = app()->make(StoreCategoryRepository::class);
173:                 if (is_array($where['cate_pid'])) {
174:                     $cateIds = $storeCategoryRepository->selectChildrenId($where['cate_pid']);
175:                 } else {
176:                     $cateIds = $storeCategoryRepository->findChildrenId((int)$where['cate_pid']);
177:                     $where['cate_pid'] = [$where['cate_pid']];
178:                 }
179:                 $cate = array_merge($cateIds, $where['cate_pid']);
180:                 $query->whereIn('P.cate_id', $cate);
181:             })
182:             ->when(isset($where['pid']) && $where['pid'] !== '', function ($query) use ($where) {
