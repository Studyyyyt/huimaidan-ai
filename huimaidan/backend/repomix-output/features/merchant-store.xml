488:             // 构建查询参数
489:             $arr =  ['exsits_id' => $id,'product_type' => 3];
490:             // 获取用户已参加活动的次数
491:             $_counot = $make->getTattendCount($arr,$uid)->count();
492:             // 如果用户参加次数达到上限，抛出异常
493:             if($_counot >= $data['pay_count']) throw new ValidateException('您已达到购买次数上限');
494:         }
495:         // 如果活动信息不存在，抛出异常（虽然前面已检查，但这里再次强调）
496:         if(!$data) throw new ValidateException('商品不在活动时间内');
