 46:      * @param int $merId 商家ID，用于指定参数所属的商家，如果数据中没有提供，则使用此默认值。
 47:      */
 48:     public function create($data, $productId = 0, $merId = 0)
 49:     {
 50:         // 检查数据集是否为空，如果为空则直接返回，不进行后续处理
 51:         if (empty($data)) return ;
 52:         // 遍历数据集中的每个参数项
 53:         $toProduct = [];
 54: 
 55:         // 如果没有parameter_id，且有productId,表示是某商品新增的属性,需要先清除商品中的属性
 56:         if(isset($productId) && !empty($productId)) {
 57:             $this->dao->clear($productId,'product_id');
 58:         }
 59: 
 60:         foreach ($data as &$datum) {
 61:             // 创建参数属性
 62:             foreach ($datum['values'] as &$v) {
 63:                 $createData = [
 64:                     'name' => $datum['name'],
 65:                     'value' => $v['value'],
 66:                     'mer_id' => $merId,
 67:                     //如果是存在$datum['parameter_id'],则表示这个属性是模板中定义的 不需要和商品绑定
 68:                     'product_id' => isset($datum['parameter_id']) ? 0 : $productId,
 69:                     'parameter_id' => isset($datum['parameter_id']) ? $datum['parameter_id'] : 0,
 70:                 ];
 71:                 $create = $this->dao->findOrcreate($createData);
 72:                 $v['parameter_value_id'] = $create->parameter_value_id;
 73: 
 74:                 if ($productId){
 75:                     $toProduct[] = [
 76:                         'product_id' => $productId,
 77:                         'parameter_value_id' => $v['parameter_value_id']
 78:                     ];
 79:                 }
 80:             }
 81:         }
 82:         // 如果有有效的参数记录，则插入到数据库
 83:         if($toProduct){
 84:             $productRepository = app()->make(ParameterProductRepository::class);
 85:             $productRepository->clear(array_column($toProduct,'product_id'),'product_id');
 86:             $productRepository->insertAll($toProduct);
 87:         }
 88: 
 89:         return $data;
 90:     }
