111:      *
112:      * 本函数用于查询指定商家ID对应的物流模板信息。它通过构建数据库查询条件，
113:      * 筛选出商家ID对应的物流模板，并按照排序和创建时间进行降序排列，最终返回查询结果。
114:      *
115:      * @param int $merId 商家ID，用于确定查询的商家范围
116:      * @return array 返回包含物流模板信息的数组，每个元素包含shipping_template_id、name、is_default字段
117:      */
118:     public function getList($merId)
119:     {
120:         // 调用getModel方法获取模型实例，并直接进行数据库查询
121:         // 查询条件为mer_id等于$merId，返回字段包括shipping_template_id、name、is_default
122:         // 按照sort降序和create_time降序进行结果排序
123:         return ($this->getModel())::getDB()->where('mer_id',$merId)->field('shipping_template_id,name,is_default')->order('sort DESC,create_time DESC')->select();
124:     }
125: 
126:     /**
127:      * 清理与指定字段和ID相关的运输模板数据。
128:      *
129:      * 此函数用于根据给定的字段ID清理相关的运输模板数据，包括删除模板本身以及与该模板相关的所有区域、未投递和免费运输设置。
130:      * 使用事务确保数据一致性和完整性。
131:      *
132:      * @param int $id 主键ID，用于查询和删除相关数据。
133:      * @param string $field 字段名，用于查询和删除相关数据。
134:      */
135:     public function clear($id,$field)
136:     {
137:         // 查询与指定字段和ID相关的运输模板ID。
138:         $shipping_template_id = $this->getModel()::getDB()->where($field, $id)->column('shipping_template_id');
139: 
140:         // 使用事务处理来确保相关操作的原子性。
141:         Db::transaction(function () use ($id,$field,$shipping_template_id) {
142:             // 删除指定字段和ID的运输模板记录。
143:             $this->getModel()::getDB()->where($field, $id)->delete();
