744:      * 该方法用于根据分类ID从Redis缓存中获取热门排名列表。如果缓存中不存在，则从数据库中查询并缓存结果。
745:      * 主要用于展示指定分类下的热门商品，提高数据获取速度，提升用户体验。
746:      *
747:      * @param int $cateId 分类ID，用于查询指定分类下的热门商品。
748:      * @param int $limit 返回结果的数量限制，默认为15条。
749:      * @return array 返回热门商品列表，列表项包含商品的基本信息。
750:      */
751:     public function getHotRanking(int $cateId, $limit = 15, $regionId = 0)
752:     {
753:         // 实例化Redis缓存服务
754:         $RedisCacheService = app()->make(RedisCacheService::class);
755:         // 构建缓存键名前缀，根据环境变量确定队列名称，后接固定字符串和分类ID
756:         $prefix = env('queue_name', 'merchant') . '_hot_ranking_';
757:         // 从Redis中获取热门排名ID列表
758:         $ids = $RedisCacheService->handler()->get($prefix . 'top_' . intval($cateId));
759:         // 如果ID列表为空，则直接返回空数组
760:         $ids = $ids ? explode(',', $ids) : [];
761:         if (!count($ids)) {
762:             return [];
763:         }
764:         // 将字符串ID转换为整数ID
765:         $ids = array_map('intval', $ids);
766:         // 定义查询条件，只查询启用状态、正常状态、未删除的商品，并按销售量排序
767:         $where['mer_status'] = 1;
768:         $where['status'] = 1;
769:         $where['is_del'] = 0;
770:         $where['product_type'] = 0;
771:         $where['order'] = 'sales';
772:         $where['is_gift_bag'] = 0;
773:         $where['spu_ids'] = $ids;
774:         // 筛选商圈商家ID列表
775:         if($regionId) {
776:             $merIds = $this->getMerIdsByRegin($regionId);
777:             $where['mer_ids'] = $merIds;
778:         }
779: 
780:         // 执行查询，限制返回结果的数量
781:         $list = $this->dao->search($where)->setOption('field', [])->field('spu_id,S.image,S.price,S.product_type,P.product_id,P.sales,S.status,S.store_name,P.ot_price,P.cost')->limit($limit)->select();
782:         // 如果查询结果存在，则转换为数组格式并返回
783:         if ($list) $list = $list->toArray();
784:         return $list;
785:     }
