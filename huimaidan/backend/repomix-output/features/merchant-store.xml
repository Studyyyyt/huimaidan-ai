 329:      *  商户优惠券创建表单
 330:      * @return Form
 331:      * @throws FormBuilderException
 332:      * @author xaboy
 333:      * @day 2020/5/20
 334:      */
 335:     public function form()
 336:     {
 337:         return Elm::createForm(Route::buildUrl('merchantCouponCreate')->build(), [
 338:             Elm::input('title', '优惠券名称：')->placeholder('请输入优惠卷名称')->attrs(['style' => ['width' => '460px']])->required('请输入优惠券名称'),
