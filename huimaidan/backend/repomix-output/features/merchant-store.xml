576:     /**
577:      * 同步房间状态
578:      * 该方法用于从小程序广播接口获取房间状态，并更新本地数据库中对应房间的状态。考虑到性能和接口限制，采用分页方式批量获取和更新。
579:      */
580:     public function syncRoomStatus()
581:     {
582:         // 初始化起始位置和每批处理的数量
583:         $start = 0;
584:         $limit = 50;
585: 
586:         // 创建小程序广播客户端
587:         $client = MiniProgramService::create()->miniBroadcast();
588: 
589:         do {
590:             // 分批获取房间信息
591:             $data = $client->getRooms($start, $limit)->room_info;
592:             $start += 50; // 更新起始位置，准备下一批处理
593: 
594:             // 根据获取的房间ID，从本地数据库中批量获取房间详情
595:             $rooms = $this->getRooms(array_column($data, 'roomid'));
596: 
597:             // 遍历获取的房间信息，对比并更新本地数据库中的房间状态
598:             foreach ($data as $room) {
599:                 // 如果本地有该房间记录且状态不同，则更新房间状态
600:                 if (isset($rooms[$room['roomid']]) && $room['live_status'] != $rooms[$room['roomid']]['live_status']) {
601:                     $this->dao->update($rooms[$room['roomid']]['broadcast_room_id'], ['live_status' => $room['live_status']]);
602:                 }
603:             }
604:         } while (count($data) >= $limit); // 如果当前批次的数据量达到或超过限制，继续处理下一批
605:     }
