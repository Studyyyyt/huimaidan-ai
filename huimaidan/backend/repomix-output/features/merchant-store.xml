175:     /**
176:      * 虚拟成团 操作
177:      * @param ProductGroupBuying $res
178:      * @author Qinii
179:      * @day 1/11/21
180:      */
181:     public function setFictiGroup(ProductGroupBuying $res)
182:     {
183:         $j = $res['buying_count_num'] - $res['yet_buying_num'];
184:         $user_make = app()->make(UserRepository::class);
185:         $query = $user_make->search([]);
