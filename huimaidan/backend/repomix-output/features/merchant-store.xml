222:         $user = $productGroupUserRepository->groupOrderIds($res['group_buying_id']);
223:         $storeOrderStatusRepository = app()->make(storeOrderStatusRepository::class);
224:         $data = $orderIds = [];
225:         foreach ($user as $item) {
226:             $data[] = [
227:                 'order_id' => $item['order_id'],
228:                 'order_sn' => $item['orderInfo']['order_sn'],
229:                 'type' => $storeOrderStatusRepository::TYPE_ORDER,
230:                 'change_message' => '拼团成功',
231:                 'change_type' => $storeOrderStatusRepository::ORDER_STATUS_GROUP_SUCCESS,
232:                 'uid' => 0,
233:                 'nickname' => '系统',
234:                 'user_type' => $storeOrderStatusRepository::U_TYPE_SYSTEM,
