 21: /**
 22:  * 价格说明
 23:  */
 24: class PriceRuleRepository extends BaseRepository
 25: {
 26:     public function __construct(PriceRuleDao $dao)
 27:     {
 28:         $this->dao = $dao;
 29:     }
 30: 
 31:     /**
 32:      * 根据条件获取规则列表
 33:      *
 34:      * 本函数用于根据给定的条件数组$where，获取规则列表。支持分页查询，每页返回$limit条记录，当前页码为$page。
 35:      * 返回的结果包含规则列表和总记录数。
 36:      *
 37:      * @param array $where 查询条件数组
 38:      * @param int $page 当前页码
 39:      * @param int $limit 每页返回的记录数
 40:      * @return array 包含规则列表和总记录数的数组
 41:      */
 42:     public function lst(array $where, $page, $limit)
 43:     {
 44:         // 根据$where条件搜索规则，并按照'sort'降序和'rule_id'降序排序
 45:         $query = $this->dao->search($where)->order('sort DESC, rule_id DESC');
 46: 
 47:         // 计算满足条件的总记录数
 48:         $count = $query->count();
 49: 
 50:         // 获取当前页的规则列表，同时加载每个规则的分类信息
 51:         $list = $query->page($page, $limit)->with(['cate'])->select();
 52: 
 53:         // 返回包含总记录数和规则列表的数组
 54:         return compact('count', 'list');
 55:     }
 56: 
 57:     /**
 58:      * 创建规则
 59:      *
 60:      * 本函数用于根据提供的数据创建新的规则，并为其关联指定的分类ID。在创建规则的过程中，会确保规则的默认状态
 61:      * 根据提供的分类ID的数量来决定。如果分类ID的数量大于0，则规则设为非默认；否则，设为默认规则。
 62:      *
 63:      * @param array $data 包含规则信息的数据数组，其中'cate_id'字段被用于关联分类，但会被随后移除。
 64:      * @return mixed 返回创建的规则对象。
 65:      */
 66:     public function createRule(array $data)
 67:     {
 68:         // 将$data['cate_id']转换为数组，用于后续处理
 69:         $cateIds = (array)$data['cate_id'];
 70:         // 移除$data中的'cate_id'字段，因为它不再需要
 71:         unset($data['cate_id']);
 72: 
 73:         // 使用事务处理来确保数据库操作的一致性
 74:         return Db::transaction(function () use ($cateIds, $data) {
 75:             // 根据$cateIds的长度判断是否设置规则为默认规则
 76:             $data['is_default'] = count($cateIds) ? 0 : 1;
 77:             // 创建新的规则对象
 78:             $rule = $this->dao->create($data);
 79: 
 80:             // 初始化用于批量插入关联数据的数组
 81:             $inserts = [];
 82:             // 遍历分类ID数组，为每个分类ID创建关联数据
 83:             foreach ($cateIds as $id) {
 84:                 $inserts[] = [
 85:                     'left_id' => $rule['rule_id'],
 86:                     'right_id' => (int)$id,
 87:                     'type' => RelevanceRepository::PRICE_RULE_CATEGORY
 88:                 ];
 89:             }
 90: 
 91:             // 如果有需要插入的关联数据，则进行插入操作
 92:             if (count($inserts)) {
 93:                 app()->make(RelevanceRepository::class)->insertAll($inserts);
 94:             }
 95: 
 96:             // 返回创建的规则对象
 97:             return $rule;
 98:         });
 99:     }
100: 
101:     /**
102:      * 更新规则信息并同步更新关联分类。
103:      *
104:      * 本函数主要用于处理规则的更新操作，包括规则本身信息的更新以及规则与分类关联关系的更新。
105:      * 在更新规则信息时，会检查是否设置了默认规则，并根据情况更新此字段。同时，会清除原有的分类关联关系，
106:      * 并根据新的分类ID列表重建关联关系。
107:      *
108:      * @param int $id 规则ID，用于定位需要更新的规则。
109:      * @param array $data 包含规则更新信息和分类ID的数据数组。
110:      * @return bool 更新操作是否成功的标志。
111:      */
112:     public function updateRule(int $id, array $data)
113:     {
114:         // 将数据中的分类ID提取为数组，后续处理规则的默认状态和关联关系
115:         $cateIds = (array)$data['cate_id'];
116:         // 从更新数据中移除 cate_id 字段，因为它将通过其他方式处理
117:         unset($data['cate_id']);
118:         // 设置更新时间
119:         $data['update_time'] = date('Y-m-d H:i:s');
120: 
121:         // 使用事务处理来确保数据的一致性
122:         return Db::transaction(function () use ($id, $cateIds, $data) {
123:             // 如果分类ID数量大于0，则设置规则为非默认；否则设置为默认
124:             $data['is_default'] = count($cateIds) ? 0 : 1;
125:             // 更新规则本身的信息
126:             $this->dao->update($id, $data);
127: 
128:             // 准备插入的新分类关联关系数据
129:             $inserts = [];
130:             foreach ($cateIds as $cid) {
131:                 $inserts[] = [
132:                     'left_id' => $id,
133:                     'right_id' => (int)$cid,
134:                     'type' => RelevanceRepository::PRICE_RULE_CATEGORY
135:                 ];
136:             }
137: 
138:             // 删除原有的规则与分类关联关系
139:             app()->make(RelevanceRepository::class)->query([
140:                 'left_id' => $id,
141:                 'type' => RelevanceRepository::PRICE_RULE_CATEGORY
142:             ])->delete();
143: 
144:             // 如果有新的分类ID需要关联，则插入新的关联关系
145:             if (count($inserts)) {
146:                 app()->make(RelevanceRepository::class)->insertAll($inserts);
147:             }
148:         });
149:     }
150: 
151: 
