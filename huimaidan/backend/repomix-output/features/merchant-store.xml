 51:     const TYPE_MUST_SECKILL_ACTIVE = 5;
 52: 
 53:     public $activeProductType = [1];
 54:     //使用范围对应的类型
 55:     public  $typeData = [
 56:         self::TYPE_ALL => '',
 57:         self::TYPE_MUST_PRODUCT => RelevanceRepository::SCOPE_TYPE_PRODUCT,
 58:         self::TYPE_MUST_CATEGORY => RelevanceRepository::SCOPE_TYPE_CATEGORY,
 59:         self::TYPE_MUST_STORE => RelevanceRepository::SCOPE_TYPE_STORE,
 60:         self::TYPE_MUST_PRODUCT_LABEL => RelevanceRepository::SCOPE_TYPE_PRODUCT_LABEL,
 61:         self::TYPE_MUST_SECKILL_ACTIVE => '',
 62:     ];
 63: 
