 88:     /**
 89:      * 验证查询参数
 90:      * @param int|null $type
 91:      * @param int $send_type
 92:      * @return BaseQuery
 93:      * @author xaboy
 94:      * @day 2020/6/18
 95:      */
 96:     public function validCouponQuery($type = null, $send_type = 0)
 97:     {
 98:         $query = StoreCoupon::getDB()
 99:             ->where('status', 1)
100:             ->where('send_type', $send_type)
101:             ->where('is_del', 0)
102:             ->order('sort DESC,coupon_id DESC')
103:             ->when(!is_null($type), function ($query) use ($type) {
104:                 $query->where('type', $type);
105:             });
106:         $query->where(function (BaseQuery $query) {
107:             $query->where('is_limited', 0)->whereOr(function (BaseQuery $query) {
108:                 $query->where('is_limited', 1)->where('remain_count', '>', 0);
109:             });
110:         })
111:         ->where(function (BaseQuery $query) {
112:             $query->where('is_timeout', 0)->whereOr(function (BaseQuery $query) {
113:                 $time = date('Y-m-d H:i:s');
114:                 $query->where('is_timeout', 1)->where('start_time', '<', $time)->where('end_time', '>', $time);
115:             });
116:         })
117:         ->where(function (BaseQuery $query) {
118:             $query->where('coupon_type', 0)->whereOr(function (BaseQuery $query) {
119:                 $query->where('coupon_type', 1)->where('use_end_time', '>', date('Y-m-d H:i:s'));
120:             });
121:         });
122:         return $query;
123:     }
