1475:     public function recalculateGiveIntegral($order, $payPrice)
1476:     {
1477:         $order_total_give_integral = 0;
1478:         $svip_status = $order->svip_discount > 0 && systemConfig('svip_switch_status') == '1';
1479:         $svip_integral_rate = $svip_status ? app()->make(MemberinterestsRepository::class)->getSvipInterestVal(MemberinterestsRepository::HAS_TYPE_PAY) : 0;
1480:         //积分配置
1481:         $sysIntegralConfig = systemConfig(['integral_money', 'integral_status', 'integral_order_rate']);
1482:         $giveIntegralFlag = $sysIntegralConfig['integral_status'] && $sysIntegralConfig['integral_order_rate'] > 0;
1483:         $total_give_integral = 0;
1484:         //计算赠送积分, 只有普通商品赠送积分
1485:         if ($giveIntegralFlag && $payPrice > 0) {
1486:             $total_give_integral = floor(bcmul($payPrice, $sysIntegralConfig['integral_order_rate'], 0));
