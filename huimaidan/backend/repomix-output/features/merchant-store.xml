2320:     /**
2321:      * 构建分拆退款数据（定金+尾款）
2322:      */
2323:     private function buildSplitRefundData(StoreRefundOrder $refundOrder, string $remainingDeposit, int $serverType): array
2324:     {
2325:         $result = [];
2326:         $order = $refundOrder->order;
2327: 
2328:         // 定金部分退款
2329:         if ($order->groupOrder->is_combine) {
2330:             $data = $refundOrder->getCombineRefundParams($serverType);
2331:             $data['refund_price'] = $remainingDeposit;
2332:             $result[] = [
2333:                 'type' => $serverType,
2334:                 'id' => $order->order_id,
2335:                 'sn' => $order->order_sn,
2336:                 'data' => $data
2337:             ];
2338:         } else {
2339:             $result[] = [
2340:                 'type' => $serverType,
2341:                 'sn' => $order->groupOrder->group_order_sn,
2342:                 'id' => $order->order_id,
2343:                 'data' => [
2344:                     'refund_id' => $refundOrder->refund_order_sn,
2345:                     'pay_price' => $order->pay_price,
2346:                     'refund_price' => $remainingDeposit
2347:                 ]
2348:             ];
2349:         }
2350: 
2351:         // 尾款部分退款
2352:         $result[] = $this->buildFinalPartialRefundData($refundOrder, $remainingDeposit);
2353: 
2354:         return $result;
2355:     }
