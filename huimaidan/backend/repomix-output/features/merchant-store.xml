111:      */
112:     public function Import($type)
113:     {
114:         $file = $this->request->file('file');
115:         if (!$file)  return app('json')->fail('请上传EXCEL文件');
116:         $file = is_array($file) ? $file[0] : $file;
117:         validate(["file|文件" => ['fileExt' => 'xlsx,xls',]])->check(['file' => $file]);
118: 
119:         $upload = UploadService::create(1);
120:         $ret = $upload->to('excel')->move('file');
121:         if ($ret === false) return app('json')->fail($upload->getError());
122:         $res = $upload->getUploadInfo();
123:         $path = rtrim(public_path(),'/').$res['dir'];
124:         $data = [];
125:         $spreadsheet = SpreadsheetExcelService::instance();
126:         switch ($type){
127:              case 'delivery' :
