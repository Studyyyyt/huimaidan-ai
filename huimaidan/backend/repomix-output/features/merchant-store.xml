312:     public function detail(int $id, $userInfo)
313:     {
314:         $where = ['group_buying_id' => $id];
315:         $data = $this->dao->getSearch($where)->where('is_del', 0)->with([
316:             'groupUser' => function ($query) {
317:                 $query->where('is_del', 0)->field('group_buying_id,product_group_id,is_initiator,nickname,avatar')->order('is_initiator DESC');
318:             },
319:         ])->hidden(['ficti_status', 'ficti_num'])->find();
320:         if (!$data) throw new ValidateException('无此团信息');
321:         $make = app()->make(ProductRepository::class);
322:         $product = $make->apiProductDetail(['product_id' => $data->productGroup['product_id']], 4, $data->productGroup['product_group_id']);
323:         $product['ot_price'] = $product['price'];
324:         $product['price'] = $data->productGroup['price'];
325:         $data['product'] = $product;
326: 
327:         if ($userInfo) {
328:             $make = app()->make(ProductGroupUserRepository::class);
329:             $data['self'] = $make->getSearch(['group_buying_id' => $id, 'uid' => $userInfo->uid, 'is_del' => 0])->find();
330:             $count = $data['self'] ? 1 : 0;
331:         }
332:         $data['create_status'] = $count ?? 0;
333:         unset($data['productGroup']);
334:         return $data;
