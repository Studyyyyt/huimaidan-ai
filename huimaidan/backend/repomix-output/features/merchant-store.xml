292:                 // 计算免费配送条件
293:                 $settlefree = $this->settleFree($free, $temp['shipping_template_id']);
294:                 // 插入计算后的免费配送条件
295:                 (app()->make(ShippingTemplateFreeRepository::class)->insertAll($settlefree));
