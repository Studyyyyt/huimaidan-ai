172:         // 将发票ID字符串分解为数组
173:         $ids = explode(',',$ids);
174: 
175:         // 遍历发票ID数组，检查每个ID是否与指定的商家ID相关联
176:         foreach ($ids as $id) {
177:             // 如果某个发票ID与指定的商家ID不相关联，则抛出验证异常
178:             if(!$this->dao->getSearch(['order_receipt_id' => $id,'mer_id' => $merId])->count())
179:                 throw new ValidateException('数据有误,存在不属于您的发票ID');
180:         }
181:         // 如果所有发票ID都通过验证，返回true
182:         return true;
183:     }
