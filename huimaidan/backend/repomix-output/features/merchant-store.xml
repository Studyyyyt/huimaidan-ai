 66: 
 67:     /**
 68:      * 查询是否存在
 69:      * @Author:Qinii
 70:      * @Date: 2020/5/7
 71:      * @param int $merId
 72:      * @param $field
 73:      * @param $value
 74:      * @param null $except
 75:      * @return bool
 76:      */
 77:     public function merFieldExists(int $merId, $field, $value, $except = null)
 78:     {
 79:        return  ($this->getModel())::getDB()->when($except, function ($query, $except) use ($field) {
 80:                 $query->where($field, '<>', $except);
 81:             })->where('mer_id', $merId)->where($field, $value)->count() > 0;
 82:     }
 83: 
 84:     /**
