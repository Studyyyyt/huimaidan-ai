 20: class ProductPresellSkuDao extends BaseDao
 21: {
 22:     protected function getModel(): string
 23:     {
 24:         return ProductPresellSku::class;
 25:     }
 26: 
 27:     /**
 28:      * 清除预售产品的相关数据
 29:      *
 30:      * 本函数用于根据给定的预售产品ID，从数据库中删除与该预售产品相关的所有数据。
 31:      * 这里的相关数据指的是通过预售产品ID可以唯一标识的数据记录。
 32:      *
 33:      * @param int $id 预售产品的唯一标识ID
 34:      */
 35:     public function clear($id)
 36:     {
 37:         // 通过模型获取数据库实例，并基于给定的预售产品ID删除相关数据
 38:         $this->getModel()::getDB()->where('product_presell_id', $id)->delete();
 39:     }
 40: 
 41: 
 42:     /**
 43:      * 减少指定预售产品的库存并增加销量
 44:      *
 45:      * 本函数用于处理预售产品的库存逻辑。通过传入预售产品ID和唯一标识符，
 46:      * 对对应产品的库存进行减少，同时增加该产品的销量。
 47:      * 这种设计适用于预售后期对已预订产品的库存和销量进行精确调整的场景。
 48:      *
 49:      * @param int $product_presell_id 预售产品的ID，用于定位特定的预售产品。
 50:      * @param string $unique 唯一标识符，用于确保操作的准确性，防止重复操作。
 51:      * @param int $desc 需要减少的库存数量，同时也是增加的销量数量。
 52:      * @return bool 返回操作结果，成功为true，失败为false。
 53:      */
 54:     public function descStock(int $product_presell_id, string $unique, int $desc)
 55:     {
 56:         // 使用模型的数据库操作方法，根据预售产品ID和唯一标识符定位到特定的数据行。
 57:         // 然后更新该行的库存和销量数据，库存减少，销量增加。
 58:         return $this->getModel()::getDB()->where('product_presell_id', $product_presell_id)->where('unique', $unique)->update([
 59:             'stock' => Db::raw('stock-' . $desc), // 直接通过数据库原生表达式减少库存
 60:             'seles' => Db::raw('seles+' . $desc), // 直接通过数据库原生表达式增加销量
 61:         ]);
 62:     }
 63: 
 64:     /**
 65:      * 增加预售产品的库存并减少销量
 66:      *
 67:      * 本函数用于在数据库中更新指定预售产品的库存和销量。它通过增加库存量和减少销售量来调整产品的状态。
 68:      * 主要用于处理预售结束后的库存和销量结算。
 69:      *
 70:      * @param int $product_presell_id 预售产品的ID，用于定位特定的预售产品
 71:      * @param string $unique 预售产品的唯一标识，用于确保操作的准确性
 72:      * @param int $desc 库存增加的数量，同时也是销量减少的数量，表示此次操作的规模
 73:      * @return bool 更新操作的结果，成功返回true，失败返回false
 74:      */
 75:     public function incStock(int $product_presell_id, string $unique, int $desc)
 76:     {
 77:         // 使用模型的数据库操作方法，根据预售产品ID和唯一标识定位到特定的预售产品记录
 78:         // 然后更新该记录的库存和销量字段，库存增加，销量减少
 79:         $info = $this->getModel()::getDB()->where('product_presell_id', $product_presell_id)->where('unique',$unique)->find();
 80: 
 81:         $info->stock = bcadd($info['stock'], $desc);
 82:         $info->seles = max(bcsub($info['seles'], $desc), 0);
 83:         return $info->save();
 84:     }
 85: 
 86:     /**
 87:      *  增加 参与或支付成功 人数
 88:      * @param int $product_presell_id
 89:      * @param string $unique
 90:      * @param string $field
 91:      * @return mixed
 92:      * @author Qinii
 93:      * @day 2020-11-27
 94:      */
 95:     public function incCount(int $product_presell_id,string $unique,string $field,$inc = 1)
 96:     {
 97:         return $this->getModel()::getDB()->where('product_presell_id', $product_presell_id)->where('unique', $unique)
 98:             ->update([
 99:                 $field => Db::raw($field.'+' . $inc)
100:             ]);
101:     }
102: 
103:     /**
104:      *  减少 参与或支付成功 人数
105:      * @param int $product_presell_id
106:      * @param string $unique
107:      * @param string $field
108:      * @return mixed
109:      * @author Qinii
110:      * @day 2020-11-27
111:      */
112:     public function desCount(int $product_presell_id,string $unique,$inc = 1)
113:     {
114:         $res = $this->getModel()::getDB()->where('product_presell_id', $product_presell_id)->where('unique',$unique)->find();
115:         if($res->presell->presell_type == 1 ){
116:             $res->one_pay = ($res->one_pay > 0) ? $res->one_pay - $inc : 0;
117:         }else{
118:             $res->two_pay = ($res->two_pay > 0) ? $res->two_pay - $inc : 0;
119:         }
120:         return $res->save();
121:     }
122: }
