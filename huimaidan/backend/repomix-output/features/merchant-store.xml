 14: namespace app\common\dao\store\coupon;
 15: 
 16: 
 17: use app\common\dao\BaseDao;
 18: use app\common\model\BaseModel;
 19: use app\common\model\store\coupon\StoreCouponUser;
 20: use think\facade\Db;
 21: 
 22: /**
 23:  * Class StoreCouponUserDao
 24:  * @package app\common\dao\store\coupon
 25:  * @author xaboy
 26:  * @day 2020-05-14
 27:  */
 28: class StoreCouponUserDao extends BaseDao
 29: {
 30: 
 31:     /**
 32:      * @return BaseModel
 33:      * @author xaboy
 34:      * @day 2020-03-30
 35:      */
 36:     protected function getModel(): string
 37:     {
 38:         return StoreCouponUser::class;
 39:     }
 40: 
 41:     /**
 42:      * 根据条件搜索优惠券用户信息
 43:      *
 44:      * 该方法通过接收一个包含搜索条件的数组，动态构建查询语句，以搜索符合指定条件的优惠券用户信息。
 45:      * 支持的搜索条件包括用户名、优惠券类型、优惠券名称或ID、状态、用户ID、商家ID、优惠券ID、发送者ID、是否为商家以及状态标签。
 46:      *
 47:      * @param array $where 搜索条件数组，包含各种可能的搜索参数。
 48:      */
 49:     public function search(array $where)
 50:     {
 51:         // 使用查询构建器实例化StoreCouponUser模型
 52:         return StoreCouponUser::when(isset($where['username']) && $where['username'] !== '', function ($query) use ($where) {
 53:             // 如果指定了用户名，则添加对用户昵称的模糊搜索条件
 54:             $query->hasWhere('user', [['nickname', 'LIKE', "%{$where['username']}%"]]);
 55:         })->when(isset($where['coupon_type']) && $where['coupon_type'] !== '', function ($query) use ($where) {
 56:             // 如果指定了优惠券类型，则添加对优惠券类型的条件查询
 57:             $query->hasWhere('coupon', ['type' => $where['coupon_type']]);
 58:         })->alias('StoreCouponUser')->when(isset($where['coupon']) && $where['coupon'] !== '', function ($query) use ($where) {
 59:             // 如果指定了优惠券名称或ID，则添加对优惠券标题的模糊搜索条件
 60:             $query->whereLike('StoreCouponUser.coupon_title', "%{$where['coupon']}%");
 61:         })->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
 62:             // 如果指定了状态，则添加对状态的条件查询
 63:             $query->where('StoreCouponUser.status', $where['status']);
 64:         })->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
 65:             // 如果指定了用户ID，则添加对用户ID的条件查询
 66:             $query->where('StoreCouponUser.uid', $where['uid']);
 67:         })->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
 68:             // 如果指定了商家ID，则添加对商家ID的条件查询
 69:             $query->where('StoreCouponUser.mer_id', $where['mer_id']);
 70:         })->when(isset($where['coupon_id']) && $where['coupon_id'] !== '', function ($query) use ($where) {
 71:             // 如果指定了优惠券ID，则添加对优惠券ID的条件查询
 72:             $query->where('StoreCouponUser.coupon_id', $where['coupon_id']);
 73:         })->when(isset($where['coupon']) && $where['coupon'] !== '', function ($query) use ($where) {
 74:             // 如果再次指定了优惠券名称或ID，则添加对优惠券标题或ID的模糊搜索条件
 75:             $query->whereLike('StoreCouponUser.coupon_title|StoreCouponUser.coupon_id', "%{$where['coupon']}%");
 76:         })->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
 77:             // 如果指定了类型，则添加对类型的条件查询
 78:             $query->where('StoreCouponUser.type', $where['type']);
 79:         })->when(isset($where['send_id']) && $where['send_id'] !== '', function ($query) use ($where) {
 80:             // 如果指定了发送者ID，并且类型为发送，则添加相应的条件查询
 81:             $query->where('StoreCouponUser.send_id', $where['send_id'])->where('StoreCouponUser.type', 'send');
 82:         })->when(isset($where['is_mer']) && $where['is_mer'] !== '', function ($query) use ($where) {
 83:             // 如果指定了是否为商家，则添加对商家ID的非空查询
 84:             $query->where('StoreCouponUser.mer_id', '<>',0);
 85:         })->when(isset($where['statusTag']) && $where['statusTag'] !== '', function ($query) use ($where) {
 86:             // 根据状态标签的不同，添加不同的条件查询，包括未使用的优惠券或在指定时间内使用的优惠券
 87:             if ($where['statusTag'] == 1) {
 88:                 $query->where('StoreCouponUser.status', 0);
 89:             } else {
 90:                 $query->whereIn('StoreCouponUser.status', [1, 2])->where('StoreCouponUser.create_time', '>', date('Y-m-d H:i:s', strtotime('-60 day')));
 91:             }
 92:         })->order('StoreCouponUser.coupon_user_id DESC');
 93:     }
 94: 
 95:     public function validIntersection($merId, $uid, array $ids): array
 96:     {
 97:         $time = date('Y-m-d H:i:s');
 98:         return StoreCouponUser::getDB()->whereIn('coupon_user_id', $ids)->where('start_time', '<', $time)->where('end_time', '>', $time)
 99:             ->where('is_fail', 0)->where('status', 0)->where('mer_id', $merId)->where('uid', $uid)->column('coupon_user_id');
100:     }
101: 
102:     public function validQuery($type)
103:     {
104:         $time = date('Y-m-d H:i:s');
105:         return StoreCouponUser::getDB()
106:             ->when($type, function ($query) use($time){
107:                 $query->where('start_time', '<', $time);
108:             })
109:             ->where('end_time', '>', $time)->where('is_fail', 0)->where('status', 0);
110:     }
111: 
112:     public function failCoupon($uid = 0)
113:     {
114:         $time = date('Y-m-d H:i:s');
115:         $res = StoreCouponUser::getDB()
116:             ->where('end_time', '<', $time)
117:             ->where('is_fail', 0)
118:             ->where('status', 0)
119:             ->when($uid, function($query) use($uid){
120:                 $query->where('uid', $uid);
121:             })
122:             ->update(['status' => 2]);
123:         return $res;
124:     }
125: 
126:     public function userTotal($uid, $type = 1)
127:     {
128:         return $this->validQuery($type)->where('uid', $uid)->count();
129:     }
130: 
131:     public function usedNum($couponId)
132:     {
133:         return StoreCouponUser::getDB()->where('coupon_id', $couponId)->where('status', 1)->count();
134:     }
135: 
136:     public function sendNum($couponId, $sendId = null, $status = null)
137:     {
138:         return StoreCouponUser::getDB()->where('coupon_id', $couponId)->when($sendId, function ($query, $sendId) {
139:             $query->where('type', 'send')->where('send_id', $sendId);
140:         })->when(isset($status), function ($query) use ($status) {
141:             $query->where('status', $status);
142:         })->count();
143:     }
144: 
145:     public function validUserPlatformCoupon($uid)
146:     {
147:         $time = date('Y-m-d H:i:s');
148:         return StoreCouponUser::getDB()->where('uid', $uid)->where('mer_id', 0)->where('start_time', '<', $time)->where('end_time', '>', $time)
149:             ->where('is_fail', 0)->where('status', 0)
150:             ->with(['product' => function ($query) {
151:                 $query->field('coupon_id,product_id');
152:             }, 'coupon' => function ($query) {
153:                 $query->field('coupon_id,type,send_type');
154:             }])->order('coupon_price DESC, coupon_user_id ASC')->select();
155:     }
156:     /**
157:      * 获取用户可用优惠券
158:      *
159:      * @param integer $uid
160:      * @param integer $merId
161:      * @return void
162:      */
163:     public function validUserCoupon(int $uid, int $merId = 0, array $ids = [])
164:     {
165:         $time = date('Y-m-d H:i:s');
166:         $query = StoreCouponUser::getDB()
167:             ->where('uid', $uid)
168:             ->where('start_time', '<', $time)
169:             ->where('end_time', '>', $time)
170:             ->where('is_fail', 0)
171:             ->where('status', 0)
172:             ->with(['product','coupon'])
173:             ->order('coupon_price DESC, coupon_user_id ASC');
174: 
175:         if ($merId) {
176:             $query->whereIn('mer_id', [0, $merId]);
177:         }
178: 
179:         if ($ids) {
180:             $query->whereIn('coupon_user_id', $ids);
181:         }
182: 
183:         return $query->select();
184:     }
185: 
186:     public function clear($id,$field)
187:     {
188:         $this->getModel()::getDB()->where($field, $id)->delete();
189:     }
190: 
191: }
</file>

