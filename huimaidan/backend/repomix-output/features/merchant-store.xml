 971:                 'number' => $groupOrder->give_integral, // 赠送的积分数量
 972:                 'mark' => '成功消费' . floatval($groupOrder['pay_price']) . '元,赠送积分' . floatval($groupOrder->give_integral), // 积分的备注信息，记录消费金额和赠送的积分数量
 973:                 'balance' => $groupOrder->user->integral // 用户当前的积分余额，用于记录积分的变化
 974:             ]);
 975:         }
 976:     }
