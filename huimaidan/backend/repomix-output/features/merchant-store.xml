280:     /**
281:      * 创建服务令牌
282:      *
283:      * 本函数用于生成针对管理员服务的JWT令牌。令牌用于在一段时间内验证请求的合法性。
284:      * 它通过JwtTokenService创建令牌，并将令牌及其过期时间存储到缓存中。
285:      *
286:      * @param StoreService $admin 管理员服务对象，用于获取服务ID，该ID是生成令牌的标识之一。
287:      * @return array 返回包含令牌和过期时间的数组。
288:      */
289:     public function createToken(StoreService $admin)
290:     {
291:         // 实例化JWT令牌服务类
292:         $service = new JwtTokenService();
293: 
294:         // 从配置中获取令牌的过期时间，默认为3小时，转换为整型
295:         $exp = intval(Config::get('admin.token_exp', 3));
296: 
297:         // 使用服务ID、令牌类型和服务过期时间创建令牌
298:         $token = $service->createToken($admin->service_id, 'service', strtotime("+ {$exp}hour"));
299: 
300:         // 将生成的令牌及其过期时间存储到缓存中
301:         $this->cacheToken($token['token'], $token['out']);
302: 
303:         // 返回生成的令牌信息
304:         return $token;
305:     }
306: 
307:     /**
308:      * 缓存令牌
309:      *
310:      * 本函数用于缓存给定的令牌及其过期时间。缓存的目的是为了提高访问效率，
311:      * 避免频繁的数据库查询或计算。令牌通常用于认证或访问控制等场景。
312:      *
313:      * @param string $token 令牌字符串。这是一个唯一标识，用于在缓存中查找或标识缓存项。
314:      * @param int $exp 令牌的过期时间，以秒为单位。这个时间从当前时间开始计算。
315:      */
316:     public function cacheToken(string $token, int $exp)
317:     {
318:         // 构建缓存键名，并设置缓存值为当前时间加上过期时间，过期时间参数再次强调了缓存的持续时间。
319:         Cache::set('service_' . $token, time() + $exp, $exp);
320:     }
321: 
322:     /**
323:      * 检查令牌的有效性
324:      *
325:      * 本函数用于验证传入的令牌是否有效，有效意味着该令牌曾在指定时间内被使用过。
326:      * 它首先检查令牌是否存在于缓存中，如果不存在，则抛出一个授权异常，指出令牌无效。
327:      * 接着，它获取令牌的最后使用时间，并计算令牌自上次使用以来是否已过期。
328:      * 如果令牌过期，同样抛出一个授权异常，指出令牌已过期。
329:      * 这样做的目的是为了确保每个请求的合法性，防止未授权的访问。
330:      *
331:      * @param string $token 待验证的令牌
332:      * @throws AuthException 如果令牌无效或已过期
333:      */
334:     public function checkToken(string $token)
335:     {
336:         // 检查缓存中是否存在该令牌
337:         $has = Cache::has('service_' . $token);
338:         // 如果令牌不存在于缓存中，则抛出无效令牌异常
339:         if (!$has)
340:             throw new AuthException('无效的token');
341: 
342:         // 获取令牌的最后使用时间
343:         $lastTime = Cache::get('service_' . $token);
344:         // 检查令牌是否过期，如果过期则抛出异常
345:         if (($lastTime + (intval(Config::get('admin.token_valid_exp', 15))) * 60) < time())
346:             throw new AuthException('token 已过期');
347:     }
348: 
349:     /**
350:      * 更新令牌的缓存时间
351:      *
352:      * 本函数用于更新特定令牌的缓存时间，确保令牌在一段时间内保持有效。
353:      * 它通过计算配置文件中指定的令牌有效时长（默认为15分钟），并更新缓存来实现。
354:      * 如果令牌在缓存中超时，用户需要重新获取令牌以进行操作。
355:      *
356:      * @param string $token 需要更新缓存时间的令牌字符串
357:      */
358:     public function updateToken(string $token)
359:     {
360:         // 根据配置文件中设定的令牌有效时长（默认15分钟），更新令牌的缓存时间
361:         Cache::set('service_' . $token, time(), intval(Config::get('admin.token_valid_exp', 15)) * 60);
362:     }
363: 
364:     /**
365:      * 清除指定令牌的缓存。
366:      *
367:      * 本函数用于从缓存系统中删除特定标识符的令牌，以实现令牌的有效 令牌通常用于认证或访问控制等场景，因此，及时清除无效的期管理或当令牌不再需要时令牌对于维护系统安全至关重要。
368:      *确保其被安全删除。
369:      *
370:      * @param string $token 需要清除的令牌字符串。
371:      */
372:     public function clearToken(string $token)
373:     {
374:         // 根据令牌生成缓存键名，并删除该缓存项。
375:         Cache::delete('service_' . $token);
376:     }
377: 
378: 
379: 
380:     /**
381:      * 检测验证码
382:      * @param string $key key
383:      * @param string $code 验证码
384:      * @author 张先生
385:      * @date 2020-03-26
386:      */
387:     public function checkCode(string $key, string $code)
388:     {
389:         $_code = Cache::get('ser_captcha' . $key);
390:         if (!$_code) {
391:             throw new ValidateException('验证码过期');
392:         }
393: 
394:         if (strtolower($_code) != strtolower($code)) {
395:             throw new ValidateException('验证码错误');
396:         }
397: 
398:         //删除code
399:         Cache::delete('ser_captcha' . $key);
400:     }
401: 
402:     /**
403:      * 创建登录验证码键
404:      *
405:      * 本函数用于生成一个唯一的登录验证码键，并将该验证码与键关联起来存储在缓存中。
406:      * 验证码键的生成结合了微秒时间和随机数，以确保唯一性。
407:      * 验证码在缓存中的有效期通过配置文件定义，以分钟为单位。
408:      *
409:      * @param string $code 登录验证码
410:      * @return string 生成的验证码键
411:      */
412:     public function createLoginKey(string $code)
413:     {
414:         // 生成一个唯一的验证码键，基于当前微秒时间戳和随机数
415:         $key = uniqid(microtime(true), true);
416: 
417:         // 将验证码与键关联，存储到缓存中，并设定过期时间
418:         // 缓存有效期通过配置文件获取，默认为5分钟
419:         Cache::set('ser_captcha' . $key, $code, Config::get('admin.captcha_exp', 5) * 60);
420: 
421:         // 返回生成的验证码键
422:         return $key;
423:     }
424: }
</file>

