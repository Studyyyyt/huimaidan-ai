 686:     /**
 687:      *  订单多个商品，全部退款操作
 688:      * @param StoreOrder $order
 689:      * @param array $ids
 690:      * @param $uid
 691:      * @param array $data
 692:      * @return mixed
 693:      * @throws DataNotFoundException
 694:      * @throws DbException
 695:      * @throws ModelNotFoundException
 696:      * @author xaboy
 697:      * @day 2020/6/17
 698:      */
 699:     public function refunds(StoreOrder $order, array $ids, $uid, array $data, $refund_switch = 1, $nums = [])
 700:     {
 701:         $orderId  = $order->order_id;
 702:         $products = app()->make(StoreOrderProductRepository::class)->userRefundProducts($ids, $uid, $orderId, $refund_switch);
 703:         if (!$products || count($ids) != count($products))
 704:             throw new ValidateException('请选择正确的退款商品');
 705:         $productRefundPrices      = app()->make(StoreRefundProductRepository::class)->userRefundPrice($ids);
 706:         $totalRefundPrice         = 0;
 707:         $totalRefundNum           = 0;
 708:         $total_extension_one      = 0;
 709:         $total_extension_two      = 0;
 710:         $totalIntegral            = 0;
 711:         $totalPlatformRefundPrice = 0;
 712:         $totalPostage             = 0;
 713:         $refundProduct            = [];
 714:         $refund_order_id          = 0;
 715:         foreach ($products as $product) {
 716:             $productRefundPrice = $productRefundPrices[$product['order_product_id']] ?? [];
 717:             if ($product['extension_one'] > 0)
 718:                 $total_extension_one = bcadd($total_extension_one, bcmul($product['refund_num'], $product['extension_one'], 2), 2);
 719:             if ($product['extension_two'] > 0)
 720:                 $total_extension_two = bcadd($total_extension_two, bcmul($product['refund_num'], $product['extension_two'], 2), 2);
 721:             $postagePrice   = (!$order->status || $order->status == 9) ? bcsub($product['postage_price'], $productRefundPrice['refund_postage'] ?? 0, 2) : 0;
 722:             $totalRefundNum += $product['refund_num'];
 723:             $refundPrice    = 0;
 724:             //计算可退金额
 725:             if ($product['product_price'] > 0) {
 726:                 $refundPrice = bcsub($product['product_price'], bcsub($productRefundPrice['refund_price'] ?? 0, $productRefundPrice['refund_postage'] ?? 0, 2), 2);
 727:             }
 728:             $platform_refund_price = 0;
 729:             //计算退的平台优惠券金额
 730:             if ($product['platform_coupon_price'] > 0) {
 731:                 $platform_refund_price = bcsub($product['platform_coupon_price'], $productRefundPrice['platform_refund_price'] ?? 0, 2);
 732:             }
 733:             $integral = 0;
 734:             if ($product['integral'] > 0) {
 735:                 $integral = bcsub($product['integral_total'], $productRefundPrice['refund_integral'] ?? 0, 0);
 736:             }
 737: 
 738:             $totalPostage             = bcadd($totalPostage, $postagePrice, 2);
 739:             $totalRefundPrice         = bcadd($totalRefundPrice, $refundPrice, 2);
 740:             $totalPlatformRefundPrice = bcadd($totalPlatformRefundPrice, $platform_refund_price, 2);
 741:             $totalIntegral            = bcadd($totalIntegral, $integral, 2);
 742: 
 743:             $refundProduct[] = [
 744:                 'refund_order_id'       => &$refund_order_id,
 745:                 'refund_num'            => $product['refund_num'],
 746:                 'order_product_id'      => $product['order_product_id'],
 747:                 'platform_refund_price' => $platform_refund_price,
 748:                 'refund_integral'       => $integral,
 749:                 'refund_price'          => $refundPrice,
 750:                 'refund_postage'        => $postagePrice,
 751:             ];
 752:         }
 753:         if($order->order_type == 2) {
 754:             // 已经申请退款的总数量
 755:             $refundTotalNum = 0;
 756:             $refundInfo = $this->getSearch(['order_id' => $order->order_id])->whereIn('status',[0,1,2,3])->with('refundProduct')->select()->toArray();
 757:             foreach($refundInfo as $item) {
 758:                 $refundTotalNum += array_sum(array_column($item['refundProduct'],'refund_num'));
 759:             }
 760:             // 订单总数量
 761:             $orderGroupTotalNum = app()->make(StoreGroupOrderRepository::class)->getSearch(['group_order_id' => $order->group_order_id])->sum('total_num');
 762:             // 如果申请退款的总数量加上当前要退款的数量等于订单分组总数量，说明是全退，同城配送全退才包含运费
 763:             if(bcadd($refundTotalNum, array_sum($nums)) == $orderGroupTotalNum) {
 764:                 $totalPostage = $order->total_postage;
 765:             }
 766:         }
 767:         $data['order_id']              = $products[0]['order_id'];
 768:         $data['uid']                   = $products[0]['uid'];
 769:         $data['mer_id']                = $order['mer_id'];
 770:         $data['refund_order_sn']       = app()->make(StoreOrderRepository::class)->getNewOrderId(StoreOrderRepository::TYPE_SN_REFUND);
 771:         $data['refund_num']            = $totalRefundNum;
 772:         $data['extension_one']         = $total_extension_one;
 773:         $data['extension_two']         = $total_extension_two;
 774:         $data['refund_price']          = bcadd($totalPostage, $totalRefundPrice, 2);
 775:         $data['integral']              = $totalIntegral;
 776:         $data['platform_refund_price'] = $totalPlatformRefundPrice;
 777:         $data['refund_postage']        = $totalPostage;
 778: 
 779:         return Db::transaction(function () use ($refundProduct, $data, $products, $order, &$refund_order_id) {
 780:             event('refund.creates.before', compact('data'));
 781:             $refund          = $this->dao->create($data);
 782:             $refund_order_id = $refund->refund_order_id;
 783:             foreach ($products as $product) {
 784:                 $product->refund_num = 0;
 785:                 $product->is_refund  = 1;
 786:                 $product->save();
 787:             }
 788:             app()->make(StoreRefundProductRepository::class)->insertAll($refundProduct);
 789:             $this->applyRefundAfter($refund, $order);
 790:             return $refund;
 791:         });
 792:     }
