209:     /**
210:      * 批量创建直播商品。
211:      *
212:      * 该方法用于处理批量创建直播商品的逻辑。根据商家商品的属性（是否为直播商品），决定商品的初始状态，并在创建商品后执行相应的后续操作。
213:      * - 如果商品是直播商品，则不推送审核通知，而是将其加入消息队列进行后续处理。
214:      * - 如果商品不是直播商品，则向管理员发送新直播商品审核的通知。
215:      *
216:      * @param string $merId 商家ID，用于标识商品所属的商家。
217:      * @param array $goodsList 商品列表，包含待创建的多个商品的信息。
218:      */
219:     public function batchCreate($merId, array $goodsList)
220:     {
221:         // 根据商家商品属性决定商品的初始状态，0表示待审核，1表示已通过。
222:         $status = request()->merchant()->is_bro_goods == 1 ? 0 : 1;
223: 
224:         // 在数据库事务中处理商品的批量创建，确保数据的一致性。
225:         $ids = Db::transaction(function () use ($goodsList, $status, $merId) {
226:             $ids = [];
227:             foreach ($goodsList as $goods) {
228:                 // 设置商品状态和商家ID，并保存商品。
229:                 $goods['status'] = $status;
230:                 $goods['mer_id'] = $merId;
231:                 $ids[] = $this->dao->create($goods)->broadcast_goods_id;
232:             }
233:             return $ids;
234:         });
235: 
236:         // 遍历创建的商品ID列表，根据商品状态执行不同的后续操作。
237:         foreach ($ids as $id) {
238:             if ($status == 1) {
239:                 // 如果商品状态为已通过，将商品ID推入消息队列，进行后续的直播商品处理。
240:                 Queue::push(ApplyBroadcastGoodsJob::class, $id);
241:             } else {
242:                 // 如果商品状态为待审核，向管理员发送新直播商品审核的通知。
243:                 SwooleTaskService::admin('notice', [
244:                     'type' => 'new_goods',
245:                     'data' => [
246:                         'title' => '新直播商品申请',
247:                         'message' => '您有1个新的直播商品审核，请及时处理！',
248:                         'id' => $id
249:                     ]
250:                 ]);
251:             }
252:         }
253:     }
