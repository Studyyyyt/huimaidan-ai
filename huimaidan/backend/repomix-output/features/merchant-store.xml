 71:                 unset($item['discountsProduct']);
 72:                 // 处理活动产品的SKU，得到活动产品的数据和价格
 73:                 $res = activeProductSku($discountsProduct, 'discounts');
 74:                 // 计算关联的活动产品数量
 75:                 $item['count'] = count($res['data']);
 76:                 // 计算产品ID字符串中包含的产品数量
 77:                 $count = count(explode(',',$item['product_ids']));
 78:                 // 根据API的类型和产品数量，决定是否将该API添加到最终列表中
 79:                 if ((!$item['type'] && $count == $item['count']) || ($item['type'] && $count > 0)) {
 80:                     // 设置最大价格
 81:                     $item['max_price'] = $res['price'];
 82:                     // 设置关联的活动产品信息
 83:                     $item['discountsProduct'] = $res['data'];
 84:                     // 将API信息添加到最终列表中
 85:                     if (count($list) < $limit)
 86:                     $list[] = $item;
 87:                 }
 88:             }
 89:         }
