23:      * @param dao $dao
24:      */
25:     public function __construct(dao $dao)
26:     {
27:         $this->dao = $dao;
28:     }
29: 
30:     /**
31:      * 检查商家是否存在指定的运输模板。
32:      *
33:      * 本函数用于确认一个商家是否拥有特定ID的运输模板。它首先通过ID从数据访问对象（DAO）获取模板信息，
34:      * 然后利用依赖注入获取ShippingTemplateRepository实例，通过这个实例来检查商家是否存在指定的模板ID。
35:      * 这种设计模式使得代码更加灵活，易于维护和测试。
36:      *
37:      * @param int $merId 商家ID，用于确认商家身份。
38:      * @param int $id 指定的运输模板ID，需要确认商家是否拥有这个模板。
39:      * @return bool 如果商家存在指定的运输模板，则返回true，否则返回false。
40:      */
41:     public function merExists($merId , $id)
42:     {
43:         // 通过ID从DAO获取模板信息
44:         $result = $this->dao->get($id);
45: 
46:         // 通过依赖注入创建ShippingTemplateRepository实例
47:         $make = app()->make(ShippingTemplateRepository::class);
48: 
49:         // 如果模板信息存在，则检查商家是否存在指定的模板ID
50:         if ($result)
51:             return $make->merExists($merId,$result['temp_id']);
52: 
53:         // 如果模板信息不存在，则直接返回false
54:         return false;
55:     }
56: 
57:     /**
58:      * 更新或创建运输模板未送达地址信息。
59:      *
60:      * 根据传入的$id和$data，如果$data中包含shipping_template_undelivery_id字段且不为空，
61:      * 则将city_id字段合并为字符串，并更新对应的运输模板未送达地址信息。
62:      * 如果$data中不包含shipping_template_undelivery_id字段，则认为是新建记录，
63:      * 将$id赋值给temp_id字段，并创建新的运输模板未送达地址信息。
64:      *
65:      * @param int $id 运输模板的ID。
66:      * @param array $data 包含运输模板未送达地址信息的数据数组。
67:      */
68:     public function update($id,$data)
69:     {
70:         // 检查$data中是否包含shipping_template_undelivery_id且不为空
71:         if(isset($data['shipping_template_undelivery_id']) && $data['shipping_template_undelivery_id']){
72:             // 将city_id数组转换为字符串格式，用于更新操作
73:             $data['city_id'] = implode('/',$data['city_id']);
74:             // 更新已存在的运输模板未送达地址信息
75:             $this->dao->update($data['shipping_template_undelivery_id'],$data);
76:         }else{
77:             // 为新记录设置temp_id字段
78:             $data['temp_id'] = $id;
79:             // 创建新的运输模板未送达地址信息
80:             $this->dao->create($data);
81:         }
82:     }
83: 
84: 
85: 
86: }
