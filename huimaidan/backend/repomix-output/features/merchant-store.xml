102:             $field = 'uid';
103:         }
104: 
105:         // 根据是否发送给所有用户，构建查询条件并执行查询
106:         if ($data['is_all']) {
107:             $query = $userMerchantRepository->search($where + $data['search']);
108:         } else {
109:             $query = $userMerchantRepository->search($where + ['uids' => $data['uid']]);
110:         }
111: 
112:         // 获取查询结果中的用户ID列表
113:         $uid = $query->column($field);
114:         $uTotal = count($uid);
115:         // 如果没有选择用户，则抛出异常
116:         if (!$uTotal) {
117:             throw new ValidateException('请选择用户');
118:         }
119: 
120:         // 如果优惠券有限制且剩余数量不足，则抛出异常
121:         if ($coupon['is_limited'] && $coupon->remain_count < $uTotal) {
122:             throw new ValidateException('该优惠券可领取数不足' . $uTotal);
123:         }
124: 
125:         // 在数据库事务中执行发送操作
126:         return Db::transaction(function () use ($uid, $merId, $data, $coupon, $uTotal) {
127:             $search = $data['mark'];
128:             // 如果优惠券有限制，则更新优惠券的剩余数量
129:             if($coupon['is_limited']){
130:                 $coupon->remain_count -= $uTotal;
131:             }
132:             // 创建优惠券发送记录
133:             $send = $this->dao->create([
134:                 'mer_id' => $merId,
135:                 'coupon_id' => $coupon->coupon_id,
136:                 'coupon_num' => $uTotal,
137:                 'status' => 0,
138:                 'mark' => [
139:                     'type' => $data['is_all'],
140:                     'search' => count($search) ? $search : null
141:                 ]
142:             ]);
143:             // 保存更新后的优惠券信息
144:             $coupon->save();
145:             // 缓存发送的优惠券ID和用户ID列表
146:             Cache::store('file')->set('_send_coupon' . $send->coupon_send_id, $uid);
147:             // 将发送任务推入队列
148:             Queue::push(MerchantSendCouponJob::class, $send->coupon_send_id);
149:             // 返回发送任务的信息
150:             return $send;
151:         });
152:     }
153: 
154: }
