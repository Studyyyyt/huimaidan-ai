250:                 $query->field('mer_id,mer_avatar,mer_name,status');
251:             }])
252:             ->where('mer_id', $is_sys ? '=' : '>',0)
253:             ->order('mer_id '. ($is_sys ? 'ASC' : 'DESC'))
254:             ->select()
255:             ->hidden(['pwd'])
256:             ->toArray();
257: 
258:         // 获取系统配置，用于填充默认商户信息
259:         $config = systemConfig(['site_logo', 'site_name']);
