 12: namespace app\common\repositories\store\order;
 13: 
 14: use app\common\dao\store\order\StoreOrderDao;
 15: use app\common\model\store\order\StoreOrder;
 16: use crmeb\services\LockService;
 17: use think\exception\ValidateException;
 18: use think\facade\Db;
 19: 
 20: /**
 21:  * Class StoreOrderSplitRepository
 22:  * @package app\common\repositories\store\order
 23:  * @author xaboy
 24:  * @day 2022/3/10
 25:  * @mixin StoreOrderDao
 26:  */
 27: class StoreOrderSplitRepository extends StoreOrderRepository
 28: {
 29: 
 30:     /**
 31:      * 分拆订单
 32:      *
 33:      * 本函数用于将一个订单按照指定的规则进行分拆处理。它首先构建一个锁服务的实例，以确保订单分拆的操作是原子性的，
 34:      * 避免并发操作导致的数据不一致问题。然后，通过调用内部的execSplitOrder方法，实际执行订单的分拆逻辑。
 35:      *
 36:      * @param StoreOrder $order 待分拆的订单对象
 37:      * @param array $rule 分拆规则，具体结构和内容根据业务需求定义
 38:      * @param int $service_id 服务ID，用于指定特定的服务进行订单分拆，默认为0，表示使用默认服务
 39:      * @param null $type 分拆类型，用于指定订单分拆的具体类型，可为空，具体含义根据业务需求定义
 40:      * @return mixed 返回订单分拆操作的结果，具体类型和结构根据业务逻辑而定
 41:      */
 42:     public function splitOrder(StoreOrder $order, array $rule, $service_id = 0,$type = null)
 43:     {
 44:         // 使用依赖注入获取锁服务实例，并执行订单分拆的锁定操作
 45:         return app()->make(LockService::class)->exec('order.split.' . $order->order_id, function () use ($rule, $order,$service_id,$type) {
 46:             // 调用内部方法实际执行订单分拆逻辑
 47:             return $this->execSplitOrder($order, $rule, $service_id,$type);
 48:         });
 49:     }
 50: 
 51:     /**
 52:      * 执行订单拆分
 53:      *
 54:      * @param StoreOrder $order 待拆分的订单
 55:      * @param array $rule 拆分规则，指定每个订单产品的拆分数量
 56:      * @param int $service_id 服务ID，用于记录服务日志（可选）
 57:      * @param null $type 订单类型，用于处理特定类型的订单（可选）
 58:      * @return mixed 返回新创建的订单
 59:      * @throws ValidateException 如果订单状态不正确或拆分规则不满足条件，抛出验证异常
 60:      */
 61:     public function execSplitOrder(StoreOrder $order, array $rule, $service_id = 0, $type = null)
 62:     {
 63:         if ($order['status'] != 0) {
 64:             throw new ValidateException('订单已发货');
 65:         }
 66:         if ($order['activity_type'] == 2 && !$type) {
 67:             throw new ValidateException('预售订单不能拆单');
 68:         }
 69:         return Db::transaction(function () use ($order, $rule,$service_id) {
 70:             $newOrderId = 0;
 71:             $newOrder = $order->getOrigin();
 72:             $newOrder['total_num'] = 0;
 73:             $newOrder['total_price'] = 0;
 74:             $newOrder['total_postage'] = 0;
 75:             $newOrder['pay_price'] = 0;
 76:             $newOrder['pay_postage'] = 0;
 77:             $newOrder['extension_one'] = 0;
 78:             $newOrder['extension_two'] = 0;
 79:             $newOrder['coupon_price'] = 0;
 80:             $newOrder['platform_coupon_price'] = 0;
 81:             $newOrder['svip_discount'] = 0;
 82:             $newOrder['cost'] = 0;
 83:             $newOrder['integral_price'] = 0;
 84:             $newOrder['integral'] = 0;
 85:             $newOrder['give_integral'] = 0;
 86:             $newOrder['coupon_id'] = '';
 87: 
 88:             $inserts = [];
 89: 
 90:             $flag = false;
 91: 
 92:             foreach ($order['orderProduct'] as $product) {
 93:                 if (!isset($rule[$product['order_product_id']])) {
 94:                     if ($product['refund_num'] > 0) {
 95:                         $flag = true;
 96:                     }
 97:                     continue;
 98:                 }
 99:                 $num = (int)$rule[$product['order_product_id']];
100:                 if ($num <= 0) {
101:                     throw new ValidateException('数量必须大于0');
102:                 }
103:                 if ($num > $product['refund_num']) {
104:                     throw new ValidateException('商品超出最大数量');
105:                 }
106:                 if ($num != $product['refund_num']) {
107:                     $flag = true;
108:                 }
109:             }
110: 
111:             if (!$flag) {
112:                 return $flag;
113:                 //throw new ValidateException('商品不能全部拆单');
114:             }
115: 
116:             foreach ($order['orderProduct'] as $product) {
117:                 if (!isset($rule[$product['order_product_id']])) continue;
118:                 $num = (int)$rule[$product['order_product_id']];
119: 
120:                 $newProduct = $product->getOrigin();
121:                 unset($newProduct['order_product_id'], $newProduct['create_time']);
122:                 $newProduct['order_id'] = &$newOrderId;
123:                 $newProduct['is_refund'] = 0;
124:                 $newProduct['is_reply'] = 0;
125: 
126:                 if ($product['product_num'] == $num && !$product['is_refund']) {
127:                     $product->delete();
128:                 } else {
129:                     $newProduct['product_num'] = $num;
130:                     $newProduct['refund_num'] = $num;
131: 
132:                     if (!$product['refund_num'] && $product['is_refund'] == 2) {
133:                         $product['is_refund'] = 3;
134:                     }
135: 
136:                     $newProduct['product_price'] = $product['product_price'] > 0 ? round(bcmul(bcdiv($product['product_price'], $product['product_num'], 3), $num, 3), 2) : 0;
137:                     $newProduct['total_price'] = $product['total_price'] > 0 ? round(bcmul(bcdiv($product['total_price'], $product['product_num'], 2), $num, 2), 2) : 0;
138:                     $newProduct['extension_one'] = $product['extension_one'];
139:                     $newProduct['extension_two'] = $product['extension_two'];
140:                     $newProduct['coupon_price'] = $product['coupon_price'] > 0 ? bcmul(bcdiv($product['coupon_price'], $product['product_num'], 2), $num, 2) : 0;
141:                     $newProduct['svip_discount'] = $product['svip_discount'] > 0 ? bcmul(bcdiv($product['svip_discount'], $product['product_num'], 2), $num, 2) : 0;
142:                     $newProduct['integral_price'] = $product['integral_price'] > 0 ? bcmul(bcdiv($product['integral_price'], $product['product_num'], 2), $num, 2) : 0;
143:                     $newProduct['platform_coupon_price'] = $product['platform_coupon_price'] > 0 ? bcmul(bcdiv($product['platform_coupon_price'], $product['product_num'], 2), $num, 2) : 0;
144:                     $newProduct['postage_price'] = $product['postage_price'] > 0 ? bcmul(bcdiv($product['postage_price'], $product['product_num'], 2), $num, 2) : 0;
145:                     $newProduct['integral_total'] = $product['integral_total'] > 0 ? floor(bcmul(bcdiv($product['integral_total'], $product['integral_total'], 2), $num, 0)) : 0;
146: 
147:                     $product['product_price'] = $product['product_price'] > 0 ? bcsub($product['product_price'], $newProduct['product_price'], 2) : 0;
148:                     $product['total_price'] = $product['total_price'] > 0 ? bcsub($product['total_price'], $newProduct['total_price'], 2) : 0;
149:                     $product['coupon_price'] = $product['coupon_price'] > 0 ? bcsub($product['coupon_price'], $newProduct['coupon_price'], 2) : 0;
150:                     $product['svip_discount'] = $product['svip_discount'] > 0 ? bcsub($product['svip_discount'], $newProduct['svip_discount'], 2) : 0;
151:                     $product['integral_price'] = $product['integral_price'] > 0 ? bcsub($product['integral_price'], $newProduct['integral_price'], 2) : 0;
152:                     $product['platform_coupon_price'] = $product['platform_coupon_price'] > 0 ? bcsub($product['platform_coupon_price'], $newProduct['platform_coupon_price'], 2) : 0;
153:                     $product['postage_price'] = $product['postage_price'] > 0 ? bcsub($product['postage_price'], $newProduct['postage_price'], 2) : 0;
154:                     $product['integral_total'] = $product['integral_total'] > 0 ? bcsub($product['integral_total'], $newProduct['integral_total'], 0) : 0;
155: 
156:                     $product['product_num'] -= $num;
157:                     $product['refund_num'] -= $num;
158: 
159:                     $product->save();
160:                 }
161: 
162:                 $give_integral = $order['give_integral'] > 0 ? floor(bcmul(bcdiv($newProduct['product_price'], $order['pay_price'], 2), $order['give_integral'], 0)) : 0;
163:                 $extension_one = $newProduct['extension_one'] > 0 ? bcmul($newProduct['extension_one'], $num, 2) : 0;
164:                 $extension_two = $newProduct['extension_two'] > 0 ? bcmul($newProduct['extension_two'], $num, 2) : 0;
165:                 $order['total_num'] -= $newProduct['product_num'];
166:                 $order['total_price'] = $order['total_price'] > 0 ? bcsub($order['total_price'], $newProduct['total_price'], 2) : 0;
167:                 $order['total_postage'] = $order['total_postage'] > 0 ? bcsub($order['total_postage'], $newProduct['postage_price'], 2) : 0;
168:                 $order['pay_postage'] = $order['total_postage'];
169:                 $order['extension_one'] = $order['extension_one'] > 0 ? bcsub($order['extension_one'], $extension_one, 2) : 0;
170:                 $order['extension_two'] = $order['extension_two'] > 0 ? bcsub($order['extension_two'], $extension_two, 2) : 0;
171:                 $order['svip_discount'] = $order['svip_discount'] > 0 ? bcsub($order['svip_discount'], $newProduct['svip_discount'], 2) : 0;
172:                 $order['coupon_price'] = $order['coupon_price'] > 0 ? bcsub($order['coupon_price'], $newProduct['coupon_price'], 2) : 0;
173:                 $order['coupon_price'] = $order['platform_coupon_price'] > 0 ? bcsub($order['coupon_price'], $newProduct['platform_coupon_price'], 2) : $order['coupon_price'];
174:                 $order['platform_coupon_price'] = $order['platform_coupon_price'] > 0 ? bcsub($order['platform_coupon_price'], $newProduct['platform_coupon_price'], 2) : 0;
175:                 $order['cost'] = $order['cost'] > 0 ? bcsub($order['cost'], $newProduct['cost'], 2) : 0;
176:                 $order['integral_price'] = $order['integral_price'] > 0 ? bcsub($order['integral_price'], $newProduct['integral_price'], 2) : 0;
177:                 $order['integral'] = $order['integral'] > 0 ? bcsub($order['integral'], $newProduct['integral_total'], 2) : 0;
178:                 $order['give_integral'] = ($order['give_integral'] > 0 && $newProduct['total_price'] > 0) ? bcsub($order['give_integral'], $give_integral, 0) : 0;
179:                 $order['pay_price'] = $order['pay_price'] > 0 ? bcsub($order['pay_price'], $newProduct['product_price'], 2) : 0;
180: 
181:                 $newOrder['total_num'] += $newProduct['product_num'];
182:                 $newOrder['total_price'] = bcadd($newOrder['total_price'], $newProduct['total_price'], 2);
183:                 $newOrder['total_postage'] = bcadd($newOrder['total_postage'], $newProduct['postage_price'], 2);
184:                 $newOrder['pay_postage'] = $newOrder['total_postage'];
185:                 $newOrder['extension_one'] = bcadd($newOrder['extension_one'], $extension_one, 2);
186:                 $newOrder['extension_two'] = bcadd($newOrder['extension_two'], $extension_two, 2);
187:                 $newOrder['svip_discount'] = bcadd($newOrder['svip_discount'], $newProduct['svip_discount'], 2);
188:                 $newOrder['coupon_price'] = bcadd($newOrder['coupon_price'], $newProduct['coupon_price'], 2);
189:                 $newOrder['coupon_price'] = bcadd($newOrder['coupon_price'], $newProduct['platform_coupon_price'], 2);
190:                 $newOrder['platform_coupon_price'] = bcadd($newOrder['platform_coupon_price'], $newProduct['platform_coupon_price'], 2);
191:                 $newOrder['cost'] = bcadd($newOrder['cost'], $newProduct['cost'], 2);
192:                 $newOrder['integral_price'] = bcadd($newOrder['integral_price'], $newProduct['integral_price'], 2);
193:                 $newOrder['integral'] = bcadd($newOrder['integral'], $newProduct['integral_total'], 2);
194:                 $newOrder['give_integral'] = bcadd($newOrder['give_integral'], $give_integral, 2);
195:                 $newOrder['pay_price'] = bcadd($newOrder['pay_price'], $newProduct['product_price'], 2);
196: 
197:                 $inserts[] = $newProduct;
198:             }
199: 
200:             if (!count($inserts)) {
201:                 throw new ValidateException('请选择需拆出的商品');
202:             }
203: 
204:             $newOrder['pay_price'] = bcadd($newOrder['pay_price'], $newOrder['pay_postage'], 2);
205:             $order['pay_price'] = bcsub($order['pay_price'], $newOrder['pay_postage'], 2);
206:             $newOrder['order_sn'] = explode('-', $newOrder['order_sn'])[0] . ('-' . ($this->getSearch([])->where('main_id', $order['order_id'])->count() + 1));
207:             $newOrder['main_id'] = $order['main_id'] ?: $order['order_id'];
208:             if ($newOrder['verify_code']) {
209:                 $newOrder['verify_code'] = $this->verifyCode();
210:             }
211:             unset($newOrder['order_id']);
212:             $newOrder = $this->create($newOrder);
213:             $newOrderId = $newOrder['order_id'];
214:             app()->make(StoreOrderProductRepository::class)->insertAll($inserts);
215: 
216:             $flag = true;
217:             foreach ($order['orderProduct'] as $product) {
218:                 $flag = $flag && $product['is_refund'] == 3;
219:             }
220:             if ($flag) {
221:                 $order['status'] = -1;
222:             }
223:             $order->save();
224:             if ($flag) {
225:                 $this->orderRefundAllAfter($order);
226:             }
227:             $statusRepository = app()->make(StoreOrderStatusRepository::class);
228:             $orderStatus = [
229:                 'order_id' => $order->order_id,
230:                 'order_sn' => $order->order_sn,
231:                 'type' => $statusRepository::TYPE_ORDER,
232:                 'change_message' => '生成子订单：'.$newOrder->order_sn,
233:                 'change_type' => $statusRepository::ORDER_STATUS_SPLIT,
234:             ];
235:             $newOrderStatus = [
236:                 'order_id' => $newOrder->order_id,
237:                 'order_sn' => $newOrder->order_sn,
238:                 'type' => $statusRepository::TYPE_ORDER,
239:                 'change_message' => '生成子订单',
240:                 'change_type' => $statusRepository::ORDER_STATUS_SPLIT,
241:             ];
242: 
243:             if ($service_id) {
244:                 $statusRepository->createServiceLog($service_id,$orderStatus);
245:                 $statusRepository->createServiceLog($service_id,$newOrderStatus);
246:             } else {
247:                 $statusRepository->createAdminLog($orderStatus);
248:                 $statusRepository->createAdminLog($newOrderStatus);
249:             }
250:             return $newOrder;
251:         });
252:     }
253: }
