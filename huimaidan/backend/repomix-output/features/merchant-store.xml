211:      * @param ProductGroupBuying $res
212:      * @author Qinii
213:      * @day 1/14/21
214:      */
215:     public function successChange(ProductGroupBuying $res)
216:     {
217:         $res->status = 10;
218:         $res->save();
219:         app()->make(ProductGroupRepository::class)->incField($res['product_group_id'], 'success_num', 1);
220:         $productGroupUserRepository = app()->make(ProductGroupUserRepository::class);
