592:      *
593:      * 该方法用于更新商品的预售价状态，并触发相应的事件。
594:      * 它首先验证数据存在性，然后更新数据，并发送通知给相关的商户。
595:      * 主要用于处理商品的上架、下架以及审核状态的变更。
596:      *
597:      * @param int $id 商品ID
598:      * @param array $data 包含商品状态的数据
599:      * @throws ValidateException 如果商品数据不存在
600:      */
601:     public function switchStatus($id, $data)
602:     {
603:         // 将状态值复制到product_status字段，以保持数据一致性
604:         $data['product_status'] = $data['status'];
605: 
606:         // 尝试获取商品信息
607:         $ret = $this->dao->get($id);
608:         // 如果商品信息不存在，则抛出异常
609:         if (!$ret)
610:             throw new ValidateException('数据不存在');
611: 
612:         // 在更新商品状态前触发预售状态变更的前置事件
613:         event('product.presellStatus.before', compact('id', 'data'));
614: 
615:         // 更新商品状态
616:         $this->dao->update($id, $data);
617: 
618:         // 在更新商品状态后触发预售状态变更的事件
619:         event('product.presellStatus', compact('id', 'data'));
620: 
621:         // 根据商品状态确定通知类型
622:         $type = ProductRepository::NOTIC_MSG[$data['status']][2];
623:         // 构造通知消息
624:         $message = '您有1个预售'. ProductRepository::NOTIC_MSG[$data['status']]['msg'];
625: 
626:         // 发送通知给商户
627:         SwooleTaskService::merchant('notice', [
628:             'type' => $type,
629:             'data' => [
630:                 'title' => $data['status'] == -2 ? '下架提醒' : '审核结果',
631:                 'message' => $message,
632:                 'id' => $id
633:             ]
634:         ], $ret->mer_id);
635: 
636:         // 更新SPU的状态
637:         app()->make(SpuRepository::class)->changeStatus($id,2);
638:     }
639: }
