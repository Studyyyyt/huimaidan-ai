157:     /**
158:      *  APi秒杀时间列表
159:      * @return array
160:      * @author Qinii
161:      * @day 2020-08-11
162:      */
163:     public function selectTime()
164:     {
165:         $seckillTimeIndex = 0;
166:         $_h = date('H',time());
167:         $query = $this->dao->search(['status' => 1]);
168:         $list = $query->select();
169:         $seckillEndTime = time();
170:         $seckillTime = [];
171:         foreach($list as $k => $item){
172:             $item['stop'] = strtotime((date('Y-m-d ',time()).$item['end_time'].':00:00'));
173:             if($item['end_time'] <= $_h) {
174:                 $item['pc_status'] = 0;
175:                 $item['state'] = '已结束';
176:             }
177:             if($item['start_time'] > $_h ) {
178:                 $item['pc_status'] = 2;
179:                 $item['state'] = '待开始';
180:             }
181:             if($item['start_time'] <= $_h && $_h < $item['end_time']){
182:                 $item['pc_status'] = 1;
183:                 $item['state'] = '抢购中';
184:                 $seckillTimeIndex = $k;
185:                 $seckillEndTime = strtotime((date('Y-m-d ',time()).$item['end_time'].':00:00'));
186:                 $item['stop_time'] = date('Y-m-d H:i:s', $seckillEndTime);
187:             }
188:             $seckillTime[$k] = $item;
189:         }
190:         return  compact('seckillTime','seckillTimeIndex','seckillEndTime');
