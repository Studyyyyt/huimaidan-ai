107:     /**
108:      * 检测是否每个sku的预售价格
109:      * @param array $data
110:      * @param int $presellType
111:      * @return array
112:      * @author Qinii
113:      * @day 2020-10-12
114:      */
115:     public function sltSku(array $data, int $presellId, int $productId)
116:     {
117:         $make = app()->make(ProductAttrValueRepository::class);
118:         $sku = [];
119:         $price = 0;
120:         foreach ($data['attrValue'] as $item) {
121:             if ($item['product_id'] != $productId)  throw new ValidateException('商品ID不一致');
122:             $skuData = $make->getWhere(['unique' => $item['unique'], 'product_id' => $productId]);
123:             if (!$skuData) throw new ValidateException('SKU不存在');
124:             if (bccomp($item['presell_price'], $skuData['price'], 2) == 1) throw new ValidateException('预售价格不得大于原价');
125:             if (!$item['presell_price'] || $item['presell_price'] < 0) throw new ValidateException('请正确填写预售金额');
126:             if ($data['presell_type'] == 2) {
127:                 if (!$item['down_price'] || $item['down_price'] < 0) throw new ValidateException('请正确填写订金金额');
128:                 $_price = bccomp($item['down_price'], bcmul($item['presell_price'], 0.2, 2), 2);
129:                 if ($_price == 1) throw new ValidateException('订金金额不得超过预售价20%');
130:             }
131:             $sku[] = [
132:                 'product_presell_id' => $presellId,
133:                 'product_id' => $data['product_id'],
134:                 'unique' => $item['unique'],
135:                 'stock' => $item['stock'],
136:                 'stock_count' => $item['stock'],
137:                 'presell_price' => $item['presell_price'],
138:                 'down_price' => $data['presell_type'] == 1 ? $item['presell_price'] :  $item['down_price'],
139:                 'final_price' => bcsub($item['presell_price'], $item['down_price'], 2)
140:             ];
141:             $price = ($price == 0) ? $item['presell_price'] : (($price > $item['presell_price']) ? $item['presell_price'] : $price);
142:         }
143:         return compact('sku', 'price');
144:     }
