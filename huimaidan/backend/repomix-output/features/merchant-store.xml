556:     /**
557:      * 更新SPU的排序信息。
558:      *
559:      * 该方法用于根据提供的ID和可选的商户ID来更新SPU的排序信息。它首先根据ID和可能的商户ID查询数据，
560:      * 如果数据不存在，则抛出一个验证异常。如果数据存在，则会更新产品的相关信息，
561:      * 最后调用另一个方法来更新SPU的排序信息。
562:      *
563:      * @param int $id 主键ID，用于唯一标识SPU。
564:      * @param int|null $merId 商户ID，可选，用于指定特定商户的数据。
565:      * @param array $data 包含更新信息的数据数组。
566:      * @return mixed 返回更新排序后的结果。
567:      * @throws ValidateException 如果数据不存在，则抛出此异常。
568:      */
569:     public function updateSort(int $id, ?int $merId, array $data)
570:     {
571:         // 根据主键ID准备查询条件
572:         $where[$this->dao->getPk()] = $id;
573:         // 如果提供了商户ID，则加入查询条件
574:         if ($merId) $where['mer_id'] = $merId;
575: 
576:         // 根据条件查询数据
577:         $ret = $this->dao->getWhere($where);
578:         // 如果查询结果为空，则抛出异常
579:         if (!$ret) throw new  ValidateException('数据不存在');
580: 
581:         // 更新产品的相关信息
582:         app()->make(ProductRepository::class)->update($ret['product_id'], $data);
583: 
584:         // 制造SPU仓库实例，用于更新SPU的排序信息
585:         $make = app()->make(SpuRepository::class);
586:         // 更新SPU的排序信息，并返回结果
587:         return $make->updateSort($ret['product_id'], $id, 2, $data);
588:     }
