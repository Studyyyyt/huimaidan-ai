  42:     {
  43:         ($this->getModel()::withTrashed()->find($id))->attr()->saveAll($data);
  44:     }
  45: 
  46:     /**
  47:      * 创建属性值
  48:      *
  49:      * 本函数用于根据提供的ID和数据数组创建属性值。它首先检索具有给定ID的模型实体，
  50:      * 然后通过关联方法保存传入的数据数组。这个函数特别处理了软删除的情况，
  51:      * 可以恢复和保存被软删除的模型的属性值。
  52:      *
  53:      * @param int $id 属性值关联模型的ID。这个ID用于定位特定的模型实例。
  54:      * @param array $data 包含要保存的属性值数据的数组。每个元素都应该符合属性值的保存要求。
  55:      */
  56:     public function createAttrValue(int $id, array $data)
  57:     {
  58:         // 使用withTrashed()来包含软删除的记录, find($id)找回指定ID的记录，然后通过attrValue()方法关联属性值，最后使用saveAll()保存数据数组
  59:         ($this->getModel()::withTrashed()->find($id))->attrValue()->saveAll($data);
  60:     }
  61: 
  62:     /**
  63:      * 创建或更新内容信息。
  64:      *
  65:      * 本函数通过给定的ID检索特定的模型实体，即使该实体已被删除（使用withTrashed()确保能检索到软删除的记录）。
  66:      * 然后，它使用关联的方法(content())来保存或更新给定的数据数组到这个实体的内容字段。
  67:      * 这种方法的设计允许在不直接触碰实体本身的情况下，灵活地处理与实体相关的内容数据。
  68:      *
  69:      * @param int $id 模型实体的唯一标识ID，用于检索特定的实体。
