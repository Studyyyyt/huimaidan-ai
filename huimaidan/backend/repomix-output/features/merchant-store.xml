416:      * @return array 创建的商品信息。
417:      */
418:     public function wxCreate($goods)
419:     {
420:         // 检查商品ID是否存在，如果存在则抛出异常
421:         if ($goods['goods_id']) {
422:             throw new ValidateException('商品已创建');
423:         }
424: 
425:         // 将商品对象转换为数组
426:         $goods = $goods->toArray();
427: 
428:         // 创建微信小程序服务实例
429:         $miniProgramService = MiniProgramService::create();
430: 
431:         // 下载商品封面图片并获取其路径
432:         $path = './public' . app()->make(DownloadImageService::class)->downloadImage($goods['cover_img'],'def','',1)['path'];
433: 
434:         // 准备创建商品所需的数据
435:         $data = [
436:             'name' => $goods['name'],
437:             'priceType' => 1,
438:             'price' => floatval($goods['price']),
439:             'url' => 'pages/goods_details/index?source=1:' . $goods['broadcast_goods_id'] . ':' . $goods['product_id'] . '&id=' . $goods['product_id'],
440:             'coverImgUrl' => $miniProgramService->material()->uploadImage($path)->media_id,
441:         ];
442: 
443:         // 删除本地临时图片文件
444:         @unlink($path);
445: 
446:         try {
447:             // 在微信小程序中创建商品并返回创建的商品信息
448:             return $miniProgramService->miniBroadcast()->create($data);
449:         } catch (Exception $e) {
450:             // 如果创建失败，则抛出异常，异常信息为微信小程序返回的错误信息
451:             throw new ValidateException($e->getMessage());
