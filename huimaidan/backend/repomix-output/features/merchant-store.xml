187:     /**
188:      * 获取指定商户和用户最后一次服务日志
189:      *
190:      * 本函数通过查询StoreServiceLog模型，找到指定商户(merId)和用户(uid)的最后一次服务日志。
191:      * 它使用了数据库查询语句来过滤结果，并按照service_log_id降序排列，确保返回的是最新的日志记录。
192:      *
193:      * @param string $merId 商户ID，用于指定查询哪个商户的服务日志
194:      * @param string $uid 用户ID，用于指定查询哪个用户的服务日志
195:      * @return array 返回最后一次服务日志的信息，如果不存在则返回空数组
196:      * @throws \think\db\exception\DataNotFoundException
197:      * @throws \think\db\exception\DbException
198:      * @throws \think\db\exception\ModelNotFoundException
199:      */
200:     public function getLastLog($merId, $uid)
201:     {
202:         // 使用where方法指定查询条件，查询指定商户和用户的服务日志
203:         // 并通过order方法按service_log_id降序排列，确保获取最新的日志记录
204:         // 最后使用find方法查找并返回第一条符合条件的数据
205:         return StoreServiceLog::getDB()->where('mer_id', $merId)->where('uid', $uid)->order('service_log_id DESC')->find();
206:     }
207: 
208:     /**
209:      * 获取未读消息数量
210:      * 该方法用于查询特定用户、商家和消息类型的未读消息数量。
211:      * @param $merId 商家ID，用于指定查询哪个商家的消息
212:      * @param $uid 用户ID，用于指定查询哪个用户的消息
213:      * @param $sendType 消息发送类型，用于进一步筛选消息
214:      * @return int 返回未读消息的数量
215:      */
216:     public function getUnReadNum($merId, $uid, $sendType)
217:     {
218:         // 根据传入的参数，使用条件查询未读消息数量
219:         // 其中，查询条件包括用户ID、商家ID、消息发送类型以及消息类型（当sendType为真时查询type，否则查询service_type）
220:         return StoreServiceLog::getDB()->where('uid', $uid)->where('mer_id', $merId)->where('send_type', $sendType)->where($sendType ? 'type' : 'service_type', 0)->count();
221:     }
222: 
223:     /**
224:      * 计算用户未读消息的数量
225:      *
226:      * 本函数用于查询并返回指定用户ID的未读消息总数。未读消息是指发送类型为1，消息类型为0的那些消息。
227:      * 这种统计方式适用于需要区分用户并关注其未读消息数量的场景，例如在商城应用中，用户可能需要知道有多少未读的系统通知。
228:      *
229:      * @param int $uid 用户的唯一标识符。这个参数用于指定查询哪个用户的未读消息数量。
230:      * @return int 返回未读消息的数量。这个数量是根据查询条件计算得出的，只包括发送类型为1，消息类型为0的消息。
231:      */
232:     public function totalUnReadNum($uid)
233:     {
234:         // 使用数据库查询方法，根据条件统计未读消息的数量
235:         return StoreServiceLog::getDB()->where('uid', $uid)->where('send_type', 1)->where('type', 0)->count();
236:     }
237: 
238: }
