2024: 
2025:         if (systemConfig('sys_reply_status')) {
2026:             $product['replayData'] = app()->make(ProductReplyRepository::class)->getReplyRate($product['product_id']);
2027:         }
2028:         $attr = $this->detailAttr($product['attr']);
2029:         $attrValue = (in_array($product['product_type'], [3, 4])) ? $product['oldAttrValue'] : $product['attrValue'];
2030: 
2031:         $sku = $this->detailAttrValue($attrValue, $userInfo, $productType, $activityId);
2032:         $sku = getThumbWaterImage($sku, ['image'], 'small');
2033:         unset($product['attr'], $product['attrValue'], $product['oldAttrValue']);
2034:         if (count($attr) > 1) {
2035:             $firstSku = [];
