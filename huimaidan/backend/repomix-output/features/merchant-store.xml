630:     /**
631:      * 关闭直播相关信息的函数
632:      *
633:      * 本函数用于处理直播间的关闭操作，包括关闭客服、评论、公开性以及商品上架状态的变更。
634:      * 在执行操作前，会检查直播间的审核状态及权限，确保只有在允许的情况下才能进行变更。
635:      * 使用事务确保数据库操作的一致性。
636:      *
637:      * @param int $id 直播间ID
638:      * @param string $type 关闭类型，包括关闭客服（'close_kf'）、关闭评论（'close_comment'）、设置feed是否公开（'is_feeds_public'）和商品上架状态（'on_sale'）
639:      * @param int $status 新的状态值，用于关闭或开启相关功能
640:      * @param bool $check 是否检查平台状态，默认为true。如果平台已关闭，则不允许进行修改。
641:      * @param array $data 当类型为'on_sale'时，需要提供商品相关信息，包括商品ID。
642:      * @throws ValidateException 当直播间状态不正确、数据不存在或操作权限受限时抛出异常。
643:      */
644:     public function closeInfo($id, string $type, int $status, $check = true, $data = [])
645:     {
646:         // 根据ID获取直播间信息
647:         $room = $this->dao->get($id);
648:         // 检查直播间是否已通过审核
649:         if ($room->status !== 2) throw new ValidateException('直播间还未审核通过，无法修改');
650:         // 检查直播间是否存在
651:         if (!$room) throw new ValidateException('数据不存在');
652: 
653:         // 如果需要检查平台状态且直播间对应类型已关闭，则抛出异常
654:         if ($check && $room[$type] == -1) {
655:             throw new ValidateException('平台已关闭，您无法修改');
656:         }
657: 
658:         // 使用事务处理数据库操作
659:         Db::transaction(function () use ($room, $id, $type, $status, $data) {
660:             // 根据类型创建对应的操作客户端
661:             $client = MiniProgramService::create()->miniBroadcast();
662:             // 根据类型执行相应的关闭操作
663:             switch ($type) {
664:                 case 'close_kf':
665:                     // 关闭客服
666:                     $client->closeKf($room->room_id, $status);
667:                     $room->close_kf = $status;
668:                     break;
669:                 case 'close_comment':
670:                     // 关闭评论
671:                     $client->banComment($room->room_id, $status);
672:                     $room->close_comment = $status;
673:                     break;
674:                 case 'is_feeds_public':
675:                     // 设置feed公开性
676:                     $client->updateFeedPublic($room->room_id, $status);
677:                     $room->is_feeds_public = $status;
678:                     break;
679:                 case 'on_sale':
680:                     // 商品上架状态变更
681:                     $ret = app()->make(BroadcastRoomGoodsRepository::class)->getWhere([
682:                         'broadcast_room_id' => $id,
683:                         'broadcast_goods_id' => $data['goods_id'],
684:                     ], '*', ['goods']);
685:                     // 检查商品是否存在
686:                     if (!isset($ret['goods']['goods_id'])) throw new ValidateException('数据不存在');
687:                     // 更新商品上架状态
688:                     $ret->on_sale = $status;
689:                     $ret->save();
690:                     // 商品上架或下架
691:                     $client->goodsOnsale($room->room_id, $ret['goods']['goods_id'], $status);
692:                     break;
693:             }
694:             // 更新直播间信息
695:             $room->save();
696:         });
697:     }
