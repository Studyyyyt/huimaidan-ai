130:                  $sql = ['delivery_name' => 'D', 'delivery_id' => 'E',];
131:                  $where = ['order_sn' => 'B',];
132:                  $data['data'] = SpreadsheetExcelService::instance()->_import($path, $sql, $where, 4);
133:                  if(!empty($data['data'] )){
134:                      $res = $this->repository->create($this->request->merId(),'delivery');
135:                      $data['path'] = $path;
136:                      $data['import_id'] = $res->import_id;
137:                      $data['mer_id'] = $this->request->merId();
138:                      Queue::push(ImportSpreadsheetExcelJob::class,$data);
139:                      return app('json')->success('开始导入数据，请稍后在批量发货记录中查看！');
140:                  }
141:                 break;
142:             case 'cdkey':
143:                 $data['library_id'] = $this->request->param('library_id');
144:                 if (!$data['library_id'])  return app('json')->fail('缺少卡密库 ID');
145:                 $spreadsheet->checkImport($path,['B1' => '卡号','C1' => '卡密']);
146:                 $csList = $spreadsheet->_import($path,['key' => 'B','pwd' => 'C'],[],2);
147:                 $data['csList'] = array_column($csList,'value');
148:                 app()->make(ProductCdkeyValidate::class)->check($data);
149:                 app()->make(ProductCdkeyRepository::class)->save($data, $this->request->merId());
150:                 return app('json')->success('导入成功');
151:                 break;
152:             default:
153:                 break;
154:         }
