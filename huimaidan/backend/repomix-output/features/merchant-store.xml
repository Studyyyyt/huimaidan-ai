 27:     //可售日期(1:每天,2:自定义时间)
 28:     const SALE_TIME_TYPE_DAY = 1;
 29:     const SALE_TIME_TYPE_CUSTOM = 2;
 30: 
 31:     //1 允许 1 不允许
 32:     const ADVANCE_TYPE_NOT_ALLOW = 0;
 33:     const ADVANCE_TYPE_ALLOW = 1;
 34: 
 35:     const RANGE_TYPE_METHOD = [
 36:         1 => 'checkRadius',
 37:         2 => 'checkRegion',
 38:         3 => 'checkFence',
 39:     ];
