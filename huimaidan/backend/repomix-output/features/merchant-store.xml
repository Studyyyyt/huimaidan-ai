155:     public function checkRange(int $uid, array $params)
156:     {
157:         // 获取用户地址信息
158:         $address = app()->make(UserAddressRepository::class)->get($params['address_id'], $uid);
159:         if (!$address) {
160:             throw new ValidateException('用户地址不存在');
161:         }
162: 
163:         $res = $this->checkRangeByType($params['mer_id'], $address->toArray());
164:         return ['in_range' => $res];
165:     }
