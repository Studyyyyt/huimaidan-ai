502:      * @param bool $admin 管理员身份标记，默认为false，表示非管理员
503:      * @return bool 更新操作的结果，true表示成功，false表示失败
504:      */
505:     public function isShow($id, $isShow, bool $admin = false)
506:     {
507:         // 根据管理员身份选择更新的字段，管理员更新is_show字段，非管理员更新is_mer_show字段
508:         return $this->dao->update($id, [($admin ? 'is_show' : 'is_mer_show') => $isShow]);
