 94:            $item['is_type'] = 1;
 95:            $item['mer_id'] = $merId;
 96:            $item['library_id'] = $library_id;
 97:            return $item;
 98:         },$saveData);
 99:         $this->changeTotalNum($library_id, count($saveData));
