 291:      */
 292:     public function cloneCouponForm($id)
 293:     {
 294:         // 通过ID获取优惠券信息，包括与其相关的产品信息
 295:         $couponInfo = $this->dao->getWith($id, ['product'])->toArray();
 296: 
 297:         // 如果优惠券已过期，将时间范围转换为数组格式
 298:         if ($couponInfo['is_timeout']) {
 299:             $couponInfo['range_date'] = [$couponInfo['start_time'], $couponInfo['end_time']];
 300:         }
 301: 
 302:         // 如果优惠券有类型限制，将使用时间范围转换为数组格式
 303:         if ($couponInfo['coupon_type']) {
 304:             $couponInfo['use_start_time'] = [$couponInfo['use_start_time'], $couponInfo['use_end_time']];
 305:         }
 306: 
 307:         // 初始化产品ID列表，用于后续处理
 308:         $couponInfo['product_id'] = [];
 309: 
 310:         // 如果设置了相关产品，获取这些产品的ID和图片信息
 311:         if (count($couponInfo['product'])) {
 312:             $productIds = array_column($couponInfo['product'], 'product_id');
 313:             /** @var ProductRepository $make */
 314:             $make = app()->make(ProductRepository::class);
 315:             $products = $make->productIdByImage($couponInfo['mer_id'], $productIds);
 316:             foreach ($products as $product) {
 317:                 $couponInfo['product_id'][] = ['id' => $product['product_id'], 'src' => $product['image']];
 318:             }
 319:         }
 320: 
 321:         // 根据优惠券的最低使用金额，确定优惠券的使用类型
 322:         $couponInfo['use_type'] = $couponInfo['use_min_price'] > 0 ? 1 : 0;
 323: 
 324:         // 创建并返回克隆的优惠券表单数据，设置表单标题为“复制优惠券”
 325:         return $this->form()->formData($couponInfo)->setTitle('复制优惠券');
 326:     }
