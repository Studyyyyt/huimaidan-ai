389:                         'uid' => $user->uid,
390:                         'product_id' => $cart['product_id'],
391:                         'activity_id' => $cart['source'] >= 2 ? $cart['source_id'] : $cart['product_id'],
392:                         'total_price' => $cart['total_price'],
393:                         'product_price' => $productPrice,
394:                         'extension_one' => 0,
395:                         'extension_two' => 0,
396:                         'postage_price' => 0,
397:                         'svip_discount' => 0,
398:                         'cost' => $cart['cost'],
399:                         'coupon_price' => 0,
400:                         'platform_coupon_price' => 0,
401:                         'product_sku' => $cart['productAttr']['unique'],
402:                         'product_num' => $cart['cart_num'],
403:                         'refund_num' => $cart['cart_num'],
404:                         'integral_price' =>  0,
405:                         'integral' => $cart['integral'] ,
406:                         'integral_total' => $cart['integral'] ,
407:                         'product_type' => $cart['product_type'],
408:                         'cart_info' => json_encode($order_cart)
409:                     ];
410:                 }
411:                 $userMerchantRepository->getInfo($user->uid, $order['mer_id']);
412:                 //订单记录
