 981:                 $field = 'mer_id,category_id,type_id,mer_name,mer_phone,is_trader';
 982:                 // 带上关联信息查询商户，并根据商户ID筛选
 983:                 $with = ['merchantType','merchantCategory'];
 984:                 $query = $make->search([])->whereIn($make->getPk(),$ids)->with($with);
 985:                 // 计算商户总数
 986:                 $count = $query->count();
 987:                 // 分页查询商户，并指定查询字段
 988:                 $list = $query->page($page, $limit)->setOption('field',[])->field($field)->select();
 989:                 break;
 990:             default:
