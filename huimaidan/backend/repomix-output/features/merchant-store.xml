1952:         switch ($productType) {
1953:             case 1:
1954:                 $with['seckillActive'] = function ($query) {
1955:                     $query->field('seckill_active_id,start_day,end_day,start_time,end_time,once_pay_count,all_pay_count,active_status,seckill_time_ids');
