2005:                     } else if ($item['end_time'] <= $currentHour) {
2006:                         $seckillStatus = -1;
2007:                     }
2008:                 }
2009:             }
2010: 
2011:             $product['stop'] = strtotime($endTime);
2012:             $product['quota'] = $this->seckillStock($where['product_id']);
2013:             unset($product['seckillActive']);
2014:         }
2015:         $isRelation = false;
2016:         if ($userInfo) {
2017:             $isRelation = app()->make(UserRelationRepository::class)->getUserRelation([
2018:                 'type_id' => $activityId ?? $where['product_id'],
2019:                 'type' => $productType
2020:             ],
2021:                 $userInfo['uid']
2022:             );
