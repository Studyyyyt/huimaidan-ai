326:     /**
327:      * 回复订单商品评价
328:      *
329:      * 该方法用于处理用户对订单商品的评价回复。它首先验证订单和商品是否存在以及是否已评价，
330:      * 然后计算综合评分，最后在数据库事务中更新评价状态和订单状态，并触发相关通知和统计。
331:      *
332:      * @param array $data 包含评价相关信息的数据数组
333:      * @throws ValidateException 如果订单不存在或商品已评价，则抛出验证异常
334:      */
335:     public function reply(array $data)
336:     {
337:         // 实例化订单商品仓库，用于后续获取和更新订单商品信息
338:         $storeOrderProductRepository = app()->make(StoreOrderProductRepository::class);
339:         // 根据订单商品ID和用户ID获取订单商品信息
340:         $orderProduct = $storeOrderProductRepository->userOrderProduct($data['order_product_id'], $data['uid']);
341:         // 验证订单商品和订单信息是否存在
342:         if (!$orderProduct || !$orderProduct->orderInfo) {
343:             throw new ValidateException('订单不存在');
344:         }
345:         // 验证该订单商品是否已评价
346:         if ($orderProduct->is_reply) {
347:             throw new ValidateException('该商品已评价');
348:         }
349:         // 将订单商品ID、唯一标识、商家ID、商品类型等数据填充到评价数据中
350:         $data['product_id'] = $orderProduct['product_id'];
351:         $data['unique'] = $orderProduct['cart_info']['productAttr']['unique'];
352:         $data['mer_id'] = $orderProduct->orderInfo['mer_id'];
353:         $data['product_type'] = $orderProduct['cart_info']['product']['product_type'];
354:         // 计算综合评分
355:         $data['rate'] = ($data['product_score'] + $data['service_score'] + $data['postage_score']) / 3;
356:         // 使用数据库事务处理评价创建和订单状态更新
357:         Db::transaction(function () use ($data, $orderProduct, $storeOrderProductRepository) {
358:             // 创建评价记录
359:             $this->dao->create($data);
360:             // 更新订单商品为已评价状态
361:             $orderProduct->is_reply = 1;
362:             $orderProduct->save();
363:             // 检查该订单是否所有商品都已评价，如果是，则更新订单状态为交易完成
364:             if (!$storeOrderProductRepository->noReplyProductCount($orderProduct->orderInfo->order_id)) {
365:                 $orderProduct->orderInfo->status = 3;
366:                 $orderProduct->orderInfo->save();
367:                 // 记录订单状态变更日志
368:                 //TODO 交易完成
369:                 //订单记录
370:                 $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
371:                 $orderStatus = [
372:                     'order_id' => $orderProduct->orderInfo->order_id,
373:                     'order_sn' => $orderProduct->orderInfo->order_sn,
374:                     'type' => $storeOrderStatusRepository::TYPE_ORDER,
375:                     'change_message' => '交易完成',
376:                     'change_type' => $storeOrderStatusRepository::ORDER_STATUS_OVER,
377:                 ];
378:                 app()->make(CircleFinancialRecordRepository::class)->defrost($orderProduct->orderInfo);
379:                 $storeOrderStatusRepository->createSysLog($orderStatus);
380:             }
381:         });
382:         // 发送商家通知，提示有新的评价
383:         SwooleTaskService::merchant('notice', [
384:             'type' => 'reply',
385:             'data' => [
386:                 'title' => '新评价',
387:                 'message' => '您有一条新的商品评价',
388:                 'id' => $data['product_id']
389:             ]
390:         ], $data['mer_id']);
391:         // 更新用户返佣统计
392:         app()->make(UserBrokerageRepository::class)->incMemberValue($data['uid'], 'member_reply_num', $data['order_product_id']);
393:         // 推送更新商品评价任务到队列
394:         Queue::push(UpdateProductReplyJob::class, $orderProduct->product_id);
395:     }
396: 
397: }
