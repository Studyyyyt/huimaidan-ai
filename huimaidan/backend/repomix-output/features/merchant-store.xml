196:      * @param int $id 配送模板的ID。
197:      * @param array $data 包含更新后配送模板信息的数据数组。
198:      */
199:     public function update(int $id,array $data)
200:     {
201:         // 开始一个数据库事务，并传递ID和数据数组作为使用变量。
202:         Db::transaction(function()use ($id,$data) {
203:             // 从数据数组中提取区域、免费配送和未送达信息。
204:             $region = $data['region'];
205:             $free = $data['free'] ?? '';
206:             $undelives = $data['undelives']??'';
207: 
208:             // 从数据数组中移除不需要的字段，准备更新配送模板的其他信息。
209:             unset($data['region'],$data['free'],$data['undelives'],$data['city_ids']);
210: 
211:             // 使用DAO更新配送模板的基本信息。
212:             $this->dao->update($id, $data);
213: 
214:             // 删除与当前模板ID相关的所有区域、免费配送和未送达规则。
215:             (app()->make(ShippingTemplateRegionRepository::class))->batchRemove([], [$id]);
216:             (app()->make(ShippingTemplateFreeRepository::class))->batchRemove([], [$id]);
217:             (app()->make(ShippingTemplateUndeliveRepository::class))->batchRemove([], [$id]);
218: 
219:             // 如果配置了指定配送，則根据免费配送信息创建新的免费配送规则。
220:             if($data['appoint']) {
221:                 $settlefree = $this->settleFree($free, $id);
222:                 (app()->make(ShippingTemplateFreeRepository::class)->insertAll($settlefree));
223:             }
224: 
225:             // 根据新的区域配置，创建并插入新的区域配送规则。
226:             $settleRegion = $this->settleRegion($region,$id);
227:             (app()->make(ShippingTemplateRegionRepository::class)->insertAll($settleRegion));
228: 
229:             // 如果配置了未送达处理，根据未送达信息创建新的未送达规则。
230:             if($data['undelivery'] == 1){
231:                 $settleUndelives = $this->settleUndelives($undelives,$id);
232:                 (app()->make(ShippingTemplateUndeliveRepository::class))->create($settleUndelives);
233:             }
234: 
235:         });
