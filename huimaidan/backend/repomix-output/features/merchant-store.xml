 77: 
 78:     /**
 79:      * 获取订单详情
 80:      *
 81:      * 本函数用于根据用户ID和订单ID获取特定订单的详细信息。
 82:      * 可以选择是否加载订单相关的详细数据，如订单列表、商户信息等。
 83:      * 这种加载是通过懒加载方式实现的，只有在标志位$flag为true时才会加载。
 84:      *
 85:      * @param int $uid 用户ID
 86:      * @param int $id 订单组ID
 87:      * @param bool $flag 标志位，控制是否加载详细数据
 88:      * @return \think\Model|null 返回匹配条件的订单模型实例，如果没有找到则返回null
 89:      */
 90:     public function detail($uid, $id,$flag = true)
 91:     {
 92:         // 根据用户ID和订单ID查询订单信息，只查询未支付的订单
 93:         return $this->search(['paid' => 0, 'uid' => $uid])->where('group_order_id', $id)
 94:             ->with([
 95:             'orderList' => function (Relation $query) use ($flag) {
 96:                 // 当$flag为true时，指定查询订单的特定字段
 97:                 $query->when($flag, function ($query) {
 98: 
 99:                     $query->field('order_id,group_order_id,mer_id,order_sn,activity_type,pay_price,order_extend,order_type,is_virtual,merchant_take_info,merchant_take_id');
100:                 });
101:                 // 加载订单相关的商户信息，如果$flag为true，则只加载指定的商户字段，并附加服务类型信息
102:                 $query->with([
103:                     'merchant' => function ($query) use ($flag) {
104:                         $flag && $query->field('mer_id,mer_name,service_phone')->append(['services_type']);
105:                     }, 'orderProduct', 'presellOrder','take'
106:                 ]);
107:             }])->find();
108:     }
