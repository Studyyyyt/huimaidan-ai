 239:      * 然后在事务中执行优惠券的创建和相关产品的绑定操作。如果在执行过程中遇到任何问题，
 240:      * 事务将被回滚。
 241:      *
 242:      * @param array $data 包含优惠券信息和相关产品ID的数据数组
 243:      * @throws ValidateException 如果未选择产品且优惠券类型为1，则抛出验证异常
 244:      */
 245:     public function create1(array $data)
 246:     {
 247:         // 如果提供了总数量，则计算剩余数量
 248:         if (isset($data['total_count'])) {
 249:             $data['remain_count'] = $data['total_count'];
 250:         }
 251: 
 252:         // 使用事务来确保数据的一致性
 253:         Db::transaction(function () use ($data) {
 254:             // 提取产品ID，并删除不再需要的product_id键
 255:             $products = array_column((array)$data['product_id'], 'id');
 256:             unset($data['product_id']);
 257: 
 258:             // 如果优惠券类型为1且未选择任何产品，则抛出异常
 259:             if ($data['type'] == 1 && !count($products)) {
 260:                 throw new ValidateException('请选择产品');
 261:             }
 262: 
 263:             // 创建优惠券
 264:             $coupon = $this->dao->create($data);
 265: 
 266:             // 如果没有选择任何产品，则直接返回创建的优惠券
 267:             if (!count($products)) {
 268:                 return $coupon;
 269:             }
 270: 
 271:             // 准备要插入的产品和优惠券关系数据
 272:             $lst = [];
 273:             foreach ($products as $product) {
 274:                 $lst[] = [
 275:                     'product_id' => (int)$product,
 276:                     'coupon_id' => $coupon->coupon_id
 277:                 ];
 278:             }
 279: 
 280:             // 批量插入产品和优惠券的关系数据
 281:             app()->make(StoreCouponProductDao::class)->insertAll($lst);
 282:         });
 283:     }
