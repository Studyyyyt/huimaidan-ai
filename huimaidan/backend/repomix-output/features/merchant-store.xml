 803:                 }
 804:                 break;
 805:             case 11: // 分类优惠券
 806:                 // 提取分类ID，去除无关数据
 807:                 $products = $data['cate_ids'];
 808:                 unset($data['cate_ids']);
 809:                 // 如果没有选择分类，抛出异常
 810:                 if (!count($products)) {
 811:                     throw new ValidateException('请选择产品分类');
 812:                 }
 813:                 // 设置优惠券产品类型为1（表示分类优惠券）
 814:                 $productType = 1;
 815:                 break;
 816:             case 12: // 商户优惠券
 817:                 // 判断是否按条件查询商户
 818:                 if ($data['mer_type'] == 1) {
 819:                     // 商户查询条件
 820:                     $where = [
 821:                         'type_id' => $data['type_id'],
 822:                         'is_trader' => $data['is_trader'],
 823:                         'category_id' => $data['category_id'],
 824:                     ];
 825:                     // 根据条件查询商户ID
 826:                     $products = app()->make(MerchantRepository::class)->search($where)->column('mer_id');
 827:                     // 如果没有符合条件的商户，抛出异常
 828:                     if (!count($products)) {
