165:      */
166:     public function getUserListQuery($serviceId)
167:     {
168:         // 通过StoreServiceLog类的getDB方法获取数据库连接对象，并链式调用where方法指定查询条件
169:         return StoreServiceLog::getDB()->where('service_id', $serviceId);
170:     }
