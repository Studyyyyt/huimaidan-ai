2044:         $product = $product->append($append);
2045:         $product['attr'] = $attr;
2046:         $product['sku'] = $sku;
2047:         $product['isRelation'] = $isRelation;
2048:         $product = json_decode(json_encode($product,true),true);
2049:         $product['seckill_status'] = $seckillStatus;
2050:         $product['promoter'] = $extension;
2051:         $product = $this->mergeReservation($product);
