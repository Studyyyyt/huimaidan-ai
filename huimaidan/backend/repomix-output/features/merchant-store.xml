 45:     /**
 46:      * 根据URL和商家ID获取产品信息
 47:      * 该方法首先尝试从缓存中获取产品信息，如果缓存存在则直接返回，以提高效率。
 48:      * 如果缓存不存在，则根据商家是否有使用平台的采集次数来决定使用哪种方式获取产品信息。
 49:      * 如果商家有可用的采集次数，且系统配置允许使用API采集，则直接调用API获取产品信息。
 50:      * 如果商家有可用的采集次数，但系统配置不允许使用API采集，则通过服务类进行商品信息的复制操作。
 51:      * 如果商家没有可用的采集次数，则使用商家的一号通服务进行商品信息的复制操作。
 52:      * 获取到产品信息后，将其处理并存入缓存中，以供后续请求使用。
 53:      * 如果产品信息获取失败，抛出异常提示用户。
 54:      * 如果使用了平台的采集次数，记录相应的消耗。
 55:      *
 56:      * @param string $url 商品的URL
 57:      * @param int $merId 商家的ID
 58:      * @return array 返回产品信息
 59:      * @throws ValidateException 如果获取产品信息失败或接口返回错误信息，则抛出异常
 60:      */
 61:     public function getProduct($url,$merId)
 62:     {
 63:         // 构建缓存键名，用于存储和检索产品信息
 64:         $key = $merId.'_url_'.json_encode($url);
 65:         // 尝试从缓存中获取产品信息，如果存在则直接返回
 66:         if ($result= Cache::get($key)) return json_decode($result,true);
 67: 
 68:         // 检查商家是否有可用的采集次数
 69:         $number = app()->make(MerchantRepository::class)->checkCrmebNum($merId,'copy');
 70: 
 71:         // 如果商家有可用的采集次数
 72:         //如果有此处使用平台的采集方式
 73:         if ($number) {
 74:             // 检查系统配置，决定是否使用API采集产品信息
 75:             if (systemConfig('copy_product_status') == 1) {
 76:                 $resultData = $this->useApi($url);
 77:             } else {
 78:                 // 使用服务类进行商品信息的复制操作
 79:                 $service =  app()->make(CrmebServeServices::class,[0]);
 80:                 $resultData['data'] =$service->copy()->goods($url);
 81:                 $resultData['status'] = true;
 82:             }
 83:         } else { // 使用商家的一号通服务进行商品信息的复制操作
 84:             // 使用商家的一号通服务进行商品信息的复制操作
 85:             $service =  app()->make(CrmebServeServices::class,[$merId]);
 86:             $resultData['data'] =$service->copy()->goods($url);
 87:             $resultData['status'] = true;
 88:         }
 89: 
 90:         // 如果成功获取到产品信息
 91:         if ($resultData['status'] && $resultData['status']) {
 92:             // 处理产品信息并存入缓存中
 93:             $result = $this->getParamsData($resultData['data']);
 94:             Cache::set($key,json_encode($result), 60 * 60 * 2);
 95:         } else {
 96:             // 如果获取产品信息失败，抛出异常
 97:             if (isset($resultData['msg'])) throw  new ValidateException('接口错误信息:'.$resultData['msg']);
 98:             throw  new ValidateException('采集失败，请更换链接重试！');
 99:         }
100: 
101:         // 如果使用了平台的采集次数，记录采集次数的消耗
102:         //如果用的是平台购买，这里需要扣除次数
103:         if ($number) {
104:             $this->add(['type' => 'copy', 'num' => -1, 'info' => $url , 'mer_id' => $merId, 'message' => '采集商品',], $merId);
105:         }
106: 
107:         // 返回产品信息
108:         return $result;
109:     }
