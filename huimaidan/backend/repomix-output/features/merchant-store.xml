 82:      * @throws ValidateException 如果购物车中存在已支付的商品，则抛出异常
 83:      */
 84:     public function checkCartList($res, $user, $hasCoupon = 0)
 85:     {
 86:         $configFiled = ['mer_integral_status', 'mer_integral_rate', 'mer_store_stock', 'mer_take_status', 'mer_take_name', 'mer_take_phone', 'mer_take_address', 'mer_take_location', 'mer_take_day','svip_coupon_merge','mer_take_time'];
 87:         $uid = $user->uid;
 88:         $arr = $fail = [];
 89:         $productRepository = app()->make(ProductRepository::class);
 90:         $storeCouponProductRepository = app()->make(StoreCouponProductRepository::class);
 91:         //付费会员状态验证
 92:         $svip_status = (systemConfig('svip_switch_status') && $user && $user->is_svip > 0) ? true : false;
 93:         // 购物车所有商户的信息
 94:         $merchantRepository = app()->make(MerchantRepository::class);
 95:         $merIds = array_unique(array_column($res->toArray(),'mer_id'));
 96:         $merchantInfoData = $merchantRepository->getSearch([])->whereIn('mer_id',$merIds)
 97:             ->with([
 98:                 'config' => function($query) use($configFiled) {
 99:                     $query->whereIn('config_key', $configFiled);
100:                 },
101:                 'coupon' => function ($query) use ($uid) {
102:                     $query->where('uid', $uid);
103:                 },
104:                 'merchantCategory'
105:             ])
106:             ->field('mer_id,category_id,mer_name,mer_state,mer_avatar,is_trader,type_id,delivery_way,commission_rate,commission_switch')->select()
107:             ->append(['openReceipt'])->toArray();
108:         $keyArray = array_column($merchantInfoData,'mer_id');
109:         $merchantInfoData = array_combine($keyArray,$merchantInfoData);
110:         $productNumber = 0;
111:         foreach ($res as $item) {
112:             if ($item['is_pay']) throw new ValidateException('存在以支付购物车信息');
113:             if (!$item['checkCartProduct']) {
114:                 $item['product'] = $productRepository->getFailProduct($item['product_id']);
115:                 $fail[] = $item;
116:             } else {
117:                 $productNumber ++;
118:                 if ($item['product']['product_type'] != 0) $svip_status = false;
119:                 $coupon_make = app()->make(StoreCouponRepository::class);
120:                 if (!isset($arr[$item['mer_id']])) {
121:                     //商户信息
122:                     $merchantData = $merchantInfoData[$item['mer_id']] ?? ['mer_id' => 0];
123: //                    $merchantData = $item['merchant'] ? $item['merchant']->toarray(): ['mer_id' => 0];
124:                     if ($hasCoupon)
125:                         $merchantData['hasCoupon'] = $coupon_make->validMerCouponExists($item['mer_id'], $hasCoupon);
126:                     $arr[$item['mer_id']] = $merchantData;
127:                 }
128:                 if ($hasCoupon && !$arr[$item['mer_id']]['hasCoupon']) {
129:                     $couponIds = $storeCouponProductRepository->productByCouponId([$item['product']['product_id']]);
130:                     $arr[$item['mer_id']]['hasCoupon'] = count($couponIds) ? $coupon_make->validProductCouponExists([$item['product']['product_id']], $hasCoupon) : 0;
131:                 }
132:                 if ($svip_status && !$item['product']['product_type'] && $item['product']['show_svip_price']) {
133:                     $item['productAttr']['show_svip_price'] = true;
134:                     $item['productAttr']['org_price'] = $item['productAttr']['price'];
135:                     $item['productAttr']['price'] = $item['productAttr']['svip_price'];
136:                 } else {
137:                     $item['productAttr']['show_svip_price'] = false;
138:                 }
139:                 $arr[$item['mer_id']]['list'][] = $item;
140:             }
141:         }
142:         $list = array_values($arr);
143:         // 返回购物车列表、失败列表和商品数量
144:         return compact('list', 'fail', 'productNumber');
145:     }
