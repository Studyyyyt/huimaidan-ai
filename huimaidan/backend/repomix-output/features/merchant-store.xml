189:         $data = [];
190:         $_count = count($arr);
191:         for ($i = 1; $i <= $j; $i++) {
192:             $data[] = [
193:                 'group_buying_id' => $res['group_buying_id'],
194:                 'product_group_id' => $res['product_group_id'],
195:                 'uid' => 0,
196:                 'order_id' => 0,
197:                 'nickname' => '匿名',
198:                 'avatar' => $arr[rand(0, $_count - 1)],
199:                 'status' => 0
200:             ];
201:         }
202:         Db::transaction(function () use ($res, $data) {
203:             app()->make(ProductGroupUserRepository::class)->insertAll($data);
204:             $this->successChange($res);
205:         });
206: 
207:     }
