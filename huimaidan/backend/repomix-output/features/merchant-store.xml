 51:                 $query->field('value_id,sku');
 52:             }
 53:         ])->order('CdkeyLibrary.create_time DESC');
 54: 
 55:         // 计算符合条件的数据总数
 56:         $count = $query->count();
 57: 
 58:         // 分页查询数据列表
 59:         $list = $query->page($page, $limt)->select();
 60: 
 61:         // 返回包含数据总数和列表数据的数组
 62:         return compact('count', 'list');
