255:     /**
256:      * 更新商品信息。
257:      * 根据商品当前状态和新状态的不同，执行不同的逻辑，包括更新数据库、创建或更新微信商品、发送通知等。
258:      *
259:      * @param int $id 商品ID。
260:      * @param array $data 商品更新数据。
261:      * @return object 更新后的商品对象。
262:      */
263:     public function update($id, array $data)
264:     {
265:         // 根据ID获取商品对象
266:         $goods = $this->dao->get($id);
267:         // 获取当前商家是否为代理商家的状态，用于后续判断商品状态的逻辑
268:         $status = request()->merchant()->is_bro_goods == 1 ? 0 : 1;
269: 
270:         // 如果商品状态为待审核
271:         if ($goods->status == 0) {
272:             // 更新商品数据
273:             $goods->save($data);
274:             // 如果当前商家不是代理商家
275:             if ($status == 1) {
276:                 // 如果商品已有ID，说明之前已创建过微信商品，此时只需更新微信商品信息
277:                 if ($goods->goods_id) {
278:                     $this->wxUpdate($goods->goods_id, $data);
279:                 } else {
280:                     // 如果商品没有ID，说明是新创建的商品，需要先创建微信商品，并更新商品对象的ID和审核ID
281:                     $res = $this->wxCreate($goods);
282:                     $goods->goods_id = $res->goodsId;
283:                     $goods->audit_id = $res->auditId;
284:                 }
285:                 // 保存更新后的商品信息
286:                 $goods->save();
287:             } else {
288:                 // 如果当前商家是代理商家，发送新直播商品申请的通知
289:                 SwooleTaskService::admin('notice', [
290:                     'type' => 'new_goods',
291:                     'data' => [
292:                         'title' => '新直播商品申请',
293:                         'message' => '您有1个新的直播商品审核，请及时处理！',
294:                         'id' => $goods->broadcast_goods_id
295:                     ]
296:                 ]);
297:             }
298:         } else {
299:             // 如果商品状态不是待审核
300:             // 如果当前商家不是代理商家且商品已有微信商品ID，则更新微信商品信息
301:             if ($status == 1 && $goods->goods_id) {
302:                 $this->wxUpdate($goods->goods_id, $data);
303:             }
304:             // 设置商品状态和错误信息为空，准备更新到数据库
305:             $data['status'] = $status;
306:             $data['error_msg'] = '';
307:             // 执行状态变更操作
308:             $this->change($id, $data);
309:         }
310:         // 返回更新后的商品对象
311:         return $goods;
312:     }
