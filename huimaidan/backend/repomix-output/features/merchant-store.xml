127:     {
128:         $res = $this->dao->get($id);
129:         if (!$res || $res['mer_id'] != $merId) throw new ValidateException('数据不存在');
130:         $num = $res['total_num'] - $res['used_num'];
131:         Db::transaction(function() use ($res,$num) {
132:             if(isset($res->product)){
133:                 $res->product->stock = $res->product->stock  - $num;
134:                 $res->product->save();
135:             }
136:             if (isset($res->attrValue)){
