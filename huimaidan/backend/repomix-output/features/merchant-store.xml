187:             ->with(['product', 'productAttr' => function($query){
188:                 $query->field('value_id,image,extension_one,extension_two,product_id,stock,price,unique,sku,volume,weight,ot_price,cost,svip_price,library_id,bar_code,bar_code_number');
189:             }])
190:             ->order('product_type DESC,cart_id DESC')
191:             ->select();
192:         // 批量加载配送模板
193:         $this->batchLoadShippingTemplates($cartItems, $cityIds);
194: 
195:         return $cartItems;
196:     }
197: 
198:     private function batchLoadShippingTemplates($cartItems, array $cityIds)
199:     {
200:         if (empty($cityIds)) {
201:             return;
202:         }
203: 
204:         // 获取所有模板 ID
205:         $templateIds = $cartItems->column('product.temp_id'); // 提取模板 ID
206:         $templateIds = array_unique($templateIds);           // 去重
207: 
208:         // 一次性查询所有模板数据，包括 region、free 和 undelives
209:         $shippingTemplates = ShippingTemplate::whereIn('id', $templateIds)
210:             ->with([
211:                 'region' => function ($query) use ($cityIds) {
212:                     foreach ($cityIds as $cityId) {
213:                         $query->whereOr('city_id', 'like', "%/{$cityId}/%");
214:                     }
215:                     $query->whereOr('city_id', '0'); // 适配所有区域
216:                     $query->order('shipping_template_region_id DESC')->withLimit(1);
217:                 },
218:                 'free' => function ($query) use ($cityIds) {
219:                     foreach ($cityIds as $cityId) {
220:                         $query->whereOr('city_id', 'like', "%/{$cityId}/%");
221:                     }
222:                     $query->order('shipping_template_free_id DESC')->withLimit(1);
223:                 },
224:                 'undelives' => function ($query) use ($cityIds) {
225:                     foreach ($cityIds as $cityId) {
226:                         $query->whereOr('city_id', 'like', "%/{$cityId}/%");
227:                     }
228:                 }
229:             ])
230:             ->select()
231:             ->column(null, 'id'); // 按模板 ID 索引结果
232: 
233:         // 将模板数据分配给购物车项
234:         foreach ($cartItems as $item) {
235:             $item->product->shipping_template = $shippingTemplates[$item->product->temp_id] ?? null;
236:         }
237:     }
238: 
239:     /**
240:      * 批量删除购物车中指定ID的商品
241:      *
242:      * 此方法通过传入的用户ID和购物车ID数组，批量从数据库中删除对应的购物车记录。
243:      * 主要用于处理用户批量清除购物车商品的场景，或者在特定情况下批量清理数据库中的购物车数据。
244:      *
245:      * @param array $cartIds 购物车项ID数组，代表需要被删除的购物车记录的ID。
246:      * @param int $uid 用户ID，用于指定哪些购物车记录属于该用户，从而进行精准删除。
247:      * @return int 返回删除操作的影响行数，即被删除的购物车记录数量。
248:      */
249:     public function batchDelete(array $cartIds, int $uid)
250:     {
251:         // 通过模型获取数据库实例，并构造删除条件，最终执行删除操作。
252:         return ($this->getModel()::getDB())->where('uid', $uid)->whereIn('cart_id', $cartIds)->delete();
253:     }
254: 
255:     /**
256:      * 获取用户购物车中商品的数量
257:      *
258:      * 本函数用于查询指定用户ID的购物车中，未删除、未标记为新、未支付的商品总数。
259:      * 这对于显示用户的购物车总数或者进行相关统计非常有用。
260:      *
261:      * @param int $uid 用户ID，用于指定查询哪个用户的购物车数据。
262:      * @return array 返回一个包含商品总数的数组，如果商品数量为0，则数组中的计数为0。
263:      */
264:     public function getCartCount(int $uid)
265:     {
266:         // 通过模型获取数据库实例，并根据条件查询购物车商品数量，条件包括用户ID、未删除、未标记为新、未支付。
267:         $data = ($this->getModel()::getDB())->where(['uid' => $uid, 'is_del' => 0, 'is_new' => 0, 'is_pay' => 0])->field('SUM(cart_num) as count')->select();
268: 
269:         // 确保返回的数据中count字段不为空，如果为空则默认为0。
270:         $data[0]['count'] = $data[0]['count'] ? $data[0]['count'] : 0;
271: 
272:         // 返回查询结果。
273:         return $data;
274:     }
275: 
276:     /**
277:      * 获取用户购物车中商品的数量
278:      *
279:      * 本函数用于查询指定用户ID的购物车中，未删除、未标记为新、未支付的商品总数。
280:      * 这对于显示用户的购物车总数或者进行相关统计非常有用。
281:      *
282:      * @param int $uid 用户ID，用于指定查询哪个用户的购物车数据。
283:      * @return array 返回一个包含商品总数的数组，如果商品数量为0，则数组中的计数为0。
284:      */
285:     public function getMerchantCartCount(int $uid, $cartIds)
286:     {
287:         // 通过模型获取数据库实例，并根据条件查询购物车商品数量，条件包括用户ID、未删除、未标记为新、未支付。
288:         $cartTotalNum = ($this->getModel()::getDB())->hasWhere('product', function($query) {
289:             $query->where('is_show', 1)->where('status', 1)->whereColumn('stock', '>=', 'StoreCart.cart_num');
290:         })->whereIn('StoreCart.cart_id', $cartIds)->where(['StoreCart.uid' => $uid, 'StoreCart.is_del' => 0, 'StoreCart.is_new' => 0, 'StoreCart.is_pay' => 0])->sum('StoreCart.cart_num');
291: 
292:         $data[0]['count'] = $cartTotalNum ?? 0;
293:         // 返回查询结果。
294:         return $data;
295:     }
