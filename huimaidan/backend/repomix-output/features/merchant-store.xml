440:     /**
441:      * 根据条件获取分页列表数据
442:      *
443:      * 本函数用于根据给定的条件数组 $where，从数据库中检索满足条件的数据列表。
444:      * 它支持分页查询，每页的数据数量由 $limit 参数指定，查询的页码由 $page 参数指定。
445:      * 查询结果包括两部分：总记录数 $count 和满足条件的分页数据列表 $list。
446:      *
447:      * @param array $where 查询条件数组
448:      * @param int $page 查询的页码
449:      * @param int $limit 每页的数据数量
450:      * @return array 返回包含 'count' 和 'list' 两个元素的数组，'count' 为总记录数，'list' 为数据列表
451:      */
452:     public function getList(array $where,int $page, int $limit)
453:     {
454:         // 初始化查询，根据 $where 条件搜索，并加载 'merchant' 关联数据，只获取 'mer_id' 和 'mer_name' 字段
455:         $query = $this->dao->search($where)->with([
456:             'merchant' => function ($query) {
457:                 // 限定只查询 'merchant' 表中的 'mer_id' 和 'mer_name' 两个字段
458:                 return $query->field('mer_id,mer_name');
459:             }
460:         ]);
461: 
462:         // 计算满足条件的总记录数
463:         $count = $query->count();
464: 
465:         // 执行分页查询，获取当前页的数据显示
466:         $list = $query->page($page,$limit)->select();
467: 
468:         // 将总记录数和分页数据列表打包成数组返回
469:         return compact('count','list');
470:     }
471: }
