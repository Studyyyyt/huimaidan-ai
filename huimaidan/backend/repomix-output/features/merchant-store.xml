41:      * 本函数用于向指定用户发行优惠券。它通过调用数据访问对象（DAO）来创建一条新的优惠券发行记录。
42:      *
43:      * @param int $couponId 优惠券ID
44:      *        识别要发行的具体优惠券的唯一标识符。
45:      * @param int $uid 用户ID
46:      *        接收优惠券的用户的唯一标识符。
47:      * @return bool|mixed
48:      *         返回值取决于DAO的create方法。通常是布尔值表示成功或失败，但在某些情况下，也可能返回新创建的记录ID。
49:      */
50:     public function issue($couponId, $uid)
51:     {
52:         // 调用DAO的create方法，传入发行优惠券所需的数据
53:         // 这里包含了优惠券ID和用户ID，用于在数据库中创建新的发行记录。
54:         return $this->dao->create([
55:             'coupon_id' => $couponId,
56:             'uid' => $uid,
57:         ]);
58:     }
59: 
60:     /**
61:      * 获取列表数据
62:      *
63:      * 根据给定的条件数组和分页信息，从数据库中检索并返回列表数据。
64:      * 这个方法主要用于处理数据的查询和分页，为前端提供分页列表的数据。
65:      *
66:      * @param array $where 查询条件数组，用于构建SQL查询的WHERE子句。
67:      * @param int $page 当前的页码，用于计算查询的起始位置。
68:      * @param int $limit 每页显示的数据条数，用于限制查询的结果集大小。
69:      * @return array 返回包含‘count’和‘list’两个元素的数组，‘count’表示总数据条数，‘list’表示当前页的数据列表。
70:      */
71:     public function getList(array $where, $page, $limit)
72:     {
73:         // 根据条件查询数据，这里不直接使用$where参数以避免潜在的SQL注入风险。
74:         $query = $this->dao->search($where);
75: 
76:         // 统计查询结果的总条数，用于分页计算。
77:         $count = $query->count();
78: 
79:         // 带上关联数据（如优惠券和用户信息）进行分页查询，返回当前页的数据列表。
80:         $list = $query->with(['coupon', 'user'])->page($page, $limit)->select();
81: 
82:         // 将总条数和当前页的数据列表打包成数组返回。
83:         return compact('count', 'list');
84:     }
85: }
