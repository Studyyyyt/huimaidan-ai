 726:     /**
 727:      *  格式商品SKU
 728:      * 商品添加编辑规格整理
 729:      * 所有商品添加编辑时预览规格整理
 730:      * @Author:Qinii
 731:      * @Date: 2020/9/15
 732:      * @param array $data
 733:      * @param int $productId
 734:      * @return mixed
 735:      */
 736:     public function setAttrValue(array $data, int $productId, int $productType, int $isUpdate = 0)
 737:     {
 738:         $extension_status = systemConfig('extension_status');
 739:         $result = ['attrValue' => [], 'data' => []];
 740:         $update_infos = [
 741:             OperateLogRepository::MERCHANT_INC_PRODUCT_PRICE => '',
 742:             OperateLogRepository::MERCHANT_DEC_PRODUCT_PRICE => '',
 743:             OperateLogRepository::MERCHANT_INC_PRODUCT_STOCK => '',
 744:             OperateLogRepository::MERCHANT_DEC_PRODUCT_STOCK => '',
 745:         ];
 746:         if ($isUpdate) {
 747:             $productAttrValue = app()->make(ProductAttrValueRepository::class)->search(['product_id' => $productId])->select()->toArray();
 748:             $oldSku = $this->detailAttrValue($productAttrValue, null);
 749:             $unique_price = array_column($productAttrValue,'price','unique');
 750:             $unique_stock = array_column($productAttrValue,'stock','unique');
 751:         }
 752: 
 753:         $cdkeyLibraryRepository = app()->make(CdkeyLibraryRepository::class);
 754:         /**
 755:          *  循环处理商品的每条规格组合
 756:          *  1. 获取商品规格组合的库存和价格
 757:          *  2. 计算商品最低价格
 758:          *  3. 处理卡密商品属性
 759:          */
 760:         $svip = isset($data['svip_price_type']) && $data['svip_price_type'] == 2 ? true : false;
 761:         $base_num = [];
 762: 
 763:         foreach ($data['attrValue'] as $value) {
 764:             if (!$productType && !$base_num && (!isset($value['is_default_select']) || $value['is_default_select']) ) {
 765:                 $base_num = [
 766:                     'price' => $value['price'],
 767:                     'ot_price' => $value['ot_price'],
 768:                     'cost' => $value['cost'],
 769:                     'svip_price' => $svip ? $value['svip_price'] : 0,
 770:                 ];
 771:             }
 772:             try {
 773:                 if (isset($value['checked']) && !$value['checked']) {continue;}
 774:                 $sku = '';
 775:                 if (isset($value['detail']) && !empty($value['detail']) && is_array($value['detail'])) {
 776:                     $sku = implode(',', $value['detail']);
 777:                 }
 778:                 $unique = $this->setUnique($productId, $sku, $productType);
 779:                 // 卡密/网盘商品 cdkey 关联
 780:                 if ($productType == 0  && isset($data['type'])) {
 781:                     if ($data['type'] == self::DEFINE_TYPE_CARD) { // 卡密商品
 782:                         if (isset($value['library_id']) && $value['library_id']) {
 783:                             $library  = $cdkeyLibraryRepository->getSearch(['id' => $value['library_id'],'mer_id' => $data['mer_id']])->find();
 784:                             if (is_null($library)) throw new ValidateException('卡密库ID错误'.$value['library_id']);
 785:                             if ($library['product_id'] && (!$isUpdate || $library['product_id'] != $productId)) {
 786:                                 throw new ValidateException('此卡密库ID已被使用【'.$value['library_id'].'】');
 787:                             }
 788:                         }
 789:                     } else if ($data['type'] == self::DEFINE_TYPE_CLOUD){ //网盘商品
 790:                         if (!isset($value['cdkey']) || empty($value['cdkey'])) throw new ValidateException('网盘商品必须填写信息');
 791:                         [$cdkey, $cdkeey_stock] = $this->setCdkey($value['cdkey'], $productId);
 792:                         !$cdkeey_stock ?: $value['stock'] = $cdkeey_stock;
 793:                     }
 794:                 }
 795:                 $attrValueItem = [];
 796:                 if(($data['type'] ?? 0) == self::DEFINE_TYPE_RESERVATION) {
 797:                     $attrValueItem['reservation'] = $value['reservation'] ?? [];
 798:                     $value['stock'] = array_sum(array_column($value['reservation'],'stock'));
 799:                 }
 800:                 //新售价
 801:                 $new_price = $value['price'] ? (($value['price'] < 0) ? 0 : $value['price']) : 0;
 802:                 //新库存
 803:                 $new_stock = $value['stock'] ? (($value['stock'] < 0) ? 0 : $value['stock']) : 0;
 804: 
 805:                 $attrValueItem["type"] = 0;
 806:                 $attrValueItem["sku"] = $sku;
 807:                 $attrValueItem["unique"] = $unique;
 808:                 $attrValueItem["price"] = $new_price;
 809:                 $attrValueItem["stock"] = $new_stock;
 810:                 $attrValueItem["product_id"] = $productId;
 811:                 $attrValueItem["image"] = isset($value["image"]) ? $value["image"] : $value["pic"] ?? '';
 812:                 $attrValueItem["bar_code"] = $value["bar_code"] ?? '';
 813:                 $attrValueItem['library_id'] = $value['library_id'] ?? 0;
 814:                 $attrValueItem['bar_code_number'] = $value['bar_code_number'] ?? '';
 815:                 $attrValueItem['detail'] = json_encode($value['detail'] ?? '');
 816:                 $attrValueItem['svip_price'] = $svip ? ($value['svip_price'] ?? 0) : 0;
 817:                 $attrValueItem['sales'] = $isUpdate ? ($oldSku[$sku]['sales'] ?? 0) : 0;
 818:                 $attrValueItem["extension_one"] = $extension_status ? ($value['extension_one'] ?? 0) : 0;
 819:                 $attrValueItem["extension_two"] = $extension_status ? ($value['extension_two'] ?? 0) : 0;
 820:                 $attrValueItem["cost"] = $value['cost'] ? (($value['cost'] < 0) ? 0 : $value['cost']) : 0;
 821:                 $attrValueItem["ot_price"] = $value['ot_price'] ? (($value['ot_price'] < 0) ? 0 : $value['ot_price']) : 0;
 822:                 $attrValueItem["volume"] = isset($value['volume']) ? ($value['volume'] ? (($value['volume'] < 0) ? 0 : $value['volume']) : 0) : 0;
 823:                 $attrValueItem["weight"] = isset($value['weight']) ? ($value['weight'] ? (($value['weight'] < 0) ? 0 : $value['weight']) : 0) : 0;
 824:                 $attrValueItem['is_default_select'] = $value['is_default_select'] ?? 0;
 825:                 $attrValueItem['is_show'] = $value['is_show'] ?? 1;
 826:                 $attrValueItem["settlement_price"] = $value["settlement_price"] ?? 0;
 827:                 if (isset($cdkey)) {$attrValueItem['cdkey'] = $cdkey;}
 828:                 $result['attrValue'][] = $attrValueItem;
 829:                 // 组合操作日志数据
 830:                 if ($isUpdate && isset($value['unique'])) {
 831:                     if (isset($unique_price[$value['unique']])) {
 832:                         if ($new_price > $unique_price[$value['unique']]) {
 833:                             $update_infos[OperateLogRepository::MERCHANT_INC_PRODUCT_PRICE] .= $attrValueItem['sku'] . '价格增加了' . bcsub($new_price, $unique_price[$value['unique']], 2) . ',';
 834:                         }
 835:                         if ($new_price < $unique_price[$value['unique']]) {
 836:                             $update_infos[OperateLogRepository::MERCHANT_DEC_PRODUCT_PRICE] .= $attrValueItem['sku'] . '价格减少了' . bcsub($unique_price[$value['unique']], $new_price, 2) . ',';
 837:                         }
 838:                     }
 839:                     if (isset($unique_stock[$value['unique']])) {
 840:                         if ($new_stock > $unique_stock[$value['unique']]) {
