 741:             return $cart['productPresellAttr']['final_price'];
 742:             // 如果商品类型为1（普通商品），或者3、4（其他特殊商品类型），返回0，表示不适用优惠券。
 743:         } else if ($cart['product_type'] == '1') {
 744:             return 0;
 745:         } else if ($cart['product_type'] == '3') {
 746:             return 0;
 747:         } else if ($cart['product_type'] == '4') {
 748:             return 0;
 749:             // 如果商品类型不属于以上任何一种，视为普通商品，返回商品的属性价格。
 750:         } else {
 751:             return $cart['productAttr']['price'];
 752:         }
 753:     }
