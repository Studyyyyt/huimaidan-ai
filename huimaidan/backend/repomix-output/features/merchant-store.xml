141:                 unset($where['type']);
142:                 $where = array_merge($where, app()->make(ProductRepository::class)->switchType($where_type, $mer_id));
143:                 if ($type !== 'price') {
144:                     $ids = $this->dao->search($mer_id, $where)->column('Product.product_id') ?? [];
145:                 } else {
146:                     $ids = [];
147:                 }
148:                 break;
149:             default:
150:                 throw new ValidateException('请选择需要批量设置的商品');
151:         }
152: 
153: 
154:         return $this->batchProcess($mer_id, $type, $ids, $data, $where, $admin_info);
155:     }
156: 
157: 
158:     /**
159:      * 批量操作
160:      * @param string $type
161:      * @param array $data
162:      * @return bool|\think\response\Json
163:      * @throws \think\db\exception\DbException
164:      *
165:      * @date 2023/10/09
166:      * @author yyw
167:      */
168:     public function batchProcess(int $mer_id, string $type, array $ids = [], array $data = [], array $where = [], $admin_info = [])
169:     {
170:         if (empty($this->type_list[$type])) {
171:             throw new ValidateException('类型异常');
172:         }
173: 
174:         if ($type != 'price' && empty($ids)) {
175:             throw new ValidateException('批量设置商品id为空，请检查');
176:         }
177:         if (empty($mer_id)) {
178:             throw new ValidateException('商户id异常，请检查');
179:         }
180: 
181:         $data = $this->validateData($type, $data);;
182: 
183:         switch ($type) {
184:             case 'cate':
185:                 $this->dao->updates($ids, $data);
186:                 break;
187:             case 'mer_cate':
188:                 $this->batchMerCate($mer_id, $ids, $data['mer_cate_ids']);
189:                 break;
190:             case 'label':
191:                 app()->make(SpuRepository::class)->batchLabels($ids, $data, $mer_id);
192:                 break;
193:             case 'delivery_method':
194:                 //验证参数
195:                 if (count($data['delivery_way']) > 3 || !is_array($data['delivery_way'])) {
196:                     throw new ValidateException('配送方式参数异常');
197:                 }
198:                 // 1:自提/到店 2:快递/上门 3:同城配送
199:                 foreach ($data['delivery_way'] as $value) {
200:                     if (!in_array($value, [1, 2, 3])) {
201:                         throw new ValidateException('没有该配送方式，请选择正确的配送方式');
202:                     }
203:                 }
204:                 if(isset($data['reservation_type']) && !empty($data['reservation_type'])) {
205:                     foreach ($data['reservation_type'] as $value) {
206:                         if (!in_array($value, [1, 2])) {
207:                             throw new ValidateException('预约商品，请选择正确的预约服务方式');
208:                         }
209:                     }
210:                     $reservationType = count($data['reservation_type']) == 2 ? 3 : $data['reservation_type'][0];
211:                     $this->reservationDao->query([])->whereIn($this->dao->getPk(), $ids)->update(['reservation_type' => $reservationType]);
212:                 }
213:                 unset($data['reservation_type']);
214: 
215:                 if (in_array(1, $data['delivery_way'])) {
216:                     $this->dao->query([])->whereIn($this->dao->getPk(), $ids)->where('type', 1)->update(['delivery_way' => 1]);
217:                 }
218:                 $data['delivery_way'] = implode(',', $data['delivery_way']);
219:                 $this->dao->query([])->whereIn($this->dao->getPk(), $ids)->where('type', 0)->update($data);
220:                 break;
221:             case 'postage':
222:                 if ($data['delivery_free'] == 1) {
223:                     $data['temp_id'] = 0;
224:                 } else {
225:                     if (!app()->make(ShippingTemplateRepository::class)->merInExists($mer_id, [$data['temp_id']]))
226:                         throw new ValidateException('请选择您自己的运费模板');
227:                 }
228:                 $this->dao->updates($ids, $data);
229:                 break;
230:             case 'commission':
231:                 if ($data['extension_one'] > 1 || $data['extension_one'] < 0 || $data['extension_two'] < 0 || $data['extension_two'] > 1) {
232:                     return app('json')->fail('比例0～1之间');
233:                 }
234:                 app()->make(ProductAttrValueRepository::class)->updatesExtension($ids, $data);
235:                 break;
236:             case 'member':
237:                 $this->dao->updates($ids, $data);
238:                 break;
239:             case 'sys_form':
240:                 $this->batchForm($mer_id, $ids, (int)$data['mer_form_id']);
241:                 break;
242:             case 'price':
243:                 $message = $this->queueBatchPrice($mer_id, $data['price_type'], $data['price_number'], $ids, $where, $admin_info);
244:                 break;
245:         }
246: 
247:         return $message ?? true;
248:     }
249: 
250: 
251:     /**
252:      * 批量修改商户分类
253:      * @param int $mer_id
254:      * @param array $ids
255:      * @param array $mer_cate_ids
256:      * @return bool
257:      *
258:      * @date 2023/10/09
259:      * @author yyw
260:      */
261:     public function batchMerCate(int $mer_id, array $ids, array $mer_cate_ids)
262:     {
263:         foreach ($ids as $id) {
264:             // 整理分类数据
265:             $mer_cate = app()->make(ProductRepository::class)->setMerCate($mer_cate_ids, $id, $mer_id);
266:             // 删除以前分类数据
267:             $productCateRepository = app()->make(ProductCateRepository::class);
268:             $productCateRepository->clearAttr($id);
269:             // 保存新的分类数据
270:             if (!empty($mer_cate)) {
271:                 $productCateRepository->insert($mer_cate);
272:             }
273:         }
274:         return true;
275:     }
276: 
277:     /**
278:      * 队列  批量修改价格
279:      * @param int $mer_id
280:      * @param array $ids
281:      * @param string $type
282:      * @param string $number
283:      * @return bool
284:      *
285:      * @date 2023/10/09
286:      * @author yyw
287:      */
288:     public function queueBatchPrice(int $mer_id, string $type, string $number, array $ids = [], array $where = [], $admin_info = [])
289:     {
290:         if (!in_array($type, ['add', 'sub', 'mul', 'div'])) {
291:             throw new ValidateException('修改价格类型错误');
292:         }
293:         if ($number === '') {
294:             return true;
295:         }
296:         if ($number <= 0) {
297:             throw new ValidateException('修改价格的变动值或比例不能小于等于0');
298:         }
299:         if ($where) {
300:             $this->dao->search($mer_id, $where)->with(['attrValue'])->chunk(10, function ($product_list) use ($mer_id, $type, $number, $ids, $admin_info) {
301:                 Queue::push(BatchUpdateProductPriceJob::class, compact('mer_id', 'type', 'number', 'product_list', 'admin_info'));
302:             }, 'Product.product_id');
303:         } else {
304:             Queue::push(BatchUpdateProductPriceJob::class, compact('mer_id', 'type', 'number', 'ids', 'admin_info'));
305:         }
306: 
307:         return '已加入消息队列，请稍后刷新';
308:     }
309: 
310: 
311:     /**
312:      * 批量修改价格
313:      * @param int $mer_id
314:      * @param array $ids
315:      * @param string $type
316:      * @param string $number
317:      * @return bool
318:      *
319:      * @date 2023/10/09
320:      * @author yyw
321:      */
322:     public function batchPrice(array $data = [])
323:     {
324: 
325:         $mer_id = $data['mer_id'];
326:         $type = $data['type'];
327:         $number = $data['number'];
328:         if (!in_array($type, ['add', 'sub', 'mul', 'div'])) {
329:             throw new ValidateException('修改价格类型错误');
330:         }
331:         if ($number <= 0) {
332:             throw new ValidateException('修改价格的变动值或比例不能小于等于0');
333:         }
334: 
335:         if (!empty($data['ids'])) {
336:             foreach ($data['ids'] as $id) {
337:                 $productInfo = $this->dao->getWith($id, ['attrValue']);
338:                 $this->updateProduct($mer_id, $type, $number, $productInfo, $data['admin_info'] ?? []);
339:             }
340:         }
341:         if (!empty($data['product_list'])) {
342:             foreach ($data['product_list'] as $productInfo) {
343:                 $this->updateProduct($mer_id, $type, $number, $productInfo, $data['admin_info'] ?? []);
344:             }
345:         }
346: 
347: 
348:         return true;
349:     }
350: 
351:     /**
352:      * 批量更新表单ID
353:      * @param int $mer_id
354:      * @param int $form_id
355:      * @return bool
356:      * @throws \think\db\exception\DbException
357:      *
358:      * @date 2023/10/11
359:      * @author yyw
360:      */
361:     public function batchForm(int $mer_id, array $ids = [], int $form_id = 0)
362:     {
363:         if ($form_id) {
364:             //验证模板是不存在
365:             /** @var FormRepository $formRepository */
366:             $formRepository = app()->make(FormRepository::class);
367:             if (!$form_info = $formRepository->get($form_id)) {
368:                 throw new ValidateException('表单数据异常');
369:             }
370:             if ($form_info['mer_id'] != $mer_id) {
371:                 throw new ValidateException('请选择自己的表单');
372:             }
373: 
374:             $this->dao->updates($ids, ['mer_form_id' => $form_id]);
375:         } else {
376:             $this->dao->updates($ids, ['mer_form_id' => 0]);
377:         }
378: 
379:         return true;
380:     }
381: 
382:     /**
383:      * 计算价格
384:      * @param string $ot_price
385:      * @param string $type
386:      * @param string $number
387:      * @return mixed|string|null
388:      *
389:      * @date 2023/10/09
390:      * @author yyw
391:      */
392:     public function calculatePrice(string $ot_price, string $type, string $number)
393:     {
394:         switch ($type) {
395:             case 'add':
396:                 $price = bcadd($ot_price, $number, 2);
397:                 break;
398:             case 'sub':
399:                 $price = max(bcsub($ot_price, $number, 2), 0);
400:                 break;
401:             case 'mul':
402:                 $pct = bcdiv($number, '100', 4);
403:                 $price = bcmul($ot_price, $pct, 2);
404:                 break;
405:             case 'div':
406:                 if ($number === '0') {
407:                     throw new ValidateException('分母不能为0');
408:                 }
409:                 $pct = bcdiv($number, '100', 4);
410:                 $price = bcdiv($ot_price, $pct, 2);
411:                 break;
412:             default:
413:                 throw new ValidateException('修改价格类型错误');
414:         }
415:         return $price;
416:     }
417: 
418:     /**
419:      * 修改商品
420:      * @param int $mer_id
421:      * @param string $type
422:      * @param string $number
423:      * @param $productInfo
424:      * @return void
425:      *
426:      * @date 2023/10/12
427:      * @author yyw
428:      */
429:     public function updateProduct(int $mer_id, string $type, string $number, $productInfo, $admin_info = []): void
430:     {
431: 
432:         Db::transaction(function () use ($mer_id, $type, $number, $productInfo, $admin_info) {
433:             $id = $productInfo['product_id'];
434:             $price = $this->calculatePrice($productInfo['price'], $type, $number);
435:             $this->dao->update($id, ['price' => $price]);
436:             $update_infos = [
437:                 OperateLogRepository::MERCHANT_INC_PRODUCT_PRICE => '',
438:                 OperateLogRepository::MERCHANT_DEC_PRODUCT_PRICE => '',
439:             ];
440:             //计算sku价格
441:             foreach ($productInfo['attrValue'] as $attrValue) {
442:                 $sku_price = $this->calculatePrice($attrValue['price'], $type, $number);
443: 
444:                 $change_price = bcsub($sku_price, $attrValue['price'], 2);
445:                 if ($change_price > 0) {
446:                     $update_infos[OperateLogRepository::MERCHANT_INC_PRODUCT_PRICE] .= $attrValue['sku'] . '价格增加了' . $change_price . ',';
447:                 } else {
448:                     $update_infos[OperateLogRepository::MERCHANT_DEC_PRODUCT_PRICE] .= $attrValue['sku'] . '价格减少了' . -$change_price . ',';
449:                 }
450: 
451:                 //更新sku
452:                 app()->make(ProductAttrValueRepository::class)->update($attrValue['value_id'], ['price' => $sku_price]);
453:             }
454:             //更新spu
455:             app()->make(SpuRepository::class)->updatePrice($mer_id, $id, $price);
456:             if (!empty($admin_info)) {
457:                 event('create_operate_log', [
458:                     'category' => OperateLogRepository::MERCHANT_EDIT_PRODUCT,
459:                     'data' => [
460:                         'product' => $productInfo,
461:                         'admin_info' => $admin_info,
462:                         'update_infos' => $update_infos,
463:                     ],
464:                 ]);
465:             }
466: 
467:         });
468:     }
469: 
470: }
