 76:     public function form(?int $id = null)
 77:     {
 78:         // 如果$id$存在，从数据库中获取卡密库的信息
 79:         //生成表单 Elm
 80:         if($id) {$formData = $this->dao->get($id)->toArray();}
 81: 
 82:         // 根据$id$的存在与否决定表单的动作，即创建还是更新卡密库
 83:         $form = Elm::createForm(is_null($id) ?
 84:             Route::buildUrl('merchantStoreProductCdkeyLibraryCreate')->build() :
 85:             Route::buildUrl('merchantStoreProductCdkeyLibraryUpdate', ['id' => $id])->build()
 86:         );
 87: 
 88:         // 设置表单的规则和预填充数据，如果.formData['name']或.formData['remark']不存在，则使用默认值
 89:         $form->setRule([
 90:             Elm::input('name', '卡密库名称：', $formData['name'] ?? '')->required('请输入卡密库名称'),
