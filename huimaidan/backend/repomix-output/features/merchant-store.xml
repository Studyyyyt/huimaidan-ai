 782:      * @return mixed 返回SpuRepository类中updateSort方法的执行结果
 783:      */
 784:     public function updateSort(int $id, ?int $merId, array $data)
 785:     {
 786:         // 根据主键ID准备查询条件
 787:         $where[$this->dao->getPk()] = $id;
 788:         // 如果提供了商户ID，则添加到查询条件中
