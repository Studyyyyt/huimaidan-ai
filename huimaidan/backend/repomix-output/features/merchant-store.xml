122:      * @param mixed $id 需要删除的记录的ID，可以是单个ID或ID数组
123:      * @param int $merId 商家ID，用于指定删除哪个商家的数据，默认为0，表示删除所有商家的数据
124:      * @return int 返回删除的记录数
125:      */
126:     public function delete($id, $merId = 0)
127:     {
128:         // 获取数据库实例并根据商家ID建立查询条件
129:         $query = ($this->getModel())::getDB()->where('mer_id', $merId);
130: 
131:         // 判断传入的ID类型，如果是数组，则使用whereIn方法删除多个记录；否则，直接使用where方法删除单个记录
132:         if (is_array($id)) {
133:             $query->where($this->getPk(), 'in',$id);
134:         } else {
135:             $query->where($this->getPk(), $id);
136:         }
137: 
138:         // 执行删除操作并返回删除的记录数
139:         return $query->delete();
140:     }
