 93:         return StoreServiceLog::getDB()->where('mer_id', $merId)->where('uid', $uid)->where('service_id', $serviceId)->where('service_type', '<>', 1)->update(['service_type' => 1]);
 94:     }
 95: 
 96:     /**
 97:      * 根据条件搜索商店服务日志。
 98:      *
 99:      * 该方法用于查询商店服务日志数据库，根据传入的条件进行过滤。支持的条件包括用户ID（uid）、商家ID（mer_id）、
100:      * 最后一条日志ID（last_id）和服务ID（service_id）。每个条件都是可选的，只有当相应条件的值被设置且不为空时，
101:      * 才会应用该条件的查询过滤。
102:      *
103:      * @param array $where 查询条件数组，包含可能的过滤条件：uid、mer_id、last_id和服务_id。
104:      * @return BaseQuery|\think\db\Query
105:      */
106:     public function search(array $where)
107:     {
108:         // 获取数据库查询对象
109:         return StoreServiceLog::getDB()->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
110:             // 如果设置了用户ID，则添加用户ID的查询条件
111:             $query->where('uid', $where['uid']);
112:         })->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
113:             // 如果设置了商家ID，则添加商家ID的查询条件
114:             $query->where('mer_id', $where['mer_id']);
115:         })->when(isset($where['last_id']) && $where['last_id'] !== '', function ($query) use ($where) {
116:             // 如果设置了最后一条日志ID，则添加服务日志ID小于指定ID的查询条件
117:             $query->where('service_log_id', '<', $where['last_id']);
118:         })->when(isset($where['service_id']) && $where['service_id'] !== '', function ($query) use ($where) {
119:             // 如果设置了服务ID，则添加服务ID的查询条件
120:             $query->where('service_id', $where['service_id']);
121:         });
122:     }
123: 
124:     /**
125:      * 获取用户最近一次的服务ID
126:      *
127:      * 本函数用于查询指定用户和商家的最近一次服务记录的ID。
128:      * 通过查询StoreServiceLog表，根据商家ID（merId）和用户ID（uid），
129:      * 以服务日志ID降序的方式获取最新的服务ID。
130:      *
131:      * @param string $merId 商家ID，用于指定查询哪个商家的服务记录
132:      * @param string $uid 用户ID，用于指定查询哪个用户的服务记录
133:      * @return mixed 返回最近一次服务的ID，如果不存在则返回null
134:      */
135:     public function getLastServiceId($merId, $uid)
136:     {
137:         // 使用数据库查询工具，指定查询条件为商家ID和用户ID，按服务日志ID降序排列，返回最新的服务ID
138:         return StoreServiceLog::getDB()->where('mer_id', $merId)->order('service_log_id DESC')->where('uid', $uid)->value('service_id');
139:     }
140: 
141:     /**
142:      * 获取商家列表查询
143:      *
144:      * 本函数用于构造查询指定用户所关联的商家列表的数据库查询语句。
145:      * 通过用户ID（$uid）筛选出相关数据，并对结果按商家ID（mer_id）进行分组。
146:      * 这样做的目的是为了获取每个商家的相关信息，避免数据重复，便于后续处理和展示商家列表。
147:      *
148:      * @param int $uid 用户ID，用于查询该用户关联的商家信息。
149:      * @return \think\db\Query 返回一个数据库查询对象，该对象包含了根据用户ID筛选并按商家ID分组的查询条件。
150:      */
151:     public function getMerchantListQuery($uid)
152:     {
153:         // 使用StoreServiceLog类中的getDB方法获取数据库操作对象，并链式调用where和group方法构造查询语句
154:         return StoreServiceLog::getDB()->where('uid', $uid)->group('mer_id');
