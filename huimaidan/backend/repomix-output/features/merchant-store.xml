14: 
15: class OrderStatus
16: {
17: 
18:     //订单支付状态：0-未支付，1-已支付
19:     const PAY_STATUS_UNPAID = 0;
20:     const PAY_STATUS_PAID = 1;
21: 
22:     /**
23:      * 订单主流程 status 字段
24:      * （订单支付状态 0-未支付）
25:      * 下单 -> 待付款
26:      *
27:      * （订单支付状态 1-已支付）
28:      * 待发货 -> 待收货 -> 待评价 -> 已完成
29:      * 通用订单状态（0：待发货；1：待收货；2：待评价；3：已完成；）
30:      *
31:      * -1：已退款
32:      *  is_del = 1 已取消
33:      */
34:     const ORDER_STATUS_PENDING_SHIPMENT =  0;  // 待发货
35:     const ORDER_STATUS_PENDING_RECEIPT  =  1;  // 待收货
36:     const ORDER_STATUS_PENDING_REVIEW   =  2;  // 待评价
37:     const ORDER_STATUS_COMPLETED        =  3;  // 已完成
38:     const ORDER_STATUS_REFUND           = -1;  // 已退款
39: 
40:     /**
41:      * 其他扩展状态：9: 拼团中 10: 待付尾款 11: 尾款超时未付 20 : 预约订单服务中【已打卡/待核销】
42:     */
43:     const ORDER_STATUS_GROUPING             = 9;
44:     const ORDER_STATUS_PENDING_PAY_TAIL     = 10;
45:     const ORDER_STATUS_PENDING_PAY_TIMEOUT  = 11;
46:     const RESERVATION_ORDER_STATUS_INSERVICE  = 20;
47: 
48:     /**
49:      *  product_type = 0 && is_virtual = 4 预约商品订单
50:      *
51:      * 预约商品订单流程
52:      * 下单 -> 待付款 ->
53:      *  status
54:      * 待指派/领取 -> 待服务 -> [已打卡 -> ] 核销 -> 待评价 -> 完成
55:      * status 0：待发货； 1：待收货；   20 已打卡/待核销   2：待评价； 3：已完成；
56:      * order_type = 0 上门 1 到店
57:      *  (status = 20 || (order_type == 1 && status == 1)) 待核销
58:      *
59:      *
60:      */
61:     const  ORDER_STATUS_CHECKIN = 20;
62: 
63:     public static function getStatusText($order, $product_type = 0, $type = 0)
64:     {
65:         $status = $order;
66:         if ($order instanceof StoreOrder) {
