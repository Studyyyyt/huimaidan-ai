 23: 
 24: /**
 25:  * 商品助力活动
 26:  */
 27: class ProductAssistRepository extends BaseRepository
 28: {
 29:     public function __construct(ProductAssistDao $dao)
 30:     {
 31:         $this->dao = $dao;
 32:     }
 33: 
 34:     /**
 35:      * 创建助力活动
 36:      *
 37:      * 本函数用于处理创建助力活动的逻辑。它首先通过给定的数据创建一个新产品，然后创建一个助力活动，
 38:      * 并设置相关的SKU信息。最后，它触发相关的事件并发送通知，提醒管理员有新的助力商品待审核。
 39:      *
 40:      * @param int $merId 商家ID，用于标识助力活动所属的商家。
 41:      * @param array $data 包含助力活动和产品信息的数据数组。
 42:      *
 43:      * @return void
 44:      */
 45:     public function create(int $merId,array $data)
 46:     {
 47:         // 实例化产品仓库，用于后续的产品创建操作。
 48:         $product_make = app()->make(ProductRepository::class);
 49: 
 50:         // 初始化产品信息数组，设置产品的基本属性。
 51:         $product = [
 52:             'image' => $data['image'],
 53:             'store_name' => $data['store_name'],
 54:             'store_info' => $data['store_info'],
 55:             'slider_image' => $data['slider_image'],
 56:             'temp_id' => $data['temp_id'],
 57:             'is_show' => 0,
 58:             'product_type' => 3,
 59:             'status'    => 1,
 60:             'old_product_id'    => $data['product_id'],
 61:             'guarantee_template_id'=>$data['guarantee_template_id'],
 62:             'sales' => 0,
 63:             'rate'  => 3,
 64:             'integral_rate' => 0,
 65:             'delivery_way' => $data['delivery_way'],
 66:             'delivery_free' => $data['delivery_free'],
 67:         ];
 68: 
 69:         // 使用数据库事务来确保操作的原子性。
 70:         Db::transaction(function()use($data,$product_make,$product,$merId){
 71:             // 触发'product.assistCreate.before'事件，允许在创建助力活动之前执行自定义逻辑。
 72:             event('product.assistCreate.before',compact('data'));
 73: 
 74:             // 复制产品并创建一个新的产品，返回新的产品ID。
 75:             $product_id = $product_make->productCopy($data['product_id'],$product,3);
 76: 
 77:             // 初始化助力活动信息数组，设置助力活动的基本属性。
 78:             $assist = [
 79:                 'start_time' => $data['start_time'],
 80:                 'end_time'   => $data['end_time'],
 81:                 'status'     => 0,
 82:                 'is_show'    => $data['is_show'] ?? 1,
 83:                 'product_id' => $product_id,
 84:                 'store_name' => $data['store_name'],
 85:                 'store_info' => $data['store_info'],
 86:                 'pay_count' => $data['pay_count'],
 87:                 'mer_id'     => $merId,
 88:                 'assist_count' => $data['assist_count'],
 89:                 'assist_user_count' => $data['assist_user_count'],
 90:                 'product_status' => 0,
 91:             ];
 92: 
 93:             // 实例化助力活动SKU仓库，用于后续的SKU信息插入操作。
 94:             $sku_make = app()->make(ProductAssistSkuRepository::class);
 95: 
 96:             // 创建助力活动。
 97:             $productAssist = $this->dao->create($assist);
 98: 
 99:             // 根据给定的数据和助力活动ID，计算并准备SKU信息数组。
100:             $sku = $this->sltSku($data,$productAssist->product_assist_id,$data['product_id']);
101: 
102:             // 批量插入SKU信息。
103:             $sku_make->insertAll($sku);
104: 
105:             // 更新SPU信息，包括价格和商家ID。
106:             $data['price'] = $sku[0]['assist_price'];
107:             $data['mer_id'] = $merId;
108: 
109:             // 实例化SPU仓库，用于创建SPU信息。
110:             app()->make(SpuRepository::class)->create($data,$product_id,$productAssist->product_assist_id,3);
111: 
112:             // 触发'product.assistCreate'事件，允许在创建助力活动之后执行自定义逻辑。
113:             event('product.assistCreate',compact('productAssist'));
114: 
115:             // 发送管理员通知，提示有新的助力商品待审核。
116:             SwooleTaskService::admin('notice', [
117:                 'type' => 'new_assist',
118:                 'data' => [
119:                     'title' => '商品审核',
120:                     'message' => '您有一个新的助力商品待审核',
121:                     'id' => $productAssist->product_assist_id
122:                 ]
123:             ]);
124:         });
125:     }
126: 
127:     /**
128:      *  检测是否每个sku的价格
129:      * @param array $data
130:      * @param int $presellType
131:      * @return array
132:      * @author Qinii
133:      * @day 2020-10-12
134:      */
135:     public function sltSku(array $data,int $assistId,int $productId)
136:     {
137:         $make = app()->make(ProductAttrValueRepository::class);
138:         $sku = [];
139:         if(count($data['attrValue']) > 1) throw new ValidateException('助力商品只能选择一个SKU');
140:         $item = $data['attrValue'][0];
141: 
142:         if(!isset($item['assist_price']))throw new ValidateException('请输入助力价格');
143:         $skuData = $make->getWhere(['unique' => $item['unique'],'product_id' => $productId]);
144:         if(!$skuData) throw new ValidateException('SKU不存在');
