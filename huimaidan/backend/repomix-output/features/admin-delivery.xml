11: namespace app\common\dao\delivery;
12: 
13: use app\common\dao\BaseDao;
14: use app\common\model\delivery\DeliveryStation;
15: 
16: class DeliveryStationDao extends BaseDao
17: {
18:     const SWITCH_TYPE = [
19:         1 => 'switch_city', // 同城配送
20:         2 => 'switch_take', // 到店自提
21:     ];
22: 
23:     protected function getModel(): string
24:     {
25:         return DeliveryStation::class;
26:     }
27: 
28:     public function search($where)
29:     {
30:         $query = ($this->getModel()::getDB());
31: 
32:         $query->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
33:             $query->where('mer_id', $where['mer_id']);
34:         })->when(isset($where['switch_city']) && !empty($where['switch_city']), function ($query) use ($where) {
35:             $query->where('switch_city', $where['switch_city']);
36:         })->when(isset($where['switch_take']) && !empty($where['switch_take']), function ($query) use ($where) {
37:             $query->where('switch_take', $where['switch_take']);
38:         })->when(isset($where['station_name']) && $where['station_name'] !== '', function ($query) use ($where) {
39:             $query->where('station_name', 'like', '%' . $where['station_name'] . '%');
40:         })->when(isset($where['contact_name']) && $where['contact_name'] !== '', function ($query) use ($where) {
41:             $query->where('contact_name', 'like', '%' . $where['contact_name'] . '%');
42:         })->when(isset($where['phone']) && $where['phone'] !== '', function ($query) use ($where) {
43:             $query->where('phone', $where['phone']);
44:         })->when(isset($where['station_address']) && $where['station_address'] !== '', function ($query) use ($where) {
45:             $query->where('station_address', 'like', '%' . $where['station_address'] . '%');
46:         })->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
47:             $query->where('status', $where['status']);
48:         })->when(isset($where['swtich_type']) && $where['swtich_type'] !== '', function ($query) use ($where) {
49:             $query->where(self::SWITCH_TYPE[$where['swtich_type']], 1);
50:         })->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
51:             $query->where('type', $where['type']);
52:         })->when(isset($where['mer_delivery_type']) && $where['mer_delivery_type'] !== '', function ($query) use ($where) {
53:             $query->whereIn('type', $where['mer_delivery_type']);
54:         })->when(isset($where['name_and_address_search']) && $where['name_and_address_search'] !== '', function ($query) use ($where) {
55:             $query->where(function ($query) use ($where) {
56:                 $query->where('station_name', 'like', '%' . $where['name_and_address_search'] . '%')
57:                     ->whereOr('station_address', 'like', '%' . $where['name_and_address_search'] . '%');
58:             });
59:         });
60: 
61:         return $query;
62:     }
63: }
