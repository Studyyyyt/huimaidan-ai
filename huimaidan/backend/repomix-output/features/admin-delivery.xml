18: class DeliveryConfigRepository extends BaseRepository
19: {
20:     use DeliveryTrait;
21: 
22:     public function __construct(DeliveryConfigDao $dao)
23:     {
24:         $this->dao = $dao;
25:     }
26: 
27:     protected function getDao()
28:     {
29:         return $this->dao;
30:     }
31: 
32:     public function update(int $id, int $merId, array $basicSettingsParams, array $deliveryParams)
33:     {
34:         // 基本信息保存
35:         $configValueRepository = app()->make(ConfigValueRepository::class);
36:         $configValueRepository->setFormData($basicSettingsParams, $merId);
37:         // 配送信息
38:         $deliveryParams['mer_id'] = $merId;
39:         $deliveryParams['status'] = 1;
40:         $deliveryParams['distance_premium_config'] = json_encode($deliveryParams['distance_premium_config']);
41:         $deliveryParams['weight_premium_config'] = json_encode($deliveryParams['weight_premium_config']);
42: 
43: 
44:         return Db::transaction(function () use ($id, $merId, $deliveryParams, $basicSettingsParams) {
45:             $this->getDao()->saveConfig($id, $deliveryParams);
46: 
47:             $mer_delivery_type = $basicSettingsParams['mer_delivery_type'];
48:             app()->make(DeliveryStationRepository::class)->search([
49:                 'mer_id' => $merId,
50:                 'status' => 1
51:             ])->whereNotIn('type', $mer_delivery_type)->update(['status'=> 0]);
52:             app()->make(DeliveryStationRepository::class)->search([
53:                 'mer_id' => $merId,
54:                 'status' => 0
55:             ])->whereIn('type', $mer_delivery_type)->update(['status' => 1]);
56:         });
57: 
58:         return $this->getDao()->saveConfig($id, $deliveryParams);
59:     }
60: 
61:     public function deliverySettings(int $merId, array $keys = [])
62:     {
63:         if (empty($keys)) {
64:             $keys = [
65:                 'mer_delivery_type',
66:                 'mer_delivery_order_status'
67:             ];
68:         }
69:         // 基本信息
70:         $basicSettings = merchantConfig($merId, $keys);
71:         // 配送信息
72:         $deliverySettings = $this->dao->getDeliveryConfig($merId);
73: 
74:         return compact('basicSettings', 'deliverySettings');
75:     }
76:     /**
77:      * 配送费用计算
78:      *
79:      * @param integer $takeId
80:      * @param float $totalWeight
81:      * @param array $deliverySettings
82:      * @param array|string $address
83:      * @return float
84:      */
85:     public function deliveryFee(int $takeId, float $totalWeight, array $deliverySettings, $address): float
86:     {
87:         // 是否开启溢价叠加,未开启溢价按基础运费计算
88:         $fee = $deliverySettings['base_shipping_fee'];
89:         if ($deliverySettings['is_premium_stack_enabled']) {
90:             $distanceStackFee = $this->distanceStackFee($takeId, $deliverySettings['mer_id'], $deliverySettings['distance_premium_config'], $address);
91:             $weightStackFee = $this->weightStackFee($totalWeight, $deliverySettings['weight_premium_config']);
92:             $stackFee = bcadd($distanceStackFee, $weightStackFee);
93:             $fee = bcadd($fee, $stackFee);
94:         }
95: 
96:         return $fee;
97:     }
98: }
