 11: namespace app\common\repositories\delivery;
 12: 
 13: use think\exception\ValidateException;
 14: 
 15: trait DeliveryTrait
 16: {
 17:     /**
 18:      * 获取距离
 19:      *
 20:      * @param float $merLat
 21:      * @param float $merLong
 22:      * @param array|string $address
 23:      * @return float
 24:      */
 25:     protected function getAddressDistance(float $merLat, float $merLong, $address): float
 26:     {
 27:         if(is_string($address)){
 28:             $addressDetail = $address;
 29:         } else {
 30:             $addressDetail = $address['province'] . $address['city'] . $address['district'] . $address['street'] . $address['detail'];
 31:         }
 32:         $addressLatAndLong = lbs_address([], $addressDetail);
 33:         if (!$addressLatAndLong || !$merLat || !$merLong) {
 34:             return false;
 35:         }
 36:         // 根据经纬度计算距离
 37:         return getDistance($addressLatAndLong['location']['lat'], $addressLatAndLong['location']['lng'], $merLat, $merLong);
 38:     }
 39:     /**
 40:      * 距离溢价计算
 41:      *
 42:      * @param integer $takeId
 43:      * @param integer $merId
 44:      * @param array $config
 45:      * @param array|string $address
 46:      * @return float
 47:      */
 48:     protected function distanceStackFee(int $takeId, int $merId,  array $config, $address): float
 49:     {
 50:         $fee = 0;
 51:         // 提货点
 52:         $deliveryStation = app()->make(DeliveryStationRepository::class)->deliveryStationInfo($takeId, $merId);
 53:         // 配送距离
 54:         $distance = $this->getAddressDistance($deliveryStation['lat'], $deliveryStation['lng'], $address);
 55:         // 小于第一等级距离
 56:         if ($distance <= $config['level_first']['lt_distance']) {
 57:             return $fee;
 58:         }
 59:         // 阶梯范围
 60:         if (!empty($config['level_stairs'])) {
 61:             foreach ($config['level_stairs'] as $level) {
 62:                 if(!$level['add_distance']) {
 63:                     throw new ValidateException('商户阶梯配送费设置错误，阶梯增加距离不能为0');
 64:                 };
 65: 
 66:                 if ($distance >= $level['end_distance']) {
 67:                     $exceedDistance = bcsub($level['end_distance'], $level['start_distance'], 2);
 68:                     $fee += bcmul(ceil(bcdiv($exceedDistance, $level['add_distance'], 2)), $level['add_amount']);
 69:                 }
 70:                 if ($distance > $level['start_distance'] && $distance <= $level['end_distance']) {
 71:                     $exceedDistance = bcsub($distance, $level['start_distance'], 2);
 72:                     $fee += bcmul(ceil(bcdiv($exceedDistance, $level['add_distance'], 2)), $level['add_amount']);
 73:                 }
 74:             }
 75:         }
 76:         // 最后等级距离
 77:         if ($distance > $config['level_last']['gt_distance']) {
 78:             $exceedDistance = bcsub($distance, $config['level_last']['gt_distance'], 2);
 79:             $fee += bcmul(ceil(bcdiv($exceedDistance,  $config['level_last']['add_distance'], 2)), $config['level_last']['add_amount']);
 80:         }
 81: 
 82:         return $fee;
 83:     }
 84:     /**
 85:      * 重量溢价计算
 86:      *
 87:      * @param float $totalWeight
 88:      * @param array $config
 89:      * @return float
 90:      */
 91:     protected function weightStackFee(float $totalWeight, array $config): float
 92:     {
 93:         $fee = 0;
 94:         // 小于第一等级重量
 95:         if ($totalWeight <= $config['level_first']['lt_weight']) {
 96:             return $fee;
 97:         }
 98:         // 阶梯范围
 99:         if (!empty($config['level_stairs'])) {
100:             foreach ($config['level_stairs'] as $level) {
101:                 if(!$level['add_weight']) {
102:                     throw new ValidateException('商户阶梯配送费设置错误，阶梯增加重量不能为0');
103:                 };
104: 
105:                 if ($totalWeight >= $level['end_weight']) {
106:                     $exceedWeight = bcsub($level['end_weight'], $level['start_weight'], 2);
107:                     $fee += bcmul(ceil(bcdiv($exceedWeight, $level['add_weight'], 2)), $level['add_amount']);
108:                 }
109:                 if ($totalWeight > $level['start_weight'] && $totalWeight <= $level['end_weight']) {
110:                     $exceedWeight = bcsub($totalWeight, $level['start_weight'], 2);
111:                     $fee += bcmul(ceil(bcdiv($exceedWeight, $level['add_weight'], 2)), $level['add_amount']);
112:                 }
113:             }
114:         }
115:         // 最后等级重量
116:         if ($totalWeight > $config['level_last']['gt_weight']) {
117:             $exceedWeight = bcsub($totalWeight, $config['level_last']['gt_weight'], 2);
118:             $fee += bcmul(ceil(bcdiv($exceedWeight, $config['level_last']['add_weight'], 2)), $config['level_last']['add_amount']);
119:         }
120: 
121:         return $fee;
122:     }
123:     /**
124:      * 检查一个点是否在多边形内部
125:      * 使用射线法判断点是否在多边形内
126:      * 从该点向右发射一条射线，计算与多边形边的交点数
127:      * 如果交点数为奇数，则点在多边形内部；如果为偶数，则在外部
128:      *
129:      * @param array $fence 围栏数据,包含多边形的顶点坐标
130:      * @param array $addressLatAndLong 需要判断的点的坐标
131:      * @return bool 返回点是否在多边形内
132:      */
133:     protected function checkInPolygon(array $fence, array $addressLatAndLong): bool
134:     {
135:         // 获取多边形的所有顶点
136:         $paths = $fence['data']['paths'];
137:         // 获取需要判断的点的坐标
138:         $lat = $addressLatAndLong['location']['lat'];
139:         $lng = $addressLatAndLong['location']['lng'];
140:         // 初始化判断结果
141:         $inside = false;
142:         // 遍历多边形的所有边
143:         $j = count($paths) - 1;
144:         foreach ($paths as $i => $path) {
145:             // 获取当前点的纬度和经度
146:             $xi = $path['lat'];  // 当前点的纬度
147:             $yi = $path['lng'];  // 当前点的经度
148:             // 获取上一个点的纬度和经度
149:             $xj = $paths[$j]['lat'];  // 上一个点的纬度
150:             $yj = $paths[$j]['lng'];  // 上一个点的经度
151:             // 判断射线是否与当前边相交
152:             // 1: 边的两个端点一个在射线上方一个在下方; 2: 点的水平坐标小于边在该点纵坐标处的水平坐标
153:             $intersect = (($yi > $lng) != ($yj > $lng)) &&
154:                 ($lat < (bcsub($xj, $xi, 8)) * bcdiv(bcsub($lng, $yi, 8), bcsub($yj, $yi, 8), 8) + $xi);
155:             // 如果相交,则改变内外性
156:             if ($intersect) {
157:                 $inside = !$inside;
158:             }
159:             $j = $i;
160:         }
161: 
162:         return $inside;
163:     }
164:     /**
165:      * 检查一个点是否在圆形配送范围内
166:      * 使用欧几里得距离公式计算点到圆心的距离，判断是否在圆的半径范围内
167:      *
168:      * @param array $fence 圆形围栏数据,包含半径和圆心坐标
169:      * @param array $addressLatAndLong 需要判断的点的坐标
170:      * @return bool 返回点是否在圆内
171:      */
172:     protected function checkInCircle(array $fence, array $addressLatAndLong): bool
173:     {
174:         // 获取圆的半径(米)
175:         $radius = $fence['data']['radius'];
176:         // 获取圆心坐标
177:         $center = $fence['data']['center'];
178: 
179:         // 获取需要判断的点的坐标
180:         $lat = $addressLatAndLong['location']['lat'];
181:         $lng = $addressLatAndLong['location']['lng'];
182:         // 使用getDistance方法计算两点之间的实际距离(米)
183:         $distance = getDistance(
184:             $lat,
185:             $lng,
186:             $center['lat'],
187:             $center['lng']
188:         ) * 1000;
189:         // 如果实际距离小于等于半径,则点在圆内
190:         return $distance <= $radius;
191:     }
192:     /**
193:      * 检查一个点是否在矩形配送范围内
194:      * 通过判断点的经纬度是否在矩形的边界范围内来确定
195:      *
196:      * @param array $fence 矩形围栏数据,包含矩形的最小最大经纬度边界
197:      * @param array $addressLatAndLong 需要判断的点的坐标
198:      * @return bool 返回点是否在矩形内
199:      */
200:     protected function checkInRectangle(array $fence, array $addressLatAndLong): bool
201:     {
202:         // 获取矩形的中心点和宽高数据
203:         $center = $fence['data']['center'];
204:         $width = $fence['data']['width'];
205:         $height = $fence['data']['height'];
206:         // 获取需要判断的点的纬度和经度
207:         $lat = $addressLatAndLong['location']['lat'];
208:         $lng = $addressLatAndLong['location']['lng'];
209:         // 将米转换为经纬度差
210:         // 纬度1度约等于111000米，经度1度约等于111000*cos(纬度)米
211:         $latPerMeter = 1 / 111000;  // 每米对应的纬度差
212:         $lngPerMeter = 1 / (111000 * cos(deg2rad((float)$center['lat']))); // 每米对应的经度差
213:         // 计算矩形的边界范围
214:         $halfWidthDegree = bcdiv($width, 2, 8) * $lngPerMeter;
215:         $halfHeightDegree = bcdiv($height, 2, 8) * $latPerMeter;
216:         $minLat = bcsub($center['lat'], $halfHeightDegree, 8);
217:         $maxLat = bcadd($center['lat'], $halfHeightDegree, 8);
218:         $minLng = bcsub($center['lng'], $halfWidthDegree, 8);
219:         $maxLng = bcadd($center['lng'], $halfWidthDegree, 8);
220:         // 判断点的坐标是否在矩形的边界范围内
221:         return $lat >= $minLat &&
222:             $lat <= $maxLat &&
223:             $lng >= $minLng &&
224:             $lng <= $maxLng;
225:     }
226:     /**
227:      * 检查一个点是否在椭圆配送范围内
228:      * 使用椭圆标准方程 (x-x0)²/a² + (y-y0)²/b² = 1 判断点是否在椭圆内
229:      * 其中(x0,y0)为椭圆中心点坐标，a和b分别为椭圆的长半轴和短半轴
230:      *
231:      * @param array $fence 椭圆围栏数据,包含椭圆的中心点坐标和长短半轴长度
232:      * @param array $addressLatAndLong 需要判断的点的坐标
233:      * @return bool 返回点是否在椭圆内
234:      */
235:     protected function checkInEllipse(array $fence, array $addressLatAndLong): bool
236:     {
237:         // 获取椭圆的参数数据
238:         $ellipse = $fence['data'];
239:         // 获取需要判断的点的纬度和经度
240:         $lat = $addressLatAndLong['location']['lat'];
241:         $lng = $addressLatAndLong['location']['lng'];
242:         // 获取椭圆中心点的坐标
243:         $x0 = $ellipse['center']['lat'];
244:         $y0 = $ellipse['center']['lng'];
245:         // 计算经度每米对应的度数(与纬度有关)
246:         $lngPerMeter = 1 / (111000 * cos(deg2rad((float)$x0)));
247:         // 获取椭圆的长半轴和短半轴(单位:米转换为度)
248:         $latRadius = bcdiv($ellipse['minorRadius'], 111000, 8); // 纬度方向半径(短半轴)
249:         $lngRadius = $lngPerMeter * $ellipse['majorRadius']; // 经度方向半径(长半轴)
250:         // 使用椭圆方程判断点是否在椭圆内
251:         // 如果 (x-x0)²/a² + (y-y0)²/b² <= 1，则点在椭圆内或椭圆上
252:         return bcadd(bcpow(bcdiv(bcsub($lat, $x0, 8), $latRadius, 8), 2, 8), bcpow(bcdiv(bcsub($lng, $y0, 8), $lngRadius, 8), 2, 8), 8) <= 1;
253:     }
254: }
