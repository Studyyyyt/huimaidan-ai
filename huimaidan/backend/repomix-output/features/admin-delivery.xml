327:     /**
328:      * 发送请求
329:      *
330:      * @param string $api
331:      * @param array $params
332:      * @return void
333:      */
334:     public function sendRequest($api, $params = [])
335:     {
336:         $url = self::BASE_URL . $api;
337:         $requestParams = $this->bulidRequestParams($params);
338:         $response = $this->httpRequestWithPost($url, json_encode($requestParams));
339:         $data = $this->getMessage($response);
340:         return $data['body'];
341:     }
342:     /**
343:      * 构建请求参数
344:      *
345:      * @param array $params
346:      * @return array
347:      */
348:     public function bulidRequestParams(array $params = [])
349:     {
350:         $requestParams['biz'] = $params ? json_encode($params) : '';
351:         $requestParams['openid'] = $this->config['open_id'];
352:         $requestParams['timestamp'] = time();
353:         $requestParams['sign'] = $this->_sign($requestParams);
354: 
355:         return $requestParams;
356:     }
357:     /**
358:      * 生成签名
359:      *
360:      * @param array $params
361:      * @return string
362:      */
363:     public function _sign($params)
364:     {
365:         ksort($params);
366:         $str = $params['biz'] . $this->config['app_key'] . $params['timestamp'];
367:         return strtoupper(md5($str));
368:     }
369:     /**
370:      * 发送POST请求
371:      *
372:      * @param string $url
373:      * @param string $data
374:      * @return void
375:      */
376:     public function httpRequestWithPost($url, $data)
377:     {
378:         $appId = $this->config['app_id'];
379:         $headers = array(
380:             "Content-Type: application/json",
381:             "X-App-Id: {$appId}"
382:         );
383: 
384:         $curl = curl_init($url);
385:         curl_setopt($curl, CURLOPT_URL, $url);
386:         curl_setopt($curl, CURLOPT_HEADER, false);
387:         curl_setopt($curl, CURLOPT_POST, true);
388:         curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
389:         curl_setopt($curl, CURLOPT_POSTFIELDS, $data);
390:         curl_setopt($curl, CURLOPT_TIMEOUT, 3);
391:         curl_setopt($curl, CURLOPT_HTTPHEADER, $headers);
392:         $resp = curl_exec($curl);
393:         $info = curl_getinfo($curl);
394:         curl_close($curl);
395:         return $resp;
396:     }
397:     /**
398:      * 获取错误信息
399:      *
400:      * @param $json
401:      * @param string $message
402:      * @return void
403:      */
404:     protected function getMessage($json, $message = '接口请求异常,请稍后重试')
405:     {
406:         $data = json_decode($json, true);
407:         if (!$data) {
408:             Log::info('【UU跑腿提示错误】:' . $message);
409:             throw new ValidateException('【UU跑腿提示错误】:' . $message);
410:         }
411:         if ($data['code'] !== 1) {
412:             Log::info('【UU跑腿提示错误】:' . $data['msg']);
413:             throw new ValidateException('【UU跑腿提示错误】:' . $data['msg']);
414:         }
415: 
416:         return $data;
417:     }
