636:     /**
637:      * 生成订单编号
638:      *
639:      * 本函数用于生成唯一的订单编号。编号由时间戳和随机数组成，确保了编号的唯一性和可追踪性。
640:      * 时间戳部分精确到毫秒，增加了编号的唯一性，随机数部分进一步确保了即使在毫秒级别内有多个订单生成，也能得到不同的编号。
641:      *
642:      * @return string 返回生成的订单编号
643:      */
644:     public function getOrderSn()
645:     {
646:         // 获取当前时间的微秒和秒部分
647:         list($msec, $sec) = explode(' ', microtime());
648: 
649:         // 将微秒和秒转换为毫秒，并格式化为整数，用于订单编号的时间戳部分
650:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
651: 
652:         // 生成订单编号：前缀 + 毫秒时间戳 + 随机数
653:         // 使用'dc'作为前缀，表示订单编号的来源或类型
654:         // 随机数生成范围确保大于毫秒时间戳转换的整数，避免重复，并且预设了一个最小值98369，以保持编号的一定长度和特征
655:         $orderId = 'dc' . $msectime . random_int(10000, max(intval($msec * 10000) + 10000, 98369));
656: 
657:         return $orderId;
658:     }
