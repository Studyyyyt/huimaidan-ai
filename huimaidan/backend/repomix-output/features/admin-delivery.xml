875:         $order = $this->orderInfo($orderId, $merId);
876:         if($order->status == 2) {
877:             throw new ValidateException('订单已确认！');
878:         }
879:         try {
880:             Db::transaction(function () use ($order, $serviceLogId) {
881:                 // 配送完成
882:                 if($order->deliveryOrder) {
883:                     $order->deliveryOrder->status = 4;
884:                     $order->deliveryOrder->save();
885:                 }
886:                 // 更新订单状态：待评价
887:                 $order->status = 2;
888:                 $order->save();
889:                 // 构建订单状态变更信息
890:                 $orderStatus = [
891:                     'order_id' => $order->order_id,
892:                     'order_sn' => $order->order_sn,
893:                     'type' => StoreOrderStatusRepository::TYPE_ORDER,
894:                     'change_message' => '订单已确认',
895:                     'change_type' => StoreOrderStatusRepository::ORDER_STATUS_TAKE,
896:                 ];
897:                 //订单记录
898:                 $user = app()->make(UserRepository::class)->get($order['uid']);
899:                 app()->make(StoreOrderRepository::class)->takeAfter($order, $user);
900:                 // 根据服务人员ID是否存在，分别记录服务人员日志或管理员日志
901:                 $storeOrderStatusRepository = app()->make(StoreOrderStatusRepository::class);
902:                 if ($serviceLogId) {
903:                     $storeOrderStatusRepository->createServiceLog($serviceLogId, $orderStatus);
904:                 } else {
905:                     $storeOrderStatusRepository->createAdminLog($orderStatus);
906:                 }
907:             });
908: 
909:             return true;
910:         } catch (\Exception $e) {
911:             throw new ValidateException('失败：' . $e->getMessage());
912:         }
913:     }
914:     /**
915:      * 获取配送订单ID
916:      * @param array $where
917:      * @return array
918:      */
919:     public function getOrderIds(array $where)
920:     {
921:         $orderIds = $this->dao->search($where)->column('order_id');
922:         return $orderIds;
923:     }
924:     /**
925:      * 配送提成计算
926:      *
927:      * @param object $station
928:      * @param object $order
929:      * @return void
930:      */
931:     protected function getServiceFee($station, $order)
932:     {
933:         $deliveryConfigRepository = app()->make(DeliveryConfigRepository::class);
934:         $deliverySettings = $deliveryConfigRepository->getDeliveryConfig($order['mer_id']);
935:         if (!$deliverySettings) {
936:             throw new ValidateException('商户：【' . $deliverySettings['merchant']['mer_name'] . '】，未设置配送费用信息，无法计算配送费');
937:         }
938:         // 如果不包邮，直接计算
939:         if($order['pay_postage'] > 0) {
940:             return bcmul(bcdiv($deliverySettings['commission_rate'], 100, 2), $order['pay_postage'], 2);
941:         }
942:         // 如果包邮，需要先获取到配送费再计算
943:         // 计算重量
944:         $totalWeight = 0;
945:         foreach($order['orderProduct'] as $item) {
946:             $totalWeight += $item['cart_info']['productAttr']['weight'] * $item['product_num'];
947:         }
948: 
949:         $fee = $deliveryConfigRepository->deliveryFee(
950:             $station['station_id'],
951:             $totalWeight,
952:             $deliverySettings->toArray(),
953:             $order['user_address']
954:         );
955: 
956:         return bcmul(bcdiv($deliverySettings['commission_rate'], 100, 2), $fee, 2);
957:     }
958: 
959:     public function getDeliveryTrack($deliveryOrder)
960:     {
961:         try {
962:             $data['order_code'] = $deliveryOrder['order_code'];
963:             $data['origin_id'] = $deliveryOrder['order_sn'];
964: 
965:             return DeliverySevices::create($deliveryOrder['station_type'], $deliveryOrder['mer_id'])->getDeliveryTrack($data);
966:         } catch (\Exception $e) {
967:             return [];
968:         }
969:     }
970: }
