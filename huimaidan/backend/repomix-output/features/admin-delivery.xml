401:     {
402:         $lat = 0;
403:         $lng = 0;
404:         if($params['switch_city']) {
405:             $params['mer_delivery_type'] = merchantConfig($params['mer_id'], 'mer_delivery_type');
406:             $address = app()->make(UserAddressRepository::class)->get($params['address_id'], $params['uid']);
407:             $addressDetail = $address['province'] . $address['city'] . $address['district'] . $address['street'] . $address['detail'];
408:             $addressLatAndLong = lbs_address([], $addressDetail);
409: 
410:             $lat = $addressLatAndLong['location']['lat'];
411:             $lng = $addressLatAndLong['location']['lng'];
412:         }
413:         if($params['switch_take']) {
414:             $lat = $params['latitude'];
415:             $lng = $params['longitude'];
416:         }
417:         unset($params['switch_city'], $params['latitude'], $params['longitude']);
418: 
419:         // 获取提货点列表
420:         $list = $this->dao->search($params)->order('station_id DESC,create_time DESC')->select()->toArray();
421:         if ($lat && $lng) {
422:             // 计算距离
423:             foreach($list as &$item){
424:                 $stationLat = $item['lat'];
425:                 $stationLong = $item['lng'];
426:                 $item['distance'] = '';
427:                 $item['distanceM'] = 0;
