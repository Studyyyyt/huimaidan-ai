339:     /**
340:      * 构造请求数据
341:      *
342:      * @param array $params
343:      * @return void
344:      */
345:     public function bulidRequestParams($params)
346:     {
347:         $requestParams = array();
348:         $requestParams['app_key'] = $this->config['app_key'];
349:         $requestParams['body'] = json_encode($params);
350:         $requestParams['format'] = 'json';
351:         $requestParams['v'] = '1.0';
352:         $requestParams['source_id'] = $this->config['source_id'];
353:         $requestParams['timestamp'] = time();
354:         $requestParams['signature'] = $this->_sign($requestParams);
355:         return json_encode($requestParams);
356:     }
357:     /**
358:      * 签名生成signature
359:      *
360:      * @param array $data
361:      * @return void
362:      */
363:     public function _sign($data)
364:     {
365:         //1.升序排序
366:         ksort($data);
367:         //2.字符串拼接
368:         $args = "";
369:         foreach ($data as $key => $value) {
370:             $args .= $key . $value;
371:         }
372:         $args = $this->config['app_secret'] . $args . $this->config['app_secret'];
373:         //3.MD5签名,转为大写
374:         $sign = strtoupper(md5($args));
375:         return $sign;
376:     }
377:     /**
378:      * 发送请求,POST
379:      *
380:      * @param string $url
381:      * @param array $data
382:      * @param array $headers
383:      * @return void
384:      */
385:     public function httpRequestWithPost($url, $data, $headers = [])
386:     {
387:         $headers = array(
388:             'Content-Type: application/json',
389:         );
390:         $curl = curl_init($url);
391:         curl_setopt($curl, CURLOPT_URL, $url);
392:         curl_setopt($curl, CURLOPT_HEADER, false);
393:         curl_setopt($curl, CURLOPT_POST, true);
394:         curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
395:         curl_setopt($curl, CURLOPT_POSTFIELDS, $data);
396:         curl_setopt($curl, CURLOPT_TIMEOUT, 3);
397:         curl_setopt($curl, CURLOPT_HTTPHEADER, $headers);
398:         $resp = curl_exec($curl);
399:         $info = curl_getinfo($curl);
400:         curl_close($curl);
401:         if (isset($info['http_code']) && $info['http_code'] == 200) {
402:             return $resp;
403:         }
404:         return;
405:     }
406:     /**
407:      * 获取错误信息
408:      *
409:      * @param $json
410:      * @param string $message
411:      * @return void
412:      */
413:     protected function getMessage($json, $message = '接口请求异常,请稍后重试')
414:     {
415:         $data = json_decode($json, true);
416:         if(!$data) {
417:             Log::info('【达达错误提示】:' . $message);
418:             throw new ValidateException('【达达错误提示】:' . $message);
419:         }
420: 
421:         if ($data['code'] !== 0) {
422:             isset($data['msg']) && $message = $data['msg'];
423:             if ($data['errorCode'] == 7718) {
424:                 foreach ($data['result']['failedList'] as $datum) {
425:                     $message .= ':' . $datum['shopName'] . '/' . $datum['msg'] . ';';
426:                 }
427:             }
428:             Log::info('【达达错误提示】:' . $message . ', 错误码:' . $data['errorCode']);
429:             throw new ValidateException('【达达错误提示】:' . $message);
430:         } else {
431:             if ($data['status'] == 'success') return $data['result'] ?? $data;
432:             return $data;
433:         }
434:     }
435: }
