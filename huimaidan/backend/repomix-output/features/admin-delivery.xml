440:     public function create($id, $merId, $data, $order)
441:     {
442:         $type = $order->take->type;
443:         $where = ['station_id' => $order['merchant_take_id'], 'mer_id' => $merId, 'status' => 1, 'type' => $type];
444:         $station = app()->make(DeliveryStationRepository::class)->getWhere($where);
445: 
446:         if (!$station) {
447:             Log::info('同城配送创建订单，门店信息不存在');
448:             return false;
449:         }
450:         if (!$station['city_name']) {
451:             Log::info('同城配送创建订单，门店缺少所在城市，请重新编辑门店信息');
452:             return false;
453:         }
454:         //地址转经纬度
455:         $addres = lbs_address([], $order['user_address']);
456:         $location = $addres['location'];
457:         // UU坐标转换为百度坐标
458:         if ($type == DeliverySevices::DELIVERY_TYPE_UU) {
459:             [$station['lng'], $station['lat']] = gcj02ToBd09($station['lng'], $station['lat']);
460:             [$location['lng'], $location['lat']] = gcj02ToBd09($addres['location']['lng'], $addres['location']['lat']);
461:         }
462: 
463:         try {
464:             $service = DeliverySevices::create($type, $merId);
465:             $orderSn = $this->getOrderSn();
466:             $callbackUrl = rtrim(systemConfig('site_url'), '/') . '/api/notice/callback';
467:             $weight = array_sum(array_column(array_column(array_column($data, 'cart_info'), 'productAttr'), 'weight'));
468: 
469:             $priceParams = $this->getPriceParams($station, $order, $location, $type, $merId);
470:             $priceParams['cargo_weight'] = max((int)$weight, 1);
471:             $priceParams['shop_no'] = $station['origin_shop_id'];
472:             $priceParams['origin_id'] = $orderSn;
473:             $priceParams['callback_url'] = $callbackUrl;
474:             $priceParams['receiver_lat'] = $addres['location']['lat'];
475:             $priceParams['receiver_lng'] = $addres['location']['lng'];
476:             //计算价格
477:             $priceData = $service->getOrderPrice($priceParams);
478:             if ($type == DeliverySevices::DELIVERY_TYPE_UU) {
479:                 $priceData['shop_no'] = $station['origin_shop_id'];
480:                 $priceData['receiver'] = $order['real_name'];
481:                 $priceData['receiver_phone'] = $order['user_phone'];
482:                 $priceData['note'] = $order['mark'];
483:                 $priceData['callback_url'] = $callbackUrl;
484:                 $priceData['push_type'] = "OPEN_ORDER"; // 测试订单:TEST_ORDER 开放订单:OPEN_ORDER
485:                 $priceData['special_type'] = 'NOT_NEED_WARM'; // NEED_WARM
486:             }
487:             //发布订单
488:             $res = $service->addOrder($priceData);
489: 
490:             $ret = [
491:                 'station_id' => $order['merchant_take_id'],
492:                 'order_sn' => $orderSn,
493:                 'city_code' => $station['city_name'],
494:                 'receiver_phone' => $order['user_phone'],
495:                 'user_name' => $order['real_name'],
496:                 'from_address' => $station['station_address'],
497:                 'to_address' => $order['user_address'],
498:                 'order_code' => $type == 2 ? $res['orderCode'] : $priceData['deliveryNo'],
499:                 'order_id' => $id,
500:                 'mer_id' => $merId,
501:                 'status' => $res['status'] ?? 0,
502:                 'station_type' => $type,
503:                 'to_lat' => $addres['location']['lat'],
504:                 'to_lng' => $addres['location']['lng'],
505:                 'from_lat' => $station['lat'],
506:                 'from_lng' => $station['lng'],
507:                 'distance' => $priceData['distance'],
508:                 'fee' => $type == 2 ? bcdiv($priceData['needPayMoney'], 100, 2) : $priceData['fee'],
509:                 'mark' => $order['mark'],
510:                 'uid' => $order['uid'],
511:                 'reason' => ''
512:             ];
513:             //入库操作
514:             $this->dao->create($ret);
515: 
516:             return true;
517:         } catch (\Exception $e) {
518:             $merchantTakeInfo = $order['merchant_take_info'] ?? [];
519:             $merchantTakeInfo[$merId]['sync_status'] = -1;
520:             $merchantTakeInfo[$merId]['sync_desc'] = $e->getMessage();
521: 
522:             $order['merchant_take_info'] = json_encode($merchantTakeInfo);
523:             $order->save();
524: 
525:             return false;
526:         }
527:     }
