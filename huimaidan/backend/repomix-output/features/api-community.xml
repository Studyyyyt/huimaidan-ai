643:      *
644:      * 此函数用于处理社区内容的删除操作。它首先触发一个名为'community.delete.before'的事件，
645:      * 允许任何监听此事件的组件在实际删除操作之前进行干预。接下来，它从数据库中获取指定ID的内容信息，
646:      * 并将该内容的删除标记设置为1，执行实际的删除逻辑。随后，它减少与该内容关联的用户的内容计数，
647:      * 这反映了内容数量的变化。最后，它触发'community.delete'事件，允许其他组件在删除操作完成后执行额外的操作。
648:      *
649:      * @param int $id 内容的唯一标识符
650:      * @param null|$user 删除操作的用户信息，默认为null，表示任何用户都可以执行此操作
651:      */
652:     public function destory($id, $user = null)
653:     {
654:         // 在执行删除操作之前触发事件，允许其他组件或功能进行干预
655:         event('community.delete.before', compact('id', 'user'));
656: 
657:         // 从数据库中获取指定ID的内容信息
658:         $info = $this->dao->get($id);
659: 
660:         // 将内容的删除状态设置为已删除
661:         $this->dao->update($id, ['is_del' => 1]);
662: 
663:         // 减少与该内容关联的用户的内容计数，反映内容的删除
664:         // 内容数统计
665:         app()->make(UserRepository::class)->decField((int)$info['uid'], 'count_content');
666: 
667:         // 删除操作完成后触发事件，允许其他组件或功能执行后续操作
668:         event('community.delete', compact('id', 'user'));
669:     }
