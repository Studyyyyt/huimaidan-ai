209:     /**
210:      * 删除指定ID的帖子
211:      *
212:      * 本函数通过使用事务处理来确保删除操作的完整性。它首先检查帖子是否存在父帖子，
213:      * 如果存在，则减少父帖子的回复计数。然后，它减少关联社区的回复计数。最后，它删除指定的帖子。
214:      * 使用事务的原因是为了避免在操作过程中发生的数据不一致问题。
215:      *
216:      * @param int $id 帖子的唯一标识符
217:      */
218:     public function delete($id)
219:     {
220:         // 开启事务处理
221:         Db::transaction(function () use ($id) {
222:             // 获取要删除的帖子评论
223:             $get = $this->dao->get($id);
224:             // 实例化社区仓库类
225:             $make = app()->make(CommunityRepository::class);
226: 
227:             // 如果帖子有父帖子，减少父帖子的回复计数
228:             if ($get->pid) $this->dao->decField($get['pid'], 'count_reply', 1);
229:             // 减少帖子的回复计数
230:             $make->decField($get['community_id'], 'count_reply', 1);
231: 
232:             // 删除帖子的评论
233:             $get->delete();
234:         });
235:     }
