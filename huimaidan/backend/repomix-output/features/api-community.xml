 36:      * User constructor.
 37:      * @param App $app
 38:      * @param  $repository
 39:      */
 40:     public function __construct(App $app, repository $repository)
 41:     {
 42:         parent::__construct($app);
 43:         $this->repository = $repository;
 44:         if (!systemConfig('community_status')) throw  new ValidateException('未开启社区功能');
 45:     }
 46: 
 47:     /**
 48:      * 列表
 49:      * @return mixed
 50:      * @author Qinii
 51:      */
 52:     public function lst($id)
 53:     {
 54:         if (!systemConfig('community_reply_status'))
 55:             return app('json')->success([
 56:                 'count' => 0,
 57:                 'all' => 0,
 58:                 'start' => 0,
 59:                 'list' => []
 60:             ]);
 61:         $where['community_id'] = $id;
 62:         [$page, $limit] = $this->getPage();
 63:         $userInfo = $this->request->isLogin() ? $this->request->userInfo() : null;
 64:         return app('json')->success($this->repository->getApiList($where, $page, $limit, $userInfo));
 65:     }
 66: 
 67:     /**
 68:      *  发评论
 69:      * @param $id
 70:      * @return \think\response\Json
 71:      * @author Qinii
 72:      * @day 10/29/21
 73:      */
 74:     public function create($id)
 75:     {
 76:         if (!systemConfig('community_reply_status'))
 77:             return app('json')->fail('评论功能未开启');
 78:         if (systemConfig('community_reply_auth') && !$this->request->userInfo()->phone)
 79:             return app('json')->fail('请先绑定手机号');
 80: 
 81:         $replyId = $this->request->param('reply_id', 0);
 82: 
 83:         $data = $this->request->params(['content']);
 84:         if (empty($data['content'])) return app('json')->fail('请输入回复内容');
 85:         MiniProgramService::create()->msgSecCheck($this->request->userInfo(), $data['content'],2,0);
 86:         $data['uid'] = $this->request->userInfo()->uid;
 87:         $data['community_id'] = $id;
 88: 
 89:         $data['status'] = 1;
 90:         $msg = '回复成功';
 91:         if (systemConfig('community_reply_audit')) {
 92:             $data['status'] = 0;
 93:             $msg = '回复成功,正在审核中';
 94:         }
 95:         $ret = $this->repository->create($replyId, $data);
 96:         return app('json')->success($msg, $ret);
 97:     }
 98: 
 99:     /**
100:      * 删除评论
101:      * @param $id
102:      * @return \think\response\Json
103:      * @author Qinii
104:      * @day 10/29/21
105:      */
106:     public function delete($id)
107:     {
108:         if (!$this->repository->uidExists($id, $this->request->userInfo()->uid))
109:             return app('json')->fail('评论不存在');
110:         $this->repository->delete($id);
111:         return app('json')->success('评论删除');
112:     }
113: 
114:     /**
115:      *  评论点赞
116:      * @param $id
117:      * @return \think\response\Json
118:      * @author Qinii
119:      * @day 10/29/21
120:      */
121:     public function start($id)
122:     {
123:         if (!systemConfig('community_reply_status'))
124:             return app('json')->success('评论不存在');
125:         $status = $this->request->param('status') == 1 ? 1 : 0;
126:         if (!$this->repository->exists($id))
127:             return app('json')->fail('评论不存在');
128: 
129:         $uid = $this->request->userInfo()->uid;
130:         $this->repository->setStart($id, $uid, $status);
131:         if ($status) {
132:             return app('json')->success('点赞成功');
133:         } else {
134:             return app('json')->success('取消点赞');
135:         }
136:     }
137: }
