 23: 
 24: /**
 25:  * 社区评论
 26:  */
 27: class CommunityReplyRepository extends BaseRepository
 28: {
 29:     /**
 30:      * @var CommunityReplyDao
 31:      */
 32:     protected $dao;
 33: 
 34:     /**
 35:      * CommunityReplyRepository constructor.
 36:      * @param CommunityReplyDao $dao
 37:      */
 38:     public function __construct(CommunityReplyDao $dao)
 39:     {
 40:         $this->dao = $dao;
 41:     }
 42: 
 43:     /**
 44:      * 获取列表数据
 45:      *
 46:      * 根据给定的条件和分页信息，从数据库中检索满足条件的数据列表。此方法主要用于查询文章或帖子等信息，
 47:      * 同时附带作者、社区和回复等相关信息，以丰富的数据集合形式返回。
 48:      *
 49:      * @param array $where 查询条件数组，用于指定查询的数据项。
 50:      * @param int $page 当前页码，用于分页查询。
 51:      * @param int $limit 每页数据的数量，用于分页查询。
 52:      * @return array 返回包含总数和列表数据的数组。
 53:      */
 54:     public function getList(array $where, int $page, int $limit)
 55:     {
 56:         // 默认不查询已删除的数据
 57:         $where['is_del'] = 0;
 58: 
 59:         // 构建查询，同时加载关联信息，如社区、作者和回复等
 60:         $query = $this->dao->search($where)->with([
 61:             'community' => function ($query) {
 62:                 // 加载社区的基本信息，包括社区ID和标题
 63:                 $query->field('community_id,title');
 64:             },
 65:             'author' => function ($query) {
 66:                 // 加载作者的信息，包括用户ID、昵称和头像
 67:                 $query->field('uid,nickname,avatar');
 68:             },
 69:             'reply' => function ($query) {
 70:                 // 加载第一条回复的信息，包括用户ID、昵称和头像
 71:                 $query->field('uid,nickname,avatar');
 72:             },
 73:             'hasReply' => function ($query) {
 74:                 // 加载是否含有回复的信息，包括回复的父ID、回复ID和状态
 75:                 $query->field('pid, reply_id, status');
 76:             },
 77:         ]);
 78: 
 79:         // 计算满足条件的数据总数
 80:         $count = $query->count();
 81: 
 82:         // 根据当前页码和每页数据数量，获取满足条件的数据列表
 83:         $list = $query->page($page, $limit)->select();
 84: 
 85:         // 将数据总数和数据列表打包成数组返回
 86:         return compact('count', 'list');
 87:     }
 88: 
 89: 
 90:     /**
 91:      * 获取API列表
 92:      * 根据给定的条件和分页信息，获取社区内容的列表。
 93:      * 这包括对内容存在性的验证，以及根据用户信息和条件进行的特定查询设置。
 94:      *
 95:      * @param array $where 查询条件数组，包含社区ID等条件
 96:      * @param int $page 当前页码
 97:      * @param int $limit 每页显示的数量
 98:      * @param object $userInfo 用户信息对象，包含用户ID等
 99:      * @return array 返回包含所有、开始、计数和列表的数组
100:      * @throws ValidateException 如果内容不存在则抛出异常
101:      */
102:     public function getApiList(array $where, int $page, int $limit, $userInfo)
103:     {
104:         // 实例化社区仓库类
105:         $make = app()->make(CommunityRepository::class);
106: 
107:         // 设置显示状态的查询条件
108:         $where_ = CommunityRepository::IS_SHOW_WHERE;
109:         // 初始化查询条件中的社区ID
110:         $where_['community_id'] = $where['community_id'];
111: 
112:         // 如果用户信息存在，并且用户ID存在于指定的社区中，则修改查询条件
113:         if ($userInfo && $make->uidExists((int)$where['community_id'], $userInfo->uid)) {
114:             $where_ = ['is_del' => 0];
115:         }
116: 
117:         // 重新设置社区ID的查询条件
118:         $where_['community_id'] = $where['community_id'];
119: 
120:         // 验证内容是否存在
121:         if (!$make->getWhereCount($where_)) {
122:             throw new ValidateException('内容不存在，可能被删删除了哦～');
123:         }
124: 
125:         // 设置查询状态为已发布
126:         $where['status'] = 1;
127:         // 计算符合条件的总内容数量
128:         $all = $this->dao->getSearch($where)->count();
129:         // 计算已开始的内容数量
130:         $start = $this->dao->getSearch($where)->sum('count_start');
131:         // 设置查询父级内容的条件
132:         $where['pid'] = 0;
133: 
134:         // 设置查询顺序和隐藏字段，并加载关联数据
135:         $query = $this->dao->getSearch($where)
136:             ->order('create_time DESC')
137:             ->hidden(['refusal'])
138:             ->with([
139:                 'author' => function ($query) {
140:                     $query->field('uid,nickname,avatar');
141:                 },
142:                 'is_start' => function ($query) use ($userInfo) {
143:                     $query->where('left_id', $userInfo->uid ?? null);
144:                 },
145:                 'children' => [
146:                     'author' => function ($query) {
147:                         $query->field('uid,nickname,avatar');
148:                     },
149:                     'reply' => function ($query) {
150:                         $query->field('uid,nickname,avatar')->order('create_time ASC');
151:                     },
152:                     'is_start' => function ($query) use ($userInfo) {
153:                         $query->where('left_id', $userInfo->uid ?? null);
154:                     }
155:                 ],
156:             ]);
157: 
158:         // 计算查询结果的总数量
159:         $count = $query->count();
160:         // 获取当前页的列表数据
161:         $list = $query->page($page, $limit)->select();
162: 
