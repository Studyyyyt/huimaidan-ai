621:         if (!$giveIntegralConfig['integral_community_give'] || !$giveIntegralConfig['integral_community_give_limit']) {
622:             return false;
623:         }
624:         $uid = $communityInfo->uid;
625:         $createDay = date('Y-m-d', strtotime($communityInfo->create_time));
626:         // 计算用户在当天发布的审核通过的图文内容数量, 判断是否超过每日限制
627:         $communityCount = $this->getWhereCount(['uid' => $uid, 'status' => 1, ['create_time', 'like', $createDay.'%']]);
628:         if($communityCount <= $giveIntegralConfig['integral_community_give_limit']) {
629:             // 使用依赖注入的方式创建用户账单仓库实例，并增加用户的积分账单
630:             app()->make(UserBillRepository::class)->incBill($uid, 'integral', 'lock', [
