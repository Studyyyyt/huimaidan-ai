 53:                     $query->whereLike('real_name',"%{$where['real_name']}%");
 54:                 })
 55:                 ->when(isset($where['nickname']) && $where['nickname'] !==  '', function ($query) use($where) {
 56:                     $query->whereLike('nickname',"%{$where['nickname']}%");
 57:                 });
 58:             $query->where(true);
