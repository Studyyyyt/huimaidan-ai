183:     /**
184:      * 获取可选选项
185:      * 此方法用于查询数据库中符合条件的记录，并将其转换为特定格式的数据，以供前端选择组件使用。
186:      * 查询条件包括状态为激活且未被删除的记录，排序依据是排序值降序和创建时间降序。
187:      * 返回的数据格式为键值对，其中键为topic_id，值为topic_name。
188:      *
189:      * @return array 返回查询结果转换后的数组，如果无数据则返回空数组。
190:      */
191:     public function options()
192:     {
193:         // 查询数据库，获取状态为1，且is_del为0的记录，按sort和create_time降序排列
194:         // 选择字段为topic_id和topic_name，重命名为value和label
195:         $data =  $this->dao->getSearch(['status' => 1,'is_del' =>0])->order('sort DESC,create_time DESC')
196:             ->field('topic_id as value,topic_name as label')->select();
197: 
198:         // 如果查询到数据，将其转换为数组形式
199:         if ($data) $res = $data->toArray();
200: 
201:         // 返回转换后的数据数组
202:         return $res;
203:     }
204: 
205: }
