632:                 'status' => 0, // 积分状态，这里假设0表示积分锁定，即还未完全发放
633:                 'title' => '种草发帖送积分', // 积分的描述，表明积分的来源是种草发帖
634:                 'number' => $giveIntegralConfig['integral_community_give'], // 赠送的积分数量
635:                 'mark' => $communityInfo->author->nickname.'【用户ID: '.$uid.'】于'.$createDay.', 成功发布第' . floatval($communityCount) . '篇种草, 赠送积分' . floatval($giveIntegralConfig['integral_community_give']), // 积分的备注信息
636:                 'balance' => $communityInfo->author->integral // 用户当前的积分余额，用于记录积分的变化
637:             ]);
638:         }
639:     }
