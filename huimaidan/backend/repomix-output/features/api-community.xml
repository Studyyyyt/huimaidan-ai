 64:                     }
 65:                     if($where['search_type'] == 'content'){
 66:                         $query->whereLike('Community.title|Community.content',"%{$where['keyword']}%");
 67:                     }
 68:                     if($where['search_type'] == 'user'){
 69:                         $query->whereLike('User.nickname',"%{$where['keyword']}%");
 70:                     }
 71:                 }
 72:             },function ($query) use ($where) {   // 兼容之前逻辑
 73:                 if(isset($where['keyword']) && $where['keyword'] !==  ''){
 74:                     $query->whereLike('Community.title',"%{$where['keyword']}%");
 75:                 }
 76:             })
 77: //            ->when(isset($where['keyword']) && $where['keyword'] !==  '', function ($query) use($where) {
 78: //                $query->whereLike('Community.title',"%{$where['keyword']}%");
 79: //            })
 80:             ->when(isset($where['uid']) && $where['uid'] !==  '', function ($query) use($where) {
 81:                 $query->where('Community.uid',$where['uid']);
 82:             })
 83:             ->when(isset($where['uids']) && $where['uids'] !==  '', function ($query) use($where) {
 84:                 $query->whereIn('Community.uid',$where['uids']);
 85:             })
 86:             ->when(isset($where['topic_id']) && $where['topic_id'] !==  '', function ($query) use($where) {
 87:                 $query->where('Community.topic_id',$where['topic_id']);
 88:             })
 89:             ->when(isset($where['mer_id']) && $where['mer_id'] !==  '', function ($query) use($where) {
 90:                 $query->where('Community.mer_id',$where['mer_id']);
 91:             })
 92:             ->when(isset($where['community_id']) && $where['community_id'] !==  '', function ($query) use($where) {
 93:                 $query->where('Community.community_id',$where['community_id']);
 94:             })
 95:             ->when(isset($where['not_id']) && $where['not_id'] !==  '', function ($query) use($where) {
 96:                 $query->whereNotIn('Community.community_id',$where['not_id']);
 97:             })
 98:             ->when(isset($where['in_id']) && $where['in_id'] !==  '', function ($query) use($where) {
 99:                 $query->whereOr(function($query) use($where){
100:                     $query->whereIn('Community.community_id',$where['in_id']);
101:                 });
102:             })
103:             ->when(isset($where['community_ids']) && $where['community_ids'] !==  '', function ($query) use($where) {
104:                 $query->whereIn('Community.community_id',$where['community_ids']);
105:             })
106:             ->when(isset($where['is_type']) && $where['is_type'] !==  '', function ($query) use($where) {
107:                 $query->whereIn('Community.is_type',$where['is_type']);
108:             })
109:             ->when(isset($where['is_show']) && $where['is_show'] !==  '', function ($query) use($where) {
110:                 $query->where('Community.is_show',$where['is_show']);
111:             })
112:             ->when(isset($where['status']) && $where['status'] !==  '', function ($query) use($where) {
113:                 $query->where('Community.status',$where['status']);
114:             })
115:             ->when(isset($where['start']) && $where['start'] !==  '', function ($query) use($where) {
116:                 $query->where('Community.start',$where['start']);
117:             })
118:             ->when(isset($where['is_del']) && $where['is_del'] !==  '', function ($query) use($where) {
119:                 $query->where('Community.is_del',$where['is_del']);
120:             })
121:             ->when(isset($where['category_id']) && $where['category_id'] !==  '', function ($query) use($where) {
122:                 $query->where('Community.category_id',$where['category_id']);
123:             })
124:             ->when(isset($where['spu_id']) && $where['spu_id'] !==  '', function ($query) use($where) {
125:                 $id = Relevance::where('right_id', $where['spu_id'])
126:                     ->where('type',RelevanceRepository::TYPE_COMMUNITY_PRODUCT)
127:                     ->column('left_id');
128:                 $query->where('community_id','in', $id);
129:             });
130: 
131:         $order = 'Community.create_time DESC';
132: 
133:         if (isset($where['order']) && $where['order'] == 'start') {
134:             $order = 'Community.start DESC,Community.create_time DESC';
135:         }
136: 
137:         $query->order($order);
138:         return $query;
139:     }
