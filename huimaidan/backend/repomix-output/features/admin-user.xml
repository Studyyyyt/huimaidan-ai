260:     /**
261:      * 给指定用户添加支付者信息。
262:      * 该方法用于处理将一个用户与多个新的商户ID关联起来的逻辑。它首先检查哪些商户ID已经与用户关联，
263:      * 然后只处理那些还未关联的商户ID。这样可以避免重复添加相同的关联信息。
264:      *
265:      * @param int $uid 用户ID。表示要添加支付者信息的用户的唯一标识。
266:      * @param array $merIds 商户ID数组。包含要将用户与之关联的所有新的商户ID。
267:      */
268:     public function payer($uid, array $merIds)
269:     {
270:         // 检查已存在的商户ID与用户ID的交集，以避免重复添加
271:         $isset = $this->dao->intersectionPayer($uid, $merIds);
272: 
273:         // 筛选出还未关联的商户ID
274:         $merIds = array_diff($merIds, $isset);
275: 
276:         // 如果没有新的商户ID需要添加，则直接返回
277:         if (!count($merIds)) return;
278: 
279:         // 准备要插入的数据数组
280:         $data = [];
281:         foreach ($merIds as $merId) {
282:             $data[] = [
283:                 'type_id' => $merId,
284:                 'type' => 12, // 这里的类型标识12具体代表什么含义，需要根据实际业务进行解释
285:                 'uid' => $uid
286:             ];
287:         }
288: 
289:         // 批量插入新的支付者信息
290:         $this->dao->insertAll($data);
291:     }
