248: 
249:     /**
250:      * 切换提取状态
251:      * 该方法用于处理提取记录的状态切换，涉及到资金操作和状态通知。
252:      *
253:      * @param int $id 提取记录ID
254:      * @param array $data 提交的数据，包含状态等信息
255:      * @throws ValidateException 如果用户不存在
256:      */
257:     public function switchStatus($id,$data)
258:     {
259:         // 根据提取ID获取提取记录
260:         $extract = $this->dao->getWhere(['extract_id' => $id]);
261:         // 如果提取记录不存在，抛出异常
262:         if(!$extract) {
263:             throw new ValidateException('提取记录不存在');
264:         }
265:         // 如果提取记录状态已被处理，抛出异常
266:         if($extract['status'] !== 0) {
267:             throw new ValidateException('提取记录状态已被处理');
268:         }
269:         // 根据提取记录中的用户ID获取用户信息
270:         $user = app()->make(UserRepository::class)->get($extract['uid']);
271:         // 如果用户不存在，抛出异常
272:         if(!$user) throw new ValidateException('用户不存在');
273:         // 获取系统配置的扩展类型
274:         $type = systemConfig('sys_extension_type');
275:         // 初始化返回数组和支付服务变量
276:         $ret = [];
277:         $service = null;
278:         $func = null;
279:         $brokerage = $user->brokerage_price;
280:         // 初始化佣金价格变量
281:         $brokerage_price = 0;
282:         $out = [];
283:         //同意
284:         if ($data['status'] == 1) {
285:             $out = [
286:                 'type' => 'extract',
287:                 'data' => [
288:                     'link_id' => $id,
289:                     'status' => 1,
290:                     'title' => '佣金提现',
291:                     'number' => $extract['extract_price'],
292:                     'mark' => '成功佣金提现' . floatval($extract['extract_price']) . '元',
293:                     'balance' => $brokerage
294:                 ]
295:             ];
296:             switch ($extract['extract_type']) {
297:                 case self::EXTRACT_TYPE_WEXIN:
298:                     if (in_array($type,[1,2])) {
299:                         // 根据扩展类型确定使用的支付方法
300:                         $func = $type == 1 ? 'merchantPay' : 'companyPay';
301:                         // 构建企业付款所需的信息
302:                         $ret = [
303:                             'sn' => $extract['extract_sn'],
304:                             'price' => $extract['extract_price'],
305:                             'mark' => '企业付款给用户:'.$user->nickname,
306:                             'batch_name' => '企业付款给用户:'.$user->nickname,
307:                             'realName' => $extract['real_name'] ?? ''
308:                         ];
309:                         // 尝试通过微信用户ID获取OpenID
310:                         $openid = app()->make(WechatUserRepository::class)->idByOpenId((int)$user['wechat_user_id']);
311:                         // 如果有OpenID，使用微信服务进行付款
312:                         if ($openid) {
313:                             $ret['openid'] = $openid;
314:                             $service = WechatService::create();
315:                         } else {
316:                             // 如果没有OpenID，尝试获取小程序OpenID
317:                             $routineOpenid = app()->make(WechatUserRepository::class)->idByRoutineId((int)$user['wechat_user_id']);
318:                             // 如果没有小程序OpenID，抛出异常
319:                             if (!$routineOpenid) throw new ValidateException('非微信用户不支持付款到零钱');
320:                             $ret['openid'] = $routineOpenid;
321:                             // 使用小程序服务进行付款
322:                             $service =  MiniProgramService::create();
323:                         }
324:                     }
325:                     break;
326:                 case self::EXTRACT_TYPE_YUE:
327:                     $ret = ['extract' => $extract['extract_price'], 'extract_id' => $id];
328:                     $service = app()->make(UserExtractRepository::class);
329:                     $func = 'toBalance';
330:                     $out = [
331:                         'type' => 'now_money',
332:                         'data' => [
333:                             'link_id' => $id,
334:                             'status' => 1,
335:                             'title' => '佣金转入余额',
336:                             'number' => $extract['extract_price'],
337:                             'mark' => '成功转入余额' . floatval($extract['extract_price']) . '元',
338:                             'balance' => $brokerage
339:                         ]
340:                     ];
341:                     break;
342:                 default:
343:                     break;
344:             }
345:         } else {
346:             // 如果数据中的状态为-1，计算新的佣金价格
347:             $brokerage_price = bcadd($user['brokerage_price'] ,$extract['extract_price'],2);
348:         }
349:         $userBillRepository = app()->make(UserBillRepository::class);
350:         // 使用事务处理以下操作，确保数据的一致性
351:         Db::transaction(function()use($id,$data,$user,$brokerage_price,$ret,$service,$func,$userBillRepository,$out){
352:             // 触发状态切换前的事件
353:             event('user.extractStatus.before',compact('id','data'));
354:             // 如果有返回数组，调用相应的支付方法
355: 
356:             if($data['status'] == 1 && $func) {
357:                 $res = $service->{$func}($ret,$user);
358:                 if ($res && $func == 'companyPay') {
359:                     $this->dao->update(
360:                         $id,
361:                         [
362:                             'package_info' => $res['package_info'],
363:                             'transfer_bill_no' => $res['transfer_bill_no'],
364:                             'wechat_status' => $res['state'],
365:                             'wechat_app_id' => $res['app_id'],
366:                             'wechat_mch_id' => $res['mch_id']
367:                         ]
368:                     );
369:                 };
370:             }
371:             // 如果有计算出的佣金价格，更新用户佣金信息
372:             if($brokerage_price){
373:                 $user->brokerage_price = $brokerage_price;
374:                 $user->save();
375:             }
376:             // 更新提取记录状态
377:             $userExtract = $this->dao->update($id,$data);
378:             if($out) $userBillRepository->decBill($user->uid, 'brokerage', $out['type'], $out['data']);
379:             // 触发状态切换后的事件
380:             event('user.extractStatus',compact('id','userExtract'));
381:         });
