140:     /**
141:      * 提现申请创建函数
142:      * @param User $user 用户对象
143:      * @param array $data 提现数据
144:      * @return Extract 提现记录对象
145:      *
146:      * 该函数用于处理用户的提现申请，包括验证提现条件、更新用户佣金余额、
147:      * 创建提现记录等操作。在执行过程中，会触发相应的事件，以便于其他系统组件监听和处理相关逻辑。
148:      */
149:     public function create($user,$data)
150:     {
151:         $key = 'user_extract_create_' . $user['uid'];
152:         if(Cache::get($key)) {
153:             throw new ValidateException('提现频率过快，请稍后重试');
154:         }
155:         Cache::set($key, $data['extract_price'], 30);
156:         // 触发提现前的提取事件，允许其他系统组件在这个阶段进行干预
157:         event('user.extract.before',compact('user','data'));
158:         $config = systemConfig(['extract_switch','sys_extension_type','withdraw_type','extract_type']);
159:         if (empty($config['withdraw_type'])) $config['withdraw_type'] = [self::EXTRACT_TYPE_YUE];
160:         $config['withdraw_type'][] = 3;
161:         if (!in_array($data['extract_type'],$config['withdraw_type']))
162:             throw new ValidateException('未开启该提现功能');
163:         //if ($data['extract_type'] == self::EXTRACT_TYPE_WEXIN && !$config['sys_extension_type'])
164:         //    throw new ValidateException('未开启微信自动转账');
165:         if ($data['extract_type'] == self::EXTRACT_TYPE_WECHAT && $config['sys_extension_type'])
166:             $data['extract_type'] = self::EXTRACT_TYPE_WEXIN;
167:             //throw new ValidateException('仅支持微信自动转账');
168:         // 校验用户可提现金额是否满足最小值要求
169:         if($user['brokerage_price'] < (systemConfig('user_extract_min')))
170:             throw new ValidateException('可提现金额不足');
171:         // 校验提现金额是否满足最小值要求
172:         if($data['extract_price'] < (systemConfig('user_extract_min')))
173:             throw new ValidateException('提现金额不得小于最低额度');
174:         // 校验提现金额是否超过用户可提现余额
175:         if($user['brokerage_price'] < $data['extract_price'])
176:             throw new ValidateException('提现金额不足');
177:         if($data['extract_price'] >= 2000 && empty($data['real_name']) && $data['extract_type'] == self::EXTRACT_TYPE_WEXIN) {
178:             throw new ValidateException('提现金额大于等于2000时,收款人姓名必须填写');
179:         }
180: 
181:         // 如果提现类型为微信，验证用户的微信OpenID是否存在
182:         if($data['extract_type'] == self::EXTRACT_TYPE_WEXIN) {
183:             $make = app()->make(WechatUserRepository::class);
184:             $openid = $make->idByOpenId((int)$user['wechat_user_id']);
185:             if (!$openid){
186:                 $openid = $make->idByRoutineId((int)$user['wechat_user_id']);
187:                 if(!$openid) throw new ValidateException('openID获取失败,请确认是微信用户');
188:             }
189:         }
190:         // 使用数据库事务来确保操作的原子性
191:         $userExtract = Db::transaction(function()use($user,$data){
192:             // 计算用户更新后的佣金余额
193:             $brokerage_price = bcsub($user['brokerage_price'],$data['extract_price'],2);
194:             // 更新用户佣金余额
195:             $user->brokerage_price = $brokerage_price;
196:             $user->save();
197:             // 生成提现单号
198:             $data['extract_sn'] = $this->createSn();
199:             // 设置提现单的用户ID和余额
200:             $data['uid'] = $user['uid'];
201:             $data['balance'] = $brokerage_price;
202:             // 创建提现记录
203:             $res = $this->dao->create($data);
204:             if ($data['extract_type'] == self::EXTRACT_TYPE_YUE) {
205:                 $this->switchStatus($res->extract_id, ['status' => 1]);
206:             }
207:             return $res;
208:         });
209: 
210:         if ($data['extract_type'] != self::EXTRACT_TYPE_YUE) {
211:             // 发送管理员通知，提醒有新的提现申请
212:             SwooleTaskService::admin('notice', [
213:                 'type' => 'extract',
214:                 'title' => '您有一条新的提醒申请',
215:                 'id' => $userExtract->extract_id
216:             ]);
217:         }
218:         // 触发提现完成事件，允许其他系统组件进行后续处理
219:         event('user.extract',compact('userExtract'));
220:         return  $userExtract;
221:     }
