26:     }
27: 
28:     /**
29:      * 根据条件搜索标签规则。
30:      *
31:      * 该方法提供了一个灵活的方式来根据不同的条件搜索标签规则。它支持搜索关键字、类型和商家ID作为过滤条件。
32:      * 使用Laravel的查询构建器来构造查询，利用when方法根据条件动态添加where子句到查询中。
33:      *
34:      * @param array $where 包含搜索条件的数组，可能包含关键字、类型和商家ID。
35:      * @return \Illuminate\Database\Eloquent\Builder 返回一个构建好的查询构建器实例，用于进一步的查询或获取结果。
36:      */
37:     public function search(array $where)
38:     {
39:         // 初始化标签规则查询，确保查询包含至少一个标签存在条件
40:         return LabelRule::hasWhere('label')->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
41:             // 如果提供了关键字，则添加一个like条件来搜索标签名称
42:             $query->whereLike('UserLabel.label_name', "%{$where['keyword']}%");
43:         })->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
44:             // 如果提供了类型，则添加一个等于条件来筛选标签类型
45:             $query->where('LabelRule.type', intval($where['type']));
46:         })->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
47:             // 如果提供了商家ID，则添加一个等于条件来筛选特定商家的标签规则
48:             $query->where('LabelRule.mer_id', intval($where['mer_id']));
49:         });
50:     }
51: }
