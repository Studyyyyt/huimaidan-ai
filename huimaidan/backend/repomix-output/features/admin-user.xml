130:     /**
131:      * 用户佣金增加函数
132:      *
133:      * 该函数用于处理用户佣金的增加逻辑。它首先根据当前用户的经纪等级获取下一个等级信息，
134:      * 然后检查是否存在相应的佣金记录。如果存在，则更新该记录的金额；如果不存在，则创建新的佣金记录。
135:      * 最后，检查用户是否满足升级到下一个经纪等级的条件。
136:      *
137:      * @param User $user 用户对象，表示当前操作的用户
138:      * @param string $type 佣金类型，用于区分不同种类的佣金
139:      * @param float $inc 佣金增加的金额，使用浮点数表示
140:      * @return bool 返回布尔值，表示用户是否成功升级到下一个经纪等级
141:      */
142:     public function inc(User $user, $type, $inc)
143:     {
144:         // 获取用户下一个经纪等级信息
145:         $nextLevel = $this->getNextLevel($user->brokerage_level);
146:         // 如果没有下一个等级，则返回false
147:         if (!$nextLevel) return false;
148: 
149:         // 实例化用户账单仓库类
150:         $make = app()->make(UserBillRepository::class);
151:         // 根据条件查询是否存在对应的佣金记录
152:         $bill = $make->getWhere(['uid' => $user->uid, 'link_id' => $nextLevel->user_brokerage_id, 'category' => 'sys_brokerage', 'type' => $type]);
153:         // 如果记录存在，则更新记录的金额并保存
154:         if ($bill) {
155:             $bill->number = bcadd($bill->number, $inc, 2);
156:             $bill->save();
157:         } else {
158:             // 如果记录不存在，则创建新的佣金记录
159:             $make->incBill($user->uid, 'sys_brokerage', $type, [
160:                 'number' => $inc,
161:                 'title' => $type,
162:                 'balance' => 0,
163:                 'status' => 0,
164:                 'link_id' => $nextLevel->user_brokerage_id
165:             ]);
166:         }
167: 
168:         // 检查用户是否满足升级到下一个经纪等级的条件，并返回检查结果
169:         return $this->checkLevel($user, $nextLevel);
170:     }
