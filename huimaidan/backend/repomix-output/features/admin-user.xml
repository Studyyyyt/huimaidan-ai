110:     /**
111:      * 根据传入的数据创建或更新SPU。
112:      *
113:      * 此方法用于处理产品类型为0、1或其它情况下的SPU创建或更新逻辑。
114:      * 它首先根据产品类型组装查询条件，然后尝试从数据库中检索相应的SPU信息。
115:      * 如果找到了SPU，并且SPU有有效的ID，则将相关信息存储到浏览记录表中。
116:      * 如果捕获到异常，则记录日志信息。
117:      *
118:      * @param array $data 包含产品类型、ID和其它必要信息的数据数组。
119:      * @return mixed 返回数据库查询结果，如果未找到则返回null。
120:      */
121:     public function createOrUpdate(array $data)
122:     {
123:         // 实例化SPURepository类，用于后续的SPU数据操作
124:         $make = app()->make(SpuRepository::class);
125: 
126:         // 初始化查询条件中的产品类型
127:         $where['product_type'] = $data['product_type'];
128: 
129:         // 根据产品类型组装查询条件
130:         switch ($data['product_type']) {
131:             case 0:
132:             case 1:
133:                 // 产品类型为0或1时，使用产品ID作为查询条件
134:                 $where['product_id'] = $data['id'];
135:                 break;
136:             default:
137:                 // 其他产品类型使用活动ID作为查询条件
138:                 $where['activity_id'] = $data['id'];
139:                 break;
140:         }
141: 
142:         try {
143:             // 根据组装的查询条件尝试获取SPU信息
144:             $ret = $make->getSearch($where)->find();
145: 
146:             // 如果找到了SPU，并且SPU有有效的ID，则更新浏览记录
147:             if ($ret && $ret['spu_id']) {
148:                 $arr = [
149:                     'res_type' => $data['res_type'],
150:                     'res_id' => $ret['spu_id'],
151:                     'uid' => $data['uid']
152:                 ];
153:                 $this->dao->createOrUpdate($arr);
154:             }
155: 
156:             // 返回查询结果
157:             return $ret;
158:         } catch (\Exception $exception) {
159:             // 捕获异常并记录日志
160:             Log::info('浏览记录添加失败，ID：' . $data['id'] . '类型：' . $data['product_type']);
161:         }
162:     }
