107:                     getModelTime($query, $where['user_time'], 'A.create_time');
108:                 }
109:             })->when(isset($where['pay_count']) && $where['pay_count'] !== '', function ($query) use ($where) {
110:                 if ($where['pay_count'] == -1) {
111:                     $query->where('A.pay_num', 0);
112:                 } else {
113:                     $query->where('A.pay_num', '>', $where['pay_count']);
