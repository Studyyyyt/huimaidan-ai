 97:      * @param int $merId 商家ID，用于指定查询哪个商家的标签，默认为0，表示查询所有商家的标签
 98:      * @return array 返回一个包含标签名称的数组，每个标签名称对应输入的标签ID
 99:      */
100:     public function labels(array $ids, $merId = 0)
101:     {
102:         // 通过UserLabel类的静态方法getDB获取数据库操作对象，并构造查询条件，筛选出指定商家ID和标签ID内的标签名称
103:         return UserLabel::getDB()->where('mer_id', $merId)->whereIn('label_id', $ids)->column('label_name');
104:     }
105: 
106:     /**
107:      * 检查特定标签ID是否存在
108:      *
109:      * 此方法用于确定数据库中是否存在具有指定标签ID、类型为0且可选的商户ID的记录。
110:      * 主要用于标签管理中对标签存在性的验证，以避免重复创建或操作已存在的标签。
111:      *
112:      * @param int $id 标签的ID，用于唯一标识一个标签。
113:      * @param int $mer_id 商户的ID，可选参数，用于指定特定商户下的标签。默认为0，表示系统标签。
114:      * @return bool 返回布尔值，表示标签是否存在。存在返回true，不存在返回false。
115:      */
116:     public function exists(int $id, $mer_id = 0)
117:     {
118:         // 使用existsWhere方法查询是否存在满足条件的标签记录。
119:         return $this->existsWhere(['label_id' => $id, 'type' => 0, 'mer_id' => $mer_id]);
120:     }
121: 
122:     /**
123:      * 检查指定标签名称是否存在
124:      *
125:      * 该方法用于查询指定条件下的标签名称是否存在，主要考虑了商家ID、标签类型和排除特定ID的情况。
126:      *
127:      * @param string $name 标签名称
128:      * @param int $mer_id 商家ID，用于限定查询范围
129:      * @param int $type 标签类型，用于进一步筛选标签
130:      * @param int|null $except 排除的标签ID，用于确保查询结果不包括特定标签
131:      * @return bool 如果存在符合条件的标签名称则返回true，否则返回false
132:      */
133:     public function existsName($name, $mer_id = 0, $type = 0, $except = null)
134:     {
135:         // 根据参数条件查询标签数据库记录，包括标签名称、商家ID和标签类型
136:         return UserLabel::where('label_name', $name)->where('mer_id', $mer_id)->where('type', $type)
137:                 // 当$except不为空时，添加额外的条件以排除特定ID的标签
138:                 ->when($except, function ($query, $except) {
139:                     $query->where($this->getPk(), '<>', $except);
140:                 })->count() > 0;
141:     }
