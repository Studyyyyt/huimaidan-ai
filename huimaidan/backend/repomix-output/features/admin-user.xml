2058:     /**
2059:      * 修改用户的推广ID
2060:      *
2061:      * 本函数用于处理用户推广关系的变更。当用户的新推广ID与当前的不同时，
2062:      * 会更新用户的推广ID及相关信息，并在推广日志中记录这一变更。
2063:      * 同时，根据配置，更新用户的推广限制时间。
2064:      *
2065:      * @param int $uid 用户ID
2066:      * @param int $spread_id 新的推广ID
2067:      * @param int $admin 是否为管理员操作，默认为0表示非管理员
2068:      * @return void
2069:      */
2070:     public function changeSpread($uid, $spread_id, $admin = 0)
2071:     {
2072:         // 实例化推广日志仓库
2073:         $spreadLogRepository = app()->make(UserSpreadLogRepository::class);
2074:         // 获取用户对象
2075:         $user = $this->dao->get($uid);
2076:         // 如果用户当前的推广ID与新ID相同，则不进行处理
2077:         if ($user->spread_uid == $spread_id)
2078:             return;
2079:         // 获取系统配置，包括推广限制及限制天数
2080:         $config = systemConfig(['extension_limit', 'extension_limit_day']);
2081:         // 开启数据库事务处理
2082:         Db::transaction(function () use ($config, $user, $spreadLogRepository, $spread_id, $admin) {
2083:             // 保存旧的推广ID，用于后续操作
2084:             $old = $user->spread_uid ?: 0;
2085:             // 添加推广日志
2086:             $spreadLogRepository->add($user->uid, $spread_id, $old, $admin);
2087:             // 根据新的推广ID，更新用户的推广时间
2088:             $user->spread_time = $spread_id ? date('Y-m-d H:i:s') : null;
2089:             // 根据配置，更新用户的推广限制时间
2090:             if ($spread_id && $config['extension_limit'] && $config['extension_limit_day']) {
2091:                 $user->spread_limit = date('Y-m-d H:i:s', strtotime('+ ' . $config['extension_limit_day'] . ' day'));
2092:             } else {
2093:                 $user->spread_limit = null;
2094:             }
2095:             // 更新用户的推广ID
2096:             $user->spread_uid = $spread_id;
2097:             // 如果新的推广ID不为空，则增加对应推广ID的推广计数
2098:             if ($spread_id) {
2099:                 $this->dao->incSpreadCount($spread_id);
2100:             }
2101:             // 如果旧的推广ID不为空，则减少对应推广ID的推广计数
2102:             if ($old) {
2103:                 $this->dao->decSpreadCount($old);
2104:             }
2105:             // 保存用户对象，完成更新
2106:             $user->save();
2107:         });
2108:     }
