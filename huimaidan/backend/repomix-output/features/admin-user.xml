40:     {
41:         if (!$this->spu) return '';
42:         if ($this->spu->product_type == 1 && $this->spu->seckillActive) {
43:             $day = date('Y-m-d', time());
44:             $_day = strtotime($day);
45:             $end_day = strtotime($this->spu->seckillActive['end_day']);
46:             if ($end_day >= $_day)
47:                 return strtotime($day . $this->spu->seckillActive['end_time'] . ':00:00');
48:             if ($end_day < strtotime($day))
49:                 return strtotime(date('Y-m-d', $end_day) . $this->spu->seckillActive['end_time'] . ':00:00');
50:         }
51:         return '';
52:     }
