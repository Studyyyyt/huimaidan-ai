193:     /**
194:      * 创建表单用于添加字段信息
195:      *
196:      * 该方法通过Element UI的表单构建器创建一个表单，用于添加系统用户信息字段。
197:      * 表单包括字段类型的选择、字段的名称、键值和提示信息的输入。
198:      * 其中字段类型为单选框，选项通过getType方法获取，当选择字段类型为'radio'时，需要额外输入配置内容。
199:      *
200:      * @return \Encore\Admin\Widgets\Form|\FormBuilder\Form
201:      */
202:     public function createFrom()
203:     {
204:         // 构建表单提交的URL
205:         $action = Route::buildUrl('systemUserInfoCreate')->build();
206: 
207:         // 使用Elm表单构建器创建表单，并设置表单字段
208:         $form = Elm::createForm($action, [
209:             // 字段类型选择器，包括获取字段类型的选项和针对'radio'类型字段的额外配置输入
210:             Elm::select('type', '字段类型：')->options($this->getType())->control([
211:                 [
212:                     'value' => 'radio',
213:                     'rule' => [
214:                         Elm::textarea('content', '配置内容')->placeholder('请输入配置内容')->required('请输入配置内容')
215:                     ]
216:                 ]
217:             ])->required('请选择字段类型'),
218:             // 字段名称输入框
219:             Elm::input('title', '字段名称：')->placeholder('请输入字段名称')->required('请输入字段名称'),
220:             // 字段键值输入框
221:             Elm::input('field', '字段key：')->placeholder('请输入字段key')->required('请输入字段key'),
222:             // 提示信息输入框
223:             Elm::input('msg', '提示信息：')->placeholder('请输入提示信息')->required('请输入提示信息')
224:         ]);
225: 
226:         // 设置表单标题
227:         return $form->setTitle('添加字段');
228:     }
