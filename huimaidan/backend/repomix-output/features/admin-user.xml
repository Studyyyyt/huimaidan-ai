1062:     /**
1063:      * 检查令牌（Token）的有效性。
1064:      *
1065:      * 本函数通过验证令牌是否存在以及是否过期来确保用户的身份验证状态。
1066:      * 它首先从缓存中检查令牌是否存在，如果不存在，则抛出一个授权异常。
1067:      * 接着，它获取令牌的最后更新时间，并检查是否超过预设的有效期，如果超过，则同样抛出授权异常。
1068:      * 这样做可以有效地防止未授权的访问，并确保用户的会话安全。
1069:      *
1070:      * @param string $token 用户的令牌，用于身份验证。
1071:      * @throws AuthException 如果令牌无效或已过期，则抛出此异常。
1072:      */
1073:     public function checkToken(string $token)
1074:     {
1075:         // 检查缓存中是否存在以'user_'前缀加上令牌值为键的记录
1076:         $has = Cache::has('user_' . $token);
1077:         // 如果令牌不存在于缓存中，则抛出授权异常
1078:         if (!$has)throw new AuthException('无效的token');
1079:         // 从缓存中获取令牌的最后更新时间
1080:         $lastTime = Cache::get('user_' . $token);
1081:         // 检查令牌是否过期，如果过期，则抛出授权异常
1082:         if (($lastTime + (intval(Cache::get('admin.user_token_valid_exp', 15))) * 24 * 60 * 60) < time())
1083:             throw new AuthException('token 已过期，请重新登录');
1084:     }
