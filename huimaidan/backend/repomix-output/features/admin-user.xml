147:      * 本函数旨在根据用户访问记录，统计前一天访问量最高的前10个产品或内容。
148:      * 如果前一天的访问数据不足，将返回最近访问量排名前100的内容。
149:      *
150:      * @return array 热门内容列表，包含前10个访问量最高的内容。
151:      */
152:     public function getHotList()
153:     {
154:         // 定义查询条件，特定类型为'searchProduct'
155:         $where['type'] = ['searchProduct'];
156: 
157:         // 查询前一天访问量最高的内容
158:         $data = app()->make(UserVisitRepository::class)
159:             ->search($where)
160:             ->whereDay('UserVisit.create_time', date('Y-m-d', strtotime("-1 day")))->column('content');
161: 
162:         // 如果前一天的数据为空，则查询历史访问量最高的100个内容
163:         if (empty($data)) {
164:             $data = app()->make(UserVisitRepository::class)
165:                 ->search($where)->limit(100)->column('content');
166:         }
167: 
168:         // 统计每个内容出现的次数，按访问量降序排列
169:         $data = array_count_values($data);
170:         arsort($data);
171: 
172:         // 取出前10个访问量最高的内容
173:         $data = array_keys($data);
174:         $data = array_slice($data, 0, 10);
175: 
176:         return $data;
177:     }
178: 
179: 
180: }
