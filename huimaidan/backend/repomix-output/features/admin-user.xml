 91:      * @param object $user 用户信息
 92:      * @param array $params 额外参数，包括支付类型和是否为APP支付等
 93:      * @return mixed 返回支付配置信息或订单ID
 94:      */
 95:     public function add($res, $user, $params)
 96:     {
 97:         $order_sn = app()->make(StoreOrderRepository::class)->getNewOrderId(StoreOrderRepository::TYPE_SN_USER_ORDER);
 98:         $data = [
 99:             'title'     => $res['value']['svip_name'],
100:             'link_id'   => $res->group_data_id,
101:             'order_sn'  => $order_sn,
102:             'pay_price' => $res['value']['price'],
103:             'order_info' => json_encode($res['value'],JSON_UNESCAPED_UNICODE),
104:             'uid'        => $user->uid,
105:             'order_type' => self::TYPE_SVIP.$res['value']['svip_type'],
106:             'pay_type'   => $res['value']['price'] == 0 ? 'free' : $params['pay_type'],
107:             'status'     => 1,
108:             'other'     => $user->is_svip == -1 ? 'first' : '',
109:         ];
110:         $body = [
111:             'order_sn' => $order_sn,
112:             'pay_price' => $data['pay_price'],
113:             'attach' => 'user_order',
114:             'body' =>'付费会员'
115:         ];
116:         $type = $params['pay_type'];
117:         if (in_array($type, ['weixin', 'alipay'], true) && $params['is_app']) {
