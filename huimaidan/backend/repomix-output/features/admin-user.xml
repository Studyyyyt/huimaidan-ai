35:     public function checkBrokerageRule($value, $rlue, $data)
36:     {
37:         if (!$data['type']) {
38:             $types = UserBrokerageRepository::BROKERAGE_RULE_TYPE;
39:             if (count($types) != count($value)) {
40:                 return '请输入正确的升级任务';
41:             }
42:             $flag = 0;
43:             foreach ($types as $type) {
44:                 $val = $value[$type] ?? '';
45:                 if (!is_array($val) || !isset($val['name'], $val['num'], $val['info']) || count($val) != 3) return '请输入正确的升级任务';
46:                 if ($val['num'] < 0)
47:                     return '请输入正确的任务数量';
48:                 if ($val['num'] > 0 && !$val['name']) return '请输入任务名称';
49:                 if ($val['num'] > 0) $flag++;
50:             }
51:             if (!$flag) return '请至少设置一个升级任务';
52:         }
53: 
54:         return true;
55:     }
