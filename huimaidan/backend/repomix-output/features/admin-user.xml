436:     /**
437:      * 根据条件搜索用户账单并联表查询
438:      *
439:      * 本函数用于根据提供的条件搜索用户的账单记录，并进行左连接操作以包含用户信息。
440:      * 支持的搜索条件包括：mer_id（商户ID）、type（账单类型）、date（日期范围）、keyword（关键词搜索）、category（账单分类）、uid（用户ID）。
441:      *
442:      * @param array $where 搜索条件数组，包含各种可能的搜索参数。
443:      * @return \think\Collection 返回搜索结果的集合。
444:      */
445:     public function searchJoin(array $where)
446:     {
447:         // 使用UserBill类的getDB方法获取数据库对象，并设置表别名为a
448:         return UserBill::getDB()->alias('a')
449:             // 左连接用户表b，根据a表的uid和b表的uid关联
450:             ->leftJoin('User b', 'a.uid = b.uid')
451:             // 指定查询的字段
452:             ->field('a.bill_id,a.pm,a.title,a.number,a.balance,a.mark,a.create_time,a.status,b.nickname,a.uid,a.category')
453:             // 当搜索条件中包含mer_id时，添加对应条件到查询
454:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
455:                 $query->where('a.mer_id', $where['mer_id']);
456:             })
457:             // 当搜索条件中包含type时，根据type的值进行分类查询
458:             ->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
459:                 $data = explode('/', $where['type'], 2);
460:                 if (count($data) > 1) {
461:                     // 如果type是分类/类型的格式，按分类和类型查询
462:                     $query->where('a.category', $data[0])->where('type', $data[1]);
463:                 } else {
464:                     // 否则，按type查询
465:                     $query->where('a.type', $where['type']);
466:                 }
467:             })
468:             // 当搜索条件中包含date时，添加日期范围条件到查询
469:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
470:                 getModelTime($query, $where['date'], 'a.create_time');
471:             })
472:             // 当搜索条件中包含keyword时，添加关键词搜索条件到查询
473:             ->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
474:                 $query->whereLike('a.uid|b.nickname|a.title', "%{$where['keyword']}%");
475:             })
476:             ->when(isset($where['nickname']) && $where['nickname'] !== '', function ($query) use ($where) {
477:                 $query->whereLike('b.nickname', "%{$where['nickname']}%");
478:             })
479:             ->when(isset($where['phone']) && $where['phone'] !== '', function ($query) use ($where) {
480:                 $query->whereLike('b.phone', "%{$where['phone']}%");
481:             })
482:             ->when(isset($where['real_name']) && $where['real_name'] !== '', function ($query) use ($where) {
483:                 $query->whereLike('b.real_name', "%{$where['real_name']}%");
484:             })
485:             ->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
486:                 $query->where('b.uid', $where['uid']);
487:             })
488:             // 当搜索条件中包含category时，添加分类条件到查询
489:             ->when(isset($where['category']) && $where['category'] !== '', function ($query) use ($where) {
490:                 if (is_array($where['category'])){
491:                     // 如果category是数组，使用whereIn查询
492:                     $query->whereIn('a.category', $where['category']);
493:                 } else {
494:                     // 否则，直接按category查询
495:                     $query->where('a.category', $where['category']);
496:                 }
497:             })
