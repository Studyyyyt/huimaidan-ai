217:     /**
218:      * 锁定积分的逻辑处理。
219:      * 该方法用于计算指定用户由于订单或其他操作而被锁定的积分总量。
220:      * 如果提供了订单ID，则只考虑与该订单相关的锁定积分；
221:      * 如果提供了用户ID，则返回该用户所有被锁定的积分，无论订单ID是否提供。
222:      *
223:      * @param integer $uid 用户ID。可选参数，用于限定查询的用户。
224:      * @param integer $order_id 订单ID。可选参数，用于限定查询与特定订单相关的锁定积分。
225:      * @return integer 返回锁定的积分总量。如果没有任何积分被锁定，返回0。
226:      */
227:     public function lockIntegral($uid = null, $order_id = null)
228:     {
229:         // 查询已经被锁定的积分记录，这些记录可能是由于不同的订单或其他操作导致的。
230:         $lst = UserBill::getDB()->where('category', 'integral')
231:             ->where('type', 'lock')->when($order_id, function ($query, $order_id) {
232:                 // 如果提供了订单ID，则查询与该订单关联的锁定积分记录。
233:                 $query->where('link_id', $order_id);
234:             })->when($uid, function ($query, $uid) {
235:                 // 如果提供了用户ID，则查询该用户的所有锁定积分记录。
236:                 $query->where('uid', $uid);
237:             })->where('status', 0)->field('link_id,number')->select()->toArray();
238: 
239:         // 初始化锁定的积分总量为0。
240:         $lockIntegral = 0;
241:         // 如果存在锁定的积分记录，则计算这些记录中的积分总量。
242:         if (count($lst)) {
243:             // 计算所有被退款锁定（即可能由于订单退款导致的积分锁定）的积分总量。
244:             $lockIntegral = -1 * UserBill::getDB()->whereIn('link_id', array_column($lst, 'link_id'))->where('uid', $uid)
245:                     ->where('category', 'integral')->where('type', 'refund_lock')->sum('number');
246:         }
247: 
248:         // 遍历所有锁定积分记录，累加它们的数值到$lockIntegral中。
249:         foreach ($lst as $bill) {
250:             $lockIntegral = bcadd($lockIntegral, $bill['number'], 0);
251:         }
252: 
253:         // 返回锁定的积分总量。
254:         return $lockIntegral;
255:     }
