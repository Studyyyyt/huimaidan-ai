 27: /**
 28:  * Class UserRelationRepository
 29:  * @package app\common\repositories\user
 30:  * @mixin dao
 31:  */
 32: class UserRelationRepository extends BaseRepository
 33: {
 34: 
 35:     protected $dao;
 36: 
 37:     /**
 38:      * UserRelationRepository constructor.
 39:      * @param dao $dao
 40:      */
 41:     public function __construct(dao $dao)
 42:     {
 43:         $this->dao = $dao;
 44:     }
 45: 
 46:     /**
 47:      * 检查特定类型的商品或服务是否存在。
 48:      *
 49:      * 本函数根据传入的类型参数，决定检查哪种类型的商品或服务是否存在。
 50:      * 支持的类型包括普通商品、秒杀商品、预售商品、助力商品、拼团商品和商铺。
 51:      * 通过调用相应类型的仓库方法来执行存在性检查。
 52:      *
 53:      * @param array $params 包含类型和类型ID的参数数组。
 54:      * @param int $params['type'] 商品或服务的类型，对应不同的业务实体。
 55:      * @param int $params['type_id'] 商品或服务的类型ID，用于特定类型的存在性检查。
 56:      * @return bool|mixed 如果类型有效并找到对应的商品或服务，则返回true或相关对象；否则返回false。
 57:      */
 58:     public function fieldExists($params)
 59:     {
 60:         switch ($params['type']) {
 61:             case 0: // 普通商品
 62:             case 1: // 秒杀商品
 63:                 // 对于类型0和1，使用ProductRepository来检查商品是否存在
 64:                 return app()->make(ProductRepository::class)->apiExists(0, $params['type_id']);
 65:                 break;
 66:             case 2: // 预售商品
 67:                 // 使用ProductPresellRepository来检查预售商品是否存在
 68:                 return app()->make(ProductPresellRepository::class)->getWhereCount(['product_presell_id' => $params['type_id']]);
 69:                 break;
 70:             case 3: // 助力商品
 71:                 // 使用ProductAssistRepository来检查助力商品是否存在
 72:                 return app()->make(ProductAssistRepository::class)->getWhereCount(['product_assist_id' => $params['type_id']]);
 73:                 break;
 74:             case 4: // 拼团商品
 75:                 // 使用ProductGroupRepository来检查拼团商品是否存在
 76:                 return app()->make(ProductGroupRepository::class)->getWhereCount(['product_group_id' => $params['type_id']]);
 77:                 break;
 78:             case 10: // 商铺
 79:                 // 使用MerchantRepository来检查商铺是否存在
 80:                 return app()->make(MerchantRepository::class)->apiGetOne($params['type_id']);
 81:                 break;
 82:             default:
 83:                 // 如果类型无效，返回false
 84:                 return false;
 85:                 break;
 86:         }
 87:     }
 88: 
 89:     /**
 90:      * 检查用户与特定SPU的关系是否存在
 91:      *
 92:      * 本函数用于确定给定用户是否与特定类型的SPU存在某种关系。这可以通过检查用户ID是否出现在API字段中来实现。
 93:      * 参数中的$type用于指定关系的类型，而$type_id则用于指定特定SPU的ID。
 94:      *
 95:      * @param array $params 包含关系类型和其他相关参数的数组
 96:      * @param int $uid 用户的ID
 97:      * @return bool 如果用户与SPU的关系存在，则返回true；否则返回false。
 98:      */
 99:     public function getUserRelation(array $params, int $uid)
100:     {
101:         // 检查传入的类型是否在允许的范围内
102:         if (in_array($params['type'], [0, 1, 2, 3, 4])) {
103:             // 获取SPU信息
104:             $spu = $this->getSpu($params);
105:             // 更新参数数组，以使用SPU的ID和类型1
106:             $params['type_id'] = $spu['spu_id'];
107:             $params['type'] = 1;
108:         }
109:         // 返回用户关系是否存在，通过检查特定字段在数据库中的数量是否大于0来确定
110:         return ($this->dao->apiFieldExists('type_id', $params['type_id'], $params['type'], $uid)->count()) > 0;
111:     }
112: 
113:     /**
114:      * 根据条件搜索信息，并分页返回结果。
115:      *
116:      * 此方法用于根据给定的条件数组$where，从数据库中搜索相关信息。
117:      * 它支持两种类型的信息搜索：SPU类型和商家类型。搜索结果将根据创建时间降序排列。
118:      * 方法返回一个包含搜索结果总数和分页后的结果列表的数组。
119:      *
120:      * @param array $where 搜索条件数组，包含各种过滤条件。
121:      * @param int $page 当前页码，用于分页。
122:      * @param int $limit 每页显示的记录数，用于分页。
123:      * @return array 返回一个包含总数和列表的数组。
124:      */
125:     public function search(array $where, int $page, int $limit)
126:     {
127:         // 初始化关联加载数组
128:         $with = [];
129: 
130:         // 当搜索类型为1时，加载SPU关联数据
131:         if($where['type'] == 1) {
132:             $with = [
133:                 'spu'
134:             ];
135:         }
136: 
137:         // 当搜索类型为10时，加载商家关联数据，并指定加载的字段
138:         if($where['type'] == 10) {
139:             $with = [
140:                 'merchant' => function($query){
141:                     $query->field('mer_id,type_id,mer_name,mer_avatar,sales,mer_info,care_count,status,is_del,mer_state');
142:                 }
143:             ];
144:         }
145: 
146:         // 初始化查询
147:         $query = $this->dao->search($where);
148: 
149:         // 关联加载并按创建时间降序排序
150:         $query->with($with)->order('create_time DESC');
151: 
152:         // 计算总记录数
153:         $count = $query->count();
154: 
155:         // 进行分页查询
156:         $list = $query->page($page, $limit)->select();
157: 
158:         // 遍历结果集，处理特定类型的数据显示
159:         foreach ($list as &$item) {
160:             if ($item['type'] == 1) {
161:                 // 处理SPU类型，设置特定条件下的显示状态
162:                 if(isset($item['spu']['product_type']) && $item['spu']['product_type'] == 1){
163:                     $item['spu']['stop_time'] = $item->stop_time;
164:                     $item['spu']['status'] = 1;
165:                     unset($item['spu']['seckillActive']);
166:                 }
167:             } else {
168:                 // 处理商家类型，设置显示商品推荐标志
169:                 if (isset($item['merchant']) && $item['merchant']) {
170:                     $item['merchant']['showProduct'] = $item['merchant']['AllRecommend'];
171:                 }
172:             }
173:         }
174: 
175:         // 返回计算后的总数和处理后的列表
176:         return compact('count', 'list');
177:     }
178: 
179:     /**
180:      * 批量创建记录
181:      *
182:      * 本函数用于在数据库中批量创建某种类型的记录。它首先检查每种类型是否已存在，
183:      * 如果不存在，则创建该记录。这个过程是在一个数据库事务中完成的，确保了数据的一致性。
184:      *
185:      * @param int $uid 用户ID，表示这些记录属于哪个用户。
186:      * @param array $data 包含待创建记录信息的数组。其中，'type_id' 键包含待创建记录的类型ID列表，
187:      *                   'type' 键表示记录的类型。
188:      */
189:     public function batchCreate(int $uid, array $data)
190:     {
191:         // 开启数据库事务处理
192:         Db::transaction(function () use ($data, $uid) {
193:             // 遍历类型ID列表
194:             foreach ($data['type_id'] as $item) {
195:                 // 组装待插入的数据参数
196:                 $param = ['type' => $data['type'], 'type_id' => $item, 'uid' => $uid];
197: 
198:                 // 检查当前类型ID是否已存在，如果不存在则创建新记录
199:                 if(!$this->dao->getWhereCount($param)) {
200:                     $this->dao->create($param);
201:                 }
202:             }
203:         });
204:     }
205: 
206:     /**
207:      * 根据传入的参数创建相关记录。
208:      * 此函数用于处理不同类型项的创建逻辑，包括用户商家信息和商品信息的创建。
209:      * 根据$type的值，决定是创建用户商家关联还是商品关联。
210:      *
211:      * @param array $params 包含创建所需信息的参数数组。
212:      * @return bool|void 返回事务处理结果。
213:      */
214:     public function create(array $params)
215:     {
216:         // 根据$type的值来决定处理逻辑
217:         if($params['type'] == 10) {
218:             // 处理用户商家关联的创建逻辑
219:             $id = $params['type_id'];
220:             app()->make(UserMerchantRepository::class)->getInfo($params['uid'], $params['type_id']);
221:             $make = app()->make(MerchantRepository::class);
222:         }else{
223:             // 处理商品关联的创建逻辑
224:             $spu = $this->getSpu($params);
225:             $params['type_id'] = $spu->spu_id;
226:             $params['type'] = 1;
227:             $make = app()->make(ProductRepository::class);
228:             $id = $spu->product_id;
229:         }
230: 
231:         // 使用事务来确保操作的完整性
232:         return Db::transaction(function()use($params,$make,$id){
233:             // 增加关注计数
234:             $make->incCareCount($id);
235:             // 创建相关记录
236:             $this->dao->create($params);
237:         });
