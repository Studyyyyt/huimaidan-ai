443:      * @return array 返回包含用户历史银行卡信息的数组。如果找不到相关信息，则返回空数组。
444:      */
445:     public function getHistoryBank($uid)
446:     {
447:         // 使用DAO对象进行查询，指定查询条件为UID和提取类型为0，按创建时间降序排序，并指定返回的字段。
448:         return $this->dao->getSearch(['uid' => $uid,'extract_type' => 0])->order('create_time DESC')->field('real_name,bank_code,bank_address,bank_name')->find();
449:     }
450: 
451:     /**
452:      * 根据ID获取详细信息
453:      * 此方法通过ID从数据库中获取特定记录的详细信息，包括用户信息，使用懒加载模式来加载用户信息，
454:      * 仅当需要时才查询用户相关数据，以提高查询效率。
455:      *
456:      * @param int $id 主键ID，用于查询特定记录
457:      * @return array 返回查询到的详细信息数组
458:      * @throws ValidateException 如果未查询到任何信息，则抛出异常
459:      */
460:     public function detail(int $id)
461:     {
462:         // 使用懒加载方式获取数据，这里只查询基本信息，并通过回调函数加载用户详细信息
463:         $info = $this->dao->getWith($id, ['user' => function ($query) {
464:             // 精确查询用户信息，只获取必要的字段，以减少数据库查询负载
465:             $query->field('uid,avatar,nickname');
466:         }]);
467: 
468:         // 检查查询结果，如果为空，则抛出异常提示数据异常
469:         if(empty($info)){
470:             throw new ValidateException('数据异常');
471:         }
472: 
473:         // 将查询结果转换为数组格式并返回
474:         return $info->toArray();
475:     }
476:     /**
477:      * 回调事件更新提现记录状态
478:      *
479:      * @param array $params
480:      * @return boolean
481:      */
482:     public function updateStatus(array $params) : bool
483:     {
484:         $where = [];
485:         $where['transfer_bill_no'] = $params['data']['transfer_bill_no'];
486:         $where['extract_sn'] = $params['data']['out_bill_no'];
487: 
488:         $info = $this->dao->getWhere($where);
489:         if(!$info) {
490:             Log::info('商家提现记录变更：提现记录不存在。params：'.json_encode($params));
491:             return false;
492:         };
493:         $user = app()->make(UserRepository::class)->get($info['uid']);
494:         // 初始化佣金价格变量
495:         $brokerage_price = 0;
496:         $extractData = [];
497:         $extractData['wechat_status'] = $params['data']['state'];
498:         $extractData['status'] = 2; // 提现成功
499:         if($extractData['wechat_status'] !== 'SUCCESS') {
500:             $extractData['status'] = -2; // 提现失败
501:             // 失败则回退佣金
502:             $brokerage_price = bcadd($user['brokerage_price'] ,$info['extract_price'],2);
503:         }
504: 
505:         // 使用事务处理以下操作，确保数据的一致性
506:         Db::transaction(function()use($info, $extractData, $user, $brokerage_price, $params){
507:             // 如果有佣金，更新用户佣金信息
508:             if($brokerage_price){
509:                 $user->brokerage_price = $brokerage_price;
510:                 $user->save();
511:             }
512:             $res = $this->dao->update($info['extract_id'], $extractData);
513:             if(!$res) {
514:                 Log::info('商家提现记录变更：提现记录状态变更失败。params：'.json_encode($params),'，res：'.json_encode($res));
515:                 return false;
516:             };
517:         });
518: 
519: 
520:         Log::info('商家提现记录变更：提现记录状态变更成功,id：'.$info['extract_id'].'，status：'.$params['data']['state']);
521:         return true;
522:     }
523: }
