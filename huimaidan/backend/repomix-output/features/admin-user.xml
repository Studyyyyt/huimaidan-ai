 33:     /**
 34:      * 获取API列表
 35:      * 根据用户请求的页面、每页数量、用户ID和类型，查询特定用户的API调用历史。
 36:      * 如果类型为1，还会额外加载SPU信息，并计算该用户的总历史记录数。
 37:      *
 38:      * @param int $page 当前页码
 39:      * @param int $limit 每页数量
 40:      * @param int $uid 用户ID
 41:      * @param int $type 查询类型，1表示包含SPU信息
 42:      * @return array 返回包含总数和列表数据的数组
 43:      */
 44:     public function getApiList($page,$limit,$uid,$type)
 45:     {
 46:         // 初始化包含关系数组
 47:         $with = [];
 48:         // 如果类型为1，查询时包含SPU信息，并计算用户的历史记录总数
 49:         if($type == 1){
 50:             $with = ['spu'];
 51:             $count = app()->make(UserHistoryRepository::class)->userTotalHistory($uid);
 52:         }
 53:         // 根据用户ID和类型进行查询
 54:         $query = $this->dao->search($uid,$type);
 55:         // 设置查询的包含关系和排序方式
 56:         $query->with($with)->order('update_time DESC');
 57:         // 如果类型不为1，则计算查询结果的总数
 58:         $count = $count ?? $query->count();
 59:         // 分页查询数据
 60:         $data = $query->page($page,$limit)->select();
 61:         // 初始化最终返回的结果数组和列表数组
 62:         $res = $list = [];
 63:         // 遍历查询结果，按更新时间分组
 64:         foreach ($data as $item) {
 65:             if ($item['spu']) {
 66:                 $time = date('m月d日',strtotime($item['update_time']));
 67:                 $res[$time][] = $item;
 68:             }
 69:         }
 70:         // 将分组后的数据转换为日期-列表的形式
 71:         foreach ($res as $k => $v) {
 72:             $list[] = ['date' => $k, 'list' => $v];
 73:         }
 74:         // 返回总数和列表数据
 75:         return compact('count','list');
 76:     }
