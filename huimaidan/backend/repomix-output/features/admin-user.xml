327:     public function incMemberValue(int $uid, string $type, int $id, int $money = 0)
328:     {
329:         // 检查是否启用了会员功能，如果没有启用，则直接返回
330:         if (!systemConfig('member_status')) return;
331: 
332:         // 创建用户账单仓库实例
333:         $make = app()->make(UserBillRepository::class);
334: 
335:         // 检查是否需要重复添加，如果需要，则直接返回
336:         // 判断是否要重复添加
337:         if ($make->ToRepeat($uid, $type, $id)) {
338:             return;
339:         }
340: 
341:         // 定义不同行为类型的描述和默认增长值
342:         $config = [
343:             'member_pay_num'   => '下单获得成长值',
344:             'member_sign_num'  => '签到获得成长值',
345:             'member_reply_num' => '评价获得成长值',
346:             'member_share_num' => '邀请获得成长值',
347:             'member_community_num'  => '社区种草内容获得成长值',
348:             'member_order_pay_num'  => ';下单获得比例成长值'
349:         ];
350: 
351:         // 根据行为类型获取配置的增长值，如果配置值小于等于0，则默认为0
352:         $inc = systemConfig($type) > 0 ? systemConfig($type) : 0;
353: 
354:         // 获取用户信息，包括会员值等
355:         $user = app()->make(UserRepository::class)->getWhere(['uid' => $uid], '*', ['member']);
356: 
357:         // 判断用户是否为VIP，并且VIP功能是否开启
358:         $svip_status = $user->is_svip > 0 && systemConfig('svip_switch_status') == '1';
359: 
360:         // 如果用户是VIP，并且设置了VIP加成比例，则根据比例调整增长值
361:         if ($svip_status) {
362:             $svipRate = app()->make(MemberinterestsRepository::class)->getSvipInterestVal(MemberinterestsRepository::HAS_TYPE_MEMBER);
363:             if ($svipRate > 0) {
364:                 $inc = bcmul($svipRate, $inc, 0);
365:             }
366:         }
367: 
368:         // 构建增长标记，描述增长的原因和值
369:         $mark = $config[$type].':'.$inc;
370: 
371:         // 如果行为类型为下单，并且指定了订单支付金额，则根据配置的规则计算额外的会员值增长
372:         // 下单通过经验值获得比例乘以订单金额作为成长值
373:         $inc_ = 0;
374:         if ($type == 'member_pay_num' && $money) {
375:             $inc_ = systemConfig('member_order_pay_num') > 0 ? systemConfig('member_order_pay_num') : 0;
376:             $inc_ = (int)bcmul($money, $inc_, 0);
377:             $mark .= $config['member_order_pay_num'].':'.$inc_;
378:         }
379: 
380:         // 计算最终的会员值增长量
381:         $inc = $inc + $inc_;
382:         // 创建用户账单，记录会员值的增长情况
383:         $make->incBill($user->uid, 'sys_members', $type, [
384:             'number'  => $inc,
385:             'title'   => $config[$type],
386:             'balance' => $user->member_value + $inc,
387:             'status'  => 0,
388:             'link_id' => $id,
389:             'mark' => $mark,
390:         ]);
391:         // 检查用户的会员值是否满足升级条件
392:         $this->checkMemberValue($user, $inc);
393:     }
394: 
395:     /**
396:      * 连续升级
397:      * @param $nextLevel
398:      * @param $num
399:      * @return array
400:      * @author Qinii
401:      * @day 1/11/22
402:      */
403:     public function upUp($nextLevel, $num, $use_value)
404:     {
405:         $newLevel = $this->getNextLevel($nextLevel->brokerage_level, 1);
406:         if ($newLevel) {
407:             $newNum = $num - $newLevel->brokerage_rule['value'];
408:             if ($newNum > 0) {
409:                 $use_value += $newLevel->brokerage_rule['value'];
410:                 [$nextLevel,$num,$use_value] = $this->upUp($newLevel, $newNum, $use_value);
411:             }
412:         }
413:         return [$nextLevel,$num,$use_value];
414:     }
415: 
416:     /**
417:      * 升级操作
418:      * @param User $user
419:      * @param int $inc
420:      * @author Qinii
421:      * @day 1/11/22
422:      */
423:     public function checkMemberValue(User $user, int $inc)
424:     {
425:         /**
426:          * 下一级所需经验值
427:          * 当前的经验值加上增加经验值是否够升级
428:          */
429:         $nextLevel = $this->getNextLevel($user->member_level, 1);
430:         return Db::transaction(function () use ($inc, $user, $nextLevel) {
431:             $num = $user->member_value + $inc;
432:             if ($nextLevel) {
433:                 if ($user->member_value >= $nextLevel->brokerage_rule['value']) {
434:                     $num = $user->member_value - $nextLevel->brokerage_rule['value'];
435:                     $use_value = $nextLevel->brokerage_rule['value'];  // 升级消耗成长值
436:                     if ($num > 0) {
437:                         [$nextLevel, $num, $use_value] = $this->upUp($nextLevel, $num, $use_value);
438:                     }
439:                     if ($user->member) {
440:                         $user->member->user_num--;
441:                         $user->member->save();
442:                     }
443:                     $nextLevel->user_num++;
444:                     $nextLevel->save();
445:                     $user->member_level = $nextLevel->brokerage_level;
446:                     $key = 'notice_member_level_' . $user->uid;
447:                     app()->make(CacheRepository::class)->save($key, $nextLevel->brokerage_level);
448:                     // 添加升级所需成长值记录
449:                     app()->make(UserBillRepository::class)->decBill($user->uid, 'sys_members', 'member_upgrade', ['number'  => $use_value,
450:                       'title'   => '升级消耗成长值',
451:                       'balance' => $num,
452:                       'status'  => 0,
453:                       'mark'    => '升级消耗成长值' . ':' . $use_value,
454:                     ]);
455:                 }
456:             }
457:             $user->member_value = $num;
458:             $user->save();
459:             return $user;
460:         });
461:     }
462: }
