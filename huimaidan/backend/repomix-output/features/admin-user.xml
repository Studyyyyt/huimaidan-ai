144:     /**
145:      * 计算商家锁定的资金总额。
146:      *
147:      * 本函数用于根据指定的商家ID，计算该商家目前被锁定的资金总额。
148:      * 锁定的资金包括：待处理的锁定资金、退款资金和订单计算资金。
149:      *
150:      * @param string|null $merId 商家ID，如果为null，则计算所有商家的锁定资金总额。
151:      * @return float 返回商家锁定的资金总额。
152:      */
153:     public function merchantLickMoney($merId = null)
154:     {
155:         // 查询待处理的商家锁定资金记录，根据商家ID进行过滤。
156:         $lst = UserBill::getDB()
157:             ->where('category', 'mer_lock_money')
158:             ->when($merId, function ($query, $val) {
159:             $query->where('mer_id', $val);
160:         })->where('status', 0)->select()->toArray();
161: 
162:         // 初始化锁定资金总额为0。
163:         $lockMoney = 0;
164:         // 如果有锁定资金记录，计算已退款金额并从中扣除。
165:         if (count($lst)) {
166:             $lockMoney = -1 * UserBill::getDB()->whereIn('link_id', array_column($lst, 'link_id'))
167:                     ->where('category', 'mer_refund_money')->sum('number');
168:         }
169: 
170:         // 累加所有的锁定资金到$lockMoney。
171:         foreach ($lst as $bill) {
172:             $lockMoney = bcadd($lockMoney, $bill['number'], 2);
173:         }
174: 
175:         // 加上订单计算产生的锁定资金。
176:         $lockMoney = bcadd($lockMoney, UserBill::getDB()
177:             ->where('category', 'mer_computed_money')->when($merId, function ($query, $val) {
178:                 $query->where('mer_id', $val);
179:             })->where('status', 0)->where('type', 'order')->sum('number'), 2);
180: 
181:         // 返回计算得到的商家锁定资金总额。
182:         return $lockMoney;
183:     }
