 42: 
 43:     /**
 44:      * 获取用户推荐产品的类别ID列表
 45:      *
 46:      * 本函数旨在查询并返回与指定用户相关的产品推荐类别ID列表。通过查询推荐表中与用户UID相关且类型为产品的推荐项，
 47:      * 限制返回结果的数量为7条，并进一步获取每项产品的类别ID。此列表可用于显示用户个性化的推荐产品类别。
 48:      *
 49:      * @param int|null $uid 用户ID。可选参数，如果未指定，则默认查询所有推荐产品的类别ID列表。
 50:      * @return array 返回包含产品类别ID的数组。如果查询结果为空或非数组，则返回空数组。
 51:      */
 52:     public function getRecommend(?int $uid)
 53:     {
 54:         // 根据用户ID和类型为'product'的条件查询推荐数据，并关联产品信息，限制返回结果数量为7
 55:         $data = $this->dao->search(['uid' => $uid, 'type' => 'product'])->with(['product' => function ($query) {
 56:             // 选择产品ID和类别ID字段
 57:             $query->field('product_id,cate_id');
 58:         }])->limit(7)->select();
 59: 
 60:         // 初始化用于存储类别ID的数组
 61:         $i = [];
 62:         // 如果查询结果是数组，则遍历结果，提取每条推荐产品的类别ID
 63:         if (is_array($data)) {
 64:             foreach ($data as $item) {
 65:                 // 将产品类别ID添加到类别ID数组中
 66:                 $i[] = $item['product']['cate_id'];
 67:             }
 68:         }
 69:         // 返回包含产品类别ID的数组
 70:         return $i;
 71:     }
 72: 
 73:     /**
 74:      * 获取用户产品浏览历史记录
 75:      *
 76:      * 本函数用于根据用户ID和分页信息，从数据库中检索该用户的产品浏览历史记录。
 77:      * 它首先构造一个查询条件为用户ID和类型为产品的查询，然后计算符合条件的记录总数，
 78:      * 最后根据指定的页码和每页记录数来获取记录列表。
 79:      *
 80:      * @param int $uid 用户ID，用于指定要查询哪个用户的浏览历史。
 81:      * @param int $page 当前页码，用于分页查询。
 82:      * @param int $limit 每页的记录数，用于分页查询。
 83:      * @return array 返回一个包含浏览历史记录总数和列表的数组。
 84:      */
 85:     public function getHistory($uid,$page, $limit)
 86:     {
 87:         // 根据用户ID和类型为产品搜索浏览历史记录
 88:         $query = $this->dao->search(['uid' => $uid, 'type' => 'product']);
 89: 
 90:         // 伴随查询产品信息，只获取指定的字段以减少数据量
 91:         $query->with(['product'=>function($query){
 92:             $query->field('product_id,image,store_name,slider_image,price,is_show,status,sales');
 93:         }]);
 94: 
 95:         // 计算符合条件的浏览历史记录总数
 96:         $count = $query->count();
 97: 
 98:         // 根据当前页码和每页记录数获取浏览历史记录列表
 99:         $list = $query->page($page,$limit)->select();
100: 
101:         // 将记录总数和列表一起返回
102:         return compact('count','list');
103:     }
104: 
105:     /**
106:      * 获取搜索日志列表
107:      *
108:      * 根据给定的条件数组 $where，分页获取搜索日志，并包含用户信息。
109:      * 这个方法主要用于支持对搜索行为的数据统计和查询。
110:      *
111:      * @param array $where 搜索条件数组，用于精确匹配搜索日志。
112:      * @param int $page 当前页码，用于分页查询。
113:      * @param int $limit 每页数据条数，用于分页查询。
114:      * @return array 返回包含搜索日志总数和列表的数据数组。
115:      */
116:     public function getSearchLog(array $where, $page, $limit)
117:     {
118:         // 初始化搜索查询
119:         $query = $this->dao->search($where);
120: 
121:         // 关联加载用户信息，只获取指定字段以减少数据量
122:         $query->with(['user' => function ($query) {
123:             $query->field('uid,nickname,avatar,user_type');
124:         }]);
125: 
126:         // 计算满足条件的搜索日志总数
127:         $count = $query->count();
128: 
129:         // 分页查询搜索日志，并按创建时间降序排序
130:         $list = $query->page($page, $limit)->order('create_time DESC')->select();
131: 
132:         // 返回搜索日志总数和列表的组合
133:         return compact('count', 'list');
134:     }
