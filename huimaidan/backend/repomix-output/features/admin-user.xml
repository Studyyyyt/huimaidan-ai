239: 
240: 
241:     /**
242:      * 批量删除
243:      * @param array $ids
244:      * @param $uid
245:      * @param $type
246:      * @author Qinii
247:      * @day 2023/2/16
248:      */
249:     public function batchDestory(array $ids,$uid, $type = 1)
250:     {
251:         if ($type == 10) {
