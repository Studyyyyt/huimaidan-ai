178:         $info = json_decode($data['order_info']);
179:         $user = app()->make(UserRepository::class)->get($ret['uid']);
180:         // 获取会员的增加天数
181:         $day = $info->svip_type == 3 ? 0 : $info->svip_number;
182:         //如果是过期了的会员，则更新结束时间以当前时间增加,否则是根据结束时间增加
183:         $endtime = ($user['svip_endtime'] && $user['is_svip'] != 0) ? $user['svip_endtime'] : date('Y-m-d H:i:s',time());
184:         $svip_endtime =  date('Y-m-d H:i:s',strtotime("$endtime  +$day day" ));
185:         $user->is_svip = $info->svip_type;
186:         $user->svip_endtime = $svip_endtime;
187:         $user->save();
188:         $ret->status = 1;
189:         $ret->pay_time = date('Y-m-d H:i:s',time());
190:         $ret->end_time = $svip_endtime;
191:         $ret->save();
192:         $title = '支付会员';
193:         if ($info->svip_type == 3) {
194:             $date = '终身会员';
195:             $mark = '终身会员';
196:         } else {
197:             $date = $svip_endtime;
