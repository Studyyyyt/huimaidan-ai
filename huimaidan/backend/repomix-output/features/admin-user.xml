231:     /**
232:      * 创建字段
233:      *
234:      * 本函数用于根据传入的数据创建新的字段。它首先验证字段类型是否有效，然后确保对于单选字段类型（radio），
235:      * 至少提供了两个选项。如果验证失败，将抛出一个验证异常。然后，它将内容数据编码为JSON格式，并为字段设置默认的排序值。
236:      * 最后，它在数据库事务中执行字段的创建操作。
237:      *
238:      * @param array $data 包含字段相关信息的数组，包括字段类型、内容等。
239:      * @return bool|void 返回数据库事务执行结果，如果执行成功，则返回true，否则不返回任何值。
240:      * @throws ValidateException 如果字段类型无效或单选字段选项不足两个，将抛出此异常。
241:      */
242:     public function create(array $data)
243:     {
244:         // 验证字段类型是否在定义的类型数组中
245:         // 验证类型
246:         if (!isset($this->type[$data['type']])) {
247:             throw new ValidateException('字段类型异常');
248:         }
249:         // 对于单选字段类型（radio），确保至少有两个选项
250:         if ($data['type'] == 'radio' && (!is_array($data['content']) || count($data['content']) < 2)) {
251:             throw new ValidateException('请至少创建两个选项');
252:         }
253:         // 将内容数据编码为JSON格式
254:         $data['content'] = json_encode($data['content']);
255:         // 设置默认的排序值
256:         $data['sort'] = 999;
257: 
258:         // 使用数据库事务执行字段的创建操作，包括更改字段信息和实际创建字段的操作
259:         return Db::transaction(function () use ($data) {
260:             $this->changeField($data);
261:             $this->dao->create($data);
262:         });
263:     }
264: 
265:     /**
266:      * 保存用户信息及扩展字段配置
267:      *
268:      * 本函数主要用于处理用户信息的保存操作，其中包括用户头像信息的更新，
269:      * 以及用户扩展信息字段的配置更新。通过对传入数据的处理，确保了用户
270:      * 信息的完整性和扩展字段的正确配置。
271:      *
272:      * @param array $data 用户信息及扩展字段数据数组
273:      *                    包含 'avatar' 用户头像信息
274:      *                    包含 'user_extend_info' 用户扩展信息字段数组
275:      * @return bool 返回保存操作的结果，true表示保存成功
276:      */
277:     public function saveAll(array $data = [])
278:     {
279:         // 设置用户默认头像信息
280:         app()->make(ConfigValueRepository::class)->setFormData(['user_default_avatar' => $data['avatar']], 0);
281: 
282:         // 检查并更新用户扩展信息字段的配置
283:         // 保存用户表单
284:         if (!empty($data['user_extend_info'])) {
285:             foreach ($data['user_extend_info'] as $sort => $item) {
286:                 // 确保必要参数存在，避免空值导致的错误
287:                 if (!isset($item['field']) || !isset($item['is_used']) || !isset($item['is_require']) || !isset($item['is_show'])) {
288:                     throw new ValidateException('参数不能为空');
289:                 }
290: 
291:                 // 确保参数值的合法性，只允许特定的取值范围
292:                 if (!in_array($item['is_used'], [0, 1]) || !in_array($item['is_require'], [0, 1]) || !in_array($item['is_show'], [0, 1])) {
293:                     throw new ValidateException('参数类性错误');
294:                 }
295: 
296:                 // 更新扩展字段的配置信息
297:                 $this->dao->query([])->where('field', $item['field'])->update(['is_used' => $item['is_used'], 'is_require' => $item['is_require'], 'is_show' => $item['is_show'], 'sort' => $sort]);
298:             }
299:         }
300: 
301:         return true;
302:     }
303: 
304:     /**
305:      * 删除表单数据。
306:      *
307:      * 本函数用于根据给定的ID删除表单数据。在删除前，它会进行一系列的验证以确保数据的安全性和完整性。
308:      * 首先，它会检查所要删除的数据是否存在以及'field'字段是否为空，如果存在异常情况，则会抛出一个验证异常。
309:      * 其次，它会检查待删除的数据是否为默认数据，如果是默认数据，则同样会抛出一个验证异常，以防止删除重要的默认设置。
310:      * 最后，如果所有验证通过，函数将使用事务来确保删除操作的原子性，即先删除字段数据，再删除实际的表单数据。
311:      *
312:      * @param int $id 表单数据的唯一标识ID。
313:      * @return bool 如果删除成功，返回true。
314:      * @throws ValidateException 如果数据不存在、字段为空或尝试删除默认表单数据，则抛出此异常。
315:      */
316:     public function delete(int $id)
317:     {
318:         // 通过ID获取表单信息
319:         $info = $this->dao->get($id);
320:         // 检查获取的表单信息是否为空，或者字段是否为空，如果是，则抛出异常
321:         if (empty($info) || empty($info['field'])) {
322:             throw new ValidateException('表单数据异常');
323:         }
324:         // 检查是否为默认表单，如果是，则抛出异常，防止删除默认表单
325:         if ($info['is_default']) {
326:             throw new ValidateException('默认表单不能删除');
327:         }
328:         // 使用事务来确保删除操作的原子性
329:         return Db::transaction(function () use ($info, $id) {
330:             // 删除字段数据
331:             $this->deleteField($info['field']);
332:             // 删除实际的表单数据
333:             $this->dao->delete($id);
334:         });
335:     }
336: 
