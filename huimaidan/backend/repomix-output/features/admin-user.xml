201:         $financialRecordRepository->inc([
202:             'order_id' => $ret->order_id,
203:             'order_sn' => $ret->order_sn,
204:             'user_info'=> $user->nickname,
205:             'user_id'  => $user->uid,
206:             'financial_type' => $financialRecordRepository::FINANCIA_TYPE_SVIP,
207:             'number' => $ret->pay_price,
208:             'type'  => 2,
209:             'pay_type' => 0
210:         ],0);
211:         $userBillRepository->incBill($ret['uid'],UserBillRepository::CATEGORY_SVIP_PAY,'svip_pay',[
212:             'link_id' => $ret->order_id,
213:             'title' => $title,
214:             'number'=> $ret->pay_price,
215:             'status'=> 1,
216:             'mark' => $mark,
217:         ]);
218:         if ($user->phone) Queue::push(SendSmsJob::class,['tempId' => 'SVIP_PAY_SUCCESS','id' => ['phone' => $user->phone, 'date' => $date]]);
