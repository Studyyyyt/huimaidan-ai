114:      *
115:      * @param int $uid 用户ID。这是识别用户的唯一标识。
116:      * @param int $mer_id 商家ID。表示用户所属的商家。
117:      * @return object 用户对象，包含用户信息。如果用户不存在，则为新创建的用户对象。
118:      */
119:     public function getInfo($uid, $mer_id)
120:     {
121:         // 根据$uid和$mer_id查询用户信息
122:         $user = $this->dao->getWhere(compact('uid', 'mer_id'));
123: 
124:         // 如果用户不存在，则尝试创建该用户
125:         if (!$user) $user = $this->create($uid, $mer_id);
126: 
127:         // 返回用户对象
128:         return $user;
129:     }
130: 
131:     /**
132:      * 更新用户的支付时间及相关支付统计信息。
133:      *
134:      * 本函数用于在用户完成支付后，更新其支付时间、支付次数、支付总额等统计信息。
135:      * 如果是首次支付，还会记录首次支付时间。
136:      *
137:      * @param int $uid 用户ID，用于标识唯一用户。
138:      * @param string $merId 商户ID，用于标识用户是在哪个商户完成的支付。
139:      * @param float $pay_price 本次支付的金额，以浮点数表示。
140:      * @param bool $flag 标志位，用于决定是否增加支付次数。默认为true，即增加支付次数。
141:      */
142:     public function updatePayTime($uid, $merId, $pay_price, $flag = true)
143:     {
144:         // 根据用户ID和商户ID获取用户信息。
145:         $user = $this->getInfo($uid, $merId);
146:         // 获取当前时间，用于更新支付时间。
147:         $time = date('Y-m-d H:i:s');
148:         // 更新用户的最后一次支付时间。
149:         $user->last_pay_time = $time;
150:         // 如果标志位为true，增加用户的支付次数。
151:         if ($flag) {
152:             $user->pay_num++;
153:         }
154:         // 更新用户的累计支付金额，使用bcadd确保浮点数计算的准确性。
155:         $user->pay_price = bcadd($user->pay_price, $pay_price, 2);
156:         // 如果用户尚未记录首次支付时间，将当前时间设为首次支付时间。
157:         if (!$user->first_pay_time) {
158:             $user->first_pay_time = $time;
159:         }
160:         // 保存更新后的用户信息。
161:         $user->save();
162:     }
163: 
164:     /**
165:      * 移除标签
166:      * 本函数用于从数据库中移除指定ID的标签。它通过搜索具有指定标签ID的记录，
167:      * 然后更新这些记录的标签ID字段，从现有的标签列表中移除指定的标签ID。
168:      *
169:      * @param int $id 标签的ID，指定要移除的标签。
170:      * @return bool 更新操作的结果，true表示成功，false表示失败。
171:      */
172:     public function rmLabel($id)
173:     {
174:         // 使用DAO层的search方法查询具有指定标签ID的记录，并准备更新这些记录的标签ID字段。
175:         // 更新操作通过在标签ID字段上执行SQL函数来实现，该函数从现有的标签ID字符串中移除指定的ID。
176:         return $this->dao->search(['label_id' => $id])->update([
177:             'A.label_id' => Db::raw('(trim(BOTH \',\' FROM replace(CONCAT(\',\',A.label_id,\',\'),\',' . $id . ',\',\',\')))')
178:         ]);
179:     }
180: 
181: 
182:     /**
183:      * 创建修改用户标签的表单
184:      *
185:      * 本函数用于生成一个表单，该表单允许操作者修改用户标签。通过提供的用户ID和商家ID，
186:      * 函数检索现有的用户标签，并为这些标签创建一个可以选择的列表。表单提交的URL是动态生成的，
187:      * 保证了表单提交的路由正确性。
188:      *
189:      * @param int $merId 商家ID，用于获取商家相关的用户标签选项
190:      * @param int $id 用户ID，用于获取当前用户已有的标签
191:      * @return \FormBuilder\Form|\Laravie\Codex\Contracts\Response
192:      */
193:     public function changeLabelForm($merId, $id)
194:     {
195:         // 通过用户ID获取用户对象
196:         $user = $this->dao->get($id);
197: 
198:         // 实例化用户标签仓库，用于后续获取所有标签选项和处理标签交集
199:         /** @var UserLabelRepository $make */
200:         $userLabelRepository = app()->make(UserLabelRepository::class);
201: 
202:         // 获取所有标签选项，包括商家拥有的标签
203:         $data = $userLabelRepository->allOptions($merId);
204: 
205:         // 创建表单，表单提交的URL是通过路由名称和参数动态构建的
206:         return Elm::createForm(Route::buildUrl('merchantUserChangeLabel', compact('id'))->build(), [
207:             // 创建多选下拉列表，用于选择用户的标签
208:             Elm::selectMultiple('label_id', '用户标签：', $userLabelRepository->intersection($user->label_id, $merId, 0))->options(function () use ($data) {
209:                 $options = [];
210:                 // 遍历标签数据，构建下拉列表的选项
211:                 foreach ($data as $value => $label) {
212:                     $options[] = compact('value', 'label');
213:                 }
214:                 return $options;
215:             })
216:         ])->setTitle('修改用户标签');
217:     }
218: 
219:     public function getManagerUid($where)
220:     {
221:         $staffsRepository = app()->make(StaffsRepository::class);
222:         $storeServiceRepository = app()->make(StoreServiceRepository::class);
223: 
224:         $uids1 = $storeServiceRepository->search($where)->column('uid');
225:         $uids2 = $staffsRepository->search($where)->column('uid');
226:         $uids = array_unique(array_merge($uids1, $uids2));
227:         return $uids;
228:     }
229: }
