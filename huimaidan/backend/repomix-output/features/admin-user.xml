 439:     /**
 440:      * 获取推广员列表
 441:      *
 442:      * 根据给定的条件和分页信息，查询推广员列表及其相关信息，包括推广员的提取信息和佣金信息。
 443:      *
 444:      * @param array $where 查询条件数组
 445:      * @param int $page 当前页码
 446:      * @param int $limit 每页数据条数
 447:      * @return array 返回包含推广员列表和总数的信息
 448:      */
 449:     public function promoterList(array $where, $page, $limit)
 450:     {
 451: 
 452:         if (systemConfig('promoter_type') != 2) {
 453:             // 将查询条件中的推广员标识设置为1，表示只查询推广员
 454:             $where['is_promoter'] = 1;
 455:             $where['promoter_switch'] = 1;
 456:         } else {
 457:             $where['is_promoter'] = [0,1];
 458:         }
 459: 
 460:         // 构建查询，包括推广员的传播信息和佣金信息
 461:         $query = $this->dao->search($where)
 462:             ->with([
 463:                 'spread' => function ($query) {
 464:                     // 查询推广员的传播者信息，包括uid、nickname和spread_uid
 465:                     $query->field('uid,nickname,spread_uid');
 466:                 },
 467:                 'brokerage' => function ($query) {
 468:                     // 查询推广员的佣金信息，包括brokerage_level、brokerage_name和brokerage_icon
 469:                     $query->field('brokerage_level,brokerage_name,brokerage_icon');
 470:                 }
 471:             ]);
 472: 
 473:         // 计算满足条件的推广员总数
 474:         $count = $query->count($this->dao->getPk());
 475: 
 476:         // 分页查询推广员信息，并转换为数组格式
 477:         $list = $query->page($page, $limit)->select()->toArray();
 478: 
 479:         // 如果查询到推广员信息
 480:         if (count($list)) {
 481:             // 获取所有推广员的提取信息
 482:             $promoterInfo = app()->make(UserExtractRepository::class)->getPromoterInfo(array_column($list, 'uid'));
 483: 
 484:             // 将提取信息按照uid进行组合
 485:             if (count($promoterInfo)) {
 486:                 $promoterInfo = array_combine(array_column($promoterInfo, 'uid'), $promoterInfo);
 487:             }
 488: 
 489:             // 遍历推广员列表，补充提取总额、提取总次数和佣金总额信息
 490:             foreach ($list as $k => $item) {
 491:                 // 补充推广员的提取总额和提取总次数
 492:                 $list[$k]['total_extract_price'] = $promoterInfo[$item['uid']]['total_price'] ?? 0;
 493:                 $list[$k]['total_extract_num'] = $promoterInfo[$item['uid']]['total_num'] ?? 0;
 494: 
 495:                 // 计算推广员的佣金总额，保留两位小数
 496:                 $list[$k]['total_brokerage_price'] = (float)bcadd($item['brokerage_price'], $list[$k]['total_extract_num'], 2);
 497:             }
 498:         }
 499: 
 500:         // 返回推广员列表和总数
 501:         return compact('count','list');
 502:     }
