410:     /**
411:      * 创建一个唯一序列号
412:      *
413:      * 本函数旨在生成一个包含时间戳和随机数的唯一序列号，用于标识或唯一标记某个事物。
414:      * 序列号以"ue"开头，后面跟随毫秒级时间戳和一个随机数。这样可以确保在短时间内生成的序列号是唯一的。
415:      *
416:      * @return string 生成的唯一序列号
417:      */
418:     public function createSn()
419:     {
420:         // 获取当前时间的微秒和秒部分
421:         list($msec, $sec) = explode(' ', microtime());
422: 
423:         // 将微秒和秒转换为毫秒，并去掉小数点，确保序列号是整数
424:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
425: 
426:         // 生成序列号：'ue' + 毫秒时间戳 + 随机数
427:         // 随机数范围确保在特定范围内，以避免生成的序列号在短时间内重复
428:         $sn = 'ue' . $msectime . mt_rand(10000, max(intval($msec * 10000) + 10000, 98369));
429: 
430:         return $sn;
431:     }
