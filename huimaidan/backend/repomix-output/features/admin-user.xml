144:     /**
145:      * 计算指定用户的商品访问总数
146:      *
147:      * 本函数通过查询用户访问记录表，统计指定用户对商品的访问次数。
148:      * 这里的“商品”是指类型为“product”的访问记录。
149:      *
150:      * @param int $uid 用户ID
151:      * @return int 用户访问商品的总次数
152:      */
153:     public function userTotalVisit($uid)
154:     {
155:         // 使用UserVisit类的静态方法getDB来获取数据库实例，并构造查询条件，统计指定用户uid且访问类型为product的记录总数
156:         return UserVisit::getDB()->where('uid', $uid)->where('type', 'product')->count();
