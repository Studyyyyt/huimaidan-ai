144:      * @return mixed 根据订单类型的不同，可能返回不同的结果。
145:      */
146:     public function paySuccess($data)
147:     {
148:         $res = $this->dao->getWhere(['order_sn' => $data['order_sn']]);
149:         $type = explode('-',$res['order_type'])[0].'-';
150: 
151:         Log::info('付费会员支付回调执行' . var_export([$data,$res->toArray(),$type,'----------------------------'],1));
152:         // 付费会员充值
153:         if ($res->pay_time && $res->paid) return true;
154:         if ($type == self::TYPE_SVIP) {
155:             return Db::transaction(function () use($data, $res) {
156:                 $res->paid = 1;
157:                 $res->pay_time = date('y_m-d H:i:s', time());
158:                 $res->transaction_id = $data['data']['transaction_id'] ?? ($data['data']['trade_no'] ?? '');
159:                 $res->save();
