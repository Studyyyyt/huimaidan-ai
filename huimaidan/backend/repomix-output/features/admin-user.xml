 13: namespace app\common\dao\user;
 14: 
 15: use app\common\dao\BaseDao;
 16: use app\common\model\user\UserHistory;
 17: 
 18: class UserHistoryDao extends BaseDao
 19: {
 20:     protected function getModel(): string
 21:     {
 22:         return UserHistory::class;
 23:     }
 24: 
 25: 
 26:     /**
 27:      * 根据给定的数据创建或更新记录。
 28:      * 此方法首先尝试根据数据中的条件查询现有记录，如果存在，则更新记录的更新时间并保存；
 29:      * 如果不存在，则将更新时间添加到数据中并创建新记录。
 30:      * @param array $data 包含要操作的数据的数组，其中的条件用于查询或插入。
 31:      */
 32:     public function createOrUpdate(array $data)
 33:     {
 34:         // 尝试根据$data中的条件查询现有记录
 35:         $ret = $this->getModel()::getDB()->where($data)->find();
 36:         if ($ret) {
 37:             // 如果记录存在，更新更新时间并保存
 38:             $ret->update_time = time();
 39:             $ret->save();
 40:         } else {
 41:             // 如果记录不存在，将更新时间添加到数据数组中并创建新记录
 42:             $data['update_time'] = time();
 43:             $this->create($data);
 44:         }
 45:     }
 46: 
 47:     /**
 48:      * 根据用户ID和资源类型搜索资源。
 49:      *
 50:      * 此方法提供了一个灵活的方式来查询资源，可以根据用户ID和资源类型进行过滤。
 51:      * 查询构建利用了when方法来条件性地添加where子句，确保了只有在相应的参数非空时才应用过滤条件。
 52:      * 最后，通过order方法指定了查询结果的排序方式，按照更新时间降序排列。
 53:      *
 54:      * @param int|null $uid 用户ID。如果提供，将根据用户ID过滤结果。
 55:      * @param int $type 资源类型。如果提供，将根据资源类型过滤结果。
 56:      * @return 查询对象，已经应用了过滤条件和排序，可用于进一步的操作，如获取结果集。
 57:      */
 58:     public function search(?int $uid, int $type)
 59:     {
 60:         // 获取数据库实例，并根据$uid和$type条件性地添加where子句
 61:         $query = ($this->getModel()::getDB())->when($uid, function ($query) use ($uid) {
 62:             $query->where('uid', $uid);
 63:         })->when($type, function ($query) use ($type) {
 64:             $query->where('res_type', $type);
 65:         });
 66: 
 67:         // 对查询结果按更新时间降序排序
 68:         return $query->order('update_time DESC');
 69:     }
 70: 
 71: 
 72: 
 73:     /**
 74:      * 批量删除记录。
 75:      * 根据传入的参数，本函数支持两种方式批量删除数据：
 76:      * 1. 当$data为数组时，删除主键在$data数组内的所有记录。
 77:      * 2. 当$data为1时，删除所有uid为$uid的记录。
 78:      *
 79:      * @param int $uid 用户ID，当$data为1时，用于指定删除哪个用户的记录。
 80:      * @param array|int $data 要删除的记录的主键数组，或者当值为1时，表示删除指定用户的所有记录。
 81:      */
 82:     public function deleteBatch($uid,$data)
 83:     {
 84:         // 检查$data是否为数组，如果是，删除主键在数组内的记录。
 85:         if(is_array($data)){
 86:             $this->getModel()::getDB()->where($this->getPk(),'in',$data)->delete();
 87:         }else if($data == 1){
 88:             // 如果$data为1，删除所有uid为$uid的记录。
 89:             $this->getModel()::getDB()->where('uid',$uid)->delete();
 90:         }
 91:     }
 92: 
 93: 
 94:     /**
 95:      * 计算用户的历史记录总数
 96:      *
 97:      * 本函数用于查询指定用户（通过$uid标识）在系统中的历史记录总数。特别地，它只计算
 98:      * 类型为1的资源的历史记录，这通常表示用户的购买、浏览或其他有意义的操作次数。
 99:      *
100:      * @param int $uid 用户ID，用于指定要查询历史记录的用户。
101:      * @return int 返回用户的历史记录总数。这个数字只包括与资源类型为1相关的记录。
102:      */
103:     public function userTotalHistory($uid)
104:     {
105:         // 使用别名H来引用UserHistory模型，以便在查询中使用
106:         // 加入store_spu表的关联查询，通过S.spu_id = H.res_id条件关联
107:         // 筛选条件：uid为指定用户ID且res_type为1
108:         // 返回满足条件的记录总数
109:         return UserHistory::alias('H')
110:             ->join('store_spu S','S.spu_id = H.res_id')
111:             ->where('uid',$uid)
112:             ->where('res_type', 1)
113:             ->count();
114:     }
115: 
116:     /**
117:      * 根据条件查询关联的SPU
118:      *
119:      * 本函数用于构建一个查询用户历史记录中特定SPU的查询语句。它允许通过关键词和其他条件来过滤结果。
120:      * 主要用于在用户历史记录中查找与特定条件匹配的SPU实体。
121:      *
122:      * @param array $where 查询条件数组，包含关键词、用户ID和资源类型。
123:      * @return \Illuminate\Database\Eloquent\Builder 返回构建好的查询构建器对象，用于进一步的查询操作或数据获取。
124:      */
125:     public function joinSpu($where)
126:     {
127:         // 初始化查询，基于是否有关键词来动态构建WHERE子句
128:         $query = UserHistory::hasWhere('spu',function($query) use($where){
129:             // 如果关键词存在且不为空，则添加LIKE条件来筛选store_name
130:             $query->when(isset($where['keyword']) && $where['keyword'] !== '', function($query) use ($where){
131:                 // 使用LIKE操作符来匹配关键词
132:                 $query->whereLike('store_name',"%{$where['keyword']}%");
133:             });
134:             // 添加一个总是为真的条件，用于确保WHERE子句的存在，以便后续的AND连接
135:             $query->where(true);
136:         });
137: 
138:         // 添加用户ID和资源类型作为查询条件
139:         $query->where('uid', $where['uid']);
140:         $query->where('res_type', $where['type']);
141: 
142:         // 返回构建好的查询构建器对象
143:         return $query;
144:     }
145: 
146: }
