181:             $mark = '成功充值余额' . floatval($recharge->price) . '元' . ($recharge->give_price > 0 ? ',赠送' . $recharge->give_price . '元' : '');
182:             app()->make(UserBillRepository::class)->incBill($recharge->user->uid, 'now_money', 'recharge', [
183:                 'link_id' => $recharge->recharge_id,
184:                 'status' => 1,
185:                 'title' => '余额充值',
186:                 'number' => $price,
187:                 'mark' => $mark,
188:                 'balance' => bcadd($recharge->user->now_money, $price, 2)
189:             ]);
190:             $recharge->user->now_money = bcadd($recharge->user->now_money, $price, 2);
191:             $recharge->user->save();
192:             $recharge->save();
193:         });
194:         Queue::push(SendSmsJob::class,['tempId' => 'USER_BALANCE_CHANGE', 'id' =>$orderId]);
195: 
196:         //小程序发货管理
197:         event('mini_order_shipping', ['recharge', $recharge, 3, '', '']);
198: 
199:         event('user.recharge',compact('recharge'));
200:     }
201: }
