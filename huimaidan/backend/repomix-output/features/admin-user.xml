1628:     /**
1629:      * 获取排行榜列表
1630:      *
1631:      * 本函数用于根据给定的排行榜键名、页码和每页数量，从缓存中获取指定页的排行榜列表。
1632:      * 排行榜数据以用户的UID、头像、昵称为基础，并包括每个用户在排行榜上的分数。
1633:      *
1634:      * @param string $key 排行榜的键名。
1635:      * @param int $page 当前页码。
1636:      * @param int $limit 每页的数量。
1637:      * @return array 返回包含排行榜数据总数和排行榜列表的数组。
1638:      */
1639:     public function topList($key, $page, $limit)
1640:     {
1641:         // 从缓存中获取指定页的排行榜数据，包括用户UID和分数，并按分数降序排列
1642:         $res = Cache::zrevrange($key, ($page - 1) * $limit, $limit, true);
1643:         // 提取排行榜数据中的用户UID作为数组键
1644:         $ids = array_keys($res);
1645:         // 获取排行榜中总的数据数量
1646:         $count = Cache::zcard($key);
1647:         // 根据用户UID查询用户详细信息，包括UID、头像和昵称，并转换为数组格式
1648:         $list = count($ids) ? $this->dao->users($ids, 'uid,avatar,nickname')->toArray() : [];
1649:         // 为每个用户添加其在排行榜上的分数
1650:         foreach ($list as $k => $v) {
1651:             $list[$k]['count'] = $res[$v['uid']] ?? 0;
1652:         }
1653:         // 提取每个用户在排行榜上的分数作为数组，用于后续的排序
1654:         $sort = array_column($list, 'count');
1655:         // 根据用户分数降序排列用户列表
1656:         array_multisort($sort, SORT_DESC, $list);
1657:         // 返回包含排行榜数据总数和排序后的用户列表的数组
1658:         return compact('count', 'list');
1659:     }
