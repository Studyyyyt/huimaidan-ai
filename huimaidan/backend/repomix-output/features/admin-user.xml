1003:      *
1004:      * @param User $user 用户对象，用于生成令牌的用户信息。
1005:      * @return array 包含令牌和过期时间的数组。
1006:      */
1007:     public function createToken(User $user)
1008:     {
1009:         // 实例化JWT令牌服务类
1010:         $service = new JwtTokenService();
1011: 
1012:         // 从配置获取用户令牌的有效期，默认为365天
1013:         $exp = intval(Config::get('admin.user_token_valid_exp', 365));
1014: 
1015:         // 使用服务类创建令牌，包括用户ID、令牌类型和过期时间
1016:         $token = $service->createToken($user->uid, 'user', strtotime("+ {$exp}day"));
1017: 
1018:         // 将生成的令牌及其过期时间存储到缓存中
1019:         $this->cacheToken($token['token'], $token['out']);
1020: 
1021:         // 返回生成的令牌信息
1022:         return $token;
1023:     }
