335:      *
336:      * 本函数用于统计在给定日期内，用户访问页面和小程序的总次数。
337:      * 它通过查询UserVisit模型的数据库记录，筛选出类型为'page'或'smallProgram'的访问记录，
338:      * 并统计这些记录的数量。
339:      *
340:      * @param string $date 需要统计访问数量的日期。
341:      * @return int 指定日期的访问数量。
342:      */
343:     public function dateVisitNum($date)
344:     {
345:         // 使用when方法条件性地加入日期查询条件，如果$date不为空，则根据$date查询创建时间
346:         return UserVisit::getDB()->when($date, function ($query, $date) {
347:             // 这里将查询条件应用到创建时间字段，用于筛选指定日期的记录
348:             getModelTime($query, $date, 'create_time');
349:         })->whereIn('type', ['page', 'smallProgram'])->count();
350:         // 筛选类型为'page'或'smallProgram'的记录，统计它们的数量
351:     }
352: 
353: 
354:     /**
355:      * 根据指定日期分组统计每日访问用户数。
356:      *
357:      * 本函数用于查询在指定日期范围内的每日独立访问用户数。
358:      * 通过分组查询，将创建时间转换为每天的格式，并统计每天的独立访问用户数。
359:      * 如果指定了日期，则查询该日期的访问数据；如果没有指定日期，则查询所有数据。
360:      *
361:      * @param string $date 指定的日期，格式为YYYY-MM-DD。如果为空，则查询所有日期的数据。
362:      * @return array 返回一个数组，每个元素包含每天的日期和独立访问用户数。
363:      */
364:     public function dateVisitNumGroup($date)
365:     {
366:         // 使用UserVisit模型的getDB方法获取数据库对象
367:         return UserVisit::getDB()->when($date, function ($query, $date) {
368:             // 如果指定了日期，则在查询中添加时间范围条件
369:             getModelTime($query, $date, 'create_time');
370:         })->field(Db::raw('from_unixtime(unix_timestamp(create_time),\'%m-%d\') as time, count(DISTINCT uid) as total'))
371:             // 按日期分组
372:             ->group('time')
373:             // 按日期升序排序
374:             ->order('time ASC')->select();
375:     }
376: 
377:     /**
378:      * 批量删除用户访问记录。
379:      *
380:      * 本函数提供两种方式批量删除用户访问记录：一种是根据访问ID数组进行删除，另一种是根据用户ID删除指定类型的访问记录。
381:      * - 当提供$ids参数时，会删除指定访问ID的记录。
382:      * - 当提供$uid参数时，会删除指定用户ID的所有产品访问记录。
383:      *
384:      * @param array|null $ids 访问ID数组，用于指定删除哪些访问记录。
385:      * @param int|null $uid 用户ID，用于指定删除属于哪个用户的访问记录。
386:      * @return int 删除的记录数。
387:      */
388:     public function batchDelete(? array $ids,?int  $uid)
389:     {
390:         // 如果提供了访问ID数组，则根据这些ID删除对应的访问记录。
391:         if($ids) return UserVisit::getDB()->where($this->getPk(),'in',$ids)->delete();
392: 
393:         // 如果提供了用户ID但没有提供访问ID数组，则删除该用户的所有产品访问记录。
394:         if($uid) return UserVisit::getDB()->where('uid',$uid)->where('type','product')->delete();
395:     }
396:     /**
397:      * 获取搜索日志
398:      *
399:      * @param array $where
400:      * @return void
401:      */
402:     public function clearSearchLog(array $where)
403:     {
404:         $query = $this->getModel()::when(isset($where['mer_id'])  && $where['mer_id'] !== '', function ($query) use ($where) {
405:             $query->where('type_id', $where['mer_id']);
406:         })->when(isset($where['type'])  && $where['type'] !== '', function ($query) use ($where) {
407:             if(is_array($where['type'])){
408:                 $query->where('type','in', $where['type']);
409:             }else{
410:                 $query->where('type', $where['type']);
411:             }
412:         });
413: 
414:         return $query->delete();
415:     }
416: }
