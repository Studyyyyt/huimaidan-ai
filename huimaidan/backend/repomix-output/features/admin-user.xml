 41:     /**
 42:      * 创建用户充值订单ID
 43:      *
 44:      * 本函数用于生成用户充值订单的唯一标识。订单ID由固定前缀、当前时间戳和自增序列组成，
 45:      * 保证了订单ID的唯一性。其中，自增序列基于当天已创建的充值订单数量，确保了每天的订单号不重复。
 46:      *
 47:      * @param int $uid 用户ID。用于区分不同用户的订单。
 48:      * @return string 返回生成的订单ID。
 49:      */
 50:     public function createOrderId($uid)
 51:     {
 52:         // 统计当天已创建的用户充值订单数量
 53:         $count = (int)UserRecharge::getDB()->where('uid', $uid)->where('create_time', '>=', date("Y-m-d"))->where('create_time', '<', date("Y-m-d", strtotime('+1 day')))->count();
 54: 
 55:         // 生成订单ID，格式为：类型前缀 + 当前时间戳 + 用户ID + 当天订单计数
 56:         return StoreOrderRepository::TYPE_SN_USER_RECHARGE . date('YmdHis', time()) . ($uid . $count);
 57:     }
 58: 
 59:     /**
 60:      * 计算用户的充值总额
 61:      *
 62:      * 本函数用于查询指定用户的所有已支付充值订单的总价，并返回这个总价。
 63:      * 充值订单的数据通过UserRecharge模型来访问和操作。
 64:      *
 65:      * @param int $uid 用户ID
 66:      *        本参数指定需要查询充值总额的用户，通过用户ID在数据库中定位到相应的充值记录。
 67:      * @return float 用户的充值总额
 68:      *         函数返回一个浮点数，代表指定用户的所有已支付充值订单的总价。
 69:      */
 70:     public function userRechargePrice($uid)
 71:     {
 72:         // 使用UserRecharge模型的getDB方法获取数据库实例
 73:         // 然后通过where语句筛选出uid为$uid且paid为1（表示已支付）的充值记录
 74:         // 最后使用sum方法计算这些记录的price列的总和，即用户的充值总额
 75:         return UserRecharge::getDB()->where('uid', $uid)->where('paid', 1)->sum('price');
 76:     }
 77: 
 78: 
 79:     /**
 80:      * 根据条件查询用户充值记录，并进行数据关联和字段筛选。
 81:      * 本函数用于构建查询用户充值记录的SQL语句，通过加入条件来筛选特定的充值记录。
 82:      *
 83:      * @param array $where 查询条件数组，包含keyword（关键字）、paid（支付状态）、date（日期）等条件。
 84:      * @return \think\db\Query 返回构建好的查询对象，可用于进一步操作或获取数据。
 85:      */
 86:     public function searchJoinQuery(array $where)
 87:     {
 88:         // 使用UserRecharge模型获取数据库对象，并设置表别名为a
 89:         return UserRecharge::getDB()->alias('a')
 90:             // 加入用户表b，根据uid进行关联
 91:             ->join('User b', 'a.uid = b.uid')
 92:             // 指定查询的字段，包括充值相关字段和用户相关字段
 93:             ->field('a.paid,a.order_id,a.recharge_id,b.nickname,b.avatar,a.price,a.give_price,a.recharge_type,a.pay_time,a.recharge_type')
 94:             // 当keyword条件存在且不为空时，添加模糊搜索条件，搜索昵称或订单号
 95:             ->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
 96:                 $query->whereLike('b.nickname|a.order_id', "%{$where['keyword']}%");
 97:             })
 98:             // 当paid条件存在且不为空时，按支付状态进行筛选
 99:             ->when(isset($where['paid']) && $where['paid'] !== '', function ($query) use ($where) {
100:                 $query->where('a.paid', $where['paid']);
101:             })
102:             ->when(isset($where['recharge_type']) && $where['recharge_type'] !== '', function ($query) use ($where) {
103:                 if ($where['recharge_type'] == 1) {
104:                     $query->whereIn('a.recharge_type', ['h5','weixin','routine']);
105:                 } else {
106:                     $query->whereIn('a.recharge_type', 'alipay');
107:                 }
108: 
109:             })
110:             ->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
111:                 $query->where('b.uid', $where['uid']);
112:             })
113:             ->when(isset($where['real_name']) && $where['real_name'] !== '', function ($query) use ($where) {
114:                 $query->whereLike('b.real_name', "%{$where['real_name']}%");
115:             })
116:             ->when(isset($where['nickname']) && $where['nickname'] !== '', function ($query) use ($where) {
117:                 $query->whereLike('b.nickname', "%{$where['nickname']}%");
118:             })
119:             ->when(isset($where['phone']) && $where['phone'] !== '', function ($query) use ($where) {
120:                 $query->whereLike('b.phone', "%{$where['phone']}%");
121:             })
122:             // 当date条件存在且不为空时，根据指定的日期范围筛选充值记录
123:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
124:                 getModelTime($query, $where['date'], 'a.create_time');
125:             });
126:     }
127: 
128:     /**
129:      * 计算所有已支付充值的总金额
130:      *
131:      * 本函数通过查询用户充值表中支付状态为已支付的记录，计算这些记录的充值金额总和。
132:      * 这样做的目的是为了获取系统中已实际完成充值交易的用户资金总流入额。
133:      *
134:      * @return float 返回已支付充值记录的金额总和
135:      */
136:     public function totalPayPrice()
137:     {
138:         // 使用UserRecharge模型的getDB方法获取数据库实例，并通过where条件筛选出支付状态为1（已支付）的记录，然后计算这些记录的price列的总和
139:         return UserRecharge::getDB()->where('paid', 1)->sum('price');
140:     }
141: 
142: 
143:     /**
144:      * 计算已退款的总金额
145:      *
146:      * 本函数用于查询并返回所有已支付订单的退款总金额。
147:      * 它通过查询UserRecharge表中paid状态为1（表示已支付）的订单的refund_price列的总和来实现。
148:      *
149:      * @return float 已退款的总金额
150:      */
151:     public function totalRefundPrice()
152:     {
153:         // 使用getDB方法获取数据库实例，并通过where子句筛选出已支付的订单，然后计算refund_price列的总和
154:         return UserRecharge::getDB()->where('paid', 1)->sum('refund_price');
