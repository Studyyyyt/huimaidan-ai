28:     /**
29:      * 根据条件搜索用户订单。
30:      *
31:      * 该方法通过接收一个包含各种搜索条件的数组，来查询符合这些条件的用户订单。
32:      * 搜索条件可以包括用户ID、关键词、电话、订单号、订单标题、订单类型、支付状态、支付方式、支付时间、商户ID、支付金额和创建时间等。
33:      * 方法使用了Eloquent ORM的链式调用功能，动态地构建SQL查询语句。
34:      *
35:      * @param array $where 包含搜索条件的数组。
36:      * @return \Illuminate\Database\Eloquent\Builder|static 返回构建的查询构建器实例。
37:      */
38:     public function search(array $where)
39:     {
40:         // 根据用户ID、关键词、电话进行查询条件构建
41:         return UserOrder::hasWhere('user', function ($query) use ($where) {
42:             // 当uid条件存在且不为空时，添加到查询条件中
43:             $query->when(isset($where['uid']) && $where['uid'] != '', function ($query) use ($where) {
44:                 $query->where('uid', $where['uid']);
45:             })
46:             // 当keyword条件存在且不为空时，以LIKE方式添加到查询条件中
47:             ->when(isset($where['keyword']) && $where['keyword'] != '', function ($query) use ($where) {
48:                 $query->whereLike('nickname', "%{$where['keyword']}%");
49:             })
50:             // 当phone条件存在且不为空时，添加到查询条件中
51:             ->when(isset($where['phone']) && $where['phone'] != '', function ($query) use ($where) {
52:                 $query->where('phone', $where['phone']);
53:             });
54:             // 保证这个where子句总是生效，用于后续连接其他条件
55:             $query->where(true);
56:         })
57:         // 根据订单号、订单标题进行查询条件构建
58:         ->when(isset($where['order_sn']) && $where['order_sn'] !== '', function ($query) use ($where) {
59:             $query->whereLike('order_sn', "%{$where['order_sn']}%");
60:         })
61:         ->when(isset($where['title']) && $where['title'] !== '', function ($query) use ($where) {
62:             $query->whereLike('title', "%{$where['title']}%");
63:         })
64:         // 根据订单类型、支付状态、支付方式进行查询条件构建
65:         ->when(isset($where['order_type']) && $where['order_type'] !== '', function ($query) use ($where) {
66:             $query->where('order_type', $where['order_type']);
67:         })
68:         ->when(isset($where['paid']) && $where['paid'] !== '', function ($query) use ($where) {
69:             $query->where('paid', $where['paid']);
70:         })
71:         ->when(isset($where['pay_type']) && $where['pay_type'] !== '', function ($query) use ($where) {
72:             $query->where('pay_type', $where['pay_type']);
73:         })
74:         // 根据支付时间和商户ID进行查询条件构建
75:         ->when(isset($where['pay_time']) && $where['pay_time'] !== '', function ($query) use ($where) {
76:             $query->whereDay('pay_time', $where['pay_time']);
77:         })
78:         ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
79:             $query->whereDay('mer_id', $where['mer_id']);
80:         })
81:         // 根据支付金额进行查询条件构建
82:         ->when(isset($where['pay_price']) && $where['pay_price'] !== '', function ($query) use ($where) {
83:             $query->where('UserOrder.pay_price', '>', $where['pay_price']);
84:         })
85:         // 根据创建时间进行查询条件构建
86:         ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
87:             getModelTime($query, $where['date'], 'UserOrder.create_time');
