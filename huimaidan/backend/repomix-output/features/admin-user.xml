 82:      * @return array 返回一个数组，数组的键为标签ID，值为标签名称。
 83:      */
 84:     public function allOptions($merId = 0)
 85:     {
 86:         // 使用UserLabel模型的getDB方法获取数据库操作对象，并设置查询条件为商家ID和类型为0，然后返回标签名称和ID的列。
 87:         return UserLabel::getDB()->where('mer_id', $merId)->where('type', 0)->column('label_name', 'label_id');
 88:     }
