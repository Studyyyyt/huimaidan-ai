265:     /**
266:      * 修改用户
267:      * @param $id
268:      * @param UserValidate $validate
269:      * @param UserLabelRepository $labelRepository
270:      * @param UserGroupRepository $groupRepository
271:      * @return mixed
272:      * @throws DbException
273:      * @author xaboy
274:      * @day 2020-05-09
275:      */
276:     public function update($id, UserValidate $validate, UserLabelRepository $labelRepository, UserGroupRepository $groupRepository)
277:     {
278:         $data = $this->request->params(['phone', 'card_id', 'mark', 'group_id', ['label_id', []], ['is_promoter', 0],
279:             ['status', 0], ['member_level', ''], ['extend_info', []],'promoter_switch']);
280:         $extend_info = $data['extend_info'];
281:         unset($data['extend_info']);
282:         $validate->check($data);
283:         if (!$user = $this->repository->get($id))
284:             return app('json')->fail('数据不存在');
285:         if ($data['group_id'] && !$groupRepository->exists($data['group_id']))
286:             return app('json')->fail('分组不存在');
287:         $label_id = (array)$data['label_id'];
288:         foreach ($label_id as $k => $value) {
289:             $label_id[$k] = (int)$value;
290:             if (!$labelRepository->exists((int)$value))
291:                 return app('json')->fail('标签不存在');
292:         }
293:         $data['label_id'] = implode(',', $label_id);
294:         if ($data['is_promoter'])
295:             $data['promoter_time'] = date('Y-m-d H:i:s');
296: //        if (!$data['birthday']) unset($data['birthday']);
297: 
298:         if ($data['member_level'] !== '') {
299:             $make = app()->make(UserBrokerageRepository::class);
300:             if ($data['member_level'] == $user->member_level) {
301:                 unset($data['member_level']);
302:             } else {
303:                 $has = $make->fieldExists('brokerage_level', $data['member_level'], null, 1);
304:                 if (!$has) return app('json')->fail('等级不存在');
305:                 $data['member_value'] = 0;
306: 
307:                 // 记录用户等级变化时成长值变化
308:                 if ($user->member_value > 0) {
309:                     app()->make(UserBillRepository::class)->decBill($user->uid, 'sys_members', 'platform_clearing', [
310:                         'number' => $user->member_value,
311:                         'title' => '平台修改等级',
312:                         'balance' => $data['member_value'],
313:                         'status' => 0,
314:                         'mark' => '平台修改等级清除成长值' . ':' . $user->member_value,
315:                     ]);
316:                 }
317:             }
318:         } else {
319:             unset($data['member_level']);
320:         }
321:         // 更新扩展字段
322:         $this->repository->saveFields((int)$id, $extend_info);
323:         $this->repository->update($id, $data);
324: 
325:         return app('json')->success('编辑成功');
326:     }
