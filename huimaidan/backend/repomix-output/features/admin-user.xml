123:     /**
124:      * 获取用户列表
125:      *
126:      * 根据给定的用户ID、页码和每页数量，查询用户列表。首先计算总记录数，然后根据页码和每页数量进行分页查询。
127:      * 主要用于分页显示用户列表的情况。
128:      *
129:      * @param int $uid 用户ID，用于指定查询哪个用户的列表。
130:      * @param int $page 当前页码，用于确定查询的起始位置。
131:      * @param int $limit 每页的数量，用于控制每页显示的记录数。
132:      * @return array 返回包含用户列表和总记录数的数组。
133:      */
134:     public function getList($uid,$page, $limit, $tourist_unique_key = '')
135:     {
136:         // 查询所有属于指定用户的记录
137:         $query = $this->dao->getAll($uid);
138:         if($tourist_unique_key){
139:             $query = $query->where('tourist_unique_key', $tourist_unique_key);
140:         }
141: 
142:         // 计算总记录数
143:         $count = $query->count();
144: 
145:         // 进行分页查询，并按照是否为默认排序
146:         $list = $query->page($page, $limit)->order('is_default desc')->select();
147: 
148:         // 返回包含总记录数和用户列表的数组
149:         return compact('count','list');
150:     }
