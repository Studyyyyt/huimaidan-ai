2250:                 $user->member->user_num--;
2251:                 $user->member->save();
2252: 
2253:                 $user->member_value = 0;
2254:             } else {
2255:                 $user->brokerage->user_num--;
2256:                 $user->brokerage->save();
2257: 
2258:             }
2259:             // 保存用户更新
