170:      * @param object $ret 订单返回对象，包含订单相关数据
171:      */
172:     public function payAfter($data, $ret)
173:     {
174:         $financialRecordRepository = app()->make(FinancialRecordRepository::class);
175:         $userBillRepository = app()->make(UserBillRepository::class);
176:         $bill = $userBillRepository->getWhere(['type' => 'svip_pay','link_id' => $ret->order_id]);
