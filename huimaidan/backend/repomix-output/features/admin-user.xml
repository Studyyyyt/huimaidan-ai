 82:      * @return bool 返回一个布尔值，表示给定ID的记录是否被标记为默认。如果记录是默认的，则返回true；否则返回false。
 83:      */
 84:     public function checkDefault(int $id)
 85:     {
 86:         // 通过DAO对象查询数据库，根据主键ID获取记录
 87:         $res = $this->dao->getWhere([$this->dao->getPk() => $id]);
 88: 
 89:         // 返回查询结果中'is_default'字段的值，该字段用于标记记录是否为默认
 90:         return $res['is_default'];
 91:     }
 92: 
 93:     /**
 94:      * 根据省份和城市名称获取城市ID
 95:      *
 96:      * 本函数通过省份和城市名称查询城市ID。首先，它根据省份名称获取该省份的数据，
 97:      * 然后使用城市名称和获取到的省份ID来获取具体城市的数据。如果找不到确切的城市数据，
 98:      * 则尝试查找以“直辖”开头的城市数据，这些城市也属于同一个省份。
 99:      * 这样做的目的是确保即使城市名称不完全匹配，也能尽可能准确地返回对应的城市ID。
100:      *
101:      * @param string $province 省份名称
102:      * @param string $city 城市名称
103:      * @return int 城市ID
104:      */
105:     public function getCityId($province,$city)
106:     {
107:         // 实例化CityRepository类，用于后续的数据查询操作
108:         $make = app()->make(CityRepository::class);
109: 
110:         // 根据省份名称查询省份数据
111:         $provinceData = $make->getWhere(['name' => $province]);
112: 
113:         // 根据城市名称和省份ID查询城市数据
114:         $cityData = $make->getWhere(['name' => $city,'parent_id' => $provinceData['city_id']]);
115: 
116:         // 如果查询不到具体城市数据，尝试查找以“直辖”开头的城市数据
117:         if(!$cityData)$cityData = $make->getWhere([['name','like','直辖'.'%'],['parent_id' ,'=', $provinceData['city_id']]]);
118: 
119:         // 返回查询到的城市ID
120:         return $cityData['city_id'];
121:     }
