 745:      * 修改用户积分
 746:      *
 747:      * 该方法用于处理用户积分的增加或减少操作。通过传入的类型参数来判断是增加还是减少积分，
 748:      * 并在事务中确保操作的原子性。操作完成后，还会记录用户的积分变动详情。
 749:      *
 750:      * @param int $id 用户ID
 751:      * @param int $adminId 操作管理员ID
 752:      * @param int $type 积分变动类型，1表示增加，其他表示减少
 753:      * @param int $integral 积分变动的数值
 754:      */
 755:     public function changeIntegral($id, $adminId, $type, $integral)
 756:     {
 757:         // 根据用户ID获取用户信息
 758:         $user = $this->dao->get($id);
 759:         // 使用事务处理来确保积分修改和账单记录的操作原子性
 760:         Db::transaction(function () use ($id, $adminId, $user, $type, $integral) {
 761:             // 强制将积分值转换为整型，确保数据类型的一致性和准确性
 762:             $integral = (int)$integral;
 763:             // 根据类型增加或减少积分，并保存新的积分值
 764:             $balance = $type == 1 ? bcadd($user->integral, $integral, 0) : max(0, bcsub($user->integral, $integral, 0));
 765:             $user->save(['integral' => $balance]);
 766:             /** @var UserBillRepository $make */
 767:             // 创建账单记录器实例，用于记录用户的积分变动情况
 768:             $make = app()->make(UserBillRepository::class);
 769:             // 根据积分变动类型，记录相应的增加或减少积分的账单
 770:             if ($type == 1) {
 771:                 $make->incBill($id, 'integral', 'sys_inc', [
 772:                     'link_id' => $adminId,
 773:                     'status' => 1,
 774:                     'title' => '系统增加积分',
 775:                     'number' => $integral,
 776:                     'mark' => '系统增加了' . $integral . '积分',
 777:                     'balance' => $balance
 778:                 ]);
 779:             } else {
 780:                 $make->decBill($id, 'integral', 'sys_dec', [
 781:                     'link_id' => $adminId,
 782:                     'status' => 1,
 783:                     'title' => '系统减少积分',
 784:                     'number' => $integral,
 785:                     'mark' => '系统减少了' . $integral . '积分',
 786:                     'balance' => $balance
 787:                 ]);
 788:             }
 789:         });
 790:     }
