1935:     /**
1936:      * 切换用户佣金到余额
1937:      *
1938:      * 该方法用于将用户的佣金转移到余额中。它通过调整用户的now_money和brokerage_price字段的值来实现此目的。
1939:      * 在这个过程中，它还记录了两次交易，一次是佣金增加到余额，另一次是佣金从佣金余额减少。
1940:      * 这个过程是在一个数据库事务中完成的，以确保数据的一致性。
1941:      *
1942:      * @param User $user 用户对象，表示进行佣金转移的用户
1943:      * @param float $brokerage 转移的佣金金额
1944:      */
1945:     public function switchBrokerage(User $user, $brokerage)
1946:     {
1947:         // 将佣金金额加到用户的现金额上
1948:         $user->now_money = bcadd($user->now_money, $brokerage, 2);
1949:         // 从用户的佣金价格中减去佣金金额
1950:         $user->brokerage_price = bcsub($user->brokerage_price, $brokerage, 2);
1951: 
1952:         // 开始一个数据库事务，以确保接下来的操作要么全部成功，要么全部失败
1953:         Db::transaction(function () use ($brokerage, $user) {
1954:             // 保存用户对象的更改，更新数据库中的用户记录
1955:             $user->save();
1956: 
1957:             // 创建用户账单记录，佣金增加到余额
1958:             app()->make(UserBillRepository::class)->incBill($user->uid, 'now_money', 'brokerage', [
1959:                 'link_id' => 0,
1960:                 'status' => 1,
1961:                 'title' => '佣金转入余额',
1962:                 'number' => $brokerage,
1963:                 'mark' => '成功转入余额' . floatval($brokerage) . '元',
1964:                 'balance' => $user->now_money
1965:             ]);
1966: 
1967:             // 创建用户账单记录，佣金从佣金余额减少
1968:             app()->make(UserBillRepository::class)->decBill($user->uid, 'brokerage', 'now_money', [
1969:                 'link_id' => 0,
1970:                 'status' => 1,
1971:                 'title' => '佣金转入余额',
1972:                 'number' => $brokerage,
1973:                 'mark' => '成功转入余额' . floatval($brokerage) . '元',
1974:                 'balance' => $user->brokerage_price
1975:             ]);
1976:         });
1977:     }
