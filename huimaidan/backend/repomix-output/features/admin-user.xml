1460:     /**
1461:      * 更新用户佣金排名
1462:      *
1463:      * 本函数用于根据用户ID（$uid）增加或减少用户的佣金，并更新其在周榜和月榜上的排名。
1464:      * $inc参数指定佣金的变化量，$type参数指定操作类型，默认为'+', 表示增加佣金。
1465:      *
1466:      * @param int $uid 用户ID
1467:      * @param float $inc 佣金变化量
1468:      * @param string $type 操作类型，默认为'+', 表示增加佣金；'-'表示减少佣金。
1469:      */
1470:     public function incBrokerage($uid, $inc, $type = '+')
1471:     {
1472:         // 构造月度佣金排行榜的键名
1473:         $moneyKey = 'b_top_' . date('Y-m');
1474:         // 构造周度佣金排行榜的键名
1475:         $weekKey = 'b_top_' . monday();
1476: 
1477:         // 从周度佣金排行榜中获取用户当前佣金，准备进行更新
1478:         //TODO 佣金周榜
1479:         $brokerage = Cache::zscore($weekKey, $uid);
1480:         // 根据$type的值决定是增加还是减少佣金，并保留两位小数
1481:         $brokerage = $type == '+' ? bcadd($brokerage, $inc, 2) : bcsub($brokerage, $inc, 2);
1482:         // 更新用户在周度佣金排行榜上的佣金及排名
1483:         Cache::zadd($weekKey, $brokerage, $uid);
1484: 
1485:         // 从月度佣金排行榜中获取用户当前佣金，准备进行更新
1486:         //TODO 佣金月榜
1487:         $brokerage = Cache::zscore($moneyKey, $uid);
1488:         // 根据$type的值决定是增加还是减少佣金，并保留两位小数
1489:         $brokerage = $type == '+' ? bcadd($brokerage, $inc, 2) : bcsub($brokerage, $inc, 2);
1490:         // 更新用户在月度佣金排行榜上的佣金及排名
1491:         Cache::zadd($moneyKey, $brokerage, $uid);
1492:     }
