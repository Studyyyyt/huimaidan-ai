 27:  * @package app\common\repositories\user
 28:  * @author xaboy
 29:  * @day 2020/6/2
 30:  * @mixin UserRechargeDao
 31:  */
 32: class UserRechargeRepository extends BaseRepository
 33: {
 34:     const TYPE_WECHAT = 'weixin';
 35:     const TYPE_ROUTINE = 'routine';
 36:     /**
 37:      * UserRechargeRepository constructor.
 38:      * @param UserRechargeDao $dao
 39:      */
 40:     public function __construct(UserRechargeDao $dao)
 41:     {
 42:         $this->dao = $dao;
 43:     }
 44: 
 45:     /**
 46:      * 创建充值订单
 47:      *
 48:      * 本函数用于生成一个新的充值订单。它根据传入的用户ID、充值金额、赠送金额和充值类型，
 49:      * 创建一个订单并返回订单数据。订单初始状态为未支付。
 50:      *
 51:      * @param int $uid 用户ID，用于关联订单和用户。
 52:      * @param float $price 充值金额，单位为元，精确到小数点后两位。
 53:      * @param float $givePrice 赠送金额，单位为元，精确到小数点后两位。
 54:      * @param string $type 充值类型，用于区分不同的充值方式，如：支付宝、微信等。
 55:      * @return array 返回新创建的订单数据。
 56:      */
 57:     public function create($uid, float $price, float $givePrice, string $type)
 58:     {
 59:         // 生成订单数据数组，包含用户ID、充值金额、赠送金额、充值类型、初始支付状态和订单ID。
 60:         $orderData = [
 61:             'uid' => $uid,
 62:             'price' => $price,
 63:             'give_price' => $givePrice,
 64:             'recharge_type' => $type,
 65:             'paid' => 0, // 订单初始支付状态为未支付。
 66:             'order_id' => $this->dao->createOrderId($uid) // 生成唯一的订单ID。
 67:         ];
 68: 
 69:         // 调用DAO层的方法创建订单，并返回创建的订单数据。
 70:         return $this->dao->create($orderData);
 71:     }
 72: 
 73:     /**
 74:      * 获取列表数据
 75:      * 通过此方法可以从数据库中检索满足特定条件的列表数据。它支持分页查询，以优化大型数据集的处理。
 76:      *
 77:      * @param string $where 查询条件，用于筛选数据。这是一个字符串，可能包含SQL的WHERE子句条件。
 78:      * @param int $page 当前页码，用于分页查询。
 79:      * @param int $limit 每页的数据条数，用于分页查询。
 80:      * @return array 返回一个包含两个元素的数组，'count'表示数据总数，'list'表示当前页的数据列表。
 81:      */
 82:     public function getList($where, $page, $limit)
 83:     {
 84:         // 构建查询语句，包括JOIN操作和排序规则
 85:         $query = $this->dao->searchJoinQuery($where)->order('a.pay_time DESC,a.create_time DESC');
 86: 
 87:         // 计算满足条件的数据总数
 88:         $count = $query->count();
 89: 
 90:         // 执行分页查询，并获取当前页的数据列表
 91:         $list = $query->page($page, $limit)->select();
 92: 
 93:         // 将数据总数和数据列表打包成数组返回
 94:         return compact('count', 'list');
 95:     }
