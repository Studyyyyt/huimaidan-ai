 14: namespace app\common\dao\user;
 15: 
 16: 
 17: use app\common\dao\BaseDao;
 18: use app\common\model\user\UserRelation;
 19: use app\common\model\user\UserRelation as model;
 20: 
 21: /**
 22:  * Class UserVisitDao
 23:  * @package app\common\dao\user
 24:  * @author xaboy
 25:  * @day 2020/5/27
 26:  */
 27: class UserRelationDao extends BaseDao
 28: {
 29: 
 30:     /**
 31:      * @return string
 32:      * @author xaboy
 33:      * @day 2020/5/27
 34:      */
 35:     protected function getModel(): string
 36:     {
 37:         return model::class;
 38:     }
 39: 
 40:     /**
 41:      * 检查指定字段是否存在
 42:      *
 43:      * 该方法通过查询数据库来确定给定字段的值是否在指定的条件下存在。
 44:      * 它支持通过可选参数来进一步限定查询的条件，如类型(type)和用户ID(uid)。
 45:      * 主要用于API中对数据存在性的验证。
 46:      *
 47:      * @param string $field 要查询的字段名
 48:      * @param mixed $value 字段对应的值
 49:      * @param string|null $type 可选参数，限定查询的数据类型
 50:      * @param int|null $uid 可选参数，限定查询的用户ID
 51:      * @return bool 查询结果，存在返回true，不存在返回false
 52:      */
 53:     public function apiFieldExists($field, $value, $type = null, $uid = null)
 54:     {
 55:         // 调用getModel方法获取模型实例，并链式调用getDB方法获取数据库实例
 56:         return $this->getModel()::getDB()
 57:             // 当$uid不为空时，添加where条件查询指定用户ID的数据
 58:             ->when($uid, function ($query) use ($uid) {
 59:                 $query->where('uid', $uid);
 60:             })
 61:             // 当$type不为空时，添加where条件查询指定类型的数据
 62:             ->when(!is_null($type), function ($query) use ($type) {
 63:                 $query->where('type', $type);
 64:             })
 65:             // 最终添加查询字段和值的条件
 66:             ->where($field, $value);
 67:     }
 68: 
 69: 
 70:     /**
 71:      * 根据条件搜索数据。
 72:      *
 73:      * 本函数用于根据提供的$where参数条件来搜索数据库中的记录。它支持两种条件：'type' 和 'uid'。
 74:      * 'type' 条件的处理逻辑是，如果类型值是在预定义的数组[1,2,3,4]中，则使用whereIn查询；
 75:      * 否则，直接使用where查询。'uid' 条件直接使用where查询。
 76:      *
 77:      * @param array $where 搜索条件数组，包含'type'和'uid'等键值对。
 78:      * @return \Illuminate\Database\Query\Builder|static 返回一个查询构建器实例，已应用搜索条件和排序。
 79:      */
 80:     public function search($where)
 81:     {
 82:         // 从模型中获取数据库实例，并应用条件查询
 83:         $query = ($this->getModel()::getDB())
 84:             // 当'type'条件存在且不为空时，应用相应的查询条件
 85:             ->when((isset($where['type']) && $where['type'] !== ''), function ($query) use ($where) {
 86:                 // 如果类型值在预定义数组中，使用whereIn查询；否则，直接使用where查询
 87:                 if(in_array($where['type'],[1,2,3,4])){
 88:                     $query->whereIn('type',[1,2,3,4]);
 89:                 }else{
 90:                     $query->where('type',$where['type']);
 91:                 }
 92:             })
 93:             // 当'uid'条件存在时，应用相应的查询条件
 94:             ->when((isset($where['uid']) && $where['uid']), function ($query) use ($where) {
 95:                 $query->where('uid', $where['uid']);
 96:             });
 97: 
 98:         // 返回应用了排序的查询构建器
 99:         return $query->order('create_time DESC');
100:     }
101: 
102: 
103:     /**
104:      * 删除数据
105:      *
106:      * 本函数用于根据指定的条件删除数据库中的记录。
107:      * 通过传入一个包含条件的数组，利用这些条件来定位特定的记录，并将它们从数据库中删除。
108:      *
109:      * @param array $where 删除条件数组，包含一个或多个用于定位记录的条件。
110:      */
111:     public function destory(array $where)
112:     {
113:         // 获取模型对应的数据库实例，并构建删除语句
114:         ($this->getModel()::getDB())->where($where)->delete();
115:     }
116: 
117: 
118:     /**
119:      * 计算指定日期内喜欢商家的用户数量
120:      *
121:      * 本函数用于查询在指定日期内，对特定商家喜欢的用户数量。
122:      * 如果未指定商家ID，则返回所有商家的喜欢用户数量。
123:      *
124:      * @param string $day 指定的日期，用于查询该日期内的喜欢情况。
125:      * @param int|null $merId 商家ID，可选参数，用于指定查询特定商家的喜欢用户数量。
126:      * @return int 返回指定日期内喜欢商家的用户数量。
127:      */
128:     public function dayLikeStore($day, $merId = null)
129:     {
130:         // 使用UserRelation模型查询数据库，条件为类型为10（表示喜欢操作），
131:         // 如果提供了商家ID，则进一步筛选出喜欢该商家的用户。
132:         // 最后，通过getModelTime处理查询结果，聚焦在指定日期，并计算用户数量。
133:         return getModelTime(UserRelation::getDB()->where('type', 10)->when($merId, function ($query, $merId) {
134:             $query->where('type_id', $merId);
135:         }), $day)->count();
136:     }
137: 
138: 
139:     /**
140:      * 统计指定日期内，指定商户的访问次数。
141:      *
142:      * 本函数用于查询在特定日期内，特定商户的用户访问次数。
143:      * 如果未指定日期，则返回所有时间的访问次数；如果未指定商户ID，则返回所有商户的访问次数。
144:      *
145:      * @param string $date 查询的日期，格式为YYYY-MM-DD。
146:      * @param int $merId 商户ID，可选参数，用于指定查询特定商户的访问次数。
147:      * @return int 返回符合条件的访问次数。
148:      */
149:     public function dateVisitStore($date, $merId = null)
150:     {
151:         // 从UserRelation类的getDB方法获取数据库查询对象，并开始构建查询条件
152:         return UserRelation::getDB()->where('type', 11)->when($merId, function ($query, $merId) {
153:             // 如果指定了商户ID，则添加where条件，查询特定商户的访问次数
154:             $query->where('type_id', $merId);
155:         })->when($date, function ($query, $date) {
156:             // 如果指定了日期，则调用getModelTime函数，添加where条件，查询特定日期的访问次数
157:             getModelTime($query, $date, 'create_time');
158:         })->count();
159:         // 计算符合条件的记录数，即访问次数，并返回结果
160:     }
161: 
162: 
163:     /**
164:      * 获取用户ID与指定类型ID交集的函数
165:      *
166:      * 本函数用于查询与给定用户ID相关的特定类型ID集合，
167:      * 其中类型ID是在预定义范围内的一组特定值。
168:      * 通过比较数据库中记录的类型ID，确定与用户相关联的ID集合。
169:      *
170:      * @param int $uid 用户的唯一标识ID
171:      * @param array $ids 指定的类型ID集合
172:      * @return array 返回与用户ID相关的指定类型ID的交集
173:      */
174:     public function intersectionPayer($uid, array $ids): array
175:     {
176:         // 通过UserRelation类的getDB方法获取数据库操作对象
177:         // 然后根据$uid查询满足条件的记录，其中"type"为12且"type_id"在$ids数组内的记录
178:         // 最后返回这些记录的"type_id"字段组成的数组
179:         return UserRelation::getDB()->where('uid', $uid)->whereIn('type', 12)->whereIn('type_id', $ids)->column('type_id');
180:     }
181: 
182: 
183:     /**
184:      * 获取用户关联的商品到社区的信息
185:      *
186:      * 本函数用于构建查询用户关联的商品（SPU）到社区的条件。支持通过关键词过滤，并限定关联状态为有效。
187:      * 主要用于在用户社区功能中展示用户关联的商品。
188:      *
189:      * @param string|null $keyword 关键词，用于过滤商品名称。如果为null，则不进行关键词过滤。
190:      * @param int $uid 用户ID，指定查询哪个用户的关联商品信息。
191:      * @return \Illuminate\Database\Eloquent\Builder 返回构建好的查询构建器对象，用于进一步的查询操作或数据获取。
192:      */
193:     public function getUserProductToCommunity(?string  $keyword, int $uid)
194:     {
195:         // 根据$keyword条件构建商品（SPU）的查询条件，支持模糊搜索，并限定关联状态为1（有效）
196:         $query = UserRelation::hasWhere('spu', function ($query) use($keyword) {
197:             $query->when($keyword, function ($query) use($keyword) {
198:                 // 当关键词存在时，进行模糊搜索
199:                 $query->whereLike('store_name',"%{$keyword}%");
200:             });
201:             // 限定关联状态为有效
202:             $query->where('status',1);
203:         });
204:         // 指定查询用户ID为$uid的关联信息
205:         $query->where('uid',$uid);
206:         return $query;
207:     }
208: 
209: }
