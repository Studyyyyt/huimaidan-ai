506:     /**
507:      * 计算并返回指定订单和用户ID的退款佣金总额。
508:      *
509:      * 本函数通过查询用户账单表，找出与指定订单ID和用户ID相关联的退款佣金记录，
510:      * 并计算这些记录的佣金总额。这有助于在处理退款时准确地调整用户的佣金余额。
511:      *
512:      * @param string $order_id 订单ID，用于查询与订单相关的佣金退款记录。
513:      * @param string $uid 用户ID，用于查询特定用户的佣金退款记录。
514:      * @return float 返回符合条件的佣金退款总额。
515:      */
516:     public function refundBrokerage($order_id, $uid)
517:     {
518:         // 使用UserBill的数据库实例，查询满足条件的佣金退款记录，并计算总数。
519:         return UserBill::getDB()->where('link_id', $order_id)->where('uid', $uid)
520:             ->where('category', 'brokerage')->whereIn('type', ['refund_two', 'refund_one'])->sum('number');
521:     }
