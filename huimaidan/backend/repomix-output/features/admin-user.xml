161:     /**
162:      * 用户访问搜索
163:      * @param array $where
164:      * @return \think\db\BaseQuery
165:      * @author wuhaotian
166:      * @email 442384644@qq.com
167:      * @date 2024/7/18
168:      */
169:     public function search(array $where)
170:     {
171:         $query = UserVisit::hasWhere('user', function ($query) use ($where) {
172:             $query = $query->where(true);
173:             $query->when(isset($where['nickname']) && $where['nickname'] !== '', function ($query) use ($where) {
174:                 $query->whereLike('User.nickname', "%{$where['nickname']}%");
175:             })->when(isset($where['user_type']) && $where['user_type'] !== '', function ($query) use ($where) {
176:                 $query->where('User.user_type', $where['user_type']);
177:             })->when(isset($where['phone']) && $where['phone'] !== '', function ($query) use ($where) {
178:                 $query->whereLike('User.phone', "%{$where['phone']}%");
179:             });
180:         });
181:         // 分组权限
182:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
183:             $query->whereIn('UserVisit.type_id', $region);
184:         }
185:         $query = $query->when(isset($where['uid'])  && $where['uid'] !== '', function ($query) use ($where) {
186:             $query->where('UserVisit.uid', $where['uid']);
187:         })->when(isset($where['mer_id'])  && $where['mer_id'] !== '', function ($query) use ($where) {
188:             $query->where('UserVisit.type_id', $where['mer_id']);
189:         })->when(isset($where['type'])  && $where['type'] !== '', function ($query) use ($where) {
190:             if(is_array($where['type'])){
191:                 $query->where('UserVisit.type','in', $where['type']);
192:             }else{
193:                 $query->where('UserVisit.type', $where['type']);
194:             }
195:         })->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
196:             getModelTime($query, $where['date'], 'UserVisit.create_time');
197:         })->when(isset($where['mom_date']) && $where['mom_date'] !== '', function ($query) use ($where) {
198:             momTime($query, $where['mom_date'], 'UserVisit.create_time');
199:         })->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
200:             $query->whereLike('UserVisit.content', "%{$where['keyword']}%");
201:         });
202: 
203:         return $query->order('UserVisit.create_time DESC');
204:     }
205: 
206:     /**
207:      * 计算指定日期内，每个用户的访问次数。
208:      *
209:      * 本函数用于统计在给定日期内，每个用户的访问产品数量。
210:      * 如果提供了商家ID，则只统计该商家的产品访问情况。
211:      *
212:      * @param string $date 统计日期，格式为YYYY-MM-DD。
213:      * @param int|null $merId 商家ID，可选参数，用于过滤特定商家的数据。
214:      * @return int 返回访问用户数量。
215:      */
216:     public function dateVisitUserNum($date, $merId = null)
217:     {
218:         // 从UserVisit模型中获取数据库实例，并设置别名为A
219:         return UserVisit::getDB()->alias('A')
220:             // 加入StoreProduct表，以获取产品相关信息
221:             ->join('StoreProduct B', 'A.type_id = B.product_id')
222:             // 当$date提供时，根据$date条件查询
223:             ->when($date, function ($query, $date) {
224:                 // 设置查询条件，根据$date筛选创建时间
225:                 getModelTime($query, $date, 'A.create_time');
226:             })
227:             // 当$merId提供时，添加条件查询特定商家的产品
228:             ->when($merId, function ($query, $merId) {
229:                 // 筛选商家ID为$merId的记录
230:                 $query->where('B.mer_id', $merId);
231:             })
232:             // 筛选类型为产品的记录
233:             ->where('A.type', 'product')
234:             // 按用户ID分组，以统计每个用户的访问次数
235:             ->group('uid')
236:             // 统计记录总数，即访问的用户数量
237:             ->count();
238:     }
