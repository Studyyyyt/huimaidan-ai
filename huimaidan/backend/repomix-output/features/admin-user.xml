277:     /**
278:      * 根据指定日期和商家ID，获取该商家产品访问量排名前$limit位的产品信息。
279:      *
280:      * 本函数通过查询用户访问记录和产品信息，统计指定日期内每个产品的访问量，并返回访问量排名前$limit的产品列表。
281:      * 这里的访问量是指用户点击产品的次数。
282:      *
283:      * @param string $date 查询的日期，格式为YYYY-MM-DD。如果未指定日期，则查询最近$limit天的数据。
284:      * @param int $merId 商家ID，用于限定查询商家下的产品。
285:      * @param int $limit 返回结果的数量限制，默认为7，即返回访问量排名前7的产品。
286:      * @return array 返回一个包含产品访问量排名前$limit的产品列表，每个元素包含产品访问量、产品图片、产品名称。
287:      */
288:     public function dateVisitProductNum($date, $merId, $limit = 7)
289:     {
290:         // 从用户访问记录表中查询数据，关联产品信息表和商家信息表
291:         return UserVisit::getDB()->alias('A')->join('StoreProduct B', 'A.type_id = B.product_id')
292:             ->join('Merchant C', 'C.mer_id = B.mer_id')
293:             // 选择查询的字段，包括产品访问量、产品图片和产品名称
294:             ->field(Db::raw('count(A.type_id) as total,B.image,B.store_name'))
295:             // 根据传入的日期条件进行查询，如果指定了日期，则只查询该日期的数据
296:             ->when($date, function ($query, $date) {
297:                 getModelTime($query, $date, 'A.create_time');
298:             })
299:             // 限定只查询访问类型为产品的记录，并且产品所属商家为传入的商家ID
300:             ->where('A.type', 'product')->where('B.mer_id', $merId)
301:             ->where('B.is_del', 0)->where('B.status', '1')
302:             // 按产品ID分组，统计每个产品的访问量
303:             ->group('A.type_id')
304:             // 按产品访问量降序排序
305:             ->order('total DESC')
306:             // 限制返回的结果数量
307:             ->limit($limit)
308:             // 执行查询并返回结果
309:             ->select();
310:     }
311: 
312:     /**
313:      * 计算指定日期内访问商家的总用户数
314:      *
315:      * 本函数通过查询用户访问记录，统计在指定日期内所有访问类型为产品的用户的数量。
316:      * 这里的访问记录是指用户与商家交互的行为记录，类型为产品表示用户访问了商家的产品。
317:      *
318:      * @param string $date 需要查询的日期，格式为YYYY-MM-DD
319:      * @return int 指定日期内访问商家的总用户数
320:      */
321:     public function dateVisitMerchantTotal($date)
322:     {
323:         // 使用UserVisit类中的getDB方法获取数据库连接
324:         // 当$date有值时，执行闭包函数进行查询条件的添加
325:         return UserVisit::getDB()->when($date, function ($query, $date) {
326:             // 添加查询条件，根据$date查询创建时间在该日期内的记录
327:             getModelTime($query, $date, 'create_time');
328:         })->whereIn('type', 'product')->count();
329:         // 筛选类型为产品的记录，然后统计满足条件的记录总数
330:     }
