 22: 
 23: /**
 24:  * Class FeedbackRepository
 25:  * @package app\common\repositories\user
 26:  * @author xaboy
 27:  * @day 2020/5/28
 28:  * @mixin FeedbackDao
 29:  */
 30: class FeedbackRepository extends BaseRepository
 31: {
 32:     /**
 33:      * FeedbackRepository constructor.
 34:      * @param FeedbackDao $dao
 35:      */
 36:     public function __construct(FeedbackDao $dao)
 37:     {
 38:         $this->dao = $dao;
 39:     }
 40: 
 41:     /**
 42:      * 根据条件获取反馈列表
 43:      *
 44:      * 本函数用于根据给定的条件数组 $where，以及分页信息 $page 和每页的条数 $limit，
 45:      * 从数据库中查询并返回反馈列表。列表包含反馈的数量 $count 和反馈项的详细信息 $list。
 46:      *
 47:      * @param array $where 查询条件数组
 48:      * @param int $page 当前页码
 49:      * @param int $limit 每页的条数
 50:      * @return array 包含反馈数量和反馈列表的数组
 51:      */
 52:     public function getList(array $where, $page, $limit)
 53:     {
 54:         // 初始化查询
 55:         $query = $this->dao->search($where)
 56:             ->with(['type' => function($query) {
 57:                 // 关联查询反馈类型，只获取feedback_category_id和cate_name两个字段
 58:                 $query->field('feedback_category_id,cate_name');
 59:             }]);
 60: 
 61:         // 计算反馈总数
 62:         $count = $query->count();
 63: 
 64:         // 分页查询并处理反馈列表中的images字段
 65:         $list = $query->page($page, $limit)
 66:             ->withAttr('images', function($val) {
 67:                 // 如果images字段不为空，则将其解析为数组，否则返回空数组
 68:                 return $val ? json_decode($val, true) : [];
 69:             })
 70:             ->select();
 71: 
 72:         // 返回包含反馈总数和反馈列表的数组
 73:         return compact('count', 'list');
 74:     }
 75: 
 76:     /**
 77:      * 根据ID获取反馈信息详情
 78:      *
 79:      * 本函数通过ID检索反馈信息的具体数据，并进一步获取该反馈类型及其父类型的名称，
 80:      * 以便在返回的数据中以更直观的方式显示反馈的分类信息。
 81:      *
 82:      * @param int $id 反馈信息的唯一标识ID
 83:      * @return array 包含反馈信息详情及类型和父类型名称的数据数组
 84:      */
 85:     public function get($id)
 86:     {
 87:         // 通过ID获取反馈信息的基本数据
 88:         $data = $this->dao->getWhere([$this->dao->getPk() => $id]);
 89: 
 90:         // 获取反馈信息所属类型的名称
 91:         $type = app()->make(FeedBackCategoryRepository::class)->getWhere(['feedback_category_id' => $data['type']]);
 92: 
 93:         // 获取反馈信息所属类型的父亲类型的名称
 94:         if($type) {
 95:             $parent = app()->make(FeedBackCategoryRepository::class)->getWhere(['feedback_category_id' => $type['pid']]);
 96:         }
 97: 
 98:         // 将类型和父类型的名称替换原有的ID值，以提供更直观的类型信息
 99:         $data['type'] = $type['cate_name'] ?? '';
100:         $data['category'] = $parent['cate_name'] ?? '';
101: 
102:         return $data;
103:     }
104: 
105: 
106:     /**
107:      * 准备回复表单的数据和结构。
108:      *
109:      * 此方法用于生成回复用户反馈的表单，通过给定的反馈ID获取反馈数据，并构建相应的表单用于回复。
110:      * 如果反馈数据不存在或该反馈已经回复过，则抛出异常。
111:      *
112:      * @param int $id 反馈数据的ID。
113:      * @return Form|\FormBuilder\Form
114:      *@throws ValidateException 如果反馈数据不存在或已回复，则抛出异常。
115:      */
116:     public function replyForm($id)
117:     {
118:         // 通过ID获取反馈数据
119:         $formData = $this->dao->get($id);
120:         // 检查反馈数据是否存在，如果不存在则抛出异常
121:         if (!$formData) throw new ValidateException('数据不存在');
122:         // 检查反馈状态，如果已回复则抛出异常
123:         if ($formData->status == 1) throw new ValidateException('该问题已回复过了');
124: 
125:         // 创建表单对象，并设置表单提交的URL
126:         $form = Elm::createForm(Route::buildUrl('systemUserFeedBackReply',['id' => $id])->build());
127:         // 设置表单的验证规则，包括一个文本区域用于输入回复内容
128:         $form->setRule([
129:             Elm::textarea('reply', '回复内容：')->placeholder('请输入回复内容')->required('请输入回复内容'),
130:         ]);
131: 
132:         // 设置表单标题，并加载反馈数据作为表单的默认数据
133:         return $form->setTitle('回复用户')->formData($formData->toArray());
134:     }
135: 
136: }
