 698:      * 通过事务处理确保操作的原子性，防止数据不一致。
 699:      *
 700:      * @param int $id 用户ID
 701:      * @param int $adminId 操作管理员ID
 702:      * @param int $type 操作类型，1表示增加，其他表示减少
 703:      * @param float $nowMoney 修改的余额数量
 704:      */
 705:     public function changeNowMoney($id, $adminId, $type, $nowMoney)
 706:     {
 707:         // 根据用户ID获取用户信息
 708:         $user = $this->dao->get($id);
 709:         // 使用事务处理来确保操作的原子性
 710:         Db::transaction(function () use ($id, $adminId, $user, $type, $nowMoney) {
 711:             // 根据操作类型计算新的余额
 712:             $balance = $type == 1 ? bcadd($user->now_money, $nowMoney, 2) : bcsub($user->now_money, $nowMoney, 2);
 713:             // 保存用户的新余额
 714:             $user->save(['now_money' => $balance]);
 715: 
 716:             // 创建用户账单记录对象
 717:             /** @var UserBillRepository $make */
 718:             $make = app()->make(UserBillRepository::class);
 719:             // 根据操作类型增加或减少用户的账单记录
 720:             if ($type == 1) {
 721:                 // 增加余额时的操作
 722:                 $make->incBill($id, 'now_money', 'sys_inc_money', [
 723:                     'link_id' => $adminId,
 724:                     'status' => 1,
 725:                     'title' => '系统增加余额',
 726:                     'number' => $nowMoney,
 727:                     'mark' => '系统增加了' . floatval($nowMoney) . '余额',
 728:                     'balance' => $balance
 729:                 ]);
 730:             } else {
 731:                 // 减少余额时的操作
 732:                 $make->decBill($id, 'now_money', 'sys_dec_money', [
 733:                     'link_id' => $adminId,
 734:                     'status' => 1,
 735:                     'title' => '系统减少余额',
 736:                     'number' => $nowMoney,
 737:                     'mark' => '系统减少了' . floatval($nowMoney) . '余额',
 738:                     'balance' => $balance
 739:                 ]);
 740:             }
 741:         });
 742:     }
