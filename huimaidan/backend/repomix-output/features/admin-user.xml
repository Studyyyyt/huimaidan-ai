302:      * @param array $data 包含产品类型和相关ID的数据数组。
303:      * @return mixed 返回找到的SPU信息。
304:      * @throws ValidateException 如果SPU不存在则抛出异常。
305:      */
306:     public function getSpu(array $data)
307:     {
308:         // 通过依赖注入创建SpuRepository实例
309:         $make = app()->make(SpuRepository::class);
310: 
311:         // 初始化用于查询条件的数组
312:         $where['product_type'] = $data['type'];
313: 
314:         // 根据产品类型设置查询条件
315:         switch ($data['type']) {
316:             case 0:
317:             case 1:
318:                 // 普通产品和秒杀产品通过product_id查询
319:                 $where['product_id'] = $data['type_id'];
320:                 break;
321:             default:
322:                 // 其他类型产品通过activity_id查询
323:                 $where['activity_id'] = $data['type_id'];
324:                 break;
325:         }
326: 
327:         // 执行查询并获取SPU信息
328:         $ret = $make->getSearch($where)->find();
329: 
330:         // 如果查询结果为空，则抛出异常
331:         if (!$ret) {
332:             throw new ValidateException('SPU不存在');
333:         }
334: 
335:         // 返回查询结果
336:         return $ret;
337:     }
