 63:      * @throws ValidateException 如果签到配置未开启，则抛出异常。
 64:      */
 65:     public function getDay(int $num)
 66:     {
 67:         // 当签到天数大于7时，计算该天数在一周内对应的实际天数
 68:         if($num > 7) {
 69:             $yu = ($num % 7);
 70:             $num = ($yu == 0) ? 6 : $yu - 1;
 71:         } else {
 72:             // 当签到天数小于等于7时，直接使用传入的天数，如果天数为0，则调整为0
 73:             $num = (($num -1) < 0) ? 0 : ($num -1);
 74:         }
 75: 
 76:         // 加载签到配置
 77:         $title = $this->signConfig();
 78:         // 如果签到配置为空，则抛出异常
 79:         if(empty($title)) throw new ValidateException('未开启签到功能');
 80: 
 81:         // 尝试获取传入天数对应的签到奖励配置
 82:         if (isset($title[$num]['value'])) {
 83:             $dat = $title[$num]['value'];
 84:         } else {
 85:             // 如果不存在对应的签到奖励配置，则返回默认的无签到奖励配置
 86:             $dat = [
 87:                 'sign_day' => '无',
