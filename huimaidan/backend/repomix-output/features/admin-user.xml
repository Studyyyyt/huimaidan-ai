220:     /**
221:      * 根据用户的交易记录和下级经纪人的佣金规则，计算下级经纪人的佣金比率。
222:      *
223:      * @param User $user 当前用户对象
224:      * @param UserBrokerage $nextLevel 下级经纪人的佣金规则对象
225:      * @return array 返回计算后的佣金比率和任务完成情况
226:      */
227:     public function getLevelRate(User $user, UserBrokerage $nextLevel)
228:     {
229:         // 查询用户指定条件的交易记录，用于后续计算佣金比率
230:         $info = app()->make(UserBillRepository::class)->search(['uid' => $user->uid, 'category' => 'sys_brokerage', 'link_id' => $nextLevel->user_brokerage_id])
231:             ->column('number', 'type');
232: 
233:         // 获取下级经纪人的佣金规则
234:         $brokerage_rule = $nextLevel['brokerage_rule'];
235: 
236:         // 遍历佣金规则，计算每个规则对应的佣金比率和完成任务的数量
237:         foreach ($nextLevel['brokerage_rule'] as $k => $rule) {
238:             // 如果规则的交易数量要求为0或负数，则移除该规则
239:             if ($rule['num'] <= 0) {
240:                 unset($brokerage_rule[$k]);
241:                 continue;
242:             }
243: 
244:             // 根据用户的交易数量和规则的要求数量，计算佣金比率
245:             if (!isset($info[$k])) {
246:                 $rate = 0;
247:             } else if ($rule['num'] > $info[$k]) {
248:                 $rate = bcdiv($info[$k], $rule['num'], 2) * 100;
249:             } else {
250:                 $rate = 100;
251:             }
252: 
253:             // 更新规则信息，添加佣金比率和已完成的任务数量
254:             $brokerage_rule[$k]['rate'] = $rate;
255:             $brokerage_rule[$k]['task'] = (float)(min($info[$k] ?? 0, $rule['num']));
256:         }
257: 
258:         // 返回计算后的佣金规则信息
259:         return $brokerage_rule;
260:     }
