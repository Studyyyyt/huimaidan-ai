143: 
144:     /**
145:      * 获取用户标签交集
146:      * 该方法用于根据给定的标签ID数组，商家ID和可选的标签类型，从数据库中查询并返回符合条件的标签ID集合。
147:      *
148:      * @param array $ids 标签ID数组，表示需要查询的标签范围。
149:      * @param int $merId 商家ID，表示查询指定商家的标签。
150:      * @param string|null $type 标签类型，可选参数，用于进一步筛选标签类型。
151:      * @return array 返回符合条件的标签ID集合。
152:      */
153:     public function intersection(array $ids, $merId, $type)
154:     {
155:         // 使用UserLabel的数据库连接，并构造查询条件
156:         return UserLabel::getDB()->whereIn('label_id', $ids)->where('mer_id', $merId)->when(!is_null($type), function ($query) use ($type) {
157:             // 如果指定了标签类型，则添加类型查询条件
158:             $query->where('type', $type);
159:         })->column('label_id');
160:     }
