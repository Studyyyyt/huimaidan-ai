32:     /**
33:      * 检查用户字段是否存在
34:      *
35:      * 本函数用于确定在用户数据表中，给定的字段是否包含特定的值。
36:      * 这对于验证用户输入、防止重复数据等场景非常有用。
37:      *
38:      * @param string $field 要检查的字段名。这可以是用户数据表中的任何字段。
39:      * @param mixed $value 要与字段值进行比较的值。可以是任何数据类型。
40:      * @param int $uid 用户ID，用于限定查询的用户范围。
41:      * @return bool 如果找到匹配的记录，则返回true；否则返回false。
42:      */
43:     public function userFieldExists($field, $value,$uid): bool
44:     {
45:         // 通过模型获取数据库实例，并构造查询条件，检查是否存在uid为$uid且$field字段值为$value的记录
46:         return (($this->getModel()::getDB())->where('uid',$uid)->where($field,$value)->count()) > 0;
47:     }
48: 
49:     /**
50:      * 修改默认设置
51:      *
52:      * 本函数用于将指定用户的默认状态设置为0，即取消默认设置。这通常在需要重新指定默认选项或
53:      * 在用户取消其默认设置时调用。
54:      *
55:      * @param int $uid 用户ID
56:      *               传入需要修改默认设置的用户的唯一标识ID。这个ID用于在数据库中定位到具体的用户记录。
57:      * @return int 返回影响的行数
58:      *             函数返回的是执行更新操作后影响的行数。如果返回0，表示没有更新任何行，即没有找到指定ID的用户；
59:      *             如果返回大于0的数，表示成功更新了相应数量的行，即成功取消了指定用户的默认设置。
60:      */
61:     public function changeDefault(int $uid)
62:     {
63:         // 通过模型获取数据库实例，并使用where子句定位到指定UID的用户记录，然后更新is_default字段为0。
64:         return ($this->getModel()::getDB())->where('uid',$uid)->update(['is_default' => 0]);
65:     }
