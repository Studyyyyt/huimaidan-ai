184:             $userInfo = app()->make(UserRepository::class)->getWhere(['uid' => $uid],'uid,avatar,nickname,integral');
185:             $count = $this->dao->getSearch(['uid' => $uid])->count('*');
186:         }
187:         $title = $this->signConfig();
188:         return compact('userInfo','is_sign','sign_num','count','title');
189: 
190:     }
191: 
192:     /**
193:      * 获取签名配置
194:      *
195:      * 本函数用于获取签到配置的相关信息，特别是针对一周内每一天的签到标题。
196:      * 它首先通过依赖注入的方式创建了一个GroupRepository的实例，用于后续获取签到天数的配置。
197:      * 接着，利用GroupDataRepository来查询具体的签到标题数据，这些数据是根据签到天数配置来获取的，并且只包含状态为1（有效）的数据。
198:      * 最后，将查询结果转换为数组并返回，这个结果包含了签到标题在内的相关信息，而一些敏感或不必要的信息（如ID、创建时间等）被隐藏。
199:      *
200:      * @return array 返回包含签到配置信息的数组，特别是每一天的签到标题。
201:      */
202:     public function signConfig(){
203:         // 通过依赖注入创建GroupRepository实例，用于查询签到天数配置
204:         $group_make = app()->make(GroupRepository::class);
205:         // 根据ID获取签到天数配置
206:         $sign_day_config = $group_make->keyById('sign_day_config');
207: 
208:         // 通过依赖注入创建GroupDataRepository实例，用于查询签到标题数据
209:         $title = app()->make(GroupDataRepository::class)
210:             // 根据签到天数配置查询签到标题数据，并限制查询结果为最近7天
211:             ->getGroupDataWhere(0,$sign_day_config)
212:             // 筛选出状态为有效的数据
213:             ->where('status',1)
214:             // 限制查询结果数量为7条
215:             ->limit(7)
216:             // 隐藏某些字段
217:             ->hidden(['group_data_id','group_id','create_time','mer_id'])
218:             // 执行查询并转换为数组形式返回
219:             ->select()->toArray();
220: 
221:         // 返回查询结果
222:         return $title;
223:     }
224: 
225:     /**
226:      * 连续签到 获取 1- 7 天
227:      * @param $uid
228:      * @return array
229:      * @author Qinii
230:      * @day 6/10/21
231:      */
232:     public function signStatus($uid)
233:     {
234:         $day = date('Y-m-d',time());
235:         $sign_num = 0;
236:         $sign_num = $this->getSign($uid,$day);
237:         $is_sign = $sign_num ? 1 : 0;
238: 
239:         if($sign_num > 7){
240:             $sign_num = ($sign_num % 7);
241:             if(!$sign_num) $sign_num = 7;
242:         }
243: 
244:         if(!$is_sign){
245:             $yesterday = date("Y-m-d",strtotime("-1 day"));
246:             $sign_num = $this->getSign($uid,$yesterday) ?: 0;
247:             if($sign_num > 7){
248:                 $sign_num = ($sign_num % 7);
249:             }
250:         }
251:         return compact('is_sign','sign_num');
252:     }
253: 
254:     /**
255:      * 按月显示签到记录
256:      * @param array $where
257:      * @return array
258:      * @author Qinii
259:      * @day 6/10/21
260:      */
261:     public function month(array $where)
262:     {
263:         $group = $this->dao->getSearch($where)->field('FROM_UNIXTIME(unix_timestamp(create_time),"%Y-%m") as time')
264:             ->order('time DESC')->group('time')->select();
265:         $ret = [];
266:         foreach ($group as $k => $item){
267:             $ret[$k]['month'] = $item['time'];
268:             $query = $this->dao->getSearch($where)->field('title,number,create_time')->whereMonth('create_time',$item['time']);
269:             $ret[$k]['list'] = $query->order('create_time DESC')->select();
270:         }
271:         return $ret;
272:     }
273: }
