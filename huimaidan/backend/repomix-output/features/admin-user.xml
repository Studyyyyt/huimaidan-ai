 98: 
 99:     /**
100:      * 根据充值金额获取赠送金额。
101:      *
102:      * 本函数用于根据用户充值的金额，确定相应的赠送金额。系统预设了不同充值金额区间的赠送规则，
103:      * 本函数通过查询这些规则，找到适用的赠送金额。
104:      *
105:      * @param float $price 充值金额。
106:      * @return float 返回应赠送的金额。
107:      */
108:     public function priceByGive($price)
109:     {
110:         // 获取系统设置的充值额度和赠送额度规则
111:         $quota = systemGroupData('user_recharge_quota');
112:         $give = 0.0; // 初始化赠送金额为0
113: 
114:         // 遍历规则数组，找出适用的赠送规则
115:         foreach ($quota as $item) {
116:             $min = floatval($item['price']); // 当前规则的最低充值金额
117:             $_give = floatval($item['give']); // 当前规则的赠送金额
118: 
119:             // 如果当前充值金额大于等于当前规则的最低充值金额，更新赠送金额
120:             if ($price >= $min) {
121:                 $give = $_give;
122:             }
123:         }
124: 
125:         return $give; // 返回计算出的赠送金额
126:     }
127: 
128:     /**
129:      * 处理用户充值支付逻辑。
130:      *
131:      * 根据支付类型和是否为APP环境，生成相应的支付配置。支持微信和支付宝两种支付方式，
132:      * 当在APP环境中支付时，支付类型会相应地加上App后缀。在支付前，会触发一个before充值事件，
133:      * 允许其他功能模块在充值前进行额外的操作或校验。最终，返回包含支付配置和充值ID等信息的数组。
134:      *
135:      * @param string $type 支付方式，支持'weixin'和'alipay'。
136:      * @param User $user 进行充值的用户对象。
137:      * @param UserRecharge $recharge 用户充值记录对象。
138:      * @param string $return_url 支付宝充值成功后的回调URL，可选。
139:      * @param bool $isApp 是否在APP环境中支付，默认为false。
140:      * @return array 包含支付配置和充值ID等信息的数组。
141:      */
142:     public function pay(string $type, User $user, UserRecharge $recharge, $return_url = '', $isApp = false)
143:     {
144:         // 根据支付方式和是否为APP环境，调整支付类型
145:         if (in_array($type, ['weixin', 'alipay'], true) && $isApp) {
146:             $type .= 'App';
147:         }
148: 
149:         // 触发用户充值前的事件，允许其他功能模块介入
150:         event('user.recharge.before', compact('user', 'recharge', 'type', 'isApp'));
151: 
152:         // 根据支付类型创建支付服务对象，并初始化支付参数
153:         $service = new PayService($type, $recharge->getPayParams($type === 'alipay' ? $return_url : ''), 'user_recharge');
154: 
155:         // 生成支付配置
156:         $config = $service->pay($user);
157: 
158:         // 返回支付配置，加上充值ID和支付类型，供前端进行支付操作
159:         return $config + ['recharge_id' => $recharge['recharge_id'], 'type' => $type];
160:     }
161: 
162:     /**
163:      * //TODO 余额充值成功
164:      *
165:      * @param $orderId
166:      * @throws \think\db\exception\DataNotFoundException
167:      * @throws \think\db\exception\DbException
