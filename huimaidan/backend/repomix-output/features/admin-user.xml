185:      *
186:      * 本函数用于根据给定的条件查询SPU相关的历史记录，并分页返回结果。
187:      * 主要包括查询条件、分页参数，以及返回数据的格式化。
188:      *
189:      * @param string|array $where 查询条件，可以是字符串或者数组形式的SQL条件。
190:      * @param int $page 当前页码，用于分页查询。
191:      * @param int $limit 每页显示的记录数，用于分页查询。
192:      * @return array 返回包含记录总数和历史记录列表的数组。
193:      */
194:     public function historyLst($where,$page,$limit)
195:     {
196:         // 根据查询条件进行SPU的连接查询
197:         $query = $this->dao->joinSpu($where);
198:         // 声明要包含的关联数据，并按更新时间降序排序
199:         $query->with([
200:             'spu'
201:         ])->order('update_time DESC');
202:         // 计算满足条件的总记录数
203:         $count = $query->count();
204:         // 进行分页查询，并指定查询字段，返回历史记录列表
205:         $list = $query->page($page, $limit)
206:             ->setOption('field',[])->field('uid,product_id,product_type,spu_id,image,store_name,price')
207:             ->select();
