159:         return UserMerchant::getDB()->where('mer_id', $mer_id)->where('pay_price', '>=', $min)->when(!is_null($max), function ($query) use ($max, $min) {
160:             // 如果指定了最大值，则进一步限定支付价格小于等于最大值
161:             $query->where('pay_price', $min == $max ? '<=' : '<', $max);
162:         })->group('uid')->column('uid');
163:     }
