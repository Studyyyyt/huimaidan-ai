172:     /**
173:      * 检查用户是否满足升级经纪人的条件
174:      *
175:      * 本函数用于评估当前用户是否满足升级为其指定经纪人的条件。它通过查询用户的交易记录，
176:      * 并对比经纪人的升级规则，来判断用户是否达到升级标准。如果用户满足条件，则进行升级操作，
177:      * 包括更新用户和经纪人的相关数据，并记录用户的经纪级别。
178:      *
179:      * @param User $user 当前待评估的用户对象
180:      * @param UserBrokerage $nextLevel 用户待升级的下一个经纪级别对象
181:      * @return bool 如果用户满足升级条件，则返回true；否则返回false。
182:      */
183:     public function checkLevel(User $user, UserBrokerage $nextLevel)
184:     {
185:         // 查询用户的交易记录，满足特定条件的记录将用于评估升级条件
186:         $info = app()->make(UserBillRepository::class)->search(['uid' => $user->uid, 'category' => 'sys_brokerage', 'link_id' => $nextLevel->user_brokerage_id])
187:             ->column('number', 'type');
188: 
189:         // 遍历经纪人的升级规则，检查用户是否满足所有规则条件
190:         foreach ($nextLevel['brokerage_rule'] as $k => $rule) {
191:             // 如果用户交易记录中不存在对应类型的记录，且规则要求的交易数量大于0，则不满足升级条件
192:             if (!isset($info[$k]) && $rule['num'] > 0) return false;
193:             // 如果用户交易记录数量小于规则要求的数量，则不满足升级条件
194:             if ($rule['num'] > 0 && $rule['num'] > $info[$k]) return false;
195:         }
196: 
197:         // 用户满足升级条件，准备进行数据更新
198:         $nextLevel->user_num++;
199:         Db::transaction(function () use ($nextLevel, $user) {
200:             // 保存更新后的下一个经纪级别信息
201:             $nextLevel->save();
202:             // 如果当前用户已有经纪人，并且其用户数量大于0，则减少该经纪人的用户数量
203:             if ($user->brokerage && $user->brokerage->user_num > 0) {
204:                 $user->brokerage->user_num--;
205:                 $user->brokerage->save();
206:             }
207:             // 更新用户经纪级别，并保存
208:             $user->brokerage_level = $nextLevel->brokerage_level;
209:             $user->save();
210: 
211:             // 将用户的经纪级别信息缓存起来，以便后续快速查询
212:             $key = 'notice_brokerage_level_' . $user->uid;
213:             app()->make(CacheRepository::class)->save($key,$nextLevel->brokerage_level);
214:         });
215: 
216:         // 返回true，表示用户满足升级条件
217:         return true;
218:     }
