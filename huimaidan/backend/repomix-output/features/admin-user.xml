 14: namespace app\common\repositories\user;
 15: 
 16: 
 17: use app\common\dao\user\LabelRuleDao;
 18: use app\common\repositories\BaseRepository;
 19: use FormBuilder\Factory\Elm;
 20: use think\facade\Db;
 21: 
 22: /**
 23:  * Class LabelRuleRepository
 24:  * @package app\common\repositories\user
 25:  * @author xaboy
 26:  * @day 2020/10/20
 27:  * @mixin LabelRuleDao
 28:  */
 29: class LabelRuleRepository extends BaseRepository
 30: {
 31:     /**
 32:      * LabelRuleRepository constructor.
 33:      * @param LabelRuleDao $dao
 34:      */
 35:     public function __construct(LabelRuleDao $dao)
 36:     {
 37:         $this->dao = $dao;
 38:     }
 39: 
 40:     /**
 41:      * 根据条件获取列表数据
 42:      *
 43:      * 本函数用于根据给定的条件数组 $where，从数据库中检索满足条件的数据列表。
 44:      * 它支持分页查询，每页的数据数量由 $limit 指定，查询结果将包含数据总数和当前页的数据列表。
 45:      *
 46:      * @param array $where 查询条件数组，用于指定数据库查询的条件。
 47:      * @param int $page 当前页码，用于指定要返回的页码。
 48:      * @param int $limit 每页的数据数量，用于指定每页返回的数据条数。
 49:      * @return array 返回包含 'count' 和 'list' 两个元素的数组，'count' 为数据总数，'list' 为数据列表。
 50:      */
 51:     public function getList(array $where, $page, $limit)
 52:     {
 53:         // 根据条件查询数据，$where 为查询条件数组
 54:         $query = $this->dao->search($where);
 55: 
 56:         // 统计满足条件的数据总数
 57:         $count = $query->count();
 58: 
 59:         // 查询满足条件的数据列表，带有 'label' 关联数据，按 'label_rule_id' 倒序排列
 60:         // 分页查询，返回当前页码的 $limit 条数据，并将结果转换为数组形式
 61:         $list = $query->with(['label'])->order('label_rule_id DESC')->page($page, $limit)->select()->toArray();
 62: 
 63:         // 返回包含数据总数和数据列表的数组
 64:         return compact('count', 'list');
 65:     }
 66: 
 67:     /**
 68:      * 创建用户标签并关联数据
 69:      *
 70:      * 本函数通过事务处理的方式，先创建用户标签，然后将标签ID关联到指定的数据中。
 71:      * 这样做的目的是为了确保标签创建和关联操作的原子性，即要么两个操作都成功，要么都失败。
 72:      *
 73:      * @param array $data 包含标签名称和其他必要数据的信息数组。
 74:      * @return bool|int 返回新创建数据的ID或者false，如果操作失败。
 75:      */
 76:     public function create($data)
 77:     {
 78:         // 使用数据库事务处理来确保操作的原子性
 79:         return Db::transaction(function () use ($data) {
 80:             // 提取标签名称，准备创建用户标签
 81:             $labelName = $data['label_name'];
 82:             // 从$data中移除'label_name'，因为它将用于创建标签，而不是数据本身
 83:             unset($data['label_name']);
 84: 
 85:             // 创建用户标签，并指定标签的类型为1
 86:             $label = app()->make(UserLabelRepository::class)->create([
 87:                 'label_name' => $labelName,
 88:                 'mer_id' => $data['mer_id'],
 89:                 'type' => 1
 90:             ]);
 91: 
 92:             // 将新创建的标签ID赋值给$data，准备插入到关联数据表中
 93:             $data['label_id'] = $label->label_id;
 94: 
 95:             // 使用DAO模式创建关联数据，并返回创建结果
 96:             return $this->dao->create($data);
 97:         });
 98:     }
 99: 
100:     /**
101:      * 更新规则信息。
102:      * 该方法通过使用事务来确保更新操作的原子性，它首先根据$id$获取规则信息，然后更新规则的某些字段。
103:      * 特别地，它将'label_name'字段从$data$中提取出来，用于单独更新标签名称，这是因为标签名称的更新涉及到另一个表的操作。
104:      *
105:      * @param int $id 规则的唯一标识符。
106:      * @param array $data 包含需要更新的规则字段的数据数组。
107:      * @return bool 更新操作的结果，true表示成功，false表示失败。
108:      */
109:     public function update($id, $data)
110:     {
111:         // 根据$id$获取规则信息
112:         $rule = $this->dao->get($id);
113: 
114:         // 使用事务来确保数据更新的一致性
115:         return Db::transaction(function () use ($data, $rule) {
116:             // 从$data$中提取标签名称，因为标签名称的更新需要单独处理
117:             $labelName = $data['label_name'];
118:             // 从$data$中移除不需要的字段，这些字段不是规则更新的一部分
119:             unset($data['mer_id'], $data['label_name']);
120:             // 更新标签名称，这涉及到另一个实体的更新
121:             app()->make(UserLabelRepository::class)->update($rule->label_id, ['label_name' => $labelName]);
122:             // 更新规则本身的信息
123:             return $rule->save($data);
124:         });
125:     }
126: 
127:     /**
128:      * 删除规则及其关联的用户标签。
129:      *
130:      * 本函数通过事务处理方式，确保删除规则的同时，关联的用户标签也能被正确删除。
131:      * 这样做是为了维护数据的一致性和完整性，避免因单个操作失败导致的数据不一致问题。
132:      *
133:      * @param int $id 规则的ID，用于查找并删除特定的规则。
134:      * @return bool 返回删除操作的结果，true表示删除成功，false表示删除失败。
135:      */
136:     public function delete($id)
137:     {
138:         // 根据$id获取规则信息，为后续的删除操作做准备。
139:         $rule = $this->dao->get($id);
140: 
141:         // 使用事务处理来确保多个数据库操作的原子性。
142:         return Db::transaction(function () use ($rule) {
143:             // 删除与规则关联的用户标签。
144:             app()->make(UserLabelRepository::class)->delete($rule->label_id);
145:             // 从用户中移除与规则关联的标签。
146:             app()->make(UserRepository::class)->rmLabel($rule->label_id);
147:             // 删除规则本身。
148:             return $rule->delete();
149:         });
150:     }
151: 
152:     /**
153:      * 同步用户数量。
154:      * 根据给定的规则ID，更新规则的用户数量和标签，并根据规则的类型（订单金额或订单数量）来筛选用户。
155:      * 使用事务来确保数据库操作的一致性。
156:      *
157:      * @param int $id 规则ID
158:      */
159:     public function syncUserNum($id)
160:     {
161:         // 获取规则信息
162:         $rule = $this->dao->get($id);
163:         // 更新规则的更新时间
164:         $rule->update_time = date('Y-m-d H:i:s');
165: 
166:         // 初始化用户ID数组
167:         $ids = [];
168:         // 创建用户商家仓库实例
169:         $userMerchantRepository = app()->make(UserMerchantRepository::class);
170: 
171:         // 根据规则的类型，获取符合条件的用户ID
172:         // 订单金额
173:         if ($rule->type == 1) {
174:             $ids = $userMerchantRepository->priceUserIds($rule->mer_id, $rule->min, $rule->max);
175:         // 订单数
176:         } else if ($rule->type == 0) {
177:             $ids = $userMerchantRepository->numUserIds($rule->mer_id, $rule->min, $rule->max);
178:         }
179: 
180:         // 更新规则的用户数量
181:         $rule->user_num = count($ids);
182: 
183:         // 将用户ID分批处理，每批50个
184:         $idList = array_chunk($ids, 50);
185: 
186:         // 使用事务来执行数据库操作
187:         Db::transaction(function () use ($rule, $idList, $userMerchantRepository) {
188:             // 删除旧的标签
189:             $userMerchantRepository->rmLabel($rule->label_id);
190: 
191:             // 遍历用户ID分批，更新用户标签
192:             foreach ($idList as $ids) {
193:                 $userMerchantRepository->search(['uids' => $ids])->update([
194:                     'A.label_id' => Db::raw('trim(BOTH \',\' FROM CONCAT(IFNULL(A.label_id,\'\'),\',' . $rule->label_id . '\'))')
195:                 ]);
196:             }
197: 
198:             // 保存更新后的规则信息
199:             $rule->save();
200:         });
201:     }
202: 
203: }
