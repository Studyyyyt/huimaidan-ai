1044:     /**
1045:      * 缓存用户令牌。
1046:      *
1047:      * 本函数用于将用户的令牌及其过期时间存储到缓存中。缓存的目的是为了提高访问速度，
1048:      * 避免频繁地对数据库或持久层进行读写操作。令牌的缓存时间由$exp参数指定，
1049:      * 在此时间范围内，用户无需再次进行身份验证。
1050:      *
1051:      * @param string $token 用户的令牌。这是一个唯一标识用户的字符串。
1052:      * @param int $exp 令牌的过期时间，以秒为单位。从当前时间开始，令牌将在$exp秒后失效。
1053:      */
1054:     public function cacheToken(string $token, int $exp)
1055:     {
1056:         // 使用文件缓存系统存储用户令牌及其过期时间。
1057:         // 'user_'前缀用于区分不同类型的缓存数据，这里特指用户令牌。
1058:         // $exp作为第三个参数指定缓存的过期时间。
1059:         Cache::set('user_' . $token, time() + $exp, $exp);
1060:     }
