 83:     public function search(array $where)
 84:     {
 85:         return UserMerchant::getDB()->alias('A')->rightJoin('User B', 'A.uid = B.uid')
 86:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
