342:     /**
343:      * 根据条件搜索用户账单信息。
344:      *
345:      * 该方法提供了丰富的查询条件，能够根据传入的数组参数灵活地查询用户账单数据。
346:      * 主要支持的查询条件包括：现在金额(now_money)、用户ID(uid)、支付方式(pm)、类别(category)、
347:      * 状态(status)、日期(date)、具体日期(day)、月份(month)、类型(type)、商户ID(mer_id)和关联ID(link_id)。
348:      *
349:      * @param array $where 查询条件数组，包含各种可能的查询条件。
350:      * @return \think\db\BaseQuery|\think\db\Query
351:      */
352:     public function search(array $where)
353:     {
354:         // 获取数据库操作对象
355:         return UserBill::getDB()
356:             // 根据(now_money)条件筛选类别和类型
357:             ->when(isset($where['now_money']) && in_array($where['now_money'], [0, 1, 2]), function ($query) use ($where) {
358:                 // 现在金额为0时的查询条件
359:                 if ($where['now_money'] == 0) {
360:                     $query->where('category', 'now_money')
361:                         ->whereIn('type', ['pay_product', 'recharge', 'sys_inc_money', 'sys_dec_money', 'brokerage', 'presell', 'refund','extract']);
362:                 // 现在金额为1时的查询条件
363:                 } else if ($where['now_money'] == 1) {
364:                     $query->where('category', 'now_money')
365:                         ->whereIn('type', ['pay_product', 'sys_dec_money', 'presell']);
366:                 // 现在金额为2时的查询条件
367:                 } else if ($where['now_money'] == 2) {
368:                     $query->where('category', 'now_money')
369:                         ->whereIn('type', ['recharge', 'sys_inc_money', 'brokerage', 'refund','extract']);
370:                 }
371:             })
372:             // 根据用户ID(uid)和商户ID(mer_id)查询
373:             ->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
374:                 $query->where('uid', $where['uid'])->where('mer_id', 0);
375:             })
376:             // 根据支付方式(pm)查询
377:             ->when(isset($where['pm']) && $where['pm'] !== '', function ($query) use ($where) {
378:                 $query->where('pm', $where['pm']);
379:             })
380:             // 根据类别(category)查询
381:             ->when(isset($where['category']) && $where['category'] !== '', function ($query) use ($where) {
382:                 $query->where('category', $where['category']);
383:             })
384:             // 根据状态(status)查询
385:             ->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
386:                 $query->where('status', $where['status']);
387:             })
388:             // 根据日期(date)查询
389:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
390:                 getModelTime($query, $where['date'], 'create_time');
391:             })
392:             // 根据具体日期(day)查询
393:             ->when(isset($where['day']) && $where['day'] !== '', function ($query) use ($where) {
394:                 $query->whereDay('create_time', $where['day']);
395:             })
396:             // 根据月份(month)查询
397:             ->when(isset($where['month']) && $where['month'] !== '', function ($query) use ($where) {
398:                 $query->whereMonth('create_time', $where['month']);
399:             })
400:             // 根据类型(type)查询，支持多级类别查询
401:             ->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
402:                 $data = explode('/', $where['type'], 2);
403:                 if (count($data) > 1) {
404:                     $query->where('category', $data[0])->where('type', $data[1]);
405:                 } else {
406:                     $query->where('type', $where['type']);
407:                 }
408:             })
409:             // 根据商户ID(mer_id)查询
410:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
411:                 $query->where('mer_id', $where['mer_id']);
412:             })
