 38:     {
 39:         parent::__construct($app);
 40:     }
 41: 
 42:     /**
 43:      *  数据统计
 44:      * @param $merId
 45:      * @param StoreOrderRepository $repository
 46:      * @return Json
 47:      * @author Qinii
 48:      */
 49:     public function orderStatistics($merId, StoreOrderRepository $repository)
 50:     {
 51:         $order = $repository->OrderTitleNumber($merId, null);
 52:         $order['refund'] = app()->make(StoreRefundOrderRepository::class)->getWhereCount(['is_system_del' => 0, 'mer_id' => $merId]);
 53:         $common = app()->make(Common::class);
 54:         $data = [];
 55:         $data['today'] = $common->mainGroup('today', $merId);
 56:         $data['yesterday'] = $common->mainGroup('yesterday', $merId);
 57:         $data['month'] = $common->mainGroup('month', $merId);
 58:         return app('json')->success(compact('order', 'data'));
 59:     }
 60: 
 61:     /**
 62:      *  数据统计  - 时间筛选
 63:      * @param $merId
 64:      * @param StoreOrderRepository $repository
 65:      * @return Json
 66:      * @author Qinii
 67:      */
 68:     public function orderDetail($merId, StoreOrderRepository $repository)
 69:     {
 70:         [$page, $limit] = $this->getPage();
 71:         list($start, $stop) = $this->request->params([
 72:             ['start', strtotime(date('Y-m'))],
 73:             ['stop', time()],
 74:         ], true);
 75:         if ($start == $stop) return app('json')->fail('参数有误');
 76:         if ($start > $stop) {
 77:             $middle = $stop;
 78:             $stop = $start;
 79:             $start = $middle;
 80:         }
 81:         $where = $this->request->has('start') ? ['dateRange' => compact('start', 'stop')] : [];
 82:         $list = $repository->orderGroupNumPage($where, $page, $limit, $merId);
 83:         return app('json')->success($list);
 84:     }
 85: 
 86:     /**
 87:      *  订单列表
 88:      * @param $merId
 89:      * @param StoreOrderRepository $repository
 90:      * @return Json
 91:      * @author Qinii
 92:      */
 93:     public function orderList($merId, StoreOrderRepository $repository)
 94:     {
 95:         [$page, $limit] = $this->getPage();
 96:         $where['status'] = $this->request->param('status');
 97:         $where['is_verify'] = $this->request->param('is_verify');
 98:         $where['search'] = $this->request->param('store_name');
 99:         $where['mer_id'] = $merId;
100:         $where['is_del'] = 0;
101:         if($where['status'] == 2) $where['order_type'] = 0;
102:         return app('json')->success($repository->merchantGetList($where, $page, $limit));
103:     }
104: 
105:     /**
106:      * 订单详情
107:      * @param $merId
108:      * @param $id
109:      * @param StoreOrderRepository $repository
110:      * @return Json
111:      * @author Qinii
112:      */
113:     public function order($merId, $id, StoreOrderRepository $repository)
114:     {
115:         $detail = $repository->getDetail($id);
116:         if (!$detail)
117:             return app('json')->fail('订单不存在');
118:         if ($detail['mer_id'] != $merId)
119:             return app('json')->fail('没有权限');
120:         return app('json')->success($detail->toArray());
121:     }
122: 
123:     /**
124:      * 检查用户是否有权限
125:      * @param $merId
126:      * @param $id
127:      * @return void
128:      * @author Qinii
129:      */
130:     protected function checkOrderAuth($merId, $id)
131:     {
132:         if (!app()->make(StoreOrderRepository::class)->existsWhere(['mer_id' => $merId, 'order_id' => $id]))
133:             throw new ValidateException('没有权限');
134:     }
135: 
136:     /**
137:      *  备注
138:      * @param $merId
139:      * @param $id
140:      * @param StoreOrderRepository $repository
141:      * @return Json
142:      * @author Qinii
143:      */
144:     public function mark($merId, $id, StoreOrderRepository $repository)
145:     {
146:         $this->checkOrderAuth($merId, $id);
147:         $data = $this->request->params(['remark']);
148:         $repository->update($id, $data);
149:         return app('json')->success('备注成功');
150:     }
151: 
152:     /**
153:      *  修改价格
154:      * @param $merId
155:      * @param $id
156:      * @param StoreOrderRepository $repository
157:      * @return Json
158:      * @author Qinii
159:      */
160:     public function price($merId, $id, StoreOrderRepository $repository)
161:     {
162:         $this->checkOrderAuth($merId, $id);
163: 
164:         $data = $this->request->params(['total_price', 'pay_postage']);
165: 
166:         if ($data['total_price'] < 0 || $data['pay_postage'] < 0)
167:             return app('json')->fail('金额不可未负数');
168:         if (!$repository->merStatusExists((int)$id, $merId))
169:             return app('json')->fail('订单信息或状态错误');
170:         $repository->eidt($id, $data);
171:         return app('json')->success('修改成功');
172:     }
173: 
174:     /**
175:      *  发货操作
176:      * @param $merId
177:      * @param $id
178:      * @param StoreOrderRepository $repository
179:      * @return Json
180:      * @author Qinii
181:      * @day 6/1/22
182:      */
183:     public function delivery($merId, $id, StoreOrderRepository $repository)
184:     {
185:         $this->checkOrderAuth($merId, $id);
186:         $type = $this->request->param('delivery_type');
187:         $split = $this->request->params(['is_split',['split',[]]]);
188:         if (!$repository->merDeliveryExists($id, $merId))
189:             return app('json')->fail('订单信息或状态错误');
190:         switch ($type)
191:         {
192:             case 2:
193:                 $data = $this->request->params(['delivery_type', 'delivery_name', 'delivery_id', 'remark',]);
194:                 if (!$data['delivery_type'] || !$data['delivery_name'] || !$data['delivery_id'])
195:                     return app('json')->fail('填写配送信息');
196:                 $ser = app()->make(DeliveryServiceRepository::class)->get($data['delivery_name']);
197:                 $data['delivery_name'] = $ser['name'] ?? $data['delivery_name'];
198:                 $method = 'delivery';
199:                 break;
200:             case 3: //虚拟发货
201:                 $data  = $this->request->params([
202:                     'delivery_type',
203:                     'remark',
204:                 ]);
205:                 $data['delivery_name'] = '';
206:                 $data['delivery_id'] = '';
207:                 $method = 'delivery';
208:                 break;
209:             case 4: //电子面单
210:                 if (!systemConfig('crmeb_serve_dump'))
211:                     return app('json')->fail('电子面单功能未开启');
212:                 $data = $this->request->params([
213:                     'delivery_type',
