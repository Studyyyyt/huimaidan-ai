 92:             if (!$this->repository->checkChangeToChild($id,$data['pid']))
 93:                 return app('json')->fail('无法修改到当前分类到子集，请先修改子类');
 94:             if (!$this->repository->checkChildLevel($id,$data['pid'],$merId))
 95:                 return app('json')->fail('子类超过最低限制，请先修改子类');
 96:         }
 97:         $this->repository->update($id,$data);
 98: 
 99:         return app('json')->success('编辑成功');
100:     }
