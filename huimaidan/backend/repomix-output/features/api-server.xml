 66:             return app('json')->fail('不可添加更低阶分类');
 67:         $data['mer_id'] = $merId;
 68:         $this->repository->create($data);
 69:         return app('json')->success('添加成功');
 70:     }
 71: 
 72:     /**
 73:      * 编辑
 74:      * @param $merId
 75:      * @param $id
 76:      * @param StoreCategoryValidate $validate
 77:      * @return \think\response\Json
 78:      * @author Qinii
 79:      * @day 8/24/21
 80:      */
 81:     public function update($merId, $id, StoreCategoryValidate $validate)
 82:     {
 83:         $data = $this->checkParams($validate);
 84: 
 85:         if(!$this->repository->checkUpdate($id,$data['pid'])){
 86:             if (!$this->repository->merExists($merId, $id))
 87:                 return app('json')->fail('数据不存在');
 88:             if ($data['pid'] && !$this->repository->merExists($merId, $data['pid']))
 89:                 return app('json')->fail('上级分类不存在');
