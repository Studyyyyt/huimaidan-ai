273:             ['start', strtotime(date('Y-m'))],
274:             ['stop', time()],
275:             'month'
276:         ], true);
277: 
278:         if ($month) {
279:             $start = date('Y/m/d', strtotime(getStartModelTime('month')));
280:             $stop = date('Y/m/d H:i:s', strtotime('+ 1day'));
281:             $front = date('Y/m/d', strtotime('first Day of this month', strtotime('-1 day', strtotime('first Day of this month'))));
282:             $end = date('Y/m/d H:i:s', strtotime($start . ' -1 second'));
283:         } else {
284:             if ($start == $stop) return app('json')->fail('参数有误');
285:             if ($start > $stop) {
286:                 $middle = $stop;
287:                 $stop = $start;
288:                 $start = $middle;
289:             }
290:             $space = bcsub($stop, $start, 0);//间隔时间段
291:             $front = bcsub($start, $space, 0);//第一个时间段
292: 
293:             $front = date('Y/m/d H:i:s', $front);
294:             $start = date('Y/m/d H:i:s', $start);
295:             $stop = date('Y/m/d H:i:s', $stop);
296:             $end = date('Y/m/d H:i:s', strtotime($start . ' -1 second'));
297:         }
298:         $frontPrice = $repository->dateOrderPrice($front . '-' . $end, $merId);
299:         $afterPrice = $repository->dateOrderPrice($start . '-' . date('Y/m/d H:i:s', strtotime($stop . '-1 second')), $merId);
300:         $chartInfo = $repository->chartTimePrice($start, date('Y/m/d H:i:s', strtotime($stop . '-1 second')), $merId);
301:         $data['chart'] = $chartInfo;//营业额图表数据
302:         $data['time'] = $afterPrice;//时间区间营业额
303:         $increase = (float)bcsub((string)$afterPrice, (string)$frontPrice, 2); //同比上个时间区间增长营业额
304:         $growthRate = abs($increase);
305:         if ($growthRate == 0) $data['growth_rate'] = 0;
306:         else if ($frontPrice == 0) $data['growth_rate'] = bcmul($growthRate, 100, 0);
307:         else $data['growth_rate'] = (int)bcmul((string)bcdiv((string)$growthRate, (string)$frontPrice, 2), '100', 0);//时间区间增长率
308:         $data['increase_time'] = abs($increase); //同比上个时间区间增长营业额
309:         $data['increase_time_status'] = $increase >= 0 ? 1 : 2; //同比上个时间区间增长营业额增长 1 减少 2
310: 
311:         return app('json')->success($data);
312:     }
