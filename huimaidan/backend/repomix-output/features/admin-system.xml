 445:     /**
 446:      * 根据商家的财务类型获取相应的财务信息。
 447:      *
 448:      * 本函数通过商家的财务类型来确定商家的收款方式，并返回相应的收款信息。
 449:      * 支持的收款方式包括银行、微信和支付宝。每种收款方式返回的信息包括名称、代码和图片标识。
 450:      * 如果商家未设置财务类型，则默认返回空的收款信息。
 451:      *
 452:      * @param object $merchant 商家对象，包含财务类型及相关信息。
 453:      * @return array 返回一个包含收款方式名称、代码和图片的数组。
 454:      */
 455:     public function getType($merchant)
 456:     {
 457:         switch ($merchant->financial_type) {
 458:             case 1:
 459:                 $arr = [
 460:                     'name' => $merchant->financial_bank->name ?? '',
 461:                     'code' => $merchant->financial_bank->bank ?? '',
 462:                     'pic' => $merchant->financial_bank->bank_code ?? '',
 463:                 ];
 464:                 break;
 465:             case 2:
 466:                 $arr = [
 467:                     'name' => $merchant->financial_wechat->name ?? '',
 468:                     'code' => $merchant->financial_wechat->wechat ?? '',
 469:                     'pic' => $merchant->financial_wechat->wechat_code ?? '',
 470:                 ];
 471:                 break;
 472:             case 3:
 473:                 $arr = [
 474:                     'name' => $merchant->financial_alipay->name ?? '',
 475:                     'code' => $merchant->financial_alipay->alipay ?? '',
 476:                     'pic' => $merchant->financial_alipay->alipay_code ?? '',
 477:                 ];
 478:                 break;
 479:             default:
 480:                 $arr = ['name' => '', 'code' => '', 'pic' => '',];
 481:                 break;
 482:         }
 483:         $arr['type'] = $merchant->financial_type ?: 1;
 484:         return $arr;
 485:     }
