 83:      * @param array $where 包含搜索条件的数组，其中键是条件名称，值是条件值。
 84:      *                    支持的条件有：keyword（关键字），pid（父分类ID），config_classify_id（分类ID），user_type（用户类型）。
 85:      * @return \Illuminate\Database\Query\Builder|static 返回构建好的查询对象，可以进一步调用其他查询方法或执行查询。
 86:      */
 87:     public function search(array $where)
 88:     {
 89:         // 从SystemConfig类中获取数据库实例
 90:         $query = SystemConfig::getDB();
 91: 
 92:         // 如果条件数组中包含keyword且不为空，则按照关键字搜索配置名或配置键
 93:         if (isset($where['keyword']) && $where['keyword'] !== '' )
 94:             $query->whereLike('config_name|config_key', '%' . $where['keyword'] . '%');
 95: 
 96:         // 如果条件数组中包含pid且不为空，则按照父分类ID搜索
 97:         if (isset($where['pid']) && $where['pid'] !== '')
 98:             $query->where('config_classify_id', $where['pid']);
 99: 
100:         // 如果条件数组中包含config_classify_id且不为空，则按照分类ID搜索
101:         if (isset($where['config_classify_id']) && $where['config_classify_id'] !== '')
102:             $query->where('config_classify_id', $where['config_classify_id']);
103: 
104:         // 如果条件数组中包含user_type且不为空，则按照用户类型搜索
105:         if (isset($where['user_type']) && $where['user_type'] !== '')
106:             $query->where('user_type', $where['user_type']);
107: 
108:         // 返回构建好的查询对象
109:         return $query;
110:     }
111: 
112:     /**
113:      * 根据配置分类ID和用户类型获取配置数据
114:      *
115:      * 本函数通过指定的配置分类ID（$cid）和用户类型（$user_type），从数据库中查询并返回相应的配置信息。
116:      * 查询条件包括配置的状态为启用（1）以及配置分类ID和用户类型与参数值匹配。查询结果将按照排序字段（sort）降序
117:      * 和配置ID（config_id）升序进行排序。
118:      *
119:      * @param int $cid 配置分类ID，用于筛选特定分类的配置。
120:      * @param int $user_type 用户类型，用于筛选适用于特定用户类型的配置。
121:      * @return array 返回符合条件的配置数据数组，包含多个配置项。
122:      */
123:     public function cidByConfig(int $cid, int $user_type)
124:     {
125:         // 使用SystemConfig类的数据库操作方法，根据配置分类ID、用户类型和状态查询配置数据
126:         // 并按照排序字段降序和配置ID升序返回查询结果
127:         return SystemConfig::getDB()->where('config_classify_id', $cid)->where('user_type', $user_type)->where('status', 1)
128:             ->order('sort DESC, config_id ASC')->select();
129:     }
130: 
131:     /**
132:      * 获取配置项的交集
133:      * 通过给定的分类ID和配置键列表，查询系统配置表中满足条件的配置项的类型和名称，并按配置键返回结果。
134:      * 此函数主要用于处理配置数据的筛选，确保返回的配置项既属于指定的分类ID（或分类ID列表），又包含在指定的键列表中，且状态为启用。
135:      *
136:      * @param mixed $cid 分类ID，可以是单个ID或ID数组
137:      * @param array $keys 配置键列表
138:      * @return array 返回格式为[key => [config_type, config_name]]的数组，其中key为配置键
139:      */
140:     public function intersectionKey($cid, $keys): array
141:     {
142:         // 根据分类ID的类型（数组或非数组），使用不同的条件查询方式
143:         return SystemConfig::where('config_classify_id', is_array($cid) ? 'IN' : '=', $cid)
144:             // 确保配置键在给定的列表中
145:             ->whereIn('config_key', $keys)
146:             // 只返回状态为启用的配置项
147:             ->where('status', 1)
148:             // 按配置键分组，返回配置类型和名称
149:             ->column('config_type,config_name', 'config_key');
150:     }
