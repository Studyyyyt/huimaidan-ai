 60:                 $query->where('is_margin', $where['is_margin']);
 61:             })
 62:             //补缴
 63:             ->when(isset($where['margin']) && $where['margin'] !== '', function ($query) use ($where) {
 64:                 if ($where['margin']) {
 65:                     $query->where('is_margin',$where['margin']);
 66:                 } else {
 67:                     $query->where(function($query){
 68:                         $query->where('is_margin',1)->whereOr(function($query){
 69:                             $query->where('is_margin',10)->whereRaw('ot_margin > margin');
