182:         $config = systemConfig([$accessKey, $secretKey, 'tengxun_appid']);
183: 
184:         // 构建表单提交的URL，并创建表单实例
185:         $form = Elm::createForm(Route::buildUrl('systemStorageCreateRegion', ['type' => $type])->build());
186:         // 初始化表单规则配置
187:         $ruleConfig = [];
188:         // 如果accessKey未配置，则添加accessKey和secretKey的输入字段
189:         if (!$config[$accessKey]) {
190:             $ruleConfig = [
191:                 Elm::input('accessKey', 'AccessKey：', $config[$accessKey])->placeholder('请输入accessKey')->required('请输入accessKey'),
192:                 Elm::input('secretKey', 'SecretKey：', $config[$secretKey])->placeholder('请输入secretKey')->required('请输入secretKey'),
