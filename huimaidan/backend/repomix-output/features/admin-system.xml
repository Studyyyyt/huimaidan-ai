330:     public function deleteRegion(int $id)
331:     {
332:         $storageInfo = $this->dao->getSearch(['is_del' => 0, 'id' => $id])->find();
333: 
334:         if (!$storageInfo) {
335:             throw new ValidateException('数据不存在');
336:         }
337:         if ($storageInfo->status) {
338:             throw new ValidateException('存储空间使用中不能删除');
339:         }
340: 
341:         try {
342:             $upload = UploadService::create($storageInfo->type);
343:             $res = $upload->deleteBucket($storageInfo->name, $storageInfo->region);
344:             if (false === $res) {
345:                 throw new ValidateException($upload->getError());
346:             }
347:         } catch (\Throwable $e) {
348:             throw new ValidateException($e->getMessage());
349:         }
350:         $storageInfo->delete();
351:         return true;
