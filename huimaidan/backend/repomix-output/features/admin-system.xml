366:         } else {
367:             $where['is_routine'] = 1;
368:             $field = 'notice_title,notice_config_id,notice_routine,routine_tempkey tempkey,routine_content content,routine_tempid tempid,type,kid';
369:         }
370: 
371:         // 执行查询操作
372:         $query = $this->dao->search($where);
373: 
374:         // 统计查询结果的总数
375:         $count = $query->count();
376: 
377:         // 设置查询字段并执行查询，获取模板列表
378:         $list = $query->setOption('field',[])->field($field)->field($field)->select();
