149:     /**
150:      * 根据商家ID和分组ID获取分组数据ID列表
151:      *
152:      * 本函数用于查询系统分组数据中，特定商家和分组对应的数据显示。
153:      * 通过分页查询方式，获取指定页码和每页数量的数据列表。返回的数据包括分组数据ID和对应的json格式数据。
154:      *
155:      * @param string $merId 商家ID，用于限定查询的商家范围
156:      * @param string $groupId 分组ID，用于限定查询的分组范围
157:      * @param int|null $page 查询的页码，可选参数，如果提供则进行分页查询
158:      * @param int|null $limit 每页的数据条数，可选参数，默认为10条
159:      * @return array 返回一个包含分组数据ID和数据的数组列表
160:      */
161:     public function getGroupDataId($merId, $groupId, ?int $page = null, ?int $limit = 10)
162:     {
163:         // 构建查询条件，限定查询商家ID、分组ID，并且状态为启用的分组数据
164:         $query = SystemGroupData::getDB()->where('mer_id', $merId)->where('group_id', $groupId)->where('status', 1)->order('sort DESC');
165: 
166:         // 如果提供了页码和每页数量，则进行分页查询
167:         if (!is_null($page)) $query->page($page, $limit);
168: 
169:         // 初始化存储查询结果的数组
170:         $groupData = [];
171: 
172:         // 遍历查询结果，将分组数据ID和解码后的数据值存入结果数组
173:         foreach ($query->column('value', 'group_data_id') as $k => $v) {
174:             $groupData[] = ['id' => $k, 'data' => json_decode($v, true)];
175:         }
176: 
177:         // 返回处理后的查询结果
178:         return $groupData;
179:     }
