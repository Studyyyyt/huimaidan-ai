524:     /**
525:      * 保存上传配置
526:      *
527:      * 该方法用于根据传入的上传类型数据，保存相应的上传配置。它支持多种上传方式，
528:      * 通过switch语句根据上传类型确定具体的上传配置键名。然后，在数据库事务中，
529:      * 先更新上传类型配置，如果上传类型有具体的配置键名，则进一步保存该上传方式的详细配置。
530:      * 这样做的目的是确保上传配置的完整性和一致性。
531:      *
532:      * @param array $data 包含上传类型等信息的数据数组
533:      */
534:     public function saveUpload($data)
535:     {
536:         // 实例化配置值仓库，用于后续保存配置数据
537:         $configValueRepository = app()->make(ConfigValueRepository::class);
538:         // 默认上传类型为1，代表本地上传
539:         $uploadType = $data['upload_type'] ?? '1';
540:         // 根据上传类型确定具体的上传方式键名
541:         $key = '';
542:         switch ($uploadType) {
543:             case 1:
544:                 $key = 'local';
545:                 break;
546:             case 2:
547:                 $key = 'qiniuyun';
548:                 break;
549:             case 3:
550:                 $key = 'aliyun_oss';
551:                 break;
552:             case 4:
553:                 $key = 'tengxun';
554:                 break;
555:             case 5:
556:                 $key = 'huawei_obs';
557:                 break;
558:             case 6:
559:                 $key = 'ucloud';
560:                 break;
561:             case 7:
562:                 $key = 'jdoss';
563:                 break;
564:             case 8:
565:                 $key = 'ctoss';
566:                 break;
567:         }
568: 
569:         // 使用数据库事务来确保配置更新和保存操作的一致性
570:         Db::transaction(function () use ($data, $key, $uploadType, $configValueRepository) {
571:             // 更新上传类型配置
572:             $configValueRepository->setFormData([
573:                 'upload_type' => $uploadType
574:             ], 0);
575:             // 如果上传方式有具体的配置键名，则进一步保存上传方式的详细配置
576:             if ($key) {
577:                 // 实例化配置分类仓库，用于获取配置分类ID
578:                 $make = app()->make(ConfigClassifyRepository::class);
579:                 // 根据上传方式键名获取对应的配置分类ID，如果获取失败则返回错误信息
580:                 if (!($cid = $make->keyById($key))) return app('json')->fail('保存失败');
581:                 // 保存上传方式的详细配置
582:                 $configValueRepository->save($cid, $data, 0);
583:             }
584:         });
585:     }
