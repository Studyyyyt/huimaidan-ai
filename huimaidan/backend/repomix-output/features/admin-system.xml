123:      * @param $cate_id
124:      * @return mixed
125:      */
126:     public function getLinks($id, PageCategoryRepository $pageCategoryServices)
127:     {
128:         if (!$id) return app('json')->fail('缺少参数');
129:         $category = $pageCategoryServices->get((int)$id);
130:         if (!$category) {
131:             return app('json')->fail('页面分类不存在');
132:         }
133:         $type = $this->request->param('type', 0);
134:         [$page, $limit] = $this->getPage();
135:         switch ($category['type']) {
136:             case 'special':
137:                 $diyServices = app()->make(ArticleRepository::class);
138:                 $data = $diyServices->search(0, ['status' => 1], $page, $limit);
139:                 break;
140:             case 'article_category':
141:                 $articleCategory = app()->make(ArticleCategoryRepository::class);
142:                 $data = $articleCategory->list(['status' => 1], $page, $limit);
143:                 break;
144:             case 'product_category':
145:                 $storeCategoryServices = app()->make(StoreCategoryRepository::class);
146:                 $data = $storeCategoryServices->getApiFormatList($this->request->merId(), 1);
147:                 break;
148:             case 'merchant':
149:                 $data = app()->make(MerchantRepository::class)->lst(['mer_state' => 1, 'status' => 1], $page, $limit);
150:                 break;
151:             case 'active':
152:                 $groupid = $this->request->merId() ? 95 : 94;
153:                 $query = app()->make(GroupDataRepository::class)
154:                     ->getGroupDataWhere($this->request->merId(), $groupid)
155:                     ->where('status', 1);
156:                 $data['count'] = $query->count();
157:                 $data['list'] = $query->page($page, $limit)->select()->toArray();
158:                 break;
159:             case 'points_cate':
160:                 $storeCategoryServices = app()->make(StoreCategoryRepository::class);
161:                 $data = $storeCategoryServices->getApiFormatList($this->request->merId(), 1, 1);
162:                 break;
163:             case 'micro':
164:                 $data = app()->make(DiyRepository::class)->getList(['is_diy' => 0], $page, $limit);
165:                 break;
166:             case 'activity_form': //报名活动
167:                 $where['activity_type'] = StoreActivityRepository::ACTIVITY_TYPE_FORM;
168:                 $where['status'] = 1;
169:                 $where['is_show'] = 1;
170:                 $data = app()->make(StoreActivityRepository::class)->getList($where, $page, $limit);
171:                 break;
172:             default:
173:                 $data = $this->repository->getLinkList($id, $type == 1 ? 1 : $this->request->merId());
174:                 break;
175:         }
176:         return app('json')->success($data);
177:     }
