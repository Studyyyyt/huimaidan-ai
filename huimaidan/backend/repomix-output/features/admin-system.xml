116:     /**
117:      * 获取分组数据列表
118:      *
119:      * 本函数用于根据商家ID、分组ID，获取特定分组的数据列表。支持分页和限制返回数据的数量。
120:      * 主要用于后台管理界面的数据展示，例如商品分类的管理。
121:      *
122:      * @param int $merId 商家ID，用于限定查询的商家范围。
123:      * @param int $groupId 分组ID，指定要查询的分组。
124:      * @param int $page 当前页码，用于分页查询。
125:      * @param int $limit 每页数据条数，用于控制返回的数据量。
126:      * @return array 返回包含数据总数和数据列表的数组。
127:      */
128:     public function getGroupDataLst(int $merId, int $groupId, int $page, int $limit): array
129:     {
130:         // 根据商家ID和分组ID构建查询条件，并按排序字段排序
131:         $query = $this->dao->getGroupDataWhere($merId, $groupId)->order('sort DESC,group_data_id ASC');
132: 
133:         // 计算满足条件的数据总数
134:         $count = $query->count();
135: 
136:         // 根据当前页码和每页数据条数，查询满足条件的数据列表
137:         // 返回的数据包含字段：group_data_id, value, sort, status, create_time
138:         $list = $query->field('group_data_id,value,sort,status,create_time')->page($page, $limit)->select()->toArray();
139: 
140:         // 遍历数据列表，将value字段合并到主数据数组中，以丰富数据内容
141:         foreach ($list as $k => $data) {
142:             $value = $data['value'];
143:             unset($data['value']);
144:             $data += $value;
145:             $list[$k] = $data;
146:         }
147: 
148:         // 返回包含数据总数和数据列表的数组
149:         return compact('count', 'list');
150:     }
