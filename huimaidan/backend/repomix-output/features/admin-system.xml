 443:     public function getDistance(int $id, array $params) : array
 444:     {
 445:         $merchant = $this->dao->get($id);
 446:         if (!$merchant) {
 447:             throw new ValidateException('商户信息不存在，请检查');
 448:         }
 449:         $merLat = $merchant['lat'];
 450:         $merLong = $merchant['long'];
 451:         if (!$merLat || !$merLong) {
 452:             throw new ValidateException('商户未设置位置信息，无法获取距离');
 453:         }
 454:         $distance = getDistance($params['latitude'], $params['longitude'], $merLat, $merLong);
 455:         if ($distance < 0.9) {
 456:             $distance = max(bcmul($distance, 1000, 0), 1).'m';
 457:             if ($distance == '1m') {$distance = '100m以内';}
 458:         } else {
 459:             $distance.= 'km';
 460:         }
 461:         return ['distance' => $distance];
 462:     }
