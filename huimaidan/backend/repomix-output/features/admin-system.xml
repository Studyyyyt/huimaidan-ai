130:      * @return \EasyAdmin\ui\Elm|\FormBuilder\Form
131:      */
132:     public function form($type)
133:     {
134:         // 通过服务类获取指定类型存储服务的前缀
135:         $prefix = $this->service::getPrefix($type);
136:         // 根据前缀和键名构造访问密钥的配置键名
137:         //获取配置
