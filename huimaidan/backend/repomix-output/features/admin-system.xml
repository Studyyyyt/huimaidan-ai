430:                     $_k = $date + $j;
431:                     $k = (string)($_k < 10 ? '0' . $_k : $_k);
432:                     $arr = [
433:                         'hours' => (string)$date.'~'.$k,
434:                         'user_count' => $orderList[$date]['user_count'] ?? 0,
435:                         'order_count' => $orderList[$date]['order_count'] ?? 0,
436:                     ];
437:                     if (isset($orderList[$k])) {
438:                         $arr['user_count']  = $arr['user_count'] + $orderList[$k]['user_count'];
439:                         $arr['order_count'] = $arr['order_count'] + $orderList[$k]['order_count'];
440:                     }
441:                 } else {
442:                     $arr = [
443:                         'hours' => (string)$date,
444:                         'user_count' => $orderList[$date]['user_count'] ?? 0,
445:                         'order_count' => $orderList[$date]['order_count'] ?? 0,
446:                     ];
447:                 }
448:                 $today_pay_count[] = $arr;
449:             }
450:             return $today_pay_count;
451:         });
452:     }
