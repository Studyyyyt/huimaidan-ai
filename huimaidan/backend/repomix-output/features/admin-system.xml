191:      *
192:      * 该方法用于处理管理员的登录逻辑。它首先触发一个登录前的事件，然后根据账户格式验证并查询管理员信息。
193:      * 如果账户格式不符合标准（不包含 '@' 符号），则认为是顶级管理员账户。否则，认为是商户管理员账户，并需要验证商户是否存在。
194:      * 如果管理员信息不存在或密码不匹配，将增加登录失败次数并抛出异常。此外，如果管理员账户被禁用，也会抛出异常。
195:      * 成功登录后，更新管理员的登录信息并触发一个登录成功的事件。
196:      *
197:      * @param string $account 管理员账户名
198:      * @param string $password 管理员密码
199:      * @return AdminModel|array|\think\db\false|Model
200:      * @throws ValidateException 如果登录失败或账户状态异常，抛出此异常
201:      */
202:     public function login(string $account, string $password)
203:     {
204:         // 触发登录前的事件，可以用于日志记录、验证码验证等
205:         event('admin.merLogin.before',compact('account', 'password'));
206: 
207:         // 分割账户名以获取账号和域名部分
208:         $accountInfo = explode('@', $account, 2);
209: 
210:         // 如果账户名不包含 '@'，则认为是顶级管理员
211:         if (count($accountInfo) === 1) {
212:             $adminInfo = $this->dao->accountByTopAdmin($accountInfo[0]);
213:         } else {
214:             // 查询商户ID对应的管理员信息
215:             $merId = $this->dao->accountByMerchantId($accountInfo[0]);
216:             // 如果商户ID不存在，增加登录失败次数并抛出异常
217:             if (!$merId){
218:                 $key = 'mer_login_failuree_'.$account;
219:                 $numb = Cache::get($key) ?? 0;
220:                 $numb++;
221:                 Cache::set($key,$numb,15*60);
222:                 throw new ValidateException('账号或密码错误');
223:             }
224:             // 根据管理员名称和商户ID查询管理员信息
225:             $adminInfo = $this->dao->accountByAdmin($accountInfo[1], $merId);
226:         }
227: 
228:         // 如果管理员信息不存在或密码不匹配，增加登录失败次数并抛出异常
229:         if (!$adminInfo || !password_verify($password, $adminInfo->pwd)){
230:             $key = 'mer_login_failuree_'.$account;
231:             $numb = Cache::get($key) ?? 0;
232:             $numb++;
233:             Cache::set($key,$numb,15*60);
234:             throw new ValidateException('账号或密码错误');
235:         }
236: 
237:         // 如果管理员账户被禁用，抛出异常
238:         if ($adminInfo['status'] != 1)
239:             throw new ValidateException('账号已关闭');
240: 
241:         // 获取商户信息
242:         /**
243:          * @var MerchantRepository $merchantRepository
244:          */
245:         $merchantRepository = app()->make(MerchantRepository::class);
246:         $merchant = $merchantRepository->get($adminInfo->mer_id);
247:         // 如果商户不存在或被禁用，抛出异常
248:         if (!$merchant)
249:             throw new ValidateException('商户不存在');
250:         if (!$merchant['status'])
251:             throw new ValidateException('商户已被锁定');
252: 
253:         // 更新管理员的登录信息
254:         $adminInfo->last_time = date('Y-m-d H:i:s');
255:         $adminInfo->last_ip = app('request')->ip();
256:         $adminInfo->login_count++;
257:         $adminInfo->save();
