188:     /**
189:      * 更新商家意向状态
190:      * 此函数用于处理商家意向的更新操作，包括状态更改、信息完善等。
191:      * @param $id 商家意向ID
192:      * @param $data 更新的数据数组
193:      * @throws ValidateException 当信息不存在或状态不正确时抛出异常
194:      */
195:     public function updateStatus($id, $data)
196:     {
197:         // 判断是否创建商家
198:         $create = $data['create_mer'] == 1;
199:         // 移除创建商家标记
200:         unset($data['create_mer']);
201:         // 根据ID查询商家意向信息
202:         $intention = $this->search(['mer_intention_id' => $id])->find();
203:         // 如果商家意向不存在，抛出异常
204:         if (!$intention)
205:             throw new ValidateException('信息不存在');
206:         // 如果商家意向状态已设置，抛出异常
207:         if ($intention->status)
208:             throw new ValidateException('状态有误,修改失败');
209:         // 获取系统配置信息
210:         $config = systemConfig(['broadcast_room_type', 'broadcast_goods_type']);
211: 
212:         // 获取商家类型信息
213:         $margin = app()->make(MerchantTypeRepository::class)->get($intention['mer_type_id']);
214:         // 设置商家意向的保证金相关字段
215:         $data['is_margin'] = $margin['is_margin'] ?? -1;
216:         $data['margin'] = $margin['margin'] ?? 0;
217: 
218:         // 初始化商家数据和短信数据数组
219:         $merData = [];
220:         $smsData = [];
221:         // 如果是创建商家
222:         if ($create == 1) {
223:             // 处理商家密码
224:             $password = substr($intention['phone'], -6);
225:             // 构建商家信息数组
226:             $merData = [
227:                 'mer_name' => $intention['mer_name'],
228:                 'mer_phone' => $intention['phone'],
229:                 'mer_account' => $intention['phone'],
230:                 'category_id' => $intention['merchant_category_id'],
231:                 'type_id' => $intention['mer_type_id'],
232:                 'real_name' => $intention['name'],
233:                 'region_id' => $intention['circle_id'],
234:                 'business_id' => $intention['business_id'],
235:                 'status' => 1,
236:                 'is_audit' => 1,
237:                 'is_bro_room' => $config['broadcast_room_type'] == 1 ? 0 : 1,
238:                 'is_bro_goods' => $config['broadcast_goods_type'] == 1 ? 0 : 1,
239:                 'mer_password' => $password,
240:                 'is_margin' => $margin['is_margin'] ?? -1,
241:                 'margin' => $margin['margin'] ?? 0,
242:                 'mark' => $margin['margin'] ?? 0,
243:             ];
244:             // 设置失败原因为空
245:             $data['fail_msg'] = '';
246:             // 构建短信数据数组
247:             $smsData = [
248:                 'date' => date('m月d日', strtotime($intention->create_time)),
249:                 'mer' => $intention['mer_name'],
250:                 'phone' => $intention['phone'],
251:                 'pwd' => $password ?? '',
252:                 'site_name' => systemConfig('site_name'),
253:             ];
254:         }
255:         // 如果状态更新为2（可能是审核不通过）
256:         if ($data['status'] == 2) {
257:             // 设置短信数据
258:             $smsData = [
259:                 'phone' => $intention['phone'],
260:                 'date' => date('m月d日', strtotime($intention->create_time)),
261:                 'mer' => $intention['mer_name'],
262:                 'site' => systemConfig('site_name'),
263:             ];
264:         }
265: 
266:         // 开启数据库事务处理
267:         Db::transaction(function () use ($config, $intention, $data, $create,$margin,$merData,$smsData) {
268:             // 如果状态更新为1（审核通过）
269:             if ($data['status'] == 1) {
270:                 // 如果需要创建商家
271:                 if ($create == 1) {
272:                     // 创建商家
273:                     $merchant = app()->make(MerchantRepository::class)->createMerchant($merData);
274:                     // 保存商家证书信息
275:                     app()->make(ConfigValueRepository::class)->setFormData(['mer_certificate' => $intention['images']], $merchant->mer_id);
276:                     // 设置商家ID
277:                     $data['mer_id'] = $merchant->mer_id;
278:                     // 添加发送短信任务
279:                     Queue::push(SendSmsJob::class, ['tempId' => 'APPLY_MER_SUCCESS', 'id' => $smsData]);
280:                 }
281:             } else {
282:                 // 添加发送短信任务（审核不通过）
283:                 Queue::push(SendSmsJob::class, ['tempId' => 'APPLY_MER_FAIL', 'id' => $smsData]);
284:             }
285:             // 保存商家意向信息
286:             $intention->save($data);
287:         });
288:     }
289: 
290: }
