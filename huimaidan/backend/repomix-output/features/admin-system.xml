152:     /**
153:      * 根据组ID和可选的ID、商家ID以及表单数据生成表单对象。
154:      * 此方法主要用于创建或更新数据组的表单，根据不同的场景（是否存在商家ID）和操作类型（创建或更新）构建不同的表单URL。
155:      * 表单字段根据组的字段定义动态生成，支持多种字段类型，包括图像、多图像、分类、标签、选择、复选框、单选框、文件等。
156:      *
157:      * @param int $groupId 组ID，用于确定表单的字段定义。
158:      * @param int|null $id 可选的ID，用于确定是进行更新操作还是创建操作。
159:      * @param int|null $merId 商家ID，用于确定表单的URL路径和某些字段的选项。
160:      * @param array $formData 可选的表单数据数组，用于预填充表单。
161:      * @return Form 返回生成的表单对象，该对象包含了表单的规则、标题和初始数据。
162:      */
163:     public function form(int $groupId, ?int $id = null, ?int $merId = null, array $formData = []): Form
164:     {
165:         // 根据组ID获取组的字段定义
166:         $fields = app()->make(GroupRepository::class)->fields($groupId);
167: 
168:         // 根据是否存在商家ID和ID，构建不同的表单URL
169:         if (is_null($merId)) {
170:             $url = is_null($id)
171:                 ? Route::buildUrl('groupDataCreate', compact('groupId'))->build()
172:                 : Route::buildUrl('groupDataUpdate', compact('groupId', 'id'))->build();
173:         } else {
174:             $url = is_null($id)
175:                 ? Route::buildUrl('merchantGroupDataCreate', compact('groupId'))->build()
176:                 : Route::buildUrl('merchantGroupDataUpdate', compact('groupId', 'id'))->build();
177:         }
178: 
179:         // 创建表单对象并设置表单URL
180:         $form = Elm::createForm($url);
181: 
182:         // 初始化表单规则数组
183:         $rules = [];
184: 
185:         // 遍历组的字段定义，根据字段类型生成相应的表单规则
186:         foreach ($fields as $field) {
187:             $rule = null;
188:             if ($field['type'] == 'image') {
189:                 // 图像字段生成框架图像组件
190:                 $rule = Elm::frameImage($field['field'], $field['name'], '/' . config('admin.' . ($merId ? 'merchant' : 'admin') . '_prefix') . '/setting/uploadPicture?field=' . $field['field'] . '&type=1')->icon('el-icon-camera')->modal(['modal' => false])->width('1000px')->height('600px')->props(['footer' => false]);
191:             } else if ($field['type'] == 'images') {
192:                 // 多图像字段生成框架图像组件，支持多图
193:                 $rule = Elm::frameImage($field['field'], $field['name'], '/' . config('admin.' . ($merId ? 'merchant' : 'admin') . '_prefix') . '/setting/uploadPicture?field=' . $field['field'] . '&type=2')->maxLength(5)->icon('el-icon-camera')->modal(['modal' => false])->width('1000px')->height('600px')->props(['footer' => false]);
194:             } else if ($field['type'] == 'cate') {
195:                 // 分类字段生成级联选择器组件，并动态加载分类选项
196:                 $rule = Elm::cascader($field['field'], $field['name'])->options(function () use ($id) {
197:                     $storeCategoryRepository = app()->make(StoreCategoryRepository::class);
198:                     $menus = $storeCategoryRepository->getAllOptions(0, 1, null, 0);
199:                     if ($id && isset($menus[$id])) unset($menus[$id]);
200:                     $menus = formatCascaderData($menus, 'cate_name');
201:                     return $menus;
202:                 })->props(['props' => ['checkStrictly' => true, 'emitPath' => false]])->filterable(true)->appendValidate(Elm::validateInt()->required('请选择分类')->message('请选择分类'));
203:             } else if ($field['type'] == 'label') {
204:                 // 标签字段生成选择器组件，并动态加载标签选项
205:                 $rule = Elm::select($field['field'], $field['name'])->options(function () {
206:                     return app()->make(ProductLabelRepository::class)->getSearch(['mer_id' => request()->merId(), 'status' => 1])->column('label_name as label,product_label_id as value');
207:                 })->appendValidate(Elm::validateNum()->required('请选择标签')->message('请选择标签'));
208:             } else if (in_array($field['type'], ['select', 'checkbox', 'radio'])) {
209:                 // 选择、复选框和单选框字段生成相应的组件，并动态加载选项
210:                 $options = array_map(function ($val) {
211:                     [$value, $label] = explode(':', $val, 2);
212:                     return compact('value', 'label');
213:                 }, explode("\n", $field['param']));
214:                 $rule = Elm::{$field['type']}($field['field'], $field['name'])->options($options);
215:                 if ($field['type'] == 'select') {
216:                     $rule->filterable(true)->prop('allow-create', true);
217:                 }
218:             } else if ($field['type'] == 'file') {
219:                 // 文件字段生成上传组件，并设置上传地址
220:                 $rule = Elm::uploadFile($field['field'], $field['name'], rtrim(systemConfig('site_url'), '/') . Route::buildUrl('configUpload', ['field' => 'file'])->build())->headers(['X-Token' => request()->token()]);
221:             } else {
222:                 // 其他字段类型直接生成相应的组件
223:                 $rule = Elm::{$field['type']}($field['field'], $field['name'], '');
224:             }
225: 
226:             // 根据字段的属性设置组件的属性、验证规则和默认值
227:             if ($field['props'] ?? '') {
228:                 $props = @parse_ini_string($field['props'], false, INI_SCANNER_TYPED);
229:                 if (is_array($props)) {
230:                     $rule->props($props);
231:                     if (isset($props['required']) && $props['required']) {
232:                         $rule->required();
233:                     }
234:                     if (isset($props['defaultValue'])) {
235:                         $rule->value($props['defaultValue']);
236:                     }
237:                 }
238:             }
239: 
240:             // 将生成的表单规则添加到规则数组
241:             $rules[] = $rule;
242:         }
243: 
244:         // 添加排序和状态字段的规则
245:         $rules[] = Elm::number('sort', '排序：', 0)->precision(0)->max(99999);
246:         $rules[] = Elm::switches('status', '是否显示：', 1)->activeValue(1)->inactiveValue(0)->inactiveText('关闭')->className('switch-width-double')->activeText('开启');
247: 
248:         // 设置表单的规则
249:         $form->setRule($rules);
250: 
251:         // 设置表单的标题和初始数据
252:         return $form->setTitle(is_null($id) ? '添加数据' : '编辑数据')->formData(array_filter($formData, function ($item) {
253:             return $item !== '' && !is_null($item);
254:         }));
255:     }
