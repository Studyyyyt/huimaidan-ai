 961:      * @param $res
 962:      * @author Qinii
 963:      * @day 1/27/22
 964:      */
 965:     public function agree($res)
 966:     {
 967:         $data = [];
 968:         $order = null;
 969:         //线上原路退回
 970:         if ($res['financial_type'] !== ServeOrderRepository::PAY_TYPE_SYS) {
 971:             //验证
 972:             $comp = bccomp($res['financial_account']->pay_price, $res['extract_money'], 2);
 973:             if ($comp == -1)
 974:                 throw new ValidateException('申请退款金额：' . $res['extract_money'] . ',大于支付保证金：' . $res['financial_account']->pay_price);
 975:             //退款
 976:             $data = [
 977:                 'refund_id' => $res['financial_account']->order_sn,
 978:                 'pay_price' => $res['financial_account']->pay_price,
 979:                 'refund_price' => $res['extract_money']
 980:             ];
 981:             $order = app()->make(ServeOrderRepository::class)->get($res['financial_account']->order_id);
 982: 
 983:         }
 984:         $has = $this->dao->getSearch([])
 985:             ->where('status', 0)
 986:             ->where('mer_id', $res->mer_id)
 987:             ->where('type', 1)
 988:             ->where('financial_id', '<>', $res->financial_id)
 989:             ->count();
 990: 
 991:         Db::transaction(function () use ($res, $data, $order, $has) {
 992:             if ($data) {
 993:                 WechatService::create()->payOrderRefund($res['financial_account']->order_sn, $data);
 994:                 //改订单
 995:                 $order->status = 20;
 996:                 $order->save();
 997:             }
 998:             /*
 999:             * 如果存在，则有其他正在申请退款的订单；
1000:             * 保证金状态不变；
1001:             * 否则
1002:             * 变更保证金状态&关闭店铺
1003:             *
1004:             */
1005:             if (!$has) {
1006:                 $is_margin = $res['merchant']['merchantType']['is_margin'];
1007:                 $res->merchant->is_margin = $is_margin;
1008:                 $res->merchant->margin = $res['merchant']['merchantType']['margin'];
1009:                 $res->merchant->ot_margin = $res['merchant']['merchantType']['margin'];
1010:                 if ($is_margin == 1) {
1011:                     $res->merchant->mer_state = 0;
1012:                     Queue::push(ChangeMerchantStatusJob::class, $res['mer_id']);
1013:                 }
1014:                 $res->merchant->save();
1015:             }
1016:         });
1017: 
