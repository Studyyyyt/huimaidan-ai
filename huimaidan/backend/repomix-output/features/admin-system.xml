86:         // 如果同时指定了开始时间和结束时间，则进一步限定查询在指定时间范围内的日志
87:         if (isset($where['section_startTime']) && $where['section_startTime'] && isset($where['section_endTime']) && $where['section_endTime']) {
88:             $query->where('create_time', '>', $where['section_startTime'])->where('create_time', '<', $where['section_endTime']);
89:         }
90: 
91:         // 返回构建好的查询条件，可用于进一步的查询操作或数据获取
92:         return $query;
