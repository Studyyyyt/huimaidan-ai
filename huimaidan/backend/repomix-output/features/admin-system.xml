354: 
355:     /**
356:      *  添加存储空间
357:      * @param int $type
358:      * @param array $data
359:      * @return bool
360:      * @author Qinii
361:      * @day 2024/3/13
362:      */
363:     public function createRegion(int $type, array $data, array $params)
364:     {
365:         $prefix = $this->service::getPrefix($type);
366:         $access_key = '';
367:         if ($params && $params['accessKey']){
368:             $access_key = $params['accessKey'];
369:             $secretKey = $params['secretKey'];
370:             unset($params['accessKey'],$params['secretKey']);
371:             $params[$prefix.'accessKey'] = $access_key;
372:             $params[$prefix.'secretKey'] = $secretKey;
373:             app()->make(ConfigValueRepository::class)->setFormData($params,0);
374:         }
375:         $access_key = $access_key ?: systemConfig($prefix . 'accessKey');
376:         $data['type'] = $type;
377:         $count = $this->dao->getWhereCount(['name' => $data['name'], 'access_key' => $access_key]);
378:         if ($count) throw new ValidateException('空间名称已存在');
379:         $upload = UploadService::create($type);
380:         $res = $upload->createBucket($data['name'], $data['region'], $data['acl']);
381:         if (false === $res) {
382:             throw new ValidateException($upload->getError());
383:         }
384: 
385:         if ($type === $this->service::STORAGE_ALIYUN) {
386:             $data['region'] = $this->getReagionHost($type, $data['region']);
387:         }
388:         $data['domain'] = $this->getDomain($type, $data['name'], $data['region'], systemConfig('tengxun_appid'));
389:         if ($type !== $this->service::STORAGE_QINIU) {
390:             $data['cname'] = $data['domain'];
391:         }
392:         $data['access_key'] = $access_key;
393:         if ($type === $this->service::STORAGE_TENGXUN) {
394:             $data['name'] = $data['name'].'-'.systemConfig('tengxun_appid');
395:         }
396:         $this->dao->create($data);
397:         $this->setDefualtUse($type,$access_key);
398:         return true;
399:     }
