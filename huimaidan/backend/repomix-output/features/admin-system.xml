105:             // 加入系统通知表，以便查询通知的详细信息
106:             ->join('SystemNotice B', 'A.notice_id = B.notice_id')
107:             // 过滤条件：商家ID
108:             ->where('mer_id', $where['mer_id'])
109:             // 当传入阅读状态条件时，添加对应过滤条件
110:             ->when(isset($where['is_read']) && $where['is_read'] !== '', function ($query) use ($where) {
111:                 $query->where('A.is_read', intval($where['is_read']));
112:             })
113:             ->when(isset($where['notice_id']) && $where['notice_id'] !== '', function ($query) use ($where) {
114:                 $query->where('A.notice_id', intval($where['notice_id']));
115:             })
116:             ->when(isset($where['notice_log_id']) && $where['notice_log_id'] !== '', function ($query) use ($where) {
117:                 $query->where('A.notice_log_id', intval($where['notice_log_id']));
118:             })
119:             // 当传入日期条件时，添加对应过滤条件，用于查询指定日期范围的通知
120:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
121:                 getModelTime($query, $where['date'], 'B.create_time');
122:             })
123:             // 当传入关键词条件时，添加对应过滤条件，用于查询包含指定关键词的通知
124:             ->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
125:                 $query->whereLike('B.notice_title|B.notice_content', "%{$where['keyword']}%");
126:             })
127:             // 过滤条件：删除状态，只返回未删除的通知日志
128:             ->where('A.is_del', 0)
