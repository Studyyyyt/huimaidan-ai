 263:         $data['mer_account'] = $make->merIdByAccount($id);
 264: 
 265:         // 为了保护密码安全，将密码字段的值设置为星号，隐藏真实密码。
 266:         $data['mer_password'] = '***********';
 267: 
 268:         // 如果分类ID为0，将其字符串化为空字符串，以便在表单中显示为未选择分类。
 269:         if($data['category_id'] == 0){
