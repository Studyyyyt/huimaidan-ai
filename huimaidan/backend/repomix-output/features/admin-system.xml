 86:     /**
 87:      * 更新表单数据的方法
 88:      *
 89:      * 本方法用于根据给定的商户ID和表单ID来更新表单数据。它首先通过调用DAO层获取当前表单的数据，
 90:      * 然后使用这些数据来构建一个新的表单实例，最后返回这个新构建的表单实例。
 91:      *
 92:      * @param int $merId 商户ID，用于指定表单所属的商户。
 93:      * @param int $id 表单ID，用于唯一标识待更新的表单。
 94:      * @return Form 返回更新后的表单实例。
 95:      */
 96:     public function updateForm(int $merId, int $id)
 97:     {
 98:         // 通过DAO层获取指定ID和商户ID的表单数据，并转换为数组格式
 99:         // 这里使用链式调用，先调用get方法获取表单数据对象，然后调用toArray方法将其转换为数组
100:         return $this->form($merId, $id, $this->dao->get($id, $merId)->toArray());
101:     }
102: 
103:     /**
104:      * 获取格式化后的分类列表
105:      *
106:      * 本函数旨在根据商家ID获取所有的分类信息，并对这些信息进行格式化处理。通过调用DAO层的方法获取所有分类数据，
107:      * 然后使用formatCategory函数对数据进行格式化，以便于前端展示或进一步处理。
108:      *
109:      * @param int $merId 商家ID，用于获取该商家的分类信息。
110:      * @return array 格式化后的分类列表数组。
111:      */
112:     public function getFormatList(int $merId)
113:     {
114:         // 调用DAO层的getAll方法获取所有分类数据，并转换为数组格式
115:         return formatCategory($this->dao->getAll($merId)->toArray(), 'attachment_category_id');
116:     }
117: 
118:     /**
119:      * 更新素材分类信息。
120:      *
121:      * 此方法用于根据提供的ID和商家ID更新素材分类的数据。如果分类的父ID（pid）发生了变化，
122:      * 则需要更新分类的路径，并在数据库中执行事务性更新以确保数据的一致性。如果父ID没有变化，
123:      * 则直接更新分类的其他信息。
124:      *
125:      * @param int $id 分类的ID。
126:      * @param int $merId 商家的ID。
127:      * @param array $data 待更新的分类数据，包括pid和其他可能需要更新的字段。
128:      * @throws ValidateException 如果分类路径超过三级，将抛出验证异常。
129:      */
130:     public function update(int $id, $merId, array $data)
131:     {
132:         // 根据ID和商家ID获取现有的分类模型
133:         $model = $this->dao->get($id, $merId);
134: 
135:         // 检查如果父ID发生变化
136:         if ($model->pid != $data['pid']) {
137:             // 使用事务处理来确保数据一致性
138:             Db::transaction(function () use ($data, $model) {
139:                 // 根据新的父ID获取分类路径
140:                 $data['path'] = $this->getPathById($data['pid']);
141: 
142:                 // 确保分类路径不超过三级，否则抛出异常
143:                 if (substr_count(trim($data['path'], '/'), '/') > 1) {
144:                     throw new ValidateException('素材分类最多添加三级');
145:                 }
146: 
147:                 // 更新现有的分类路径，为即将进行的保存操作做准备
148:                 $this->dao->updatePath($model->path . $model->attachment_category_id, $data['path'] . $model->attachment_category_id);
149: 
150:                 // 保存更新后的模型数据
151:                 $model->save($data);
152:             });
153:         } else {
154:             // 如果父ID没有变化，直接更新分类数据，不需要修改路径
155:             unset($data['path']);
156:             $this->dao->update($id, $data);
157:         }
158:     }
159: 
160: 
161:     /**
162:      * 添加
163:      * @param array $data 添加的数据
164:      * @return BaseDao|int|Model
165:      * @author 张先生
166:      * @date 2020-03-30
167:      */
168:     public function create(array $data)
169:     {
170:         $data['path'] = $this->getPathById($data['pid']);
171:         if (substr_count(trim($data['path'], '/'), '/') > 1) throw new ValidateException('素材分类最多添加三级');
172:         return $this->dao->create($data);
173:     }
174: 
175: 
176:     /**
177:      * 获取path
178:      * @param int $id 主键id
179:      * @return mixed
180:      * @author 张先生
181:      * @date 2020-03-30
182:      */
183:     private function getPathById(int $id = 0)
184:     {
185:         $result = '/';
186:         if ($id) {
187:             $result = $this->dao->getPathById($id) . $id . '/';
188:         }
189:         return $result;
190:     }
191: 
192: }
