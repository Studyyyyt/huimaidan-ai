 27: /**
 28:  * 商户分类
 29:  */
 30: class MerchantCategoryRepository extends BaseRepository
 31: {
 32:     /**
 33:      * @var MerchantCategoryDao
 34:      */
 35:     protected $dao;
 36: 
 37:     /**
 38:      * MerchantCategoryRepository constructor.
 39:      * @param MerchantCategoryDao $dao
 40:      */
 41:     public function __construct(MerchantCategoryDao $dao)
 42:     {
 43:         $this->dao = $dao;
 44:     }
 45: 
 46:     /**
 47:      * 获取列表数据，支持根据条件查询和分页
 48:      *
 49:      * @param array $where 查询条件数组
 50:      * @param int $page 当前页码
 51:      * @param int $limit 每页数据条数
 52:      * @return array 返回包含总数和列表数据的数组
 53:      */
 54:     public function getList(array $where, $page, $limit)
 55:     {
 56:         // 根据条件进行查询
 57:         $query = $this->search($where);
 58: 
 59:         // 计算满足条件的数据总条数
 60:         $count = $query->count($this->dao->getPk());
 61: 
 62:         // 获取当前页码的数据列表
 63:         $list = $query->page($page, $limit)->select()->toArray();
 64: 
 65:         // 对列表中的每一项，计算并转换佣金比例为百分比形式
 66:         foreach ($list as $k => $v) {
 67:             $list[$k]['commission_rate'] = ($v['commission_rate'] > 0 ? bcmul($v['commission_rate'], 100, 2) : 0) . '%';
 68:         }
 69: 
 70:         // 返回包含总数和列表的数组
 71:         return compact('count', 'list');
 72:     }
 73: 
 74:     /**
 75:      * 创建或编辑商户分类表单
 76:      *
 77:      * 本函数用于生成一个商户分类的创建或编辑表单。根据传入的$id$参数决定是创建新分类还是编辑已有的分类。
 78:      * 表单包含分类名称和手续费率两个字段，都为必填字段。手续费率字段是一个数值字段，限制在0到100之间，精度为2位小数。
 79:      *
 80:      * @param int|null $id 商户分类的ID，如果为null则表示创建新分类，否则表示编辑已有的分类。
 81:      * @param array $formData 表单的初始数据，用于填充表单字段的值。
 82:      * @return \EasyWeChat\Kernel\Messages\Form|Form
 83:      */
 84:     public function form(?int $id = null, array $formData = [])
 85:     {
 86:         // 根据$id$的值决定构建创建还是更新分类的URL
 87:         $action = Route::buildUrl(is_null($id) ? 'systemMerchantCategoryCreate' : 'systemMerchantCategoryUpdate', is_null($id) ? [] : compact('id'))->build();
 88: 
 89:         // 创建表单，包含分类名称和手续费率两个字段
 90:         $form = Elm::createForm($action, [
 91:             Elm::input('category_name', '分类名称：')->placeholder('请输入分类名称')->required('请输入分类名称'),
 92:             Elm::number('commission_rate', '手续费(%)：', 0)->required('请输入手续费')->max(100)->precision(2)
 93:         ]);
 94: 
 95:         // 设置表单数据和标题，根据$id$的值决定是添加还是编辑分类
 96:         return $form->formData($formData)->setTitle(is_null($id) ? '添加商户分类' : '编辑商户分类');
 97:     }
 98: 
 99:     /**
100:      * 更新表单数据。
101:      * 此方法用于根据给定的ID获取表单数据，并对其进行更新，特别是将佣金率转换为百分比格式。
102:      *
103:      * @param int $id 数据库中记录的ID，用于定位特定的表单数据。
104:      * @return array|\EasyWeChat\Kernel\Messages\Form|Form
105:      */
106:     public function updateForm($id)
107:     {
108:         // 通过ID获取数据库中的记录，并转换为数组格式。
109:         $res = $this->dao->get($id)->toArray();
110: 
111:         // 如果佣金率大于0，则将其转换为百分比格式，保留两位小数；否则设置为0。
112:         $res['commission_rate'] = $res['commission_rate'] > 0 ? bcmul($res['commission_rate'], 100, 2) : 0;
113: 
114:         // 调用form方法，传入ID和更新后的数据，返回准备好的表单数据。
115:         return $this->form($id, $res);
116:     }
117: 
118: 
119:     /**
120:      * 筛选分类
121:      * @Author:Qinii
122:      * @Date: 2020/9/15
123:      * @return array
124:      */
125:     public function getSelect()
126:     {
127:         $query = $this->search([])->field('merchant_category_id,category_name');
128:         $list = $query->select()->toArray();
129:         return $list;
130:     }
131: }
