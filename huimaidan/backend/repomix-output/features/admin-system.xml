1291:     {
1292:         // 检查系统配置的保证金提醒开关，如果未开启，则不执行任何操作直接返回true
1293:         if (systemConfig('margin_remind_switch') !== '1') return true;
1294: 
1295:         // 获取系统配置的保证金提醒天数，如果未配置则默认为0
