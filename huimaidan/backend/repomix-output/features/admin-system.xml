286:     /**
287:      * 月账单
288:      * @param array $where
289:      * @param int $page
290:      * @param int $limit
291:      * @return array
292:      * @author Qinii
293:      * @day 3/23/21
294:      */
295:     public function getAdminList(array $where, int $page, int $limit)
296:     {
297:         //日
298:         if ($where['type'] == 1) {
299:             $field = Db::raw('from_unixtime(unix_timestamp(create_time),\'%Y-%m-%d\') as time');
300:             $time = date('Y-m-d', time());
301:         } else {
302:             //月
303:             if (!empty($where['date'])) {
304:                 list($startTime, $endTime) = explode('-', $where['date']);
305:                 $firstday = date('Y/m/01', strtotime($startTime));
306:                 $lastday_ = date('Y/m/01', strtotime($endTime));
307:                 $lastday = date('Y/m/d', strtotime("$lastday_ +1 month -1 day"));
308:                 $where['date'] = $firstday . '-' . $lastday;
309:             }
310:             $field = Db::raw('from_unixtime(unix_timestamp(create_time),\'%Y-%m\') as time');
311:             $time = date('Y-m', time());
312:         }
313:         $query = $this->dao->search($where)->field($field)->group("time")->order('create_time DESC');
314:         $count = $query->count();
315:         $list = $query->page($page, $limit)->select()->each(function ($item) use ($where,$time) {
316:             $offlineWhere = $where;
317:             $offlineWhere['financial_pm'] = 1;
318:             if ($where['type'] == 1 && $item['time'] == $time) {
319:                 $income = ($this->countIncome($where['type'], $where, $item['time']))['number'];
320:                 $expend = ($this->countExpend($where['type'], $where, $item['time']))['number'];
321:                 [$offline['count_offline'], $offline['number_offline']] = $this->dao->getDateByPayType($where['type'], $offlineWhere, $item['time'], [7]);
322:                 $ret = ['income' => $income, 'expend' => $expend, 'charge' => bcsub($income, $expend, 2),'offline' => $offline['number_offline']];
323:             } else {
324:                 $key = $where['is_mer'] ? 'mer_financial_record_list_' . $item['time']. $where['is_mer']  : 'sys_financial_record_list_' . $item['time'];
325:                 $ret = Cache::get($key);
326:                 if (!$ret) {
327:                     $income = ($this->countIncome($where['type'], $where, $item['time']))['number'];
328:                     $expend = ($this->countExpend($where['type'], $where, $item['time']))['number'];
329:                     [$offline['count_offline'], $offline['number_offline']] = $this->dao->getDateByPayType($where['type'], $offlineWhere, $item['time'], [7]);
330:                     $ret = ['income' => $income, 'expend' => $expend, 'charge' => bcsub($income, $expend, 2),'offline' => $offline['number_offline']];
331:                     Cache::tag('system')->set($key, $ret, 24 * 3600);
332:                 }
333:             }
334:             $item['income'] = $ret['income'];
335:             $item['expend'] = $ret['expend'];
336:             $item['charge'] = $ret['charge'];
337:             $item['offline'] = $ret['offline'] ?? 0;
338:         });
339: 
340:         return compact('count', 'list');
341:     }
