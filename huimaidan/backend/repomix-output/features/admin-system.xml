277:     /**
278:      * 根据商家ID和配置名称获取配置信息。
279:      * 该方法支持批量获取配置，如果配置信息存储在Redis中，则直接从Redis中读取；
280:      * 如果Redis中不存在配置信息，则从数据库同步配置到Redis。
281:      *
282:      * @param int $merId 商家ID，用于区分不同商家的配置。
283:      * @param string|array $name 配置名称，可以是单个配置名称的字符串，也可以是多个配置名称的数组。
284:      * @return array|mixed 返回配置值，如果请求的是单个配置，则返回对应的配置值对象；
285:      * 如果请求的是多个配置，则返回一个包含多个配置值的数组。
286:      */
287:     public function getConfig(int $merId, $name)
288:     {
289:         // 创建Redis缓存服务实例
290:         $make = app()->make(RedisCacheService::class);
291: 
292:         // 处理配置名称为数组的情况
293:         if (is_array($name)) {
294:             if (!count($name)) {
295:                 // 如果配置名称数组为空，则直接返回空数组
296:                 return [];
297:             }
298:             $names = $name;
299:         } else {
300:             // 如果配置名称不是数组，则将其转换为数组
301:             $names = [$name];
302:         }
303:         $configFlag = $make->mGet([self::CONFIG_KEY_PREFIX.'configFlag']);
304: 
305:         // 从Redis中获取配置标志，用于判断是否需要同步配置到Redis
306:         if (empty($configFlag) || $configFlag[0] == false) {
307:             // 如果Redis中没有配置标志，则调用同步配置方法
308:             $this->syncConfig();
309:         }
310: 
311:         // 准备配置键名数组
312:         $keys = [];
313:         foreach ($names as $item) {
314:             $keys[] = self::CONFIG_KEY_PREFIX . $merId . '_' . $item;
315:         }
316: 
317:         // 从Redis中批量获取配置值
318:         $values = $make->mGet($keys) ?: [];
319: 
320:         if (!is_array($name)) {
321:             // 如果请求的是单个配置，则直接返回对应的配置值
322:             $value = $values[0] ?? '';
323:             $json = json_decode($value, true);
324:             if (json_last_error() == JSON_ERROR_NONE) {
325:                 $value = $json;
326:             }
327: 
328:             return $value;
329:         }
330: 
331:         // 处理批量获取配置的情况
332:         $data = [];
333:         if (!count($values)) {
334:             // 如果没有获取到任何配置值，则初始化一个空数组，每个配置对应一个空字符串值
335:             foreach ($names as $v) {
336:                 $data[$v] = '';
337:             }
338:             return $data;
339:         }
340: 
341:         // 遍历获取到的配置值，将其按照配置名称放入$data数组中
342:         foreach ($values as $i => &$value) {
343:             $json = json_decode($value, true);
344:             if (json_last_error() == JSON_ERROR_NONE) {
345:                 $value = $json;
346:             }
347: 
348:             $data[$names[$i]] = $value;
349:         }
350: 
351:         return $data;
352:     }
353: 
354: }
