 36: 
 37:     /**
 38:      * ConfigRepository constructor.
 39:      * @param SystemConfigDao $dao
 40:      */
 41:     public function __construct(SystemConfigDao $dao)
 42:     {
 43:         $this->dao = $dao;
 44:     }
 45: 
 46:     /**
 47:      * 根据商家ID、配置分类和配置信息，生成表单规则。
 48:      * 该方法主要用于构建表单的规则和结构，根据不同的商家ID和配置分类，动态生成表单用于数据的录入和修改。
 49:      *
 50:      * @param int $merId 商家ID，用于区分是商家配置还是平台配置。
 51:      * @param SystemConfigClassify $configClassify 配置分类对象，包含分类的键和名称。
 52:      * @param array $configs 配置信息数组，包含所有的配置项。
 53:      * @param array $formData 已填写的表单数据数组，用于预填充表单。
 54:      * @return Elm|Form
 55:      */
 56:     public function formRule(int $merId, SystemConfigClassify $configClassify, array $configs, array $formData = [])
 57:     {
 58:         // 根据配置信息和商家ID获取表单组件规则
 59:         $components = $this->getRule($configs, $merId);
 60: 
 61:         // 创建表单，设置表单的提交URL和组件
 62:         $form = Elm::createForm(Route::buildUrl($merId ? 'merchantConfigSave' : 'configSave', ['key' => $configClassify->classify_key])->build(), $components);
 63: 
 64:         // 设置表单的标题为配置分类的名称，并过滤掉表单数据中的空值
 65:         return $form->setTitle($configClassify->classify_name)->formData(array_filter($formData, function ($item) {
 66:             return $item !== '' && !is_null($item);
 67:         }));
 68:     }
