266:     /**
267:      * 缓存令牌
268:      *
269:      * 本函数用于缓存给定的令牌及其过期时间。缓存机制可以是任何支持的缓存驱动，
270:      * 如文件缓存、数据库缓存、内存缓存等。缓存的目的是为了快速验证令牌的有效性，
271:      * 而不是每次请求都进行复杂的令牌生成逻辑。
272:      *
273:      * @param string $token 令牌字符串。这是由特定算法生成的唯一字符串，用于标识用户或会话。
274:      * @param int $exp 令牌的过期时间，以秒为单位。过期时间过后，令牌将不再有效。
275:      */
276:     public function cacheToken(string $token, int $exp)
277:     {
278:         // 构建缓存键名，并设置缓存值为当前时间加上过期时间，过期时间参数再次确保缓存的有效期。
279:         Cache::set('mer_' . $token, time() + $exp, $exp);
280:     }
281: 
282:     /**
283:      * 检查商家令牌的有效性
284:      *
285:      * 本函数用于验证传入的商家令牌是否有效。它首先检查令牌是否存在缓存中，
286:      * 如果不存在，则抛出一个表示令牌无效的异常。如果令牌存在缓存中，
287:      * 它将进一步检查令牌是否过期。如果令牌过期，则同样抛出一个表示令牌过期的异常。
288:      * 这样做的目的是为了确保只有有效的令牌才能用于授权和访问受保护的资源。
289:      *
290:      * @param string $token 商家令牌。这是一个用于标识和验证商家的唯一字符串。
291:      * @throws AuthException 如果令牌无效或过期，则抛出此异常。
292:      */
293:     public function checkToken(string $token)
294:     {
295:         // 检查缓存中是否存在指定的商家令牌
296:         $has = Cache::has('mer_' . $token);
297:         // 如果令牌不存在于缓存中，则抛出无效令牌异常
298:         if (!$has)
299:             throw new AuthException('无效的token');
300: 
301:         // 获取商家令牌的缓存时间
302:         $lastTime = Cache::get('mer_' . $token);
303:         // 检查令牌是否过期，如果过期则抛出异常
304:         if (($lastTime + (intval(Config::get('admin.token_valid_exp', 15))) * 60) < time())
305:             throw new AuthException('token 已过期，请重新登录');
306:     }
307: 
308:     /**
309:      * 更新商户令牌
310:      *
311:      * 本函数用于更新商户的令牌。令牌是用于验证商户身份的重要凭据，通过更新令牌，可以延长商户的登录状态，
312:      * 或者重新设置商户的访问权限。此操作依赖于缓存系统来存储令牌和其对应的过期时间。
313:      *
314:      * @param string $token 商户的令牌。该令牌是用于标识和验证商户身份的唯一字符串。
315:      */
316:     public function updateToken(string $token)
317:     {
318:         // 组合缓存键名，并设置缓存，缓存值为当前时间戳，过期时间为配置文件中定义的令牌有效时长（默认为15分钟）的60倍。
319:         // 这样做是为了确保令牌在设定的有效期内保持有效，过期后需要重新获取。
320:         Cache::set('mer_' . $token, time(), intval(Config::get('admin.token_valid_exp', 15)) * 60);
321:     }
322: 
323:     /**
324:      * 清除指定商户的令牌缓存
325:      *
326:      * 本函数用于从缓存系统中删除指定商户的令牌。这在商户令牌不再需要时，
327:      * 或者在令牌过期或被吊销时非常有用。通过清除令牌的缓存，可以确保
328:      * 令牌不会被意外或恶意使用，增强了系统的安全性。
329:      *
330:      * @param string $token 商户的令牌。此令牌用于唯一标识商户。
331:      */
332:     public function clearToken(string $token)
333:     {
334:         // 构建缓存键名，并删除该缓存项
335:         Cache::delete('mer_' . $token);
336:     }
337: 
338:     /**
339:      * 创建管理员令牌
340:      *
341:      * 本函数用于生成针对管理员的JWT令牌，该令牌用于管理员的身份验证。
342:      * 令牌的过期时间通过配置文件定义，默认为3小时。
343:      *
344:      * @param MerchantAdmin $admin 管理员对象，包含管理员信息。
345:      * @return array 返回包含令牌和过期时间的信息。
346:      */
347:     public function createToken(MerchantAdmin $admin)
348:     {
349:         // 实例化JWT令牌服务类
350:         $service = new JwtTokenService();
351: 
352:         // 从配置文件中获取管理员令牌的过期时间，默认为3小时
353:         $exp = intval(Config::get('admin.token_exp', 3));
354: 
355:         // 生成令牌，指定管理员ID和令牌过期时间
356:         $token = $service->createToken($admin->merchant_admin_id, 'mer', strtotime("+ {$exp}hour"));
357: 
358:         // 缓存令牌信息
359:         $this->cacheToken($token['token'], $token['out']);
360: 
361:         // 返回生成的令牌信息
362:         return $token;
363:     }
364: 
365:     /**
366:      * 验证验证码是否正确。
367:      * 该方法主要用于在非开发环境下验证用户输入的验证码是否与缓存中的验证码匹配。如果验证码不匹配或已过期，
368:      * 将抛出ValidateException异常。在开发环境下，验证码的验证逻辑被跳过，以方便开发。
369:      *
370:      * @param string $key 验证码的唯一标识键，用于拼接缓存键名。
371:      * @param string $code 用户输入的验证码内容。
372:      * @throws ValidateException 如果验证码过期或不正确，则抛出此异常。
373:      */
374:     public function checkCode(string $key, string $code)
375:     {
376:         // 如果不在开发模式下，则进行验证码的验证
377:         if (!env('DEVELOPMENT',false)){
378:             // 从缓存中获取存储的验证码，键名为'am_captcha'加上$key。
379:             $_code = Cache::get('am_captcha' . $key);
380:             // 如果缓存中没有找到验证码，表示验证码已过期，抛出异常。
381:             if (!$_code) {
382:                 throw new ValidateException('验证码过期');
383:             }
384:             // 将存储的验证码和用户输入的验证码转换为小写后比较，不匹配则抛出异常。
385:             if (strtolower($_code) != strtolower($code)) {
386:                 throw new ValidateException('验证码错误');
387:             }
388:             // 验证码验证通过后，删除缓存中的验证码。
389:             //删除code
390:             Cache::delete('am_captcha' . $key);
391:         }
392:     }
393: 
394:     /**
395:      * 创建登录验证码键
396:      *
397:      * 本函数用于生成一个唯一的登录验证码键，并将该验证码与键关联起来存储在缓存中。
398:      * 验证码键的生成结合了微秒时间和随机数，以确保唯一性。
399:      * 验证码在缓存中的有效期通过配置文件设定，以分钟为单位。
400:      *
401:      * @param string $code 登录验证码
402:      * @return string 生成的验证码键
403:      */
404:     public function createLoginKey(string $code)
405:     {
406:         // 生成一个唯一的验证码键，基于当前微秒时间戳和随机数
407:         $key = uniqid(microtime(true), true);
408: 
409:         // 将验证码与键关联，存储到缓存中，并设定过期时间
410:         // 缓存有效期通过配置文件获取，默认为5分钟
411:         Cache::set('am_captcha' . $key, $code, Config::get('admin.captcha_exp', 5) * 60);
412: 
413:         // 返回生成的验证码键
414:         return $key;
415:     }
