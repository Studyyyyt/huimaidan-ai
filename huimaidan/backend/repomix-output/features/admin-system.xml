420:     /**
421:      * 快捷搜索
422:      * @param int $isMer 是否商户
423:      * @param string $keyWord 关键词
424:      * @return array
425:      * @throws DataNotFoundException
426:      * @throws DbException
427:      * @throws ModelNotFoundException
428:      * FerryZhao 2024/4/3
429:      */
430:     public function getMenusList($isMer, $keyWord)
431:     {
432:         $pre = '/' . config('admin.' . ($isMer ? 'merchant' : 'admin') . '_prefix');
433:         $configRepository = app()->make(ConfigRepository::class);
434:         $configData = $configRepository->getSearch([])
435:             ->where('user_type', $isMer)
436:             ->whereLike('config_name', '%' . $keyWord . '%')
437:             ->field('config_id,config_name,config_classify_id')
438:             ->with(['classConfig.parent'])->select()->toArray();
439:         $configMenus = [];
440:         $configMenusPath = [];
441:         $param = [];
442:         if ($configData) {
443:             foreach ($configData as $configDatum) {
444:                 if ($_p = $this->valSpecial($isMer, $configDatum['config_name'])) {
445:                     $configMenus[$_p] = [
446:                         'title' => $configDatum['config_name'],
447:                         'path' => $_p,
448:                     ];
449:                 } else if ($classConfig = $configDatum['classConfig']) {
450:                     $classConfigId = !empty($classConfig['parent']) ? $classConfig['parent']['config_classify_id'] : $classConfig['config_classify_id'];
451:                     $classifyKey = !empty($classConfig['parent']) ? $classConfig['parent']['classify_key'] : $classConfig['classify_key'];
452:                     $title = !empty($classConfig['parent']) ? $classConfig['parent']['classify_name'] : $classConfig['classify_name'];
453:                     $path = '/systemForm/Basics/' . $classifyKey;
454:                     $configMenus[$classConfigId] = [
455:                         'title' => $title,
456:                         'path' => $path,
457:                     ];
458:                     $param[$path] = '/' . $classConfig['config_classify_id'];
459:                 }
460:             }
461:             $configMenus = array_values($configMenus);
462:             $configMenusPath = array_column($configMenus, 'path');
463:         }
464:         $menuData = $this->dao->getSearch([])
465:             ->where('is_mer', $isMer)
466:             ->where('is_menu', 1)
467:             ->where('is_show', 1)
468:             ->where(function ($query) use ($keyWord, $configMenusPath) {
469:                 $query->whereLike('menu_name', '%' . $keyWord . '%')->whereOr('route', 'in', $configMenusPath);
470:             })->select()->append(['parents', 'child'])->toArray();
471:         $menus = [];
472:         foreach ($menuData as $datum) {
473:             if (in_array($datum['route'], $this->unsetConfigArray)) {
474:                 continue;
475:             }
476:             if (!empty($datum['child'])) {
477:                 continue;
478:             }
479:             $title = '';
480:             if ($parents = $datum['parents']) {
481:                 $path = explode('/', trim($datum['path'], '/'));
482:                 $parents = array_combine(array_column($parents, 'pid'), $parents);
483:                 $menu = $parents[0]['menu_name'] ?? '';
484:                 foreach ($path as $item) {
485:                     if (isset($parents[$item])) {
486:                         $menu .= ' - ' . $parents[$item]['menu_name'];
487:                     }
488:                 }
489:                 $menu .= ' - ' . $datum['menu_name'];
490:                 $title = trim($menu, '-');
491:             }
492:             $menus[] = [
493:                 'path' => $pre . $datum['route'] . ($param[$datum['route']] ?? ''),
494:                 'title' => $title ?: $datum['menu_name'],
495:             ];
496:         }
497:         return compact('menus');
498:     }
499: }
