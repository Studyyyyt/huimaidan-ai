 14: namespace app\common\repositories\system\notice;
 15: 
 16: 
 17: use app\common\dao\system\notice\SystemNoticeDao;
 18: use app\common\repositories\BaseRepository;
 19: use app\common\repositories\system\merchant\MerchantCategoryRepository;
 20: use app\common\repositories\system\merchant\MerchantRepository;
 21: use think\exception\ValidateException;
 22: use think\facade\Db;
 23: 
 24: /**
 25:  * 通知公告
 26:  */
 27: class SystemNoticeRepository extends BaseRepository
 28: {
 29:     public function __construct(SystemNoticeDao $dao)
 30:     {
 31:         $this->dao = $dao;
 32:     }
 33: 
 34:     /**
 35:      * 创建通知
 36:      * 根据传入的数据和管理员ID，创建相应的通知，并根据不同的条件筛选商户，将通知与商户关联。
 37:      *
 38:      * @param array $data 包含通知信息和筛选条件的数据数组
 39:      * @param int $admin_id 管理员ID，用于标识通知的创建者
 40:      * @return object 创建的通知对象
 41:      * @throws ValidateException 如果商户类型错误或没有有效的商户信息，则抛出验证异常
 42:      */
 43:     public function create(array $data, $admin_id)
 44:     {
 45:         // 为通知数据添加管理员ID
 46:         $data['admin_id'] = $admin_id;
 47:         // 根据不同的商户类型，筛选商户ID并生成相应的type_str
 48:         $ids = $this->merchantIds($data);
 49:         // 在事务中执行通知的创建和商户通知关联的插入
 50:         return Db::transaction(function () use ($data, $ids) {
 51:             // 创建通知
 52:             $notice = $this->dao->create($data);
 53:             // 获取系统通知日志仓库实例
 54:             $systemNoticeLogRepository = app()->make(SystemNoticeLogRepository::class);
 55:             // 准备商户通知关联的插入数据
 56:             $inserts = [];
 57:             foreach ($ids as $id) {
 58:                 if (!$id) continue;
 59:                 $inserts[] = [
 60:                     'mer_id' => (int)$id,
 61:                     'notice_id' => $notice->notice_id
 62:                 ];
 63:             }
 64:             // 批量插入商户通知关联数据
 65:             $systemNoticeLogRepository->insertAll($inserts);
 66:             // 返回创建的通知对象
 67:             return $notice;
 68:         });
 69:     }
 70:     /**
 71:      * 更新通知
 72:      *
 73:      * 根据提供的ID、数据和管理员ID，更新数据库中的通知记录。
 74:      * 该方法用于处理通知的编辑操作，确保只有授权的管理员才能更新通知。
 75:      *
 76:      * @param integer $noticeId 要更新的通知记录的ID。
 77:      * @param array $data 包含更新数据的关联数组，键为字段名，值为新的字段值。
 78:      * @param int $admin_id 执行更新操作的管理员ID，用于验证权限。
 79:      * @return void 无返回值，直接更新数据库记录。
 80:      */
 81:     public function update(int $noticeId, array $data, int $admin_id)
 82:     {
 83:         // 为通知数据添加管理员ID
 84:         $data['admin_id'] = $admin_id;
 85:         // 根据不同的商户类型，筛选商户ID并生成相应的type_str
 86:         $ids = $this->merchantIds($data);
 87:         // 在事务中执行通知的创建和商户通知关联的插入
 88:         return Db::transaction(function () use ($noticeId, $data, $ids) {
 89:             // 更新通知
 90:             $this->dao->update($noticeId, $data);
 91:             // 获取系统通知日志仓库实例
 92:             $systemNoticeLogRepository = app()->make(SystemNoticeLogRepository::class);
 93:             // 删除旧的商户通知关联记录
 94:             $systemNoticeLogRepository->getSearch(['notice_id' => $noticeId])->delete();
 95:             // 准备新的商户通知关联数据
 96:             $inserts = [];
 97:             foreach ($ids as $id) {
 98:                 if (!$id) continue;
 99:                 $inserts[] = [
100:                     'mer_id' => (int)$id,
101:                     'notice_id' => $noticeId
102:                 ];
103:             }
104:             // 批量插入商户通知关联数据
105:             $systemNoticeLogRepository->insertAll($inserts);
106:         });
107:     }
108: 
109:     public function switchStatus(int $noticeId, array $data, int $admin_id)
110:     {
111:         // 为通知数据添加管理员ID
112:         $data['admin_id'] = $admin_id;
113:         // 检查状态值是否有效
114:         if (!in_array($data['status'], [0, 1], true)) {
115:             throw new ValidateException('状态值错误');
116:         }
117:         $info = $this->dao->get($noticeId);
118:         if (!$info) {
119:             throw new ValidateException('公告信息不存在');
120:         }
121:         $data['type'] = $info->type;
122: 
123:         return Db::transaction(function () use ($noticeId, $data, $info) {
124:             // 更新通知
125:             $this->dao->update($noticeId, $data);
126:             // 获取系统通知日志仓库实例
127:             $systemNoticeLogRepository = app()->make(SystemNoticeLogRepository::class);
128:             if($data['status'] == 0){
129:                 // 状态关闭禁用通知，删除所有关联记录
130:                 $systemNoticeLogRepository->getSearch(['notice_id' => $noticeId])->delete();
131:                 return;
132:             } else {
133:                 // 指定商户通过名称反查id
134:                 if($info['type'] == 1) {
135:                     $merName = explode('/', $info['type_str']);
136:                     $merIds = app()->make(MerchantRepository::class)->getSearch([])->whereIn('mer_name', $merName)->column('mer_id');
137:                     $data['mer_id'] = $merIds;
138:                 }
139:                 // 指定是否自营
140:                 if ($info['type'] == 2) {
141:                     $data['is_trader'] = $info['type_str'] == '自营' ? 1 : 0;
142:                 }
143:                 // 指定分类通过名称反查id
144:                 if ($info['type'] == 3) {
145:                     $categoryName = explode('/', $info['type_str']);
146:                     $categoryIds = app()->make(MerchantCategoryRepository::class)->getSearch([])->whereIn('category_name', $categoryName)->column('merchant_category_id');
147:                     $data['category_id'] = $categoryIds;
148:                 }
149:                 // 状态开启启用通知，根据商户类型筛选商户ID并关联通知
150:                 $ids = $this->merchantIds($data);
151:                 // 准备新的商户通知关联数据
152:                 $inserts = [];
153:                 foreach ($ids as $id) {
154:                     if (!$id) continue;
155:                     $inserts[] = [
156:                         'mer_id' => (int)$id,
157:                         'notice_id' => $noticeId
158:                     ];
159:                 }
160:                 // 批量插入商户通知关联数据
161:                 $systemNoticeLogRepository->insertAll($inserts);
162:             }
163:         });
164:     }
165: 
166:     public function delete(int $noticeId)
167:     {
168:         $info = $this->dao->get($noticeId);
169:         if (!$info) {
170:             throw new ValidateException('公告信息不存在');
171:         }
172: 
173:         return Db::transaction(function () use ($noticeId) {
174:             // 删除通知
175:             $this->dao->delete($noticeId);
176:             // 删除关联的商户通知记录
177:             app()->make(SystemNoticeLogRepository::class)->getSearch(['notice_id' => $noticeId])->delete();
178: 
179:             return true;
180:         });
181:     }
182: 
183:     protected function merchantIds(array &$data)
184:     {
185:         // 获取商户仓库实例
186:         $merchantRepository = app()->make(MerchantRepository::class);
187: 
188:         // 根据不同的商户类型，筛选商户ID并生成相应的type_str
189:         if ($data['type'] == 1) {
190:             // 多个指定商户
191:             $ids = (array)$data['mer_id'];
192:             $type_str = implode('/', $merchantRepository->names($ids));
193:         } else if ($data['type'] == 2) {
194:             // 按自营或非自营筛选
195:             $ids = $merchantRepository->search(['is_trader' => (int)$data['is_trader']])->column('mer_id');
196:             $type_str = $data['is_trader'] ? '自营' : '非自营';
197:         } else if ($data['type'] == 3) {
198:             // 按类别筛选
199:             $ids = $merchantRepository->search(['category_id' => (array)$data['category_id']])->column('mer_id');
200:             $type_str = implode('/', app()->make(MerchantCategoryRepository::class)->names((array)$data['category_id']));
201:         } else if ($data['type'] == 4) {
202:             // 所有商户
203:             $ids = $merchantRepository->search([])->column('mer_id');
204:             $type_str = '全部';
205:         } else {
206:             // 商户类型错误，抛出异常
207:             throw new ValidateException('商户类型有误');
208:         }
209:         // 如果没有有效的商户ID，抛出异常
210:         if (!count($ids)) {
211:             throw new ValidateException('没有有效的商户信息');
212:         }
213:         // 为通知数据添加type_str，并移除不需要的字段
214:         $data['type_str'] = $type_str;
215:         unset($data['is_trader'], $data['category_id'], $data['mer_id']);
216: 
217:         return $ids;
218:     }
219:     /**
220:      * 获取通知列表
221:      *
222:      * 根据给定的条件和分页信息，从数据库中检索通知列表。
223:      * 这个方法用于处理数据的查询逻辑，包括条件查询、分页和排序。
224:      *
225:      * @param array $where 查询条件，以键值对形式提供，用于构建SQL查询的WHERE子句。
226:      * @param int $page 当前的页码，用于实现分页查询。
227:      * @param int $limit 每页的记录数，用于控制分页查询的结果数量。
228:      * @return array 返回包含通知列表和总数的数组，方便前端进行分页显示。
229:      */
230:     public function getList(array $where, $page, $limit)
231:     {
232:         // 根据提供的条件进行查询
233:         $query = $this->dao->search($where);
234: 
235:         // 统计满足条件的通知总数
236:         $count = $query->count();
237:         // 进行分页查询，并按通知ID降序排序
238:         $list = $query->field('notice_id,notice_title,type,type_str,status,create_time')->page($page, $limit)->order('notice_id DESC')->select();
239: 
240:         // 将总数和列表一起返回
241:         return compact('count', 'list');
242:     }
243: }
</file>

