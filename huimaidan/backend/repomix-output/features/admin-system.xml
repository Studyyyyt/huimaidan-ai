 513: 
 514:         // 生成并返回退款相关信息数组
 515:         return [
 516:             'status' => 0,
 517:             'mer_id' => $merchant->mer_id,
 518:             'mer_money' => 0,
 519:             'financial_sn' => 'mm' . date('YmdHis' . $merchant->mer_id),
 520:             'extract_money' => $refund_price,
 521:             'financial_type' => $order['pay_type'],
 522:             'financial_account' => json_encode($order, JSON_UNESCAPED_UNICODE),
 523:             'financial_status' => 0,
 524:             'mer_admin_id' => $adminId,
