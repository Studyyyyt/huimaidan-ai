 51:      * @return \Illuminate\Http\JsonResponse 返回一个JSON响应，包含账号信息和发送总量。
 52:      */
 53:     public function number()
 54:     {
 55:         // 调用服务层方法获取统计信息
 56:         $countInfo = $this->service->count();
 57: 
 58:         // 检查请求是否成功，如果状态码为400，则返回错误信息
 59:         if ($countInfo['status'] == 400) return app('json')->fail($countInfo['msg']);
 60: 
 61:         // 组装返回的数据，包括账号信息和统计的发送总量
 62:         $info['account'] = $this->service->account();
 63:         $info['number'] = $countInfo['data']['number'];
 64:         $info['send_total'] = $countInfo['data']['send_total'];
 65: 
 66:         // 返回成功的JSON响应，包含统计信息
 67:         return app('json')->success($info);
 68:     }
 69: 
 70:     /**
 71:      * 获取餐品价格信息
 72:      *
 73:      * 本方法用于从服务层获取指定页码和每页数量的餐品价格信息。
 74:      * 如果请求成功，将返回餐品的详细价格数据；如果请求失败，将返回错误信息。
 75:      *
 76:      * @return \Illuminate\Http\JsonResponse
 77:      * 返回一个JSON响应，包含成功时的餐品价格数据，或失败时的错误信息。
 78:      */
 79:     public function price()
 80:     {
 81:         // 获取分页信息
 82:         [$page, $limit] = $this->getPage();
 83: 
 84:         // 从服务层获取餐品信息
 85:         $mealInfo = $this->service->meal($page, $limit);
 86: 
 87:         // 检查请求是否成功
 88:         if ($mealInfo['status'] == 400) {
 89:             // 如果请求失败，返回失败的JSON响应
 90:             return app('json')->fail($mealInfo['msg']);
 91:         }
 92: 
 93:         // 如果请求成功，返回成功的JSON响应，包含餐品价格数据
 94:         return app('json')->success($mealInfo['data']);
 95:     }
 96: 
 97:     /**
 98:      * 处理支付请求
 99:      *
100:      * 本函数负责接收支付请求，解析请求参数，调用支付服务进行支付操作，并根据支付结果返回相应的响应。
101:      * 支付请求中应包含支付方式、餐品ID及价格等信息。
102:      *
103:      * @return json 支付成功时返回支付详情，支付失败时返回错误信息。
104:      */
105:     public function pay()
106:     {
107:         // 解析请求参数，包括支付方式、餐品ID和价格，默认值分别为微信支付、0和0。
108:         list($payType, $mealId, $price) = $this->request->params([
109:             ['payType', 'weixin'],
110:             ['mealId', 0],
111:             ['price', 0],
112:         ], true);
113: 
114:         // 调用支付服务进行支付操作，传入支付方式、餐品ID、价格以及管理员ID。
115:         // 管理员ID通过请求对象的adminId方法获取。
116:         $payInfo = $this->service->pay($payType, $mealId, $price, $this->request->adminId());
117: 
118:         // 根据支付结果的状态码进行响应。
119:         // 如果状态码为400，表示支付失败，返回错误信息。
120:         // 否则，返回支付成功的详细信息。
121:         if ($payInfo['status'] == 400) return app('json')->fail($payInfo['msg']);
122:         return app('json')->success($payInfo['data']);
123:     }
