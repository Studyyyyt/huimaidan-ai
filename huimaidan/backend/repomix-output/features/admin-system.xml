 91:         });
 92: 
 93:         // 当is_wechat条件存在且不为空时，添加notice_wechat字段的查询条件
 94:         $query = $query->when(isset($where['is_wechat']) && $where['is_wechat'] != '', function($query){
 95:             // 筛选notice_wechat字段为0或1的记录，表示微信通知的状态为启用或禁用
 96:             $query->whereIn('notice_wechat',[0,1]);
 97:         });
 98: 
 99:         // 返回构建完成的查询对象
100:         return $query;
