380:      * 查询结果包括配置项的列表和总数，方便前端进行分页显示。
381:      *
382:      * @param array $where 查询条件，以键值对形式表示，用于构建SQL的WHERE子句。
383:      * @param int $page 当前页码，用于确定要返回哪一页的记录。
384:      * @param int $limit 每页返回的记录数，用于控制分页大小。
385:      * @return array 返回一个包含两个元素的数组，'count'表示记录总数，'list'表示当前页的配置项列表。
386:      */
387:     public function lst(array $where, int $page, int $limit)
388:     {
389:         // 根据$where条件搜索配置项
390:         $query = $this->dao->search($where);
391: 
392:         // 计算满足条件的配置项总数
393:         $count = $query->count();
394: 
395:         // 对查询结果进行分页，每页返回$limit条记录，并处理配置项的'typeName'属性
396:         // 通过闭包函数动态获取'types'数组中对应'config_type'的值作为'typeName'
