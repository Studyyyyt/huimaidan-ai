311:      * @param bool $all 是否返回所有菜单。true表示返回所有菜单，包括未设置为显示的和非菜单项；false表示只返回设置为显示且为菜单项的菜单。
312:      * @param array $where 查询条件数组。可以包含任何有效的SQL查询条件。
313:      * @param string $filed 要返回的字段，以逗号分隔。默认为'menu_name,pid'，表示返回菜单名称和父ID。
314:      * @return array 返回一个数组，数组的键为menu_id，值为指定字段的值。
315:      */
316:     public function getAllOptions($is_mer = 0, $all = false, $where = [], $filed = 'menu_name,pid', int $isAgent = 0)
317:     {
318:         // 使用菜单模型的数据库操作对象
319:         return Menu::getDB()->where('is_mer', $is_mer == 2 ? $is_mer : ($is_mer ? 1 : 0))
320:             // 如果$where数组中包含'ids'键，并且其值不为空，那么查询菜单ID在给定数组中的菜单
321:             ->when(isset($where['ids']) && !empty($where['ids']), function($query) use($where) {
322:                 $query->whereIn('menu_id', $where['ids']);
323:             })
324:             ->where('is_agent', $isAgent)
325:             // 如果$all参数为false，那么查询显示且为菜单项，或者非菜单项的菜单
326:             ->when(!$all, function ($query) {
327:                 $query->where(function ($query) {
328:                     $query->where(function ($query) {
329:                         $query->where('is_show', 1)->where('is_menu', 1);
330:                     })->whereOr('is_menu', 0);
331:                 });
332:             })
333:             // 按照排序降序，菜单ID升序排序
334:             ->order('sort DESC,menu_id ASC')->column($filed, 'menu_id');
335:     }
