104:     /**
105:      * 创建新的权限类型并关联权限。
106:      *
107:      * 本函数用于处理新增权限类型的操作，包括插入新的权限类型数据以及建立该类型与具体权限的关联关系。
108:      * 使用事务确保数据操作的原子性。
109:      *
110:      * @param array $data 包含权限类型信息和授权ID的数据数组。
111:      * @return \think\Model 新增的权限类型的模型对象。
112:      */
113:     public function create(array $data)
114:     {
115:         // 使用数据库事务处理来确保操作的完整性
116:         return Db::transaction(function () use ($data) {
117:             // 过滤并去重auth数组中的授权ID
118:             $auth = array_filter(array_unique($data['auth']));
119:             // 从$data中移除'auth'键，因为它已经不再需要
120:             unset($data['auth']);
121:             // 调用DAO层创建新的权限类型
122:             $type = $this->dao->create($data);
123:             // 初始化一个数组，用于存储后续要插入的关联数据
124:             $inserts = [];
125:             // 遍历授权ID数组，构建关联数据数组
126:             foreach ($auth as $id) {
127:                 $inserts[] = [
128:                     'left_id' => $type->mer_type_id, // 新增权限类型的ID
129:                     'right_id' => (int)$id, // 当前授权ID
130:                     'type' => RelevanceRepository::TYPE_MERCHANT_AUTH // 关联类型常量
131:                 ];
132:             }
133:             // 使用依赖注入创建RelevanceRepository实例，并插入所有关联数据
134:             app()->make(RelevanceRepository::class)->insertAll($inserts);
135:             // 返回新增的权限类型对象
136:             return $type;
137:         });
138:     }
