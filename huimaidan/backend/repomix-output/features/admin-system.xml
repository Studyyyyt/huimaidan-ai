 82:                 return app('json')->fail($e->getMessage());
 83:             }
 84:         }
 85:         $adminInfo = $this->repository->login($data['account'], $data['password']);
 86:         $tokenInfo = $this->repository->createToken($adminInfo);
 87:         $admin = $adminInfo->toArray();
 88:         unset($admin['pwd']);
 89:         $data = [
 90:             'token' => $tokenInfo['token'],
 91:             'exp' => $tokenInfo['out'],
 92:             'admin' => $admin
 93:         ];
 94:         Cache::delete($key);
 95:         return app('json')->success($data);
