219:     /**
220:      * 同步配置到Redis缓存中。
221:      * 该方法从数据库中查询当前的配置信息，然后将这些配置同步到Redis缓存中。
222:      * 同时，它也会清理掉已经不存在于数据库中的旧配置项，以保持缓存的同步和清洁。
223:      * 最后，它会更新一个配置标志，标记配置的同步时间。
224:      */
225:     public function syncConfig()
226:     {
227:         // 从数据库中查询所有的配置项，包括值、配置键和商家ID。
228:         $list = $this->query([])->column('value,config_key,mer_id');
229: 
230:         // 实例化Redis缓存服务类。
231:         $make = app()->make(RedisCacheService::class);
232: 
233:         // 获取当前Redis中所有以CONFIG_KEY_PREFIX开头的键，这些可能是旧的配置键。
234:         $oldKeys = $make->keys(self::CONFIG_KEY_PREFIX.'*') ?: [];
235:         // 将键名和键值设为相同的值，以便后续操作。
236:         $oldKeys = array_combine($oldKeys, $oldKeys);
237: 
238:         // 准备一个数组，用于存储要设置到Redis中的新配置项。
239:         $mset = [];
240:         foreach ($list as $item) {
241:             // 构建新的配置键，并将配置值存储到$mset数组中。
242:             $key = self::CONFIG_KEY_PREFIX . $item['mer_id'] . '_' . $item['config_key'];
243:             $mset[$key] = $item['value'];
244:             // 从旧的键中删除已经存在于新配置中的键，以便后续清理。
245:             unset($oldKeys[$key]);
246:         }
247:         // 更新配置标志，记录配置的同步时间。
248:         $mset[self::CONFIG_KEY_PREFIX.'configFlag'] = time();
249: 
250:         // 通过Redis缓存服务类设置新的配置项。
251:         $make->mset($mset);
252: 
253:         // 如果还有剩余的旧键，说明这些键已经不存在于新的配置中，需要从Redis中删除。
254:         if (count($oldKeys)) {
255:             $make->handler()->del(...array_values($oldKeys));
256:         }
257:         // 删除API配置的缓存，以便下次请求时重新从Redis获取最新配置。
258:         Cache::delete('get_api_config');
259:     }
260: 
