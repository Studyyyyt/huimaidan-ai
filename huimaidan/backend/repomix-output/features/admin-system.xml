 71:         }
 72:         // 是否为商圈代理角色
 73:         if (isset($where['is_agent']) && $where['is_agent'] !== '') {
 74:             $roleModel = $roleModel->where('is_agent', intval($where['is_agent']));
 75:         }
 76:         // 是否为商圈id
 77:         if (isset($where['circle_id']) && $where['circle_id'] !== '') {
 78:             $roleModel = $roleModel->where('circle_id', intval($where['circle_id']));
