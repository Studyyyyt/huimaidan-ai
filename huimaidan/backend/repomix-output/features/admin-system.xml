263:      *  清除缓存后需要重新增加缓存的配置
264:      * @author Qinii
265:      * @day 2023/10/20
266:      */
267:     public function special()
268:     {
269:         $list = $this->query([])->column('value,config_key,mer_id');
270:         foreach ($list as $item) {
271:             if (in_array($item['config_key'], $this->special)) {
272:                 Cache::set($item['config_key'], json_decode($item['value']));
273:             }
274:         }
275:     }
