 90:      * 获取超时记录ID列表
 91:      *
 92:      * 本函数用于查询并返回所有结果码为空且创建时间早于指定时间的短信记录的ID列表。
 93:      * 这样做的目的是为了后续可能的操作，比如清理这些超时记录，或者对这些记录进行进一步的分析处理。
 94:      *
 95:      * @param int $time 用于查询的截止时间，以时间戳形式表示。
 96:      * @return array 包含符合条件的短信记录ID的数组。
 97:      */
 98:     public function getTimeOutIds($time)
 99:     {
100:         // 使用SmsRecord类的getDB方法获取数据库实例，并链式调用where方法指定查询条件，最后调用column方法获取record_id列的值。
101:         return SmsRecord::getDB()->where('resultcode', null)->where('create_time', '<=', $time)->column('record_id');
102:     }
103: 
104: }
</file>

