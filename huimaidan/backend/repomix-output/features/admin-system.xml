417:     /**
418:      * 创建密码修改表单
419:      *
420:      * 本函数用于生成一个用于修改密码的表单。表单的行为根据用户类型的不同而有所不同。
421:      * 可以是系统管理员修改密码，也可以是商家管理员自己修改密码。
422:      *
423:      * @param int $id 用户ID，用于标识特定用户的密码修改操作。
424:      * @param int $userType 用户类型，定义了密码修改的操作范围。2表示商家管理员，其他值表示系统管理员。
425:      * @return Form|string
426:      */
427:     public function passwordForm(int $id, $userType = 2)
428:     {
429:         // 根据用户类型确定表单提交的行动
430:         $action = 'merchantAdminPassword';
431:         if ($userType == self::PASSWORD_TYPE_ADMIN) {
432:             $action = 'systemMerchantAdminPassword';
433:         } else if ($userType == self::PASSWORD_TYPE_SELF) {
434:             $action = 'merchantAdminEditPassword';
435:         }
436: 
437:         // 创建表单，包括密码和确认密码两个字段
438:         $form = Elm::createForm(Route::buildUrl($action, $userType == self::PASSWORD_TYPE_SELF ? [] : compact('id'))->build(), [
439:             $rules[] = Elm::password('pwd', '密码：')->placeholder('请输入密码')->required('请输入密码'),
440:             $rules[] = Elm::password('againPassword', '确认密码：')->placeholder('请输入确认密码')->required('请输入确认密码'),
441:         ]);
442: 
443:         // 设置表单标题为“修改密码”
444:         return $form->setTitle('修改密码');
445:     }
446: 
447:     /**
448:      * 创建并返回编辑管理员信息的表单
449:      *
450:      * 该方法通过Element UI的表单构建器生成一个用于编辑管理员信息的表单。表单包含了管理员姓名和联系电话两个必填字段。
451:      * 表单的提交地址是通过路由生成的管理员编辑地址。使用该表单可以方便地收集和验证管理员的更新信息。
452:      *
453:      * @param array $formData 管理员当前的信息数据，用于填充表单的默认值。
454:      * @return Form|\think\response\View
455:      */
456:     public function editForm(array $formData)
457:     {
458:         // 通过路由生成编辑管理员信息的URL，用于表单的提交动作
459:         $form = Elm::createForm(Route::buildUrl('merchantAdminEdit')->build());
460: 
461:         // 设置表单的验证规则，包括管理员姓名和联系电话两个字段
462:         $form->setRule([
463:             // 管理员姓名字段，必填，用于输入管理员的姓名
464:             Elm::input('merchant_admin_id', '管理员ID：')->disabled(true),
465:             Elm::input('real_name', '管理员姓名：')->placeholder('请输入管理员姓名')->required('请输入管理员姓名'),
466:             // 联系电话字段，用于输入管理员的联系电话
467:             Elm::input('phone', '联系电话：')->placeholder('请输入联系电话')
468:         ]);
469: 
470:         // 设置表单的标题为“修改信息”，并加载传入的管理员当前信息数据，用于表单显示
471:         return $form->setTitle('修改信息')->formData($formData);
472:     }
