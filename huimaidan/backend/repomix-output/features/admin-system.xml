254:      * @param string $domain
255:      * @param array $data
256:      * @return bool
257:      * @author Qinii
258:      * @day 2024/3/13
259:      */
260:     public function updateDomain(int $id, string $domain, array $data = [])
261:     {
262:         $info = $this->dao->get($id);
263:         if (!$info) {
264:             throw new ValidateException('数据不存在');
265:         }
266:         if ($info->domain != $domain) {
267:             $info->domain = $domain;
268:             $upload = UploadService::create($info->type);
269:             //是否添加过域名不存在需要绑定域名
270:             $domainList = $upload->getDomian($info->name, $info->region);
271:             $domainParse = parse_url($domain);
272:             if (false === $domainParse) {
273:                 throw new ValidateException('域名输入有误');
274:             }
275:             if (!in_array($domainParse['host'], $domainList)) {
276:                 //绑定域名到云储存桶
277:                 $res = $upload->bindDomian($info->name, $domain, $info->region);
278:                 if (false === $res) {
279:                     throw new ValidateException($upload->getError());
280:                 }
281:             }
282:             //七牛云需要通过接口获取cname
283:             if (2 === ((int)$info->type)) {
284:                 $resDomain = $upload->getDomianInfo($domain);
285:                 $info->cname = $resDomain['cname'] ?? '';
286:             }
287:             $info->save();
288:         }
289:         if ($info->cdn != $data['cdn']) {
290:             $info->cdn = $data['cdn'];
291:             $info->save();
292:         }
293:         return true;
294:     }
