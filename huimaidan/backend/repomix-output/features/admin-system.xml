 87:                 $query->whereIn('category_id', is_array($where['category_id']) ? $where['category_id'] : explode(',', $where['category_id']));
 88:             })
 89:             ->when(isset($where['type_id']) && $where['type_id'] !== '', function ($query) use ($where) {
 90:                 $query->whereIn('type_id', is_array($where['type_id']) ? $where['type_id'] : explode(',', $where['type_id']));
 91:             })
