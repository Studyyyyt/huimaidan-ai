213:     /**
214:      * 切换实体的状态。
215:      *
216:      * 本函数用于通过指定的ID和新的状态来更新数据库中相应实体的状态字段。
217:      * 它封装了与数据访问对象（DAO）的交互，使得业务逻辑层可以更方便地进行状态更新操作，
218:      * 而无需直接处理数据库层面的细节。
219:      *
220:      * @param int $id 实体的唯一标识符。用于在数据库中定位到特定的实体。
221:      * @param int $status 新的状态值。该值会被用于更新实体的状态字段。
222:      * @return mixed 返回DAO更新操作的结果。具体类型取决于DAO的实现。
223:      */
224:     public function switchStatus(int $id, int $status)
225:     {
226:         // 使用compact函数将$status变量打包成一个名为'status'的键值对数组，
227:         // 然后调用dao的update方法，通过$id更新数据库中的对应记录的状态。
228:         return $this->dao->update($id, compact('status'));
