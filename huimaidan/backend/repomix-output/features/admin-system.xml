238:     /**
239:      * 管理员登录方法
240:      *
241:      * 本方法用于处理管理员的登录逻辑。首先，它触发一个登录前的事件，允许任何监听者对此过程进行干预。
242:      * 接着，它验证管理员账号和密码是否正确。如果登录信息不正确，会记录登录失败次数，并抛出一个验证异常。
243:      * 如果账号存在但被禁用，也会抛出一个验证异常。如果账号验证成功，更新管理员的登录信息，如最后登录时间、IP和登录次数，
244:      * 并触发一个登录成功的事件。最后，返回管理员信息。
245:      *
246:      * @param string $account 管理员账号
247:      * @param string $password 管理员密码
248:      * @return array|object
249:      * @throws ValidateException 如果登录失败或账号被禁用
250:      */
251:     public function login(string $account, string $password)
252:     {
253:         // 触发登录前的事件，允许进行额外的验证或操作
254:         event('admin.login.before',compact('account','password'));
255: 
256:         // 根据管理员账号查询管理员信息
257:         $adminInfo = $this->dao->accountByAdmin($account);
258:         // 验证管理员信息是否存在
259:         if(!$adminInfo){
260:             throw new ValidateException('账号不存在，请检查');
261:         }
262:         // 密码是否正确
263:         if (!password_verify($password, $adminInfo->pwd)){
264:             // 记录登录失败次数，防止恶意登录尝试
265:             $key = 'sys_login_failuree_'.$account;
266:             $numb = Cache::get($key) ?? 0;
267:             $numb++;
268:             Cache::set($key,$numb,15*60);
269:             throw new ValidateException('账号或密码错误');
270:         }
271:         // 检查管理员账号是否被禁用
272:         if ($adminInfo['status'] != 1) {
273:             throw new ValidateException('账号已关闭');
274:         }
275:         // 更新管理员的登录信息
276:         $adminInfo->last_time = date('Y-m-d H:i:s');
277:         $adminInfo->last_ip = app('request')->ip();
278:         $adminInfo->login_count++;
279:         $adminInfo->save();
280: 
281:         // 触发登录成功的事件，允许进行额外的操作，如记录日志等
282:         event('admin.login',compact('adminInfo'));
283: 
284:         // 返回管理员信息
285:         return $adminInfo;
286:     }
287: 
288:     /**
289:      * 登录尝试次数限制
290:      * @param $account
291:      * @param int $number
292:      * @param int $n
293:      * @author Qinii
294:      * @day 7/6/21
295:      */
296:     public function loginFailure($account,$number = 5,$n = 3)
297:     {
298:         $key = 'sys_login_failuree_'.$account;
299:         $numb = Cache::get($key) ?? 0;
300:         $numb++;
301:         if($numb >= $number){
302:             $fail_key = 'sys_login_freeze_'.$account;
303:             Cache::tag('sys_login_freeze')->set($fail_key,1,15*60);
304:             throw new ValidateException('账号或密码错误次数太多，请稍后在尝试');
305:         }else{
306:             Cache::tag('sys_login_freeze')->set($key,$numb,5*60);
307:             $msg = '账号或密码错误';
308:             $_n = $number - $numb;
309:             if($_n <= $n){
310:                 $msg .= ',还可尝试'.$_n.'次';
311:             }
312:             throw new ValidateException($msg);
313:         }
314:     }
315: 
316:     /**
317:      * 缓存管理员令牌
318:      *
319:      * 本函数用于缓存管理员的登录令牌，以便在后续请求中验证管理员的身份。
320:      * 令牌的缓存时间由$exp参数指定，单位为秒。缓存机制能够减少数据库的访问频率，
321:      * 提高系统性能，尤其是在高并发的场景下。
322:      *
323:      * @param string $token 管理员的登录令牌
324:      * @param int $exp 令牌的过期时间，单位为秒
325:      */
326:     public function cacheToken(string $token, int $exp)
327:     {
328:         // 通过键名'admin_'和当前时间加上过期时间来设置令牌的缓存
329:         Cache::set('admin_' . $token, time() + $exp, $exp);
330:     }
331: 
332:     /**
333:      * 检查管理员的令牌是否有效。
334:      *
335:      * 本函数通过验证令牌是否存在以及是否过期来确保管理员的会话仍然有效。
336:      * 如果令牌不存在或已过期，则抛出一个授权异常。
337:      *
338:      * @param string $token 管理员的令牌。这是用于验证管理员身份的唯一字符串。
339:      * @throws AuthException 如果令牌无效或已过期，则抛出此异常。
340:      */
341:     public function checkToken(string $token)
342:     {
343:         // 检查令牌是否存在于缓存中
344:         $has = Cache::has('admin_' . $token);
345:         // 如果令牌不存在，则抛出授权异常
346:         if (!$has)
347:             throw new AuthException('无效的token');
348: 
349:         // 获取令牌的最后活动时间
350:         $lastTime = Cache::get('admin_' . $token);
351:         // 检查令牌是否过期，如果过期，则抛出授权异常
352:         if (($lastTime + (intval(Config::get('admin.token_valid_exp', 15))) * 60) < time())
353:             throw new AuthException('token 已过期，请重新登录');
354:     }
355: 
356:     /**
357:      * 更新管理员令牌的缓存
358:      *
359:      * 本函数用于更新管理员令牌的缓存时间。令牌的缓存时间基于配置文件中设定的令牌有效时长，
360:      * 默认为15分钟。通过将令牌的缓存时间设置为当前时间，可以确保令牌在一段时间内保持有效。
361:      * 这对于维护会话状态和确保安全性非常重要。
362:      *
363:      * @param string $token 管理员的令牌字符串。这是用于标识和验证管理员身份的唯一令牌。
364:      */
365:     public function updateToken(string $token)
366:     {
367:         // 根据管理员令牌生成缓存键，并设置缓存时间为配置的令牌有效时长（默认为15分钟）。
368:         Cache::set('admin_' . $token, time(), intval(Config::get('admin.token_valid_exp', 15)) * 60);
369:     }
370: 
371:     /**
372:      * 清除指定的管理员令牌
373:      *
374:      * 本函数用于从缓存中删除指定的管理员令牌，以实现登出功能或令牌失效。
375:      * 通过删除令牌，可以确保之前的登录状态被正确终止，防止未授权的访问。
376:      *
377:      * @param string $token 需要清除的管理员令牌
378:      */
379:     public function clearToken(string $token)
380:     {
381:         // 根据管理员令牌生成缓存键，并删除该缓存项
382:         Cache::delete('admin_' . $token);
383:     }
384: 
385:     /**
386:      * 创建管理员令牌
387:      *
388:      * 本函数用于生成管理员的JWT令牌，该令牌用于管理员的身份验证。
389:      * 它通过JwtTokenService创建令牌，并将令牌及其过期时间存储到缓存中。
390:      *
391:      * @param Admin $admin 管理员对象，包含管理员的身份信息。
392:      * @return array 返回包含令牌和过期时间的数组。
393:      */
394:     public function createToken(Admin $admin)
395:     {
396:         // 实例化JWT令牌服务类
397:         $service = new JwtTokenService();
398: 
399:         // 从配置中获取管理员令牌的过期时间，默认为3小时
400:         $exp = intval(Config::get('admin.token_exp', 3));
401: 
402:         // 使用JwtTokenService创建令牌，指定管理员ID、类型为'admin'，以及过期时间
403:         $token = $service->createToken($admin->admin_id, 'admin', strtotime("+ {$exp}hour"));
404: 
405:         // 将生成的令牌及其过期时间存储到缓存中
406:         $this->cacheToken($token['token'], $token['out']);
407: 
408:         // 返回生成的令牌信息
409:         return $token;
410:     }
411: 
412:     /**
413:      * 检测验证码
414:      * @param string $key key
415:      * @param string $code 验证码
416:      * @author 张先生
417:      * @date 2020-03-26
418:      */
419:     public function checkCode(string $key, string $code)
420:     {
421:         if (!env('DEVELOPMENT',false)) {
422:             $_code = Cache::get('am_captcha' . $key);
423:             if (!$_code) {
424:                 throw new ValidateException('验证码过期');
425:             }
426: 
427:             if (strtolower($_code) != strtolower($code)) {
428:                 throw new ValidateException('验证码错误');
429:             }
430: 
431:             //删除code
432:             Cache::delete('am_captcha' . $key);
433:         }
434:     }
435: 
436:     /**
437:      * 创建登录验证码键
438:      *
439:      * 本函数用于生成一个唯一的登录验证码键，并将该验证码与键关联起来存储在缓存中。
440:      * 验证码键的生成结合了微秒时间和随机数，以确保唯一性。
441:      * 验证码在缓存中的有效期通过配置文件设定，以分钟为单位。
442:      *
443:      * @param string $code 登录验证码
444:      * @return string 生成的验证码键
445:      */
446:     public function createLoginKey(string $code)
447:     {
448:         // 生成一个唯一的验证码键，基于当前微秒时间戳和随机数
449:         $key = uniqid(microtime(true), true);
450: 
451:         // 将验证码与键关联，存储到缓存中，并设定过期时间
452:         // 缓存有效期通过配置文件获取，默认为5分钟
453:         Cache::set('am_captcha' . $key, $code, Config::get('admin.captcha_exp', 5) * 60);
454: 
455:         // 返回生成的验证码键
456:         return $key;
457:     }
458: }
