159:         $rest = $this->dao->search($merId, ['role_ids' => $role,'status' => 1])->column('role_id');
160: 
161:         // 对传入的角色数组和查询结果进行排序，以便后续比较。
162:         sort($role);
163:         sort($rest);
164: 
165:         // 比较排序后的角色数组和查询结果数组是否完全相同。
166:         // 使用sort函数的返回值进行比较，如果相同则返回true，否则返回false。
167:         return (sort($role) == sort($rest)) ?  true: false;
168:     }
169: }
