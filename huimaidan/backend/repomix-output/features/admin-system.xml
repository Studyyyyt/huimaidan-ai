42: 
43:     /**
44:      * @param array $where
45:      * @param $merId
46:      * @return BaseQuery
47:      * @author xaboy
48:      * @day 2020-04-16
49:      */
50:     /**
51:      * 根据条件搜索日志记录
52:      *
53:      * 本函数用于查询特定条件下的日志记录。它支持多个查询条件，包括商家ID、日期、操作方法、管理员ID以及创建时间范围。
54:      * 通过灵活组合这些条件，可以精确地定位到特定的日志数据。
55:      *
56:      * @param array $where 查询条件数组，包含各种可能的搜索参数。
57:      * @param int $merId 商家ID，用于限定查询的日志所属商家。
58:      * @return \Illuminate\Database\Query\Builder|BaseQuery
59:      */
60:     public function search(array $where, $merId)
61:     {
62:         // 初始化查询，指定查询商家ID为$merId的日志数据
63:         $query = Log::getDB()->where('mer_id', $merId);
64: 
65:         // 如果指定了查询日期，则进一步限定查询日期范围
66:         $query->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
67:             // 调用辅助函数处理日期查询条件
68:             getModelTime($query, $where['date']);
69:         });
70: 
71:         // 如果指定了操作方法，则进一步限定查询特定操作方法的日志
72:         if (isset($where['method']) && $where['method'] !== '') {
73:             $query->where('method', $where['method']);
74:         }
75: 
76:         // 如果指定了管理员ID，则进一步限定查询特定管理员操作的日志
77:         if (isset($where['admin_id']) && $where['admin_id'] !== '') {
78:             $query->where('admin_id', $where['admin_id']);
79:         }
80:         // 如果指定了管理员ID，则进一步限定查询特定管理员操作的日志
81:         if (isset($where['keyword']) && $where['keyword'] !== '') {
