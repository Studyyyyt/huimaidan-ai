268:             $formData['config_classify_id'] = (int)$cid;
269:         }
270:         $form = Elm::createForm(is_null($id) ? Route::buildUrl('configSettingCreate')->build() : Route::buildUrl('configSettingUpdate', ['id' => $id])->build());
271:         $rule = [
272:             Elm::cascader('config_classify_id', '上级分类：')->options(function () use
273:             ($configClassifyRepository){
274:                 return array_merge([['value' => 0, 'label' => '请选择']], $configClassifyRepository->options());
275:             })->placeholder('请选择上级分类')->props(['props' => ['checkStrictly' => true, 'emitPath' => false]]),
276:             Elm::select('user_type', '后台类型：', 0)->options([
277:                 ['label' => '总后台配置', 'value' => 0],
278:                 ['label' => '商户后台配置', 'value' => 1],
279:             ])->requiredNum('请选择后台类型'),
280:             Elm::input('config_name', '配置名称：')->placeholder('请输入配置名称')->required('请输入配置名称')->appendRule('suffix', [
281:                 'type' => 'div',
282:                 'style' => ['color' => 'red'],
283:                 'domProps' => [
284:                     'innerHTML' =>'配置联动显示选项，需从[ 配置分类 ]菜单中的[ 配置列表 ]进入配置页',
285:                 ]
286:             ]),
287:         ];
288:         if ($cid) {
289:             $rule[] = Elm::radio('linked_status', '联动显示：', 0)->options([
290:                 ['label' => '否', 'value' => 0],
291:                 ['label' => '是', 'value' => 1],
292:             ])->control([
293:                 // 当选择未通过状态时，显示未通过原因的文本区域
294:                 ['value' => 1, 'rule' => [
295:                     Elm::cascader('linked_data', '上级联动：')
296:                         ->options($linkData)
297:                         ->props(['props' => ['multiple' => false, 'checkStrictly' => false, 'emitPath' => true]])
298:                         ->placeholder('请选择上级分类')
299:                 ]]
300:             ])->appendRule('suffix', [
301:                 'type' => 'div',
302:                 'style' => ['color' => '#999999'],
303:                 'domProps' => [
304:                     'innerHTML' =>'否：默认正常展示此配置；是：此配置默认隐藏，当选中下方对应配置的值时，此配置才会显示',
305:                 ]
306:             ]);
307:         }
308:         $rule = array_merge($rule, [
309:             Elm::input('config_key', '配置key：')->placeholder('请输入配置key')->required('请输入配置key'),
310:             Elm::textarea('info', '说明：')->placeholder('请输入说明'),
311:             Elm::select('config_type', '配置类型：')->options(function () {
312:                 $options = [];
313:                 foreach (self::TYPES as $value => $label) {
314:                     $options[] = compact('value', 'label');
315:                 }
316:                 return $options;
317:             })->placeholder('请选择配置类型')->required('请选择配置类型'),
318:             Elm::textarea('config_rule', '选择项：')->placeholder('请输入选择项'),
319:             Elm::textarea('config_props', '配置：')->placeholder('请输入配置'),
320:             Elm::number('sort', '排序：', 0)->precision(0)->max(99999),
321:             Elm::switches('required', '必填：', 0)->activeValue(1)->inactiveValue(0)->inactiveText('关闭')->className('switch-width-double')->activeText('开启'),
322:             Elm::switches('status', '是否显示：', 1)->activeValue(1)->inactiveValue(0)->inactiveText('关闭')->className('switch-width-double')->activeText('开启'),
323:         ]) ;
324:         $form->setRule($rule);
325:         return $form->setTitle(is_null($id) ? '添加配置' : '编辑配置')->formData($formData);
326:     }
