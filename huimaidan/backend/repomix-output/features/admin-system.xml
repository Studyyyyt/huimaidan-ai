 48:     }
 49: 
 50:     /**
 51:      * 获取角色列表
 52:      *
 53:      * 根据给定的条件数组$where，分页获取角色列表。每页包含$limit个角色。
 54:      * 返回包含角色列表和总角色数量的数据数组。
 55:      *
 56:      * @param array $where 查询条件数组
 57:      * @param int $page 当前页码
 58:      * @param int $limit 每页的角色数量
 59:      * @return array 包含角色列表和总角色数量的数组
 60:      */
 61:     public function getList(array $where, $page, $limit)
 62:     {
 63:         // 根据条件查询角色信息
 64:         $query = $this->dao->search($where);
 65: 
 66:         // 计算满足条件的角色总数量
 67:         $count = $query->count();
 68: 
 69:         // 获取当前页的角色列表，隐藏某些字段，并进行分页
 70:         $list = $query->page($page, $limit)->hidden(['pwd', 'is_del', 'update_time'])->select()->append(['region_name']);
 71: 
 72:         // 遍历角色列表，为每个角色添加角色名
 73:         foreach ($list as $k => $role) {
 74:             $list[$k]['rule_name'] = $role->roleNames();
 75:         }
 76: 
 77:         // 返回角色列表和总数量
 78:         return compact('list', 'count');
 79:     }
