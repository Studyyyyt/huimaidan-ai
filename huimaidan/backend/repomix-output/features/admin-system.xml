 253:     public function updateForm($id)
 254:     {
 255:         // 通过ID获取数据库中的数据，并转换为数组格式。
 256:         $data = $this->dao->get($id)->toArray();
 257: 
 258:         // 通过依赖注入获取MerchantAdminRepository实例，用于后续操作。
