 13: 
 14: namespace app\common\dao\system\groupData;
 15: 
 16: 
 17: use app\common\dao\BaseDao;
 18: use app\common\model\BaseModel;
 19: use app\common\model\system\groupData\SystemGroupData;
 20: use think\db\BaseQuery;
 21: use think\db\exception\DataNotFoundException;
 22: use think\db\exception\DbException;
 23: use think\db\exception\ModelNotFoundException;
 24: use think\Model;
 25: 
 26: /**
 27:  * Class GroupDataDao
 28:  * @package app\common\dao\system\groupData
 29:  * @author xaboy
 30:  * @day 2020-03-27
 31:  */
 32: class GroupDataDao extends BaseDao
 33: {
 34: 
 35:     /**
 36:      * @return BaseModel
 37:      * @author xaboy
 38:      * @day 2020-03-30
 39:      */
 40:     protected function getModel(): string
 41:     {
 42:         return SystemGroupData::class;
 43:     }
 44: 
 45:     /**
 46:      * 根据商家ID和分组ID获取分组数据
 47:      *
 48:      * 本函数旨在查询特定商家和分组对应的系统分组数据。通过指定商家ID和分组ID，
 49:      * 可以从数据库中检索出相应的分组数据，并以特定的排序方式返回。
 50:      *
 51:      * @param int $merId 商家ID，用于指定查询的商家范围
 52:      * @param int $groupId 分组ID，用于指定查询的分组范围
 53:      * @return BaseQuery 返回查询结果的对象，该对象可用于进一步的查询操作或数据获取
 54:      */
 55:     public function getGroupDataWhere($merId, $groupId): BaseQuery
 56:     {
 57:         // 使用SystemGroupData类的getDB方法获取数据库操作对象
 58:         // 并通过withAttr方法处理'value'字段，将其JSON格式化为数组
 59:         // 然后通过where方法指定查询条件：商家ID和分组ID
 60:         // 最后，通过order方法指定查询结果的排序方式为降序排序
 61:         return SystemGroupData::getDB()->withAttr('value', function ($val) {
 62:             // 这里对'value'字段进行JSON解码，以便后续处理
 63:             return json_decode($val, true);
 64:         })->where('mer_id', $merId)->where('group_id', $groupId)->order('sort DESC');
 65:     }
 66: 
 67:     /**
 68:      * 根据商家ID和分组ID获取分组数据信息。
 69:      *
 70:      * 本函数用于查询系统分组数据中，特定商家和特定分组的相关数据。
 71:      * 它支持分页查询，并返回经过处理的分组数据数组，每个元素包含分组数据ID、商家ID以及其他解码后的分组数据内容。
 72:      *
 73:      * @param string $merId 商家ID，用于限定查询的商家范围。
 74:      * @param string $groupId 分组ID，用于限定查询的分组范围。
 75:      * @param int $page 查询的页码，可选参数，用于分页查询。
 76:      * @param int $limit 每页的数据条数，可选参数，默认为10条。
 77:      * @return array 返回查询结果数组，每个元素包含分组数据的详细信息。
 78:      */
 79:     public function getGroupData($merId, $groupId, ?int $page = null, ?int $limit = 10)
 80:     {
 81:         // 构建查询条件，查询指定商家ID、分组ID，并且状态为启用的分组数据。
 82:         $query = SystemGroupData::getDB()
 83:             ->where('mer_id', $merId)
 84:             ->where('group_id', $groupId)
 85:             ->where('status', 1)
 86:             ->order('sort DESC,group_data_id ASC');
 87: 
 88:         // 如果指定了页码，则进行分页查询。
 89:         if (!is_null($page)) {
 90:             $query->page($page, $limit);
 91:         }
 92: 
 93:         // 初始化分组数据数组。
 94:         $groupData = [];
 95: 
 96:         // 遍历查询结果，对每个分组数据进行处理，包括解码和添加额外字段。
 97:         foreach ($query->column('value,mer_id', 'group_data_id') as $k => $v) {
 98:             // 解码分组数据值，并合并分组数据ID和商家ID到结果中。
 99:             $groupData[] = json_decode($v['value'], true) + ['group_data_id' => $k, 'group_mer_id' => $v['mer_id']];
100:         }
101: 
102:         // 返回处理后的分组数据数组。
103:         return $groupData;
104:     }
105: 
106:     /**
107:      * 根据ID和状态获取数据
108:      *
109:      * 本函数用于从系统分组数据表中检索特定ID和可选状态的数据。它允许灵活地查询数据，
110:      * 既可以获取所有状态的数据，也可以根据特定状态进行筛选。
111:      *
112:      * @param int $id 数据ID，用于精确匹配数据行。
113:      * @param string|null $status 数据的状态，可选参数，用于按状态筛选数据。
114:      * @return mixed 返回查询结果，如果未找到数据则返回null。返回的数据包括'group_data_id'和'group_mer_id'，
115:      *               以及查询结果中的'value'字段，方便调用方直接使用。
116:      */
117:     public function getData($id,$status = null)
118:     {
119:         // 初始化查询条件，指定数据ID
120:         $where['group_data_id'] = (int)$id;
121:         // 如果提供了状态参数，则添加到查询条件中
122:         if (!is_null($status)) $where['status'] = $status;
123:         // 执行查询，根据条件获取第一条数据
124:         $res = SystemGroupData::getDB()->where($where)->find();
125:         // 如果查询结果为空，则返回null
126:         if (!$res) return null;
127:         // 返回查询结果，附加'group_data_id'和'group_mer_id'字段，方便调用方使用
128:         return $res['value'] + ['group_data_id' => $res['group_data_id'], 'group_mer_id' => $res['mer_id']];
129:     }
130: 
131:     /**
