 58:      */
 59:     public function getNoticeStatusByConstKey(string $key)
 60:     {
 61:         // 通过常量键查询数据库，获取指定通知设置项的通知状态
 62:         $value = $this->getModel()::getDb()->where('const_key',$key)->field('notice_sys,notice_wechat,notice_routine,notice_sms')->find();
 63:         return $value;
 64:     }
 65: 
 66:     /**
 67:      * 根据条件搜索通知记录
 68:      *
 69:      * 本函数用于构建查询通知记录的数据库查询条件。它支持通过不同渠道的通知状态进行筛选，
 70:      * 包括短信、常规任务和微信通知。查询条件根据传入的$where参数动态构建，只包含有实际筛选需求的条件。
 71:      * 这种设计提高了查询的灵活性和效率，避免了不必要的数据库查询操作。
 72:      *
 73:      * @param array $where 查询条件数组，包含可能的筛选条件：is_sms, is_routine, is_wechat
 74:      * @return \yii\db\Query 查询对象，包含了根据条件构建的查询条件
