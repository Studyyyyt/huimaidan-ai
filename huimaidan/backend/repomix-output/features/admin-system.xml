196:         if ($type == $this->service::STORAGE_TENGXUN && !$config['tengxun_appid']) {
197:             $ruleConfig[] = Elm::input('tengxun_appid', 'APPID：')->placeholder('请输入APPID')->required('请输入APPID');
198:         }
199: 
200:         // 定义表单的基本规则，包括空间名称、区域和读写权限的选择
201:         $rule = [
202:             Elm::input('name', '空间名称')->required('请输入空间名称')->min(5),
203:             Elm::select('region', '空间区域')->options($upload->getRegion())->required('请选择空间区域'),
204:             Elm::radio('acl', '读写权限', 'public-read')->options([
205:                 ['label' => '公共读(推荐)', 'value' => 'public-read'],
206:                 ['label' => '公共读写', 'value' => 'public-read-write'],
207:             ])->required('请选择读写权限'),
