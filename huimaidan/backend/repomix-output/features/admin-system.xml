632:                 $this->mark .= $this->buildLogMark(($update_infos['is_bro_goods'] == 1 ? '打开了' : '关闭了'), '直播间商品审核');
633:             }
634: 
635:             $this->createLog();
636:         }
637: 
638:         if ($merchant['status'] != $update_infos['status']) {
639:             $this->category = self::PLATFORM_EDIT_MERCHANT_AUDIT_STATUS;
640:             $this->mark = $this->buildLogMark(($update_infos['status'] == 1 ? '打开了' : '关闭了'), '商户');
641:             $this->createLog();
642:         }
643: 
644:         return true;
645:     }
