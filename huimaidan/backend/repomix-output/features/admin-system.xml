356: 
357:     /**
358:      * 获取服务订单列表
359:      *
360:      * 根据给定的条件和分页参数，从数据库中检索服务订单列表。此方法专注于查询操作，不涉及数据的增删改。
361:      *
362:      * @param array $where 查询条件，允许通过数组传递多个条件。
363:      * @param int $page 当前页码，用于分页查询。
364:      * @param int $limit 每页的记录数，用于分页查询。
365:      * @return array 返回包含订单总数和订单列表的数组。
366:      */
367:     public function getList(array $where, int $page, int $limit)
368:     {
369:         // 默认不查询已删除的订单
370:         $where['is_del'] = 0;
371: 
372:         // 构建查询语句，包括关联查询和排序
373:         $query = $this->dao->search($where)
374:             ->with([
