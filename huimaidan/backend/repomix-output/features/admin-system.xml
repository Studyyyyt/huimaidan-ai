231:     /**
232:      * 根据表单规则获取配置ID
233:      *
234:      * 本函数主要用于根据给定的系统配置分类和商家ID，通过特定的逻辑
235:      * 获取相应的配置ID。此过程涉及查询配置数据库并根据条件组装返回的数据。
236:      *
237:      * @param SystemConfigClassify $configClassify 系统配置分类对象，包含配置分类ID
238:      * @param int $merId 商家ID，用于确定是系统配置还是商家配置
239:      * @return mixed 返回根据表单规则处理后的配置数据
240:      */
241:     public function cidByFormRule(SystemConfigClassify $configClassify, int $merId)
242:     {
243:         // 根据配置分类ID和商家ID（0代表系统配置）查询配置信息
244:         $config = $this->dao->cidByConfig($configClassify->config_classify_id, $merId == 0 ? 0 : 1);
245:         // 获取查询到的配置项的键名集合
246:         $keys = $config->column('config_key');
247: 
248:         // 组装并返回表单规则数据，包括配置ID、分类、配置项及对应的值
249:         $formData = app()->make(ConfigValueRepository::class)->more($keys, $merId);
250:         return $this->formRule($merId, $configClassify, $config->toArray(), $formData);
