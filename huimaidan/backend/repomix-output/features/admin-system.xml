768:     /**
769:      * 获取指定类型的域名列表
770:      *
771:      * 本函数用于查询并返回指定上传类型对应的域名列表。如果未指定类型，则根据系统配置的默认上传类型获取。
772:      * 主要用于支持多域名配置下的文件上传服务，使得可以灵活切换不同的域名进行文件访问。
773:      *
774:      * @param int|null $type 上传类型标识，null表示使用系统默认上传类型。
775:      * @return array 域名列表，如果没有找到任何域名则返回空数组。
776:      */
777:     public function domains(?int $type)
778:     {
779:         // 如果未指定上传类型，则使用系统配置的默认上传类型
780:         $type = $type ?: (systemConfig('upload_type') ?: 1);
781: 
782:         // 查询数据库，获取指定类型且未被删除的域名列表
783:         $domain = $this->dao->getSearch([])->where(['type' => $type,'is_del' => 0])->where('domain','>',0)->column('domain');
784: 
785:         // 返回查询结果，如果结果为空则返回空数组
786:         return $domain ?: [];
787:     }
788: }
