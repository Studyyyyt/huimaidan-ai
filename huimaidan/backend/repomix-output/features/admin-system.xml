 55:      * @param int $is_mer 菜单类型标志，0 表示普通菜单，非0表示商家菜单。
 56:      * @return \think\db\Query 返回一个查询对象，该对象可用于进一步的查询操作或获取查询结果。
 57:      */
 58:     public function search(array $where, int $is_mer = 0)
 59:     {
 60:         // 初始化查询对象，指定查询条件为 'is_mer' 字段等于 $is_mer，并按 'sort' 字段降序，'menu_id' 字段升序排序
 61:         $query = Menu::getDB()->where('is_mer', $is_mer)->order('sort DESC,menu_id ASC');
