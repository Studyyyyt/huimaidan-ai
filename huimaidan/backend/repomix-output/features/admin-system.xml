231:         // 通过模型获取数据库实例，并构造查询条件，查询满足mer_id和主键$id的记录数量。
232:         // 如果记录数量大于0，则表示存在对应的记录，返回true；否则返回false。
233:         return ($this->getModel())::getDB()->where('mer_id', $merId)->where($this->getPk(), $id)->count() > 0;
234:     }
