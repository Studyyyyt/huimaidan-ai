 83: 
 84:     /**
 85:      * 删除操作，用于删除指定ID的数据，并清理相关的关联数据。
 86:      *
 87:      * @param int $id 需要删除的数据的ID。
 88:      * @return bool 删除操作的结果，true表示成功，false表示失败。
 89:      */
 90:     public function delete(int $id)
 91:     {
 92:         // 使用事务处理来确保删除操作和相关清理操作的原子性。
 93:         return Db::transaction(function () use ($id) {
 94:             // 删除指定ID的数据。
 95:             $this->dao->delete($id);
 96:             // 清理与该ID关联的商家类型ID。
 97:             app()->make(MerchantRepository::class)->clearTypeId($id);
 98:             // 批量删除与该ID相关的认证关联数据。
 99:             app()->make(RelevanceRepository::class)->batchDelete($id, RelevanceRepository::TYPE_MERCHANT_AUTH);
100:         });
101:     }
