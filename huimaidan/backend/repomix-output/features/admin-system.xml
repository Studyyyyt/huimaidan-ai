140: 
141:     /**
142:      * 更新商户信息并同步更新权限关系。
143:      *
144:      * 本函数通过事务处理方式，确保更新商户信息和关联权限的操作一致性。
145:      * 具体步骤包括：
146:      * 1. 更新商户的基本信息；
147:      * 2. 删除旧的商户权限关联；
148:      * 3. 添加新的商户权限关联；
149:      * 4. 更新商户的保证金状态。
150:      *
151:      * @param int $id 商户ID。
152:      * @param array $data 商户更新的数据，包括基本信息和权限信息。
153:      * @return bool 更新操作是否成功的标志。
154:      */
155:     public function update(int $id, array $data)
156:     {
157:         return Db::transaction(function () use ($id, $data) {
158:             // 过滤并去重权限数组
159:             $auth = array_filter(array_unique($data['auth']));
160: 
161:             // 从更新数据中移除权限信息
162:             unset($data['auth']);
163: 
164:             // 准备新的权限关联数据
165:             $inserts = [];
166:             foreach ($auth as $aid) {
167:                 $inserts[] = [
168:                     'left_id' => $id,
169:                     'right_id' => (int)$aid,
170:                     'type' => RelevanceRepository::TYPE_MERCHANT_AUTH
171:                 ];
172:             }
173: 
174:             // 设置更新时间
175:             $data['update_time'] = date('Y-m-d H:i:s',time());
176: 
177:             // 更新商户基本信息
178:             $this->dao->update($id, $data);
179: 
180:             // 实例化关联仓库，用于处理权限关联的增删操作
181:             $make = app()->make(RelevanceRepository::class);
182: 
183:             // 删除旧的权限关联
184:             $make->batchDelete($id, RelevanceRepository::TYPE_MERCHANT_AUTH);
185: 
186:             // 插入新的权限关联
187:             $make->insertAll($inserts);
188: 
189:             // 更新商户的保证金状态
190:             // 更新未交保证金的商户
191:             app()->make(MerchantRepository::class)->updateMargin($id, $data['margin'], $data['is_margin']);
192:         });
193:     }
