1299:         $data = $this->dao->search(['margin' => 10])->whereRaw('ot_margin > margin')->select();
1300: 
1301:         // 遍历查询结果，对每个商家进行状态检查和调整
1302:         foreach ($data as $datum) {
1303:             // 如果商家未设置过保证金提醒时间
1304:             if (is_null($datum->margin_remind_time)) {
1305:                 // 如果设置了提醒天数，则计算提醒时间，并设置商家的margin_remind_time
1306:                 if($day) {
