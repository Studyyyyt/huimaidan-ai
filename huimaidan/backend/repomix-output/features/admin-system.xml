227:         return Menu::getDB()->where('is_menu', 1)->where('is_show', 1)->order('sort DESC,menu_id ASC')->where('is_mer', $is_mer)
228:             ->whereIn('menu_id', array_unique(array_filter($ids)))
229:             ->column('menu_name title,route path,params,icon,pid,menu_id id');
