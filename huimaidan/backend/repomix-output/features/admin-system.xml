186:     /**
187:      * 设置商家配置数据
188:      * 该方法用于批量更新或插入商家的配置信息。它首先检查每个配置项是否已存在，如果存在，则更新其值；如果不存在，则创建新的配置项。
189:      * 使用数据库事务确保操作的原子性。
190:      *
191:      * @param array $formData 商家配置的数据数组，键值对形式，其中键是配置项的键，值是配置项的值。
192:      * @param int $merId 商家的ID，用于标识商家。
193:      */
194:     public function setFormData(array $formData, int $merId)
195:     {
196:         // 开启数据库事务处理
197:         Db::transaction(function () use ($merId, $formData) {
198:             // 遍历配置数据数组
199:             foreach ($formData as $key => $value) {
200:                 // 检查当前配置项是否已存在
201:                 if ($this->dao->merExists($key, $merId)) {
202:                     // 如果已存在，则更新配置项的值
203:                     $this->dao->merUpdate($merId, $key, ['value' => $value]);
204:                 } else {
205:                     // 如果不存在，则创建新的配置项
206:                     $this->dao->create([
207:                         'mer_id' => $merId,
208:                         'value' => $value,
209:                         'config_key' => $key
210:                     ]);
211:                 }
212:             }
213:         });
214:         // 同步配置信息到其他系统或缓存
215:         $this->syncConfig();
216:     }
