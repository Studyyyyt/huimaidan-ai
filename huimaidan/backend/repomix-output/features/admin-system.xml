 99:      * @return \think\Collection
100:      * @author Qinii
101:      * @day 4/20/22
102:      */
103:     public function getAllRecommendAttr()
104:     {
105:         $list = Product::where('mer_id', $this['mer_id'])
106:             ->with(['reservation','merchant'])
107:             ->where((new ProductDao())->productShow())
108:             ->field('mer_id,product_id,store_name,image,price,is_show,status,is_gift_bag,is_good,cate_id,activity_label_ids,delivery_free,give_coupon_ids,delivery_way,type,product_type')
109:             ->order('is_good DESC, sort DESC, create_time DESC')
110:             ->limit(10)
111:             ->select()->append(['show_svip_info','activity_labels']);
112:         if ($list) {
113:             $list = app()->make(StoreActivityRepository::class)->getPic($list->toArray(),StoreActivityRepository::ACTIVITY_TYPE_BORDER);
114:         }
115:        return $list;
116:     }
117: 
118:     public function getCityRecommendAttr()
119:     {
120:         $list = Product::where('mer_id', $this['mer_id'])
121:             ->with(['reservation','merchant'])
122:             ->where((new ProductDao())->productShow())
123:             ->whereLike('delivery_way',"%1%")
124:             ->field('mer_id,product_id,store_name,image,price,is_show,status,is_gift_bag,is_good,cate_id,activity_label_ids,delivery_free,give_coupon_ids,delivery_way,type,product_type')
125:             ->order('sort DESC, create_time DESC')
126:             ->limit(3)
127:             ->select()->append(['activity_labels']);
128:         if ($list) {
129:             $list = app()->make(StoreActivityRepository::class)->getPic($list->toArray(),StoreActivityRepository::ACTIVITY_TYPE_BORDER);
130:         }
131:         return $list;
