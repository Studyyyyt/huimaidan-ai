308:     /**
309:      * 根据给定的数据生成命令行菜单。
310:      * 该方法主要用于处理系统（sys）和商户（mer）类型的菜单数据，通过给定的菜单标识符，从数据库中获取菜单的父ID，
311:      * 如果不存在，则尝试创建一个新的菜单项。
312:      *
313:      * @param string $type 菜单的类型，决定是系统菜单还是商户菜单。
314:      * @param array $data 菜单数据，包含需要处理的菜单标识符及其对应显示名称。
315:      * @param string $prompt命令行提示信息，用于优化用户交互体验。
316:      * @return int 返回处理的菜单项数量。
317:      */
318:     public function commandMenu($type, $data, $prompt)
319:     {
320:         $res = [];
321:         // 根据type设置是否为菜单的标志
322:         // 平台
323:         $isMer = 0;
324:         $isAgent = 0;
325:         // 店铺
326:         if($type == 'mer') {
327:             $isMer = 1;
328:         }
329:         // 区域
330:         if($type == 'region') {
331:             $isAgent = 1;
332:         }
333:         // 商户
334:         if ($type == 'business') {
335:             $isAgent = 2;
336:         }
337: 
338:         foreach ($data as $key => $value) {
339:             try {
340:                 // 尝试根据$key获取菜单的父ID，如果失败则处理特别情况
341:                 $result = $this->dao->getMenuPid($key, $isMer, 0, $isAgent);
342:                 if (!$result) {
343:                     // 处理新增菜单项的特殊情况，包括附加权限和自定义路由
344:                     $route = $key;
345:                     $isAppend = 0;
346:                     if (substr($key, 0, 7) === 'append_') {
347:                         $isAppend = 1;
348:                         $route = substr($key, 7);
349:                     }
350:                     // 再次尝试获取菜单的父ID，如果仍然失败且$key不是'self'，则记录未找到菜单的信息并跳过当前循环
351:                     $result = $this->dao->getMenuPid($route, $isMer, 1, $isAgent);
352:                     if (!$result && $key !== 'self') {
353:                         printf($this->styles['info'], '未找到菜单: ' . $key);
354:                         echo PHP_EOL;
355:                         continue;
356:                     } else {
357:                         // 创建新的菜单项
358:                         $result = $this->dao->create([
359:                             'pid' => $key == 'self' ? 0 : $result['menu_id'],
360:                             'path' => $key == 'self' ? '/' : $result['path'] . $result['menu_id'] . '/',
361:                             'menu_name' => $isAppend ? '附加权限' : '权限',
362:                             'route' => $key,
363:                             'is_mer' => $isMer,
364:                             'is_menu' => 0,
365:                             'is_agent' => $isAgent
366:                         ]);
367:                     }
368:                 }
369:                 // 将处理后的菜单项数据合并到结果集中
370:                 $res = array_merge($res, $this->createSlit($isMer, $result['menu_id'], $result['path'], $value, $isAgent));
371:             } catch (\Exception $exception) {
372:                 // 抛出异常，处理菜单创建过程中的错误
373:                 throw new Exception($key);
374:             }
375:         }
376:         // 插入处理后的菜单项数据到数据库，并返回处理的菜单项数量
377:         if (!empty($res)) $this->dao->insertAll($res);
378:         return count($res);
379:     }
