680:         $status = 10;
681:         switch (($data['applyment_state']))
682:         {
683:             //申请状态: 0.平台未提交，-1.平台驳回，10.平台提交审核中，11.需用户操作 ，20.已完成，30.已冻结，40.驳回
684:             case 'ACCOUNT_NEED_VERIFY':
685:                 $status = 11;
686:                 if(isset($data['account_validation'])){
687:                     $ret = $data['account_validation'];
688:                     $message = '通过申请银行账号向以下信息汇款完成验证,'.PHP_EOL;
689:                     $message .= '收款方信息：'.PHP_EOL;
