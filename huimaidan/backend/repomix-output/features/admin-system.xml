331:      * @return mixed
332:      * @author Qinii
333:      */
334:     public function linkData($cid)
335:     {
336:         $linkData = $this->dao->getSearch([])
337:             ->where('config_classify_id', $cid)
338:             ->whereIn('config_type',['switches','radio'])
339:             ->field('config_id value,config_name label,config_rule parameter,config_type')
340:             ->select()->toArray();
