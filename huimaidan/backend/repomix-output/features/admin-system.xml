 563:     /**
 564:      * 生成商家微信二维码
 565:      *
 566:      * 本函数用于生成商家的微信二维码图片的URL。首先，它根据商家ID和当前日期生成一个唯一的文件名，
 567:      * 然后尝试从附件库中查找这个文件名的二维码图片信息。如果图片存在但URL无效（例如，图片已移除），则从数据库中删除该图片信息。
 568:      * 如果找不到图片信息，说明需要生成新的二维码。二维码的URL基于商家ID和系统配置的网站URL构建，
 569:      * 并可能通过微信服务进行永久二维码的生成。生成的二维码图片信息将被保存到附件库中，并返回其URL。
 570:      *
 571:      * @param string $merId 商家ID，用于生成唯一二维码文件名和构建二维码URL
 572:      * @return string 二维码图片的URL
 573:      */
 574:     public function wxQrcode($merId)
 575:     {
 576:         $siteUrl = systemConfig('site_url');
 577:         $name = md5('mwx' . $merId . date('Ymd')) . '.jpg';
 578:         $attachmentRepository = app()->make(AttachmentRepository::class);
 579:         $imageInfo = $attachmentRepository->getWhere(['attachment_name' => $name]);
 580: 
 581:         if (isset($imageInfo['attachment_src']) && strstr($imageInfo['attachment_src'], 'http') !== false && curl_file_exist($imageInfo['attachment_src']) === false) {
 582:             $imageInfo->delete();
 583:             $imageInfo = null;
 584:         }
 585:         if (!$imageInfo) {
 586:             $codeUrl = rtrim($siteUrl, '/') . '/pages/store/home/index?id=' . $merId; //二维码链接
 587:             if (systemConfig('open_wechat_share')) {
 588:                 $qrcode = WechatService::create(false)->qrcodeService();
 589:                 $codeUrl = $qrcode->forever('_scan_url_mer_' . $merId)->url;
 590:             }
 591:             $imageInfo = app()->make(QrcodeService::class)->getQRCodePath($codeUrl, $name);
 592:             if (is_string($imageInfo)) throw new ValidateException('二维码生成失败');
 593: 
 594:             $imageInfo['dir'] = tidy_url($imageInfo['dir'], null, $siteUrl);
 595: 
 596:             $attachmentRepository->create(systemConfig('upload_type') ?: 1, -2, $merId, [
 597:                 'attachment_category_id' => 0,
 598:                 'attachment_name' => $imageInfo['name'],
 599:                 'attachment_src' => $imageInfo['dir']
 600:             ]);
 601:             $urlCode = $imageInfo['dir'];
 602:         } else $urlCode = $imageInfo['attachment_src'];
 603:         return $urlCode;
 604:     }
