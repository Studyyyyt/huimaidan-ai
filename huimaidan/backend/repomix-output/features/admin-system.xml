474:     /**
475:      * 更新数据库中指定ID的记录。
476:      *
477:      * 本函数用于根据提供的ID和数据数组更新数据库中的相应记录。特别地，如果数据数组中包含'roles'字段，
478:      * 该字段将被转换为以逗号分隔的字符串格式，这是因为数据库中可能需要以这种格式存储角色数据。
479:      *
480:      * @param int $id 要更新的记录的ID。
481:      * @param array $data 包含要更新到数据库的字段和值的数据数组。
482:      * @return mixed 返回DAO层执行更新操作的结果。具体类型取决于DAO层的实现。
483:      */
484:     public function update(int $id, array $data)
485:     {
486:         // 如果$data数组中包含'roles'键，将其值转换为逗号分隔的字符串
487:         if (isset($data['roles'])) {
488:             $data['roles'] = implode(',', $data['roles']);
489:         }
490:         // 调用DAO层的update方法执行更新操作，并返回结果
491:         return $this->dao->update($id, $data);
492:     }
493: 
494: }
