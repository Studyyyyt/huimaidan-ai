308:             $upload = UploadService::create($info->type);
309:             $res = $upload->setBucketCors($info->name, $info->region);
310:             if (false === $res) {
311:                 return app('json')->fail($upload->getError());
312:             }
313:         } catch (\Throwable $e) {
314:         }
315:         //修改状态
316:         return Db::transaction(function () use ($id, $info) {
317:             $this->dao->getSearch(['type' => $info->type])->update(['status' => 0]);
318:             $info->status = 1;
319:             $info->save();
320:         });
