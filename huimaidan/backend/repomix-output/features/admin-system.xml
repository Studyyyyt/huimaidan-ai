691:                     $message .= "收款卡号：".$ret['destination_account_number'].';'.PHP_EOL;
692:                     $message .= "收款户名：".$ret['destination_account_name'].';'.PHP_EOL;
693:                     $message .= "开户银行：".$ret['destination_account_bank'].';'.PHP_EOL;
694:                     $message .= "省市信息：".$ret['city'].';'.PHP_EOL;
695:                     $message .= "备注信息：".$ret['remark'].';'.PHP_EOL;
696:                     $message .= "汇款截止时间：".$ret['deadline'].'。';
697:                 }
