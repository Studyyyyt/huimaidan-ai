1459:             }
1460:             Log::info('特约商户分账比例:'.$max_ratio.',系统设置比例：'.$rate);
1461:             if (bccomp($max_ratio,$rate,4) == -1) {
1462:                 $item->applyment_switch = 0;
1463:                 $item->save();
