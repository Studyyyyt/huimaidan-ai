 95:     /**
 96:      * 检查数据是否符合指定的规则
 97:      *
 98:      * 本函数用于遍历字段规则数组，并针对每个规则检查相应的数据字段是否满足条件。
 99:      * 如果数据字段不满足规则条件，则抛出一个验证异常。
100:      *
101:      * @param array $data 要检查的数据数组，其中包含各个字段的值。
102:      * @param array $fieldRule 字段规则数组，每个元素包含字段的名称、类型及其他验证条件。
103:      * @throws ValidateException 如果数据字段不满足规则条件，则抛出此异常。
104:      */
105:     public function checkData(array $data, array $fieldRule)
106:     {
107:         foreach ($fieldRule as $rule) {
108:             // 检查规则类型为数字的字段是否小于0
109:             // 如果字段类型为数字且值小于0，则抛出验证异常，指出该字段不能小于0。
110:             if ($rule['type'] === 'number' && $data[$rule['field']] < 0) {
111:                 throw new ValidateException($rule['name'] . '不能小于0');
112:             }
113:         }
114:     }
