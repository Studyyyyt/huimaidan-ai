605:         $update_infos = $data['update_infos'] ?? [];
606:         if (empty($merchant) || empty($update_infos)) {
607:             throw new ValidateException('参数异常');
608:         }
609:         $this->setMerchantInfo($merchant);
610:         $this->action = self::ACTION_EDIT;
611:         // 对比参数  判断商户修改了什么
