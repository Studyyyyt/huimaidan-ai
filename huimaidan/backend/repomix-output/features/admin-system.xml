601:         // 如果文件路径存在但文件实际不存在，则清空文件路径
602:         if ($formData['wechat_chekc_file'] && !is_file($formData['wechat_chekc_file'])) {
603:             $formData['wechat_chekc_file'] = '';
604:         }
605: 
606:         // 创建表单实例，表单提交地址为配置微信上传设置的路由
607:         $form = Elm::createForm(Route::buildUrl('configWechatUploadSet')->build());
608: 
609:         // 设置表单验证规则，包括一个文件上传字段
610:         $form->setRule([
