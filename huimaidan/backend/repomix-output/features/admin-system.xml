480:                 break;
481:             case self::PLATFORM_AUDIT_PRODUCT_OFF_SALE:
482:                 $this->auditProductRefuseOffSale($data);
483:                 break;
484:             case self::PLATFORM_EDIT_PRODUCT_SHOW:
