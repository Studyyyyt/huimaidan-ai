 494:      * @param $auth_code
 495:      * @return void
 496:      */
 497:     public function payWeixinBarCode($out_trade_no, $total_fee, $attach, $body, $auth_code, $type, $sub_mchid = '')
 498:     {
 499:         //$order = $this->paymentOrderBarCode($out_trade_no, $total_fee, $attach, $body, $auth_code);
 500:         $order = $this->paymentOrder(null, $out_trade_no, $total_fee, $attach, $body, $detail = '', 'MICROPAY', ['auth_code' => $auth_code]);
 501:         if ($sub_mchid) $order['sub_mch_id'] = $sub_mchid;
 502: 
 503:         $result = $this->application->payment->pay($order);
 504:         $paid = 0;
 505:         if ($result->return_code === 'SUCCESS'&& $result->result_code === 'SUCCESS' && $result->trade_type === 'MICROPAY') {
 506:             $paid = 1;
 507:             $transaction_id = $result->transaction_id;
 508:         }else if(isset($result->err_code)){
 509:             if($result->err_code == 'USERPAYING') {
 510:                 $redis = Cache::store('redis')->handler();
 511:                 $redis->hSet('bar_code_pay', $out_trade_no, $type);
 512:                 throw new ValidateException($result->err_code_des);
 513:             }
 514:             throw new ValidateException('微信扫码枪支付错误返回：' . $result->err_code_des);
 515:         }else if($result->return_code == 'FAIL'){
 516:             throw new ValidateException('微信扫码枪支付错误返回：' . $result->return_msg);
 517:         }
 518: 
 519:         return [
 520:             'paid' => $paid,
 521:             'transaction_id' => $transaction_id ?? 0,
 522:             'payInfo' => $result
 523:         ];
 524:     }
