 18: 
 19: class ProgramTemplate extends AbstractAPI
 20: {
 21:     /**
 22:      * Default color.
 23:      *
 24:      * @var string
 25:      */
 26:     protected $defaultColor = '#173177';
 27: 
 28:     /**
 29:      * Attributes.
 30:      *
 31:      * @var array
 32:      */
 33:     protected $message = [
 34:         'touser' => '',
 35:         'template_id' => '',
 36:         'url' => '',
 37:         'data' => [],
 38:         'miniprogram' => '',
 39:     ];
 40: 
 41:     /**
 42:      * Required attributes.
 43:      *
 44:      * @var array
 45:      */
 46:     protected $required = ['touser', 'template_id'];
 47: 
 48:     /**
 49:      * Message backup.
 50:      *
 51:      * @var array
 52:      */
 53:     protected $messageBackup;
 54: 
 55:     const API_SEND_NOTICE = 'https://api.weixin.qq.com/cgi-bin/message/template/send';
 56:     const API_SET_INDUSTRY = 'https://api.weixin.qq.com/cgi-bin/template/api_set_industry';
 57:     const API_ADD_TEMPLATE = 'https://api.weixin.qq.com/cgi-bin/template/api_add_template';
 58:     const API_GET_INDUSTRY = 'https://api.weixin.qq.com/cgi-bin/template/get_industry';
 59:     const API_GET_ALL_PRIVATE_TEMPLATE = 'https://api.weixin.qq.com/cgi-bin/template/get_all_private_template';
 60:     const API_DEL_PRIVATE_TEMPLATE = 'https://api.weixin.qq.com/cgi-bin/template/del_private_template';
 61: 
 62:     /**
 63:      * Notice constructor.
 64:      *
 65:      * @param \EasyWeChat\Core\AccessToken $accessToken
 66:      */
 67:     public function __construct(AccessToken $accessToken)
 68:     {
 69:         parent::__construct($accessToken);
 70: 
 71:         $this->messageBackup = $this->message;
 72:     }
 73: 
 74:     /**
 75:      * Set default color.
 76:      *
 77:      * @param string $color example: #0f0f0f
 78:      *
 79:      * @return $this
 80:      */
