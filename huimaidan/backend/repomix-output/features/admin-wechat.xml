 32: class WechatReplyDao extends BaseDao
 33: {
 34: 
 35:     /**
 36:      * @return BaseModel
 37:      * @author xaboy
 38:      * @day 2020-03-30
 39:      */
 40:     protected function getModel(): string
 41:     {
 42:         return WechatReply::class;
 43:     }
 44: 
 45:     /**
 46:      * 根据回复关键字获取微信回复对象
 47:      *
 48:      * 本函数旨在通过给定的关键字，在微信回复数据库中查找相应的回复配置。
 49:      * 这对于根据用户的输入关键字，动态生成相应的回复内容至关重要。
 50:      *
 51:      * @param string $key 关键字，用于在数据库中查询对应的微信回复配置。
 52:      * @return WechatReply|null 返回找到的微信回复对象，如果未找到则返回null。
 53:      */
 54:     public function keyByReply(string $key)
 55:     {
 56:         // 使用关键字查询数据库中的微信回复配置，并尝试获取第一条匹配的数据。
 57:         return WechatReply::where('key', $key)->find();
 58:     }
 59: 
 60:     /**
 61:      * 根据条件搜索微信回复配置
 62:      *
 63:      * 本函数用于查询微信回复数据库表中不被隐藏的记录，可以根据关键字进行模糊搜索。
 64:      * 主要用于在管理界面提供搜索功能，帮助用户快速定位特定的微信回复配置。
 65:      *
 66:      * @param array $where 搜索条件数组，其中可能包含关键字 keyword。
 67:      * @return \think\db\Query 查询对象，可用于进一步的查询操作。
 68:      */
 69:     public function search(array $where)
 70:     {
 71:         // 初始化查询对象，查询不被隐藏的微信回复记录
 72:         $query = WechatReply::getDB()->where('hidden', 0);
 73: 
 74:         // 如果搜索关键字存在，则进行模糊搜索
 75:         if (isset($where['keyword']) && $where['keyword']) {
 76:             $query->whereLike('key', "%{$where['keyword']}%");
 77:         }
 78: 
 79:         // 返回查询对象
 80:         return $query;
 81:     }
 82: 
 83:     /**
 84:      * 删除指定ID的记录
 85:      *
 86:      * 此方法用于根据给定的ID删除数据库中的一条记录。它首先通过调用getModel方法获取模型实例，
 87:      * 然后使用该实例的getDB方法来获取数据库对象。接下来，它构造一个查询，指定主键为$id$，
 88:      * 并且确保被删除的记录的'hidden'字段值为0（即未被隐藏）。最后，执行删除操作。
 89:      *
 90:      * @param int $id 需要被删除的记录的ID
 91:      * @return int 返回删除操作影响的行数。如果未删除任何行，则返回0。
 92:      */
 93:     public function delete(int $id)
 94:     {
 95:         // 根据ID和'hidden'字段的值删除记录，确保只删除未隐藏的记录
 96:         return ($this->getModel())::getDB()->where($this->getPk(), $id)->where('hidden', 0)->delete();
 97:     }
 98: 
 99: 
100:     /**
101:      * 根据给定的关键字查询有效的数据并以其为键进行分组
102:      *
103:      * 本函数旨在从微信回复数据库中检索与给定关键字相关且状态为有效的数据。
104:      * 它通过构造一个SQL查询，该查询使用关键字进行匹配，并且只返回状态为1的记录。
105:      * 使用关键字的特殊查询逻辑确保了关键字在数据的`key`字段中以逗号分隔的列表中出现。
106:      *
107:      * @param string $key 要查询的关键字
108:      * @return array|false|null|\think\Model|\think\Model[] 带有给定关键字的有效数据数组，如果找不到则返回false，如果没有数据则返回null
109:      */
110:     public function keyByValidData($key)
111:     {
112:         // 从微信回复数据库中获取数据，应用两个条件：关键字匹配和状态为有效
113:         return WechatReply::getDB()->where(function ($query) use ($key) {
114:             // 构造一个SQL查询，该查询使用关键字进行匹配，确保关键字在`key`字段的以逗号分隔的值中出现
115:             $query->where('key', $key)->whereFieldRaw('CONCAT(\',\',`key`,\',\')', 'LIKE', '%,' . $key . ',%', 'OR');
116:         })->where('status', 1)->find();
117:     }
118: }
