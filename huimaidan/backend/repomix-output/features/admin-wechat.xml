224:     public function configForPayment($prepayId, $json = true)
225:     {
226:         $params = [
227:             'appId' => $this->app['config']['app_id'],
228:             'timeStamp' => strval(time()),
229:             'nonceStr' => uniqid(),
230:             'package' => "prepay_id=$prepayId",
231:             'signType' => 'RSA',
232:         ];
233:         $message = $params['appId'] . "\n" .
234:             $params['timeStamp'] . "\n" .
235:             $params['nonceStr'] . "\n" .
236:             $params['package'] . "\n";
237:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
238:         $sign = base64_encode($raw_sign);
239: 
240:         $params['paySign'] = $sign;
241: 
242:         return $json ? json_encode($params) : $params;
243:     }
