 463:     public function paymentPrepare($openid, $out_trade_no, $total_fee, $attach, $body, $detail = '', $trade_type = 'JSAPI', $options = [])
 464:     {
 465:         $order = $this->paymentOrder($openid, $out_trade_no, $total_fee, $attach, $body, $detail, $trade_type, $options);
 466: 
 467:         if ($this->isV3()) {
 468:             if ($trade_type == 'MWEB') $trade_type = 'H5';
 469:             $payFunction = 'pay'.ucfirst($trade_type);
 470:             return $this->application->v3Pay->{$payFunction}($order);
 471:         } else {
 472:             $result = $this->application->payment->prepare($order);
 473:             if ($result->return_code == 'SUCCESS' && $result->result_code == 'SUCCESS') {
 474:                 return $result;
 475:             } else {
 476:                 if ($result->return_code == 'FAIL') {
 477:                     throw new WechatException('微信支付错误返回：' . $result->return_msg);
 478:                 } else if (isset($result->err_code)) {
 479:                     throw new WechatException('微信支付错误返回：' . $result->err_code_des);
 480:                 } else {
 481:                     throw new WechatException('没有获取微信支付的预支付ID，请重新发起支付!');
 482:                 }
 483:             }
 484:         }
