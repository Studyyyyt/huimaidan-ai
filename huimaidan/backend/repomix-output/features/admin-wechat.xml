 55:      */
 56:     public function uploadShippingInfo(array $order_key, int $logistics_type, array $shipping_list, string $payer_openid, $path, int $delivery_mode = 1, bool $is_all_delivered = true)
 57:     {
 58: 
 59:         if (!$this->checkManaged()) {
 60:             throw new ValidateException('开通小程序订单管理服务后重试');
 61:         }
 62:         $params = [
 63:             'order_key' => [
