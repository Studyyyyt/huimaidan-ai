716:                         'phone_number10' => $res->delivery_id,
717:                     ],
718:                     'link' => $link.$id,
719:                     'color' => null
720:                 ];
721:                 break;
722:             //退款通知
723:             case 'REFUND_CONFORM_CODE':
724:                 $res = $refund_make->get($id);
725:                 if(!$res) return false;
726:                 $name = mb_substr($res['refundProduct'][0]['product']['cart_info']['product']['store_name'],0,10);
727:                 $data[] = [
728:                     'tempCode' => 'REFUND_CONFORM_CODE',
729:                     'uid' => $res->uid,
730:                     'data' => [
731:                         'thing1' => '退款成功',
732:                         'thing2' => '「'.$name.'」等',
733:                         'character_string6' => $res->refund_order_sn,
734:                         'amount3' => $res->refund_price,
735:                         'thing13' => $res->fail_message ?? '其他',
736:                     ],
737:                     'link' => 'pages/users/refund/detail?id='.$id,
738:                     'color' => null
739:                 ];
740:                 break;
741:             //资金变动
742:             case 'USER_BALANCE_CHANGE':
743:                 $res = $user_make->get($id);
744:                 if(!$res) return false;
745:                 $data[] = [
746:                     'tempCode' => 'USER_BALANCE_CHANGE',
747:                     'uid' => $res->uid,
748:                     'data' => [
749:                         'character_string1' => $res->order_id,
750:                         'amount3' => $res->price,
751:                         'amount6' => $res->give_price,
752:                         'date5' => $res->pay_time,
753:                     ],
754:                     'link' => 'pages/users/user_money/index',
755:                     'color' => null
756:                 ];
757:                 break;
758:             //提现结果通知
759:             case 'EXTRACT_NOTICE':
760:                 $res = $extract_make->get($id);
761:                 if(!$res) return false;
762:                 $data[] = [
763:                     'tempCode' => 'USER_EXTRACT',
764:                     'uid' => $res->uid,
765:                     'data' => [
766:                         'thing1' => $res->status == -1 ? '未通过' : '已通过',
767:                         'amount2' => empty($res->bank_code)?(empty($res->alipay_code)?$res->wechat:$res->alipay_code):$res->bank_code,
768:                         'thing3' => $res->give_price,
769:                         'date4' => $res->create_time,
770:                     ],
771:                     'link' => 'pages/users/user_spread_user/index',
772:                     'color' => null
773:                 ];
774:                 break;
775:             //到货通知
776:             case'PRODUCT_INCREASE':
777:                 /*
778:                     商品名称 {{thing1.DATA}}
779:                     商品价格：{{amount5.DATA}}
780:                     温馨提示：{{thing2.DATA}}
781:                  */
782:                 $make = app()->make(ProductTakeRepository::class);
783:                 $product = app()->make(ProductRepository::class)->getWhere(['product_id' => $id],'*',['attrValue']);
784:                 if(!$product) return false;
785:                 $unique[] = 1;
786:                 foreach ($product['attrValue'] as $item) {
787:                     if($item['stock'] > 0){
788:                         $unique[] = $item['unique'];
789:                     }
790:                 }
791:                 $res = $make->getSearch(['product_id' => $id,'status' =>0,'type' => 3])->where('unique','in',$unique)->column('uid,product_id,product_take_id');
792:                 $uids = array_unique(array_column($res,'uid'));
793:                 if (!$uids) return false;
794:                 $takeId = array_column($res,'product_take_id');
795:                 foreach ($uids as $uid) {
796:                     $data[] = [
797:                         'tempCode' => 'PRODUCT_INCREASE',
798:                         'uid' => $uid,
799:                         'data' => [
800:                             'thing1' => '「'.mb_substr($product->store_name,0,10) .'」',
801:                             'amount5' => $product->price,
802:                             'thing2' => '亲！你想要的商品已到货，可以购买啦~',
803:                         ],
804:                         'link' => 'pages/goods_details/index?id='.$id,
805:                         'color' => null
806:                     ];
807:                 }
808:                 if ($takeId) $make->updates($takeId,['status' => 1]);
809:                 break;
810:             //提现结果通知
811:             case 'PAYMENT_RECEIVED':
812:                 $res = $extract_make->get($id);
813:                 if(!$res) return false;
814:                 $data[] = [
815:                     'tempCode' => 'PAYMENT_RECEIVED',
816:                     'uid' => $res->uid,
817:                     'data' => [
818:                         'amount3' => $res->extract_price,
819:                         'thing4' => $res->status == -1 ? '审核未通过' : ($res->wechat_status == 'WAIT_USER_CONFIRM' ? '佣金提现已通过，请及时确认收款' : '审核通过'),
820:                         'time9' => $res->create_time,
821:                     ],
822:                     'link' => 'pages/users/user_spread_money/index?type=1',
823:                     'color' => null
824:                 ];
825:                 break;
826:             default:
827:                 return false;
828:                 break;
829:         }
830:        return $data;
831:     }
832: 
833:     /**
834:      * 整理发送对象的openid
835:      * @param $uid
836:      * @return mixed
837:      * @author Qinii
838:      * @day 2020-06-29
839:      */
840:     public function getUserOpenID($uid,$type = 'wechat')
841:     {
842:         $user = app()->make(UserRepository::class)->get($uid);
843:         if (!$user) return null;
844:         $make = app()->make(WechatUserRepository::class);
845:         if($type == 'wechat') {
846:             return $make->idByOpenId((int)$user['wechat_user_id']);
847:         }else{
848:             return $make->idByRoutineId((int)$user['wechat_user_id']);
849:         }
850:     }
851: 
852:     /**
853:      * 发送模板消息/订阅消息
854:      * @param $openid
855:      * @param $tempCode
856:      * @param $data
857:      * @param $type
858:      * @param $link
859:      * @param $color
860:      * @return bool|mixed
861:      * @author Qinii
862:      * @day 2020-07-01
863:      */
864:     public function send($openid,$tempCode,$data,$type,$link,$color)
865:     {
866:         $template = new Template($type);
867:         $template->to($openid)->color($color);
868:         if ($link) $template->url($link);
869:         return $template->send($tempCode, $data);
870:     }
871: 
872: }
