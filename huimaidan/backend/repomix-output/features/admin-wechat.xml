148: 
149:     /**
150:      * 同步订阅消息
151:      * @return string
152:      * @author Qinii
153:      * @day 11/24/21
154:      */
155:     public function syncMinSubscribe()
156:     {
157:         if (!systemConfig('routine_appId') || !systemConfig('routine_appsecret')) {
158:             throw new ValidateException('请先配置小程序appid、appSecret等参数');
159:         }
160:         $systemNoticeConfigRepository = app()->make(SystemNoticeConfigRepository::class);
161:         $all = $systemNoticeConfigRepository->getTemplateList(0);
162:         $errData = [];
163:         $errMessage = [
164:             '-1' => '系统繁忙，此时请稍候再试',
165:             '40001' => 'AppSecret错误或者AppSecret不属于这个小程序，请确认AppSecret 的正确性',
166:             '40002' => '请确保grant_type字段值为client_credential',
167:             '40013' => '不合法的AppID，请检查AppID的正确性，避免异常字符，注意大小写',
168:             '40125' => '小程序配置无效，请检查配置',
169:             '41002' => '缺少appid参数',
170:             '41004' => '缺少secret参数',
171:             '43104' => 'appid与openid不匹配',
172:             '45009' => '达到微信api每日限额上限',
173:             '200011' => '此账号已被封禁，无法操作',
174:             '200012' => '个人模版数已达上限，上限25个',
175:         ];
176:         if ($all['list']) {
177: 
178:             $time = time();
179:             foreach ($all['list'] as $k => $template) {
180:                 if ($template['tempkey']) {
181:                     if (!isset($template['kid'])) {
182:                         throw new ValidateException('缺少字段：kid');
183:                     }
184:                     if (isset($template['kid']) && $template['kid']) {
185:                         continue;
186:                     }
187:                     $works = [];
188:                     try {
189:                         $works = MiniProgramService::create()->getSubscribeTemplateKeyWords($template['tempkey']);
190:                     } catch (\Throwable $e) {
191:                         $wechatErr = $e->getMessage();
192:                         if (is_string($wechatErr))
193:                             throw new WechatException('模板ID：'.$template['tempkey'].',错误信息'.$wechatErr);
194:                         if (in_array($e->getCode(), array_keys($errMessage))) {
195:                             throw new WechatException($errMessage[$wechatErr->getCode()]);
196:                         }
197:                         $errData[$k][] = '获取关键词列表失败：' . $wechatErr->getMessage(). '，微信错误代码：' . $e->getCode();
198:                     }
199:                     $kid = [];
200:                     if ($works) {
201:                         $works = array_combine(array_column($works, 'name'), $works);
202:                         $content = is_array($template['content']) ? $template['content'] : explode("\n", $template['content']);
203:                         foreach ($content as $c) {
204:                             $name = trim(explode('{{', $c)[0] ?? '');
205:                             if ($name && isset($works[$name])) {
206:                                 $kid[] = $works[$name]['kid'];
207:                             }
208:                         }
209:                     }
210:                     if ($kid && isset($template['kid']) && !$template['kid']) {
211:                         $tempid = '';
212:                         try {
213:                             $tempid = MiniProgramService::create()->addSubscribeTemplate($template['tempkey'], $kid, $template['notice_title']);
214:                         } catch (\Throwable $e) {
215:                             $wechatErr = $e->getMessage();
216:                             if ($e->getCode() == 200022) continue;
217:                             if (is_string($wechatErr)) throw new WechatException($wechatErr);
218:                             if (in_array($wechatErr->getCode(), array_keys($errMessage))) {
219:                                 throw new WechatException($errMessage[$wechatErr->getCode()]);
220:                             }
221:                             $errData[$k][] = '模板ID：'.$template['tempkey'].'，添加订阅消息模版失败：'.$wechatErr->getMessage().'，微信错误代码：'.$wechatErr->getCode();
222:                         }
223: 
224:                         if ($tempid != $template['tempid'] && $tempid) {
225:                             $systemNoticeConfigRepository->update($template['notice_config_id'], ['routine_tempid' => $tempid, 'kid' => json_encode($kid)]);
226:                         }
227:                     }
228:                 }
229:             }
230:         }
231:         if ($errData) Log::error('同步消息失败：'.var_export($errData,1));
232:         return $errData ? '同步存在错误，请在日志查看:/runtime/log/' : '同步成功';
233:     }
234: 
235:     /**
236:      * 同步模板消息
237:      * @return mixed
238:      * @throws \think\db\exception\DataNotFoundException
239:      * @throws \think\db\exception\DbException
240:      * @throws \think\db\exception\ModelNotFoundException
241:      */
242:     public function syncWechatSubscribe()
243:     {
244:         if (!systemConfig('wechat_appid') || !systemConfig('wechat_appsecret')) {
245:             throw new WechatException('请先配置微信公众号appid、appSecret等参数');
246:         }
247:         $systemNoticeConfigRepository = app()->make(SystemNoticeConfigRepository::class);
248:         $tempall = $systemNoticeConfigRepository->getTemplateList(1);
249:         /*
250:          * 删除所有模版ID
251:          */
252:         //获取微信平台已经添加的模版
253:         $list = WechatService::create()->getPrivateTemplates();//获取所有模版
254:         foreach ($list->template_list as $v) {
255:             //删除已有模版
256:             WechatService::create()->deleleTemplate($v['template_id']);
257:         }
258: 
259:         foreach ($tempall['list'] as $temp) {
260:             $content = is_array($temp['content']) ? $temp['content'] : explode("\n", $temp['content']);
261:             $name = [];
262:             foreach ($content as $c) {
263:                 $name[] = trim(explode('{{', $c)[0] ?? '');
264:             }
265:             //添加模版消息
266:             try{
267:                 $res = WechatService::create()->addTemplateId($temp['tempkey'],$name);
268:             }catch (\Exception $exception) {
269:                 return $temp['notice_title'].$exception->getMessage();
270:             }
271: 
272:             if (!$res->errcode && $res->template_id) {
273:                 $systemNoticeConfigRepository->update($temp['notice_config_id'], ['wechat_tempid' => $res->template_id]);
274:             }
275:         }
276: 
277:         return '模版消息一键设置成功';
278:     }
279: }
</file>

