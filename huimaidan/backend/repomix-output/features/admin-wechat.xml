151:     {
152:         $params = ['template_id' => $templateId];
153: 
154:         return $this->parseJSON('json', [self::API_DEL_PRIVATE_TEMPLATE, $params]);
155:     }
156: 
157:     /**
158:      * Send a notice message.
159:      *
160:      * @param $data
161:      *
162:      * @return \EasyWeChat\Support\Collection
163:      *
164:      * @throws \EasyWeChat\Core\Exceptions\InvalidArgumentException
165:      */
166:     public function send($data = [])
167:     {
168:         $params = array_merge($this->message, $data);
169: 
170:         foreach ($params as $key => $value) {
171:             if (in_array($key, $this->required, true) && empty($value) && empty($this->message[$key])) {
172:                 throw new InvalidArgumentException("Attribute '$key' can not be empty!");
173:             }
174: 
175:             $params[$key] = empty($value) ? $this->message[$key] : $value;
176:         }
177: 
178:         $params['data'] = $this->formatData($params['data']);
179: 
180:         $this->message = $this->messageBackup;
181: 
182:         return $this->parseJSON('json', [static::API_SEND_NOTICE, $params]);
183:     }
184: 
185:     /**
186:      * Magic access..
187:      *
188:      * @param string $method
189:      * @param array $args
190:      *
191:      * @return Notice
192:      */
193:     public function __call($method, $args)
194:     {
195:         $map = [
196:             'template' => 'template_id',
197:             'templateId' => 'template_id',
198:             'uses' => 'template_id',
199:             'to' => 'touser',
200:             'receiver' => 'touser',
201:             'url' => 'url',
202:             'link' => 'url',
203:             'data' => 'data',
204:             'with' => 'data',
205:             'formId' => 'form_id',
206:             'prepayId' => 'form_id',
207:         ];
208: 
209:         if (0 === stripos($method, 'with') && strlen($method) > 4) {
210:             $method = lcfirst(substr($method, 4));
211:         }
212: 
213:         if (0 === stripos($method, 'and')) {
214:             $method = lcfirst(substr($method, 3));
215:         }
216: 
217:         if (isset($map[$method])) {
218:             $this->message[$map[$method]] = array_shift($args);
219:         }
220: 
221:         return $this;
222:     }
223: 
224:     /**
225:      * Format template data.
226:      *
227:      * @param array $data
228:      *
229:      * @return array
230:      */
231:     protected function formatData($data)
232:     {
233:         $return = [];
234: 
235:         foreach ($data as $key => $item) {
236:             if (is_scalar($item)) {
237:                 $value = $item;
238:                 $color = $this->defaultColor;
239:             } elseif (is_array($item) && !empty($item)) {
240:                 if (isset($item['value'])) {
241:                     $value = strval($item['value']);
242:                     $color = empty($item['color']) ? $this->defaultColor : strval($item['color']);
243:                 } elseif (count($item) < 2) {
244:                     $value = array_shift($item);
245:                     $color = $this->defaultColor;
246:                 } else {
247:                     list($value, $color) = $item;
248:                 }
249:             } else {
250:                 $value = 'error data item.';
251:                 $color = $this->defaultColor;
252:             }
253: 
254:             $return[$key] = [
255:                 'value' => $value,
256:                 'color' => $color,
257:             ];
258:         }
259: 
260:         return $return;
261:     }
262: }
