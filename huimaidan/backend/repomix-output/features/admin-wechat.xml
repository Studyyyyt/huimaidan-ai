 12: namespace crmeb\services\easywechat;
 13: 
 14: use think\facade\Log;
 15: use EasyWeChat\Core\AbstractAPI;
 16: use EasyWeChat\Core\AccessToken;
 17: use EasyWeChat\Core\Exceptions\HttpException;
 18: use EasyWeChat\Core\Exceptions\InvalidConfigException;
 19: use EasyWeChat\Core\Http;
 20: use EasyWeChat\Encryption\EncryptionException;
 21: use think\exception\InvalidArgumentException;
 22: 
 23: class BaseClient extends AbstractAPI
 24: {
 25:     protected $app;
 26: 
 27:     const KEY_LENGTH_BYTE = 32;
 28:     const AUTH_TAG_LENGTH_BYTE = 16;
 29: 
 30:     protected $isService = true;
 31: 
 32:     public function __construct(AccessToken $accessToken, $app)
 33:     {
 34:         parent::__construct($accessToken);
 35:         $this->app = $app;
 36:     }
 37: 
 38:     public function setServiceStatus($val)
 39:     {
 40:         $this->isService = $val;
 41:         return $this;
 42:     }
 43: 
 44: 
 45:     /**
 46:      * @param $api
 47:      * @param $params
 48:      * @return \EasyWeChat\Support\Collection|null
 49:      * @throws \EasyWeChat\Core\Exceptions\HttpException
 50:      */
 51:     protected function httpPostJson($api, $params)
 52:     {
 53:         try {
 54:             return $this->parseJSON('json', [$api, $params]);
 55:         } catch (HttpException $e) {
 56:             $code = $e->getCode();
 57:             throw new HttpException("接口异常[$code]" . ($e->getMessage()), $code);
 58:         }
 59:     }
 60: 
 61:     /**
 62:      * @param $api
 63:      * @param $params
 64:      * @return \EasyWeChat\Support\Collection|null
 65:      * @throws \EasyWeChat\Core\Exceptions\HttpException
 66:      */
 67:     protected function httpPost($api, $params)
 68:     {
 69:         try {
 70:             return $this->parseJSON('post', [$api, $params]);
 71:         } catch (HttpException $e) {
 72:             $code = $e->getCode();
 73:             throw new HttpException("接口异常[$code]" . ($e->getMessage()), $code);
 74:         }
 75:     }
 76: 
 77: 
 78:     /**
 79:      * @param $api
 80:      * @param $params
 81:      * @return \EasyWeChat\Support\Collection|null
 82:      * @throws \EasyWeChat\Core\Exceptions\HttpException
 83:      */
 84:     protected function httpGet($api, $params)
 85:     {
 86:         try {
 87:             return $this->parseJSON('get', [$api, $params]);
 88:         } catch (HttpException $e) {
 89:             $code = $e->getCode();
 90:             throw new HttpException("接口异常[$code]" . ($e->getMessage()), $code);
 91:         }
 92:     }
 93: 
 94:     /**
 95:      * request.
 96:      *
 97:      * @param string $endpoint
 98:      * @param string $method
 99:      * @param array $options
100:      * @param bool $returnResponse
101:      */
102:     public function request(string $endpoint, string $method = 'POST', array $options = [], $serial = true)
103:     {
104:         $sign_body = $options['sign_body'] ?? '';
105:         $headers = [
106:             'Content-Type' => 'application/json',
107:             'User-Agent' => 'curl',
108:             'Accept' => 'application/json',
109:             'Authorization' => $this->getAuthorization($endpoint, $method, $sign_body),
110: //            'Wechatpay-Serial' => $this->app['config']['payment']['serial_no']
111:         ];
112:         $options['headers'] = array_merge($headers, ($options['headers'] ?? []));
113: 
114:         if ($serial) {
115: 
116:             $options['headers']['Wechatpay-Serial'] = $this->app->certficates->setServiceStatus
117:             ($this->isService)->get()['serial_no'];
118:         }
119: 
120:         Http::setDefaultOptions($options);
121:         return $this->_doRequestCurl($method, 'https://api.mch.weixin.qq.com' . $endpoint, $options);
122:     }
123: 
124: 
125:     private function _doRequestCurl($method, $location, $options = [])
126:     {
127:         $curl = curl_init();
128:         // POST数据设置
129:         if (strtolower($method) === 'post') {
130:             curl_setopt($curl, CURLOPT_POST, true);
131:             curl_setopt($curl, CURLOPT_POSTFIELDS, $options['data'] ?? $options['sign_body'] ?? '');
132:         }
133:         // CURL头信息设置
134:         if (!empty($options['headers'])) {
135:             $headers = [];
136:             foreach ($options['headers'] as $k => $v) {
137:                 $headers[] = "$k: $v";
138:             }
139:             curl_setopt($curl, CURLOPT_HTTPHEADER, $headers);
140:         }
141:         curl_setopt($curl, CURLOPT_URL, $location);
142:         curl_setopt($curl, CURLOPT_HEADER, true);
143:         curl_setopt($curl, CURLOPT_TIMEOUT, 60);
144:         curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
145:         curl_setopt($curl, CURLOPT_SSL_VERIFYPEER, false);
146:         curl_setopt($curl, CURLOPT_SSL_VERIFYHOST, false);
147:         $content = curl_exec($curl);
148:         $headerSize = curl_getinfo($curl, CURLINFO_HEADER_SIZE);
149:         curl_close($curl);
150:         return json_decode(substr($content, $headerSize), true);
151:     }
152: 
153: 
154:     /**
155:      * get sensitive fields name.
156:      *
157:      * @return array
158:      */
159:     protected function getSensitiveFieldsName()
160:     {
161:         return [
162:             'contact_name',
163:             'contact_id_number',
164:             'mobile_phone',
165:             'contact_email',
166:             'id_card_name',
167:             'id_card_number',
168:             'id_card_address',
169:             'id_doc_name',
170:             'id_doc_number',
171:             'id_doc_address',
172:             'name',
173:             'id_number',
174:             'account_name',
175:             'account_number',
176:             'contact_id_card_number',
177:             'contact_email',
178:             'openid',
179:             'ubo_id_doc_name',
180:             'ubo_id_doc_number',
181:             'ubo_id_doc_address',
182: //            'bank_address_code',
183:         ];
184:     }
185: 
186:     /**
187:      * To id card, mobile phone number and other fields sensitive information encryption.
188:      *
189:      * @param string $string
190:      *
191:      * @return string
192:      */
193:     protected function encryptSensitiveInformation(string $string)
194:     {
195:         $encrypted = '';
196:         $is = $this->isService ? 'service_payment':'payment';
197:         if ($this->app['config']['type'] == 'wechat') {
198:             $public_key = $this->app['config'][$is]['pay_weixin_public_key'];
199:         } else {
200:             $public_key = $this->app['config'][$is]['pay_routine_public_key'];
201:         }
202:         if ($public_key && ($this->isService || $this->app['config']['is_v3'])) {
203:             $public_key = rtrim(public_path(),'/').$public_key;
204:             //如果获取公钥成功则返回
205:             if ($public_key) {
206:                 if (!is_file($public_key))
207:                     throw new InvalidConfigException('公钥文件不存在');
208:                 $public_content = file_get_contents($public_key);
209:                 if (openssl_public_encrypt($string, $encrypted, $public_content,
210:                     OPENSSL_PKCS1_OAEP_PADDING)) {
211:                     //base64编码
212:                     $sign = base64_encode($encrypted);
213:                     return  $sign;
214:                 } else {
215:                     throw new InvalidConfigException('encrypt failed');
216:                 }
217:             }
218:         }
219: 
220:         $certificates = $this->app->certficates->setServiceStatus($this->isService)->get()['certificates'];
221:         if (null === $certificates) {
222:             throw new InvalidConfigException('config certificate connot be empty.');
223:         }
224:         if (openssl_public_encrypt($string, $encrypted, $certificates, OPENSSL_PKCS1_OAEP_PADDING)) {
225:             //base64编码
226:             $sign = base64_encode($encrypted);
227:         } else {
228:             throw new EncryptionException('Encryption of sensitive information failed');
229:         }
230: 
231:         return $sign;
232:     }
233: 
234:     /**
235:      * processing parameters contain fields that require sensitive information encryption.
236:      *
237:      * @param array $params
238:      *
239:      * @return array
240:      */
241:     protected function processParams(array $params)
242:     {
243:         $sensitive_fields = $this->getSensitiveFieldsName();
244: 
245:         foreach ($params as $k => $v) {
246:             if (is_array($v)) {
247:                 $params[$k] = $this->processParams($v);
248:             } else if(is_object($v)){
249:                 $params[$k] = $this->processParams((array)$v);
250:             } else {
251:                 if (in_array($k, $sensitive_fields, true)) {
252:                     $params[$k] = $this->encryptSensitiveInformation($v);
253:                 }
254:             }
255:         }
256: 
257:         return $params;
258:     }
259: 
260:     /**
261:      * @param string $url
262:      * @param string $method
263:      * @param string $body
264:      * @return string
265:      */
266:     protected function getAuthorization(string $url, string $method, string $body)
267:     {
268:         $nonce_str = uniqid();
269:         $timestamp = time();
270:         $message = $method . "\n" .
271:             $url . "\n" .
272:             $timestamp . "\n" .
273:             $nonce_str . "\n" .
274:             $body . "\n";
275:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
276:         $sign = base64_encode($raw_sign);
277:         $schema = 'WECHATPAY2-SHA256-RSA2048 ';
278:         $token = sprintf('mchid="%s",nonce_str="%s",timestamp="%d",serial_no="%s",signature="%s"',
279:             ($this->isService ? $this->app['config']['service_payment']['merchant_id'] : $this->app['config']['payment']['merchant_id']),
280:             $nonce_str,
281:             $timestamp,
282:             ($this->isService ? $this->app['config']['service_payment']['serial_no'] : $this->app['config']['payment']['serial_no']),
283:             $sign);
284: 
285:         return $schema . $token;
286:     }
287: 
288:     /**
289:      * 获取商户私钥
290:      * @return bool|resource
291:      */
292:     protected function getPrivateKey()
293:     {
294:         $key_path = $this->isService ?
295:             $this->app['config']['service_payment']['key_path'] :
296:             $this->app['config']['payment']['key_path'];
297:         if (!file_exists($key_path) || !is_file($key_path)) {
298:             throw new \InvalidArgumentException("【请上传".($this->isService ? '服务商':'微信')."支付书】SSL certificate not found");
299:         }
300:         return openssl_pkey_get_private(file_get_contents($key_path));
301:     }
302: 
303:     /**
304:      * decrypt ciphertext.
305:      *
306:      * @param array $encryptCertificate
307:      *
308:      * @return string
309:      */
310:     public function decrypt(array $encryptCertificate)
311:     {
312:         $ciphertext = base64_decode($encryptCertificate['ciphertext'], true);
313:         $associatedData = $encryptCertificate['associated_data'];
314:         $nonceStr = $encryptCertificate['nonce'];
315:         $aesKey = ($this->isService ? $this->app['config']['service_payment']['apiv3_key'] : $this->app['config']['payment']['apiv3_key']);
316:         if (strlen($aesKey) !== 32) {
317:             throw new InvalidArgumentException('The length of the key must be 32 bytes');
318:         }
319:         try {
320:             // ext-sodium (default installed on >= PHP 7.2)
321:             if (function_exists('\sodium_crypto_aead_aes256gcm_is_available') && \sodium_crypto_aead_aes256gcm_is_available()) {
322:                 return \sodium_crypto_aead_aes256gcm_decrypt($ciphertext, $associatedData, $nonceStr, $aesKey);
323:             }
324:             // ext-libsodium (need install libsodium-php 1.x via pecl)
325:             if (function_exists('\Sodium\crypto_aead_aes256gcm_is_available') && \Sodium\crypto_aead_aes256gcm_is_available()) {
326:                 return \Sodium\crypto_aead_aes256gcm_decrypt($ciphertext, $associatedData, $nonceStr, $aesKey);
327:             }
328:             // openssl (PHP >= 7.1 support AEAD)
329:             if (PHP_VERSION_ID >= 70100 && in_array('aes-256-gcm', \openssl_get_cipher_methods())) {
330:                 $ctext = substr($ciphertext, 0, -self::AUTH_TAG_LENGTH_BYTE);
331:                 $authTag = substr($ciphertext, -self::AUTH_TAG_LENGTH_BYTE);
332:                 return \openssl_decrypt($ctext, 'aes-256-gcm', $aesKey, \OPENSSL_RAW_DATA, $nonceStr, $authTag, $associatedData);
333:             }
334:         } catch (\Exception $exception) {
335:             throw new InvalidArgumentException($exception->getMessage(), $exception->getCode());
336:         } catch (\SodiumException $exception) {
337:             throw new InvalidArgumentException($exception->getMessage(), $exception->getCode());
338:         }
339:         throw new InvalidArgumentException('AEAD_AES_256_GCM 需要 PHP 7.1 以上或者安装 libsodium-php');
340:     }
341: }
</file>

