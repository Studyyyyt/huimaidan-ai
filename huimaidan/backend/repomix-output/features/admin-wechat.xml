20:      * 加密数据
21:      * @param string $plaintext
22:      * @param int $padding
23:      * @return string
24:      */
25:     public function encryptor(string $plaintext, int $padding = OPENSSL_PKCS1_OAEP_PADDING)
26:     {
27:         self::paddingModeLimitedCheck($padding);
28: 
29:         if (!openssl_public_encrypt($plaintext, $encrypted, $this->getPublicKey(), $padding)) {
30:             throw new AdminException('Encrypting the input $plaintext failed, please checking your $publicKey whether or nor correct.');
31:         }
32: 
33:         return base64_encode($encrypted);
34:     }
