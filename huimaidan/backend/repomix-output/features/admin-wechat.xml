 33:                 $contact['consignor_contact'] = Utility::encryptTel($contact['consignor_contact']);
 34:             }
 35:             if (isset($contact['receiver_contact']) && $contact['receiver_contact']) {
 36:                 $contact['receiver_contact'] = Utility::encryptTel($contact['receiver_contact']);
 37:             }
 38:         }
 39:         return $contact;
 40:     }
