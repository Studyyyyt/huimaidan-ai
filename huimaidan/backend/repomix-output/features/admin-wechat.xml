 27: /**
 28:  * Class WechatQrcodeRepository
 29:  * @package app\common\repositories\wechat
 30:  * @author xaboy
 31:  * @day 2020-04-28
 32:  * @mixin WechatQrcodeDao
 33:  */
 34: class WechatQrcodeRepository extends BaseRepository
 35: {
 36:     /**
 37:      * WechatQrcodeRepository constructor.
 38:      * @param WechatQrcodeDao $dao
 39:      */
 40:     public function __construct(WechatQrcodeDao $dao)
 41:     {
 42:         $this->dao = $dao;
 43:     }
 44: 
 45:     /**
 46:      * 创建临时二维码
 47:      *
 48:      * 本函数用于生成微信公众号的临时二维码，并根据二维码ID（$qtcode_id）决定是更新已有的二维码记录还是创建新的二维码记录。
 49:      * 临时二维码具有固定的有效时长，且在过期后不能再次使用。
 50:      *
 51:      * @param int $id 二维码关联的ID，用于指定二维码的具体内容，如商品ID等。
 52:      * @param string $type 二维码的类型，用于区分不同种类的二维码。
 53:      * @param int|null $qtcode_id 二维码的ID，如果为null，则表示创建新的二维码记录；否则，表示更新已有的二维码记录。
 54:      * @return int|bool 返回更新或创建的二维码记录ID，如果操作失败，则返回false。
 55:      */
 56:     public function createTemporaryQrcode($id, $type, $qtcode_id = null)
 57:     {
 58:         // 初始化微信服务，获取二维码对象
 59:         $qrcode = WechatService::create()->getApplication()->qrcode;
 60: 
 61:         // 创建临时二维码，有效期为30天，转换为数组格式
 62:         $data = $qrcode->temporary($id, 30 * 24 * 3600)->toArray();
 63: 
 64:         // 保存二维码的URL至$data数组
 65:         $data['qrcode_url'] = $data['url'];
 66: 
 67:         // 计算二维码的过期时间，并保存至$data数组
 68:         $data['expire_seconds'] = $data['expire_seconds'] + time();
 69: 
 70:         // 通过二维码的ticket获取二维码的URL，并保存至$data数组
 71:         $data['url'] = $qrcode->url($data['ticket']);
 72: 
 73:         // 设置二维码的状态为可用
 74:         $data['status'] = 1;
 75: 
 76:         // 保存关联的ID和类型至$data数组
 77:         $data['third_id'] = $id;
 78:         $data['third_type'] = $type;
 79: 
 80:         // 如果$qtcode_id不为空，则更新二维码记录，否则创建新的二维码记录
 81:         if ($qtcode_id) {
 82:             return $this->dao->update($qtcode_id, $data);
 83:         } else {
 84:             return $this->dao->create($data);
 85:         }
 86:     }
 87: 
 88:     /**
 89:      * 创建永久二维码
 90:      *
 91:      * 本函数用于生成微信公众号的永久二维码，并将其相关数据存储到数据库中。
 92:      * 永久二维码的特点是，扫描后不会失效，可以用于诸如会员卡绑定、商品链接等长期有效的场景。
 93:      *
 94:      * @param int $id 二维码的标识ID，用于关联具体的数据，如商品ID、会员卡ID等。
 95:      * @param string $type 二维码的类型，用于区分不同种类的二维码，如商品类型、会员卡类型等。
 96:      * @return static 返回创建的二维码记录实例。
 97:      */
 98:     public function createForeverQrcode($id, $type)
 99:     {
100:         // 初始化微信服务，获取二维码对象
101:         $qrcode = WechatService::create()->getApplication()->qrcode;
102: 
103:         // 创建永久二维码，并获取其配置数据
104:         $data = $qrcode->forever($id)->toArray();
105: 
106:         // 将二维码的URL地址赋值给qrcode_url字段，便于后续展示或下载
107:         $data['qrcode_url'] = $data['url'];
108: 
109:         // 通过二维码的ticket获取实际的二维码URL，更新data中的URL字段
110:         $data['url'] = $qrcode->url($data['ticket']);
111: 
112:         // 永久二维码的有效期设置为0，表示永久有效
113:         $data['expire_seconds'] = 0;
114: 
115:         // 设置二维码的状态为可用（1）
116:         $data['status'] = 1;
117: 
118:         // 记录二维码的第三方标识ID和类型
119:         $data['third_id'] = $id;
120:         $data['third_type'] = $type;
121: 
122:         // 根据数据创建新的二维码记录，并返回该记录实例
123:         return self::create($data);
124:     }
125: 
126:     /**
127:      * 获取临时二维码
128:      *
129:      * 本函数用于根据类型和ID获取临时二维码的信息。如果二维码已过期或不存在，则重新创建一个。
130:      * 临时二维码用于一些需要时效性的场景，比如会议签到、活动报名等。
131:      *
132:      * @param string $type 二维码类型，用于区分不同场景的二维码。
133:      * @param int $id 与二维码相关的ID，用于唯一标识该二维码。
134:      * @return array 包含二维码信息的数组，包括ticket和expire_seconds等字段。
135:      * @throws ValidateException 如果无法获取到有效的临时二维码信息，则抛出异常。
136:      */
137:     public function getTemporaryQrcode($type, $id)
138:     {
139:         // 从数据库尝试获取临时二维码信息
140:         $qrInfo = $this->dao->getTemporaryQrcode($type, $id);
141: 
142:         // 检查二维码信息是否有效，如果无效则重新创建
143:         if (!$qrInfo || (!$qrInfo['expire_seconds'] || $qrInfo['expire_seconds'] < time())) {
144:             $qrInfo = $this->createTemporaryQrcode($type, $id);
145:         }
146: 
147:         // 确保二维码的ticket存在且不为空，否则抛出异常
148:         if (!isset($qrInfo['ticket']) || !$qrInfo['ticket']) {
149:             throw new ValidateException('临时二维码获取错误');
150:         }
151: 
152:         // 返回有效的二维码信息
153:         return $qrInfo;
154:     }
155: 
156:     /**
157:      * 获取永久二维码信息
158:      *
159:      * 本函数用于根据类型和ID获取永久二维码的信息。如果该二维码信息不存在，则通过调用
160:      * createForeverQrcode函数创建新的永久二维码信息。
161:      *
162:      * @param string $type 二维码类型
163:      * @param int $id 与二维码相关联的ID
164:      * @return array 二维码信息，包含ticket等关键信息
165:      * @throws ValidateException 如果二维码信息获取失败，则抛出异常
166:      */
167:     public function getForeverQrcode($type, $id)
168:     {
169:         // 尝试从数据库中获取永久二维码信息
170:         $qrInfo = $this->dao->getForeverQrcode($type, $id);
171: 
172:         // 如果二维码信息不存在，则创建新的永久二维码
173:         if (!$qrInfo) {
174:             $qrInfo = $this->createForeverQrcode($id, $type);
175:         }
176: 
177:         // 检查二维码信息是否包含有效的ticket，如果没有则抛出异常
178:         if (!isset($qrInfo['ticket']) || !$qrInfo['ticket']) {
179:             throw new ValidateException('二维码获取错误');
180:         }
181: 
182:         // 返回二维码信息
183:         return $qrInfo;
184:     }
185: 
186: }
