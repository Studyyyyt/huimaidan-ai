 39:             $response = [
 40:                 'code' => 'SUCCESS',
 41:                 'message' => 'OK',
 42:             ];
 43:         } else {
 44:             $response = [
 45:                 'code' => 'FAIL',
 46:                 'message' => $handleResult,
 47:             ];
 48:         }
 49: 
 50:         return response($response, 200, [], 'json');
