 12: namespace crmeb\services\easywechat\msgseccheck;
 13: 
 14: use crmeb\services\easywechat\BaseClient;
 15: use EasyWeChat\Core\AbstractAPI;
 16: use EasyWeChat\Core\AccessToken;
 17: use EasyWeChat\Core\Exceptions\HttpException;
 18: use EasyWeChat\Core\Http;
 19: use EasyWeChat\Payment\API;
 20: use EasyWeChat\Payment\Merchant;
 21: use GuzzleHttp\HandlerStack;
 22: use think\Exception;
 23: use EasyWeChat\Support\XML;
 24: use EasyWeChat\Support\Collection;
 25: use Psr\Http\Message\ResponseInterface;
 26: use think\exception\ValidateException;
 27: 
 28: /**
 29:  * Class Client.
 30:  *
 31:  * @author ClouderSky <clouder.flow@gmail.com>
 32:  */
 33: class Client extends BaseClient
 34: {
 35:     protected $isService = false;
 36:     //文档地址：https://developers.weixin.qq.com/miniprogram/dev/OpenApiDoc/sec-center/sec-check/msgSecCheck.html
 37:     const MSG_API = 'https://api.weixin.qq.com/wxa/msg_sec_check?access_token=';
 38:     const MEDIA_API = 'https://api.weixin.qq.com/wxa/media_check_async?access_token=';
 39:     const LABEL = [
 40:         100   => '正常',
 41:         10001 => '广告',
 42:         20001 => '时政',
 43:         20002 => '色情',
 44:         20003 => '辱骂',
 45:         20006 => '违法犯罪',
 46:         20008 => '欺诈',
 47:         20012 => '低俗',
 48:         20013 => '版权',
 49:         21000 => '其他'
 50:     ];
 51: 
 52:     public function msgSecCheck($content, $scene, $openId)
 53:     {
 54:        $access_token = $this->accessToken->getToken();
 55:         //scene 场景枚举值（1 资料；2 评论；3 论坛；4 社交日志）
 56:         $_url = self::MSG_API.$access_token;
 57:         $params = [
 58:             'content' => $content,
 59:             'version' => (int)2,
 60:             'scene' => (int)$scene,
 61:             'openid' => $openId,
 62:         ];
 63: 
 64:         try{
 65:             $res = $this->parseJSON('json',[$_url, $params]);
 66:             if (isset($res->errcode) && $res->errcode == 0) {
 67:                 if($res->result['label'] == 100) {
 68:                     return true;
 69:                 } else if ($res->result['label'] == 21000) {
 70:                     throw new ValidateException('内容存在敏感信息无法提交');
 71:                 } else {
 72:                     throw new ValidateException('内容包含：【'.self::LABEL[$res->result['label']].'】无法提交');
 73:                 }
 74:             }
 75:         }catch (Exception $exception) {
 76:             throw new ValidateException($exception->getMessage());
 77:         }
 78:     }
 79: 
 80: 
 81:     /**
 82:      * 图片或音频是异步回调，暂未使用
 83:      * @param $media_url
 84:      * @param $scene
 85:      * @param $openId
 86:      * @param $media_type
 87:      * @return bool
 88:      * @author Qinii
 89:      * @day 2023/2/1
 90:      */
 91:     public function mediaSecCheck($media_url,$scene,$openId,$media_type)
 92:     {
 93:         $access_token = $this->accessToken->getToken();
 94:         //$media_type 1:音频;2:图片
 95:         //scene 场景枚举值（1 资料；2 评论；3 论坛；4 社交日志）
 96:         $params = [
 97:             'media_url' => $media_url,
 98:             'media_type' => $media_type,
 99:             'version' => (int)2,
100:             'scene' => (int)$scene,
101:             'openid' => $openId,
102:         ];
103:         $_url = self::MEDIA_API.$access_token;
104:         try{
105:             $res = $this->parseJSON('json',[$_url, $params]);
106:             if (isset($res->errcode) && $res->errcode == 0) {
107:                 return true;
108:             } else {
109:                 throw new ValidateException($res->errmsg);
110:             }
111:         }catch (Exception $exception) {
112:             throw new ValidateException($exception->getMessage());
113:         }
114:     }
115: }
</file>

