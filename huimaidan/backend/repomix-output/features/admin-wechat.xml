 93:             if (empty($userName)) {
 94:                 throw new ValidateException('明细金额大于等于2000时,收款人姓名必须填写');
 95:             }
 96:             $data['user_name'] = $this->encryptSensitiveInformation($userName);
 97:         }
 98:         Log::info('发起转账 data :' . var_export($data, 1));
 99:         $res = $this->request(self::API_TRANSFER_BILLS_URL, 'POST', ['sign_body' => json_encode($data)]);
100:         if (!$res || isset($res['code'], $res['message'])) {
101:             throw new ValidateException('微信商家转账：'.$res['message'] ?? '发起商家转账失败');
102:         }
103: 
104:         $res['app_id'] = $appId;
105:         $res['mch_id'] = $this->app['config']['payment']['merchant_id'];
106: 
107:         return $res;
108:     }
109: 
110:     public function handleNotify($callback)
111:     {
112:         $request = request();
113:         $data = $request->post('resource', []);
114:         $data = $this->decrypt($data);
115: 
116:         $handleResult = call_user_func_array($callback, [json_decode($data, true)]);
117:         if (is_bool($handleResult) && $handleResult) {
118:             $response = [
119:                 'code' => 'SUCCESS',
120:                 'message' => 'OK',
121:             ];
122:         } else {
123:             $response = [
124:                 'code' => 'FAIL',
125:                 'message' => $handleResult,
126:             ];
127:         }
128: 
129:         return response($response, 200, [], 'json');
130:     }
131: }
