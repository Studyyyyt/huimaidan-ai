 73:                 'openid' => $payer_openid
 74:             ]
 75:         ];
 76: 
 77:         if ($delivery_mode == 2) {
 78:             $params['is_all_delivered'] = $is_all_delivered;
 79:         }
 80: 
 81:         foreach ($shipping_list as $shipping) {
 82:             $contact = $this->handleContact($shipping['contact'] ?? []);
 83:             $params['shipping_list'][] = [
 84:                 'tracking_no' => $shipping['tracking_no'] ?? '',
 85:                 'express_company' => isset($shipping['express_company']) ? $this->getDelivery($shipping['express_company']) : '',
 86:                 'item_desc' => $shipping['item_desc'],
 87:                 'contact' => $contact
