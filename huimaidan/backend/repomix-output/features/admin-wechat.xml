 13: namespace crmeb\services\easywechat\subscribe;
 14: 
 15: use EasyWeChat\Core\AbstractAPI;
 16: use EasyWeChat\Core\AccessToken;
 17: use EasyWeChat\Core\Exceptions\InvalidArgumentException;
 18: 
 19: /**
 20:  * 小程序订阅消息
 21:  * Class ProgramSubscribe
 22:  * @package crmeb\utils
 23:  * @method $this
 24:  * @method $this template(string $template_id) 设置模板id
 25:  * @method $this withTemplateId(string $template_id) 设置模板id
 26:  * @method $this andTemplateId(string $template_id) 设置模板id
 27:  * @method $this andTemplate(string $template_id) 设置模板id
 28:  * @method $this andUses(string $template_id) 设置模板id
 29:  * @method $this to(string $touser) 设置opendid
 30:  * @method $this andReceiver(string $touser) 设置opendid
 31:  * @method $this withReceiver(string $touser) 设置opendid
 32:  * @method $this with(array $data) 设置发送内容
 33:  * @method $this andData(array $data) 设置发送内容
 34:  * @method $this withData(array $data) 设置发送内容
 35:  * @method $this data(array $data) 设置发送内容
 36:  * @method $this withUrl(string $page) 设置跳转路径
 37:  */
 38: class ProgramSubscribe extends AbstractAPI
 39: {
 40: 
 41:     /**
 42:      * 添加模板接口
 43:      */
 44:     const API_SET_TEMPLATE_ADD = 'https://api.weixin.qq.com/wxaapi/newtmpl/addtemplate';
 45: 
 46:     /**
 47:      * 删除模板消息接口
 48:      */
 49:     const API_SET_TEMPLATE_DEL = 'https://api.weixin.qq.com/wxaapi/newtmpl/deltemplate';
 50: 
 51:     /**
 52:      * 获取模板消息列表
 53:      */
 54:     const API_GET_TEMPLATE_LIST = 'https://api.weixin.qq.com/wxaapi/newtmpl/gettemplate';
 55: 
 56:     /**
 57:      * 获取模板消息分类
 58:      */
 59:     const API_GET_TEMPLATE_CATE = 'https://api.weixin.qq.com/wxaapi/newtmpl/getcategory';
 60: 
 61:     /**
 62:      * 获取模板消息关键字
 63:      */
 64:     const API_GET_TEMPLATE_KEYWORKS = 'https://api.weixin.qq.com/wxaapi/newtmpl/getpubtemplatekeywords';
 65: 
 66:     /**
 67:      * 获取公共模板
 68:      */
 69:     const API_GET_PUBLIC_TEMPLATE = 'https://api.weixin.qq.com/wxaapi/newtmpl/getpubtemplatetitles';
 70: 
 71:     /**
 72:      * 发送模板消息
 73:      */
 74:     const API_SUBSCRIBE_SEND = 'https://api.weixin.qq.com/cgi-bin/message/subscribe/send';
 75: 
 76:     /**
 77:      * Attributes
 78:      * @var array
 79:      */
 80:     protected $message = [
 81:         'touser' => '',
 82:         'template_id' => '',
 83:         'page' => '',
 84:         'data' => [],
 85:     ];
 86: 
 87:     /**
 88:      * Message backup.
 89:      *
 90:      * @var array
 91:      */
 92:     protected $messageBackup;
 93: 
 94:     protected $required = ['template_id', 'touser'];
 95: 
 96:     /**
 97:      * ProgramSubscribeService constructor.
 98:      * @param AccessToken $accessToken
 99:      */
100:     public function __construct(AccessToken $accessToken)
101:     {
102:         parent::__construct($accessToken);
103: 
104:         $this->messageBackup = $this->message;
105: 
106:     }
107: 
108:     /**
109:      * 获取当前拥有的模板列表
110:      * @return \EasyWeChat\Support\Collection|null
111:      * @throws \EasyWeChat\Core\Exceptions\HttpException
112:      */
113:     public function getTemplateList()
114:     {
115:         return $this->parseJSON('get', [self::API_GET_TEMPLATE_LIST]);
116:     }
117: 
118:     /**
119:      * 获取公众模板列表
120:      * @param string $ids
121:      * @param int $start
122:      * @param int $limit
123:      * @return \EasyWeChat\Support\Collection|null
124:      * @throws \EasyWeChat\Core\Exceptions\HttpException
125:      */
126:     public function getPublicTemplateList(string $ids, int $start = 0, int $limit = 10)
127:     {
128:         $params = [
129:             'ids' => $ids,
130:             'start' => $start,
131:             'limit' => $limit
132:         ];
133:         return $this->parseJSON('get', [self::API_GET_PUBLIC_TEMPLATE, $params]);
134:     }
135: 
136:     /**
137:      * 获取模板分类
138:      * @return \EasyWeChat\Support\Collection|null
139:      * @throws \EasyWeChat\Core\Exceptions\HttpException
140:      */
141:     public function getTemplateCate()
142:     {
143:         return $this->parseJSON('get', [self::API_GET_TEMPLATE_CATE]);
144:     }
145: 
146:     /**
147:      * 获取模板标题下的关键词列表
148:      * @param string $tid 模板标题 id，可通过接口获取
149:      * @return \EasyWeChat\Support\Collection|null
150:      * @throws \EasyWeChat\Core\Exceptions\HttpException
151:      */
152:     public function getPublicTemplateKeywords(string $tid)
153:     {
154:         $params = [
155:             'tid' => $tid
156:         ];
157:         return $this->parseJSON('get', [self::API_GET_TEMPLATE_KEYWORKS, $params]);
158:     }
159: 
160:     /**
161:      * 添加订阅模板消息
162:      * @param string $tid 模板标题 id，可通过接口获取，也可登录小程序后台查看获取
163:      * @param array $kidList 模板序列号 关键词顺序可以自由搭配（例如 [3,5,4] 或 [4,5,3]），最多支持5个，最少2个关键词组合
164:      * @param string $sceneDesc 服务场景描述，15个字以内
165:      * @return \EasyWeChat\Support\Collection|null
166:      * @throws \EasyWeChat\Core\Exceptions\HttpException
167:      */
168:     public function addTemplate(string $tid, array $kidList, string $sceneDesc = '')
169:     {
170:         $params = [
171:             'tid' => $tid,
172:             'kidList' => $kidList,
173:             'sceneDesc' => $sceneDesc,
174:         ];
175:         return $this->parseJSON('json', [self::API_SET_TEMPLATE_ADD, $params]);
176:     }
177: 
178:     /**
179:      * 删除模板消息
180:      * @param string $priTmplId
181:      * @return \EasyWeChat\Support\Collection|null
182:      * @throws \EasyWeChat\Core\Exceptions\HttpException
183:      */
184:     public function delTemplate(string $priTmplId)
185:     {
186:         $params = [
187:             'priTmplId' => $priTmplId
188:         ];
189:         return $this->parseJSON('json', [self::API_SET_TEMPLATE_DEL, $params]);
190:     }
191: 
192:     /**
193:      * 发送订阅消息
194:      * @param array $data
195:      * @return \EasyWeChat\Support\Collection|null
196:      * @throws InvalidArgumentException
197:      * @throws \EasyWeChat\Core\Exceptions\HttpException
198:      */
199:     public function send(array $data = [])
200:     {
201:         $params = array_merge($this->message, $data);
202: 
203:         foreach ($params as $key => $value) {
204:             if (in_array($key, $this->required, true) && empty($value) && empty($this->message[$key])) {
205:                 throw new InvalidArgumentException("Attribute '$key' can not be empty!");
206:             }
207: 
208:             $params[$key] = empty($value) ? $this->message[$key] : $value;
209:         }
210: 
211:         $params['data'] = $this->formatData($params['data']);
212: 
213:         $this->message = $this->messageBackup;
214: 
215:         return $this->parseJSON('json', [self::API_SUBSCRIBE_SEND, $params]);
216:     }
217: 
218:     /**
219:      * 设置订阅消息发送data
220:      * @param array $data
221:      * @return array
222:      */
223:     protected function formatData(array $data)
224:     {
225:         $return = [];
226: 
227:         foreach ($data as $key => $item) {
228:             if (is_scalar($item)) {
229:                 $value = $item;
230:             } elseif (is_array($item) && !empty($item)) {
231:                 if (isset($item['value'])) {
232:                     $value = strval($item['value']);
233:                 } elseif (count($item) < 2) {
234:                     $value = array_shift($item);
235:                 } else {
236:                     [$value] = $item;
237:                 }
238:             } else {
239:                 $value = 'error data item.';
240:             }
241: 
242:             $return[$key] = ['value' => $value];
243:         }
244: 
245:         return $return;
246:     }
247: 
248: 
249:     /**
250:      * Magic access..
251:      *
252:      * @param $method
253:      * @param $args
254:      * @return $this
255:      */
256:     public function __call($method, $args)
257:     {
258:         $map = [
259:             'template' => 'template_id',
260:             'templateId' => 'template_id',
261:             'uses' => 'template_id',
262:             'to' => 'touser',
263:             'receiver' => 'touser',
264:             'url' => 'page',
265:             'link' => 'page',
266:             'data' => 'data',
267:             'with' => 'data',
268:         ];
269: 
270:         if (0 === stripos($method, 'with') && strlen($method) > 4) {
271:             $method = lcfirst(substr($method, 4));
272:         }
273: 
274:         if (0 === stripos($method, 'and')) {
275:             $method = lcfirst(substr($method, 3));
276:         }
277: 
