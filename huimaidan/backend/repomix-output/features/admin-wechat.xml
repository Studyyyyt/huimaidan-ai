210:         }
211: 
212:         // 如果指定了分组ID，则添加等于条件搜索
213:         if (isset($where['groupid']) && $where['groupid']) $query->where('groupid', $where['groupid']);
214: 
215:         // 如果指定了性别，则添加等于条件搜索
216:         if (isset($where['sex']) && $where['sex']) $model = $query->where('sex', $where['sex']);
217: 
218:         // 如果指定了订阅状态，则添加等于条件搜索
219:         if (isset($where['subscribe']) && $where['subscribe']) $query->where('subscribe', $where['subscribe']);
