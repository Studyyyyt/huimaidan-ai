 54:         $commissionPrice = bcmul($orderInfo->pay_price, $commissionRate, 2);
 55:         // 商圈信息
 56:         $circle = $merchant->merchantRegion;
 57:         if (!$circle) {
 58:             return false;
 59:         }
 60: 
 61:         $data = [];
 62:         $circleName = '';
 63:         if ($circle->level == 1) { // 两层
 64:             // 一级商圈
 65:             $firstCircle = $circle->parent;
 66:             $firstCircleAgent = $firstCircle->circleAgent;
