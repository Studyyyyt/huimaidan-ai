 19: 
 20: class CircleBrokerageCheckoutRepository extends BaseRepository
 21: {
 22:     public function __construct(CircleBrokerageCheckoutDao $dao)
 23:     {
 24:         $this->dao = $dao;
 25:     }
 26: 
 27:     public function getList(int $page = 1, int $limit = 10, array $where, array $with = [])
 28:     {
 29:         $query = $this->dao->search($where)
 30:             ->when(!empty($with), function ($query) use ($with) {
 31:                 $query->with($with);
 32:             });
 33: 
 34:         $count = $query->count();
 35:         $list = $query->page($page, $limit)->select();
 36: 
 37:         return compact('list', 'count');
 38:     }
 39: 
 40:     public function create(array $data)
 41:     {
 42:         $agentInfo = app()->make(CircleAgentRepository::class)->get($data['agent_id']);
 43:         if(!$agentInfo) {
 44:             throw new ValidateException('代理商不存在');
 45:         }
 46:         if(!$agentInfo['payment_name'] && !$agentInfo['payment_account']) {
 47:             throw new ValidateException('未设置结算方式，无法申请结算');
 48:         }
 49: 
 50:         if((float)$agentInfo->balance < (float)$data['withdrawal_amount']) {
 51:             throw new ValidateException('余额不足');
 52:         }
 53: 
 54:         $data['agent_name'] = $agentInfo->name;
 55:         $data['agent_phone'] = $agentInfo->phone;
 56:         $data['withdrawal_sn'] = $this->getSn();
 57:         $data['withdrawal_type'] = $agentInfo->payment_method;
 58:         $data['withdrawal_name'] = $agentInfo->payment_name;
 59:         $data['withdrawal_account'] = $agentInfo->payment_account;
 60:         $data['withdrawal_qr_img'] = $agentInfo->payment_qr_img;
 61: 
 62:         return Db::transaction(function () use ($data) {
 63:             $this->dao->create($data);
 64:             // 提交成功，代理商余额减少
 65:             app()->make(CircleAgentRepository::class)->decField($data['agent_id'], 'balance', $data['withdrawal_amount']);
 66: 
 67:             return true;
 68:         });
 69:     }
 70: 
 71:     public function revoke(int $id)
 72:     {
 73:         $info = $this->dao->get($id);
 74:         if(!$info) {
 75:             throw new ValidateException('提现记录不存在');
 76:         }
 77: 
