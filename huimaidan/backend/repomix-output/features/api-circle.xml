 13: namespace app\common\repositories\circle;
 14: 
 15: use think\facade\Db;
 16: use think\exception\ValidateException;
 17: use app\common\dao\circle\CircleAgentDao;
 18: use app\common\repositories\BaseRepository;
 19: use app\common\repositories\system\admin\AdminRepository;
 20: use app\common\repositories\system\merchant\MerchantRepository;
 21: use app\common\repositories\system\auth\RoleRepository;
 22: 
 23: class CircleAgentRepository extends BaseRepository
 24: {
 25:     const IS_AGENT = [
 26:         CircleAgentDao::TYPE['REGION'] => 1, // 区域
 27:         CircleAgentDao::TYPE['MERCHANT'] => 2, // 商户
 28:     ];
 29: 
 30:     public function __construct(CircleAgentDao $dao)
 31:     {
 32:         $this->dao = $dao;
 33:     }
 34:     /**
 35:      * 获取代理列表
 36:      *
 37:      * @param int $page
 38:      * @param int $limit
 39:      * @param array $where
 40:      * @param array $with
 41:      * @return void
 42:      */
 43:     public function getList(int $page = 1, int $limit = 10, array $where, array $with = [])
 44:     {
 45:         $query = $this->dao->search($where)
 46:             ->when(!empty($with), function ($query) use ($with) {
 47:                 $query->with($with);
 48:             });
 49: 
 50:         $count = $query->count();
 51:         $list = $query->page($page, $limit)->select();
 52: 
 53:         // 取各个状态的总数
 54:         if (isset($where['status'])) {
 55:             unset($where['status']);
 56:         }
 57:         $typeTotal = $this->dao->search($where, true)->field("count(c.circle_agent_id)AS`all`,ifnull(sum(if(c.status=" . CircleAgentDao::STATUS['REVIEW'] . ",1,0)), 0)AS review,ifnull(sum(if(c.status=" . CircleAgentDao::STATUS['APPROVER'] . ",1,0)), 0)AS approver,ifnull(sum(if(c.status=" . CircleAgentDao::STATUS['REJECTED'] . ",1,0)), 0)AS rejected,ifnull(sum(if(c.status=" . CircleAgentDao::STATUS['REVOKED'] . ",1,0)), 0)AS revoked")->select()->toArray();
 58:         $typeTotal = array_shift($typeTotal);
 59: 
 60:         return compact('list', 'count', 'typeTotal');
 61:     }
 62:     /**
 63:      * 创建代理
 64:      *
 65:      * @param int $uid
 66:      * @param array $data
 67:      * @return void
 68:      */
 69:     public function create(int $uid, array $data)
 70:     {
 71:         $oldInfo = $this->dao->getWhere(['type' => $data['type'], 'uid' => $uid, 'status' => [CircleAgentDao::STATUS['REVIEW'], CircleAgentDao::STATUS['APPROVER']]]);
 72:         if ($oldInfo) {
 73:             throw new ValidateException('您已有一条入驻申请正在审核中或已通过，无需重复提交');
 74:         }
 75:         $data['uid'] = $uid;
 76: 
 77:         return $this->dao->create($data);
 78:     }
 79:     /**
 80:      * 更新代理
 81:      *
 82:      * @param int $id
 83:      * @param int $uid
 84:      * @param array $data
 85:      * @return void
 86:      */
 87:     public function update(int $id, int $uid, array $data)
 88:     {
 89:         $info = $this->dao->get($id);
 90:         if (!$info) {
 91:             throw new ValidateException('记录不存在!');
 92:         }
 93:         if ($info['uid'] != $uid) {
 94:             throw new ValidateException('无权限操作');
 95:         }
 96:         if (!in_array($info['status'], [CircleAgentDao::STATUS['REJECTED'], CircleAgentDao::STATUS['REVOKED']])) {
 97:             throw new ValidateException('状态异常，无法修改');
 98:         }
 99: 
100:         $data['audit_time'] = null;
101:         $data['audit_reason'] = '';
102:         $data['audit_admin_id'] = 0;
103:         $data['status'] = CircleAgentDao::STATUS['REVIEW'];
104:         $data['extend'] = $data['extend'] ? json_encode($data['extend']) : [];
105:         $data['qualification'] = $data['qualification'] ? json_encode($data['qualification']) : [];
106:         $data['update_time'] = date('Y-m-d H:i:s');
107: 
108:         return $this->dao->update($id, $data);
109:     }
110:     /**
111:      * 撤销代理
112:      *
113:      * @param int $id
114:      * @param int $uid
115:      * @return void
116:      */
117:     public function revoke($id, $uid)
118:     {
119:         $info = $this->dao->get($id);
120:         if (!$info) {
121:             throw new ValidateException('记录不存在!');
122:         }
123:         if ($info['uid'] != $uid) {
124:             throw new ValidateException('无权限操作');
125:         }
126:         if ($info['status'] != CircleAgentDao::STATUS['REVIEW']) {
127:             throw new ValidateException('状态异常，无法撤销');
128:         }
129: 
130:         $data['status'] = CircleAgentDao::STATUS['REVOKED'];
131:         $data['update_time'] = date('Y-m-d H:i:s');
132: 
133:         return $this->dao->update($id, $data);
134:     }
135:     /**
136:      * 后台创建代理
137:      *
138:      * @param int $adminId
139:      * @param array $data
140:      * @return void
141:      */
142:     public function adminCreate(int $adminId, array $data)
143:     {
144:         if ($data['uid']) {
145:             $oldInfo = $this->dao->getWhere([
146:                 'type' => $data['type'],
147:                 'uid' => $data['uid'],
148:                 'status' => [CircleAgentDao::STATUS['REVIEW'], CircleAgentDao::STATUS['APPROVER']]
149:             ]);
150:             if ($oldInfo) {
151:                 throw new ValidateException('该用户已有一条入驻申请正在审核中或已通过，无需重复提交');
152:             }
153:         }
154:         $data['status'] = CircleAgentDao::STATUS['APPROVER'];
155:         $data['audit_admin_id'] = $adminId;
156:         $data['audit_time'] = date('Y-m-d H:i:s');
157:         $data['status'] = CircleAgentDao::STATUS['APPROVER'];
158: 
159:         return Db::transaction(function () use ($data) {
160:             $res = $this->dao->create($data);
161:             // 后台添加默认审核通过,生成商圈管理员账号
162:             $this->circleUserAdmin($res->circle_agent_id, $data);
163: 
164:             return true;
165:         });
166:     }
167:     /**
168:      * 后台更新代理
169:      *
170:      * @param int $id
171:      * @param int $adminId
172:      * @param array $data
173:      * @return void
174:      */
175:     public function adminUpdate(int $id, int $adminId, array $data)
176:     {
177:         $info = $this->dao->get($id);
178:         if (!$info) {
179:             throw new ValidateException('记录不存在!');
180:         }
181:         if (!$info['uid'] && $data['uid']) {
182:             $oldInfo = $this->dao->getWhere([
183:                 'type' => $data['type'],
184:                 'uid' => $data['uid'],
185:                 'status' => [CircleAgentDao::STATUS['REVIEW'], CircleAgentDao::STATUS['APPROVER']]
186:             ]);
187:             if ($oldInfo) {
188:                 throw new ValidateException('该用户已有一条入驻申请正在审核中或已通过，无需重复提交');
189:             }
190:         }
191:         if ($info['status'] !== CircleAgentDao::STATUS['APPROVER']) {
192:             throw new ValidateException('状态异常，无法修改');
193:         }
194:         $data['audit_admin_id'] = $adminId;
195:         $data['audit_time'] = date('Y-m-d H:i:s');
196:         $data['extend'] = $data['extend'] ? json_encode($data['extend']) : [];
197:         $data['qualification'] = $data['qualification'] ? json_encode($data['qualification']) : [];
198:         $data['update_time'] = date('Y-m-d H:i:s');
199: 
200:         return Db::transaction(function () use ($id, $data) {
201:             $this->dao->update($id, $data);
202:             // 后台添加默认审核通过,生成商圈管理员账号
203:             $this->circleUserAdmin($id, $data, true);
204: 
205:             return true;
206:         });
207:     }
208:     /**
209:      * 后台审核代理
210:      *
211:      * @param int $id
212:      * @param int $adminId
213:      * @param array $data
214:      * @return void
215:      */
216:     public function audit($id, int $adminId, array $data)
217:     {
218:         $info = $this->dao->get($id);
219:         if (!$info) {
220:             throw new ValidateException('记录不存在!');
221:         }
222:         if ($info['status'] != CircleAgentDao::STATUS['REVIEW']) {
223:             throw new ValidateException('状态异常，无法审核');
224:         }
225: 
226:         $data['audit_admin_id'] = $adminId;
227:         $data['audit_time'] = date('Y-m-d H:i:s');
228:         $data['update_time'] = date('Y-m-d H:i:s');
229: 
230:         return Db::transaction(function () use ($id, $data, $info) {
231:             $this->dao->update($id, $data);
232:             // 审核通过后生成商圈管理员账号
233:             if ($data['status'] == CircleAgentDao::STATUS['APPROVER']) {
234:                 $this->circleUserAdmin($id, $info->toArray());
235:                 // type为商户，则自动创建组织商户
236:                 if ($info['type'] == CircleAgentDao::TYPE['MERCHANT']) {
237:                     // 创建组织商户
238:                     $circleRepository = app()->make(CircleRepository::class);
239:                     $circleRepository->create([
240:                         "pid" => 0,
241:                         "type" => 1,
242:                         "role_id" => app()->make(RoleRepository::class)->getWhere(['is_default' => 1, 'is_agent' => 2, 'status' => 1])->role_id ?? 0,
243:                         "name" => $info['business_name'],
244:                         "circle_agent_id" => $id,
245:                         "status" => 1,
246:                         "is_show" => 1,
247:                         "positioning_status" => 0,
248:                         "business_store_category" => $info['business_store_category'],
249:                         "business_store_type" => $info['business_store_type'],
250:                         "merchant_ids" => []
251:                     ]);
252:                 }
253:             }
254: 
255:             return true;
256:         });
257:     }
258:     /**
259:      * 后台删除代理
260:      *
261:      * @param int $id
262:      * @return void
263:      */
264:     public function delete($id)
265:     {
266:         $info = $this->dao->get($id);
267:         if (!$info) {
268:             throw new ValidateException('记录不存在!');
269:         }
270:         if ($info['status'] !== CircleAgentDao::STATUS['APPROVER']) {
271:             throw new ValidateException('状态异常，无法删除');
272:         }
273: 
274:         return Db::transaction(function () use ($id) {
275:             $this->dao->delete($id);
276:             // 删除成功后清除该商户下的商圈管理员账号
277:             app()->make(AdminRepository::class)->getSearch(['circle_agent_id' => $id, 'is_agent' => 1])->delete();
278:             // 清除关联的商圈的关联关系
279:             app()->make(CircleRepository::class)->search(['circle_agent_id' => $id])->update(['circle_agent_id' => 0]);
280: 
281:             return true;
282:         });
283:     }
284:     /**
285:      * 后台创建/更新商圈管理员账号
286:      *
287:      * @param int $circleAgentId
288:      * @param array $data
289:      * @param bool $isEdit
290:      * @return void
291:      */
292:     protected function circleUserAdmin(int $circleAgentId, array $data, bool $isEdit = false)
293:     {
294:         $adminRepository = app()->make(AdminRepository::class);
295: 
296:         if (!$isEdit) {
297:             $param['account'] = isset($data['account']) && !empty($data['account']) ? $data['account'] : $data['phone'];
298:             $param['pwd'] = isset($data['password']) && !empty($data['password']) ? $data['password'] : '000000'; // 默认密码 000000
299:             $param['pwd'] = $adminRepository->passwordEncode($param['pwd']);
300:         }
301:         $param['phone'] = $data['phone'];
302:         $param['real_name'] = $data['name'];
303:         $param['status'] = 1;
304:         $param['roles'] = '';
305:         $param['is_agent'] = self::IS_AGENT[$data['type']];
306:         $param['circle_agent_id'] = $circleAgentId;
307: 
308:         if ($isEdit) {
309:             return $adminRepository->search(['circle_agent_id' => $circleAgentId])->update($param);
310:         }
311: 
312:         return $adminRepository->create($param);
313:     }
314:     /**
315:      * 后台获取关联的商户列表
316:      *
317:      * @param int $id
318:      * @param int $page
319:      * @param int $limit
320:      * @param array $where
321:      * @return void
322:      */
323:     public function associatedMerchantList(int $id, int $page, int $limit, array $where)
324:     {
325:         $info = $this->dao->get($id);
326:         if (!$info) {
327:             throw new ValidateException('代理记录不存在!');
328:         }
329:         if (!$where['circle_id']) {
330:             $circleIds = app()->make(CircleRepository::class)->getSearch(['circle_agent_id' => $id])->column('circle_id');
331:         } else {
332:             $circleIds = [$where['circle_id']];
333:             unset($where['circle_id']);
334:         }
335: 
336:         if (empty($circleIds)) {
337:             return ['list' => [], 'count' => 0];
338:         }
339:         if ($info['type'] == CircleAgentDao::TYPE['REGION']) {
340:             $where['region_id'] = $circleIds;
341:         }
342:         if ($info['type'] == CircleAgentDao::TYPE['MERCHANT']) {
343:             $where['business_id'] = $circleIds;
344:         }
345:         $query = app()->make(MerchantRepository::class)->search($where);
346: 
347:         $count = $query->count();
348:         $list = $query->page($page, $limit)->field('mer_id, mer_name,real_name, mer_phone, region_id,status,mer_state')
349:             ->with(['merchantRegion'])->select();
350: 
351:         return compact('list', 'count');
352:     }
353:     /**
354:      * 获取代理的结算方式
355:      *
356:      * @param int $id
357:      * @return void
358:      */
359:     public function getSettlementMethod(int $id)
360:     {
361:         $where['circle_agent_id'] = $id;
362:         $field = 'circle_agent_id,payment_method, payment_name, payment_account, payment_bank, payment_qr_img';
363: 
364:         $info = $this->dao->getWhere($where, $field);
365:         if (!$info) {
366:             throw new ValidateException('记录不存在!');
367:         }
368: 
369:         return $info;
370:     }
371:     /**
372:      * 设置代理的结算方式
373:      *
374:      * @param int $id
375:      * @param array $data
376:      * @return void
377:      */
378:     public function setSettlementMethod(int $id, array $data)
379:     {
380:         $info = $this->dao->get($id);
381:         if (!$info) {
382:             throw new ValidateException('记录不存在!');
383:         }
384: 
385:         $data['update_time'] = date('Y-m-d H:i:s');
386: 
387:         return $this->dao->update($id, $data);
388:     }
389:     /**
390:      * 获取代理下拉列表
391:      *
392:      * @param string $type
393:      * @return void
394:      */
395:     public function options(string $type)
396:     {
397:         $where['type'] = $type;
398:         $where['status'] = CircleAgentDao::STATUS['APPROVER'];
399: 
400:         return $this->dao->search($where)->column('circle_agent_id, name');
401:     }
402:     /**
403:      * 重置密码
404:      *
405:      * @param int $id
406:      * @return void
407:      */
408:     public function resetPassword(int $id)
409:     {
410:         $info = $this->dao->get($id);
411:         if (!$info) {
412:             throw new ValidateException('记录不存在!');
413:         }
414: 
415:         $adminRepository = app()->make(AdminRepository::class);
416:         $adminInfo = $adminRepository->getWhere(['circle_agent_id' => $id, 'is_agent' => self::IS_AGENT[$info['type']]]);
417:         if (!$adminInfo) {
418:             throw new ValidateException('管理员账号不存在!');
419:         }
420: 
421:         $data['pwd'] = '000000'; // 默认密码 000000
422:         $data['pwd'] = $adminRepository->passwordEncode($data['pwd']);
423:         $data['update_time'] = date('Y-m-d H:i:s');
424: 
425:         return $adminRepository->update($adminInfo['admin_id'], $data);
426:     }
427: }
