 180:         }
 181: 
 182:         // 初始化商品数据，并处理商品属性值。
 183:         $spuData = $product = $this->setProduct($data);
 184:         // 处理商品属性值，并计算商品价格。
 185:         $settleParams = $this->setAttrValue($data, $id, $productType, 1);
 186:         // 设置商品属性。
 187:         $settleParams['attr'] = $this->setAttr($data['attr'], $id);
 188: 
 189:         // 构建商品内容信息。
 190:         $content = ['content' => $data['content'], 'type' => $conType];
 191: 
 192:         // 更新SPU数据，包括价格和原价。
 193:         $spuData['price'] = $settleParams['data']['price'];
 194:         $spuData['ot_price'] = $settleParams['data']['ot_price'];
 195: 
 196:         // 获取SPU仓库实例。
 197:         $SpuRepository = app()->make(SpuRepository::class);
 198: 
 199:         // 使用数据库事务来确保更新操作的一致性。
 200:         Db::transaction(function () use ($id, $data, $productType, $settleParams, $content, $product, $spuData, $merId, $SpuRepository) {
 201:             // 更新商品信息。
 202:             $this->save($id, $settleParams, $content, $product, $productType);
