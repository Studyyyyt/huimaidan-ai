 116:      * @throws ValidateException 如果数据验证失败，将抛出此异常。
 117:      */
 118:     public function create(array $data, int $productType = 0)
 119:     {
 120:         // 检查产品规格类型，若为单规格，则处理属性数据
 121:         if (!$data['spec_type']) {
 122:             $data['attr'] = []; // 初始化属性数组
 123:             // 如果属性值数量大于1，抛出异常，因为单规格产品只能有一个属性值
 124:             if (count($data['attrValue']) > 1)
 125:                 throw new ValidateException('单规格商品属性错误');
 126:         }
 127: 
 128:         // 初始化产品内容信息
 129:         $content = ['content' => $data['content'], 'type' => 0];
 130: 
 131:         // 根据$data数据设置产品信息，准备创建产品
 132:         $product = $this->setProduct($data);
 133: 
 134:         // 使用事务处理来确保数据一致性和完整性
 135:         return Db::transaction(function () use ($data, $productType, $content, $product) {
 136:             // 初始化活动ID为0，表示此产品未关联任何活动
 137:             $activity_id = 0;
 138: 
 139:             // 创建产品
 140:             $result = $this->dao->create($product);
 141: 
 142:             // 处理产品属性值，并保存
 143:             $settleParams = $this->setAttrValue($data, $result->product_id, $productType, 0);
 144:             $settleParams['attr'] = $this->setAttr($data['attr'], $result->product_id);
 145:             $this->save($result->product_id, $settleParams, $content, $product, $productType);
 146: 
 147:             // 更新产品价格信息
 148:             $product['price'] = $settleParams['data']['price'];
 149:             $product['ot_price'] = $settleParams['data']['ot_price'];
 150: 
 151:             // 创建SPU（Standard Product Unit），即标准化产品单元
 152:             app()->make(SpuRepository::class)->create($product, $result->product_id, $activity_id, $productType);
 153: 
 154:             // 返回新创建的产品ID
 155:             return $result->product_id;
 156:         });
 157:     }
