1016:     /**
1017:      * 检查购物车中添加的商品是否有效
1018:      *
1019:      * 该方法用于在用户将商品添加到购物车之前，验证该商品是否有效。它检查商品是否已下架、是否为新的积分商品、SKU是否存在以及库存是否足够。
1020:      *
1021:      * @param array $data 商品相关数据，包括商品ID、商品属性唯一码和购物车数量。
1022:      * @param mixed $userInfo 用户信息，该参数未在函数内部直接使用，可能是为了后续扩展而保留。
1023:      * @return array 返回包含商品、SKU和购物车信息的数组。
1024:      * @throws ValidateException 如果商品无效，抛出验证异常。
1025:      */
1026:     public function cartCheck(array $data, $userInfo)
1027:     {
1028:         // 初始化购物车变量
1029:         $cart = null;
1030: 
1031:         // 获取商品显示条件
1032:         $where = $this->dao->productShow();
1033: 
1034:         // 配置查询条件，特定于积分商品
1035:         $where['product_id'] = $data['product_id'];
1036:         $where['product_type'] = self::PRODUCT_TYPE_POINTS;
1037:         unset($where['is_gift_bag']);
1038: 
1039:         // 根据条件查询商品信息
1040:         $product = $this->dao->search(null, $where)->find();
1041: 
1042:         // 如果商品不存在，抛出异常
1043:         if (!$product) throw new ValidateException('商品已下架');
1044: 
1045:         // 如果商品不是新的积分商品，抛出异常
1046:         if (!$data['is_new']) throw new ValidateException('积分商品不可加入购物车');
1047: 
1048:         // 实例化产品属性值仓库
1049:         $value_make = app()->make(ProductAttrValueRepository::class);
1050: 
1051:         // 根据商品属性唯一码获取SKU信息
1052:         $sku = $value_make->getOptionByUnique($data['product_attr_unique']);
1053: 
1054:         // 如果SKU不存在，抛出异常
1055:         if (!$sku) throw new ValidateException('SKU不存在');
1056: 
1057:         // 如果库存不足，抛出异常
1058:         if ($sku['stock'] < $data['cart_num']) throw new ValidateException('库存不足');
1059: 
1060:         // 返回验证通过的商品、SKU和购物车信息
1061:         return compact('product', 'sku', 'cart');
1062:     }
