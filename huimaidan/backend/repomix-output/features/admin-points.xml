 999:                 $attr[$key]['attr_values'] = $item['attr_values'];
1000:             }
1001:             $values = $item['attr_values'];
1002:             foreach ($values as $i => $value) {
1003:                 $arr[] = [
1004:                     'attr' => $value,
1005:                     'check' => false
1006:                 ];
1007:             }
1008:             $attr[$key]['product_id'] = $item['product_id'];
1009:             $attr[$key]['attr_name'] = $item['attr_name'];
1010:             $attr[$key]['attr_value'] = $arr;
1011:             $attr[$key]['attr_values'] = $values;
1012:         }
1013:         return $attr;
