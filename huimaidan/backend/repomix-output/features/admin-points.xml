 927:     /**
 928:      * 根据产品ID展示产品详情
 929:      *
 930:      * 此方法通过产品ID检索特定产品的详细信息，包括产品属性、内容、价格等。
 931:      * 它还处理了属性值的细节，以及根据属性组合生成SKU。
 932:      *
 933:      * @param int $id 产品ID
 934:      * @return array 产品详细信息，包括属性、SKU等。如果产品不存在，则返回空数组。
 935:      */
 936:     public function show($id)
 937:     {
 938:         // 定义需要查询的产品字段
 939:         $field = 'is_show,product_id,mer_id,image,slider_image,store_name,store_info,unit_name,price,cost,ot_price,stock,sales,video_link,product_type,extension_type,old_product_id,rate,guarantee_template_id,temp_id,once_max_count,pay_limit,once_min_count,integral_rate,delivery_way,delivery_free,type,cate_id,svip_price_type,svip_price,mer_svip_status';
 940:         // 定义查询关联数据的策略，包括属性、内容和属性值
 941:         $with = [
 942:             'attr',
 943:             'content' => function ($query) {
 944:                 $query->order('type ASC');
 945:             },
 946:             'attrValue',
 947:         ];
 948:         // 根据产品ID查询产品信息
 949:         $res = $this->dao->getWhere(['product_id' => $id], $field, $with);
 950:         // 如果产品不存在，则返回空数组
 951:         if (!$res) return [];
 952:         // 处理产品属性细节
 953:         $attr = $this->detailAttr($res['attr']);
 954:         // 获取产品属性值细节
 955:         $attrValue = $res['attrValue'];
 956:         // 根据属性值生成SKU细节
 957:         $sku = $this->detailAttrValue($attrValue, null, 20, 0);
 958:         // 设置是否有关联的标记，默认为false
 959:         $res['isRelation'] = $isRelation ?? false;
 960:         // 移除属性和属性值数据，以优化返回的结果集
 961:         unset($res['attr'], $res['attrValue']);
 962:         // 如果存在多个属性，处理SKU的显示顺序，将第一个属性值组合放在最前面
 963:         if (count($attr) > 1) {
 964:             $firstSku = [];
 965:             foreach ($attr as $item) {
 966:                 $firstSku[] = $item['attr_values'][0];
 967:             }
 968:             $firstSkuKey = implode(',', $firstSku);
 969:             // 如果存在第一个属性值组合的SKU，将其放在SKU数组的前面
 970:             if (isset($sku[$firstSkuKey])) {
 971:                 $sku = array_merge([$firstSkuKey => $sku[$firstSkuKey]], $sku);
 972:             }
 973:         }
 974:         // 更新产品信息，包括属性和SKU
 975:         $res['attr'] = $attr;
 976:         $res['sku'] = $sku;
 977: 
 978:         // 返回处理后的详细信息
 979:         return $res;
 980:     }
