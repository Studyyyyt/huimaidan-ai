 472:      * @param int $productId
 473:      * @return mixed
 474:      */
 475:     public function setAttrValue(array $data, int $productId, int $productType, int $isUpdate = 0)
 476:     {
 477:         $extension_status = systemConfig('extension_status');
 478:         if ($isUpdate) {
 479:             $product = app()->make(ProductAttrValueRepository::class)->search(['product_id' => $productId])->select()->toArray();
 480:             $oldSku = $this->detailAttrValue($product, null);
 481:         }
 482:         $price = $stock = $ot_price = $cost = 0;
 483:         try {
 484:             foreach ($data['attrValue'] as $value) {
 485:                 $_svip_price = 0;
 486:                 $sku = '';
 487:                 if (isset($value['detail']) && !empty($value['detail']) && is_array($value['detail'])) {
 488:                     $sku = implode(',', $value['detail']);
 489:                 }
 490: 
 491:                 $cost = !$cost ? $value['cost'] : (($cost > $value['cost']) ? $cost : $value['cost']);
 492:                 $price = !$price ? $value['price'] : (($price > $value['price']) ? $value['price'] : $price);
 493:                 $ot_price = !$ot_price ? $value['ot_price'] : (($ot_price < $value['ot_price']) ? $ot_price : $value['ot_price']);
 494: 
 495:                 $unique = $this->setUnique($productId, $sku, $productType);
 496:                 $result['attrValue'][] = [
 497:                     'detail' => json_encode($value['detail'] ?? ''),
 498:                     "bar_code" => $value["bar_code"] ?? '',
 499:                     "image" => $value["image"] ?? '',
 500:                     "cost" => $value['cost'] ? (($value['cost'] < 0) ? 0 : $value['cost']) : 0,
 501:                     "price" => $value['price'] ? (($value['price'] < 0) ? 0 : $value['price']) : 0,
 502:                     "volume" => isset($value['volume']) ? ($value['volume'] ? (($value['volume'] < 0) ? 0 : $value['volume']) : 0) : 0,
 503:                     "weight" => isset($value['weight']) ? ($value['weight'] ? (($value['weight'] < 0) ? 0 : $value['weight']) : 0) : 0,
 504:                     "stock" => $value['stock'] ? (($value['stock'] < 0) ? 0 : $value['stock']) : 0,
 505:                     "ot_price" => $value['ot_price'] ? (($value['ot_price'] < 0) ? 0 : $value['ot_price']) : 0,
 506:                     "extension_one" => $extension_status ? ($value['extension_one'] ?? 0) : 0,
 507:                     "extension_two" => $extension_status ? ($value['extension_two'] ?? 0) : 0,
 508:                     "product_id" => $productId,
 509:                     "type" => self::PRODUCT_TYPE_POINTS,
 510:                     "sku" => $sku,
 511:                     "unique" => $unique,
 512:                     'sales' => $isUpdate ? ($oldSku[$sku]['sales'] ?? 0) : 0,
 513:                     'svip_price' => $_svip_price,
 514:                 ];
 515:                 $stock = $stock + intval($value['stock']);
 516:             }
 517:             $result['data'] = [
 518:                 'price' => $price,
 519:                 'stock' => $stock,
 520:                 'ot_price' => $ot_price,
 521:                 'cost' => $cost,
 522:                 'svip_price' => 0,
 523:             ];
 524:         } catch (\Exception $exception) {
 525:             throw new ValidateException('规格错误 ：' . $exception->getMessage());
 526:         }
 527:         return $result;
