 278:     /**
 279:      * 保存产品信息，包括属性、属性值、内容和数据更新。
 280:      *
 281:      * 此方法用于处理产品保存逻辑，它首先清除旧的属性和属性值，然后根据提供的参数
 282:      * 插入新的属性和属性值。如果提供了内容信息，也会清除旧内容并创建新内容。
 283:      * 最后，根据提供的数据更新产品信息。
 284:      *
 285:      * @param int $id 产品的ID，用于标识要更新的产品。
 286:      * @param array $settleParams 包含属性和属性值等结算参数的数组。
 287:      * @param array $content 包含产品内容信息的数组。
 288:      * @param array $data 包含要更新的产品数据的数组，默认为空。
 289:      * @param int $productType 产品类型，默认为0，可选参数用于区分不同类型的产品。
 290:      * @return bool 返回更新操作的结果，true表示成功，false表示失败。
 291:      */
 292:     public function save($id, $settleParams, $content, $data = [], $productType = 0)
 293:     {
 294:         // 创建产品属性和属性值的仓库实例
 295:         $ProductAttrRepository = app()->make(ProductAttrRepository::class);
 296:         $ProductAttrValueRepository = app()->make(ProductAttrValueRepository::class);
 297: 
 298:         // 清除指定产品ID的旧属性
 299:         $ProductAttrRepository->clearAttr($id);
 300:         // 清除指定产品ID的旧属性值
 301:         $ProductAttrValueRepository->clearAttr($id);
 302: 
 303:         // 如果设置了属性参数，则插入新的属性
 304:         if (isset($settleParams['attr'])) {
 305:             $ProductAttrRepository->insert($settleParams['attr']);
 306:         }
 307: 
 308:         // 如果设置了属性值参数，则分批插入新的属性值
 309:         if (isset($settleParams['attrValue'])) {
 310:             $arr = array_chunk($settleParams['attrValue'], 30);
 311:             foreach ($arr as $item) {
 312:                 $ProductAttrValueRepository->insertAll($item);
 313:             }
 314:         }
 315: 
 316:         // 如果提供了内容信息，则清除旧内容并创建新内容
 317:         if ($content) {
 318:             app()->make(ProductContentRepository::class)->clearAttr($id, $content['type']);
 319:             $this->dao->createContent($id, $content);
 320:         }
 321: 
 322:         // 如果设置了数据参数，则更新产品的价格、成本、库存等信息
 323:         if (isset($settleParams['data'])) {
 324:             $data['price'] = $settleParams['data']['price'];
 325:             $data['ot_price'] = $settleParams['data']['ot_price'];
 326:             $data['cost'] = $settleParams['data']['cost'];
 327:             $data['stock'] = $settleParams['data']['stock'];
 328:         }
 329: 
 330:         // 更新产品信息，并返回更新结果
 331:         $res = $this->dao->update($id, $data);
 332:         return $res;
 333:     }
