 172:     public function edit(int $id, array $data, int $merId, int $productType, $conType = 0)
 173:     {
 174:         // 检查商品规格类型，如果是单规格，则处理商品属性。
 175:         if (!$data['spec_type']) {
 176:             $data['attr'] = [];
