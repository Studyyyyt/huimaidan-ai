158:                 },
159:                 // 加载订单关联的产品信息
160:                 'order.orderProduct', 'platform'
161:             ])
162:             // 查找并返回订单数据
163:             ->find();
164:         // 添加附加信息'create_user'到返回结果中
165:         if ($res) $res->append(['create_user']);
166:         return $res;
167:     }
