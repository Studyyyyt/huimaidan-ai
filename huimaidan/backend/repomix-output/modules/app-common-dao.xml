175:             })->when(isset($where['user_type']) && $where['user_type'] !== '', function ($query) use ($where) {
176:                 $query->where('User.user_type', $where['user_type']);
177:             })->when(isset($where['phone']) && $where['phone'] !== '', function ($query) use ($where) {
178:                 $query->whereLike('User.phone', "%{$where['phone']}%");
179:             });
180:         });
181:         // 分组权限
182:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
183:             $query->whereIn('UserVisit.type_id', $region);
184:         }
185:         $query = $query->when(isset($where['uid'])  && $where['uid'] !== '', function ($query) use ($where) {
186:             $query->where('UserVisit.uid', $where['uid']);
187:         })->when(isset($where['mer_id'])  && $where['mer_id'] !== '', function ($query) use ($where) {
188:             $query->where('UserVisit.type_id', $where['mer_id']);
189:         })->when(isset($where['type'])  && $where['type'] !== '', function ($query) use ($where) {
190:             if(is_array($where['type'])){
191:                 $query->where('UserVisit.type','in', $where['type']);
192:             }else{
193:                 $query->where('UserVisit.type', $where['type']);
194:             }
195:         })->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
196:             getModelTime($query, $where['date'], 'UserVisit.create_time');
197:         })->when(isset($where['mom_date']) && $where['mom_date'] !== '', function ($query) use ($where) {
198:             momTime($query, $where['mom_date'], 'UserVisit.create_time');
199:         })->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
200:             $query->whereLike('UserVisit.content', "%{$where['keyword']}%");
201:         });
202: 
203:         return $query->order('UserVisit.create_time DESC');
204:     }
205: 
206:     /**
207:      * 计算指定日期内，每个用户的访问次数。
208:      *
209:      * 本函数用于统计在给定日期内，每个用户的访问产品数量。
210:      * 如果提供了商家ID，则只统计该商家的产品访问情况。
211:      *
212:      * @param string $date 统计日期，格式为YYYY-MM-DD。
213:      * @param int|null $merId 商家ID，可选参数，用于过滤特定商家的数据。
214:      * @return int 返回访问用户数量。
215:      */
216:     public function dateVisitUserNum($date, $merId = null)
217:     {
218:         // 从UserVisit模型中获取数据库实例，并设置别名为A
219:         return UserVisit::getDB()->alias('A')
220:             // 加入StoreProduct表，以获取产品相关信息
221:             ->join('StoreProduct B', 'A.type_id = B.product_id')
222:             // 当$date提供时，根据$date条件查询
223:             ->when($date, function ($query, $date) {
224:                 // 设置查询条件，根据$date筛选创建时间
225:                 getModelTime($query, $date, 'A.create_time');
226:             })
227:             // 当$merId提供时，添加条件查询特定商家的产品
228:             ->when($merId, function ($query, $merId) {
229:                 // 筛选商家ID为$merId的记录
230:                 $query->where('B.mer_id', $merId);
231:             })
232:             // 筛选类型为产品的记录
233:             ->where('A.type', 'product')
234:             // 按用户ID分组，以统计每个用户的访问次数
235:             ->group('uid')
236:             // 统计记录总数，即访问的用户数量
237:             ->count();
238:     }
239: 
240: 
241:     /**
242:      * 获取指定日期范围内访问商家的数量
243:      *
244:      * 本函数通过查询用户访问记录，结合商家产品信息，统计在指定日期范围内每个商家被访问的次数。
245:      * 默认查询最近7天的数据，可自定义查询日期范围。返回结果按访问次数降序排列。
246:      *
247:      * @param string $date 查询日期范围，格式为'YYYY-MM-DD'。如果不提供，则查询最近7天的数据。
248:      * @param int $limit 返回结果的数量限制，默认为7。
249:      * @return array 返回一个包含每个商家访问次数的数组，每个元素包含商家ID（mer_id）、商家名称（mer_name）和总访问次数（total）。
250:      */
251:     public function dateVisitMerchantNum($date, $limit = 7)
252:     {
253:         // 初始化查询，设置别名为A，以便在后续的JOIN操作中引用
254:         return UserVisit::getDB()->alias('A')
255:             // 加入StoreProduct表，通过type_id与A表关联，别名为B
256:             ->join('StoreProduct B', 'A.type_id = B.product_id')
257:             // 加入Merchant表，通过mer_id与B表关联，别名为C
258:             ->join('Merchant C', 'C.mer_id = B.mer_id')
259:             // 定义要返回的字段，包括访问次数、商家ID和商家名称
260:             ->field(Db::raw('count(A.type) as total,B.mer_id,C.mer_name,C.care_ficti, C.care_count'))
261:             // 当传入$date时，根据$date调整查询的创建时间范围
262:             ->when($date, function ($query, $date) {
263:                 getModelTime($query, $date, 'A.create_time');
264:             })
265:             // 限制查询的类型为'product'
266:             ->where('A.type', 'product')
267:             // 限制返回的结果数量
268:             ->limit($limit)
269:             // 按商家ID分组，统计每个商家的访问次数
270:             ->group('B.mer_id')
271:             // 按总访问次数降序排列
272:             ->order('total DESC')
273:             // 执行查询并返回结果
274:             ->select();
275:     }
276: 
277:     /**
278:      * 根据指定日期和商家ID，获取该商家产品访问量排名前$limit位的产品信息。
279:      *
280:      * 本函数通过查询用户访问记录和产品信息，统计指定日期内每个产品的访问量，并返回访问量排名前$limit的产品列表。
281:      * 这里的访问量是指用户点击产品的次数。
282:      *
283:      * @param string $date 查询的日期，格式为YYYY-MM-DD。如果未指定日期，则查询最近$limit天的数据。
284:      * @param int $merId 商家ID，用于限定查询商家下的产品。
285:      * @param int $limit 返回结果的数量限制，默认为7，即返回访问量排名前7的产品。
286:      * @return array 返回一个包含产品访问量排名前$limit的产品列表，每个元素包含产品访问量、产品图片、产品名称。
287:      */
288:     public function dateVisitProductNum($date, $merId, $limit = 7)
289:     {
290:         // 从用户访问记录表中查询数据，关联产品信息表和商家信息表
291:         return UserVisit::getDB()->alias('A')->join('StoreProduct B', 'A.type_id = B.product_id')
292:             ->join('Merchant C', 'C.mer_id = B.mer_id')
293:             // 选择查询的字段，包括产品访问量、产品图片和产品名称
294:             ->field(Db::raw('count(A.type_id) as total,B.image,B.store_name'))
295:             // 根据传入的日期条件进行查询，如果指定了日期，则只查询该日期的数据
296:             ->when($date, function ($query, $date) {
297:                 getModelTime($query, $date, 'A.create_time');
298:             })
299:             // 限定只查询访问类型为产品的记录，并且产品所属商家为传入的商家ID
300:             ->where('A.type', 'product')->where('B.mer_id', $merId)
301:             ->where('B.is_del', 0)->where('B.status', '1')
302:             // 按产品ID分组，统计每个产品的访问量
303:             ->group('A.type_id')
304:             // 按产品访问量降序排序
305:             ->order('total DESC')
306:             // 限制返回的结果数量
307:             ->limit($limit)
308:             // 执行查询并返回结果
309:             ->select();
310:     }
311: 
312:     /**
313:      * 计算指定日期内访问商家的总用户数
314:      *
315:      * 本函数通过查询用户访问记录，统计在指定日期内所有访问类型为产品的用户的数量。
316:      * 这里的访问记录是指用户与商家交互的行为记录，类型为产品表示用户访问了商家的产品。
317:      *
318:      * @param string $date 需要查询的日期，格式为YYYY-MM-DD
319:      * @return int 指定日期内访问商家的总用户数
320:      */
321:     public function dateVisitMerchantTotal($date)
322:     {
323:         // 使用UserVisit类中的getDB方法获取数据库连接
324:         // 当$date有值时，执行闭包函数进行查询条件的添加
325:         return UserVisit::getDB()->when($date, function ($query, $date) {
326:             // 添加查询条件，根据$date查询创建时间在该日期内的记录
327:             getModelTime($query, $date, 'create_time');
328:         })->whereIn('type', 'product')->count();
329:         // 筛选类型为产品的记录，然后统计满足条件的记录总数
330:     }
331: 
332: 
333:     /**
334:      * 计算指定日期的访问数量。
335:      *
336:      * 本函数用于统计在给定日期内，用户访问页面和小程序的总次数。
337:      * 它通过查询UserVisit模型的数据库记录，筛选出类型为'page'或'smallProgram'的访问记录，
338:      * 并统计这些记录的数量。
339:      *
340:      * @param string $date 需要统计访问数量的日期。
341:      * @return int 指定日期的访问数量。
342:      */
343:     public function dateVisitNum($date)
344:     {
345:         // 使用when方法条件性地加入日期查询条件，如果$date不为空，则根据$date查询创建时间
346:         return UserVisit::getDB()->when($date, function ($query, $date) {
347:             // 这里将查询条件应用到创建时间字段，用于筛选指定日期的记录
348:             getModelTime($query, $date, 'create_time');
349:         })->whereIn('type', ['page', 'smallProgram'])->count();
350:         // 筛选类型为'page'或'smallProgram'的记录，统计它们的数量
351:     }
352: 
353: 
354:     /**
355:      * 根据指定日期分组统计每日访问用户数。
356:      *
357:      * 本函数用于查询在指定日期范围内的每日独立访问用户数。
358:      * 通过分组查询，将创建时间转换为每天的格式，并统计每天的独立访问用户数。
359:      * 如果指定了日期，则查询该日期的访问数据；如果没有指定日期，则查询所有数据。
360:      *
361:      * @param string $date 指定的日期，格式为YYYY-MM-DD。如果为空，则查询所有日期的数据。
362:      * @return array 返回一个数组，每个元素包含每天的日期和独立访问用户数。
363:      */
364:     public function dateVisitNumGroup($date)
365:     {
366:         // 使用UserVisit模型的getDB方法获取数据库对象
367:         return UserVisit::getDB()->when($date, function ($query, $date) {
368:             // 如果指定了日期，则在查询中添加时间范围条件
369:             getModelTime($query, $date, 'create_time');
370:         })->field(Db::raw('from_unixtime(unix_timestamp(create_time),\'%m-%d\') as time, count(DISTINCT uid) as total'))
371:             // 按日期分组
372:             ->group('time')
373:             // 按日期升序排序
374:             ->order('time ASC')->select();
375:     }
376: 
377:     /**
378:      * 批量删除用户访问记录。
379:      *
380:      * 本函数提供两种方式批量删除用户访问记录：一种是根据访问ID数组进行删除，另一种是根据用户ID删除指定类型的访问记录。
381:      * - 当提供$ids参数时，会删除指定访问ID的记录。
382:      * - 当提供$uid参数时，会删除指定用户ID的所有产品访问记录。
383:      *
384:      * @param array|null $ids 访问ID数组，用于指定删除哪些访问记录。
385:      * @param int|null $uid 用户ID，用于指定删除属于哪个用户的访问记录。
386:      * @return int 删除的记录数。
387:      */
388:     public function batchDelete(? array $ids,?int  $uid)
389:     {
390:         // 如果提供了访问ID数组，则根据这些ID删除对应的访问记录。
391:         if($ids) return UserVisit::getDB()->where($this->getPk(),'in',$ids)->delete();
392: 
393:         // 如果提供了用户ID但没有提供访问ID数组，则删除该用户的所有产品访问记录。
394:         if($uid) return UserVisit::getDB()->where('uid',$uid)->where('type','product')->delete();
395:     }
396:     /**
397:      * 获取搜索日志
398:      *
399:      * @param array $where
400:      * @return void
401:      */
402:     public function clearSearchLog(array $where)
403:     {
404:         $query = $this->getModel()::when(isset($where['mer_id'])  && $where['mer_id'] !== '', function ($query) use ($where) {
405:             $query->where('type_id', $where['mer_id']);
406:         })->when(isset($where['type'])  && $where['type'] !== '', function ($query) use ($where) {
407:             if(is_array($where['type'])){
408:                 $query->where('type','in', $where['type']);
409:             }else{
410:                 $query->where('type', $where['type']);
411:             }
412:         });
413: 
414:         return $query->delete();
415:     }
416: }
