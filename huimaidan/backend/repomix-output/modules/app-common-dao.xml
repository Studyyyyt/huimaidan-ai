298:      * 获取指定来源的支付信息
299:      *
300:      * 本函数用于查询指定来源（$source）的支付详情，包括支付数量和支付金额。
301:      * 如果提供了$ids参数，则只会查询这些ID对应的支付信息。
302:      *
303:      * @param string $source 来源标识，用于指定查询哪个来源的支付信息。
304:      * @param array|null $ids 可选参数，指定查询的来源ID列表。如果不提供，则查询所有来源。
305:      * @return array 返回一个包含支付信息的数组，每个元素包含支付数量（pay_num）、支付金额（pay_price）和来源ID（source_id）。
306:      */
307:     public function getSourcePayInfo($source, ?array $ids = null)
308:     {
309:         // 使用数据库查询工具，指定别名为A，查询满足条件的支付信息。
310:         return StoreCart::getDB()->alias('A')
311:             // 筛选来源为指定值且已支付的购物车项。
312:             ->where('A.source', $source)->where('A.is_pay', 1)
313:             // 如果提供了ID列表，则进一步筛选来源ID在列表中的项。
314:             ->when($ids, function ($query, $ids) {
315:                 $query->whereIn('A.source_id', $ids);
316:             })
317:             // 左连接订单产品表，以获取购物车项对应的订单产品信息。
318:             ->leftJoin('StoreOrderProduct B', 'A.cart_id = B.cart_id')
319:             // 选择计算总支付数量和总支付金额的字段，以及来源ID。
320:             ->field('sum(B.product_num) as pay_num,sum(B.product_price) as pay_price,A.source_id')
321:             // 按来源ID分组，以聚合支付数量和金额。
322:             ->group('A.source_id')
323:             // 执行查询并返回结果集。
324:             ->select();
325:     }
326: }
