 53: 
 54:     /**
 55:      * 获取所有商家分类选项
 56:      *
 57:      * 本函数旨在获取所有商家分类的名称和ID，以数组形式返回这些信息，
 58:      * 以便在前端界面中作为下拉选项或其他形式的列表使用。
 59:      *
 60:      * @return array 返回一个包含所有商家分类ID和名称的数组，数组的每个元素是一个关联数组，
 61:      * 关联数组中包含 'value' 和 'label' 两个键，分别对应商家分类的ID和名称。
 62:      */
 63:     public function allOptions()
 64:     {
 65:         // 从数据库中查询所有商家分类的名称和ID
 66:         $data = MerchantCategory::getDB()->column('category_name', 'merchant_category_id');
 67: 
 68:         // 初始化用于存储选项的数组
 69:         $options = [];
 70:         // 遍历查询结果，构建每个分类的选项数组
 71:         foreach ($data as $value => $label) {
 72:             $options[] = compact('value', 'label');
 73:         }
 74:         // 返回构建好的选项数组
 75:         return $options;
 76:     }
 77: 
 78: 
 79:     /**
 80:      * 根据日期查询商家类别下的订单金额分组情况
 81:      *
