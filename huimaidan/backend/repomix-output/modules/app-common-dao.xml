435:      * 首先，它将所有指定产品的扩展类型设置为1，然后根据产品ID分批获取产品列表，
436:      * 并对每个产品计算并更新其两个扩展字段的值。
437:      *
438:      * @param array $ids 产品ID数组，指定需要更新扩展字段的产品
439:      * @param array $data 更新数据数组，包含扩展字段'extension_one'和'extension_two'的倍数值
440:      */
441:     public function updatesExtension(array $ids, array $data)
442:     {
443:         // 设置指定产品ID的扩展类型为1
444:         app()->make(ProductRepository::class)->updates($ids,['extension_type' => 1]);
445: 
446:         // 构建查询，准备分批更新产品扩展字段
447:         $query = $this->getModel()::getDb()->where('product_id','in',$ids);
448: 
449:         // 分批处理产品列表，每次处理100条，用于更新扩展字段
450:         $query->chunk(100, function($list) use($data){
451:             foreach ($list as $item) {
452:                 // 计算扩展字段的新值，并更新到数据库
453:                 $arr['extension_one'] = bcmul($item->price,$data['extension_one'],2);
454:                 $arr['extension_two'] = bcmul($item->price,$data['extension_two'],2);
455:                 $this->getModel()::getDb()->where('unique',$item->unique)->update($arr);
456:             }
457:         },'product_id');
458:     }
