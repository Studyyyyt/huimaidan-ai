42:     /**
43:      * 增加指定ID的数据的total字段值。
44:      * 此函数主要用于对数据库中的某些记录进行总量控制和更新，确保数据的正确性和一致性。
45:      *
46:      * @param int $id 需要更新的记录的ID。
47:      * @param int $inc 需要增加的值，默认为1，表示增加1。
48:      * @throws ValidateException 如果找不到相关数据或更新后的总量超过了预设的限制，则抛出异常。
49:      */
50:     public function incTotal($id, $inc = 1)
51:     {
52:         // 根据ID查询数据库记录。
53:         $res = $this->getModel()::getDb()->where($this->getPk(), $id)->find();
54: 
55:         // 如果查询结果为空，则抛出异常，表示数据异常。
56:         if (empty($res)) {
57:             throw new ValidateException('活动数据异常');
58:         }
59: 
60:         // 计算更新后的total值。
61:         $total = $res['total'] + $inc;
62: 
63:         // 如果当前记录的count值存在且小于更新后的total值，则抛出异常，表示超出总数限制。
64:         if ($res['count'] && $res['count'] < $total) {
65:             throw new ValidateException('超出总数限制');
66:         }
67: 
68:         // 更新记录的total值，并保存到数据库。
69:         $res->total = $total;
70:         $res->save();
71:     }
