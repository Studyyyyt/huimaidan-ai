 40:     {
 41:         return ProductReply::class;
 42:     }
 43: 
 44:     /**
 45:      * 根据条件搜索产品回复信息。
 46:      *
 47:      * 该方法通过接收一个包含搜索条件的数组，动态地构建查询语句，以检索产品回复数据。
 48:      * 搜索条件可以包括商家ID、回复状态、虚拟状态、昵称、产品ID、产品类型和删除状态等。
 49:      * 每个条件都是可选的，只有当条件存在且不为空时，才会被添加到查询语句中。
 50:      *
 51:      * @param array $where 包含搜索条件的数组。
 52:      * @return BaseQuery|\think\db\Query
 53:      */
 54:     public function search(array $where)
 55:     {
 56:         // 获取数据库查询对象
 57:         return ProductReply::getDB()->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
 58:             // 如果指定了商家ID，则添加到查询条件中
 59:             $query->where('mer_id', $where['mer_id']);
 60:         })->when(isset($where['is_reply']) && $where['is_reply'] !== '', function ($query) use ($where) {
 61:             // 如果指定了回复状态，则添加到查询条件中
 62:             $query->where('is_reply', $where['is_reply']);
 63:         })->when(isset($where['is_virtual']) && $where['is_virtual'] !== '', function ($query) use ($where) {
 64:             // 如果指定了虚拟状态，则添加到查询条件中
 65:             $query->where('is_virtual', $where['is_virtual']);
 66:         })->when(isset($where['nickname']) && $where['nickname'] !== '', function ($query) use ($where) {
 67:             // 如果指定了昵称，则添加到查询条件中，使用LIKE进行模糊搜索
 68:             $query->whereLike('nickname', "%{$where['nickname']}%");
 69:         })->when(isset($where['product_id']) && $where['product_id'] !== '', function ($query) use ($where) {
 70:             // 如果指定了产品ID，则添加到查询条件中
 71:             $query->where('product_id', $where['product_id']);
 72:         })->when(isset($where['product_type']) && $where['product_type'] !== '', function ($query) use ($where) {
 73:             // 如果指定了产品类型，则添加到查询条件中
 74:             $query->where('product_type', 'product_type');
 75:         })->when(isset($where['is_del']) && $where['is_del'] !== '', function ($query) use ($where) {
 76:             // 如果指定了删除状态，则添加到查询条件中
 77:             $query->where('is_del', $where['is_del']);
 78:         })->order('sort DESC'); // 按排序降序排列
 79:     }
 80: 
 81:     /**
 82:      * 根据条件搜索产品评价信息并进行关联查询。
 83:      * 该方法通过构建一个复杂的SQL查询来实现，它根据传入的条件来过滤产品评价，并且联合查询产品及相关信息。
 84:      *
 85:      * @param array $where 查询条件数组，包含各种过滤参数如是否已回复、昵称、关键词等。
 86:      * @return \think\db\Query 返回一个查询对象，该对象可用于进一步的查询操作或获取数据。
 87:      */
 88:     public function searchJoinQuery(array $where)
 89:     {
 90:         // 从产品评价表中获取数据，表别名为A
 91:         return ProductReply::getDB()->alias('A')
 92:             // 加入产品表（表别名为B），根据产品ID进行关联
 93:             ->join('StoreProduct B', 'A.product_id = B.product_id')
 94:             // 如果条件中指定了是否已回复，则在查询中加入该条件
 95:             ->when(isset($where['is_reply']) && $where['is_reply'] !== '', function ($query) use ($where) {
 96:                 $query->where('A.is_reply', $where['is_reply']);
 97:             })
 98:             // 如果条件中指定了昵称，则在查询中加入昵称模糊搜索条件
 99:             ->when(isset($where['nickname']) && $where['nickname'] !== '', function ($query) use ($where) {
100:                 $query->whereLike('A.nickname', "%{$where['nickname']}%");
101:             })
102:             // 如果条件中指定了关键词，则在查询中加入对产品名称或产品ID的搜索条件
103:             ->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
104:                 $query->where(function ($query) use ($where) {
105:                     $query->where('B.store_name', 'like', "%{$where['keyword']}%")
106:                         ->whereOr('B.product_id', $where['keyword']);
107:                 });
108:             })
109:             // 如果条件中指定了日期范围，则在查询中加入创建时间的条件
110:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
111:                 getModelTime($query, $where['date'], 'A.create_time');
112:             })
113:             // 如果条件中指定了商家ID，则在查询中加入商家ID的条件
114:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
115:                 $query->where('A.mer_id', $where['mer_id']);
116:             })
117:             // 如果条件中指定了产品ID，则在查询中加入产品ID的条件
118:             ->when(isset($where['product_id']) && $where['product_id'] !== '', function ($query) use ($where) {
119:                 $query->where('A.product_id', $where['product_id']);
120:             })
121:             // 按照评价排序和创建时间倒序排列
122:             ->order('A.sort DESC, A.create_time DESC')
123:             // 仅查询未被删除的评价
124:             ->where('A.is_del', 0)
125:             // 指定返回的字段
126:             ->field('A.reply_id,A.is_reply,A.uid,A.product_score,A.service_score,A.postage_score,A.comment,A.pics,A.create_time,A.merchant_reply_content,A.nickname,A.avatar,B.store_name,B.image,B.product_id,A.sort');
127:     }
128: 
129:     /**
130:      * 批量插入数据到产品回复表中。
131:      *
132:      * 本方法用于一次性插入多条数据到产品回复表中，提高了数据插入的效率。
133:      * 它通过调用ProductReply类中的getDB方法来获取数据库连接对象，然后进一步调用insertAll方法进行数据插入。
134:      *
135:      * @param array $data 包含多条产品回复数据的数组，每条数据是一个关联数组，其中键是字段名，值是字段值。
