150:                 // 如果$except存在，则添加不等于($<>_)查询条件。
151:                 $query->where($field, '<>', $except);
152:             })->where('mer_id', $merId)->where($field, $value)->count() > 0;
153:     }
154: 
155:     /**
156:      * 根据ID和商家ID获取数据
157:      *
158:      * 本函数用于从数据库中检索指定ID和商家ID对应的数据行。
159:      * 它首先通过调用getModel方法来获取模型实例，然后使用该实例的getDB方法来获得数据库操作对象。
160:      * 接着，通过where方法指定查询条件为商家ID为$merId，最后使用find方法根据$id查找数据。
161:      *
162:      * @param int $id 数据行的唯一标识ID
163:      * @param int $merId 商家的唯一标识ID，默认为0，表示系统默认商家
164:      * @return object 返回查询结果的对象，如果未找到则为null
165:      */
166:     public function get($id, $merId = 0)
167:     {
168:         // 通过模型获取数据库操作对象，并根据$id和$merId查询数据
169:         return ($this->getModel())::getDB()->where('mer_id', $merId)->find($id);
170:     }
171: 
172:     /**
173:      * 删除记录
174:      *
175:      * 本函数用于根据给定的ID和可选的merId删除数据库中的记录。
176:      * 它首先获取模型对应的数据库实例，然后构建一个查询条件，包括主键ID和mer_id（如果提供），
177:      * 最后执行删除操作。此函数返回删除操作的结果。
178:      *
179:      * @param int $id 主键ID，用于指定要删除的记录。
180:      * @param int $merId 商户ID，可选参数，用于指定特定商户的记录。默认为0，表示不区分商户。
181:      * @return int 返回删除操作影响的行数。
182:      */
183:     public function delete(int $id, $merId = 0)
184:     {
185:         // 获取模型对应的数据库实例，并构建删除条件
186:         return ($this->getModel())::getDB()->where($this->getPk(), $id)->where('mer_id', $merId)->delete();
187:     }
