42:         return $this->update($id, $cartPriceData);
43:     }
44: 
45:     private function getCartPriceData(int $cartId, array $data) : array
46:     {
47:         $newPrice = $data['new_price'] ?? 0;
48:         if($data['type'] == 1){ // 立减
49:             $newPrice = bcsub($data['old_price'], $data['reduce_price'], 2);
50:         }
51:         if($data['type'] == 2){ // 折扣
52:             $newPrice = bcmul($data['old_price'], $data['discount_rate']/100, 2);
53:         }
54: 
55:         $storeCartPriceData['cart_id'] = $cartId;
56:         $storeCartPriceData['old_price'] = $data['old_price'];
57:         $storeCartPriceData['type'] = $data['type'];
58:         $storeCartPriceData['reduce_price'] = $data['reduce_price'] ?? 0;
59:         $storeCartPriceData['discount_rate'] = $data['discount_rate'] ?? 0;
60:         $storeCartPriceData['new_price'] = $newPrice;
61:         $storeCartPriceData['is_batch'] = 0;
62:         $storeCartPriceData['update_time'] = date('Y-m-d H:i:s', time());
63: 
64:         return $storeCartPriceData;
65:     }
66: }
