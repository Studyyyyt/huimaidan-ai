 174:      * 并支持多种条件组合以满足不同的搜索需求。搜索条件包括但不限于产品属性、
 175:      * 商家标识、状态、标签等。此外，方法还处理了不同条件下的查询逻辑，如软删除、
 176:      * 商家关联、产品类型等。
 177:      *
 178:      * @param string $merId 商家ID，用于限制搜索范围。
 179:      * @param array $where 搜索条件数组，包含各种过滤条件。
 180:      * @return \think\db\Query 查询对象，可用于进一步的查询操作或获取结果。
 181:      */
 182:     public function search($merId, array $where, $search = '')
 183:     {
 184:         // 初始化用于构建查询条件的数组
 185:         $keyArray = $whereArr = [];
 186:         // 定义需要排除的搜索字段
 187:         $out = ['soft', 'us_status', 'mer_labels', 'sys_labels', 'order', 'hot_type','cate_ids', 'is_action', 'seckill_active_id','spu_ids','activity_label_ids'];
 188: 
 189:         // 遍历搜索条件，构建查询字段和值的映射
 190:         foreach ($where as $key => $item) {
 191:             if ($item !== '' && !in_array($key, $out)) {
 192:                 $keyArray[] = $key;
 193:                 $whereArr[$key] = $item;
 194:             }
 195:         }
 196:         // 根据是否有软删除条件，构建查询对象
 197:         $query = isset($where['soft']) ? model::onlyTrashed()->alias('Product')->where('delete', 0) : model::alias('Product');
 198:         $query->where('Product.mer_status', 1);
 199:         if($search) {
 200:             $query->hasWhere('attrValue');
 201:             $query->where(function ($query) use($search) {
 202:                 $query->hasWhere('attrValue', ['bar_code_number' => $search])->whereOr("Product.store_name|Product.product_id", "like", "%{$search}%");
 203:             });
 204:         }
 205:         // 分组权限
 206:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
 207:             $query->whereIn('Product.mer_id', $region);
 208:         }
 209:         // 处理商家类型条件
 210:         if (isset($where['is_trader']) && $where['is_trader'] !== '') {
 211:             $query->hasWhere('merchant', function ($query) use ($where) {
 212:                 $query->where('is_trader', $where['is_trader']);
 213:             });
 214:         }
 215: 
 216:         // 处理搜索关键字和关联查询
 217:         $query->withSearch($keyArray, $whereArr)->Join('StoreSpu U', 'Product.product_id = U.product_id')->where('U.product_type', $where['product_type'] ?? 0);
 218: 
 219:         // 处理类别ID条件
 220:         $query->when((isset($where['spu_ids']) && !empty($where['spu_ids'])), function ($query) use ($where) {
 221:             $query->whereIn('spu_id',$where['spu_ids']);
 222:         });
 223: 
 224:         // 处理类别ID条件
 225:         $query->when((isset($where['cate_id']) && !empty($where['cate_id'])), function ($query) use ($where) {
 226:             $query->where(['cate_id' => $where['cate_id']]);
 227:         });
 228:         $query->when((isset($where['cate_ids']) && !empty($where['cate_ids'])), function ($query) use ($where) {
 229:             $cateIds = app()->make(StoreCategoryRepository::class)->allChildren($where['cate_ids']);
 230:             $query->whereIn('cate_id', $cateIds);
 231:         });
 232: 
 233:         // 处理秒杀活动ID条件
 234:         $query->when((isset($where['seckill_active_id']) && is_array($where['seckill_active_id']) && !empty($where['seckill_active_id'])), function ($query) use ($where) {
 235:             $query->whereIn('Product.active_id', $where['seckill_active_id']);
 236:         });
 237:         $query->when((isset($where['seckill_active_id']) && !is_array($where['seckill_active_id']) && $where['seckill_active_id']), function ($query) use ($where) {
 238:             $query->where('Product.active_id', $where['seckill_active_id']);
 239:         });
 240: 
 241:         // 处理商家ID条件
 242:         $query->when($merId, function ($query) use ($merId) {
 243:             if (is_array($merId)) {
 244:                 $query->whereIn('Product.mer_id', $merId);
 245:             } else if (!is_array($merId)) {
 246:                 $query->where('Product.mer_id', $merId);
 247:             }
 248:         })
 249:             // 处理热门类型条件
 250:             ->when(isset($where['hot_type']) && $where['hot_type'] !== '', function ($query) use ($where) {
 251:                 if ($where['hot_type'] == 'new')
 252:                     $query->where('is_new', 1);
 253:                 else if ($where['hot_type'] == 'hot')
 254:                     $query->where('is_hot', 1);
 255:                 else if ($where['hot_type'] == 'best')
 256:                     $query->where('is_best', 1);
 257:                 else if ($where['hot_type'] == 'good')
 258:                     $query->where('is_benefit', 1);
 259:             })
 260:             // 处理使用状态条件
 261:             ->when(isset($where['us_status']) && $where['us_status'] !== '', function ($query) use ($where) {
 262:                 if ($where['us_status'] == 0) {
