 74:                     $query->whereLike('Community.title',"%{$where['keyword']}%");
 75:                 }
 76:             })
 77: //            ->when(isset($where['keyword']) && $where['keyword'] !==  '', function ($query) use($where) {
 78: //                $query->whereLike('Community.title',"%{$where['keyword']}%");
 79: //            })
 80:             ->when(isset($where['uid']) && $where['uid'] !==  '', function ($query) use($where) {
 81:                 $query->where('Community.uid',$where['uid']);
 82:             })
 83:             ->when(isset($where['uids']) && $where['uids'] !==  '', function ($query) use($where) {
 84:                 $query->whereIn('Community.uid',$where['uids']);
