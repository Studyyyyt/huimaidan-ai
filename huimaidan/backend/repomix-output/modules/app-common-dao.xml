320:         if(empty($viewSearch) || !isset($viewSearch[0]['boolean'])) return $query;
321:         $logic = $viewSearch[0]['boolean'] == 'and' ? 'where' : 'whereOr';
322:         $query = $query->where(function (Query $query) use ($viewSearch, $logic, $defaulAlias) {
323:             foreach ($viewSearch as $search) {
324:                 if (empty($search['field_name']) || empty($search['operator'])) {
325:                     continue;
326:                 }
327:                 if (!isset($search['value'])) {
