128:     private function collectProductIds($where)
129:     {
130:         $query = Product::alias('P')->where('P.is_del', 0)
131:             ->join('StoreProductReservation R', 'P.product_id = R.product_id', 'LEFT');
132: 
133:         if (isset($where['product_type']) && $where['product_type'] != 20){
134:             $query->join('Merchant M', 'P.mer_id = M.mer_id', 'LEFT')
135:                 ->where('M.status', 1)
136:                 ->where('M.mer_state', 1);
137:         }
138: 
139:         $query
140:             ->when(isset($where['is_del']) && $where['is_del'] !== '',function($query)use($where){
141:                 $query->where('P.is_del',$where['is_del']);
142:             })
143:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '',function($query)use($where){
144:                 $query->where('P.mer_id',$where['mer_id']);
145:             })
146:             ->when(isset($where['mer_ids']) && $where['mer_ids'] !== '',function($query)use($where){
147:                 $query->whereIn('P.mer_id',$where['mer_ids']);
148:             })
149:             ->when(isset($where['product_ids']) && $where['product_ids'] !== '',function($query)use($where){
150:                 $query->whereIn('P.product_id',$where['product_ids']);
151:             })
152:             ->when(isset($where['is_trader']) && $where['is_trader'] !== '',function($query)use($where){
153:                 $merId = app()->make(MerchantRepository::class)->search([
154:                     'is_trader' => $where['is_trader'],
155:                     'status' => 1,
156:                     'mer_state' => 1,
157:                     'is_del' => 1,
158:                 ])->column('mer_id');
159:                 $query->whereIn('P.mer_id',$merId);
160:             })
161:             ->when(isset($where['mer_type_id']) && $where['mer_type_id'] !== '',function($query)use($where){
162:                 $merId = app()->make(MerchantRepository::class)->search([
163:                     'type_id' => $where['mer_type_id'],
164:                     'status' => 1,
165:                     'mer_state' => 1,
166:                     'is_del' => 1,
167:                 ])->column('mer_id');
168:                 $query->whereIn('P.mer_id',$merId);
169:             })
170: 
171:             ->when(isset($where['cate_pid']) && $where['cate_pid'], function ($query) use ($where) {
172:                 $storeCategoryRepository = app()->make(StoreCategoryRepository::class);
173:                 if (is_array($where['cate_pid'])) {
174:                     $cateIds = $storeCategoryRepository->selectChildrenId($where['cate_pid']);
175:                 } else {
176:                     $cateIds = $storeCategoryRepository->findChildrenId((int)$where['cate_pid']);
177:                     $where['cate_pid'] = [$where['cate_pid']];
178:                 }
179:                 $cate = array_merge($cateIds, $where['cate_pid']);
180:                 $query->whereIn('P.cate_id', $cate);
181:             })
182:             ->when(isset($where['pid']) && $where['pid'] !== '', function ($query) use ($where) {
183:                 $query->join('StoreCategory CT','P.cate_id = CT.store_category_id')->where('CT.pid',$where['pid']);
184:             })
185:             ->when(isset($where['cate_id']) && $where['cate_id'] !== '', function ($query) use ($where) {
186:                 $query->whereIn('P.cate_id', $where['cate_id']);
187:             })
188: 
189:             ->when(isset($where['is_stock']) && !empty($where['is_stock']), function ($query) use ($where) {
190:                 $query->where('P.stock','>',0);
191:             })
192:             ->when(isset($where['is_coupon']) && !empty($where['is_coupon']), function ($query) use ($where) {
193:                 $query->whereIn('P.product_type','0,2');
194:             })
195:             ->when(isset($where['brand_id']) && $where['brand_id'] !== '', function ($query) use ($where) {
196:                 $query->whereIn('P.brand_id', array_map('intval', explode(',', $where['brand_id'])));
197:             })
198:             ->when(isset($where['is_gift_bag']) && $where['is_gift_bag'] !== '',function($query)use($where){
199:                 $query->where('P.is_gift_bag',$where['is_gift_bag']);
200:             })
201: 
202:             ->when(isset($where['mer_cate_id']) && $where['mer_cate_id'] !== '',function($query)use($where){
203:                 $merCateIds = explode(',', $where['mer_cate_id']);
204:                 $storeCategory = StoreCategory::getDB();
205:                 foreach ($merCateIds as $item) {
206:                     $storeCategory->whereOr('path','like','%/'.$item.'/%');
207:                 }
208:                 $ids = $storeCategory->column('store_category_id');
209:                 $ids = array_unique(array_merge($merCateIds,$ids));
210:                 $productId = ProductCate::where('mer_cate_id', 'in', $ids)->column('product_id');
211:                 $productId = array_unique($productId);
212:                 $query->where('P.product_id','in',$productId);
213:             })
214:             ->when(isset($where['mer_status']) && $where['mer_status'] !== '',function($query)use($where){
215:                 $query->where('mer_status',$where['mer_status']);
216:             })
217: 
218:             ->when(isset($where['delivery_way']) && $where['delivery_way'] !== '', function ($query) use ($where) {
219:                 $query->whereLike('P.delivery_way',"%{$where['delivery_way']}%");
220:             })
221:             ->when(isset($where['store_type_id']) && $where['store_type_id'] !== '', function ($query) use ($where) {
222:                 $types = explode(',', $where['store_type_id']);
223:                 foreach ($types as &$item) {
224:                     $item--;
225:                 }
226:                 $query->whereIn('P.type', $types);
227:             })
228:             ->when(isset($where['hot_type']) && $where['hot_type'] !== '', function ($query) use ($where) {
229:                 if ($where['hot_type'] == 'new') $query->where('P.is_new', 1);
230:                 else if ($where['hot_type'] == 'hot') $query->where('P.is_hot', 1);
231:                 else if ($where['hot_type'] == 'best') $query->where('P.is_best', 1);
232:                 else if ($where['hot_type'] == 'good') $query->where('P.is_benefit', 1);
233:             })
234:             ->when(isset($where['svip']) && $where['svip'] !== '',function($query)use($where){
235:                 $query->where('P.svip_price_type','>',0)->where('P.mer_svip_status',1);
236:             })
237:             ->when(isset($where['product_type']) && $where['product_type'] !== '',function($query)use($where){
238:                 $query->where('P.product_type',$where['product_type']);
239:             })
240:             ->when(isset($where['delivery_type']) && $where['delivery_type'] !== '',function($query)use($where){
241:                 $productWay = [];
242:                 $reservationWay = [];
243:                 foreach(explode(',', $where['delivery_type']) as $item){
244:                     if($item <= 3) {
245:                         $productWay[] = $item;
246:                     }else{
247:                         $reservationWay[] = $item;
248:                     }
249:                 }
250:                 $reservationWhere = [];
251:                 if(in_array('4', $reservationWay)){
252:                     $reservationWhere = ['R.reservation_type' => 2]; // 上门
253:                 }
254:                 if(in_array('5', $reservationWay)){
255:                     $reservationWhere = ['R.reservation_type' => 1]; // 到店
256:                 }
257:                 if(in_array('4', $reservationWay) && in_array('5', $reservationWay)){ //上门+到店
258:                     $reservationWhere = ['R.reservation_type' => 3];
259:                 }
260:                 if($productWay && !$reservationWhere){
261:                     $query->where('P.type','<>',4);
262:                     foreach($productWay as $item){
263:                         if($item <= 3) {
264:                             $query->whereFindInSet('P.delivery_way', $item);
265:                         }
266:                     }
267:                 }
268:                 if(!$productWay && $reservationWhere){
269:                     $query->where(function($query)use($reservationWhere){
270:                         $query->where('P.type',4);
271:                         $query->where($reservationWhere);
272:                     });
273:                 }
274:                 if($productWay && $reservationWhere){
275:                     $query->where(function($query)use($productWay, $reservationWhere){
276:                         $query->where(function($query)use($productWay){
277:                             $query->where('P.type','<>',4);
278:                             foreach($productWay as $item){
279:                                 if($item <= 3) {
280:                                     $query->whereFindInSet('P.delivery_way', $item);
281:                                 }
282:                             }
283:                         });
284:                         $query->whereOr(function($query)use($reservationWhere){
285:                             $query->where('P.type',4);
286:                             $query->where($reservationWhere);
287:                         });
288:                     });
289:                 }
290:             })
291:         ;
292:         return $query->column('P.product_id') ?: false;
293:     }
