138:             ->where('C.is_del', 0)
139:             ->when(isset($where['type']) && !is_null($where['type']), function ($query) use ($where) {
140:                 if ($where['type'] == '') {
141:                     $query->where('C.type', 'in', [0,10,11,12]);
142:                 } else {
143:                     $query->where('C.type', $where['type']);
144:                 }
145:             })
146:             ->when(isset($where['send_type']) && $where['send_type'] !== '', function($query) use($where){
147:                 $query->where('C.send_type', $where['send_type']);
148:             })
149:             ->when(isset($where['not_svip']) && $where['not_svip'] !== '', function($query) use($where){
150:                 $query->where('C.send_type', '<>',StoreCouponRepository::GET_COUPON_TYPE_SVIP);
151:             })
152:             ->when($uid, function($query) use($uid){
153:                 $couponId = StoreCouponUser::where('uid',$uid)->whereIn('status',[1,2])->column('coupon_id');
154:                 $query->whereNotIn('C.coupon_id', $couponId);
155:             })
156:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function($query) use($where){
157:                 if (is_array($where['mer_id'])) {
158:                     $query->whereIn('C.mer_id', $where['mer_id']);
159:                 } else {
160:                     $query->where('C.mer_id', $where['mer_id']);
161:                 }
162:             })
163:             ->where(function (BaseQuery $query) {
164:                 $query->where('is_limited', 0)->whereOr(function (BaseQuery $query) {
165:                     $query->where('is_limited', 1)->where('remain_count', '>', 0);
166:                 });
167:             })
168:             ->where(function (BaseQuery $query) {
169:                 $query->where('is_timeout', 0)->whereOr(function (BaseQuery $query) {
170:                     $time = date('Y-m-d H:i:s');
171:                     $query->where('is_timeout', 1)->where('start_time', '<', $time)->where('end_time', '>', $time);
172:                 });
173:             })
174:             ->where(function (BaseQuery $query) {
175:                 $query->where('C.mer_id', 0)->whereOr(function (BaseQuery $query) {
176:                     $query->where('M.is_del',0)->where('M.status',1)->where('M.mer_state',1);
177:                 });
178:             })
179:             ->where(function (BaseQuery $query) {
180:                 $query->where('coupon_type', 0)->whereOr(function (BaseQuery $query) {
181:                     $query->where('coupon_type', 1)->where('use_end_time', '>', date('Y-m-d H:i:s'));
182:                 });
183:             });
