 17: 
 18: class WechatNewsDao extends BaseDao
 19: {
 20: 
 21:     protected function getModel(): string
 22:     {
 23:         return WechatNews::class;
 24:     }
 25: 
 26:     /**
 27:      * 根据主键查询
 28:      * @param int $merId
 29:      * @param int $id
 30:      * @param null $except
 31:      * @return bool
 32:      * @author Qinii
 33:      */
 34:     public function merExists(int $merId, int $id, $except = null)
 35:     {
 36:         return $this->merFieldExists($merId, $this->getPk(), $id, $except);
 37:     }
 38: 
 39:     /**
 40:      * 根据 字段名查询
 41:      * @param int $merId
 42:      * @param $field
 43:      * @param $value
 44:      * @param null $except
 45:      * @return bool
 46:      * @author Qinii
 47:      */
 48:     public function merFieldExists(int $merId, $field, $value, $except = null)
 49:     {
 50:         return ($this->getModel())::getDB()->when($except, function ($query, $except) use ($field) {
 51:                 $query->where($field, '<>', $except);
 52:             })->where('mer_id', $merId)->where($field, $value)->count() > 0;
 53:     }
 54: 
 55:     /**
 56:      * 根据条件获取所有的微信新闻信息。
 57:      *
 58:      * 此方法主要用于查询微信新闻及相关文章的信息。通过接收一个数组参数$where，
 59:      * 来确定查询条件。特别地，如果数组中包含'cate_name'键，并且其值不为空，
 60:      * 则会进一步根据 cate_name 来模糊查询文章标题。
 61:      *
 62:      * @param array $where 查询条件数组，可以包含任何用于筛选新闻的条件。
 63:      * @return \Illuminate\Database\Eloquent\Builder|WechatNews 查询结果，包含微信新闻及其相关文章。
 64:      */
 65:     public function getAll(array $where)
 66:     {
 67:         // 当$where数组中包含'cate_name'且不为空时，进行模糊查询
 68:         if(isset($where['cate_name']) && $where['cate_name'] !== ''){
 69:             $query = WechatNews::hasWhere('article',function ($query)use($where){
 70:                 // 在文章中模糊搜索标题包含$cate_name的记录
 71:                 $query->whereLike('title',"%{$where['cate_name']}%");
 72:             });
 73:         }else{
 74:             // 如果没有指定cate_name，则直接查询微信新闻表
 75:             $query = WechatNews::alias('WechatNews');
 76:         }
 77: 
 78:         // 带上相关文章信息
 79:         $query->with('article');
 80: 
 81:         // 按照创建时间降序排序
 82:         return $query->order('WechatNews.create_time DESC');
 83:     }
 84: 
 85:     /**
 86:      * 根据ID和商家ID获取数据
 87:      *
 88:      * 本函数用于从数据库中检索指定ID和商家ID对应的数据。它通过调用getModel方法获取数据模型实例，
 89:      * 并使用该实例的getDB方法来访问数据库。查询时，会指定条件为mer_id等于传入的商家ID，
 90:      * 并且通过with方法加载关联的article内容。最后，使用find方法根据指定的ID查找数据。
 91:      *
 92:      * @param int $id 需要获取的数据的ID
 93:      * @param int $merId 商家ID，用于限定查询的数据范围，默认为0，表示不进行商家ID的限定
 94:      * @return \think\Model|null 返回符合查询条件的数据模型对象，如果未找到数据则返回null
 95:      */
 96:     public function get( $id, int $merId = 0)
 97:     {
 98:         // 根据ID和商家ID查询数据，同时加载关联的article内容
 99:         return ($this->getModel())::getDB()->where('mer_id',$merId)->with('article.content')->find($id);
100:     }
101: 
102: }
