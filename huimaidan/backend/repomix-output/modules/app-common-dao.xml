399:                                                     $query->where($fieldName, 'like', '%/' . $val . '/%');
400:                                                 }
401:                                             }
402:                                         });
403:                                         break;
404:                                     case CrudFormEnum::FORM_TAG:
405:                                     case CrudFormEnum::FORM_CHECKBOX:
406:                                     case CrudFormEnum::FORM_CASCADER_ADDRESS:
407:                                         $tags  = is_array($search['value']) ? $search['value'] : explode(',', $search['value']);
408:                                         $query = $query->whereNot(function ($query) use ($tags, $fieldName) {
409:                                             foreach ($tags as $i => $tag) {
410:                                                 if ($i) {
411:                                                     $query->whereOr($fieldName, 'like', '%/' . $tag . '/%');
