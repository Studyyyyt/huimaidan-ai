153:     /**
154:      * 检查用户是否已设置特定服务
155:      *
156:      * 本函数用于查询指定用户是否为特定商家设置了服务。通过传入用户的ID（$uid）和商家的ID（$merId），
157:      * 函数将查询数据库中是否存在相应的服务记录。如果存在，则表示用户已设置该服务；如果不存在，则表示用户未设置。
158:      * 可选参数$except允许指定一个服务ID进行排除查询，即查询时不包括指定的服务ID。
159:      *
160:      * @param string $merId 商家ID，用于指定查询的商家。
161:      * @param string $uid 用户ID，用于指定查询的用户。
162:      * @param int|null $except 可选参数，用于指定需要排除的服务ID。
163:      * @return bool 如果用户已设置服务则返回true，否则返回false。
164:      * @throws DbException
165:      */
166:     public function issetService($merId, $uid, ?int $except = null)
167:     {
168:         // 通过StoreService获取数据库操作对象，并构造查询条件
169:         // 查询条件包括：用户ID（$uid）、商家ID（$merId）、服务未被删除（'is_del'为0）
170:         // 如果传入了$except参数，则进一步排除指定的服务ID
171:         return StoreService::getDB()->where('uid', $uid)->when($except, function ($query, $except) {
172:                 $query->where($this->getPk(), '<>', $except);
173:             })->where('mer_id', $merId)->where('is_del', 0)->count($this->getPk()) > 0;
174:     }
175: 
176:     /**
177:      * 检查用户是否绑定特定服务
178:      *
179:      * 本函数用于查询指定用户是否绑定了一定的服务实例。通过传入用户的ID（$uid），
180:      * 它可以在数据库中搜索与该用户ID相关联的服务绑定记录。如果可选参数$except被提供，
181:      * 函数将排除这个ID，不考虑它是否被绑定。
182:      *
183:      * @param int $uid 用户的唯一标识符。用于查询与该用户相关联的绑定记录。
184:      * @param int|null $except 可选参数，用于指定一个ID，函数将排除这个ID进行查询。
185:      *                        这允许检查用户是否绑定了除特定ID之外的任何服务。
186:      * @return bool 如果用户绑定了至少一个服务，则返回true；否则返回false。
187:      * @throws DbException
188:      */
189:     public function isBindService($uid, ?int $except = null)
190:     {
191:         // 从StoreService获取数据库实例，并构造查询条件
192:         // 首先，查询与用户ID($uid)匹配的记录
193:         return StoreService::getDB()->where('uid', $uid)
194:             // 如果提供了$except参数，则添加额外的查询条件，排除特定ID
195:             ->when($except, function ($query, $except) {
196:                 $query->where($this->getPk(), '<>', $except);
197:             })
198:             // 确保查询不包括已删除的记录
199:             ->where('is_del', 0)
200:             // 计算满足条件的记录数，如果大于0，则表示用户绑定了服务
201:             ->count($this->getPk()) > 0;
202:     }
203: 
204:     /**
205:      * 删除记录
206:      *
207:      * 本函数用于标记指定ID的数据记录为删除状态。在实际数据库操作中，并不直接物理删除记录，
208:      * 而是通过将记录的is_del字段设置为1来表示该记录已被删除。这种方式可以避免因误删导致的数据损失，
209:      * 同时也便于后续如果需要恢复数据或进行数据清理工作。
210:      *
211:      * @param int $id 需要被标记为删除的记录的ID
