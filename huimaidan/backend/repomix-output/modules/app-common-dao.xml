213:      * @throws DbException
214:      */
215:     public function delete(int $id)
216:     {
217:         // 通过StoreService获取数据库操作对象，并构造SQL语句，更新指定ID的记录的is_del字段为1
218:         return StoreService::getDB()->where($this->getPk(), $id)->update(['is_del' => 1]);
