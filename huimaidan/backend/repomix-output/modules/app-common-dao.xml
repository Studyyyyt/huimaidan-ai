  38: class StoreOrderDao extends BaseDao
  39: {
  40:     //订单状态（0：待发货；1：待收货；2：待评价；3：已完成； 9: 拼团中 10:  待付尾款 11:尾款超时未付 -1：已退款）
  41:     const ORDER_STATUS_BE_SHIPPED = 0;
  42:     const ORDER_STATUS_BE_RECEIVE = 1;
  43:     const ORDER_STATUS_REPLY = 2;
  44:     const ORDER_STATUS_SUCCESS = 3;
  45:     const ORDER_STATUS_SPELL = 9;
  46:     const ORDER_STATUS_TAIL = 10;
  47:     const ORDER_STATUS_TAIL_FAIL = 11;
  48:     const ORDER_STATUS_REFUND = -1;
  49: 
  50: 
  51:     /**
  52:      * @return string
  53:      * @author xaboy
