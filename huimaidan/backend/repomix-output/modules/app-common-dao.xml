 61:             $roleModel = $roleModel->where('status', intval($where['status']));
 62:         }
 63: 
 64:         if(isset($where['is_organization']) && $where['is_organization'] !== '') {
 65:             $roleModel = $roleModel->where('is_agent', '>', 0);
 66:         }
