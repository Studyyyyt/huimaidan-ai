391:      * 本函数通过查询用户表和订单表的数据，获取指定用户($uid)的订单总额、订单数量以及相关的会员信息。
392:      * 查询条件限定为已支付的订单，并且只统计当天的订单数据。同时，如果存在预售订单，也会一并统计其支付金额。
393:      *
394:      * @param int $uid 用户ID
395:      * @return object|null 返回用户订单详情的对象，包含订单总额、订单数量等信息；如果未找到相关数据，则返回null。
396:      */
397:     public function userOrderDetail($uid)
398:     {
399:         // 构建查询语句，从用户表和订单表中获取所需数据
400:         $info = User::getDB()->alias('A')->with(['group','spread','memberIcon'])
401:             ->leftJoin('StoreOrder B', 'A.uid = B.uid and B.paid = 1 and B.pay_time between \'' . date('Y/m/d', strtotime('first day of')) . ' 00:00:00\' and \'' . date('Y/m/d H:i:s') . '\'')
402:             ->leftJoin('PresellOrder C', 'C.order_id = B.order_id and C.paid = 1')
403:             ->field('A.*, sum(B.pay_price + IFNULL(C.pay_price,0)) as total_pay_price, count(B.order_id) as total_pay_count,is_svip,svip_endtime,svip_save_money')
404:             ->where('A.uid', $uid)
405:             ->find()->append(['userLabel']);
406: 
407:         // 如果查询结果存在，则进行额外的信息处理
408:         if(!empty($info)){
409:             // 处理会员等级和团ID的空值问题
410:             $info->member_level = $info->member_level ?: '';
411:             $info->group_id = $info->group_id ?: '';
412:             // 删除用户敏感信息字段，这些信息不应该在订单详情中展示
413:             // 删除扩展信息默认字段，影响用户编辑
414:             unset($info['real_name']);
415:             unset($info['sex']);
416:             unset($info['birthday']);
417:             unset($info['addres']);
418:         }
419: 
420:         // 返回处理后的用户订单详情信息
421:         return $info;
422:     }
