350:                                     case CrudFormEnum::FORM_CASCADER_ADDRESS:
351:                                         $tags  = is_array($search['value']) ? $search['value'] : explode(',', $search['value']);
352:                                         $query = $query->where(function ($query) use ($tags, $fieldName) {
353:                                             foreach ($tags as $i => $tag) {
354:                                                 if ($i) {
355:                                                     $query->whereOr($fieldName, 'like', '%/' . $tag . '/%');
356:                                                 } else {
357:                                                     $query->where($fieldName, 'like', '%/' . $tag . '/%');
358:                                                 }
359:                                             }
360:                                         });
361:                                         break;
362:                                     case CrudFormEnum::FORM_CASCADER_RADIO:
363:                                         $query = $query->where(function ($query) use ($search, $fieldName) {
364:                                             foreach ($search['value'] as $i => $val) {
365:                                                 $val = implode('/', $val);
366:                                                 if ($i) {
367:                                                     $query->whereOr($fieldName, 'like', '%/' . $val . '/%');
368:                                                 } else {
369:                                                     $query->where($fieldName, 'like', '%/' . $val . '/%');
370:                                                 }
371:                                             }
372:                                         });
373:                                         break;
374:                                     default:
375:                                         $query = $query->whereIn($fieldName, is_array($search['value']) ? $search['value'] : explode(',',$search['value']));
376:                                         break;
377:                                 }
378:                             } else {
379:                                 $query = $query->whereIn($fieldName, is_array($search['value']) ? $search['value'] : [$search['value']]);
380:                             }
381:                             break;
382:                         case CrudOperatorEnum::OPERATOR_NOT_IN:
383:                             if (isset($search['form_value'])) {
384:                                 switch ($search['form_value']) {
385:                                     case CrudFormEnum::FORM_INPUT:
386:                                     case CrudFormEnum::FORM_TEXTAREA:
387:                                         if (is_array($search['value'])) {
388:                                             $search['value'] = json_encode($search['value']);
389:                                         }
390:                                         $query = $query->whereNot($fieldName, 'LIKE', '%' . $search['value'] . '%');
391:                                         break;
392:                                     case CrudFormEnum::FORM_CASCADER_RADIO:
393:                                         $query = $query->whereNot(function ($query) use ($search, $fieldName) {
394:                                             foreach ($search['value'] as $i => $val) {
395:                                                 $val = implode('/', $val);
396:                                                 if ($i) {
