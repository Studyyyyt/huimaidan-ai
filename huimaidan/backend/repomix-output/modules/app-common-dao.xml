246:     /**
247:      * 根据订单ID数组计算退款总额
248:      *
249:      * 本函数通过查询数据库，计算指定订单ID列表中状态为3（假设代表已退款）的订单的退款总额。
250:      * 使用了whereIn和where方法来筛选订单ID和订单状态，sum方法用于计算退款金额总和。
251:      *
252:      * @param array $orderIds 订单ID数组，用于查询指定订单的退款金额
253:      * @return float 返回计算得到的退款总额
254:      */
255:     public function refundPirceByOrder(array $orderIds)
256:     {
257:         // 调用getModel方法获取模型实例，然后通过该实例的getDB方法获取数据库连接
258:         // 使用whereIn方法筛选出订单ID在指定数组中的记录，再使用where方法筛选出状态为3的记录
259:         // 最后使用sum方法计算这些记录的refund_price列的总和，并返回该值
260:         return $this->getModel()::getDB()->whereIn('order_id', $orderIds)->where('status', 3)->sum('refund_price');
261:     }
