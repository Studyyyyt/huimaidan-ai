39:     /**
40:      * 根据条件搜索商店服务回复信息。
41:      *
42:      * 该方法通过接收一个包含搜索条件的数组，动态地构造数据库查询语句，以筛选出符合条件的商店服务回复记录。
43:      * 支持的搜索条件包括：商家ID（mer_id）、关键词（keyword）和状态（status）。
44:      *
45:      * @param array $where 搜索条件数组，包含可能的字段：mer_id、keyword、status。
46:      * @return \Illuminate\Database\Query\Builder|StoreServiceReply 查询构造器或者StoreServiceReply实例。
47:      */
48:     public function search(array $where)
49:     {
50:         // 获取数据库查询构建器
51:         return StoreServiceReply::getDB()
52:             // 当'mer_id'字段存在且不为空时，添加where条件筛选商家ID
53:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
54:                 $query->where('mer_id', $where['mer_id']);
55:             })
56:             // 当'keyword'字段存在且不为空时，添加like条件筛选关键词
57:             ->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
58:                 $query->whereLike('keyword', "%{$where['keyword']}%");
59:             })
60:             // 当'status'字段存在且不为空时，添加where条件筛选状态
61:             ->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
62:                 $query->where('status', $where['status']);
63:             });
64:     }
65: 
66:     /**
67:      * 根据有效数据查询关键词
68:      * 本函数旨在通过特定的关键词和商家ID，从数据库中检索有效的关键词信息。
69:      * 这里的“有效”指的是关键词处于激活状态（status=1）且属于指定的商家（mer_id）。
70:      *
71:      * @param string $key 关键词，用于搜索匹配。
72:      * @param int $merId 商家ID，用于限定搜索范围。
73:      * @return array|null 返回匹配条件的关键词数据数组，如果找不到则返回null。
74:      */
75:     public function keywordByValidData($key, $merId)
76:     {
77:         // 从StoreServiceReply的数据库实例中查询
78:         // 使用where函数构建复杂的查询条件，首先搜索包含关键词的关键字
79:         // 然后搜索关键词列表中包含该关键词的数据
80:         // 最后限定查询条件为状态为1且属于指定商家ID的数据
81:         return StoreServiceReply::getDB()->where(function ($query) use ($key) {
82:             // 搜索关键词字段中包含$key的数据
83:             $query->where('keyword', 'like', "%{$key}%")
84:                 // 搜索关键词以逗号分隔的列表中包含$key的数据
85:                 ->whereFieldRaw('CONCAT(\',\',`keyword`,\',\')', 'LIKE', '%,' . $key . ',%', 'OR');
86:         })->where('status', 1)->where('mer_id', $merId)->find();
87:     }
88: }
