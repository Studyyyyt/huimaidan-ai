281:      * @return array 返回符合查询条件的服务信息数组，如果未找到则返回空数组。
282:      * @throws DataNotFoundException
283:      * @throws DbException
284:      * @throws ModelNotFoundException
285:      */
286:     public function getValidServiceInfo($id)
287:     {
288:         // 通过StoreService类的getDB方法获取数据库操作对象
289:         // 然后使用where方法指定查询条件，包括服务ID、服务状态、是否开启以及是否被删除
290:         // 最后使用hidden方法隐藏is_del字段，不将其返回给调用者
291:         // 返回查询结果，如果不存在符合要求的服务，则返回空数组
292:         return StoreService::getDB()->where('service_id', $id)->where('is_open',1)->where('status', 1)->where('is_del', 0)->hidden(['is_del'])->find();
293:     }
294: 
295:     /**
296:      * 获取通知服务信息
297:      *
