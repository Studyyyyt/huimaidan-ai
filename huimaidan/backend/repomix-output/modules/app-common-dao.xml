295:     private function buildOrderSql($where)
296:     {
297:         $orderMappings = [
298:             'none'          => '',
299:             'is_new'        => 'P.is_new DESC,',
300:             'rate'          => 'P.rate DESC,',
301:             'sort'          => 'P.sort DESC,',
302:             'sales'         => 'P.sales DESC,',
303:             'range_asc'     => 'P.sort DESC,',
304:             'price_asc'     => 'S.price ASC,',
305:             'price_desc'    => 'S.price DESC,',
306:             'sales_asc'     => 'P.sales ASC,',
307:             'sales_desc'    => 'P.sales DESC,',
308:             'ot_price'      => 'S.ot_price DESC,',
309:             'ot_price_asc'  => 'S.ot_price ASC,',
310:             'ot_price_desc' => 'S.ot_price DESC,',
311:             'distance_asc'  => 'S.star ASC,S.rank ASC,',
312:             'distance_desc' => 'S.star DESC,S.rank DESC,',
313:         ];
314:         if(!isset($where['order'])){
315:             $where['order'] = 'none';
316:         }
317:         $order = ($orderMappings[$where['order']] ?? '') . 'S.create_time DESC';
318:         return $order;
319:     }
