21:     }
22: 
23: 
24:     /**
25:      * 根据条件搜索团购信息
26:      *
27:      * 本函数用于构建并返回一个根据指定条件搜索产品团购信息的查询语句。
28:      * 它支持多种搜索条件，包括商家ID、日期、状态、用户名、关键词和是否为交易者等。
29:      * 搜索功能通过动态拼接查询条件来实现，以适应不同的搜索需求。
30:      *
31:      * @param array $where 搜索条件数组，包含各种可能的搜索参数。
32:      * @return \yii\db\ActiveQuery 返回构建的查询语句对象。
33:      */
34:     public function search($where)
35:     {
36:         // 初始化查询，从ProductGroupBuying表开始，使用别名B
37:         $query = ProductGroupBuying::getDb()->alias('B')
38:             // 加入StoreProductGroup表，通过product_group_id关联
39:             ->join('StoreProductGroup G','B.product_group_id = G.product_group_id');
40:         // 分组权限
41:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
42:             $query->whereIn('B.mer_id', $region);
43:         }
44:         // 动态添加条件：根据商家ID搜索
45:         $query
46:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '', function($query)use($where){
47:                 // 如果指定了商家ID，则添加到查询条件中
48:                 $query->where('B.mer_id',$where['mer_id']);
49:             })
50:             // 动态添加条件：根据日期搜索
51:             ->when(isset($where['date']) && $where['date'] , function($query)use($where){
52:                 // 如果指定了日期，则调用getModelTime函数处理，并添加到查询条件中
53:                 getModelTime($query,$where['date'],'B.create_time');
54:             })
55:             // 动态添加条件：根据状态搜索
56:             ->when(isset($where['status']) && $where['status'] !== '', function($query)use($where){
57:                 // 如果指定了状态，则添加到查询条件中
58:                 $query->where('B.status',$where['status']);
59:             })
60:             // 动态添加条件：根据用户名搜索
61:             ->when(isset($where['user_name']) && $where['user_name'] !== '', function($query)use($where){
62:                 // 加入StoreProductGroupUser表，通过group_buying_id关联
63:                 // 并搜索初始化者（is_initiator=1），用户名（uid|nickname）包含搜索关键字
64:                 $query->join('StoreProductGroupUser U','U.group_buying_id = B.group_buying_id')
65:                     ->where('is_initiator',1)
66:                     ->whereLike('uid|nickname',"%{$where['user_name']}%");
67:             })
68:             // 动态添加条件：根据关键词搜索
69:             ->when(isset($where['keyword']) && $where['keyword'] !== '' , function($query)use($where){
70:                 // 加入StoreProduct表，通过product_id关联
71:                 // 搜索团购ID、产品ID或商店名称包含搜索关键字
72:                 $query->join('StoreProduct P','G.product_id = P.product_id')
73:                     ->whereLike('B.group_buying_id|P.product_id|store_name',"%{$where['keyword']}%");
74:             })
75:             // 动态添加条件：根据是否为交易者搜索
76:             ->when(isset($where['is_trader']) && $where['is_trader'] !== '', function($query)use($where){
77:                 // 加入Merchant表，通过mer_id关联
78:                 // 并根据是否为交易者（is_trader）进行筛选
79:                 $query->join('Merchant M','M.mer_id = B.mer_id')->where('is_trader',$where['is_trader']);
80:             })
81:         ;
82: 
83:         // 返回构建好的查询语句
84:         return $query;
85:     }
86: }
