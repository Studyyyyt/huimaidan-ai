 44:     /**
 45:      * 根据条件搜索商店信息。
 46:      *
 47:      * 该方法通过接收一个包含各种搜索条件的数组，来查询数据库中符合这些条件的商店信息。
 48:      * 查询时，只会返回未被删除的商店（is_del为0）。此外，可以根据传入的条件如状态、关键字、商家ID等进行过滤。
 49:      * 这种灵活的查询方法允许根据不同的需求组合各种搜索条件，以获取精确的搜索结果。
 50:      *
 51:      * @param array $where 包含搜索条件的数组，每个条件对应数据库表中的一个字段。
 52:      * @return BaseQuery 返回一个构建器对象，可用于进一步的查询操作或获取结果。
 53:      */
 54:     public function search(array $where)
 55:     {
 56:         // 从StoreService中获取数据库实例，并初始化查询构建器
 57:         return StoreService::getDB()->where('is_del', 0)->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
 58:             // 如果指定了状态，则添加状态条件到查询
 59:             $query->where('status', $where['status']);
 60:         })->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
 61:             // 如果指定了关键字，则添加模糊搜索条件到查询
 62:             $query->whereLike('nickname', "%{$where['keyword']}%");
 63:         })->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
 64:             // 如果指定了商家ID，则添加商家ID条件到查询
 65:             $query->where('mer_id', $where['mer_id']);
 66:         })->when(isset($where['customer']) && $where['customer'] !== '', function ($query) use ($where) {
 67:             // 如果指定了客户名称，则添加客户名称条件到查询
 68:             $query->where('customer', $where['customer']);
 69:         })->when(isset($where['is_verify']) && $where['is_verify'] !== '', function ($query) use ($where) {
 70:             // 如果指定了验证状态，则添加验证状态条件到查询
 71:             $query->where('is_verify', $where['is_verify']);
 72:         })->when(isset($where['is_goods']) && $where['is_goods'] !== '', function ($query) use ($where) {
 73:             // 如果指定了商品状态，则添加商品状态条件到查询
 74:             $query->where('is_goods', $where['is_goods']);
 75:         })->when(isset($where['is_open']) && $where['is_open'] !== '', function ($query) use ($where) {
 76:             // 如果指定了营业状态，则添加营业状态条件到查询
 77:             $query->where('is_open', $where['is_open']);
 78:         })->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
 79:             // 如果指定了用户ID，则添加用户ID条件到查询
 80:             $query->where('uid', $where['uid']);
 81:         })->when(isset($where['service_id']) && $where['service_id'] !== '', function ($query) use ($where) {
 82:             // 如果指定了服务ID，则添加服务ID条件到查询
 83:             $query->where('service_id', $where['service_id']);
 84:         });
 85:     }
 86: 
 87:     /**
 88:      * 根据用户ID和可选的商户ID获取服务信息
 89:      *
 90:      * 此方法用于查询与特定用户相关联的服务信息。它允许指定一个可选的商户ID来过滤结果，
 91:      * 仅返回属于该商户的服务。这是在处理多商户系统中，针对特定用户和商户的服务查询的常见需求。
 92:      *
 93:      * @param int $uid 用户ID。这是查询服务所必需的参数，用于确定服务与哪个用户相关联。
 94:      * @param int|null $merId 商户ID。这是一个可选参数，用于进一步筛选服务，只返回属于指定商户的服务。
 95:      *                       如果未提供此参数，则查询将不考虑商户过滤，返回与用户相关联的所有服务。
 96:      * @return array|null 返回符合查询条件的服务信息数组。如果找不到符合条件的服务，则返回null。
 97:      * @throws DataNotFoundException
 98:      * @throws DbException
 99:      * @throws ModelNotFoundException
100:      */
101:     public function getService($uid, $merId = null)
102:     {
103:         // 从StoreService中获取数据库实例，并构建查询条件
104:         return StoreService::getDB()->where('uid', $uid)->when(!is_null($merId), function ($query) use($merId) {
105:             // 如果提供了商户ID，则添加额外的查询条件来过滤商户
106:             $query->where('mer_id', $merId);
107:         })->where('is_del', 0)->where('is_open',1)->find();
108:     }
109: 
110:     /**
111:      * 检查指定字段是否存在指定值（且未被删除）。
112:      *
113:      * 此方法用于查询数据库中是否存在指定字段的值，并且该记录没有被删除。
114:      * 可以通过传递一个排除ID来排除特定的记录。
115:      *
116:      * @param string $field 要检查的字段名。
117:      * @param mixed $value 字段应该具有的值。
118:      * @param int|null $except 排除的ID，可选参数，用于排除特定的记录。
119:      * @return bool 如果找到符合条件的记录，则返回true，否则返回false。
120:      */
121:     public function fieldExists($field, $value, ?int $except = null): bool
122:     {
123:         // 初始化查询，查询具有指定字段值并且未被删除的记录
124:         $query = ($this->getModel())::getDB()->where($field, $value)->where('is_del', 0);
125: 
126:         // 如果提供了排除ID，则添加条件以排除该ID的记录
127:         if (!is_null($except)) {
128:             $query->where($this->getPk(), '<>', $except);
129:         }
130: 
131:         // 返回查询结果是否存在，即记录数是否大于0
132:         return $query->count() > 0;
133:     }
