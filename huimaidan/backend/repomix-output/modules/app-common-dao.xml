193:      * 该方法用于确定数据库中是否存在指定ID且满足特定条件的管理员。
194:      * 它支持根据商家ID和级别进一步筛选结果。
195:      *
196:      * @param int $id 管理员的唯一标识ID。
197:      * @param int $merId 商家ID，用于指定特定商家的管理员。默认为0，表示不进行商家ID的筛选。
198:      * @param int|null $level 管理员级别，用于指定特定级别的管理员。如果为null，则不进行级别筛选。
199:      * @return bool 如果找到满足条件的管理员返回true，否则返回false。
200:      */
201:     public function exists(int $id, int $merId = 0, ?int $level = null)
202:     {
203:         // 初始化查询，根据管理员ID和是否已删除进行筛选
204:         $query = MerchantAdmin::getDB()->where($this->getPk(), $id)->where('is_del', 0);
205: 
206:         // 如果提供了商家ID，则进一步根据商家ID进行筛选
207:         if ($merId) $query->where('mer_id', $merId);
208: 
209:         // 如果提供了级别，则进一步根据级别进行筛选
210:         if (!is_null($level)) $query->where('level', $level);
211: 
212:         // 返回查询结果是否存在，存在返回true，否则返回false
213:         return $query->count() > 0;
214:     }
