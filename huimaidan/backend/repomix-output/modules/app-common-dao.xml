299:      * 通过筛选条件，获取到满足条件的记录中与通知服务相关的用户ID、电话和昵称信息。
300:      * 主要用于通知服务的查询和管理，确保通知对象的准确性和有效性。
301:      *
302:      * @param string $merId 商户ID，用于指定查询的商户范围。
303:      * @return array 返回一个包含用户ID、电话和昵称的数组，数组中的每个元素代表一个满足条件的通知服务对象。
304:      */
305:     public function getNoticeServiceInfo($merId)
306:     {
307:         // 使用StoreService的数据库操作对象，查询满足条件的通知服务信息。
308:         // 条件包括：商户ID为$merId，状态为启用，通知开启，未被删除。
309:         // 返回查询结果中uid, phone, nickname字段组成的列数组。
310:         return StoreService::getDB()->where('mer_id', $merId)->where('status', 1)->where('notify', 1)
311:             ->where('is_del', 0)->column('uid,phone,nickname');
312:     }
313: 
314: 
315:     /**
316:      * 将指定记录的状态设置为关闭
317:      *
318:      * 本函数通过传入的ID和字段名称，更新对应记录的状态为关闭（0）。
319:      * 主要用于在数据库中更新某些实体的状态，例如文章、订单等的关闭操作。
320:      *
321:      * @param int $id 主键ID，用于定位特定记录
322:      * @param string $field 需要与ID匹配的字段名称，允许灵活指定字段进行匹配而非固定主键
323:      */
324:     public function close($id,$field)
325:     {
326:         // 使用模型获取数据库实例，并通过where子句指定条件，更新记录的状态为0（关闭）
327:         $this->getModel()::getDB()->where($field, $id)->update(['status' => 0]);
328:     }
