189:     /**
190:      * 更新附件路径。
191:      * 当旧路径被新路径替换时，此方法用于更新所有关联的附件路径。
192:      * 主要用于处理附件分类路径的更新，确保路径更新后仍符合系统规定的最多三级分类的要求。
193:      *
194:      * @param string $oldPath 旧的附件路径。
195:      * @param string $path 新的附件路径。
196:      *
197:      * @throws ValidateException 如果新路径超过三级分类限制，则抛出验证异常。
198:      */
199:     public function updatePath(string $oldPath, string $path)
200:     {
201:         // 使用like查询匹配以旧路径开头的所有附件分类记录，并选择需要的字段
202:         AttachmentCategory::getDB()->whereLike('path', $oldPath . '%')->field('attachment_category_id,path')->select()->each(function ($val) use ($oldPath, $path) {
203:             // 替换记录中的旧路径为新路径
204:             $newPath = str_replace($oldPath, $path, $val['path']);
205:             // 检查新路径是否超过三级分类的限制
206:             if (substr_count(trim($newPath, '/'), '/') > 1) {
207:                 throw new ValidateException('素材分类最多添加三级');
208:             }
209:             // 更新附件分类的路径
210:             AttachmentCategory::getDB()->where('attachment_category_id', $val['attachment_category_id'])->update(['path' => $newPath]);
211:         });
212:     }
213: }
