 13: namespace app\common\dao\store\product;
 14: 
 15: use app\common\dao\BaseDao;
 16: use app\common\model\store\product\ProductAssist;
 17: use app\common\repositories\store\product\SpuRepository;
 18: use app\common\repositories\system\merchant\MerchantRepository;
 19: 
 20: class ProductAssistDao extends BaseDao
 21: {
 22:     protected function getModel(): string
 23:     {
 24:         return ProductAssist::class;
 25:     }
 26: 
 27:     /**
 28:      * 商品查询条件
 29:      * @param array $where
 30:      * @return \think\db\BaseQuery
 31:      * @author wuhaotian
 32:      * @email 442384644@qq.com
 33:      * @date 2024/7/16
 34:      */
 35:     public function search(array $where)
 36:     {
 37:         $query = ProductAssist::hasWhere('product',function($query)use($where){
 38:             $query->when(isset($where['product_show']) && $where['product_show'] !== '',function($query)use($where){
 39:                     $query->where('is_del',0)->where('mer_status',1)->where('product_type',3);
 40:                 })
 41:                 ->where('status',1);
 42:         });
 43:         // 分组权限
 44:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
 45:             $query->whereIn('ProductAssist.mer_id', $region);
 46:         }
 47:         $query->join('StoreSpu U', 'Product.product_id = U.product_id')->where('U.product_type', 3);
 48:         $query->when(isset($where['product_assist_id']) && $where['product_assist_id'] !== '',function($query)use($where){
 49:                 $query->where('product_assist_id',$where['product_assist_id']);
 50:             })
 51:             ->when(isset($where['keyword']) && $where['keyword'] !== '',function($query)use($where){
 52:                 $query->whereLike('ProductAssist.store_name|ProductAssist.product_id',"%{$where['keyword']}%");
 53:             })
 54:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '',function($query)use($where){
 55:                 if(is_array($where['mer_id'])) {
 56:                     $query->whereIn('ProductAssist.mer_id', $where['mer_id']);
 57:                 } else {
 58:                     $query->where('ProductAssist.mer_id',$where['mer_id']);
 59:                 }
 60:             })
 61:             ->when(isset($where['type']) && $where['type'] !== '',function($query)use($where){
 62:                 switch ($where['type']){
 63:                     case 0: //未开始
 64:                         $query->whereTime('start_time','>',time());
 65:                         break;
 66:                     case 1: //进行中
 67:                         $query->whereTime('start_time','<=',time())->whereTime('end_time','>',time())
 68:                         ->where('ProductAssist.product_status',1)->where('ProductAssist.status',1)->where('ProductAssist.is_show',1);
 69:                         break;
 70:                     case 2: //已结束
 71:                         $query->where(function($query){
 72:                             $query->where('action_status',-1)->whereOr('end_time','<= TIME',time());
 73:                         });
 74:                         break;
 75:                 }
 76:             })
 77:             ->when(isset($where['status']) && $where['status'] !== '',function($query)use($where){
 78:                 $query->where('ProductAssist.status',$where['status']);
 79:             })
 80:             ->when(isset($where['is_show']) && $where['is_show'] !== '',function($query)use($where){
 81:                 $query->where('ProductAssist.is_show',$where['is_show']);
 82:             })
 83:             ->when(isset($where['is_del']) && $where['is_del'] !== '',function($query)use($where){
 84:                 $query->where('ProductAssist.is_del',$where['is_del']);
 85:             })
 86:             ->when(isset($where['mer_name']) && $where['mer_name'] !== '',function($query)use($where){
 87:                 $make = app()->make(MerchantRepository::class);
 88:                 $mer_id = $make->search(['keyword' => $where['mer_name']])->column('mer_id');
 89:                 $query->whereIn('ProductAssist.mer_id',$mer_id);
 90:             })
 91:             ->when(isset($where['product_status']) && $where['product_status'] !== '',function($query)use($where){
 92:                 if($where['product_status'] == -1){
 93:                     $query->where('ProductAssist.product_status','in',[-1,-2]);
 94:                 }else{
 95:                     $query->where('ProductAssist.product_status',$where['product_status']);
 96:                 }
 97:             })
 98:             ->when(isset($where['is_trader']) && $where['is_trader'] !== '',function($query)use($where){
 99:                 $make = app()->make(MerchantRepository::class);
100:                 $mer_id = $make->search(['is_trader' => $where['is_trader']])->column('mer_id');
101:                 $query->whereIn('ProductAssist.mer_id',$mer_id);
102:             })
103:             ->when(isset($where['us_status']) && $where['us_status'] !== '',function($query)use($where){
104:                 if($where['us_status'] == 0) {
105:                     $query->where('ProductAssist.is_show',0)->where('ProductAssist.status',1)->where('ProductAssist.product_status',1);
106:                 }
107:                 if($where['us_status'] == 1) {
108:                     $query->where('ProductAssist.is_show',1)->where('ProductAssist.status',1)->where('ProductAssist.product_status',1);
109:                 }
110:                 if($where['us_status'] == -1) {
111:                     $query->where(function($query){
112:                         $query->where('ProductAssist.status',0)->whereOr('ProductAssist.product_status','<>',1);
113:                     });
114:                 }
115:             })
116:             ->when(isset($where['mer_labels']) && $where['mer_labels'] !== '', function ($query) use ($where) {
117:                 $query->whereLike('U.mer_labels', "%,{$where['mer_labels']},%");
118:             })
119:             ->when(isset($where['sys_labels']) && $where['sys_labels'] !== '', function ($query) use ($where) {
120:                 $query->whereLike('U.sys_labels', "%,{$where['sys_labels']},%");
121:             })
122:             ->when(isset($where['star']),function($query)use($where){
123:                 $query->when($where['star'] !== '', function ($query) use ($where) {
124:                     $query->where('U.star', $where['star']);
125:                 });
126:                 $query->order('U.star DESC,U.rank DESC,ProductAssist.create_time DESC');
127:             });
128:         $query->where('ProductAssist.is_del',0);
129:         return $query;
130:     }
131: 
132:     /**
133:      *  移动端展示 条件
134:      * @return array
135:      * @author Qinii
136:      * @day 2020-10-19
137:      */
138:     public function assistShow()
139:     {
140:         return [
141:             'product_show' => 1,
142:             'product_status' => 1,
143:             'status' => 1,
144:             'is_show' => 1,
145:             'type' => 1,
146:             'is_del' => 0
147:         ];
148:     }
149: 
150:     /**
151:      * 检查并更新过期活动的状态
152:      * 该方法用于定期检查所有活动的结束时间，如果活动已经结束，则将其状态设置为失效（-1）。
153:      * 同时，它也会更新关联的SPU（Special Product Unit）的状态，将这些SPU的活动状态设置为失效。
154:      * 这样做的目的是为了维护数据库中活动和SPU状态的准确性，确保只有当前有效的活动和SPU被展示或参与。
155:      */
156:     public function valActiveStatus()
157:     {
158:         // 根据当前时间，查询所有已经结束的活动，这些活动的状态为1（进行中）
159:         $query = $this->getModel()::getDB()->whereTime('end_time','<=',time())->where('action_status',1);
160:         // 获取这些活动的ID
161:         $id = $query->column($this->getPk());
162: 
163:         // 如果查询到了已结束的活动ID
164:         if($id) {
165:             // 更新这些活动的状态为-1（失效）
166:             $this->getModel()::getDB()->where($this->getPk(),'in',$id)->update(['action_status' => -1]);
167:             // 准备更新SPU状态的条件，特定类型的SPU且关联的活动ID在已结束的活动中
168:             $where = [
169:                 'product_type' => 3,
170:                 'activity_ids' => $id
171:             ];
172:             // 更新所有符合条件的SPU的状态为0（失效）
173:             app()->make(SpuRepository::class)->getSearch($where)->update(['status' => 0]);
174:         }
175:     }
176: 
177: 
178:     /**
179:      *  软删除商户的所有商品
180:      * @param $merId
181:      * @author Qinii
182:      * @day 5/15/21
183:      */
184:     public function clearProduct($merId)
185:     {
186:         $this->getModel()::getDb()->where('mer_id', $merId)->update(['is_del' => 1]);
187:     }
188: }
