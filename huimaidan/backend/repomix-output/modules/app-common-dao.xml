144:     /**
145:      * 检查指定ID的产品回复是否存在且未被删除。
146:      *
147:      * 本函数通过查询数据库来确定给定ID的产品回复是否存在，同时确保该记录没有被标记为删除。
148:      * 存在并未被删除的条件是通过查询满足ID匹配和is_del字段为0（未删除）的记录数来判断的。
149:      * 如果存在至少一条满足条件的记录，则认为该产品回复存在。
150:      *
151:      * @param int $id 需要检查的产品回复的唯一标识ID。
152:      * @return bool 如果产品回复存在且未被删除，则返回true；否则返回false。
153:      * @throws DbException
154:      */
155:     public function exists(int $id)
156:     {
157:         // 构建查询条件，查询满足ID和未删除条件的记录数
158:         return ProductReply::getDB()->where($this->getPk(), $id)->where('is_del', 0)->count() > 0;
159:     }
160: 
161:     /**
162:      * 检查指定商户是否存在指定ID的商品回复
163:      *
164:      * 本函数通过查询数据库来确定是否存在某个特定商户（通过$merId指定）发布的商品回复（通过$id指定）
165:      * 并且该回复未被删除（is_del字段为0）。
166:      *
167:      * @param string $merId 商户ID，用于指定查询的商户范围
168:      * @param int $id 商品回复的ID，用于指定查询的具体回复
169:      * @return bool 如果存在符合条件的商品回复，则返回true，否则返回false
170:      * @throws DbException
171:      */
172:     public function merExists($merId, int $id)
173:     {
174:         // 使用数据库查询工具，根据指定条件查询商品回复记录的数量
175:         // 条件包括：主键ID为$id，未被删除（is_del为0），以及商户ID为$merId
176:         return ProductReply::getDB()->where($this->getPk(), $id)->where('is_del', 0)->where('mer_id', $merId)->count() > 0;
177:     }
178: 
179:     /**
180:      * 删除产品回复
181:      *
182:      * 本函数用于标记一个产品回复为已删除，并将该信息推送到队列中以更新相关产品的回复数量。
183:      * 删除操作是通过修改数据库中对应记录的is_del字段来实现的，而不是物理删除记录。
184:      * 使用队列来异步处理产品回复数量的更新，可以提高系统的响应速度和处理能力。
185:      *
186:      * @param int $id 回复的唯一标识符，用于在数据库中定位到具体的回复记录。
187:      * @throws DbException
188:      * @throws \think\db\exception\DataNotFoundException
189:      * @throws \think\db\exception\ModelNotFoundException
190:      */
191:     public function delete(int $id)
192:     {
193:         // 根据$id查询数据库中的回复记录
194:         $reply = ProductReply::getDB()->where('reply_id', $id)->find();
195:         // 将查询到的回复记录的is_del字段设置为1，标记为已删除
196:         $reply->is_del = 1;
197:         // 保存修改，更新数据库中的记录
198:         $reply->save();
199:         // 将回复所属产品的ID推送到队列中，用于后续的异步更新产品回复数量
200:         Queue::push(UpdateProductReplyJob::class, $reply['product_id']);
201:     }
