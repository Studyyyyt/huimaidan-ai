35:      * @return \Illuminate\Database\Eloquent\Builder|static 返回一个构建器对象，用于进一步的查询操作或数据检索。
36:      */
37:     public function search(array $where)
38:     {
39:         // 从模型中获取数据库实例，并根据条件应用订单ID的筛选。
40:         $query = $this->getModel()::getDB()
41:             ->when(isset($where['order_id']) && $where['order_id'] !== '', function($query) use ($where) {
42:                 // 如果提供了订单ID，并且不为空，则在查询中添加订单ID的条件。
