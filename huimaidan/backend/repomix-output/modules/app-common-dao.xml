 41:         $res  = $this->getModel()::getDb()->find($id);
 42: 
 43:         // 更新所有不属于当前商家的默认记录状态为未使用（0）
 44:         $this->getModel()::getDb()->where('mer_id', $merId)->where('is_default' ,0)->update(['status'=>0]);
 45: 
 46:         // 如果当前记录不是默认记录，则将其状态设置为使用中（1）
 47:         if (!$res['is_default']) {
 48:             $this->getModel()::getDb()->where('mer_id', $merId)->where('id',$id)->update(['status'=> 1]);
 49:         }
 50:     }
