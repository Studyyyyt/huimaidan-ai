137:      */
138:     public function insertAll(array $data)
139:     {
140:         // 调用ProductReply类的静态方法getDB来获取数据库连接对象，并进一步调用insertAll方法插入数据
141:         return ProductReply::getDB()->insertAll($data);
142:     }
