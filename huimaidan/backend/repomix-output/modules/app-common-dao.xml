109:     /**
110:      * 根据规则ID获取关联的规则列表。
111:      * 该方法通过查询数据库，获取指定商家ID对应的所有状态为启用的规则，并将这些规则的ID合并为一个数组返回。
112:      * 这样做的目的是为了方便后续的操作，比如权限检查，可以快速地通过这个方法获取到一个商家的所有有效规则ID。
113:      *
114:      * @param int $merId 商家ID，用于查询特定商家的规则。
115:      * @param array $ids 规则ID数组，用于查询数据库中对应ID的规则。
116:      * @return array 返回一个包含所有规则ID的唯一数组。
117:      */
118:     public function idsByRules($merId, array $ids)
119:     {
120:         // 根据$merId和$ids查询数据库，获取所有状态为1的规则的rules字段
121:         $rules = Role::getDB()->where('status', 1)->where('mer_id', $merId)->whereIn($this->getPk(), $ids)->column('rules');
122: 
123:         // 初始化用于存储所有规则ID的数组
124:         $data = [];
125:         // 遍历查询结果，将每个规则的ID以逗号分隔并合并到$data数组中
126:         foreach ($rules as $rule) {
127:             $data = array_merge(explode(',', $rule), $data);
128:         }
129:         // 去除数组中的重复元素，确保每个规则ID只出现一次，并返回结果数组
130:         return array_unique($data);
