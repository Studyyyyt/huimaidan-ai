 97:             })
 98:             // 按商家类别ID分组，筛选支付金额大于0的记录，按支付金额降序排列
 99:             ->group('A.merchant_category_id')->where('pay_price', '>', 0)->order('pay_price DESC')->limit($limit)->select();
100:     }
