20: class MerchantReconciliationDao extends BaseDao
21: {
22:    public function getModel(): string
23:    {
24:        return model::class;
25:    }
26: 
27:    /**
28:     * 根据条件搜索数据。
29:     *
30:     * 该方法用于根据传入的条件数组来构建数据库查询条件，灵活地支持多种搜索逻辑，
31:     * 包括对特定字段的条件查询以及关键词的全文搜索。搜索条件的构建使用了Laravel的查询构建器，
32:     * 通过链式调用where和when方法来动态添加查询条件。
33:     *
34:     * @param array $where 搜索条件数组，包含各种可能的查询条件。
35:     * @return \Illuminate\Database\Eloquent\Builder|static 返回构建好的查询构建器实例，可用于进一步的操作或直接执行查询。
36:     */
37:    public function search(array $where)
38:    {
39:        // 获取模型对应的数据库实例
40:        $query = ($this->getModel()::getDB())
41:            // 当'mer_id'字段存在且不为空时，添加对'mer_id'字段的查询条件
42:            ->when(isset($where['mer_id']) && $where['mer_id'] != '' ,function($query)use($where){
43:                $query->where('mer_id',$where['mer_id']);
44:            })
45:            // 当'status'字段存在且不为空时，添加对'status'字段的查询条件
46:            ->when(isset($where['status']) && $where['status'] != '' ,function($query)use($where){
47:                $query->where('status',$where['status']);
48:            })
49:            // 当'is_accounts'字段存在且不为空时，添加对'is_accounts'字段的查询条件
50:            ->when(isset($where['is_accounts']) && $where['is_accounts'] != '' ,function($query)use($where){
51:                $query->where('is_accounts',$where['is_accounts']);
52:            })
53:            // 当'date'字段存在且不为空时，调用getModelTime函数添加对日期的查询条件
54:            ->when(isset($where['date']) && $where['date'] != '' ,function($query)use($where){
55:                getModelTime($query,$where['date']);
56:            })
57:            // 当'reconciliation_id'字段存在且不为空时，添加对'reconciliation_id'字段的查询条件
58:            ->when(isset($where['reconciliation_id']) && $where['reconciliation_id'] != '' ,function($query)use($where){
59:                $query->where('reconciliation_id',$where['reconciliation_id']);
60:            })
61:            // 当'keyword'字段存在且不为空时，执行关键词搜索逻辑
62:            ->when(isset($where['keyword']) && $where['keyword'] !== '',function($query)use($where){
63:                // 实例化管理员仓库，用于获取管理员ID列表
64:                $make = app()->make(AdminRepository::class);
65:                $admin_id = $make->getSearch(['real_name' => $where['keyword']],null,false)->column('admin_id');
66:                // 根据是否存在'mer_id'字段，构建不同的查询条件
67:                $query->where(function($query) use($admin_id,$where){
68:                    if(isset($where['mer_id'])){
69:                        $query->where('admin_id','in',$admin_id);
70:                    }else {
71:                        // 实例化商家仓库，用于获取商家ID列表
72:                        $mer_make = app()->make(MerchantRepository::class);
73:                        $mer_id = $mer_make->getSearch(['keyword' => $where['keyword']])->column('mer_id');
74:                        // 添加对管理员ID或商家ID的查询条件
75:                        $query->where('admin_id','in',$admin_id)->whereOr('mer_id','in',$mer_id);
76:                    }
77:                });
78:            });
79:        // 设置查询结果的排序方式
80:        return $query->order('create_time DESC,status DESC');
81:    }
