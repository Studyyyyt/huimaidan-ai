106:                 $query->whereLike('U.sys_labels', "%,{$where['sys_labels']},%");
107:             });
108:         if(isset($where['order'])) {
109:             switch ($where['order']) {
110:                 case 'sort':
111:                     $order = 'U.sort DESC';
112:                     break;
113:                 case 'rank':
114:                     $order = 'U.rank DESC';
115:                     break;
116:                 case 'star':
117:                     $order = 'U.star DESC,U.rank DESC';
118:                     break;
119:                 default:
120:                     $order = 'U.star DESC,U.rank DESC,U.sort DES';
121:                     break;
122:             }
123:             $query->order($order.',ProductGroup.create_time DESC');
124:         }
