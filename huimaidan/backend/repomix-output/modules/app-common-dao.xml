270:                 $field = 'P.product_id,O.pay_time paytime,O.pay_price as number,P.create_time, P.order_id,O.mer_id';
271:                 break;
272:             default:
273:                 $field = 'P.*';
274:                 break;
275:         }
276:         $query->when($mer_id, function ($query) use($mer_id) {
277:             $query->where('O.mer_id', $mer_id);
278:         })->when($date, function($query) use ($date) {
279:             getModelTime($query, $date,'P.create_time');
280:         })->whereNotNull('sp.product_id');
281: 
282:         return $query->field($field)->when(!empty($group), function ($query) use ($group) {
283:             $query->group($group);
284:         })->order("$type DESC,P.create_time DESC")->limit($limit)->select();
285:     }
286: 
287:     public function getReservationSum($productId, $date, $reservationId)
288:     {
289:         // 使用数据库查询语句，统计指定日期内已支付订单的商品总数
290:         $stock = StoreOrderProduct::getDB()->alias('A')
291:             ->leftJoin('StoreOrder B', 'A.order_id = B.order_id')
292:             ->where(function($query){
293:                $query->where('is_del',0)->whereOr(function($query){
294:                     $query->where('is_del',1)->where('paid',1);
295:                 });
296:             })
297:             ->where('B.status','<>',OrderStatus::ORDER_STATUS_REFUND)
298:             ->where('A.product_id', $productId)
299:             ->where('A.reservation_date', $date)
300:             ->where('A.reservation_id', $reservationId)
301:             ->sum('A.product_num');
302:         return $stock;
303:     }
304: }
