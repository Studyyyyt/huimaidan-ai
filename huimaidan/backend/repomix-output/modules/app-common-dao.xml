100:     /**
101:      * 根据条件搜索数据。
102:      *
103:      * 该方法用于根据提供的条件数组来构建查询语句，灵活地根据不同的条件进行数据库查询。
104:      * 条件数组中的每个键值对代表一个查询条件，方法内部通过判断键的存在与否来决定是否添加相应的查询条件。
105:      * 支持的条件包括财务类型、商户ID、用户信息、用户ID、关键字、日期范围以及是否为商户等。
106:      *
107:      * @param array $where 包含查询条件的数组。
108:      *
109:      * @return \Illuminate\Database\Query\Builder|static 返回构建好的查询语句。
110:      */
111:     public function search(array $where)
112:     {
113:         // 获取模型实例并连接数据库。
114:         $query = $this->getModel()::getDB();
115: 
116:         // 如果条件数组中包含'financial_type'键，且其值不为空，添加WHERE IN查询条件。
117:         $query = $query->when(isset($where['financial_type']) && $where['financial_type'] !== '', function ($query) use ($where) {
118:             $query->whereIn('financial_type', $where['financial_type']);
119:         });
120: 
121:         // 如果条件数组中包含'mer_id'键，且其值不为空，添加WHERE查询条件。
122:         $query = $query->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
123:             $query->where('mer_id', $where['mer_id']);
124:         });
125: 
126:         // 如果条件数组中包含'user_info'键，且其值不为空，添加WHERE查询条件。
127:         $query = $query->when(isset($where['user_info']) && $where['user_info'] !== '', function ($query) use ($where) {
128:             $query->where('user_info', $where['user_info']);
129:         });
130: 
131:         // 如果条件数组中包含'user_id'键，且其值不为空，添加WHERE查询条件。
132:         $query = $query->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
133:             $query->where('user_id', $where['uid']);
134:         });
135:         $query = $query->when(isset($where['nickname']) && $where['nickname'] !== '', function ($query) use ($where) {
136:             $uid = User::where('nickname', 'like', "%{$where['nickname']}%")->column('uid');
137:             $query->whereIn('user_id', $uid);
138:         });
139:         // 如果条件数组中包含'keyword'键，且其值不为空，添加WHERE LIKE查询条件，搜索字段包括订单号、用户信息和财务记录号。
140:         $query = $query->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
141:             $query->whereLike('order_sn|user_info|financial_record_sn', "%{$where['keyword']}%");
142:         });
143:         $query = $query->when(isset($where['order_sn']) && $where['order_sn'] !== '', function ($query) use ($where) {
144:             $query->whereLike('order_sn', "%{$where['order_sn']}%");
145:         });
146:         $query = $query->when(isset($where['real_name']) && $where['real_name'] !== '', function ($query) use ($where) {
147:             $query->whereLike('user_info', "%{$where['real_name']}%");
148:         });
149:         $query = $query->when(isset($where['financial_pm']) && $where['financial_pm'] !== '', function ($query) use ($where) {
150:             $query->where('financial_pm', $where['financial_pm']);
151:         });
152:         $query->when(isset($where['pay_type']) && $where['pay_type'] !== '', function ($query) use ($where) {
153:             if (is_int($where['pay_type'])) {
154:                 $query->where('pay_type', $where['pay_type']);
155:             } else {
156:                 $query->whereIn('pay_type', $where['pay_type']);
157:             }
158:         });
159: 
160:         // 如果条件数组中包含'date'键，且其值不为空，调用getModelTime函数添加日期范围查询条件。
161:         $query = $query->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
162:             getModelTime($query, $where['date'], 'create_time');
163:         });
164: 
165:         // 如果条件数组中包含'is_mer'键，根据其值添加不同的WHERE查询条件，判断是否为商户以及类型条件。
166:         $query = $query->when(isset($where['is_mer']) && $where['is_mer'] !== '', function ($query) use ($where) {
167:             if($where['is_mer']){
168:                 $query->where('mer_id',$where['is_mer'])->where('type','in',[0,1]);
169:             }else{
170:                 $query->where('type','in',[1,2]);
171:             }
172:         });
173: 
174:         // 返回构建好的查询语句。
175:         return $query;
176:     }
