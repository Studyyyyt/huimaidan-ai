 83:      * 主要用于展示或统计特定日期内各商家类别的订单收入情况。
 84:      *
 85:      * @param string $date 查询的日期，格式为YYYY-MM-DD。如果未指定日期，则查询所有记录。
 86:      * @param int $limit 返回结果的限制数量，默认为4，用于控制返回的商家类别数量。
 87:      * @return array 返回一个包含商家类别名称和对应订单总支付金额的数组，数组项按支付金额降序排列。
 88:      */
 89:     public function dateMerchantPriceGroup($date, $limit = 4)
 90:     {
 91:         // 从MerchantCategory模型的数据库连接中获取查询对象
 92:         return MerchantCategory::getDB()->alias('A')->leftJoin('Merchant B', 'A.merchant_category_id = B.category_id')
 93:             ->leftJoin('StoreOrder C', 'C.mer_id = B.mer_id')->field(Db::raw('sum(C.pay_price) as pay_price,A.category_name'))
 94:             // 根据$date参数条件，动态添加查询时间范围的条件
 95:             ->when($date, function ($query, $date) {
