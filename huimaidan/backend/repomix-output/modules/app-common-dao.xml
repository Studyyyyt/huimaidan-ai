 57:      *
 58:      * 此函数用于根据提供的条件搜索店铺分组订单。它支持搜索已支付、用户ID、是否为积分订单、以及是否已删除的订单。
 59:      * 通过条件构造查询语句，并根据这些条件来过滤订单数据。
 60:      *
 61:      * @param array $where 搜索条件数组，包含paid、uid、is_del等键值对
 62:      * @param null $is_points 是否为积分订单，null表示不筛选，true/false分别表示是/否
 63:      * @return \think\db\BaseQuery 查询构建器或StoreGroupOrder实例，用于进一步的查询操作或数据获取
 64:      */
 65:     public function search(array $where,$is_points = null)
 66:     {
 67:         // 获取数据库实例并根据条件逐步构建查询语句
 68:         $query = StoreGroupOrder::getDB()
 69:             // 当paid字段在$where数组中且不为空时，添加where条件筛选支付状态
 70:             ->when(isset($where['paid']) && $where['paid'] !== '', function ($query) use ($where) {
 71:                 $query->where('paid', $where['paid']);
 72:             })
 73:             // 当uid字段在$where数组中且不为空时，添加where条件筛选用户ID
 74:             ->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
 75:                 $query->where('uid', $where['uid']);
 76:             })
 77:             ->when(isset($where['is_first']) && $where['is_first'] !== '', function ($query) use ($where) {
 78:                 $query->where('is_first', $where['is_first']);
 79:             })
 80:             // 当$is_points不为null时，根据$is_points的值添加where条件筛选是否为积分订单
 81:             ->when(!is_null($is_points), function ($query) use ($is_points) {
 82:                 if ($is_points) {
 83:                     $query->where('activity_type', 20);
 84:                 } else {
 85:                     $query->where('activity_type', '<>',20);
 86:                 }
 87:             })
 88:             // 当is_del字段在$where数组中且不为空时，添加where条件筛选删除状态；否则，添加默认的where条件筛选未删除的订单
 89:             ->when(isset($where['is_del']) && $where['is_del'] !== '', function ($query) use ($where) {
 90:                 $query->where('is_del', $where['is_del']);
 91:             }, function ($query) {
 92:                 $query->where('is_del', 0);
 93:             })
 94:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
 95:                 getModelTime($query, $where['date'], 'create_time');
 96:             })
 97:             ->when(isset($where['mom_date']) && $where['mom_date'] !== '', function ($query) use ($where) {
 98:                 momTime($query, $where['mom_date'], 'create_time');
 99:             });
100:         // 返回按照创建时间降序排序的查询构建器，用于进一步的查询操作或数据获取
101:         return $query->order('create_time DESC');
102:     }
103: 
104:     /**
105:      * 获取超时订单ID列表
106:      * 此函数用于查询并返回在指定时间之前创建的、未支付的订单ID列表。如果指定了需要提醒的订单，则只返回尚未提醒的订单ID。
107:      *
