 26:  * @day 2020/5/28
 27:  */
 28: class FeedbackDao extends BaseDao
 29: {
 30: 
 31:     /**
 32:      * @return string
 33:      * @author xaboy
 34:      * @day 2020/5/28
 35:      */
 36:     protected function getModel(): string
 37:     {
 38:         return Feedback::class;
 39:     }
 40: 
 41:     /**
 42:      * 根据条件搜索反馈信息
 43:      *
 44:      * 本函数用于根据提供的条件数组搜索反馈信息。它支持多种条件搜索，包括用户ID、关键词、类型、状态、姓名和删除状态等。
 45:      * 搜索条件是可选的，只有当条件存在且不为空时，才会应用相应的查询条件。
 46:      *
 47:      * @param array $where 搜索条件数组，包含各种可能的搜索参数。
 48:      * @return \think\Collection 返回搜索结果集合。
 49:      */
 50:     public function search(array $where)
 51:     {
 52:         // 从Feedback类中获取数据库实例
 53:         return Feedback::getDB()->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
 54:             // 如果提供了用户ID，则按用户ID查询
 55:             $query->where('uid', $where['uid']);
 56:         })->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
 57:             // 如果提供了关键词，则按内容、回复、备注、真实姓名和联系方式模糊查询
 58:             $query->whereLike('content|reply|remake|realname|contact', '%'.$where['keyword'].'%');
 59:         })->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
 60:             // 如果提供了类型，则按类型查询
 61:             $query->where('type',$where['type']);
 62:         })->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
 63:             // 如果提供了状态，则按状态查询
 64:             $query->where('status', $where['status']);
 65:         })->when(isset($where['realname']) && $where['realname'] !== '', function ($query) use ($where) {
 66:             // 如果提供了真实姓名，则按真实姓名模糊查询
 67:             $query->where('realname','like', '%'.$where['realname'].'%');
 68:         })->when(isset($where['is_del']) && $where['is_del'] !== '', function ($query) use ($where) {
 69:             // 如果提供了删除状态，则按删除状态查询
 70:             $query->where('is_del',$where['is_del']);
 71:         })->order('create_time DESC'); // 按创建时间降序排序
 72:     }
 73: 
 74:     /**
 75:      * 检查给定的ID和UID是否存在对应的反馈信息。
 76:      *
 77:      * 本函数通过查询数据库来确定是否存在一条反馈信息，其主键（ID）与给定的ID匹配，
 78:      * 并且用户ID（uid）与给定的UID匹配，同时该反馈信息未被删除（is_del为0）。
 79:      * 这对于确保操作的反馈信息是有效和可用的非常重要。
 80:      *
 81:      * @param int $id 主键ID，用于查询特定的反馈信息。
 82:      * @param int $uid 用户ID，用于查询属于特定用户的反馈信息。
 83:      * @return bool 如果存在匹配的反馈信息，则返回true；否则返回false。
 84:      */
 85:     public function uidExists($id, $uid): bool
 86:     {
 87:         // 使用Feedback类的静态方法getDB来获取数据库实例，并构建查询条件，
 88:         // 查询条件包括主键ID、用户ID和删除状态，最后通过count方法统计符合条件的记录数，
 89:         // 如果记录数大于0，则表示存在匹配的反馈信息。
 90:         return Feedback::getDB()->where($this->getPk(), $id)->where('uid', $uid)->where('is_del', 0)->count($this->getPk()) > 0;
 91:     }
 92: 
 93:     /**
 94:      * 检查指定ID的商品是否存在且未被删除。
 95:      *
 96:      * 该方法通过查询数据库来确定给定ID的商品是否存在，同时确保该商品的删除标记(is_del)为0，即未被删除。
 97:      * 这是对商品管理中常见操作的封装，用于在进行进一步的操作前验证商品的有效性。
 98:      *
