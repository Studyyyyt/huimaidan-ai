 26:  * @day 2020-04-24
 27:  */
 28: class CacheDao extends BaseDao
 29: {
 30: 
 31:     /**
 32:      * @return BaseModel
 33:      * @author xaboy
 34:      * @day 2020-03-30
 35:      */
 36:     protected function getModel(): string
 37:     {
 38:         return Cache::class;
 39:     }
 40: 
 41:     /**
 42:      * 根据键获取缓存结果
 43:      *
 44:      * 本函数旨在通过指定的键从缓存数据库中检索相应的结果。如果找到结果，它将尝试解析JSON格式的数据并返回解码后的数组；
 45:      * 如果未找到结果，则返回null。使用此函数可以方便地获取和处理缓存中的数据，而无需直接与缓存存储交互。
 46:      *
 47:      * @param string $key 缓存中的键，用于唯一标识缓存的数据。
 48:      * @return array|null 返回解码后的JSON数据作为数组，如果未找到则返回null。
 49:      */
 50:     public function getResult($key)
 51:     {
 52:         // 从缓存数据库中根据键获取结果值
 53:         $val = Cache::getDB()->where('key', $key)->value('result');
 54: 
 55:         // 如果值存在则解码JSON数据并返回数组，否则返回null
 56:         return $val ? json_decode($val, true) : null;
 57:     }
 58: 
 59:     /**
 60:      * 更新缓存中的数据。
 61:      * 此方法用于根据给定的键更新缓存数据。特别是，如果数据数组中包含一个名为'result'的元素，
 62:      * 它将被转换为JSON格式，以便在数据库中以更紧凑、可搜索的形式存储。
 63:      *
 64:      * @param string $key 缓存条目的键。用于唯一标识缓存数据。
 65:      * @param array $data 包含要更新的数据的数组。如果数组中包含'result'键，其值将被转换为JSON格式。
 66:      */
 67:     public function keyUpdate(string $key, $data)
 68:     {
 69:         // 检查$data数组中是否包含'result'键
 70:         // 如果存在，则将其值转换为JSON格式，使用JSON_UNESCAPED_UNICODE选项保留多字节字符
 71:         if (isset($data['result']))
 72:             $data['result'] = json_encode($data['result'], JSON_UNESCAPED_UNICODE);
 73: 
 74:         // 使用Cache的getDB方法获取数据库实例，并根据$key更新数据
 75:         // 这里假设Cache::getDB()返回一个可用于执行数据库操作的对象
 76:         Cache::getDB()->where('key', $key)->update($data);
 77:     }
 78: 
 79: 
 80:     /**
 81:      * 根据一组键搜索缓存数据。
 82:      *
 83:      * 本函数旨在通过提供的键数组，从缓存数据库中检索对应的结果。它首先构造一个查询，以键为条件检索缓存，
 84:      * 然后对检索到的数据进行处理，将其转换为PHP对象，最后返回处理后的数据数组。
 85:      *
 86:      * @param array $keys 键的数组，用于查找缓存数据。
 87:      * @return array 返回一个键值对数组，其中每个键对应的值是从缓存中检索到的数据对象。
 88:      */
 89:     public function search(array $keys)
 90:     {
 91:         // 从缓存数据库中查询键对应的缓存结果，以键为索引。
 92:         $cache = $this->getModel()::getDB()->whereIn('key',$keys)->column('result','key');
 93:         $ret = [];
 94: 
 95:         // 遍历查询结果，将JSON格式的缓存数据转换为PHP对象。
 96:         foreach ($cache as $k => $v) {
 97:             $ret[$k] = json_decode($v);
 98:         }
 99:         return $ret;
100:     }
101: 
102: 
103: 
104: }
