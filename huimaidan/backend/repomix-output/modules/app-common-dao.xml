110:                 $query->where('Community.is_show',$where['is_show']);
111:             })
112:             ->when(isset($where['status']) && $where['status'] !==  '', function ($query) use($where) {
113:                 $query->where('Community.status',$where['status']);
114:             })
115:             ->when(isset($where['start']) && $where['start'] !==  '', function ($query) use($where) {
116:                 $query->where('Community.start',$where['start']);
117:             })
118:             ->when(isset($where['is_del']) && $where['is_del'] !==  '', function ($query) use($where) {
119:                 $query->where('Community.is_del',$where['is_del']);
120:             })
121:             ->when(isset($where['category_id']) && $where['category_id'] !==  '', function ($query) use($where) {
