 56:      * @param array $where
 57:      * @return BaseQuery
 58:      * @author Qinii
 59:      */
 60:     public function search($merId,array $where)
 61:     {
 62:         $query = Article::getDB();
 63:         if (isset($where['cid']) && $where['cid'] !== '') $query->where('cid', (int)$where['cid']);
 64:         if (isset($where['title']) && $where['title'] !== '') $query->whereLike('title', "%{$where['title']}%");
