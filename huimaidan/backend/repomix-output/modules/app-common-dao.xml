238:      * @return mixed
239:      * @author Qinii
240:      * @day 2020-06-11
241:      */
242:     public function merchantTotalRate($merId)
243:     {
244:         return ($this->getModel()::getDB())->where('mer_id', $merId)->field('avg(product_score) product_score ,avg(service_score) service_score,avg(postage_score) postage_score')->find()->toArray();
245:     }
