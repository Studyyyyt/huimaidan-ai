108:      *
109:      * 此方法用于确定数据库中是否存在具有指定标签ID、类型为0且可选的商户ID的记录。
110:      * 主要用于标签管理中对标签存在性的验证，以避免重复创建或操作已存在的标签。
111:      *
112:      * @param int $id 标签的ID，用于唯一标识一个标签。
113:      * @param int $mer_id 商户的ID，可选参数，用于指定特定商户下的标签。默认为0，表示系统标签。
114:      * @return bool 返回布尔值，表示标签是否存在。存在返回true，不存在返回false。
115:      */
116:     public function exists(int $id, $mer_id = 0)
117:     {
118:         // 使用existsWhere方法查询是否存在满足条件的标签记录。
119:         return $this->existsWhere(['label_id' => $id, 'type' => 0, 'mer_id' => $mer_id]);
120:     }
121: 
122:     /**
