20: {
21:     protected function getModel(): string
22:     {
23:         return MerchantApplyments::class;
24:     }
25: 
26:     /**
27:      * 根据条件搜索数据。
28:      *
29:      * 本函数用于根据提供的条件数组搜索数据库中的记录。它支持多个条件，
30:      * 条件之间是逻辑与（AND）关系。每个条件只有在数组中存在且不为空时才会被应用。
31:      *
32:      * @param array $where 包含搜索条件的数组。数组的键是条件的字段名，值是条件的值。
33:      *                    条件支持的字段包括：mer_id, uid, status, mer_applyments_id, date。
34:      *                    其中date字段需要是一个特定格式的字符串，会被内部转换为对应的时间范围条件。
35:      * @return \Illuminate\Database\Query\Builder|static 返回构建好的查询构建器对象，可以进一步链式调用或执行查询。
36:      */
37:     public function search(array $where)
38:     {
39:         // 获取模型对应的数据库连接实例
40:         $query = $this->getModel()::getDB();
41: 
42:         // 如果条件数组中包含mer_id，且值不为空，则添加where条件筛选mer_id
43:         $query = $query->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
44:             $query->where('mer_id', $where['mer_id']);
45:         });
46: 
47:         // 如果条件数组中包含uid，且值不为空，则添加where条件筛选uid
48:         $query = $query->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
49:             $query->where('uid', $where['uid']);
50:         });
51: 
52:         // 如果条件数组中包含status，且值不为空，则添加where条件筛选status，并将值转换为整型
53:         $query = $query->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
54:             $query->where('status', (int)$where['status']);
55:         });
56: 
57:         // 如果条件数组中包含mer_applyments_id，且值不为空，则添加where条件筛选mer_applyments_id
58:         $query = $query->when(isset($where['mer_applyments_id']) && $where['mer_applyments_id'] !== '', function ($query) use ($where) {
59:             $query->where('mer_applyments_id', $where['mer_applyments_id']);
60:         });
61: 
62:         // 如果条件数组中包含date，且值不为空，则调用getModelTime函数添加对应的时间范围条件
63:         $query = $query->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
64:             getModelTime($query, $where['date']);
65:         });
66: 
67:         $query = $query->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
68:             $query->where('type', $where['type']);
69:         });
70: 
71:         // 永久排除已删除的数据
72:         $query = $query->where('is_del', 0);
73: 
74:         // 返回构建好的查询对象
75:         return $query;
76:     }
