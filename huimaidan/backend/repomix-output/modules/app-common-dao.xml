 50:     {
 51:         // 使用查询构建器实例化StoreCouponUser模型
 52:         return StoreCouponUser::when(isset($where['username']) && $where['username'] !== '', function ($query) use ($where) {
 53:             // 如果指定了用户名，则添加对用户昵称的模糊搜索条件
 54:             $query->hasWhere('user', [['nickname', 'LIKE', "%{$where['username']}%"]]);
 55:         })->when(isset($where['coupon_type']) && $where['coupon_type'] !== '', function ($query) use ($where) {
 56:             // 如果指定了优惠券类型，则添加对优惠券类型的条件查询
 57:             $query->hasWhere('coupon', ['type' => $where['coupon_type']]);
 58:         })->alias('StoreCouponUser')->when(isset($where['coupon']) && $where['coupon'] !== '', function ($query) use ($where) {
 59:             // 如果指定了优惠券名称或ID，则添加对优惠券标题的模糊搜索条件
 60:             $query->whereLike('StoreCouponUser.coupon_title', "%{$where['coupon']}%");
 61:         })->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
 62:             // 如果指定了状态，则添加对状态的条件查询
 63:             $query->where('StoreCouponUser.status', $where['status']);
 64:         })->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
 65:             // 如果指定了用户ID，则添加对用户ID的条件查询
 66:             $query->where('StoreCouponUser.uid', $where['uid']);
 67:         })->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
 68:             // 如果指定了商家ID，则添加对商家ID的条件查询
 69:             $query->where('StoreCouponUser.mer_id', $where['mer_id']);
 70:         })->when(isset($where['coupon_id']) && $where['coupon_id'] !== '', function ($query) use ($where) {
 71:             // 如果指定了优惠券ID，则添加对优惠券ID的条件查询
 72:             $query->where('StoreCouponUser.coupon_id', $where['coupon_id']);
 73:         })->when(isset($where['coupon']) && $where['coupon'] !== '', function ($query) use ($where) {
 74:             // 如果再次指定了优惠券名称或ID，则添加对优惠券标题或ID的模糊搜索条件
 75:             $query->whereLike('StoreCouponUser.coupon_title|StoreCouponUser.coupon_id', "%{$where['coupon']}%");
 76:         })->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
 77:             // 如果指定了类型，则添加对类型的条件查询
 78:             $query->where('StoreCouponUser.type', $where['type']);
 79:         })->when(isset($where['send_id']) && $where['send_id'] !== '', function ($query) use ($where) {
 80:             // 如果指定了发送者ID，并且类型为发送，则添加相应的条件查询
 81:             $query->where('StoreCouponUser.send_id', $where['send_id'])->where('StoreCouponUser.type', 'send');
 82:         })->when(isset($where['is_mer']) && $where['is_mer'] !== '', function ($query) use ($where) {
 83:             // 如果指定了是否为商家，则添加对商家ID的非空查询
 84:             $query->where('StoreCouponUser.mer_id', '<>',0);
 85:         })->when(isset($where['statusTag']) && $where['statusTag'] !== '', function ($query) use ($where) {
 86:             // 根据状态标签的不同，添加不同的条件查询，包括未使用的优惠券或在指定时间内使用的优惠券
 87:             if ($where['statusTag'] == 1) {
 88:                 $query->where('StoreCouponUser.status', 0);
 89:             } else {
 90:                 $query->whereIn('StoreCouponUser.status', [1, 2])->where('StoreCouponUser.create_time', '>', date('Y-m-d H:i:s', strtotime('-60 day')));
 91:             }
 92:         })->order('StoreCouponUser.coupon_user_id DESC');
 93:     }
