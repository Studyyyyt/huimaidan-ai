115:             })->when(isset($where['label_id']) && $where['label_id'] !== '', function (BaseQuery $query) use ($where) {
116:                 return $query->whereRaw('CONCAT(\',\',A.label_id,\',\') LIKE \'%,' . $where['label_id'] . ',%\'');
117:             })->when(isset($where['user_type']) && $where['user_type'] !== '', function (BaseQuery $query) use ($where) {
118:                 return $query->where('B.user_type', $where['user_type']);
119:             })->where('A.status', 1);
120:     }
121: 
122:     /**
123:      * 获取指定商家ID下的用户ID列表，这些用户的支付数目在指定的范围内。
124:      *
125:      * 本函数通过查询用户支付表，筛选出特定商家ID且支付数目在最小值和最大值（可选）之间的用户ID。
126:      * 使用了Laravel的查询构建器来构造数据库查询，并通过分组和列操作来优化结果集的返回形式。
127:      *
128:      * @param string $mer_id 商家ID，用于查询指定商家的用户。
129:      * @param int $min 最小支付数目，用于筛选支付数目不小于该值的用户。
130:      * @param int|null $max 最大支付数目，可选参数，用于筛选支付数目不大于该值的用户。
131:      * @return array 返回符合条件的用户ID列表。
132:      */
133:     public function numUserIds($mer_id, $min, $max = null)
134:     {
135:         // 构建查询条件，首先指定商家ID和支付数目最小值
136:         return UserMerchant::getDB()->where('mer_id', $mer_id)->where('pay_num', '>=', $min)->when(!is_null($max), function ($query) use ($max) {
137:             // 如果指定了最大支付数目，则添加该条件进行筛选
138:             $query->where('pay_num', '<=', $max);
139:         })->group('uid')->column('uid');
140:     }
141: 
142: 
143:     /**
144:      * 获取指定商家ID和价格范围内的用户ID列表
145:      *
146:      * 此方法用于查询与特定商家相关联的，并且交易价格在指定范围内的用户的唯一ID列表。
147:      * 查询条件包括商家ID和支付价格，支付价格支持设定最小值和最大值。
148:      * 如果只指定了最小值而没有最大值，则查询大于等于最小值的所有记录。
149:      * 如果同时指定了最小值和最大值，则查询大于等于最小值且小于等于最大值的所有记录。
150:      *
151:      * @param int $mer_id 商家ID，用于限定查询的商家范围
152:      * @param int $min 最小支付价格，用于限定查询的最低价格范围
153:      * @param int|null $max 最大支付价格，可选参数，用于限定查询的最高价格范围
154:      * @return array 返回符合条件的用户ID列表
155:      */
156:     public function priceUserIds($mer_id, $min, $max = null)
157:     {
158:         // 使用UserMerchant类的数据库连接，并构造查询条件
159:         return UserMerchant::getDB()->where('mer_id', $mer_id)->where('pay_price', '>=', $min)->when(!is_null($max), function ($query) use ($max, $min) {
160:             // 如果指定了最大值，则进一步限定支付价格小于等于最大值
161:             $query->where('pay_price', $min == $max ? '<=' : '<', $max);
162:         })->group('uid')->column('uid');
163:     }
164: 
165: }
