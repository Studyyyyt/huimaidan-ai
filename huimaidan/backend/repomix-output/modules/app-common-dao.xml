 26:      * 生成订单编号
 27:      *
 28:      * 本函数用于生成唯一的订单编号。编号由前缀、时间戳和随机数组成，确保了订单编号的唯一性和可追踪性。
 29:      * - 前缀为"pr"，用于标识订单类型或业务领域。
 30:      * - 时间戳部分基于微秒级时间，提高了编号的唯一性，避免了在高并发场景下的重复问题。
 31:      * - 随机数部分确保即使在微秒级别的时间内有重复，也可以通过随机数避免编号重复。
 32:      *
 33:      * @return string 返回生成的订单编号
 34:      * @throws \Exception
 35:      */
 36:     public function getOrderSn()
 37:     {
 38:         // 获取当前时间的微秒和秒部分
 39:         list($msec, $sec) = explode(' ', microtime());
 40: 
 41:         // 将微秒和秒合并，并转换为毫秒，去除了小数点，确保数字部分全是整数
 42:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
 43: 
 44:         // 生成订单编号：前缀 + 毫秒时间戳 + 4位随机数
 45:         // 随机数生成考虑了微秒时间戳的重复性和随机性，避免了直接使用微秒时间戳可能导致的重复问题
 46:         $orderId = 'pr' . $msectime . random_int(10000, max(intval($msec * 10000) + 10000, 98369));
 47: 
 48:         return $orderId;
 49:     }
