232:      * 用于调和数据更新的函数。
233:      * 此函数旨在将指定的调和ID列表中的所有调和ID更新为0。
234:      * 这是一个具体的操作数据库的函数，它依赖于getModel方法来获取数据库实例。
235:      *
236:      * @param array $reconciliation_id 调和ID的数组，这些ID将被更新为0。
237:      * @return int 返回影响的行数，表示更新操作的结果。
238:      */
239:     public function reconciliationUpdate($reconciliation_id)
240:     {
241:         // 通过模型获取数据库实例，并使用whereIn方法指定更新条件，然后更新reconciliation_id为0
242:         return ($this->getModel()::getDB())->whereIn('reconciliation_id', $reconciliation_id)->update(['reconciliation_id' => 0]);
243:     }
