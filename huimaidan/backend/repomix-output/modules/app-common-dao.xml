 33:      * 可以根据支付方式、支付状态、商家ID和订单ID列表来过滤结果。
 34:      *
 35:      * @param array $where 包含搜索条件的数组，其中可能包含pay_type、paid、mer_id和order_ids键。
 36:      * @return \think\db\Query|null 返回构建的查询对象，或者在没有符合条件的查询时返回null。
 37:      */
 38:     public function search(array $where)
 39:     {
 40:         // 获取数据库查询对象
 41:         return PresellOrder::getDB()->when(isset($where['pay_type']) && $where['pay_type'] !== '', function ($query) use ($where) {
 42:             // 如果支付方式被指定且不为空，则添加支付方式的查询条件
 43:             $query->whereIn('pay_type', $where['pay_type']);
 44:         })->when(isset($where['paid']) && $where['paid'] !== '', function ($query) use ($where) {
 45:             // 如果支付状态被指定且不为空，则添加支付状态的查询条件
 46:             $query->where('paid', $where['paid']);
 47:         })->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
 48:             // 如果商家ID被指定且不为空，则添加商家ID的查询条件
 49:             $query->where('mer_id', $where['mer_id']);
 50:         })->when(isset($where['order_ids']) && $where['order_ids'] !== '', function ($query) use ($where) {
 51:             // 如果订单ID列表被指定且不为空，则添加订单ID在指定列表中的查询条件
 52:             $query->where('order_id','in',$where['order_ids']);
 53:         });
