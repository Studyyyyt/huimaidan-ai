27:     /**
28:      * 根据条件搜索数据。
29:      *
30:      * 该方法用于根据提供的条件数组搜索数据库中的记录。支持的条件包括状态(status)、类型(type)和关键字(keyword)。
31:      * 搜索逻辑是条件性的，只有当相应的条件存在且不为空时，才会应用到查询中。
32:      * 查询结果按照创建时间降序排序。
33:      *
34:      * @param array $where 包含搜索条件的数组。支持的条件有：status（状态）、type（类型）、keyword（关键字）。
35:      * @return \Illuminate\Database\Query\Builder|static 返回构建器对象或静态调用结果。
36:      */
37:     public function search(array $where)
38:     {
39:         // 获取模型对应的数据库实例。
40:         return ($this->getModel()::getDB())->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
41:             // 如果提供了状态条件，则应用到查询中。
42:             $query->where('status', $where['status']);
43:         })->when(isset($where['type']) && $where['type'] !== '', function ($query) use ($where) {
44:             // 如果提供了类型条件，则应用到查询中。
45:             $query->where('type', $where['type']);
46:         })->when(isset($where['keyword']) && $where['keyword'] !== '', function ($query) use ($where) {
47:             // 如果提供了关键字条件，则应用到查询中，支持名称和临时ID的模糊搜索。
48:             $query->where(function($query) use ($where) {
49:                 $query->where('name', 'like', '%' . $where['keyword'] . '%');
50:                 $query->whereOr('tempid', 'like', '%' . $where['keyword'] . '%');
51:             });
52:         })->order('create_time DESC');
