39:     /**
40:      * 根据条件搜索优惠券发送记录
41:      *
42:      * 本函数用于根据提供的条件从数据库中检索优惠券发送记录。它支持搜索优惠券名称、
43:      * 发送日期范围、优惠券类型、状态和商家ID。搜索结果基于这些条件的组合。
44:      *
45:      * @param array $where 搜索条件数组，包含可能的键：coupon_name（优惠券名称）、
46:      *                     date（日期范围）、coupon_type（优惠券类型）、status（状态）、mer_id（商家ID）。
47:      * @return \think\db\Query 返回一个数据库查询对象，该对象可用于进一步的查询操作或数据检索。
48:      */
49:     public function search(array $where)
50:     {
51:         // 初始化查询，指定别名为A，并左连接到StoreCoupon表（别名为B） on B.coupon_id = A.coupon_id
52:         return StoreCouponSend::getDB()->alias('A')->leftJoin('StoreCoupon B', 'B.coupon_id = A.coupon_id')
53:             // 当coupon_name条件存在且不为空时，添加LIKE条件到查询中
54:             ->when(isset($where['coupon_name']) && $where['coupon_name'] !== '', function ($query) use ($where) {
55:                 $query->whereLike('B.title', "%{$where['coupon_name']}%");
56:             })
57:             // 当date条件存在且不为空时，调用getModelTime函数来处理日期范围条件
58:             ->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
59:                 getModelTime($query, $where['date'], 'A.create_time');
60:             })
61:             // 当coupon_type条件存在且不为空时，添加类型条件到查询中
62:             ->when(isset($where['coupon_type']) && $where['coupon_type'] !== '', function ($query) use ($where) {
63:                 $query->where('B.type', $where['coupon_type']);
64:             })
65:             // 当status条件存在且不为空时，添加状态条件到查询中
66:             ->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
67:                 $query->where('A.status', $where['status']);
