133:      * 获取二级分类列表
134:      * 本函数用于查询并返回指定商户下的二级分类ID、分类名称和父分类ID。
135:      * 主要用于前端展示或进一步的数据处理，例如商品分类导航等。
136:      *
137:      * @param int $merId 商户ID，用于查询指定商户的分类数据。默认为0，表示查询所有商户的数据。
138:      * @return array 返回一个包含分类ID、分类名称和父分类ID的数组，每个元素代表一个二级分类。
139:      */
140:     public function getTwoLevel($merId = 0)
141:     {
142:         // 查询顶级分类的ID，这些分类属于指定的商户，且显示状态为开启，类型为0。
143:         $pid = model::getDB()->where('pid', 0)->where('is_show',1)->where('type',0)->where('mer_id', $merId)->order('sort DESC')->column('store_category_id');
144: 
145:         // 根据上一步查询得到的顶级分类ID，进一步查询其下的二级分类ID、分类名称和父分类ID。
146:         // 这里限制了查询结果的数量为20条，并按照排序降序返回。
147:         return model::getDB()->whereIn('pid', $pid)->where('is_show', 1)->where('mer_id', $merId)->limit(20)->order('sort DESC')->column('store_category_id,cate_name,pid');
148:     }
149: 
150:     /**
151:      * 获取指定父级ID和商户ID下的分类信息
152:      *
153:      * 此函数用于查询数据库中特定父分类ID和商户ID下的分类信息，并且只返回显示状态为正常的分类。
154:      * 结果按照排序降序返回分类的ID、名称和图片信息。
155:      *
156:      * @param integer $pid 父分类ID，用于指定查询的父分类。
157:      * @param integer $merId 商户ID，可选参数，默认为0，用于指定查询的商户分类。
158:      * @return array 返回一个包含分类ID、名称和图片的数组。
159:      */
160:     public function children($pid, $merId = 0)
161:     {
162:         // 通过模型获取数据库实例，然后进行条件查询：指定父ID、商户ID和显示状态为1的分类，按排序降序获取分类的ID、名称和图片信息。
163:         return model::getDB()->where('pid', $pid)->where('mer_id', $merId)->where('is_show', 1)->order('sort DESC')->column('store_category_id,cate_name,pic');
164:     }
165: 
166: 
167:     /**
168:      * 获取所有子分类的ID列表
169:      *
170:      * 本函数旨在通过给定的分类ID（可以是单个ID或ID数组），获取该分类及其所有子分类的ID列表。
171:      * 这对于需要对一系列分类进行操作，例如遍历或筛选，非常有用。
172:      *
173:      * @param int|array $id 分类ID，可以是单个ID或ID数组
174:      * @return array 包含所有子分类ID的数组，如果找不到任何子分类，则返回空数组
175:      */
176:     public function allChildren($id)
177:     {
178:         // 根据给定的分类ID（单个或数组），查询数据库中所有对应分类的路径
179:         $path = model::getDB()->where('store_category_id', is_array($id) ? 'IN' : '=', $id)->where('mer_id', 0)->column('path', 'store_category_id');
180: 
181:         // 如果查询结果为空，则直接返回空数组
182:         if (!count($path)) return [];
183: 
184:         // 继续查询所有路径包含之前查询到的分类路径的分类ID，并按排序降序排列
185:         // 这里使用了WHERE子句的回调功能来构建一个或多个LIKE条件，以匹配所有子分类的路径
186:         return model::getDB()->where(function ($query) use ($path) {
187:             foreach ($path as $k => $v) {
188:                 $query->whereOr('path', 'LIKE', "$v$k/%");
189:             }
190:         })->where('mer_id', 0)->order('sort DESC')->column('store_category_id');
191:     }
192: 
193:     /**
194:      * 根据给定的一组子分类ID，获取所有相关分类的ID。
195:      * 此方法通过查询数据库，找出给定子分类ID列表中所有分类的路径，
196:      * 然后根据这些路径来获取所有父分类的ID。
197:      *
198:      * @param array $ids 子分类的ID列表
199:      * @return array 返回所有相关分类的ID列表
200:      */
201:     public function idsByAllChildren(array $ids)
202:     {
203:         // 查询数据库，找出所有属于给定子分类ID列表且mer_id为0的分类的路径
204:         $paths = model::getDB()->whereIn('store_category_id', $ids)->where('mer_id', 0)->column('path');
205: 
206:         // 如果没有找到任何路径，则直接返回空数组
207:         if (!count($paths)) return [];
208: 
209:         // 查询所有路径匹配且mer_id为0的分类ID，按排序降序排列
210:         // 这里使用了where函数内的循环，来构建一个或多个path匹配的条件
211:         return model::getDB()->where(function ($query) use ($paths) {
212:             foreach ($paths as $path) {
213:                 // 对每个路径使用whereOr，确保任何匹配路径的分类都被选中
214:                 $query->whereOr('path', 'LIKE', "$path%");
215:             }
216:         })->where('mer_id', 0)->order('sort DESC')->column('store_category_id');
217:     }
218: 
219:     /**
220:      * 获取最大级别
221:      * 此函数用于确定给定商户ID的最大级别。如果商户ID被提供并且有效，返回2；否则，返回3。
222:      *
223:      * @param int|null $merId 商户ID。如果提供，将用于确定级别的值。
224:      * @return int 返回商户的最大级别。可能的值为2（如果提供了有效的商户ID）或3（如果未提供商户ID）。
225:      */
226:     public function getMaxLevel($merId = null)
227:     {
228:         if($merId) return 2;
229:         return 3;
230:     }
