13: namespace app\common\dao\store;
14: 
15: 
16: use app\common\dao\BaseDao;
17: use app\common\model\BaseModel;
18: use app\common\model\store\CityArea;
19: use think\exception\ValidateException;
20: 
21: class CityAreaDao extends BaseDao
22: {
23: 
24:     protected function getModel(): string
25:     {
26:         return CityArea::class;
27:     }
28: 
29:     public function search(array $where)
30:     {
31:         return CityArea::getDB()->when(isset($where['pid']) && $where['pid'] !== '', function ($query) use ($where) {
32:             $query->where('parent_id', $where['pid']);
33:         })->when(isset($where['address']) && $where['address'] !== '', function ($query) use ($where) {
34:             $address = explode('/', trim($where['address'], '/'));
35:             $p = array_shift($address);
36:             $_p = $p;
37:             if (mb_strlen($p) - 1 === mb_strpos($p, '市')) {
38:                 $p = mb_substr($p, 0, -1);
39:             } elseif (mb_strlen($p) - 1 === mb_strpos($p, '省')) {
40:                 $p = mb_substr($p, 0, -1);
41:             } elseif (mb_strlen($p) - 3 === mb_strpos($p, '自治区')) {
42:                 $p = mb_substr($p, 0, -3);
43:             }
44:             $pcity = $this->search([])->where('name', $p)->find();
45:             if (!$pcity) $pcity = $this->search([])->where('name', $_p)->find();
46:             if (!$pcity) throw new ValidateException('获取地址失败'.$_p);
47:             $street = array_pop($address);
48:             if ($pcity) {
49:                 $path = '/' . $pcity->id . '/';
50:                 $query->whereLike('path', "/{$pcity->id}/%");
51:                 foreach ($address as $item) {
52:                     $id = $this->search([])->whereLike('path', $path . '%')->where('name', $item)->value('id');
53:                     if ($id) {
54:                         $path .= $id . '/';
55:                     } else {
56:                         break;
57:                     }
58:                 }
59:             }
60:             $query->whereLike('path', $path . '%')->where('name', $street);
61:         });
62:     }
63: 
64:     /**
65:      * 获取城市列表
66:      *
67:      * 本函数用于根据给定的城市区域对象，获取该城市区域的所有父级城市直到根城市的一个列表。
68:      * 这个功能适用于需要展示城市层级关系的场景，比如导航菜单或选择框。
69:      *
70:      * @param CityArea $city 城市区域对象，包含城市区域的信息。
71:      * @return array 返回一个包含城市区域对象的数组，从根城市到给定城市的父级城市。
72:      */
73:     public function getCityList(CityArea $city)
74:     {
75:         // 如果城市区域没有父级ID，则说明它是根城市，直接返回该城市自身
76:         if (!$city->parent_id) return [$city];
77: 
78:         // 通过查询找到给定城市的所有父级城市，路径用'/'分隔
79:         $lst = $this->search([])->where('id', 'in', explode('/', trim($city->path, '/')))->order('id ASC')->select();
80: 
81:         // 将给定的城市对象添加到结果列表末尾，确保列表以给定城市结尾
82:         $lst[] = $city;
83: 
84:         // 返回包含所有父级城市和给定城市的列表
85:         return $lst;
86:     }
87: }
</file>

