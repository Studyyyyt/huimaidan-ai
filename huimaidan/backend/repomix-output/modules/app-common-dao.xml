 41:     /**
 42:      * 根据条件搜索用户标签。
 43:      *
 44:      * 该方法提供了搜索用户标签的灵活性，根据传入的条件决定搜索的范围和条件。
 45:      * 主要处理两种情况：1) 是否搜索所有标签；2) 是否指定商家ID进行搜索。
 46:      *
 47:      * @param array $where 搜索条件数组，可能包含 'all' 和 'mer_id' 键。
 48:      *                     'all' 表示是否搜索所有标签，'mer_id' 表示商家ID。
 49:      * @return \think\db\Query 用户标签查询结果。
 50:      */
 51:     public function search(array $where = [])
 52:     {
 53:         // 获取用户标签的数据库查询对象
 54:         $db = UserLabel::getDB();
 55: 
 56:         // 如果没有指定搜索所有标签或指定的值为空，则添加类型为0的条件
 57:         $db->when(!isset($where['all']) || $where['all'] === '', function ($query) use ($where) {
 58:             // 当 'all' 不设置或为空时，查询类型为0的标签
 59:             $query->where('type', 0);
 60:         });
 61: 
 62:         // 如果指定了商家ID且不为空，则添加商家ID的条件；否则，添加商家ID为0的条件
 63:         $db->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
 64:             // 当 'mer_id' 设定且不为空时，查询指定商家ID的标签
 65:             $query->where('mer_id', $where['mer_id']);
 66:         }, function ($query) {
 67:             // 当 'mer_id' 未设定或为空时，查询商家ID为0的标签
 68:             $query->where('mer_id', 0);
 69:         });
 70: 
 71:         // 返回处理后的查询对象
 72:         return $db;
 73:     }
