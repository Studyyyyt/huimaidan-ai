 99: 
100:         // 如果条件数组中包含config_classify_id且不为空，则按照分类ID搜索
101:         if (isset($where['config_classify_id']) && $where['config_classify_id'] !== '')
102:             $query->where('config_classify_id', $where['config_classify_id']);
103: 
104:         // 如果条件数组中包含user_type且不为空，则按照用户类型搜索
105:         if (isset($where['user_type']) && $where['user_type'] !== '')
106:             $query->where('user_type', $where['user_type']);
107: 
108:         // 返回构建好的查询对象
109:         return $query;
110:     }
