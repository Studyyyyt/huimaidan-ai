242:      * 它首先获取模型对应的数据库实例，然后使用提供的字段和ID构建删除条件，
243:      * 最后执行删除操作。
244:      *
245:      * @param int $id 主键ID，用于指定要删除的记录。
246:      * @param string $field 要用于删除条件的字段名称。
247:      */
248:     public function clear(int $id, string $field)
249:     {
250:         $this->getModel()::getDB()->where($field, $id)->delete();
251:     }
