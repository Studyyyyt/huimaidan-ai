208:      * @param array $where
209:      * @return mixed
210:      */
211:     public function getProductReplay(int $productId, $where = [0, 5])
212:     {
213:         return $this->getModel()::getDB()->where('product_id', $productId)->whereBetween('rate', $where)->select();
214:     }
