423:                                 $query = $query->whereNotIn($fieldName, is_array($search['value']) ? $search['value'] : [$search['value']]);
424:                             }
425:                             break;
426:                         case CrudOperatorEnum::OPERATOR_EQ:
427:                             switch ($search['form_value']) {
