 80:         })->column('value', 'config_key');
 81: 
 82:         // 遍历查询结果，对每个配置值进行JSON解码
 83:         foreach ($result as $k => &$val) {
 84:             $item = json_decode($val, true);
 85:             if (json_last_error() == JSON_ERROR_NONE) {
 86:                 $val = $item;
 87:             }
 88:             if(!is_array($val)) {
 89:                 $val = (string)$val;
 90:             }
 91:             $result[$k] = $val;
 92:         }
 93: 
 94:         // 返回处理后的配置值数组
 95:         return $result;
 96:     }
 97: 
 98:     /**
 99:      * 根据键值数组和商家ID清除系统配置值
100:      *
101:      * 此方法用于删除指定商家ID下，与给定键值数组中任何键匹配的系统配置值。
102:      * 它通过查询数据库中config_key在给定键值数组内的记录，并且mer_id与指定商家ID匹配，
103:      * 然后删除这些记录来实现清理。
104:      *
105:      * @param array $keys 包含需要清除的系统配置键的数组
106:      * @param int $merId 商家ID，用于限定删除操作的作用范围
107:      * @return int 返回删除操作影响的记录数
108:      */
109:     public function clearBykey(array $keys,int $merId)
110:     {
111:         // 使用whereIn和where组合查询条件，然后执行删除操作
112:         return SystemConfigValue::getDB()->whereIn('config_key', $keys)->where('mer_id', $merId)->delete();
113:     }
114: 
115:     /**
116:      * 清除特定字段值对应的数据记录
117:      *
118:      * 本函数用于根据指定的字段值和该值对应的ID，从数据库中删除相应的记录。
119:      * 这是个通用函数，可以通过传入不同的字段名和ID值来删除不同表中的数据。
120:      *
121:      * @param mixed $id 需要删除的数据记录的ID值，可以是数字、字符串等
122:      * @param string $field 指定的字段名，用于查询和删除数据
123:      */
124:     public function clear($id,$field)
125:     {
126:         // 使用模型获取数据库实例，并构造删除语句，根据字段和ID删除数据
127:         $this->getModel()::getDB()->where($field, $id)->delete();
128:     }
129: 
130:     /**
131:      * 根据键和商户ID获取系统配置的值
132:      *
133:      * 此方法用于查询系统配置表中特定键和商户ID对应的配置值。
134:      * 如果配置值存储为JSON格式，则会将其解码为PHP数组返回。
135:      * 如果不存在匹配的配置项，则返回NULL。
136:      *
137:      * @param string $key 配置的键名，用于查询特定的配置项。
138:      * @param int $merId 商户ID，用于查询特定商户的配置值。如果配置项是全局的，此参数可能无效或被忽略。
139:      * @return mixed 返回查询到的配置值，如果值不存在或查询失败，则返回NULL。配置值如果是JSON格式，则返回解码后的PHP数组。
140:      */
141:     public function value(string $key, int $merId)
142:     {
143:         // 通过键名和商户ID查询配置表中对应的配置值
144:         $value = SystemConfigValue::getDB()->where('config_key', $key)->where('mer_id', $merId)->value('value');
145: 
146:         // 检查查询结果是否为NULL，如果是，则返回NULL；否则，将JSON格式的配置值解码为PHP数组并返回
147:         if(is_null($value)) {
148:             return null;
149:         }
150: 
151:         $item = json_decode($value, true);
152:         if (json_last_error() == JSON_ERROR_NONE) {
153:             $value = $item;
154:         }
155:         if(!is_array($value)) {
156:             $value = (string)$value;
157:         }
158: 
159:         return $value;
160:     }
161: 
162:     /**
163:      * 检查特定商家是否存在指定配置键
164:      *
165:      * 本函数用于确定在数据库中是否存在特定商家ID关联的特定配置键。
166:      * 它通过查询配置表中config_key是否匹配给定的键，并且mer_id是否匹配给定的商家ID来实现。
167:      * 如果找到至少一条匹配的记录，则表示指定的配置键对于给定的商家ID是存在的，函数返回true；
168:      * 如果没有找到匹配的记录，则表示指定的配置键对于给定的商家ID不存在，函数返回false。
169:      *
170:      * @param string $key 配置键的名称
171:      * @param int $merId 商家的ID
172:      * @return bool 如果指定的配置键对于给定的商家ID存在则返回true，否则返回false
173:      */
174:     public function merExists(string $key, int $merId): bool
175:     {
176:         // 通过SystemConfigValue类的静态方法getDB获取数据库操作对象
177:         // 然后使用where方法指定查询条件，分别是config_key为$key和mer_id为$merId
178:         // 最后使用count方法统计满足条件的记录数，如果大于0则表示存在，返回true，否则返回false
179:         return SystemConfigValue::getDB()->where('config_key', $key)->where('mer_id', $merId)->count() > 0;
180:     }
