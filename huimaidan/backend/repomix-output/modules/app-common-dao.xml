 77:     /**
 78:      * 根据条件搜索系统配置信息
 79:      *
 80:      * 本函数用于构建一个搜索系统配置的查询。它根据传入的条件数组来筛选数据库中的配置项。
 81:      * 可以根据配置名、配置键、分类ID、父分类ID和用户类型进行搜索。
 82:      *
 83:      * @param array $where 包含搜索条件的数组，其中键是条件名称，值是条件值。
 84:      *                    支持的条件有：keyword（关键字），pid（父分类ID），config_classify_id（分类ID），user_type（用户类型）。
 85:      * @return \Illuminate\Database\Query\Builder|static 返回构建好的查询对象，可以进一步调用其他查询方法或执行查询。
 86:      */
 87:     public function search(array $where)
 88:     {
 89:         // 从SystemConfig类中获取数据库实例
 90:         $query = SystemConfig::getDB();
 91: 
 92:         // 如果条件数组中包含keyword且不为空，则按照关键字搜索配置名或配置键
 93:         if (isset($where['keyword']) && $where['keyword'] !== '' )
