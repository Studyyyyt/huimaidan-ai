 41:     /**
 42:      * 更新商家配置信息
 43:      *
 44:      * 该方法用于更新特定商家的配置项值。如果传入的数据中包含'value'键，
 45:      * 其值将被转换为JSON格式存储。这允许灵活存储复杂数据结构，
 46:      * 而不需要修改数据库结构。
 47:      *
 48:      * @param int $merId 商家ID，用于确定要更新哪个商家的配置
 49:      * @param string $key 配置项的键，指定要更新的配置项
 50:      * @param array $data 包含要更新的配置项数据的数组，如果'value'键存在，其值将被JSON编码
 51:      * @return int 返回更新操作影响的行数，用于确认更新是否成功
 52:      */
 53:     public function merUpdate(int $merId, string $key, array $data)
 54:     {
 55:         // 检查$data数组中是否包含'value'键，如果存在，则将其值转换为JSON格式
 56:         if (isset($data['value']) && is_array($data['value'])) {
 57:             $data['value'] = json_encode($data['value']);
 58:         }
 59: 
 60:         // 使用SystemConfigValue类的数据库访问对象，根据$merId和$key更新配置数据
 61:         // 返回更新操作影响的行数
 62:         return SystemConfigValue::getDB()->where('mer_id', $merId)->where('config_key', $key)->update($data);
 63:     }
 64: 
 65:     /**
 66:      * 根据配置键和商家ID获取配置值
 67:      * 此方法用于从数据库中检索指定商家ID和配置键对应的配置值。
 68:      * 它首先通过配置键和商家ID查询数据库，然后对查询结果进行处理，将JSON格式的配置值解析为数组。
 69:      * 最后，返回一个关联数组，其中配置键作为键，对应的配置值作为值。
 70:      *
 71:      * @param array $keys 配置键的数组
 72:      * @param int $merId 商家ID
 73:      * @return array 解析后的配置值数组，键为配置键，值为配置值
 74:      */
 75:     public function fields(array $keys, int $merId)
 76:     {
 77:         // 使用whereIn和where查询满足条件的配置项，并通过withAttr对查询结果的'value'字段进行处理
 78:         $result = SystemConfigValue::getDB()->whereIn('config_key', $keys)->where('mer_id', $merId)->withAttr('value', function ($val, $data) {
