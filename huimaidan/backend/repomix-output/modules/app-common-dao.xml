493:     /**
494:      * 初始化用户每日传播限制
495:      *
496:      * 本函数用于更新用户数据库中指定用户的传播限制日期。它通过计算当前日期之后的指定天数，
497:      * 设置用户的传播限制时间为未来某一天的特定时间点。这有助于管理用户的传播活动，确保他们
498:      * 在指定的时间范围内进行传播行为。
499:      *
500:      * @param int $day 传播限制的生效天数。从当前日期开始，多少天后传播限制将生效。
501:      * @return int 返回更新操作影响的行数。这可以用来确认更新操作是否成功。
502:      */
503:     public function initSpreadLimitDay(int $day)
504:     {
505:         // 使用User类的getDB方法获取数据库连接，并构造更新语句。
506:         // 更新条件是spread_uid大于0，这意味着只更新具有有效传播标识符的用户。
507:         // 更新的字段是spread_limit，其值为当前时间向后推$day天后的日期和时间。
508:         return User::getDB()->where('spread_uid', '>', 0)->update(['spread_limit' => date('Y-m-d H:i:s', strtotime("+ $day day"))]);
509:     }
510: 
511:     /**
512:      * 清除用户的每日传播限制
513:      *
514:      * 本函数用于更新数据库中满足条件的用户记录，将他们的传播限制设置为null。
515:      * 这样做可以解除这些用户在当天的传播次数限制，允许他们继续进行传播操作。
516:      *
517:      * @return int 返回影响的行数，即被更新的用户记录数。
518:      */
519:     public function clearSpreadLimitDay()
520:     {
521:         // 使用User类的getDB方法获取数据库连接，并构造更新语句，更新满足条件的用户的spread_limit字段为null。
522:         return User::getDB()->where('spread_uid', '>', 0)->update(['spread_limit' => null]);
523:     }
524: 
525: 
526:     /**
527:      * 更新用户的传播限制日期
528:      *
529:      * 本函数用于根据指定的天数更新用户的传播限制日期。它首先更新所有传播用户ID大于0且传播限制日期为空的用户的传播限制日期为当前日期加上指定天数。
530:      * 然后，它更新所有传播用户ID大于0且传播限制日期不为空的用户的传播限制日期为当前传播限制日期加上指定天数。
531:      * 这样做的目的是确保所有用户的传播限制日期都被正确地根据业务需求进行更新。
532:      *
533:      * @param int $day 要添加的天数，用于更新传播限制日期。
534:      * @return int 返回影响的行数，表示成功更新的用户数量。
535:      */
536:     public function updateSpreadLimitDay(int $day)
537:     {
538:         // 更新所有传播用户ID大于0且传播限制日期为空的用户的传播限制日期为当前日期加上指定天数
539:         User::getDB()->where('spread_uid', '>', 0)->whereNull('spread_limit')->update(['spread_limit' => date('Y-m-d H:i:s', strtotime("+ $day day"))]);
540: 
541:         // 更新所有传播用户ID大于0且传播限制日期不为空的用户的传播限制日期为当前传播限制日期加上指定天数
542:         return User::getDB()->where('spread_uid', '>', 0)->whereNotNull('spread_limit')->update(['spread_limit' => Db::raw('TIMESTAMPADD(DAY, ' . $day . ', `spread_limit`)')]);
543:     }
544: 
545: 
546:     /**
547:      * 同步传播状态
548:      *
549:      * 本函数用于更新用户数据库中满足特定条件的记录的传播相关字段。
550:      * 它针对的是那些传播者ID大于0，传播限制日期不为空且小于等于当前日期的用户记录。
551:      * 对于这些记录，它将传播时间、传播者ID和传播限制日期字段重置为null。
552:      * 这个函数的存在是为了处理传播活动的结束或无效化，确保数据库的准确性和一致性。
553:      *
554:      * @return int 返回更新的记录数。这可以让调用者知道有多少条记录受到了影响。
555:      */
556:     public function syncSpreadStatus()
557:     {
558:         // 使用where子句构建查询条件，筛选出需要更新的记录。
559:         // 这里解释了为什么会有这些特定的查询条件，即为了找出那些传播活动已结束或无效的用户。
560:         return User::getDB()->where('spread_uid', '>', 0)->whereNotNull('spread_limit')->where('spread_limit', '<=', date('Y-m-d H:i:s'))->update(['spread_time' => null, 'spread_uid' => 0, 'spread_limit' => null]);
561:     }
562: 
563: 
564:     /**
565:      * 增加用户的传播次数
566:      *
567:      * 此方法用于更新指定用户的传播次数。它通过查询数据库找到对应用户，
568:      * 然后将该用户的传播次数增加1。这种方法适用于需要记录用户传播行为的场景，
569:      * 比如计算用户的分享、推荐或邀请次数。
570:      *
571:      * @param int $uid 用户ID
572:      *          传入用户的唯一标识符，用于在数据库中定位到该用户。
573:      */
574:     public function incSpreadCount($uid)
575:     {
576:         // 使用User类的静态方法getDB来获取数据库实例，并根据$uid更新用户的传播次数
577:         User::getDB()->where('uid', $uid)->update([
578:             // 使用数据库原生表达式来增加spread_count列的值，避免直接的字符串拼接
579:             'spread_count' => Db::raw('spread_count + 1')
580:         ]);
581:     }
582: 
583: 
584:     /**
585:      * 减少用户的传播数。
586:      *
587:      * 本函数用于更新指定用户的传播数，将其传播数减少1。传播数可能是用户分享、邀请他人等行为的统计，
588:      * 通过减少传播数可以反映用户行为的回溯或撤销。
589:      *
590:      * @param int $uid 用户ID。此参数用于指定哪个用户的传播数需要减少。
591:      */
592:     public function decSpreadCount($uid)
593:     {
594:         // 使用User类的getDB方法获取数据库实例，并通过where语句构建条件，更新指定用户的传播数
595:         User::getDB()->where('uid', $uid)->where('spread_count','>',0)->update([
596:             'spread_count' => Db::raw('spread_count - 1')
597:         ]);
598:     }
599: }
