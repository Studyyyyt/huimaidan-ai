659:      *
660:      * @param int $mer_id 商家ID，用于限定查询的商家范围。
661:      * @param int $product_id 商品ID，用于指定需要更新价格的具体商品。
662:      * @param float $price 新的商品价格，这是需要更新到数据库的值。
663:      * @return bool 返回更新操作的结果，成功为true，失败为false。
664:      */
665:     public function updatePrice($mer_id, $product_id, $price)
666:     {
667:         // 使用模型获取数据库实例，并构建更新查询条件，特定商家ID、商品ID和商品类型为0，然后更新商品价格
668:         return $this->getModel()::getDB()->where('mer_id', $mer_id)->where('product_id', $product_id)->where('product_type', 0)->update(['price' => $price]);
