333:                     $alias     = $item['alias'] ?? $defaulAlias;
334:                     $fieldName = ($alias ? $alias . '.' : '') . $search['field_name'];
335:                 }
336:                 $query->{$logic}(function(Query  $query) use($search, $fieldName){
337:                     switch ($search['operator']) {
338:                         case CrudOperatorEnum::OPERATOR_IN :
339:                             if (isset($search['form_value'])) {
340:                                 switch ($search['form_value']) {
341:                                     case CrudFormEnum::FORM_INPUT:
342:                                     case CrudFormEnum::FORM_TEXTAREA:
343:                                         if (is_array($search['value'])) {
344:                                             $search['value'] = json_encode($search['value']);
