453:                                     break;
454:                             }
455:                             break;
456:                         case CrudOperatorEnum::OPERATOR_LT:
457:                             switch ($search['form_value']) {
458:                                 case CrudFormEnum::FORM_DATE_TIME_PICKER:
459:                                     $query = $query->whereTime($fieldName,'<', $search['value']);
460:                                     break;
