557:     /**
558:      * 根据给定的条件查找或创建数据。
559:      * 该方法遍历一个条件数组，并对每个条件尝试查找对应的数据记录。
560:      * 如果找不到，则根据条件创建新记录。
561:      * @param array $where 包含多个查询条件的数组，每个条件可能包含product_id, product_type, activity_id。
562:      */
563:     public function findOrCreateAll(array $where)
564:     {
565:         // 遍历条件数组
566:         foreach ($where as $item) {
567:             // 确保activity_id有值，如果未指定，则默认为0
568:             $item['activity_id'] = $item['activity_id'] ?? 0;
569: 
570:             // 根据条件查询数据库，尝试找到匹配的记录
571:             $data = $this->getModel()::getDB()->where('product_id', $item['product_id'])
572:                 ->where('product_type', $item['product_type'])
573:                 ->where('activity_id', $item['activity_id'])
574:                 ->find();
575: 
576:             // 如果查询结果为空，则意味着该条件下的记录不存在，需要创建新记录
577:             if (!$data) {
578:                 $this->create($item);
579:             }
580:         }
581:     }
