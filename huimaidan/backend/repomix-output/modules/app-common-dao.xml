 52: 
 53:         // 添加条件查询：商家ID
 54:         $query->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use ($where) {
 55:             $query->where('StoreRefundOrder.mer_id', $where['mer_id']);
 56:         });
 57:         // 分组权限
 58:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
 59:             $query->whereIn('StoreRefundOrder.mer_id', $region);
 60:         }
 61:         // 添加条件查询：订单号
 62:         $query->when(isset($where['order_sn']) && $where['order_sn'] !== '', function ($query) use ($where) {
