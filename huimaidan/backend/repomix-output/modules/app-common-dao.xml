64:             ->whereIn('A.order_product_id', $ids)->group('A.order_product_id')
65:             ->field('A.order_product_id, SUM(A.refund_price) as refund_price, SUM(A.platform_refund_price) as platform_refund_price, SUM(A.refund_postage) as refund_postage, SUM(A.refund_integral) as refund_integral')
66:             ->select()->toArray();
67: 
68:         // 将查询结果重新组织为以订单产品ID为键的数组，方便后续根据订单产品ID快速查找退款详情
69:         $data = [];
70:         foreach ($lst as $item) {
71:             $data[$item['order_product_id']] = $item;
72:         }
73: 
74:         // 返回重新组织后的数据数组
75:         return $data;
76:     }
