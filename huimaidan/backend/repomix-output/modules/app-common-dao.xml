 67: 
 68:         if (isset($where['article_id']) && $where['article_id'] !== ''){
 69:             if (is_array($where['article_id'])) {
 70:                 $query->whereIn('article_id', $where['article_id']);
 71:             } else {
 72:                 $query->where('article_id', $where['article_id']);
 73:             }
 74: 
 75:         }
 76: 
 77: 
 78:         $query->with(['content','articleCategory']);
 79: 
 80:         return $query->where('mer_id',$merId)->order('sort DESC,create_time DESC');
