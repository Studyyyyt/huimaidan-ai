 29:      * @email 442384644@qq.com
 30:      * @date 2024/7/17
 31:      */
 32:     public function search($where)
 33:     {
 34:         $query = ProductGroup::hasWhere('product',function($query)use($where){
 35:             $query->where('status',1);
 36:             $query->when(isset($where['keyword']) && $where['keyword'] !== '',function($query)use($where){
 37:                 $query->whereLike('store_name',"%{$where['keyword']}%");
 38:             });
 39:         });
 40:         // 分组权限
 41:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
 42:             $query->whereIn('ProductGroup.mer_id', $region);
 43:         }
 44:         $query->when(isset($where['is_show']) && $where['is_show'] !== '',function($query)use($where){
 45:                 $query->where('ProductGroup.is_show',$where['is_show']);
 46:             })
 47:             ->when(isset($where['product_status']) && $where['product_status'] !== '',function($query)use($where){
 48:                 if($where['product_status'] == -1){
 49:                     $query->where('ProductGroup.product_status','in',[-1,-2]);
 50:                 }else{
 51:                     $query->where('ProductGroup.product_status',$where['product_status']);
 52:                 }
 53:             })
 54:             ->when(isset($where['status']) && $where['status'] !== '',function($query)use($where){
 55:                 $query->where('ProductGroup.status',$where['status']);
 56:             })
 57:             ->when(isset($where['end_time']) && $where['end_time'] !== '',function($query)use($where){
 58:                 $query->whereTime('ProductGroup.end_time','>',$where['end_time']);
 59:             })
 60:             ->when(isset($where['active_type']) && $where['active_type'] !== '',function($query)use($where){
 61:                 $query->where('ProductGroup.action_status',$where['active_type']);
 62:             })
 63:             ->when(isset($where['is_trader']) && $where['is_trader'] !== '',function($query)use($where){
 64:                 $query->join('Merchant M','M.mer_id = ProductGroup.mer_id')->where('is_trader',$where['is_trader']);
 65:             })
 66:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '',function($query)use($where){
 67:                 if(is_array($where['mer_id'])) {
 68:                     $query->whereIn('ProductGroup.mer_id', $where['mer_id']);
 69:                 } else {
 70:                     $query->where('ProductGroup.mer_id',$where['mer_id']);
 71:                 }
 72:             })
 73:             ->when(isset($where['product_group_id']) && $where['product_group_id'] !== '',function($query)use($where){
 74:                 $query->where('ProductGroup.product_group_id',$where['product_group_id']);
 75:             })
 76:              ->when(isset($where['store_category_id']) && $where['store_category_id'] !== '',function($query)use($where){
 77:                  $query->join('StoreCategory C','Product.cate_id = C.store_category_id')
 78:                      ->whereLike('path',"/{$where['store_category_id']}/%");
 79:              })
 80:             ->when(isset($where['us_status']) && $where['us_status'] !== '',function($query)use($where){
 81:                 if($where['us_status'] == 0) {
 82:                     $query->where('ProductGroup.is_show',0)->where('ProductGroup.status',1)->where('ProductGroup.product_status',1);
 83:                 }
 84:                 if($where['us_status'] == 1) {
 85:                     $query->where('ProductGroup.is_show',1)->where('ProductGroup.status',1)->where('ProductGroup.product_status',1);
 86:                 }
 87:                 if($where['us_status'] == -1) {
 88:                     $query->where(function($query){
 89:                         $query->where('ProductGroup.status',0)->whereOr('ProductGroup.product_status','<>',1);
 90:                     });
 91:                 }
 92:             });
 93: 
 94:         $query->join('StoreSpu U','ProductGroup.product_group_id = U.activity_id')->where('U.product_type',4);
 95: 
 96:         $query->when(isset($where['star']) && $where['star'] !== '',function($query)use($where){
