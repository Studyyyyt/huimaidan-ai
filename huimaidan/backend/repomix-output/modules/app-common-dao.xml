601:      * 获取指定类型下激活状态的商品分类路径
602:      *
603:      * 本函数用于查询特定类型的商品所属于的激活状态分类的路径。
604:      * 通过JOIN操作关联了Spu、StoreProduct和StoreCategory三个表，
605:      * 以获取商品ID和分类ID之间的关联，并筛选出状态为激活且显示状态为是的分类。
606:      *
607:      * @param string $type 商品类型标识
608:      * @return array 返回一个包含分类路径的数组
609:      */
610:     public function getActivecategory($type)
611:     {
612:         // 初始化查询，设置表别名为S，并JOIN产品和分类表
613:         $query = Spu::getDB()->alias('S')->join('StoreProduct P','S.product_id = P.product_id')
614:             ->join('StoreCategory C','C.store_category_id = P.cate_id');
615: 
616:         // 筛选条件：商品状态为激活，商品类型为参数类型，分类显示状态为是
617:         $query->where('S.status',1)->where('S.product_type',$type)->where('C.is_show',1);
618: 
619:         // 分组查询以确保每个产品ID只出现一次，并返回分类路径列
620:         return $query->group('S.product_id')->column('C.path');
621:     }
