 28:     public function search(array $where)
 29:     {
 30:         $query = ProductPresell::hasWhere('product',function($query)use($where){
 31:             $query->when(isset($where['product_show']) && $where['product_show'] !== '',function($query)use($where){
 32:                     $query->where('is_del',0)->where('mer_status',1);
 33:                 })
 34:                 ->when(isset($where['product_type']) && $where['product_type'] !== '',function($query)use($where){
 35:                     $query->where('product_type',2);
 36:                 })
 37:                 ->where('status',1);
 38:         });
 39:         // 分组权限
 40:         if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
 41:             $query->whereIn('ProductPresell.mer_id', $region);
 42:         }
 43:         $query->join('StoreSpu U', 'ProductPresell.product_presell_id = U.activity_id')->where('U.product_type', 2);
 44:         $query->when(isset($where['product_presell_id']) && $where['product_presell_id'] !== '',function($query)use($where){
 45:                 $query->where('product_presell_id',$where['product_presell_id']);
 46:             })
 47:             ->when(isset($where['mer_id']) && $where['mer_id'] !== '',function($query)use($where){
 48:                 if(is_array($where['mer_id'])) {
 49:                     $query->whereIn('ProductPresell.mer_id', $where['mer_id']);
 50:                 } else {
 51:                     $query->where('ProductPresell.mer_id',$where['mer_id']);
 52:                 }
 53:             })
 54:             ->when(isset($where['is_del']) && $where['is_del'] !== '',function($query)use($where){
 55:                 $query->where('ProductPresell.is_del',$where['is_del']);
 56:             })
 57:             ->when(isset($where['action_status']) && $where['action_status'] !== '',function($query)use($where){
 58:                 $query->where('ProductPresell.action_status',$where['action_status']);
 59:             })
 60:             ->when(isset($where['keyword']) && $where['keyword'] !== '',function($query)use($where){
 61:                 $query->whereLike('ProductPresell.store_name|ProductPresell.product_id|ProductPresell.product_presell_id',"%{$where['keyword']}%");
 62:             })
 63:             ->when(isset($where['product_status']) && $where['product_status'] !== '',function($query)use($where){
 64:                 if($where['product_status'] == -1){
 65:                     $query->where('ProductPresell.product_status','in',[-1,-2]);
 66:                 }else{
 67:                     $query->where('ProductPresell.product_status',$where['product_status']);
 68:                 }
 69:             })
 70:             ->when(isset($where['presell_type']) && $where['presell_type'] !== '',function($query)use($where){
 71:                 $query->where('ProductPresell.presell_type',$where['presell_type']);
 72:             })
 73:             ->when(isset($where['type']) && $where['type'] !== '',function($query)use($where){
 74:                 switch ($where['type']){
 75:                     case 0: //未开始
 76:                         if(isset($where['api_type'])){
 77:                             $query->where('product_status',1);
 78:                         }
 79:                         $query->where('action_status',1);
 80:                         $query->where(function($query){
 81:                             $query->whereTime('start_time','>',time())->whereOr(function ($query){
 82:                                 $query->whereTime('start_time','<',time())->whereTime('end_time','>',time())->where(function($query){
 83:                                     $query->where('ProductPresell.product_status','<>',1)->whereOr('ProductPresell.is_show','<>',1)->whereOr('ProductPresell.status','<>',1);
 84:                                 });
 85:                             });
 86:                         });
 87:                         break;
 88:                     case 1: //进行中
 89:                         $query->where('action_status',1)
 90:                             ->whereTime('start_time','<=',time())
 91:                             ->whereTime('end_time','>',time())
 92:                             ->where('product_status',1)
 93:                             ->where('ProductPresell.status',1)
 94:                             ->where('ProductPresell.is_show',1);
 95:                         break;
 96:                     case 2: //已结束
 97:                             $query->where(function($query){
 98:                                 $query->where('action_status',-1)->whereOr('end_time','<= TIME',time());
 99:                             });
100:                         break;
101:                     case 3: //已关闭
102:                         $query->where(function($query){
103:                             $query->where(function($query){
104:                                 $query->where('ProductPresell.presell_type',1)->whereTime('end_time','<',time());
105:                             })->whereOr(function($query){
106:                                 $query->where('ProductPresell.presell_type',2)->whereTime('final_end_time','<',time());
107:                             });
108:                         });
109:                         break;
110:                     case 4: //未开始 和 进行中
111:                         if (isset($where['api_type'])) {
112:                             $query->where('product_status', 1);
113:                         }
114:                         $query->where('action_status', 1)
115:                             ->whereTime('end_time', '>', time())
116:                             ->where('product_status', 1)
117:                             ->where('ProductPresell.status', 1)
118:                             ->where('ProductPresell.is_show', 1);
119:                         $query->whereOr(function ($query) {
120:                             $query->whereTime('start_time', '<', time())->whereTime('end_time', '>', time())->where(function ($query) {
121:                                 $query->where('ProductPresell.product_status', '<>', 1)->whereOr('ProductPresell.is_show', '<>', 1)->whereOr('ProductPresell.status', '<>', 1);
122:                             });
123:                         });
124:                         break;
125:                     default:
126:                         $query->where(function($query){
127:                             $query->where(function($query){
128:                                 $query->where('ProductPresell.presell_type',1)->whereTime('end_time','>',time());
129:                             })->whereOr(function($query){
130:                                 $query->where('ProductPresell.presell_type',2)->whereTime('final_end_time','>',time());
131:                             });
132:                         });
133:                         break;
134:                 }
135:             })
136:             ->when(isset($where['status']) && $where['status'] !== '',function($query)use($where){
137:                 $query->where('ProductPresell.status',$where['status']);
138:             })
139:             ->when(isset($where['is_show']) && $where['is_show'] !== '',function($query)use($where){
140:                 $query->where('ProductPresell.is_show',$where['is_show']);
141:             })
142:             ->when(isset($where['mer_name']) && $where['mer_name'] !== '',function($query)use($where){
143:                 $make = app()->make(MerchantRepository::class);
144:                 $mer_id = $make->search(['keyword' => $where['mer_name']])->column('mer_id');
145:                 $query->whereIn('ProductPresell.mer_id',$mer_id);
146:             })
147:             ->when(isset($where['is_trader']) && $where['is_trader'] !== '',function($query)use($where){
148:                 $make = app()->make(MerchantRepository::class);
149:                 $mer_id = $make->search(['is_trader' => $where['is_trader']])->column('mer_id');
150:                 $query->whereIn('ProductPresell.mer_id',$mer_id);
151:             })
152:             ->when(isset($where['us_status']) && $where['us_status'] !== '',function($query)use($where){
153:                if($where['us_status'] == 0) {
154:                   $query->where('ProductPresell.is_show',0)->where('ProductPresell.status',1)->where('ProductPresell.product_status',1);
155:                }
156:                if($where['us_status'] == 1) {
157:                    $query->where('ProductPresell.is_show',1)->where('ProductPresell.status',1)->where('ProductPresell.product_status',1);
158:                }
159:                if($where['us_status'] == -1) {
160:                    $query->where(function($query){
161:                        $query->where('ProductPresell.status',0)->whereOr('ProductPresell.product_status','<>',1);
162:                    });
163:                }
164:             });
165:         $query->when(isset($where['mer_labels']) && $where['mer_labels'] !== '', function ($query) use ($where) {
166:                 $query->whereLike('U.mer_labels', "%,{$where['mer_labels']},%");
167:             })
168:             ->when(isset($where['sys_labels']) && $where['sys_labels'] !== '', function ($query) use ($where) {
169:                 $query->whereLike('U.sys_labels', "%,{$where['sys_labels']},%");
170:             })
171:             ->when(isset($where['star']),function($query)use($where){
172:                 $query->when($where['star'] !== '', function ($query) use ($where) {
173:                     $query->where('U.star', $where['star']);
174:                 });
175:                 $query->order('U.star DESC,U.rank DESC,ProductPresell.create_time DESC');
176:             });
177:         $query->where('ProductPresell.is_del',0);
178:         return $query;
179:     }
