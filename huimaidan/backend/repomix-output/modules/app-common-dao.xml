48:      * @param int|null $except 排除的记录ID，如果为null，则不进行排除
49:      * @param int $type 查询的数据类型，用于进一步筛选数据
50:      * @return bool 如果字段存在则返回true，否则返回false
51:      */
52:     public function fieldExists($field, $value, ?int $except = null, int $type = 0): bool
53:     {
54:         // 构建查询条件，查询指定类型且字段值符合的记录
55:         $query = ($this->getModel())::getDB()->where('type',$type)->where($field, $value);
56: 
57:         // 如果指定了排除的ID，则添加到查询条件中，排除该记录
58:         if (!is_null($except)) $query->where($this->getPk(), '<>', $except);
59: 
60:         // 返回查询结果是否存在，存在则返回true，否则返回false
61:         return $query->count() > 0;
62:     }
63: }
