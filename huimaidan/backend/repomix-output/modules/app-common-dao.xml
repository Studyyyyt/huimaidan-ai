 32:      * @day 2020-03-30
 33:      */
 34:     protected function getModel(): string
 35:     {
 36:         return Admin::class;
 37:     }
 38: 
 39:     /**
 40:      * 根据条件搜索管理员信息。
 41:      *
 42:      * 方法通过懒加载方式构建查询条件，只有在需要时才添加相应的查询条件，提高了查询的灵活性和性能。
 43:      *
 44:      * @param array $where 查询条件数组，包含各种可能的搜索条件。
 45:      * @param int $is_del 是否已删除的标志，0表示未删除，非0表示已删除。
 46:      * @param bool $level 是否考虑级别条件，true表示只查询级别不为0的记录。
 47:      * @return BaseQuery 查询构建器实例，可用于进一步的查询操作或数据获取。
 48:      */
 49:     public function search(array $where = [], $is_del = 0,$level = true)
 50:     {
 51:         // 获取管理员表的数据库查询构建器
 52:         $query = Admin::getDB();
 53: 
 54:         // 如果考虑级别条件，添加级别不为0的查询条件
 55:         if($level) $query->where('level', '<>', 0);
 56: 
 57:         // 如果指定了删除状态，添加相应的查询条件
 58:         $query->when($is_del !== null, function ($query) use ($is_del) {
 59:             $query->where('is_del', $is_del);
 60:         });
 61: 
 62:         // 如果指定了日期范围，添加日期范围的查询条件
 63:         $query->when(isset($where['date']) && $where['date'] !== '', function ($query) use ($where) {
 64:             getModelTime($query, $where['date']);
 65:         });
 66: 
 67:         // 如果指定了关键字，添加关键字的模糊查询条件
 68:         if (isset($where['keyword']) && $where['keyword'] !== '') {
 69:             $query->whereLike('real_name|account', '%' . $where['keyword'] . '%');
 70:         }
 71: 
 72:         // 如果指定了状态，添加状态的查询条件
 73:         if (isset($where['status']) && $where['status'] !== '') {
 74:             $query->where('status', intval($where['status']));
 75:         }
 76: 
 77:         if (isset($where['is_agent']) && $where['is_agent'] !== '') {
 78:             $query->where('is_agent', intval($where['is_agent']))->where('circle_agent_id', 0);
 79:         }
 80: 
 81:         if (isset($where['region_id']) && $where['region_id'] !== '') {
 82:             $query->whereFindInSet('region_ids', $where['region_id']);
 83:             // $query->whereLike('region_ids', "%,{$where['region_id']},%");
 84:         }
 85: 
 86:         if(isset($where['circle_agent_id']) && $where['circle_agent_id'] !== '') {
 87:             $query->where('circle_agent_id', intval($where['circle_agent_id']));
 88:         }
 89: 
 90:         // 返回构建好的查询构建器实例
 91:         return $query;
 92:     }
 93: 
 94: 
 95:     /**
 96:      * 检查指定ID的记录是否存在且未被删除。
 97:      *
 98:      * 本函数通过查询数据库来确定给定ID的记录是否存在，并且其删除标志位是否为0（即未被删除）。
 99:      * 主要用于在执行删除、更新等操作前验证记录的有效性，避免错误的操作导致数据丢失或错误。
100:      *
101:      * @param int $id 要检查的记录的唯一标识ID。
102:      * @return bool 如果记录存在且未被删除，则返回true；否则返回false。
103:      */
104:     public function exists(int $id)
105:     {
106:         // 构建查询条件，查询指定ID且未被删除的记录
107:         $query = ($this->getModel())::getDB()->where($this->getPk(), $id)->where('is_del', 0);
108: 
109:         // 判断查询结果的数量是否大于0，如果大于0则表示记录存在
110:         return $query->count() > 0;
111:     }
112: 
113:     /**
114:      * 根据ID获取管理员信息
115:      *
116:      * 本函数用于通过管理员的ID，从数据库中查询并返回对应的管理员信息。
117:      * 特别注意，这里只返回未被删除（is_del字段为0）的管理员信息。
118:      *
119:      * @param int $id 管理员的唯一标识ID
120:      * @return array|false 返回管理员的信息数组，如果找不到则返回false。
121:      */
122:     public function get( $id)
123:     {
124:         // 通过Admin类的单例模式获取管理员实例，然后查询数据库中is_del为0且ID为$id的管理员信息
125:         return Admin::getInstance()->where('is_del', 0)->find($id);
126:     }
127: 
128:     /**
129:      * 检查指定字段是否存在指定值（且未被删除）。
130:      *
131:      * 此方法用于查询数据库中是否存在指定字段的值，并且该记录没有被删除。
132:      * 可以通过传递一个排除ID来排除特定的记录。
133:      *
134:      * @param string $field 要检查的字段名。
135:      * @param mixed $value 字段应该具有的值。
136:      * @param int|null $except 排除的ID，可选参数，用于排除特定的记录。
137:      * @return bool 如果找到符合条件的记录，则返回true，否则返回false。
138:      */
139:     public function fieldExists($field, $value, ?int $except = null): bool
140:     {
141:         // 初始化查询，查询具有指定字段值并且未被删除的记录
142:         $query = ($this->getModel())::getDB()->where($field, $value)->where('is_del', 0);
143: 
144:         // 如果提供了排除ID，则添加条件以排除该ID的记录
145:         if (!is_null($except)) {
146:             $query->where($this->getPk(), '<>', $except);
147:         }
148: 
149:         // 返回查询结果是否存在，即记录数是否大于0
150:         return $query->count() > 0;
151:     }
152: 
153:     /**
154:      * 通过管理员账号获取管理员信息
155:      *
156:      * 本函数用于查询并返回与指定管理员账号相关联的信息。它通过管理员账号查找管理员数据库记录，
157:      * 并返回包含管理员账号、密码、真实姓名、登录次数、管理员ID和状态等信息的对象。
158:      * 这样做的目的是为了提供一种方式来验证管理员身份或获取管理员的详细信息。
159:      *
160:      * @param string $account 管理员账号
161:      * @return array|null 包含管理员信息的数组，如果找不到管理员则返回null
162:      */
163:     public function accountByAdmin(string $account)
164:     {
165:         // 通过管理员类的单例获取管理员实例
166:         return Admin::getInstance()->where('account', $account)
167:             // 确保查询的管理员未被删除
168:             ->where('is_del', 0)
169:             // 指定查询的字段，以减少不必要的数据返回
170:             ->field(['account', 'pwd', 'real_name', 'login_count', 'admin_id', 'status', 'is_agent', 'circle_agent_id', 'region_ids'])
171:             ->append(['region_name'])
172:             // 执行查询并返回结果
173:             ->find();
174:     }
175: }
