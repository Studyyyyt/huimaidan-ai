220:                         $query->whereOr('city_id', 'like', "%/{$cityId}/%");
221:                     }
222:                     $query->order('shipping_template_free_id DESC')->withLimit(1);
223:                 },
224:                 'undelives' => function ($query) use ($cityIds) {
225:                     foreach ($cityIds as $cityId) {
226:                         $query->whereOr('city_id', 'like', "%/{$cityId}/%");
227:                     }
228:                 }
229:             ])
230:             ->select()
231:             ->column(null, 'id'); // 按模板 ID 索引结果
232: 
233:         // 将模板数据分配给购物车项
