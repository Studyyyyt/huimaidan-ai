424:     /**
425:      * 根据指定日期分组统计用户数量
426:      *
427:      * 本函数用于查询在指定日期范围内每天新增的用户数量。
428:      * 通过数据库查询语句实现，根据用户创建时间进行分组，统计每天的新增用户数。
429:      * 如果指定了日期，则查询该日期范围内的数据；如果未指定日期，则查询所有数据。
430:      *
431:      * @param mixed $date 查询的日期范围。如果为NULL，则查询所有数据；否则，查询指定日期范围内的数据。
432:      * @return array 返回一个数组，其中每个元素包含日期和该日期新增的用户数量。
433:      */
434:     public function userNumGroup($date)
435:     {
436:         // 根据$date的值决定是否添加时间范围的查询条件
437:         return User::getDB()->when($date, function ($query, $date) {
