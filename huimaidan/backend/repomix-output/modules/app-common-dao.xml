  59:     }
  60: 
  61:     /**
  62:      * 订单搜索
  63:      * @param array $where
  64:      * @param int $sysDel
  65:      * @return BaseQuery
  66:      * @author wuhaotian
  67:      * @email 442384644@qq.com
  68:      * @date 2024/7/16
  69:      */
  70:     public function search(array $where, $sysDel = 0)
  71:     {
  72:         $query = StoreOrder::hasWhere('merchant', function ($query) use ($where) {
  73:             // 分组权限
  74:             if (app('request')->hasMacro('regionAuthority') && $region = app('request')->regionAuthority()) {
  75:                 $query->whereIn('mer_id', $region);
  76:             }
  77:             if (isset($where['is_trader']) && $where['is_trader'] !== '') {
  78:                 $query->where('is_trader', $where['is_trader']);
  79:             }
  80:             $query->where('is_del', 0);
  81:         });
  82:         $query = $this->whereSearch($query, $where, $sysDel);
  83:         return $query;
  84:     }
  85: 
  86:     public function whereSearch($query, $where, $sysDel = 0)
  87:     {
  88:         $query->where('StoreOrder.activity_type', '<>', 20);
  89:         $query->when(($sysDel !== null), function ($query) use ($sysDel) {
  90:             $query->where('is_system_del', $sysDel);
  91:         });
  92:         $query->when(isset($where['order_type']) && $where['order_type'] >= 0 && $where['order_type'] !== '', function ($query) use ($where) {
  93:             if ($where['order_type'] == 2) {
  94:                 $query->where('is_virtual', 1);
  95:             } else if ($where['order_type'] == 3) { // 卡密商品
  96:                 $query->whereIn('is_virtual', [2,3]);
  97:             } else if ($where['order_type'] == 4) { // 预约商品订单
  98:                 $query->where('is_virtual', 4);
  99:             } else {
 100:                 $query->where('order_type', $where['order_type']);
 101:             }
 102:         });
 103:         $query->when(isset($where['activity_type']) && $where['activity_type'] !== '', function ($query) use ($where) {
 104:             $query->where('StoreOrder.activity_type', $where['activity_type']);
 105:         })
 106:             ->when(isset($where['status']) && $where['status'] !== '', function ($query) use ($where) {
 107:                 switch ($where['status']) {
 108:                     case 0 :
 109:                         $query->whereIn('StoreOrder.status', [0, 9, 20]);
 110:                         break;
 111:                     case -2 :
 112:                         $query->whereNotIn('StoreOrder.status', [10, 11]);
 113:                         break;
 114:                     case 10 :
 115:                         $query->where('paid', 1)->whereIn('StoreOrder.status', [10, 11]);
 116:                         break;
 117:                     case 11 :
 118:                         $query->where('paid', 1)->whereIn('StoreOrder.status', [2, 3]);
 119:                         break;
 120:                     default:
 121:                         $query->where('StoreOrder.status', $where['status']);
 122:                         break;
 123:                 }
 124:             })
 125:             ->when(isset($where['uid']) && $where['uid'] !== '', function ($query) use ($where) {
 126:                 $query->where('StoreOrder.uid', $where['uid']);
 127:             })
 128:             ->when(isset($where['is_spread']) && $where['is_spread'] !== '', function ($query) use ($where) {
 129:                 if ($where['is_spread']) {
 130:                     $query->where(function ($query) {
 131:                         $query->where('StoreOrder.spread_uid', '>', 0)->whereOr('StoreOrder.top_uid', '>', 0);
 132:                     });
 133:                 }
 134:             })
 135:             ->when(isset($where['is_user']) && $where['is_user'] !== '', function ($query) use ($where) {
 136:                 $query->where(function ($query) {
 137:                     $query->where('order_type', 0)->whereOr(function ($query) {
 138:                         $query->where('order_type', 1)->where('main_id', 0);
 139:                     });
 140:                 });
 141:             })
 142:             //待核销订单
 143:             ->when(isset($where['is_verify']) && $where['is_verify'], function ($query) use ($where) {
 144:                 $query->where('paid', 1);
 145:                 $query->where(function($query) use($where){
 146:                     $query->where(function ($query) {
 147:                         $query->where('StoreOrder.order_type', 1)->where('StoreOrder.status', 0);
 148:                     })->whereOr(function ($query) {
 149:                         $query->where('StoreOrder.order_type', 0)->where('StoreOrder.status', 20)->where('is_virtual', 4);
 150:                     })->whereOr(function ($query) {
 151:                         $query->where('StoreOrder.order_type', 1)->where('StoreOrder.status', 1)->where('enable_assigned', 1)->where('is_virtual', 4);
 152:                     })->whereOr(function ($query) {
 153:                         $query->where('StoreOrder.order_type', 2)->where('StoreOrder.status', 0);
 154:                     })->whereOr(function ($query) {
 155:                         $query->where('StoreOrder.order_type', 2)->where('StoreOrder.status', 1)->where('enable_assigned', 1);
 156:                     });
 157:                 });
 158:             })
