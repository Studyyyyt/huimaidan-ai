30:     /**
31:      * 检查指定字段的值是否已存在，可排除特定的值或ID。
32:      *
33:      * 此函数用于查询数据库中是否存在指定字段的值，同时允许排除特定的值或ID，
34:      * 以及限定只查询显示状态为是的记录。这在处理数据唯一性验证或存在性检查时非常有用。
35:      *
36:      * @param string $field 要检查的字段名。
37:      * @param mixed $value 要检查的字段值。
38:      * @param mixed $except 排除的值，如果不为空，则查询时不包括此值。
39:      * @param mixed $id 排除的ID，如果不为空，则查询时不包括此ID的记录。
40:      * @param bool $isUser 是否只查询显示状态为是的记录，true表示只查询显示状态为是的记录，false或null表示不作此限制。
41:      * @return bool 如果存在返回true，否则返回false。
42:      */
43:     public function merFieldExists($field, $value, $except = null, $id = null, $isUser = null)
44:     {
45:         return ($this->getModel())::getDB()->when($except, function ($query, $except) use ($field) {
46:                 $query->where($field, '<>', $except);
47:             })->when($id, function ($query) use ($id) {
48:                 $query->where($this->getPk(), '<>', $id);
49:             })->when($isUser, function ($query) {
50:                 $query->where('is_show', 1);
51:             })->where($field, $value)->count() > 0;
52:     }
53: 
54:     /**
55:      * 根据条件搜索数据。
56:      *
57:      * 本函数用于根据提供的条件数组搜索相应的数据。支持的条件包括关键字、代码、显示状态和ID。
58:      * 搜索条件是可选的，只有在数组中提供了相应的键值对时，才会应用相应的过滤条件。
59:      *
60:      * @param array $where 搜索条件数组，包含可能的键：keyword（关键字）、code（代码）、is_show（显示状态）、id（ID）。
61:      * @return \Illuminate\Database\Eloquent\Builder|static 返回一个构建器对象，已应用搜索条件和排序。
62:      */
63:     public function search(array $where)
64:     {
65:         // 从模型获取数据库实例，并根据提供的条件应用相应的查询约束。
66:         $query = ($this->getModel()::getDB())
67:             // 如果提供了关键字，则在名称或代码字段中进行模糊搜索。
68:             ->when(isset($where['keyword']) && $where['keyword'], function ($query) use ($where) {
69:                 $query->where('name|code', 'like', '%'.$where['keyword'].'%');
70:             })
71:             // 如果提供了代码，则精确匹配代码字段。
72:             ->where(isset($where['code']) && $where['code'], function ($query) use ($where) {
73:                 $query->where('code', $where['code']);
74:             })
75:             // 如果提供了显示状态，则精确匹配显示状态字段。
76:             ->where(isset($where['is_show']) && $where['is_show'], function ($query) use ($where) {
77:                 $query->where('is_show', $where['is_show']);
78:             })
79:             // 如果提供了ID，则精确匹配ID字段。
80:             ->where(isset($where['id']) && $where['id'], function ($query) use ($where) {
81:                 $query->where('id', $where['id']);
82:             });
83: 
84:         // 返回应用了排序（按排序降序）的查询构建器。
85:         return $query->order('sort DESC');
86:     }
87: 
88:     public function options($merId, $where, $field = 'id,name')
89:     {
90:         $query = $this->getModel()::getDB()->where($where)->field($field);
91: 
92:         if($merId) {
93:             $query->whereFindInSet('open_mer', $merId);
94:         }
95: 
96:         return $query->select()->toArray();
97:     }
98: 
99: }
