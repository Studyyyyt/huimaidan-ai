51:             $query->when(isset($where['type_id']) && $where['type_id'] !== '', function ($query) use($where) {
52:                 $query->where('type_id', $where['type_id']);
53:             });
54:             // 永久删除的订单不参与查询。
55:             $query->where('is_del', 0);
56:         });
57: 
58:         // 当订单类型条件存在时，添加对应查询条件。
59:         $query->when(isset($where['type']) && $where['type'] !== '', function ($query) use($where) {
60:             $query->where('ServeOrder.type', $where['type']);
61:         });
62: 
63:         // 当日期条件存在时，添加对应查询条件。
64:         $query->when(isset($where['date']) && $where['date'] !== '', function ($query) use($where) {
65:             getModelTime($query, $where['date'], 'ServeOrder.create_time');
66:         });
67: 
68:         // 当商家ID条件存在时，添加对应查询条件。
69:         $query->when(isset($where['mer_id']) && $where['mer_id'] !== '', function ($query) use($where) {
