544:     /**
545:      * 校验用户在指定时间范围内积分的锁定状态是否有效。
546:      * 该方法通过计算用户在指定时间内锁定的积分，以及相同时间内发生的积分返还和系统扣减情况，来确定用户的实际可用积分。
547:      *
548:      * @param integer $uid 用户ID。
549:      * @param string $start 查询的开始时间。
550:      * @param string $end 查询的结束时间。
551:      * @return integer 返回用户在指定时间内实际可用的积分值。
552:      */
553:     public function validIntegral($uid, $start, $end)
554:     {
555:         // 查询指定时间内被锁定的积分记录。
556:         $lst = UserBill::getDB()->where('category', 'integral')
557:             ->where('type', 'lock')->whereBetween('create_time', [$start, $end])->where('uid', $uid)->where('status', 1)->field('link_id,number')->select()->toArray();
558: 
559:         // 初始化积分计算变量。
560:         $integral = 0;
561:         // 如果有锁定的积分记录，则计算已返还的锁定积分。
562:         if (count($lst)) {
563:             $integral = -1 * UserBill::getDB()->whereIn('link_id', array_column($lst, 'link_id'))->where('uid', $uid)
564:                     ->where('category', 'integral')->where('type', 'refund_lock')->sum('number');
565:         }
566:         // 累加计算所有锁定的积分。
567:         foreach ($lst as $bill) {
568:             $integral = bcadd($integral, $bill['number'], 0);
569:         }
570: 
571:         // 计算指定时间内用户获得的积分（不包括锁定和系统扣减）。
572:         $integral2 = UserBill::getDB()->where('uid', $uid)->whereBetween('create_time', [$start, $end])
573:             ->where('category', 'integral')->where('pm', 1)->whereNotIn('type', ['lock', 'refund'])->sum('number');
574: 
575:         // 计算指定时间内用户因系统原因被扣减的积分。
576:         $integral3 = UserBill::getDB()->where('uid', $uid)->whereBetween('create_time', [$start, $end])
577:             ->where('category', 'integral')->where('type', 'sys_dec')->sum('number');
578: 
579:         // 返回用户在指定时间内实际可用的积分，确保积分值不为负。
580:         return (int)max(bcsub(bcadd($integral, $integral2, 0), $integral3, 0), 0);
581:     }
