183:     /**
184:      * 获取用户关联的商品到社区的信息
185:      *
186:      * 本函数用于构建查询用户关联的商品（SPU）到社区的条件。支持通过关键词过滤，并限定关联状态为有效。
187:      * 主要用于在用户社区功能中展示用户关联的商品。
188:      *
189:      * @param string|null $keyword 关键词，用于过滤商品名称。如果为null，则不进行关键词过滤。
190:      * @param int $uid 用户ID，指定查询哪个用户的关联商品信息。
191:      * @return \Illuminate\Database\Eloquent\Builder 返回构建好的查询构建器对象，用于进一步的查询操作或数据获取。
192:      */
193:     public function getUserProductToCommunity(?string  $keyword, int $uid)
194:     {
195:         // 根据$keyword条件构建商品（SPU）的查询条件，支持模糊搜索，并限定关联状态为1（有效）
196:         $query = UserRelation::hasWhere('spu', function ($query) use($keyword) {
197:             $query->when($keyword, function ($query) use($keyword) {
198:                 // 当关键词存在时，进行模糊搜索
199:                 $query->whereLike('store_name',"%{$keyword}%");
200:             });
201:             // 限定关联状态为有效
202:             $query->where('status',1);
203:         });
204:         // 指定查询用户ID为$uid的关联信息
205:         $query->where('uid',$uid);
206:         return $query;
207:     }
208: 
209: }
