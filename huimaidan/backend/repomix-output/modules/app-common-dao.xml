129:     /**
130:      * 展示动作的执行结果
131:      *
132:      * 本函数用于返回一个表示展示状态的数组，包含多个状态标识和当前时间。
133:      * 这些状态标识用于表示展示是否应该显示、动作是否成功、产品状态等。
134:      * 返回的数组包含以下键值对：
135:      * - is_show: 表示展示是否应该显示，值为1表示应该显示。
136:      * - action_status: 表示动作的状态，值为1表示动作执行成功。
137:      * - product_status: 表示产品的状态，值为1表示产品处于有效状态。
138:      * - status: 通用状态标识，值为1表示一切正常。
139:      * - end_time: 表示当前时间，以Unix时间戳形式表示，用于记录动作的结束时间。
140:      *
141:      * @return array 包含状态信息的数组。
142:      */
143:     public function actionShow()
144:     {
145:         // 返回包含状态信息的数组
146:         return [
147:             'is_show' => 1,
148:             'action_status' => 1,
149:             'product_status' => 1,
150:             'status' => 1,
151:             'end_time' => time(),
152:         ];
153:     }
154: 
155:     /**
156:      * 获取展示状态为正常且可购买的产品分类路径列表
157:      *
158:      * 本函数通过查询产品组（ProductGroup）关联的产品（StoreProduct）及其分类（StoreCategory）
159:      * 来获取展示状态、动作状态及产品状态都为正常的产品的分类路径。
160:      * 使用了别名简化查询语句，通过连接（join）产品组、产品和分类表，筛选出符合条件的产品，
161:      * 并按产品ID分组，最后返回每个产品的分类路径列表。
162:      *
163:      * @return array 返回符合条件的产品的分类路径列表
164:      */
165:     public function category()
166:     {
167:         // 使用别名简化表名，并连接产品组、产品和分类表
168:         $query = ProductGroup::alias('G')->join('StoreProduct P','G.product_id = P.product_id')
169:             ->join('StoreCategory C','P.cate_id = C.store_category_id');
170: 
171:         // 筛选展示状态、动作状态及产品状态都为正常的产品
172:         $query->where('G.is_show',1)->where('G.action_status',1)->where('G.product_status',1);
173: 
174:         // 按产品ID分组，以确保每个产品只返回一个分类路径
175:         $query->group('G.product_id');
176: 
177:         // 返回查询结果中产品的分类路径列表
178:         return $query->column('path');
179:     }
