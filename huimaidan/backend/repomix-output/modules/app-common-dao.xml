126:         // 并按照排序字段降序和配置ID升序返回查询结果
127:         return SystemConfig::getDB()->where('config_classify_id', $cid)->where('user_type', $user_type)->where('status', 1)
128:             ->order('sort DESC, config_id ASC')->select();
