 61: 
 62:     /**
 63:      * 获取超时未处理的经纪费账单
 64:      *
 65:      * 本函数用于查询指定时间之前，状态为未处理的经纪费账单。这些账单可以是订单一或订单二类型的经纪费。
 66:      * 主要用于统计或管理需要跟进的经纪费账单情况。
 67:      *
 68:      * @param int $time 查询的时间点，通常为时间戳形式，表示查询小于等于该时间的记录。
 69:      * @return Collection|array|\think\Collection|\think\db\BaseQuery[]
 70:      */
 71:     public function getTimeoutBrokerageBill($time)
 72:     {
 73:         // 通过UserBill的getDB方法获取数据库实例，并链式调用where方法设置查询条件
 74:         // 本行注释解释了为何使用where('create_time', '<=', $time)和where('category', 'brokerage')
 75:         // 这两个条件用于限定查询的时间范围和账单类型
 76:         return UserBill::getDB()->where('create_time', '<=', $time)->where('category', 'brokerage')
 77:             // 使用whereIn方法限定查询的账单类型为'order_one'或'order_two'
 78:             // 这一行注释解释了为何使用whereIn('type', ['order_one', 'order_two'])
 79:             ->whereIn('type', ['order_one', 'order_two'])->with('user')->where('status', 0)->select();
 80:     }
 81: 
 82:     /**
 83:      * 获取过期积分账单
 84:      *
 85:      * 本函数用于查询指定时间之前，类型为锁定积分的账单记录。
 86:      * 这些账单处于未处理状态（即状态为0），并关联了相应的用户信息。
 87:      * 主要用于处理过期积分的统计和管理。
 88:      *
 89:      * @param int $time 以时间戳形式表示的截止时间
 90:      * @return array|\think\Collection|\think\db\BaseQuery[]
 91:      */
 92:     public function getTimeoutIntegralBill($time)
 93:     {
 94:         // 通过UserBill的getDB方法获取数据库实例，并链式调用where方法设置查询条件
 95:         // 包括创建时间小于等于指定时间、分类为积分、类型为锁定、状态为0
 96:         // 最后使用with方法加载关联的用户信息，并通过select方法执行查询
 97:         return UserBill::getDB()->where('create_time', '<=', $time)->where('category', 'integral')
 98:             ->where('type', 'lock')->with('user')->where('status', 0)->select();
 99:     }
100: 
101:     /**
102:      * 获取超时未处理的商家结算账单
103:      *
104:      * 本函数用于查询指定时间之前，且状态为未处理的商家结算账单。
105:      * 这些账单可能是由于订单支付超时或其他原因尚未进行结算。
106:      * 通过筛选创建时间、类别、类型和状态，精确获取目标账单数据。
107:      *
108:      * @param int $time 查询的时间点，通常为时间戳形式。
109:      * @return array 返回符合条件的商家结算账单数据集合。
110:      */
111:     public function getTimeoutMerchantMoneyBill($time)
112:     {
113:         // 使用UserBill类的getDB方法获取数据库实例，并链式调用where方法设置查询条件。
114:         // 查询条件包括：创建时间不晚于指定时间、类别为mer_computed_money、类型为order、状态为0（未处理）。
115:         // 最后调用select方法执行查询并返回结果。
116:         return UserBill::getDB()
117:             ->where('create_time', '<=', $time)
118:             ->where('category', 'mer_computed_money')
119:             ->where('type', 'order')
120:             ->where('status', 0)->select();
121:     }
122: 
123: 
124:     /**
125:      * 计算商家退款金额
126:      *
127:      * 本函数用于查询指定订单ID和商家ID下的特定类型退款金额。
128:      * 它通过查询用户账单表，筛选出符合条件的退款记录，并计算它们的总数。
129:      * 这样可以方便地获取商家的退款总额，以便进行财务结算。
130:      *
131:      * @param string $order_id 订单ID，用于关联退款记录和订单。
132:      * @param string $type 退款类型，用于区分不同的退款情况。
133:      * @param string $mer_id 商家ID，用于限定查询商家的退款记录。
134:      * @return float 返回符合条件的退款金额总和。
135:      */
136:     public function refundMerchantMoney($order_id, $type, $mer_id)
137:     {
138:         // 使用where子句筛选出特定订单ID、商家ID、类别为'mer_refund_money'且类型为参数$type的记录，然后计算number列的总和。
139:         return UserBill::getDB()->where('link_id', $order_id)->where('mer_id', $mer_id)
140:             ->where('category', 'mer_refund_money')->where('type', $type)->sum('number');
141:     }
142: 
143: 
144:     /**
145:      * 计算商家锁定的资金总额。
146:      *
147:      * 本函数用于根据指定的商家ID，计算该商家目前被锁定的资金总额。
148:      * 锁定的资金包括：待处理的锁定资金、退款资金和订单计算资金。
149:      *
150:      * @param string|null $merId 商家ID，如果为null，则计算所有商家的锁定资金总额。
151:      * @return float 返回商家锁定的资金总额。
152:      */
153:     public function merchantLickMoney($merId = null)
154:     {
155:         // 查询待处理的商家锁定资金记录，根据商家ID进行过滤。
156:         $lst = UserBill::getDB()
157:             ->where('category', 'mer_lock_money')
158:             ->when($merId, function ($query, $val) {
159:             $query->where('mer_id', $val);
160:         })->where('status', 0)->select()->toArray();
161: 
162:         // 初始化锁定资金总额为0。
163:         $lockMoney = 0;
164:         // 如果有锁定资金记录，计算已退款金额并从中扣除。
165:         if (count($lst)) {
166:             $lockMoney = -1 * UserBill::getDB()->whereIn('link_id', array_column($lst, 'link_id'))
167:                     ->where('category', 'mer_refund_money')->sum('number');
168:         }
169: 
170:         // 累加所有的锁定资金到$lockMoney。
171:         foreach ($lst as $bill) {
172:             $lockMoney = bcadd($lockMoney, $bill['number'], 2);
173:         }
174: 
175:         // 加上订单计算产生的锁定资金。
176:         $lockMoney = bcadd($lockMoney, UserBill::getDB()
177:             ->where('category', 'mer_computed_money')->when($merId, function ($query, $val) {
178:                 $query->where('mer_id', $val);
179:             })->where('status', 0)->where('type', 'order')->sum('number'), 2);
180: 
181:         // 返回计算得到的商家锁定资金总额。
182:         return $lockMoney;
183:     }
184: 
185:     /**
186:      * 锁定经纪佣金
187:      * 该方法用于计算并返回指定用户ID的待处理（未结算）订单所产生的经纪佣金总和。
188:      * 这里的“锁定”指的是，通过计算这些未结算订单的佣金总额，为后续的佣金结算提供一个预估值。
189:      *
190:      * @param int $uid 用户ID，指定哪个用户的佣金需要被锁定计算。
191:      * @return float 返回计算得到的待处理佣金总和，以浮点数形式表示。
192:      */
193:     public function lockBrokerage($uid)
194:     {
195:         // 查询用户未结算的订单佣金记录，包括一级和二级订单产生的佣金。
196:         $lst = UserBill::getDB()->where('category', 'brokerage')
197:             ->whereIn('type', ['order_one', 'order_two'])->where('uid', $uid)->where('status', 0)->field('link_id,number')->select()->toArray();
198: 
199:         // 初始化退款金额为0，用于后续计算已退款的佣金。
200:         $refundPrice = 0;
201:         // 如果存在未结算的佣金记录，则计算已退款的佣金总额。
202:         if (count($lst)) {
203:             // 根据之前的佣金记录，查询相同订单链接ID下的退款佣金记录，并计算其总和。
204:             $refundPrice = -1 * UserBill::getDB()->whereIn('link_id', array_column($lst, 'link_id'))->where('uid', $uid)
205:                     ->where('category', 'brokerage')->whereIn('type', ['refund_two', 'refund_one'])->sum('number');
206:         }
207: 
208:         // 遍历未结算佣金列表，累加所有未结算的佣金金额。
209:         foreach ($lst as $bill) {
210:             $refundPrice = bcadd($refundPrice, $bill['number'], 2);
211:         }
212: 
213:         // 返回计算得到的待处理佣金总和。
214:         return $refundPrice;
215:     }
216: 
217:     /**
218:      * 锁定积分的逻辑处理。
219:      * 该方法用于计算指定用户由于订单或其他操作而被锁定的积分总量。
220:      * 如果提供了订单ID，则只考虑与该订单相关的锁定积分；
221:      * 如果提供了用户ID，则返回该用户所有被锁定的积分，无论订单ID是否提供。
222:      *
223:      * @param integer $uid 用户ID。可选参数，用于限定查询的用户。
224:      * @param integer $order_id 订单ID。可选参数，用于限定查询与特定订单相关的锁定积分。
225:      * @return integer 返回锁定的积分总量。如果没有任何积分被锁定，返回0。
226:      */
227:     public function lockIntegral($uid = null, $order_id = null)
228:     {
229:         // 查询已经被锁定的积分记录，这些记录可能是由于不同的订单或其他操作导致的。
230:         $lst = UserBill::getDB()->where('category', 'integral')
231:             ->where('type', 'lock')->when($order_id, function ($query, $order_id) {
232:                 // 如果提供了订单ID，则查询与该订单关联的锁定积分记录。
233:                 $query->where('link_id', $order_id);
234:             })->when($uid, function ($query, $uid) {
235:                 // 如果提供了用户ID，则查询该用户的所有锁定积分记录。
236:                 $query->where('uid', $uid);
237:             })->where('status', 0)->field('link_id,number')->select()->toArray();
238: 
239:         // 初始化锁定的积分总量为0。
240:         $lockIntegral = 0;
241:         // 如果存在锁定的积分记录，则计算这些记录中的积分总量。
242:         if (count($lst)) {
243:             // 计算所有被退款锁定（即可能由于订单退款导致的积分锁定）的积分总量。
244:             $lockIntegral = -1 * UserBill::getDB()->whereIn('link_id', array_column($lst, 'link_id'))->where('uid', $uid)
245:                     ->where('category', 'integral')->where('type', 'refund_lock')->sum('number');
246:         }
247: 
248:         // 遍历所有锁定积分记录，累加它们的数值到$lockIntegral中。
249:         foreach ($lst as $bill) {
250:             $lockIntegral = bcadd($lockIntegral, $bill['number'], 0);
251:         }
252: 
253:         // 返回锁定的积分总量。
254:         return $lockIntegral;
255:     }
