16: 
17: use BadMethodCallException;
18: use Closure;
19: 
20: trait Macro
21: {
22:     protected $macroList = [];
23: 
24:     /**
25:      * @param string $name
26:      * @param $macro
27:      * @author xaboy
28:      * @day 2020-04-10
29:      */
30:     public function macro(string $name, $macro)
31:     {
32:         $this->macroList[$name] = $macro;
33:     }
34: 
35:     /**
36:      * @param array $names
37:      * @param $macro
38:      * @author xaboy
39:      * @day 2020-04-10
40:      */
41:     public function macros(array $names, $macro)
42:     {
43:         foreach ($names as $name) {
44:             $this->macro($name, $macro);
45:         }
46:     }
47: 
48:     /**
49:      * @param string $name
50:      * @return bool
51:      * @author xaboy
52:      * @day 2020-04-10
53:      */
54:     public function hasMacro(string $name): bool
55:     {
56:         return isset($this->macroList[$name]);
57:     }
58: 
59:     public function __call($method, $parameters)
60:     {
61:         if (!$this->hasMacro($method)) {
62:             throw new BadMethodCallException("Method {$method} does not exist.");
63:         }
64: 
65:         $macro = $this->macroList[$method];
66: 
67:         if ($macro instanceof Closure) {
68:             return call_user_func_array($macro->bindTo($this, static::class), $parameters);
69:         }
70: 
71:         return call_user_func_array($macro, $parameters);
72:     }
73: }
