34:      * @return int|void|null
35:      * @throws \think\db\exception\DbException
36:      * @author wuhaotian
37:      * @email 442384644@qq.com
38:      * @date 2024/7/12
39:      */
40:     protected function execute(Input $input, Output $output)
41:     {
42:         $flag = $output->confirm($input, '清空数据前务必做好数据库的备份,防止数据被误删 !!!', false);
43:         if (!$flag) return;
44:         $tables = Db::query('SHOW TABLES FROM ' . env('database.database', ''));
45:         $pre = env('database.prefix', '');
46:         $bakTables = [
47:             $pre . 'page_link',
48:             $pre . 'page_category',
49:             $pre . 'diy',
50:             $pre . 'city_area',
51:             $pre . 'express',
52:             $pre . 'system_admin',
53:             $pre . 'system_city',
54:             $pre . 'system_config',
55:             $pre . 'system_config_classify',
56:             $pre . 'system_config_value',
57:             $pre . 'system_group',
58:             $pre . 'system_group_data',
59:             $pre . 'system_menu',
60:             $pre . 'system_role',
61:             $pre . 'template_message',
62:             $pre . 'system_notice_config',
63:             $pre . 'cache',
64:         ];
65: 
66:         foreach ($tables as $table) {
67:             $name = array_values($table)[0];
68:             if (!in_array($name, $bakTables)) {
69:                 Db::table($name)->delete(true);
70:             }
71:         }
72:         Db::table( $pre . 'cache')->whereNotIn('key','copyright_context,copyright_image,copyright_status')->delete(true);
73:         $output->info('删除成功');
74:     }
75: 
76: }
