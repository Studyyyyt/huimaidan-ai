 18: use think\console\Input;
 19: use think\console\Output;
 20: use think\console\input\Option;
 21: 
 22: class createTool extends Command
 23: {
 24:     public $config;
 25:     public $log = '创建记录:'.PHP_EOL;
 26:     protected function configure()
 27:     {
 28:         // 指令配置
 29:         $this->setName('createTool')
 30:             ->addArgument('table', Option::VALUE_REQUIRED, '表名称')
 31:             ->addOption('path', 'p',Option::VALUE_REQUIRED, '创建路径,不填则创建在最外层')
 32:             ->addOption('controller',  'c',Option::VALUE_OPTIONAL,"可选参数,需要创建的控制器:admin,mer,api,pc,ser")
 33:             ->addOption('key', 'k',Option::VALUE_REQUIRED, '主键名称')
 34:             ->setDescription('创建一个新的数据表全部模块:model,dao,repository,controller');
 35:     }
 36: 
 37:     protected function execute(Input $input, Output $output)
 38:     {
 39:         $options['table'] = $input->getArgument('table');
 40:         if (!preg_match('/^[a-z_]+$/', $options['table'])){
 41:             $output->error('表名称格式不正确:仅包含小写字母和下划线');
 42:             $output->error('例: php think createTool table_name -p system/merchant -c admin -k id');
 43:             return;
 44:         }
 45:         $options['path'] = $input->getOption('path');
 46:         $options['controller'] = null;
 47:         if ($controller = $input->getOption('controller')) {
 48:             $options['controller'] = explode(',',$controller);
 49:         }
 50:         $options['key'] = $input->getOption('key');
 51:         $output->writeln('开始执行');
 52:         $output->writeln('');
 53:         $this->create($options);
 54:         $output->writeln($this->log);
 55:         $output->writeln('执行完成');
 56:     }
 57: 
 58:     public function create($config)
 59:     {
 60:         $table = $config['table'];
 61:         $prefix = env('database.prefix', '');
 62:         $len = strlen($prefix);
 63:         $_prefix = substr($table,0,$len);
 64:         if ($prefix == $_prefix) {
 65:             $table = substr($table,$len);
 66:         }
 67:         $config['table'] = $table;
 68:         $class_name = str_replace(' ', '', ucwords(str_replace('_', ' ', $table)));
 69:         $config['class_name'] = $class_name;
 70:         $path = explode('/', $config['path']);
 71:         $config['namespace_path']  = implode('\\',$path);
 72:         $this->config = $config;
 73: 
 74:         ////生成model
 75:         $this->createModel();
 76: 
 77:         //生成dao
 78:         $this->createDao();
 79: 
 80:         //生成repository
 81:         $this->createRepository();
 82: 
 83:         if ($this->config['controller']) {
 84:             foreach ($this->config['controller'] as $c) {
 85:                 $this->createController($c);
 86:             }
 87:         }
 88:     }
 89: 
 90:     public function createModel()
 91:     {
 92:         $file_path = app_path().'common/model/'.$this->config['path'];
 93:         $file_name = $this->config['class_name'].'.php';
 94:         $id = $this->config['key'] ?: $this->config['table'].'_id';
 95:         $content = $this->getStart();
 96:         $content .= "namespace app\common\model\\{$this->config['namespace_path']};
 97:         
 98: use app\common\model\BaseModel;
 99: 
100: class {$this->config['class_name']} extends BaseModel
101: {
102:     public static function tablePk(): ?string
103:     {
104:         return '{$id}';
105:     }
106:     
107:     public static function tableName(): string
108:     {
109:         return '{$this->config['table']}';
110:     }
111: }
112: ";
113:         $this->createFile($file_path, $file_name,$content);
114:     }
115: 
116:     public function createDao()
117:     {
118:         $file_path = app_path().'common/dao/'.$this->config['path'];
119:         $file_name = $this->config['class_name'].'Dao.php';
120:         $content = $this->getStart();
121:         $content .= "namespace app\common\dao\\{$this->config['namespace_path']};
122: 
123: use app\common\dao\BaseDao;
124: use app\common\model\\{$this->config['namespace_path']}\\{$this->config['class_name']};
125: 
126: class {$this->config['class_name']}Dao extends BaseDao
127: {
128: 
129:     protected function getModel(): string
130:     {
131:         return {$this->config['class_name']}::class;
132:     }
133: }";
134:         $this->createFile($file_path, $file_name, $content);
135:     }
136: 
137:     public function createRepository()
138:     {
139:         $file_path = app_path().'common/repositories/'.$this->config['path'];
140:         $file_name = $this->config['class_name'].'Repository.php';
141: 
142:         $content = $this->getStart();
143:         $content .= "namespace app\common\\repositories\\{$this->config['namespace_path']};
144: 
145: use app\common\\repositories\BaseRepository;
146: use app\common\\dao\\{$this->config['namespace_path']}\\{$this->config['class_name']}Dao;
147: 
148: class {$this->config['class_name']}Repository extends BaseRepository
149: {
150:     public function __construct({$this->config['class_name']}Dao \$dao)
151:     {
152:         \$this->dao = \$dao;
153:     }
154:   
155:  }";
156:         $this->createFile($file_path, $file_name, $content);
157:     }
158: 
159:     public function createController($controller)
160:     {
161:         switch ($controller) {
162:             case "admin":
163:                 $contr = 'admin';
164:                 break;
165:             case "mer":
166:                 $contr = 'merchant';
167:                 break;
168:             case "api":
169:                 $contr = 'api';
170:                 break;
171:             case "pc":
172:                 $contr = 'pc';
173:                 break;
174:             case "ser":
175:                 $contr = 'service';
176:                 break;
177:             default:
178:                 throw new Exception('控制器类型错误');
179:         }
180:         $file_path = app_path().'controller/'.$contr.'/'.$this->config['path'];
181:         $file_name = $this->config['class_name'].'.php';
182: 
183:         $content = $this->getStart();
