 26: class updateAuth extends Command
 27: {
 28:     protected $k = [];
 29:     protected $kv =[];
 30: 
 31:     protected function configure()
 32:     {
 33:         // 指令配置
 34:         $this->setName('setAuth')
 35:             ->addArgument('prompt',Argument::OPTIONAL, 'php think menu [s] / [e]')
 36:             ->setDescription('使用方法： `php think menu` , 可选传参数 s 只显示成功信息');
