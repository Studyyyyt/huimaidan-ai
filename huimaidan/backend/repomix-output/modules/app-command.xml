 38: 
 39:     /**
 40:      * 更新路由
 41:      * @Author:Qinii
 42:      * @Date: 2020/5/15
 43:      * @param Input $input
 44:      * @param Output $output
 45:      * @return int|void|null
 46:      */
 47:     protected function execute(Input $input, Output $output)
 48:     {
 49:         $prompt = $input->getArgument('prompt');
 50: 
 51:         $output->writeln('开始执行');
 52:         $output->writeln('<----------------');
 53: 
 54:         $output->writeln('开始平台权限');
 55:         $sys = $this->routeList('sys',$prompt);
 56:         $output->writeln('开始店铺权限');
 57:         $mer = $this->routeList('mer',$prompt);
 58:         $output->writeln('开始区域权限');
 59:         $region = $this->routeList('region',$prompt);
 60:         $output->writeln('开始商户权限');
 61:         $business = $this->routeList('business', $prompt);
 62: 
 63:         $output->writeln('------------------------------------------------------------');
 64:         $output->writeln('平台执行成功，合计: '. $sys .'条 , 店铺执行成功，合计: '. $mer . '条, 区域执行成功，合计: '. $region . '条, 商户执行成功，合计: ' . $business . '条');
 65:         $output->writeln('------------------------------------------------------------');
 66:     }
 67: 
 68: 
 69:     /**
 70:      * 路由列表
 71:      * @Author:Qinii
 72:      * @Date: 2020/5/15
 73:      * @param string|null $dir
 74:      * @return mixed
 75:      */
 76:     public function routeList($type, $prompt)
 77:     {
 78:         $this->k = [];
 79:         $this->kv = [];
 80:         $this->app->route->setTestMode(true);
 81:         $this->app->route->clear();
 82:         $path = $this->app->getRootPath() . 'route' . DIRECTORY_SEPARATOR;
 83: 
 84:         if($type == 'mer') {
 85:             include $path . 'merchant.php';
 86:         } else {
 87:             include $path . 'admin.php';
 88:         }
 89:         //触发路由载入完成事件
 90:         $this->app->event->trigger(RouteLoaded::class);
 91:         $routeList = $this->app->route->getRuleList();
 92:         $resp = [];
 93: 
 94:         foreach ($routeList as $k => $item) {
 95:             if ($item['option'] && isset($item['option']['_auth']) && $item['option']['_auth']) {
 96:                 if (!(strpos($item['name'], '/') !== false) && !(strpos($item['name'], '@') !== false)) {
 97:                     if (isset($item['option']['_init'])) {
 98:                         $route = (new $item['option']['_init'][0]())->create($item, $item['option']['_init'][1]);
 99:                     } else {
100:                         $route = [$item];
101:                     }
102:                     if ($route) {
103:                         foreach ($route as $one) {
104:                             if (!isset($one['option']['_name'])) $one['option']['_name'] = $one['name'];
105:                             $this->menu($one['option']['_path'] ?? '', $one['option'], $resp);
106:                         }
107:                     }
108:                 }
109:             }
110:         }
111:         return app()->make(MenuRepository::class)->commandMenu($type, $resp, $prompt);
112:     }
113: 
114: 
115:     /**
116:      * 菜单权限
117:      * @param $_path
118:      * @param $data
119:      * @param array $resp
120:      * @return array
121:      * @author Qinii
122:      * @day 3/18/22
123:      */
124:     protected function menu($_path, $data, &$resp = [], $isAppend = 0)
125:     {
126:         $check = true;
127:         if($_path){
128:             if(!is_array($_path)){
129:                 $_path = [$_path];
130:             }
131:             if ($_path && is_array($data)) {
132:                 foreach($_path as $item) {
133:                     $v = [
134:                         'route'     => $data['_name'],
135:                         'menu_name' => $data['_alias'] ?? '权限',
136:                         'params'    => $data['_params'] ?? '',
137:                     ];
138:                     if (!isset($data['_repeat']) || (isset($data['_repeat']) && !$data['_repeat'])) {
139:                         $check = $this->checkRepeat($v['route'], $v['menu_name']);
140:                         $this->k[] = $v['route'];
141:                         $this->kv[$v['route']] = $v['menu_name'];
142:                     }
143: 
144:                     if (!$check) {
145:                         throw new Exception("路由名重复 < " . $v['route'] . ' >' . '「' . $v['menu_name'] . ' 」');
146:                     }
147:                     if ($isAppend) {
148:                         $item = 'append_' . $item;
149:                     }
150: 
151:                     $resp[$item][$data['_name']] = $v;
152: 
153:                     if (isset($data['_append']) && !empty($data['_append'])) {
154:                         foreach ($data['_append'] as $datum) {
155:                             $datum['_repeat'] = true;
156:                             $this->menu($datum['_path'] ?? $data['_path'], $datum, $resp, 1);
157:                         }
158:                     }
159:                 }
160:             }
161:         }
162: 
163:         return $resp;
164:     }
165: 
166:     protected function checkRepeat($key, $value)
167:     {
168:         if (in_array($key, $this->k)) {
169:             if ($value != $this->kv[$key]) {
170:                 return false;
171:             }
172:         }
173:         return true;
174:     }
175: }
