 20: use think\Exception;
 21: use think\facade\Db;
 22: 
 23: class VersionUpdate extends Command
 24: {
 25:     protected function configure()
 26:     {
 27:         $this->setName('version:update')
 28:             ->setDescription('crmeb_merchant 版本更新命令')
 29:             ->addOption('package', 'p', Option::VALUE_REQUIRED, '指定更新包的路径');
 30:     }
 31: 
 32:     /**
 33:      * 版本升级
 34:      * @param Input $input
 35:      * @param Output $output
 36:      * @return int|void|null
 37:      * @author wuhaotian
 38:      * @email 442384644@qq.com
 39:      * @date 2024/7/12
 40:      */
 41:     protected function execute(Input $input, Output $output)
 42:     {
 43:         $flag = $output->confirm($input, '更新之前请务必做好数据库和代码的备份,防止数据或代码在更新中被覆盖 !!!', false);
 44:         if (!$flag) return;
 45:         $flag = $output->confirm($input, '请确保swoole服务和队列服务已关闭,防止意外报错', false);
 46:         if (!$flag) return;
 47: 
 48:         $version = get_crmeb_version_code();
 49:         ini_set('memory_limit', '-1');
 50:         set_time_limit(0);
 51: 
 52:         $packagePath = $input->getOption('package') ?: 'auto_update.zip';
 53:         $updateFilePath = app()->getRootPath() . ltrim($packagePath, '/= ');
 54:         $updatePath = dirname($updateFilePath);
 55:         $unzipPath = $updatePath . '/_update_runtime_' . str_replace('.', '_', $version);
 56:         if (!is_file($updateFilePath)) {
 57:             $output->warning($updateFilePath . ' 更新包不存在');
 58:             return;
 59:         }
 60:         $zip = new \ZipArchive();
 61:         if ($zip->open($updateFilePath) === true) {
 62:             $zip->extractTo($unzipPath);
 63:             $zip->close();
 64:         } else {
 65:             $output->warning($updateFilePath . ' 更新包打开失败');
 66:             return;
 67:         }
 68:         $unlink = function () use ($unzipPath) {
 69:             @unlink($unzipPath . '/update.sql');
 70:             @unlink($unzipPath . '/update.zip');
 71:             @unlink($unzipPath . '/AutoUpdate.php');
 72:             @unlink($unzipPath . '/.env');
 73:             @unlink($unzipPath . '/.config');
 74:             @rmdir($unzipPath);
 75:         };
 76:         if (!is_file($unzipPath . '/.env') && !is_file($unzipPath . '/.config')) {
 77:             $output->warning('文件不完整');
 78:             $unlink();
 79:             return;
 80:         }
 81:         if (is_file($unzipPath . '/.env')) {
 82:             $env = parse_ini_file($unzipPath . '/.env', true) ?: [];
 83:         }
 84:         if (is_file($unzipPath . '/.config')) {
 85:             $env = parse_ini_file($unzipPath . '/.config', true) ?: [];
 86:         }
 87:         if (($env['NAME'] ?? '') !== 'CRMEB-MERCHANT') {
 88:             $output->warning('（1）版本号对比失败,请检查当前版本号(.version/更新包)是否被修改');
 89:             $unlink();
 90:         }
 91:         if (($env['TYPE'] ?? '') !== 'MODEL') {
 92:             if (!($env['OLD_VERSION'] ?? '')) {
