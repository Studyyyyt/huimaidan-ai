19: class UserBrokerageValidate extends Validate
20: {
21:     protected $failException = true;
22: 
23:     protected $rule = [
24:         'brokerage_level|会员等级' => 'require|integer|>:0',
25:         'brokerage_name|会员名称' => 'require|max:16',
26:         'brokerage_icon|会员图标' => 'require',
27:         'brokerage_rule|会员升级规则' => 'requireIf:type,0|array|checkBrokerageRule',
28:         'extension_one|一级佣金比例' => 'requireIf:type,0|float|>=:0|<=:100',
29:         'extension_two|二级佣金比例' => 'requireIf:type,0|float|>=:0|<=:100',
30:         'image|背景图' => 'requireIf:type,1|max:128',
31:         'value|会员成长值' => 'requireIf:type,1|float|>=:0',
32:         'type|类型' => 'require|in:0,1',
33:     ];
34: 
35:     public function checkBrokerageRule($value, $rlue, $data)
36:     {
37:         if (!$data['type']) {
38:             $types = UserBrokerageRepository::BROKERAGE_RULE_TYPE;
39:             if (count($types) != count($value)) {
40:                 return '请输入正确的升级任务';
41:             }
42:             $flag = 0;
43:             foreach ($types as $type) {
44:                 $val = $value[$type] ?? '';
45:                 if (!is_array($val) || !isset($val['name'], $val['num'], $val['info']) || count($val) != 3) return '请输入正确的升级任务';
46:                 if ($val['num'] < 0)
47:                     return '请输入正确的任务数量';
48:                 if ($val['num'] > 0 && !$val['name']) return '请输入任务名称';
49:                 if ($val['num'] > 0) $flag++;
50:             }
51:             if (!$flag) return '请至少设置一个升级任务';
52:         }
53: 
54:         return true;
55:     }
56: }
</file>

