25:         'phone|手机号' => 'isPhone',
26:         'birthday|生日' => 'dateFormat:Y-m-d',
27:         'card_id|身份证' => 'length:18',
28:         'addres|用户地址' => 'max:64',
29:         'mark|备注' => 'max:200',
30:         'group_id|分组' => 'integer',
31:         'label_id|标签' => 'array',
