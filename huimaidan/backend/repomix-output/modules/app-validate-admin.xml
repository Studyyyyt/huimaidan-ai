33:         'status|推广人' => 'in:0,1'
34:     ];
35: 
36:     protected function isPhone($val)
37:     {
38:         if (!preg_match('/^1[3456789]{1}\d{9}$/', $val))
39:             return '请输入正确的手机号';
40:         else
41:             return true;
42:     }
43: 
44:     protected function sceneCreate()
45:     {
46:         return $this->append('account', 'require|unique:user,account|max:16|min:5')
47:             ->append('pwd', 'require')
48:             ->append('repwd', 'confirm:pwd')
49:             ->append('sex', 'in:0,1,2');
50:     }
51: 
52:     protected $message = [
53:         'account.require' => '账号必填',
54:         'account.unique' => '账号已经存在',
