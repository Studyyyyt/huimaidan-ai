14: namespace app\common\middleware;
15: 
16: use app\common\repositories\system\auth\MenuRepository;
17: use app\common\repositories\system\auth\RoleRepository;
18: use app\Request;
19: use Doctrine\Common\Cache\RedisCache;
20: use http\Exception\InvalidArgumentException;
21: use think\facade\Cache;
22: use think\Response;
23: 
24: class BlockerMiddleware extends BaseMiddleware
25: {
26:     protected  $key;
27: 
28:     public function before(Request $request)
29:     {
30:         $uid = request()->uid();
31:         $this->key = md5(request()->rule()->getRule() . $uid);
32:         if (!$this->setMutex($this->key)) {
33:             throw new InvalidArgumentException('请求太过频繁，请稍后再试');
34:         }
35:     }
36: 
37:     public function setMutex(string $key, int $timeout = 10)
38:     {
39:         $curTime = time();
40:         $readMutexKey = "redis:mutex:{$key}";
41:         $mutexRes = Cache::store('redis')->handler()->setnx($readMutexKey, $curTime + $timeout);
42:         if ($mutexRes) {
43:             return true;
44:         }
45:         //就算意外退出，下次进来也会检查key，防止死锁
46:         $time = Cache::store('redis')->handler()->get($readMutexKey);
47:         if ($curTime > $time) {
48:             Cache::store('redis')->handler()->del($readMutexKey);
49:             return Cache::store('redis')->handler()->setnx($readMutexKey, $curTime + $timeout);
50:         }
51:         return false;
52:     }
53: 
54:     public function after(Response $response)
55:     {
56:         Cache::store('redis')->handler()->del("redis:mutex:{$this->key}");
57:         // TODO: Implement after() method.
58:     }
59: }
