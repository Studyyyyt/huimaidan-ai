13: namespace app\common\middleware;
14: 
15: use app\common\repositories\openapi\OpenAuthRepository;
16: use app\common\repositories\system\merchant\MerchantRepository;
17: use app\Request;
18: use crmeb\exceptions\AuthException;
19: use crmeb\services\JwtTokenService;
20: use Firebase\JWT\ExpiredException;
21: use think\exception\ValidateException;
22: use think\Response;
23: use Throwable;
24: 
25: class OpenApiAuthMiddleware extends BaseMiddleware
26: {
27: 
28:     public function before(Request $request)
29:     {
30:         $unique     = $request->param('unique');
31:         $expiration = $request->param('expiration');
32:         $access_key = $request->param('access_key');
33:         $signature  = $request->param('signature');
34:         if (!$unique || !$expiration || !$access_key || !$signature) throw new AuthException('验证失败,请完善参数');
35:         if ((time() - $expiration) > 300) throw new AuthException('验证已过期');
36: 
37:         $openAuthRepository = app()->make(OpenAuthRepository::class);
38:         $auth = $openAuthRepository->getSearch(['access_key' => $access_key])->find();
39:         $secret_key = $auth->secret_key;
40: 
41:         $credential = ['mer','openapi'];
42:         $policy = [
43:             'access_key' => $access_key,
44:             'conditions' => $access_key.'/'.implode('/', $credential),
45:             'expiration' =>  date('YmdHis',$expiration),
46:             'unique' => $unique
47:         ];
48:         ksort($policy);
49:         $policy = json_encode($policy);
50:         $jsonPolicy64 = base64_encode($policy);
51:         $_signature = bin2hex(hash_hmac('sha256', $jsonPolicy64, $secret_key, true));
52: 
53:         if ($signature !== $_signature)  throw new AuthException('验证失败');
54:         if ($auth->status != 1 || $auth->is_del) throw new AuthException('账号已被禁用');
55:         $request->macro('openAuthInfo', function () use($auth) {
56:             unset($auth['secret_key']);
57:             return $auth;
58:         });
59:         $request->macro('isAuth', function () {
60:             return true;
61:         });
62:         $request->macro('openMerId', function () use($auth) {
63:             return $auth->mer_id;
64:         });
65:         $request->macro('openRoule', function () use($auth) {
66:             return $auth->auth;
67:         });
68:         $auth->last_time = date('Y-m-d H:i:s', time());
69:         $auth->last_ip = request()->ip();
70:         $auth->save();
71:     }
72: 
73:     public function after(Response $response)
74:     {
75:         // TODO: Implement after() method.
76:     }
77: }
