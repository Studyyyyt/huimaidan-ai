 12: namespace app\common\middleware;
 13: 
 14: use Throwable;
 15: use app\Request;
 16: use think\Response;
 17: use Firebase\JWT\ExpiredException;
 18: use crmeb\exceptions\AuthException;
 19: use crmeb\services\JwtTokenService;
 20: use think\exception\ValidateException;
 21: use app\common\repositories\system\admin\AdminRepository;
 22: use app\common\repositories\system\merchant\MerchantRepository;
 23: 
 24: class AdminTokenMiddleware extends BaseMiddleware
 25: {
 26: 
 27:     /**
 28:      * @param Request $request
 29:      * @throws Throwable
 30:      * @author xaboy
 31:      * @day 2020-04-10
 32:      */
 33:     public function before(Request $request)
 34:     {
 35:         $force = $this->getArg(0, true);
 36:         try {
 37:             $token = trim($request->header('X-Token'));
 38:             if(!$token) $token = trim($request->param('token/s',''));
 39:             if (strpos($token, 'Bearer') === 0)
 40:                 $token = trim(substr($token, 6));
 41:             if (!$token)
 42:                 throw new ValidateException('请登录');
 43: 
 44:             /**
 45:              * @var AdminRepository $repository
 46:              */
 47:             $repository = app()->make(AdminRepository::class);
 48:             $service = new JwtTokenService();
 49:             try {
 50:                 $payload = $service->parseToken($token);
 51:             } catch (ExpiredException $e) {
 52:                 $repository->checkToken($token);
 53:                 $payload = $service->decode($token);
 54:             } catch (Throwable $e) {//Token 过期
 55:                 throw new AuthException('token 已过期，请重新登录');
 56:             }
 57:             if ('admin' != $payload->jti[1])
 58:                 throw new AuthException('无效的 token');
 59: 
 60:             $admin = $repository->get($payload->jti[0]);
 61:             if (!$admin)
 62:                 throw new AuthException('账号不存在');
 63:             if (!$admin['status'])
 64:                 throw new AuthException('账号已被禁用');
 65: 
 66:         } catch (Throwable $e) {
 67:             if ($force)
 68:                 throw  $e;
 69:             $request->macro('isLogin', function () {
 70:                 return false;
 71:             });
 72:             $request->macros(['tokenInfo', 'adminId', 'adminInfo', 'token'], function () {
 73:                 throw new AuthException('请登录');
 74:             });
 75:             return;
 76:         }
 77:         $repository->updateToken($token);
 78:         $regionMerId = [];
 79:         if ($admin->region_ids) {
 80:             if($admin->is_agent == 1) {
 81:                 $where['region_id'] = $admin->region_ids;
 82:             }
 83:             if($admin->is_agent == 2) {
 84:                 $where['business_id'] = $admin->region_ids;
 85:             }
 86:             $regionMerId = app()->make(MerchantRepository::class)->search($where)->column('mer_id');
 87:         }
 88:         $request->macro('isLogin', function () {
 89:             return true;
 90:         });
 91:         $request->macro('tokenInfo', function () use (&$payload) {
 92:             return $payload;
 93:         });
 94:         $request->macro('token', function () use (&$token) {
 95:             return $token;
 96:         });
 97:         $request->macro('adminId', function () use (&$admin) {
 98:             return $admin->admin_id;
 99:         });
100:         $request->macro('adminInfo', function () use (&$admin) {
101:             return $admin;
102:         });
103:         $request->macro('userType', function () {
104:             return 2;
105:         });
106:         $request->macro('isAgent', function () use (&$admin) {
107:             return $admin->is_agent;
108:         });
109: 
110:         $request->macro('regionIds', function () use($admin){
111:            return is_array($admin->region_ids) ? $admin->region_ids : [];
112:         });
113: 
114:         $request->macro('regionAuthority', function () use($admin, $regionMerId){
115:             if ($admin->region_ids) {
116:                 return empty($regionMerId) ? [0] : $regionMerId;
117:             }
118:             return [];
119:         });
120:     }
121: 
122:     public function after(Response $response)
123:     {
124:         // TODO: Implement after() method.
125:     }
126: }
