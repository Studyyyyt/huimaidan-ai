18: use crmeb\services\LockService;
19: use think\Response;
20: 
21: class RequestLockMiddleware implements MiddlewareInterface
22: {
23:     final public function handle(Request $request, \Closure $next, ...$args): Response
24:     {
25:         $params = $request->route();
26:         if (!count($params) || in_array(strtolower($request->method()), ['get', 'options']) || $request->rule()->getOption('_lock', true) === false) {
27:             return $next($request);
28:         }
29:         ksort($params);
30:         $key = 're:' . $request->rule()->getName() . ':' . implode('-', $params);
31:         return app()->make(LockService::class)->exec($key, function () use ($next, $request) {
32:             return $next($request);
33:         }, 8);
34:     }
35: }
