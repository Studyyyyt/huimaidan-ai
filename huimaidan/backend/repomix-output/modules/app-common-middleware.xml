 16: use app\common\repositories\system\auth\MenuRepository;
 17: use app\common\repositories\system\auth\RoleRepository;
 18: use app\Request;
 19: use think\exception\ValidateException;
 20: use think\Response;
 21: 
 22: class AdminAuthMiddleware extends BaseMiddleware
 23: {
 24: 
 25:     public function before(Request $request)
 26:     {
 27:         $admin = $request->adminInfo();
 28: 
 29:         /** @var RoleRepository $role */
 30:         $role = app()->make(RoleRepository::class);
 31: 
 32:         /** @var MenuRepository $menu */
 33:         $menu = app()->make(MenuRepository::class);
 34: 
 35:         $rules = [];
 36:         $menus = [];
 37:         if ($admin->level) {
 38:             if ($admin->is_agent) {
 39:                 $admin->append(['region_name']);
 40:                 $regions = $admin->region_name;
 41:                 foreach ($regions as $region) {
 42:                     $rules[$region['circle_id']] = $role->idsByRules(0, [$region['role_id']]);
 43:                 }
 44:                 foreach($rules as $key => $role) {
 45:                     $menus[$key] = $menu->idsByRoutes($role);
 46:                 }
 47:             } else {
 48:                 $rules = $role->idsByRules(0, $admin->roles);
 49:                 $menus = $menu->idsByRoutes($rules);
 50:             }
 51:         }
 52: 
 53:         $request->macro('adminAuth', function () use (&$menus) {
 54:             return $menus;
 55:         });
 56: 
 57:         $request->macro('adminRule', function () use (&$rules) {
 58:             return $rules;
 59:         });
 60: 
 61:         $request->macro('checkAuth', function ($name, $vars) use (&$admin, &$menus, &$menu, $request) {
 62:             if (!$name || !$admin->level || $admin->is_agent) return true;
 63:             $isset = false;
 64:             foreach ($menus as $_menu) {
 65:                 $keys = $menu->tidyParams($_menu['params']);
 66:                 if ($_menu['route'] != $name) continue;
 67:                 $isset = true;
 68:                 if (!count($keys)) return true;
 69:                 if ($menu->checkParams($keys, $vars))
 70:                     return true;
 71:             }
 72:             if ($isset || $menu->routeExists($name))
 73:                 return false;
 74:             return true;
 75:         });
 76: 
 77:         $rule = $request->rule();
 78:         if (!$rule) {
 79:             return true;
 80:         }
 81:         $options = $rule->getOption();
 82:         if (!($options['_auth'] ?? true) && !isset($options['_form'])) {
 83:             return true;
 84:         }
 85:         if (isset($options['_form'])) {
 86:             $name = $options['_form'];
 87:             $var = $options['_form_val'] ?? [];
 88:         } else {
 89:             $name = $rule->getName();
 90:             $var = $rule->getVars();
 91:         }
 92:         if (!$request->checkAuth($name, $var))
 93:             throw new ValidateException('没有权限访问');
 94:     }
 95: 
