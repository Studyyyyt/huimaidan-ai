16: 
17: use app\Request;
18: use crmeb\interfaces\MiddlewareInterface;
19: use think\Response;
20: 
21: abstract class BaseMiddleware implements MiddlewareInterface
22: {
23: 
24:     /**
25:      * @var Request
26:      */
27:     protected $request;
28: 
29:     protected $args = [];
30: 
31:     abstract public function before(Request $request);
32: 
33:     /**
34:      * @param int $num
35:      * @param mixed $default
36:      * @return mixed
37:      * @author xaboy
38:      * @day 2020-04-10
39:      */
40:     public function getArg($num, $default = null)
41:     {
42:         return isset($this->args[$num]) ? $this->args[$num] : $default;
43:     }
44: 
45:     final public function handle(Request $request, \Closure $next, ...$args): Response
46:     {
47:         $this->args = $args;
48:         $this->request = $request;
49:         $this->before($request);
50:         $response = $next($request);
51:         $this->after($response);
52:         return $response;
53:     }
54: 
55:     abstract public function after(Response $response);
56: }
