294:     /**
295:      * 计算距离
296:      *
297:      * @param array $params
298:      * @param string $merLat
299:      * @param string $merLong
300:      * @return void
301:      */
302:     public function distance(array $params, string $merLat, string $merLong)
303:     {
304:         if (!$merLat || !$merLong) {
305:             return false;
306:         }
307:         $distance = getDistance($params['latitude'], $params['longitude'], $merLat, $merLong);
308:         $distanceM = $distance;
309:         if ($distance < 0.9) {
310:             $distance = max(bcmul($distance, 1000, 0), 1).'m';
311:             if ($distance == '1m') {$distance = '100m以内';}
312:         } else {
313:             $distance.= 'km';
314:         }
315: 
316:         return [$distance,$distanceM];
317:     }
