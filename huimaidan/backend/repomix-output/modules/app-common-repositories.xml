 23: 
 24: class OpenAuthRepository extends BaseRepository
 25: {
 26:     const AUTH_TYPE_PRODUCT = '1';
 27:     const AUTH_TYPE_ORDER = '2';
 28: 
 29:     public function __construct(OpenAuthDao $dao)
 30:     {
 31:         $this->dao = $dao;
 32:     }
 33: 
 34:     /**
 35:      * 创建
 36:      * @param int $merId
 37:      * @param array $data
 38:      * @return \app\common\dao\BaseDao|\think\Model
 39:      * @author Qinii
 40:      * @day 2023/7/21
 41:      */
 42:     public function create(int $merId, array $data)
 43:     {
 44:         $data['access_key'] = $this->createAccessKey($merId);
 45:         $data['secret_key'] = $this->createSecretKey($merId);
 46:         $data['mer_id'] = $merId;
 47:         return $this->dao->create($data);
 48:     }
 49: 
 50:     /**
 51:      * 列表
 52:      * @param $where
 53:      * @param $page
 54:      * @param $limit
 55:      * @return array
 56:      * @author Qinii
 57:      * @day 2023/7/21
 58:      */
 59:     public function getList($where,$page, $limit)
 60:     {
 61:         $where['is_del'] = 0;
 62:         $query = $this->dao->getSearch($where)->hidden(['secret_key','delete_time'])->order('id ASC');
 63:         $count = $query->count();
 64:         $list = $query->page($page, $limit)->select();
 65:         return compact('count','list');
