 39:     public function insertAll($orderInfo)
 40:     {
 41:         if ($orderInfo->pay_price == 0) {
 42:             return false;
 43:         }
 44:         // 商户信息
 45:         $merchant = $orderInfo->merchant;
 46:         if(!$merchant) {
 47:             return false;
 48:         }
 49:         // 计算平台抽成
 50:         $commissionRate = (float)($merchant->commission_switch ? bcdiv($merchant->commission_rate, 100, 2) : $merchant->merchantCategory->commission_rate);
 51:         if (!$commissionRate) {
 52:             return false;
 53:         }
 54:         $commissionPrice = bcmul($orderInfo->pay_price, $commissionRate, 2);
 55:         // 商圈信息
 56:         $circle = $merchant->merchantRegion;
 57:         if (!$circle) {
 58:             return false;
 59:         }
 60: 
 61:         $data = [];
 62:         $circleName = '';
 63:         if ($circle->level == 1) { // 两层
 64:             // 一级商圈
 65:             $firstCircle = $circle->parent;
 66:             $firstCircleAgent = $firstCircle->circleAgent;
 67:             if ($firstCircleAgent && $firstCircle && $firstCircle->status) {
 68:                 $amount = bcmul($commissionPrice, bcdiv(bcsub($firstCircle->commission_rate, $circle->commission_rate), 100, 2), 2);
 69:                 if($firstCircle->type == 0) {
 70:                     $data[] = [
 71:                         'circle_id' => $firstCircle->circle_id,
 72:                         'circle_name' => $firstCircle->name,
 73:                         'mer_id' => $merchant->mer_id,
 74:                         'mer_name' => $merchant->mer_name,
 75:                         'agent_id' => $firstCircleAgent->circle_agent_id,
 76:                         'agent_name' => $firstCircleAgent->name,
 77:                         'record_sn' => $this->getSn(),
 78:                         'order_id' => $orderInfo->order_id,
 79:                         'order_sn' => $orderInfo->order_sn,
 80:                         'user_id' => $orderInfo->uid,
 81:                         'user_info' => $orderInfo->user->nickname ?? '游客',
 82:                         'amount' => $amount
 83:                     ];
 84:                 }
 85:             }
 86:             $circleName = $firstCircle->name . '/';
 87:         }
 88:         if ($circle->level == 2) { // 三层
 89:             // 一级商圈
 90:             $firstCircle = $circle->parent->parent;
 91:             $firstCircleAgent = $firstCircle->circleAgent;
 92:             if ($firstCircleAgent && $firstCircle && $firstCircle->status) {
 93:                 $amount = bcmul($commissionPrice, bcdiv(bcsub($firstCircle->commission_rate, $circle->parent->commission_rate), 100, 2), 2);
 94:                 if($firstCircle->type == 0) {
 95:                     $data[] = [
 96:                         'circle_id' => $firstCircle->circle_id,
 97:                         'circle_name' => $firstCircle->name,
 98:                         'mer_id' => $merchant->mer_id,
 99:                         'mer_name' => $merchant->mer_name,
100:                         'agent_id' => $firstCircleAgent->circle_agent_id,
101:                         'agent_name' => $firstCircleAgent->name,
102:                         'record_sn' => $this->getSn(),
103:                         'order_id' => $orderInfo->order_id,
104:                         'order_sn' => $orderInfo->order_sn,
105:                         'user_id' => $orderInfo->uid,
106:                         'user_info' => $orderInfo->user->nickname ?? '游客',
107:                         'amount' => $amount
108:                     ];
109:                 }
110:             }
111:             // 二级商圈
112:             $secondCircle = $circle->parent;
113:             $secondCircleAgent = $secondCircle->circleAgent;
114:             if ($secondCircleAgent && $secondCircle && $secondCircle->status) {
115:                 $amount = bcmul($commissionPrice, bcdiv(bcsub($secondCircle->commission_rate, $circle->commission_rate), 100, 2), 2);
116:                 if($secondCircle->type == 0) {
117:                     $data[] = [
118:                         'circle_id' => $secondCircle->circle_id,
119:                         'circle_name' => $firstCircle->name . '/' . $secondCircle->name,
120:                         'mer_id' => $merchant->mer_id,
121:                         'mer_name' => $merchant->mer_name,
122:                         'agent_id' => $secondCircleAgent->circle_agent_id,
123:                         'agent_name' => $secondCircleAgent->name,
124:                         'record_sn' => $this->getSn(),
125:                         'order_id' => $orderInfo->order_id,
126:                         'order_sn' => $orderInfo->order_sn,
127:                         'user_id' => $orderInfo->uid,
128:                         'user_info' => $orderInfo->user->nickname ?? '游客',
129:                         'amount' => $amount
130:                     ];
131:                 }
132:             }
133:             $circleName = $firstCircle->name . '/' . $secondCircle->name . '/';
134:         }
135:         // 当前层级商圈
136:         $circleAgent = $circle->circleAgent;
137:         if ($circleAgent && $circle && $circle->status) {
138:             $amount = bcmul($commissionPrice, bcdiv($circle->commission_rate, 100, 2), 2);
139:             if($circle->type == 0) {
140:                 $data[] = [
141:                     'circle_id' => $circle->circle_id,
142:                     'circle_name' => $circleName . $circle->name,
143:                     'mer_id' => $merchant->mer_id,
144:                     'mer_name' => $merchant->mer_name,
