178:      * 本函数用于验证商家的打印机配置是否完整且正确。它首先检查打印功能是否已开启，然后获取并验证相关配置参数，
179:      * 包括客户端ID、API密钥、合作伙伴ID和终端号码。如果任何一项配置缺失或无效，将抛出一个验证异常。
180:      *
181:      * @param int $merId 商家ID，用于获取商家的打印配置
182:      * @return array 返回包含打印机配置的数组，包括客户端ID、API密钥、合作伙伴ID和终端号码
183:      * @throws ValidateException 如果打印功能未开启或打印机配置不完整或无效，抛出此异常
184:      */
185:     public function checkPrinterConfig(int $merId)
186:     {
187:         // 检查打印功能是否已开启
188:         if (!merchantConfig($merId, 'printing_status'))
189:             throw new ValidateException('打印功能未开启');
190: 
191:         // 组装打印机配置数组
192:         $config = [
193:             'clientId' => merchantConfig($merId, 'printing_client_id'),
194:             'apiKey' => merchantConfig($merId, 'printing_api_key'),
195:             'partner' => merchantConfig($merId, 'develop_id'),
196:             'terminal' => merchantConfig($merId, 'terminal_number')
197:         ];
198: 
199:         // 验证打印机配置是否完整
200:         if (!$config['clientId'] || !$config['apiKey'] || !$config['partner'] || !$config['terminal'])
201:             throw new ValidateException('打印机配置错误');
202: 
203:         // 返回验证通过的打印机配置
204:         return $config;
205:     }
