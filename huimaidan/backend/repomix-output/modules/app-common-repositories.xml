162:     /**
163:      * 创建商品
164:      *
165:      * 本函数用于处理商品的创建流程，包括数据准备和事务处理。
166:      * 根据传入的商家ID和商品数据，首先设定商品的状态，然后在数据库事务中执行商品的创建操作。
167:      * 根据商品的状态，可能需要进一步调用微信接口创建商品，并更新数据库中的商品信息。
168:      * 如果商品状态为非上架状态，则通过任务服务发送新商品审核通知。
169:      *
170:      * @param string $merId 商家ID
171:      * @param array $data 商品数据，包含各种与商品相关的信息
172:      * @return object 创建后的商品对象，包含商品的各种信息
173:      */
174:     public function create($merId, array $data)
175:     {
176:         // 根据商家商品属性决定商品状态，0为待上架，1为已上架
177:         $data['status'] = request()->merchant()->is_bro_goods == 1 ? 0 : 1;
178:         $data['mer_id'] = $merId;
179: 
180:         // 使用数据库事务处理来确保数据的一致性
181:         return Db::transaction(function () use ($data) {
182:             // 创建商品
183:             $goods = $this->dao->create($data);
184: 
185:             // 如果商品状态为已上架，则调用微信接口创建商品
186:             if ($data['status'] == 1) {
187:                 $res = $this->wxCreate($goods);
188:                 // 更新商品ID和审核ID，来自于微信接口的返回
189:                 $goods->goods_id = $res->goodsId;
190:                 $goods->audit_id = $res->auditId;
191:                 $goods->save();
192:             } else {
193:                 // 如果商品状态为待上架，则发送新商品审核通知
194:                 SwooleTaskService::admin('notice', [
195:                     'type' => 'new_goods',
196:                     'data' => [
197:                         'title' => '新直播商品申请',
198:                         'message' => '您有1个新的直播商品审核，请及时处理！',
199:                         'id' => $goods->broadcast_goods_id
200:                     ]
201:                 ]);
202:             }
203: 
204:             // 返回创建后的商品对象
205:             return $goods;
206:         });
207:     }
