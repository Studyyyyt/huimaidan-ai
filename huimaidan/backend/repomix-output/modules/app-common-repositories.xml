 67: 
 68:     /**
 69:      * 添加编辑表单
 70:      * @param int $merId
 71:      * @param $id
 72:      * @return \FormBuilder\Form
 73:      * @author Qinii
 74:      * @day 2023/7/21
 75:      */
 76:     public function form(int $merId, $id = 0)
 77:     {
 78:         $formData = [];
 79:         if ($id) {
 80:             $formData = $this->dao->getWhere(['id' => $id])->toArray();
 81:             if (!$formData) throw new ValidateException('数据不存在');
 82:             $form = Elm::createForm(Route::buildUrl('merchantOpenapiUpdate', ['id' => $id])->build());
 83:         } else {
 84:             $form = Elm::createForm(Route::buildUrl('merchantOpenapiCreate')->build());
 85:         }
 86:         $form->setRule([
 87:             Elm::input('title', '标题：')->placeholder('请输入标题'),
 88:             Elm::selectMultiple('auth', '权限：')->options([
 89:                 ['value' => self::AUTH_TYPE_PRODUCT,'label' => '商品'],
 90:                 ['value' => self::AUTH_TYPE_ORDER,'label' => '订单'],
 91:             ]),
 92:             Elm::input('mark', '备注')->placeholder('请输入备注'),
 93:             Elm::switches('status', '是否开启：', 1)->activeValue(1)->inactiveValue(0)->inactiveText('关闭')->className('switch-width-double')->activeText('开启'),
 94:             Elm::number('sort', '排序：', 0)->precision(0)->max(99999),
 95:         ]);
 96:         return $form->setTitle($id ? '编辑授权账户' : '添加授权账户')->formData($formData);
 97:     }
 98: 
 99:     /**
100:      * 生成 AccessKey
101:      * @param int $merId
102:      * @return string
103:      * @author Qinii
104:      * @day 2023/7/21
105:      */
106:     public function createAccessKey(int $merId)
107:     {
108:         list($msec, $sec) = explode(' ', microtime());
109:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
110:         $sn = $msectime . random_int(10000, max(intval($msec * 10000) + 10000, 98369));
111:         return 'M'.$merId.'os'.$sn;
112:     }
113: 
114:     /**
115:      * 生成 secret_key
116:      * @param int $merId
117:      * @return string
118:      * @author Qinii
119:      * @day 2023/7/21
120:      */
121:     public function createSecretKey(int $merId)
122:     {
123:         list($msec, $sec) = explode(' ', microtime());
124:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
125:         return $merId.'cb'.MD5($msectime . random_int(10000, max(intval($msec * 10000) + 10000, 98369)));
126:     }
127: 
128:     /**
129:      * 获取secret_key
130:      * @param $id
131:      * @return array
132:      * @author Qinii
133:      * @day 2023/7/21
134:      */
135:     public function getSecretKey($id)
136:     {
137:         $data = $this->dao->get($id);
138:         return ['secret_key' => $data['secret_key']];
139:     }
140: 
141:     /**
142:      * 重置secret_key
143:      * @param $id
144:      * @return int
145:      * @author Qinii
146:      * @day 2023/7/21
147:      */
148:     public function setSecretKey($id,$merId)
149:     {
150:         $data['secret_key'] = $this->createSecretKey($merId);
151:         $data['update_time'] = date('Y-m-d H:i:s',time());
152:         $this->dao->update($id,$data);
153:         return  ['secret_key' => $data['secret_key']];
154:     }
155: 
156:     /**
157:      * 检查令牌的有效性
158:      *
159:      * 本函数用于验证传入的令牌是否有效，有效意味着该令牌曾在指定时间内被使用过。
160:      * 它首先检查令牌是否存在于缓存中，如果不存在，则抛出一个授权异常。
161:      * 接着，它获取令牌的最后使用时间，并计算令牌是否已过期。如果令牌过期，则同样抛出授权异常。
162:      * 这个过程旨在确保每个请求的令牌都是近期有效的，从而保障系统的安全性。
163:      *
164:      * @param string $token 需要验证的令牌字符串
165:      * @throws AuthException 如果令牌无效或已过期，则抛出授权异常
166:      */
167:     public function checkToken(string $token)
168:     {
169:         // 检查缓存中是否存在指定的令牌
170:         $has = Cache::has('openapi_' . $token);
171:         // 如果令牌不存在于缓存中，则抛出无效令牌异常
172:         if (!$has)
173:             throw new AuthException('无效的token');
174: 
175:         // 获取令牌的最后使用时间
176:         $lastTime = Cache::get('openapi_' . $token);
177:         // 计算令牌的有效期，并与当前时间进行比较
178:         // 如果令牌已过期，则抛出令牌过期异常
179:         if (($lastTime + (intval(Config::get('admin.openapi_token_valid_exp', 15))) * 60) < time())
180:             throw new AuthException('token 已过期，请重新登录');
181:     }
182: 
183: }
