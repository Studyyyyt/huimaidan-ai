 282:     /**
 283:      * 创建商家
 284:      *
 285:      * 本函数用于处理商家的创建流程，包括验证商家名称、手机号、分类存在性以及账号唯一性，
 286:      * 设置商家的保证金和相关费用，创建商家管理员账号，并在数据库事务中完成所有相关操作。
 287:      * 这确保了操作的一致性和原子性。
 288:      *
 289:      * @param array $data 商家创建的数据，包含商家名称、电话、分类ID、管理员账号等信息。
 290:      * @return object 创建的商家对象。
 291:      * @throws ValidateException 如果验证失败，抛出验证异常。
 292:      */
 293:     public function createMerchant(array $data)
 294:     {
 295:         // 检查商家名称是否已存在
 296:         if ($this->fieldExists('mer_name', $data['mer_name']))
 297:             throw new ValidateException('商户名已存在');
 298: 
 299:         // 验证手机号格式是否正确
 300:         if ($data['mer_phone'] && isPhone($data['mer_phone']))
 301:             throw new ValidateException('请输入正确的手机号');
 302: 
 303:         // 获取商家分类仓库和商家管理员仓库实例
 304:         $merchantCategoryRepository = app()->make(MerchantCategoryRepository::class);
 305:         $adminRepository = app()->make(MerchantAdminRepository::class);
 306: 
 307:         // 检查商家分类是否存在
 308:         if (!$data['category_id'] || !$merchantCategoryRepository->exists($data['category_id']))
 309:             throw new ValidateException('商户分类不存在');
 310: 
 311:         // 检查管理员账号是否已存在
 312:         if ($adminRepository->fieldExists('account', $data['mer_account']))
 313:             throw new ValidateException('账号已存在');
 314: 
 315:         /** @var MerchantAdminRepository $make */
 316:         $make = app()->make(MerchantAdminRepository::class);
 317: 
 318:         // 获取商家类型信息，包括保证金和相关费用
 319:         $margin = app()->make(MerchantTypeRepository::class)->get($data['type_id']);
 320:         $data['is_margin'] = $margin['is_margin'] ?? 0;
 321:         $data['margin'] = $margin['margin'] ?? 0;
 322:         $data['ot_margin'] = $margin['margin'] ?? 0;
 323: 
 324:         // 处理管理员信息，如果存在则保留
 325:         $admin_info = [];
 326:         if(isset($data['admin_info'])){
 327:             $admin_info = $data['admin_info'] ?: [];
 328:             unset($data['admin_info']);
 329:         }
 330: 
 331:         // 使用数据库事务来确保所有操作的一致性
 332:         return Db::transaction(function () use ($data, $make,$admin_info) {
 333:             // 从数据数组中提取账号和密码，并删除这些字段
 334:             $account = $data['mer_account'];
 335:             $password = $data['mer_password'];
 336:             unset($data['mer_account'], $data['mer_password']);
 337: 
 338:             // 创建商家主体
 339:             $merchant = $this->dao->create($data);
 340:             // 创建商家管理员账号
 341:             $make->createMerchantAccount($merchant, $account, $password);
 342:             // 创建默认的配送模板
 343:             app()->make(ShippingTemplateRepository::class)->createDefault($merchant->mer_id);
 344:             // 设置默认的商品复制数量
 345:             app()->make(ProductCopyRepository::class)->defaulCopyNum($merchant->mer_id);
 346:             // 处理关联店铺分组
 347:             $storeGroupIds = $data['store_group_ids'] ?? [];
 348:             unset($data['store_group_ids']);
 349:             if($storeGroupIds){
 350:                 $relevance = [];
 351:                 foreach ($storeGroupIds as $storeGroupId) {
 352:                     $relevance[] = [
 353:                         'left_id' => $storeGroupId,
 354:                         'right_id' => $merchant->mer_id,
 355:                         'type' => RelevanceRepository::STORE_GROUP,
 356:                     ];
 357:                 }
 358:                 app()->make(RelevanceRepository::class)->insertAll($relevance);
 359:             }
 360: 
 361:             // 如果存在管理员信息和操作日志更新信息，记录操作日志
 362:             // 记录商户创建日志
 363:             if (!empty($admin_info) && !empty($update_infos)) {
 364:                 event('create_operate_log', [
 365:                     'category' => OperateLogRepository::PLATFORM_CREATE_MERCHANT,
 366:                     'data' => [
 367:                         'merchant' => $merchant,
 368:                         'admin_info' => $admin_info,
 369:                     ],
 370:                 ]);
 371:             }
 372:             // 返回创建的商家对象
 373:             return $merchant;
 374:         });
 375:     }
