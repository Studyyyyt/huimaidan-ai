568:     public function subjectStatus($data)
569:     {
570:         /**
571:          * APPLYMENT_STATE_EDITTING:（编辑中）提交申请发生错误导致，请尝试重新提交。
572:          * APPLYMENT_STATE_AUDITING:（审核中）申请单正在审核中，超级管理员用微信打开“签约链接”，完成绑定微信号后，申请单进度将通过微信公众号通知超级管理员，引导完成后续步骤。
573:          * APPLYMENT_STATE_REJECTED:（已驳回）请按照驳回原因修改申请资料，超级管理员用微信打开“签约链接”，完成绑定微信号，后续申请单进度将通过微信公众号通知超级管理员。
574:          * APPLYMENT_STATE_TO_BE_CONFIRMED:（待账户验证）请超级管理员使用微信打开返回的“签约链接”，根据页面指引完成账户验证
575:          * APPLYMENT_STATE_TO_BE_SIGNED:（待签约）请超级管理员使用微信打开返回的“签约链接”，根据页面指引完成签约。
576:          * APPLYMENT_STATE_SIGNING:（开通权限中）系统开通相关权限中，请耐心等待。
577:          * APPLYMENT_STATE_FINISHED:（已完成）商户入驻申请已完成。
578:          * APPLYMENT_STATE_CANCELED:（已作废）申请单已被撤销。
579:          */
580:         //申请状态: 0.平台未提交，-1.平台驳回，10.平台提交审核中，11.需用户操作 ，20.已完成，30.已冻结，40.驳回
581:         $result = [];
582:         $status = 0;
583:         $message = '';
584:         switch ($data['applyment_state']) {
585:             case 'APPLYMENT_STATE_REJECTED':
586:                 foreach ($data['audit_detail'] as $datum){
587:                     $message .= '参数名称:'.$datum['param_name'].PHP_EOL;
588:                     $message .= '驳回原因:'.$datum['reject_reason'].PHP_EOL;
589:                 }
590:                 $status = 40;
591:                 break;
592:             case 'APPLYMENT_STATE_TO_BE_CONFIRMED':
593:                 $message = $data['sign_url'];
594:                 $status = 1;
595:                 break;
596:             case 'APPLYMENT_STATE_TO_BE_SIGNED':
597:                 $message = $data['sign_url'];
598:                 $status = 11;
599:                 break;
600:             case 'APPLYMENT_STATE_SIGNING':
601:                 $message = $data['sign_url'];
602:                 $status = 11;
603:                 break;
604:             case 'APPLYMENT_STATE_FINISHED':
605:                 $result['sub_mchid'] = $data['sub_mchid'];
606:                 $status = 20;
607:                 break;
608:             case 'APPLYMENT_STATE_CANCELED':
609:                 $message = $data['applyment_state_msg'];
610:                 $status = 40;
611:                 break;
612:         }
613:         $result['status'] = $status;
614:         return $result;
615:     }
