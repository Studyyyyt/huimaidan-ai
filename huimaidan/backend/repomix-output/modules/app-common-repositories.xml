666:     /**
667:      * 商户财务信息查询
668:      *
669:      * 根据给定的条件查询商户的财务信息，并计算每个商户的收入、支出和可提现金额。
670:      * 使用缓存来优化性能，避免重复计算。
671:      *
672:      * @param array $where 查询条件
673:      * @param int $page 当前页码
674:      * @param int $limit 每页数据数量
675:      * @return array 包含商户数量和商户列表的数组
676:      */
677:     public function merchantFinancial(array $where, int $page, int $limit)
678:     {
679:         // 根据条件查询商户信息
680:         $query = app()->make(MerchantRepository::class)->search($where);
681:         // 计算总商户数
682:         $count = $query->count();
683:         // 获取指定页码和每页数量的商户列表，并指定查询字段
684:         $merchant = $query->page($page, $limit)->setOption('field', [])->field('mer_id,mer_name,status,is_del,mer_money')->select();
685:         // 实例化财务记录仓库
686:         $financialRecordRepository = app()->make(FinancialRecordRepository::class);
687:         // 初始化商户列表数组
688:         $list = [];
689:         // 遍历商户列表
690:         foreach ($merchant as $item) {
691:             // 构建缓存键，每天每小时每个商户只计算一次
692:             $key = date('YmdH') . '_' . json_encode($item);
693:             // 从缓存中获取商户的财务信息，如果不存在
694:             if (!$ret = Cache::get($key)) {
695:                 // 初始化计算条件
696:                 // 商户累计应入账金额
697:                 $_where['is_mer'] = $item['mer_id'];
698:                 // 计算商户的收入
699:                 $income = $financialRecordRepository->countIncome(0, $_where, '')['number'];
700:                 // 计算商户的支出
701:                 $expend = $financialRecordRepository->countExpend(0, $_where, '')['number'];
702:                 // 计算商户的结余
703:                 $ret = [
704:                     'income' => $income,
705:                     'expend' => $expend,
706:                     'charge' => bcsub($income, $expend, 2),
707:                 ];
708:                 // 计算商户的累计交易额
709:                 // 商户累计交易额
710:                 $ret['sum'] = $financialRecordRepository->search($_where)->where('financial_type', 'in', ['order', 'mer_presell'])->sum('number');
711:                 // 计算商户的可提现金额
712:                 // 最低提现额度
713:                 $extract_minimum_line = systemConfig('extract_minimum_line');
714:                 // 商户可提现金额
715:                 // 最低提现额度
716:                 $_line = bcsub($item['mer_money'], $extract_minimum_line, 2);
717:                 $ret['line'] = $_line > 0 ? $_line : 0;
718:                 $ret['mer_money'] = $item['mer_money'];
719:                 [$ret['count_offline'], $ret['number_offline']] = $this->dao->getDateByPayType(0, $_where, '', [7]);
720:                 // 将计算结果序列化并存入缓存
721:                 $ret = json_encode($ret, JSON_UNESCAPED_UNICODE);
722:                 Cache::set($key, $ret, 1800);
723:             }
724:             // 解析缓存中的财务信息，并添加到商户信息中
725:             $item['account'] = json_decode($ret, true);
726:             // 将处理后的商户信息添加到列表中
727:             $list[] = $item;
728:         }
729:         // 返回商户总数和处理后的商户列表
730:         return compact('count', 'list');
731:     }
