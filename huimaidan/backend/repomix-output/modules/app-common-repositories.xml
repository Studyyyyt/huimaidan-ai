 65: 
 66:         return Cache::tag($cacheTags)->remember($cacheky, function () use ($date, $merId) {
 67:             $merId = $merId ? : '';
 68:             $query = $this->dao->search(['date' => $date, 'mer_id' => $merId, 'paid' => 1]);
 69:             $momQuery = $this->dao->search(['mom_date' => $date, 'mer_id' => $merId, 'paid' => 1]);
 70:             //支付订单数 & 环比
 71:             $payOrderNum = $query->count();
 72:             $momPayOrderNum = $momQuery->count();
 73: 
 74:             //订单实付金额
 75:             $payMoney = $query->sum('pay_price');
 76:             $momPayMoney = $momQuery->sum('pay_price');
 77: 
 78:             //用券金额
 79:             $couponMoney = $query
 80:                 ->where(function($query){
 81:                     $query->where('coupon_price','>',0)->whereOr('platform_coupon_price > 0');
 82:                 })
 83:                 ->sum(Db::raw('platform_coupon_price + coupon_price'));
 84: 
 85:             $momCouponMoney = $momQuery
 86:                 ->where(function($query){
 87:                     $query->where('coupon_price','>',0)->whereOr('platform_coupon_price > 0');
 88:                 })
 89:                 ->sum(Db::raw('platform_coupon_price + coupon_price'));
 90: 
 91: 
 92:             $refundOrderRepository = app()->make(StoreRefundOrderRepository::class);
 93:             $refundQuery = $refundOrderRepository->search(['date' => $date, 'mer_id' => $merId]);
 94:             $momRefundQuery = $refundOrderRepository->search(['mom_date' => $date, 'mer_id' => $merId]);
 95: 
 96:             //退款金额
 97:             $refundMoney = $refundQuery->where('StoreRefundOrder.status',3)->sum('refund_price');
 98:             $momRefundMoney = $momRefundQuery->where('StoreRefundOrder.status',3)->sum('refund_price');
 99:             //退款订单数
100:             $refundOrderNum = $refundQuery->where('StoreRefundOrder.status','<>',-1)->count();
101:             $momRefundOrderNum = $momRefundQuery->where('StoreRefundOrder.status','<>',-1)->count();
102:             $redata = [
103:                 [
104:                     'title' => "支付订单数",
105:                     'count' => $payOrderNum,
106:                     'mom'   => $momPayOrderNum,
107:                     'statistic' => growthRate($payOrderNum,$momPayOrderNum)
108:                 ],
109:                 [
110:                     'title' => "订单实付金额",
111:                     'count' => $payMoney,
112:                     'mom'   => $momPayMoney,
113:                     'statistic' => growthRate($payMoney,$momPayMoney)
114:                 ],
115:                 [
116:                     'title' => "用券金额",
117:                     'count' => $couponMoney,
118:                     'mom'   => $momCouponMoney,
119:                     'statistic' => growthRate($couponMoney,$momCouponMoney)
120:                 ],
121:                 [
122:                     'title' => "退款金额",
123:                     'count' => $refundMoney,
124:                     'mom'   => $momRefundMoney,
125:                     'statistic' => growthRate($refundMoney,$momRefundMoney)
126:                 ],
127:                 [
128:                     'title' => "退款订单数",
129:                     'count' => $refundOrderNum,
130:                     'mom'   => $momRefundOrderNum,
131:                     'statistic' => growthRate($refundOrderNum,$momRefundOrderNum)
132:                 ],
133:             ];
134:             return $redata;
135:         },self::CACHA_TIME);
