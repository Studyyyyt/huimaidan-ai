 98:     /**
 99:      * 保存配置数据
100:      *
101:      * 该方法用于处理配置项的保存操作。它首先确定哪些配置键是有效的，然后处理这些键对应的值，
102:      * 包括类型转换和值的验证，最后保存处理后的数据。
103:      *
104:      * @param int $cid 配置分类ID，用于确定配置项的分类。
105:      * @param array $formData 用户提交的表单数据，包含所有的配置项及其值。
106:      * @param int $merId 商家ID，用于区分不同商家的配置数据（如果适用）。
107:      * @throws ValidateException 如果配置项的值不合法，例如小于0的数字，将抛出验证异常。
108:      */
109:     public function save($cid, array $formData, int $merId)
110:     {
111:         $this->saveBefore($cid, $formData, $merId);
112:         // 获取表单数据的所有键
113:         $keys = array_keys($formData);
114:         // 确定哪些键是有效的配置键，通过与配置仓库中的键进行交集运算
115:         $keys = app()->make(ConfigRepository::class)->intersectionKey($cid, $keys);
116:         // 如果没有有效的键，则直接返回，不进行后续操作
117:         if (!count($keys)) return;
118: 
119:         // 遍历有效的键，对每个键对应的值进行处理
120:         foreach ($keys as $key => $info) {
121:             // 如果表单数据中不存在当前键，则从表单数据中移除该键
122:             if (!isset($formData[$key]))
123:                 unset($formData[$key]);
124:             else {
125:                 // 如果当前配置项的类型为数字，则进行数值验证和类型转换
126:                 if ($info['config_type'] == 'number') {
127:                     // 如果值为空或小于0，则抛出验证异常
128:                     if ($formData[$key] === '' || $formData[$key] < 0)
129:                         throw new ValidateException($info['config_name'] . '不能小于0');
130:                     // 将值转换为浮点数
131:                     $formData[$key] = floatval($formData[$key]);
132:                 }
133:                 // 对当前配置项进行进一步的处理，例如存储或转换
134:                 $this->separate($key,$formData[$key],$merId);
135:             }
136:         }
137:         // 保存处理后的表单数据
138:         $this->setFormData($formData, $merId);
139:     }
