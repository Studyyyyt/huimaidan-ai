 584:     /**
 585:      *  自动发货卡密商品
 586:      * @param $order
 587:      * @return mixed|string
 588:      * @author Qinii
 589:      * @day 2023/5/4
 590:      */
 591:     public function sendCdkey($order, $type)
 592:     {
 593:         $msg = '未获得卡密，请联系客服';
 594:         if ($type == ProductRepository::DEFINE_TYPE_CARD) {
 595:             $productCdkeyRepository = app()->make(ProductCdkeyRepository::class);
 596:             $library_id = $order->orderProduct[0]['cart_info']['productAttr']['library_id'];
 597:             $where = ['library_id' => $library_id, 'status' => 1];
 598:             $cdkey = $productCdkeyRepository->search($where)->whereNotNull('key')->find();
 599:             if ($cdkey) {
 600:                 $cdkey->status = -1;
 601:                 $cdkey->product_id = $order->orderProduct[0]['cart_info']['product']['product_id'];
 602:                 $cdkey->value_id = $order->orderProduct[0]['cart_info']['productAttr']['value_id'];
 603:                 $cdkey->save();
 604:                 $msg = '卡号：' . $cdkey['key'] . ' 卡密：' . $cdkey['pwd'];
 605:             }
 606:             app()->make(CdkeyLibraryRepository::class)->incUsedNum($library_id);
 607:         } else {
 608:             $productAttrValueRepository = app()->make(ProductAttrValueRepository::class);
 609:             if (isset($order->orderProduct[0]['cart_info']['productAttr']['value_id'])) {
 610:                 $where['value_id'] = $order->orderProduct[0]['cart_info']['productAttr']['value_id'];
 611:             } else {
 612:                 $where['unique'] = $order->orderProduct[0]['cart_info']['productAttr']['unique'];
 613:             }
 614:             $rest = $productAttrValueRepository->getWhere($where, '*', ['productCdkey' => function ($query) {
 615:                 $query->where('status', 1)->order('cdkey_id ASC')->withLimit(1);
 616:             }]);
 617:             $cdkey = $rest['productCdkey'];
 618:             $msg = $cdkey['key'];
 619:         }
 620:         return $msg;
 621:     }
