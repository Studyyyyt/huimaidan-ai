249:         }
250:         $list = app()->make(StoreActivityRepository::class)->getPic($list, StoreActivityRepository::ACTIVITY_TYPE_BORDER);
251:         // 计算距离
252:         if((isset($where['latitude']) && !empty($where['latitude'])) && (isset($where['longitude']) && !empty($where['longitude']))) {
253:             foreach ($list as &$item) {
254:                 [$item['distance'], $item['distanceM']] = $this->distance($where, $item['merchant']['lat'], $item['merchant']['long']);
255:             }
256:             if($where['order'] == 'distance_asc') {
257:                 // 距离排序
258:                 usort($list, function($a, $b) {
259:                     return $a['distanceM'] > $b['distanceM'];
260:                 });
261:             }
262:             if($where['order'] == 'distance_desc') {
263:                 // 距离排序
264:                 usort($list, function($a, $b) {
265:                     return $a['distanceM'] < $b['distanceM'];
266:                 });
267:             }
268:         }
269: 
270:         $list = $this->spuCart($userInfo, getThumbWaterImage($list, ['image'], 'mid'));
271:         return compact('count', 'list');
272:     }
