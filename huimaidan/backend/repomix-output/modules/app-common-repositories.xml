 387:     /**
 388:      * 检查并处理退款保证金
 389:      *
 390:      * 该方法用于检查商家是否有足够的保证金可以退款，并根据情况处理线上和线下的退款。
 391:      * 它首先查询商家的信息以及相关的保证金订单，然后计算可退金额并分别处理线上和线下的退款操作。
 392:      *
 393:      * @param string $merId 商家ID
 394:      * @param string $adminId 管理员ID
 395:      * @param bool $crate 是否创建退款订单，默认为false
 396:      * @param array $account 如果需要线下退款，传入退款账户信息
 397:      * @return array 包含线上退款金额、线下退款金额、退款订单信息和退款类型信息的数组
 398:      * @throws ValidateException 如果商家无法退款或重复申请，则抛出验证异常
 399:      */
 400:     public function checkRefundMargin($merId, $adminId, $crate = false, $account = [])
 401:     {
 402:         /**
 403:          * 获取线上支付的订单
 404:          * 检查线上支付的订单是否够退当前的保证金
 405:          * 优先线上退款，剩余的金额都走线下退款
 406:          */
 407:         $merchant = app()->make(MerchantRepository::class)->getWhere(['mer_id' => $merId], '*', [
 408:                 'marginOrder' => function ($query) {
 409:                     $query->where('status', 1)->where('pay_type', '<>', ServeOrderRepository::PAY_TYPE_SYS)->field('order_id,order_sn,pay_price,pay_type,mer_id');
 410:                 }]
 411:         );
 412: 
 413:         if ($merchant['is_margin'] == -1) throw new ValidateException('请勿重复申请');
 414:         if (!in_array($merchant['is_margin'], [10, -10]) || $merchant['margin'] <= 0)
 415:             throw new ValidateException('无可退保证金');
 416:         $orderList = $merchant->marginOrder;
 417:         //需退金额
 418:         $extract_money = $merchant->margin;
 419:         $financial = $info = [];
 420:         $online = $offline = 0;
 421:         if ($orderList) {
 422:             foreach ($orderList as $order) {
 423:                 $refund_price = bcsub($order->pay_price, $extract_money, 2) < 0 ? $order->pay_price : $merchant->margin;
 424:                 $extract_money = bcsub($extract_money, $refund_price, 2);
 425:                 $online = bcadd($refund_price, $online, 2);
 426:                 if ($crate) {
 427:                     $financial[] = $this->payOrderRefund($merchant, $adminId, $refund_price, $order);
 428:                 }
 429:                 if (bccomp($extract_money, 0, 2) == 0) break;
 430:             }
 431:         }
 432: 
 433:         if (bccomp($extract_money, 0, 2) == 1) {
 434:             $offline = $extract_money;
 435:             if ($crate) {
 436:                 $financial[] = $this->payOrderRefund($merchant, $adminId, $extract_money, null, $account);
 437:             }
 438:             $info = $this->getType($merchant);
 439:         }
 440: 
 441:         return compact('online', 'offline', 'financial', 'info');
