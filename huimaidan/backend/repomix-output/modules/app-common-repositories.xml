 891:            'price' => $minValue[$price_filed],
 892:            'ot_price' => $minValue[$ot_price],
 893:            'cost' => $minValue['cost'],
 894:            'svip_price' => $svip ? $minValue['svip_price'] : 0,
 895:        ];
 896:     }
