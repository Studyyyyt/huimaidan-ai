2241:     public function getSeckillAttrValue($skuList, $oldProductId)
2242:     {
2243:         /**
2244:          *  秒杀商品限购数量
2245:          *  原商品库存 > 限购数
2246:          *      销量 = 订单总数 - 退款退货 - （未发货且仅退款）
2247:          *      限购数 = 限购数 - 销量
2248:          *  原商品库存 < 限购数
2249:          *      限购数 = 原商品库存
2250:          */
2251:         $productAttrValueRepository = app()->make(ProductAttrValueRepository::class);
2252:         $storeOrderProductRepository = app()->make(StoreOrderProductRepository::class);
2253:         $orderCount = $storeOrderProductRepository->getSearch([])
2254:             ->where('product_sku', 'in', array_column($skuList->toArray(), 'unique'))
2255:             ->where('is_refund', 'in', '0,1,2')
2256:             ->whereDay('create_time')
2257:             ->column('refund_num', 'product_sku');
2258:         $stock = 0;
2259:         $item = [];
2260: 
2261:         $oldAttrValue = $productAttrValueRepository->search(['product_id' => $oldProductId])->column('stock', 'sku');
2262:         foreach ($skuList as $value) {
2263:             $_stock = 0;
2264:             if (isset($oldAttrValue[$value['sku']]) && $oldAttrValue[$value['sku']]) {
2265:                 $_stock = ($value['stock'] < $oldAttrValue[$value['sku']]) ? $value['stock'] : $oldAttrValue[$value['sku']];
2266:                 if ($_stock > 0 && ($value['stock'] < $oldAttrValue[$value['sku']])) {
2267:                     $_stock = $_stock - ($orderCount[$value['unique']] ?? 0);
2268:                 }
2269:                 $value['stock'] = max(0,$_stock);
2270:             } else {
2271:                 $value['stock'] = 0;
2272:             }
2273:             $stock += $_stock;
2274:             $item[] = $value;
2275:         }
2276:         return compact('stock','item');
2277:     }
