 986:      */
 987:     public function computed(StoreOrder $order, User $user)
 988:     {
 989:         // 实例化用户账单仓库，用于处理用户账单相关操作。
 990:         $userBillRepository = app()->make(UserBillRepository::class);
 991: 
 992:         // 根据订单状态和用户角色，确定推广UID和顶级UID。
