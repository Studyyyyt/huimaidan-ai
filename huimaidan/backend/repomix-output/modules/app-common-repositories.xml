546:     /**
547:      * 平台总支出
548:      * @param $type
549:      * @param $date
550:      * @return array
551:      * @author Qinii
552:      * @day 3/23/21
553:      */
554:     public function countExpend($type, $where, $date)
555:     {
556:         /**
557:          * 平台支出
558:          * 商户的收入 order_true + 佣金 brokerage_one,brokerage_two + 手续费 refund_charge + 商户预售收入 presell_true
559:          *
560:          * 商户支出
561:          * 退回收入 refund_order + （佣金 brokerage_one,brokerage_two  -  退回佣金 refund_brokerage_two,refund_brokerage_one ） + （手续费  order_charge + 预售手续费 presell_charge  - 平台退给商户的手续费 refund_charge ）
562:          */
563:         // 退回佣金
564:         $financialType = ['brokerage_one', 'brokerage_two'];
565:         [$data['count_brokerage'], $data['number_brokerage']] = $this->dao->getDataByType($type, $where, $date, $financialType);
566: 
567:         // 退回 手续费
568:         $financialType = ['refund_charge'];
569:         [$data['count_charge'], $data['number_charge']] = $this->dao->getDataByType($type, $where, $date, $financialType);
570: 
571:         if ($where['is_mer']) { //商户的
572:             //退回 收入
573:             $financialType = ['refund_order'];
574:             [$data['count_refund'], $data['number_refund']] = $this->dao->getDataByType($type, $where, $date, $financialType);
575: 
576:             //平台手续费
577:             $financialType = ['order_charge', 'presell_charge'];
578:             [$data['count_order_charge'], $data['number_order_charge']] = $this->dao->getDataByType($type, $where, $date, $financialType);
579: 
580:             //退回佣金
581:             $financialType = ['refund_brokerage_two', 'refund_brokerage_one'];
582:             [$data['count_refund_brokerage'], $data['number_refund_brokerage']] = $this->dao->getDataByType($type, $where, $date, $financialType);
583: 
584:             //退回给平台的优惠券金额
585:             $financialType = ['refund_platform_coupon'];
586:             [$data['count_coupon'], $data['number_coupon']] = $this->dao->getDataByType($type, $where, $date, $financialType);
587:             //退回给平台的会员优惠券金额
588:             $financialType = ['refund_svip_coupon'];
589:             [$data['count_svipcoupon'], $data['number_svipcoupon']] = $this->dao->getDataByType($type, $where, $date, $financialType);
590: 
591:             //佣金 brokerage_one,brokerage_two  -  退回佣金 refund_brokerage_two,refund_brokerage_one ）
592:             $number = bcsub($data['number_brokerage'], $data['number_refund_brokerage'], 3);
593: 
594:             //平台手续费 =（ order_charge + 预售手续费 presell_charge  - 平台退给商户的手续费 refund_charge ）
595:             $number_1 = bcsub($data['number_order_charge'], $data['number_charge'], 3);
596: 
597:             //退回收入 refund_order + 退回佣金
598:             $number_2 = bcadd(bcadd($data['number_refund'], $data['number_coupon'], 2), $data['number_svipcoupon'], 2);
599: 
600:             $data['count'] = $data['count_brokerage'] + $data['count_refund'] + $data['count_order_charge'] + $data['count_refund'] + $data['count_refund_brokerage'] + $data['count_svipcoupon'];
601:             $data['number'] = bcadd(bcadd($number_2, $number, 3), $number_1, 2);
602: 
603:         } else { //平台的
604:             // 退回 订单实际获得金额
605: 
606:             $financialType = ['order_true', 'presell_true'];
607:             [$data['count_order'], $data['number_order']] = $this->dao->getDataByType($type, $where, $date, $financialType);
608: 
609:             //付给商户的优惠券抵扣金额
610:             $financialType = ['order_platform_coupon'];
611:             [$data['count_coupon'], $data['number_coupon']] = $this->dao->getDataByType($type, $where, $date, $financialType);
612: 
613:             //付给商户的svip优惠券抵扣金额
614:             $financialType = ['order_svip_coupon'];
615:             [$data['count_svipcoupon'], $data['number_svipcoupon']] = $this->dao->getDataByType($type, $where, $date, $financialType);
616:             // 线下支付金额（线下支付）
617:             $offlineWhere = $where;
618:             $offlineWhere['financial_pm'] = 0;
619:             $offlineWhere['financial_type'] = ['refund_order'];
620:             [$data['count_offline'], $data['number_offline']] = $this->dao->getDateByPayType($type, $offlineWhere, $date, [7]);
621: 
622:             $data['number_order'] = bcsub($data['number_order'], $data['number_offline'], 2); // 减去线下支付金额
623:             $data['count_order'] = bcsub($data['count_order'], $data['count_offline']); // 减去线下支付数量
624:             $number = bcadd($data['number_brokerage'], $data['number_order'], 2);
625:             $number_1 = bcadd(bcadd($number, $data['number_coupon'], 2), $data['number_svipcoupon'], 2);
626: 
627:             $data['count'] = $data['count_brokerage'] + $data['count_order'] + $data['count_charge'] + $data['count_offline'];
628:             $data['number'] = bcadd($data['number_offline'],bcadd($number_1, $data['number_charge'], 2),2);
629:         }
630: 
631:         return $data;
632:     }
