1633:     /**
1634:      * 处理订单退款时的佣金返还逻辑。
1635:      *
1636:      * 该方法主要处理一级和二级佣金在订单退款时的返还操作。它首先检查退款订单中的一级和二级佣金金额，
1637:      * 如果佣金大于0，则尝试从用户的佣金账单中扣除该金额。如果账单存在且状态不是已退款，则执行扣除操作，
1638:      * 同时更新用户的佣金余额。如果账单不存在或状态是已退款，则记录一条财务记录，表示佣金的退还。
1639:      * 最后，更新订单中的佣金金额。
1640:      *
1641:      * @param StoreRefundOrder $refundOrder 退款订单对象，包含订单和退款信息。
1642:      */
1643:     public function descBrokerage(StoreRefundOrder $refundOrder)
1644:     {
1645:         // 获取用户账单仓库和用户仓库实例
1646:         $userBillRepository = app()->make(UserBillRepository::class);
1647:         $userRepository     = app()->make(UserRepository::class);
1648: 
1649:         // 处理一级佣金退款
1650:         if ($refundOrder['extension_one'] > 0) {
1651:             // 根据订单ID查询一级佣金账单
1652:             $bill = $userBillRepository->getWhere(['category' => 'brokerage', 'type' => 'order_one', 'link_id' => $refundOrder->order_id]);
1653:             // 减少订单中的一级佣金金额
1654:             $refundOrder->order->extension_one = bcsub($refundOrder->order->extension_one, $refundOrder['extension_one'], 2);
1655:             // 如果账单存在且状态不是已退款，则执行佣金扣除操作
1656:             $title = $refundOrder->order->activity_type == 4 ? '团员退款' : '用户退款';
1657:             if ($bill && $bill->status != 1) {
1658:                 $userRepository->incBrokerage($bill->uid, $refundOrder['extension_one'], '-');
1659:                 $userBillRepository->decBill($bill->uid, 'brokerage', 'refund_one', [
1660:                     'link_id' => $refundOrder->order_id,
1661:                     'status'  => 1,
1662:                     'title'   => $title,
1663:                     'number'  => $refundOrder['extension_one'],
1664:                     'mark'    => $title . '扣除推广佣金' . floatval($refundOrder['extension_one']),
1665:                     'balance' => 0
1666:                 ]);
1667:             }
1668:             // 如果账单不存在或状态是已退款，则记录一条财务记录，表示一级佣金的退还
1669:             if (!$bill || $bill->status != 1) {
1670:                 app()->make(FinancialRecordRepository::class)->inc([
1671:                     'order_id'       => $refundOrder->refund_order_id,
1672:                     'order_sn'       => $refundOrder->refund_order_sn,
1673:                     'user_info'      => $bill ? $userRepository->getUsername($bill->uid) : '退还一级佣金',
1674:                     'user_id'        => $bill ? $bill->uid : 0,
1675:                     'type'           => 1,
1676:                     'financial_type' => 'refund_brokerage_one',
1677:                     'number'         => $refundOrder['extension_one'],
1678:                 ], $refundOrder->mer_id);
1679:             }
1680:         }
1681: 
1682:         // 处理二级佣金退款
1683:         if ($refundOrder['extension_two'] > 0) {
1684:             // 根据订单ID查询二级佣金账单
1685:             $bill = $userBillRepository->getWhere(['category' => 'brokerage', 'type' => 'order_two', 'link_id' => $refundOrder->order_id]);
1686:             // 减少订单中的二级佣金金额
1687:             $refundOrder->order->extension_two = bcsub($refundOrder->order->extension_two, $refundOrder['extension_two'], 2);
1688:             // 如果账单存在且状态不是已退款，则执行佣金扣除操作
1689:             if ($bill && $bill->status != 1) {
1690:                 $userRepository->incBrokerage($bill->uid, $refundOrder['extension_two'], '-');
1691:                 $userBillRepository->decBill($bill->uid, 'brokerage', 'refund_two', [
1692:                     'link_id' => $refundOrder->order_id,
1693:                     'status'  => 1,
1694:                     'title'   => '用户退款',
1695:                     'number'  => $refundOrder['extension_two'],
1696:                     'mark'    => '用户退款扣除推广佣金' . floatval($refundOrder['extension_two']),
1697:                     'balance' => 0
1698:                 ]);
1699:             }
1700:             // 如果账单不存在或状态是已退款，则记录一条财务记录，表示二级佣金的退还
1701:             if (!$bill || $bill->status != 1) {
1702:                 app()->make(FinancialRecordRepository::class)->inc([
1703:                     'order_id'       => $refundOrder->refund_order_id,
1704:                     'order_sn'       => $refundOrder->refund_order_sn,
1705:                     'user_info'      => $bill ? $userRepository->getUsername($bill->uid) : '退还二级佣金',
1706:                     'user_id'        => $bill ? $bill->uid : 0,
1707:                     'type'           => 1,
1708:                     'financial_type' => 'refund_brokerage_two',
1709:                     'number'         => $refundOrder['extension_two'],
1710:                 ], $refundOrder->mer_id);
1711:             }
1712:         }
1713: 
1714:         // 保存更新后的订单信息
1715:         $refundOrder->order->save();
1716:     }
