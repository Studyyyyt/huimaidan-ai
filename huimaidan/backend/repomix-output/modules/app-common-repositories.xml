 921:         // 根据优惠券的最低使用金额，确定是否有限制使用条件
 922:         $couponInfo['use_type'] = $couponInfo['use_min_price'] > 0 ? 1 : 0;
 923: 
 924:         // 移除原始产品信息，避免数据冗余
 925:         unset($couponInfo['product']);
