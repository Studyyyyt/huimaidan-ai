155:     /**
156:      * 视频分片上传
157:      * @param $data
158:      * @param $file
159:      * @return mixed
160:      */
161:     public function videoUpload($data, $file)
162:     {
163:         $pathinfo = pathinfo($data['filename']);
164:         if (isset($pathinfo['extension']) && !in_array($pathinfo['extension'], ['avi', 'mp4', 'wmv', 'rm', 'mpg', 'mpeg', 'mov', 'flv', 'swf'])) {
165:             throw new AdminException(400558);
166:         }
167:         $data['chunkNumber'] = (int)$data['chunkNumber'];
168:         $public_dir = app()->getRootPath() . 'public';
169:         $dir = '/uploads/attach/' . date('Y') . DIRECTORY_SEPARATOR . date('m') . DIRECTORY_SEPARATOR . date('d');
170:         $all_dir = $public_dir . $dir;
171:         if (!is_dir($all_dir)) mkdir($all_dir, 0777, true);
172:         $filename = $all_dir . '/' . $data['filename'] . '__' . $data['chunkNumber'];
173:         move_uploaded_file($file['tmp_name'], $filename);
174:         $res['code'] = 0;
175:         $res['msg'] = 'error';
176:         $res['file_path'] = '';
177:         if ($data['chunkNumber'] == $data['totalChunks']) {
178:             $blob = '';
179:             for ($i = 1; $i <= $data['totalChunks']; $i++) {
180:                 $blob .= file_get_contents($all_dir . '/' . $data['filename'] . '__' . $i);
181:             }
182:             file_put_contents($all_dir . '/' . $data['filename'], $blob);
183:             for ($i = 1; $i <= $data['totalChunks']; $i++) {
184:                 @unlink($all_dir . '/' . $data['filename'] . '__' . $i);
185:             }
186:             if (file_exists($all_dir . '/' . $data['filename'])) {
187:                 $res['code'] = 2;
188:                 $res['msg'] = 'success';
189:                 $res['file_path'] = systemConfig('site_url') . $dir . '/' . $data['filename'];
190:             }
191:         } else {
192:             if (file_exists($all_dir . '/' . $data['filename'] . '__' . $data['chunkNumber'])) {
193:                 $res['code'] = 1;
194:                 $res['msg'] = 'waiting';
195:                 $res['file_path'] = '';
196:             }
197:         }
198:         return $res;
199:     }
200: }
