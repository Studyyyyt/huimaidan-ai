 76:      * 主要涉及的步骤包括：
 77:      * 1. 根据传入的字段规则，验证数据的合法性。
 78:      * 2. 调用DAO层的方法，执行实际的更新操作。
 79:      *
 80:      * @param int $merId 商家ID，用于确定要更新的商家。
 81:      * @param int $id 需要更新的具体信息的ID，用于定位要更新的具体信息。
 82:      * @param array $data 包含要更新的数据的信息，其中'value'键包含实际的更新值。
 83:      * @param array $fieldRule 字段规则，用于验证$data中'value'的合法性。
 84:      * @return bool 更新操作的结果，true表示成功，false表示失败。
 85:      */
 86:     public function merUpdate($merId, $id, $data, $fieldRule)
 87:     {
 88:         // 根据字段规则检查数据的合法性
 89:         $this->checkData($data['value'], $fieldRule);
 90: 
 91:         // 调用DAO层的方法执行商家信息的更新操作
 92:         return $this->dao->merUpdate($merId, $id, $data);
 93:     }
 94: 
 95:     /**
 96:      * 检查数据是否符合指定的规则
 97:      *
 98:      * 本函数用于遍历字段规则数组，并针对每个规则检查相应的数据字段是否满足条件。
 99:      * 如果数据字段不满足规则条件，则抛出一个验证异常。
100:      *
101:      * @param array $data 要检查的数据数组，其中包含各个字段的值。
102:      * @param array $fieldRule 字段规则数组，每个元素包含字段的名称、类型及其他验证条件。
103:      * @throws ValidateException 如果数据字段不满足规则条件，则抛出此异常。
104:      */
105:     public function checkData(array $data, array $fieldRule)
106:     {
107:         foreach ($fieldRule as $rule) {
108:             // 检查规则类型为数字的字段是否小于0
109:             // 如果字段类型为数字且值小于0，则抛出验证异常，指出该字段不能小于0。
110:             if ($rule['type'] === 'number' && $data[$rule['field']] < 0) {
