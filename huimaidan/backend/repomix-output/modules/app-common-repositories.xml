219:         ]);
220: 
221:         // 设置表单的标题
222:         return $form->setTitle('修改备注');
223:     }
224: 
225:     /**
226:      * 标记数据为特定状态。
227:      *
228:      * 本函数用于更新指定ID的数据项的状态。在更新之前，它会检查该数据项是否存在，
229:      * 如果不存在，则抛出一个异常。这个方法确保了只有存在的数据才能被更新，避免了
230:      * 对不存在数据的更新操作，从而维护了数据的一致性和完整性。
231:      *
232:      * @param int $id 数据项的唯一标识符。用于指定要更新哪个数据项。
233:      * @param array $data 包含要更新到数据项的新状态的数据数组。
234:      * @throws ValidateException 如果指定ID的数据项不存在，则抛出此异常。
235:      */
236:     public function mark($id, $data)
237:     {
238:         // 检查指定ID的数据项是否存在
239:         if (!$this->dao->getWhereCount([$this->dao->getPk() => $id]))
240:             // 如果数据项不存在，则抛出异常
241:             throw new ValidateException('数据不存在');
242: 
243:         // 更新数据项的状态
244:         $this->dao->update($id, $data);
245:     }
246: 
247:     /**
248:      * 获取商户详情
249:      *
250:      * 该方法通过指定的ID检索商户信息及其授权权限。如果数据不存在，则抛出验证异常。
251:      * 商户的授权权限通过权限ID数组进行表示，并进一步转换为权限路径的选项列表。
252:      *
253:      * @param int $id 商户类型ID
254:      * @return array 商户详情，包括基本信息和授权权限选项
255:      * @throws ValidateException 如果商户数据不存在
256:      */
257:     public function detail($id)
258:     {
259:         // 搜索指定ID的商户信息，并加载其授权信息，同时附加商户数量
260:         $find = $this->dao->search(['mer_type_id' => $id])->with(['auth'])->find()->append(['merchant_count']);
261: 
262:         // 如果找不到数据，则抛出异常
263:         if (!$find)    throw new ValidateException('数据不存在');
264: 
265:         // 提取授权信息中的权利ID
266:         $ids = array_column($find['auth']->toArray(), 'right_id');
267:         // 移除授权信息对象，避免直接暴露内部结构
268:         unset($find['auth']);
269:         // 将权利ID数组附加到商户详情中，以'auth_ids'键存储
270:         $find['auth_ids'] = $ids;
271: 
272:         // 初始化选项数组
273:         $options = [];
274:         // 如果存在授权ID，进一步获取授权路径和选项
275:         if ($ids) {
276:             // 获取所有权限选项，包括路径信息，传入当前授权ID数组进行过滤
277:             $paths = app()->make(MenuRepository::class)->getAllOptions(1, true,compact('ids'),'path');
278:             // 合并权限路径中的ID，以获取完整的授权ID集合
279:             foreach ($paths as $id => $path) {
280:                 $ids = array_merge($ids, explode('/', trim($path, '/')));
281:                 array_push($ids, $id);
282:             }
283:             // 根据完整的授权ID集合，获取所有的权限选项
284:             $auth = app()->make(MenuRepository::class)->getAllOptions(1, true, compact('ids'));
285:             // 格式化权限选项为树状结构，以'menu_name'作为节点标识
286:             $options = formatTree($auth, 'menu_name');
287:         }
288:         // 将格式化的权限选项附加到商户详情中
289:         $find['options'] = $options;
290: 
291:         // 返回商户详情，包括基本信息和授权权限选项
292:         return $find;
293:     }
294: 
295: }
