 29: /**
 30:  * 角色身份
 31:  */
 32: class RoleRepository extends BaseRepository
 33: {
 34:     public function __construct(RoleDao $dao)
 35:     {
 36:         /**
 37:          * @var RoleDao
 38:          */
 39:         $this->dao = $dao;
 40:     }
 41: 
 42:     /**
 43:      * 商户查询功能
 44:      * 根据给定的商户ID和查询条件，分页查询符合条件的数据，并返回总数和查询结果列表。
 45:      *
 46:      * @param int $merId 商户ID，用于指定查询的商户。
 47:      * @param array $where 查询条件数组，用于指定查询的过滤条件。
 48:      * @param int $page 当前页码，用于指定查询的页码。
 49:      * @param int $limit 每页数据条数，用于指定每页返回的数据数量。
 50:      * @return array 返回包含总数和列表的数据数组，列表中的每个角色都包含了规则名称。
 51:      */
 52:     public function search(int $merId, array $where, $page, $limit)
 53:     {
 54:         // 根据商户ID和查询条件进行查询
 55:         $query = $this->dao->search($merId, $where);
 56:         // 统计查询结果的总数
 57:         $count = $query->count();
 58:         // 进行分页查询，并获取查询结果列表
 59:         $list = $query->page($page, $limit)->select();
 60: 
 61:         // 遍历查询结果列表，为每个角色添加规则名称
 62:         foreach ($list as $k => $role) {
 63:             $list[$k]['rule_name'] = $role->ruleNames();
 64:         }
 65: 
 66:         // 返回查询结果的总数和列表
 67:         return compact('count', 'list');
 68:     }
 69: 
 70:     /**
 71:      * 更新数据条目。
 72:      *
 73:      * 本函数用于根据提供的ID和数据数组更新数据库中的相应条目。特别地，如果数据数组中包含'rules'字段，
 74:      * 该字段将被处理为以逗号分隔的字符串，以适应数据库的存储格式。这一步处理是必要的，因为数据库中
 75:      * 'rules'字段的类型通常为字符串，而不是数组。
 76:      *
 77:      * @param int $id 数据条目的唯一标识符。此ID用于在数据库中定位特定的条目。
 78:      * @param array $data 包含要更新的数据的数组。数组的键是数据库字段名，值是要更新的字段值。
 79:      *                    如果数组中包含'rules'键，其值将被转换为逗号分隔的字符串。
 80:      * @return mixed 返回更新操作的结果。具体类型取决于DAO层实现的返回类型。
 81:      */
 82:     public function update(int $id, array $data)
 83:     {
 84:         // 如果$data数组中包含'rules'键，将其值转换为逗号分隔的字符串
 85:         if (isset($data['rules'])) {
 86:             $data['rules'] = implode(',', $data['rules']);
 87:         }
 88:         // 调用DAO层的update方法执行更新操作，并返回操作结果
 89:         return $this->dao->update($id, $data);
 90:     }
 91: 
 92:     /**
 93:      * 创建或编辑角色的表单
 94:      *
 95:      * 根据传入的$merType和$id参数，决定是创建还是编辑商家角色或系统角色，并构造相应的表单。
 96:      * $merType用于区分商家角色和系统角色，$id用于指定要编辑的角色ID。如果$id为null，则表示创建新角色。
 97:      * 表单包含角色名称输入框、权限选择树和状态开关。
 98:      *
 99:      * @param int $merType 角色类型，0表示系统角色，非0表示商家角色。
100:      * @param int|null $id 角色ID，用于编辑已有角色。
101:      * @param array $formData 表单默认数据，用于填充表单。
102:      * @param array $params 
103:      * @return Form 返回构造好的表单对象。
104:      */
105:     public function form($merType = 0, ?int $id = null, array $formData = [], $params = []): Form
106:     {
107:         // 根据$merType和$id构建表单的提交URL
108:         if ($merType) {
109:             $form = Elm::createForm(is_null($id) ? Route::buildUrl('merchantRoleCreate')->build() : Route::buildUrl('merchantRoleUpdate', ['id' => $id])->build());
110:         } else {
111:             $form = Elm::createForm(is_null($id) ? Route::buildUrl('systemRoleCreate')->build() : Route::buildUrl('systemRoleUpdate', ['id' => $id])->build());
112:         }
113: 
114:         // 获取权限选项树，用于填充权限选择控件
115:         $options = app()->make(MenuRepository::class)->getTree($merType, $params['is_agent']??0, $params['circle_id']??0);
116:         // 设置表单的验证规则
117:         $form->setRule([
118:             Elm::input('role_name', '身份名称：')->placeholder('请输入身份名称')->required('请输入身份名称'),
119:             Elm::tree('rules', '权限：')->data($options)->showCheckbox(true),
120:             Elm::switches('status', '是否开启：', 1)->inactiveValue(0)->activeValue(1)->inactiveText('关闭')->className('switch-width-double')->activeText('开启'),
121:             Elm::hidden('is_agent', '组织类型')->value($params['is_agent']??0),
122:             Elm::hidden('circle_id', '组织id')->value($params['circle_id']??0)
123:         ]);
124: 
125:         // 设置表单标题并返回表单对象
126:         return $form->setTitle(is_null($id) ? '添加身份' : '编辑身份')->formData($formData);
127:     }
128: 
129:     /**
130:      * 更新表单数据的方法
131:      *
132:      * 本方法用于根据给定的ID获取现有数据，并构建一个更新表单的实例。
133:      * 主要用于在前端展示现有的数据以便用户进行编辑更新。
134:      *
135:      * @param bool $is_mer 是否为商家端，用于区分不同的表单展示逻辑。
136:      * @param int $id 需要更新的数据的ID。
137:      * @return Form 返回一个表单实例，该实例包含了需要更新的数据。
138:      */
139:     public function updateForm($is_mer, int $id, $params = [])
140:     {
141:         // 通过ID获取数据库中的数据，并转换为数组格式
142:         // 这里的$this->dao->get($id)用于从数据库中获取指定ID的数据
143:         // ->toArray()则是将获取到的数据对象转换为数组，以便后续处理
144:         return $this->form($is_mer, $id, $this->dao->get($id)->toArray(), $params);
145:     }
146: 
147:     /**
148:      * 检查角色是否匹配
149:      * 该方法用于验证给定的角色数组是否与商家在数据库中的角色完全匹配。
150:      * 这是一个业务逻辑层的方法，依赖于数据访问对象（DAO）来执行数据库查询。
151:      *
152:      * @param array $role 包含需要检查的角色ID的数组。
153:      * @param int $merId 商家的唯一标识ID。
154:      * @return bool 返回true如果角色完全匹配，否则返回false。
155:      */
156:     public function checkRole(array $role, $merId)
157:     {
158:         // 通过DAO查询商家角色ID，并筛选出状态为1的记录。
159:         $rest = $this->dao->search($merId, ['role_ids' => $role,'status' => 1])->column('role_id');
160: 
161:         // 对传入的角色数组和查询结果进行排序，以便后续比较。
162:         sort($role);
163:         sort($rest);
164: 
165:         // 比较排序后的角色数组和查询结果数组是否完全相同。
166:         // 使用sort函数的返回值进行比较，如果相同则返回true，否则返回false。
167:         return (sort($role) == sort($rest)) ?  true: false;
168:     }
169: }
