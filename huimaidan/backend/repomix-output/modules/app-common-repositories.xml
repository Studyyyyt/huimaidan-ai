1287:      * 如果系统配置的保证金提醒开关未开启，则直接返回true。
1288:      * 否则，将查找保证金低于设定值的商家，并根据提醒时间进行状态调整，如果商家未设置提醒时间或提醒时间已过，则将商家状态设为0。
1289:      */
1290:     public function changeMerchantStatus()
1291:     {
1292:         // 检查系统配置的保证金提醒开关，如果未开启，则不执行任何操作直接返回true
1293:         if (systemConfig('margin_remind_switch') !== '1') return true;
1294: 
1295:         // 获取系统配置的保证金提醒天数，如果未配置则默认为0
1296:         $day = systemConfig('margin_remind_day') ?: 0;
1297: 
1298:         // 查询保证金低于10的商家，并且其上次保证金提醒时间在当前时间之后的记录
1299:         $data = $this->dao->search(['margin' => 10])->whereRaw('ot_margin > margin')->select();
1300: 
1301:         // 遍历查询结果，对每个商家进行状态检查和调整
1302:         foreach ($data as $datum) {
1303:             // 如果商家未设置过保证金提醒时间
1304:             if (is_null($datum->margin_remind_time)) {
1305:                 // 如果设置了提醒天数，则计算提醒时间，并设置商家的margin_remind_time
1306:                 if($day) {
1307:                     $time = strtotime(date('Y-m-d 23:59:59',strtotime("+ $day day",time())));
1308:                     $this->margin_remind_time = $time;
1309:                 } else {
1310:                     // 如果未设置提醒天数，则直接将商家状态设为0
1311:                     $this->status = 0;
1312:                 }
1313:             } else {
1314:                 // 如果商家已设置过保证金提醒时间，并且提醒时间已过，则将商家状态设为0，并将该商家状态调整的任务加入队列
