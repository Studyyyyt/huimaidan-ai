 447:     /**
 448:      * 发送优惠券
 449:      *
 450:      * 该方法用于在系统中发送优惠券给指定用户。它首先触发一个'before'事件，允许任何监听此事件的代码在优惠券发送前执行操作。
 451:      * 然后，在一个数据库事务中，执行发送优惠券的准备工作，包括校验和更新优惠券状态，并实际发行优惠券给用户。
 452:      * 如果优惠券是有限制的，还会更新优惠券的剩余数量。发送完成后，触发相应的发送事件，以便监听此事件的代码可以执行后续操作。
 453:      *
 454:      * @param StoreCoupon $coupon 优惠券对象，包含要发送的优惠券的信息
 455:      * @param int $uid 接收优惠券的用户ID
 456:      * @param string $type 优惠券发送的类型，用于区分不同的发送场景
 457:      */
 458:     public function sendCoupon(StoreCoupon $coupon, $uid, $type)
 459:     {
 460:         // 触发发送优惠券前的事件，允许执行任何前置操作
 461:         event('user.coupon.send.before', compact('coupon', 'uid', 'type'));
 462: 
 463:         // 使用数据库事务确保发送过程的原子性
 464:         Db::transaction(function () use ($uid, $type, $coupon) {
 465:             // 执行发送优惠券前的准备工作
 466:             $this->preSendCoupon($coupon, $uid, $type);
 467:             // 发行优惠券给指定用户
 468:             app()->make(StoreCouponIssueUserRepository::class)->issue($coupon['coupon_id'], $uid);
 469: 
 470:             // 如果优惠券有限制次数，则更新优惠券的剩余数量
 471:             if ($coupon->is_limited) {
 472:                 $coupon->remain_count--;
 473:                 $coupon->save();
 474:             }
 475:         });
 476: 
 477:         // 触发发送优惠券的事件，允许执行任何后续操作
 478:         event('user.coupon.send', compact('coupon', 'uid', 'type'));
 479:         // 触发特定类型的发送优惠券事件，提供更细粒度的事件订阅
 480:         event('user.coupon.send.' . $type, compact('coupon', 'uid', 'type'));
 481:     }
