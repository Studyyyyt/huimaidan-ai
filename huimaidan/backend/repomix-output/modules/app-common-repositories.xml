 779:      * @param array $data 创建优惠券所需的数据，包含优惠券类型、产品ID、分类ID等
 780:      * @throws ValidateException 当未选择产品、分类或商户时抛出异常
 781:      */
 782:     public function create($data)
 783:     {
 784:         // 如果设置了总数量，则计算剩余数量
 785:         if (isset($data['total_count'])) {
 786:             $data['remain_count'] = $data['total_count'];
 787:         }
 788: 
 789:         // 优惠券产品类型，默认为0（表示普通商品）
 790:         $productType = 0;
 791:         // 产品ID数组
