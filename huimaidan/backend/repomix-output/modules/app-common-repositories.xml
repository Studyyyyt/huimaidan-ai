400:                         'platform_coupon_price' => 0,
401:                         'product_sku' => $cart['productAttr']['unique'],
402:                         'product_num' => $cart['cart_num'],
403:                         'refund_num' => $cart['cart_num'],
404:                         'integral_price' =>  0,
405:                         'integral' => $cart['integral'] ,
406:                         'integral_total' => $cart['integral'] ,
407:                         'product_type' => $cart['product_type'],
408:                         'cart_info' => json_encode($order_cart)
