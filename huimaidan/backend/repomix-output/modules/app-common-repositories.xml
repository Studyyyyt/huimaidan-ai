1052:      * 该方法用于处理商户保证金的扣除操作。它首先验证商户是否已支付保证金，然后确保扣除金额不小于0，
1053:      * 并检查是否有足够的保证金可供扣除。如果所有验证都通过，则更新商户的保证金余额，并记录操作。
1054:      *
1055:      * @param array $data 包含商户ID、要扣除的保证金数额、操作标记等信息的数据数组
1056:      * @throws ValidateException 如果商户未支付保证金、扣除金额小于0或保证金不足，则抛出验证异常
1057:      */
1058:     public function setMargin($data)
1059:     {
1060:         // 根据商户ID获取商户信息
1061:         $merechant = $this->dao->get($data['mer_id']);
1062: 
1063:         // 检查商户是否已支付保证金，如果不是则抛出异常
1064:         if ($merechant->is_margin !== 10) {
1065:             throw new ValidateException('商户未支付保证金或已申请退款');
1066:         }
1067: 
1068:         // 确保要扣除的保证金数额不小于0，小于0则抛出异常
1069:         if ($data['number'] < 0) {
1070:             throw new ValidateException('扣除保证金额不能小于0');
1071:         }
1072: 
1073:         // 检查商户现有的保证金是否足够扣除，不足则抛出异常
1074:         if (bccomp($merechant->margin, $data['number'], 2) == -1) {
1075:             throw new ValidateException('扣除保证金额不足');
1076:         }
1077: 
1078:         // 计算扣除保证金后的余额
1079:         $data['balance'] = bcsub($merechant->margin, $data['number'], 2);
1080: 
1081:         // 为操作标记添加操作者信息
1082:         $data['mark'] =  $data['mark'].'【 操作者：'. request()->adminId().'/'.request()->adminInfo()->real_name .'】';
1083: 
1084:         // 实例化用户账单仓库
1085:         $userBillRepository = app()->make(UserBillRepository::class);
1086: 
1087:         // 使用事务处理来确保数据库操作的一致性
1088:         Db::transaction(function () use ($merechant, $data,$userBillRepository) {
1089:             // 更新商户的保证金余额
1090:             $merechant->margin = $data['balance'];
1091: 
1092:             // 根据系统配置，更新商户的保证金提醒时间或状态
1093:             if (systemConfig('margin_remind_switch') == 1) {
1094:                 $day = systemConfig('margin_remind_day') ?: 0;
1095:                 if($day) {
1096:                     $time = strtotime(date('Y-m-d 23:59:59',strtotime("+ $day day",time())));
1097:                     $merechant->margin_remind_time = $time;
1098:                 } else {
1099:                     $merechant->status = 0;
1100:                 }
1101:             }
1102: 
1103:             // 保存商户信息
1104:             $merechant->save();
1105: 
1106:             // 记录保证金操作的账单
1107:             $userBillRepository->bill(0, 'mer_margin', $data['type'], 0, $data);
1108:         });
1109:     }
