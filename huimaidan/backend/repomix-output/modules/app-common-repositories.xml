 29:  * @day 2020-05-14
 30:  * @mixin  StoreCouponUserDao
 31:  */
 32: class StoreCouponUserRepository extends BaseRepository
 33: {
 34: 
 35:     //获取方式(receive:自己领取 send:后台发送  give:满赠  new:新人 buy:买赠送)
 36:     const SEND_TYPE_BUY = 'buy';
 37:     const SEND_TYPE_RECEIVE = 'receive';
 38:     const SEND_TYPE_SEND = 'send';
 39:     const SEND_TYPE_GIVE = 'give';
 40:     const SEND_TYPE_NEW = 'new';
 41:     /**
 42:      * @var StoreCouponUserDao
 43:      */
 44:     protected $dao;
 45: 
 46:     /**
 47:      * StoreCouponUserRepository constructor.
 48:      * @param StoreCouponUserDao $dao
 49:      */
 50:     public function __construct(StoreCouponUserDao $dao)
 51:     {
 52:         $this->dao = $dao;
 53:     }
 54: 
 55:     /**
 56:      * 获取用户列表
 57:      *
 58:      * 根据给定的条件和分页信息，查询用户列表，并包含用户的优惠券和商户信息。
 59:      * 当页码为1时，执行特定的数据库操作（如标记优惠券为失效），以实现特定的业务逻辑。
 60:      *
 61:      * @param array $where 查询条件数组
 62:      * @param int $page 当前页码
 63:      * @param int $limit 每页记录数
 64:      * @return array 包含用户数量和用户列表的数组
 65:      */
 66:     public function userList(array $where, $page, $limit)
 67:     {
 68:         // 当页码为1时，执行特定数据库操作
 69:         if ($page == 1) {
 70:             $this->dao->failCoupon();
 71:         }
 72: 
 73:         // 根据条件查询用户
 74:         $query = $this->dao->search($where);
 75: 
 76:         // 统计查询到的用户总数
 77:         $count = $query->count();
 78: 
 79:         // 查询用户列表，同时加载每个用户的优惠券和商户信息
 80:         // 通过with方法加载关联数据，减少数据库查询次数，提高性能
 81:         $list = $query->with([
 82:             'coupon' => function ($query) {
 83:                 // 加载用户的优惠券信息，只包含指定字段
 84:                 $query->field('coupon_id,type,send_type');
 85:             },
 86:             'merchant' => function ($query) {
 87:                 // 加载用户的商户信息，只包含指定字段
 88:                 $query->field('mer_id,mer_name,mer_avatar');
 89:             },
 90:         ])->page($page, $limit)->select();
 91: 
 92:         // 返回用户总数和用户列表
 93:         return compact('count', 'list');
 94:     }
 95: 
 96:     /**
 97:      * 根据条件获取优惠券列表
 98:      *
 99:      * 本函数用于根据给定的条件和分页信息，从数据库中检索优惠券列表。它包括与优惠券相关的用户、优惠券本身和商家信息。
100:      * 如果请求的是第一页，则会触发一个失败的优惠券操作，这可能是为了处理特定的业务逻辑。
101:      *
102:      * @param array $where 搜索条件数组
103:      * @param int $page 当前页码
104:      * @param int $limit 每页记录数
105:      * @return array 包含记录总数和记录列表的数组
106:      */
107:     public function getList(array $where, $page, $limit)
108:     {
109:         // 如果是第一页，则执行failCoupon方法
110:         if ($page == 1) {
111:             $this->dao->failCoupon();
112:         }
113: 
114:         // 构建查询，包括关联的用户、优惠券和商家信息，只选取需要的字段
115:         $query = $this->dao->search($where)->with([
116:             'user' => function ($query) {
117:                 $query->field('avatar,uid,nickname,user_type');
118:             },
119:             'coupon' => function ($query) {
120:                  $query->field('coupon_id,type');
121:             },
122:             'merchant' => function ($query) {
123:                 $query->field('mer_id,mer_name,mer_state,mer_avatar,is_trader,type_id');
124:             }
125:         ]);
126: 
127:         // 计算满足条件的总记录数
128:         $count = $query->count();
129: 
130:         // 获取当前页的记录列表
131:         $list = $query->page($page, $limit)->select();
132: 
133:         // 返回记录总数和记录列表的数组
134:         return compact('count', 'list');
135:     }
136: 
137:     const PLATFORM_TYPES = [10,11,12];
138:     /**
139:      * 获取用户优惠券
140:      * 标记优惠券失效情况
141:      *
142:      * @param integer $uid
143:      * @param integer $merId
144:      * @param array $cartIds
145:      * @return void
146:      */
147:     public function validCoupon($userCoupons, $useCoupon, $cartInfo, $cartTotalPrice, $merId)
148:     {
149:         if(empty($cartInfo)) {
150:             return $userCoupons;
151:         }
152:         $checkedTypes = [];
153:         $failCoupons = [];
154:         // 筛选优惠券,并标记失效优惠券
155:         foreach ($userCoupons as &$userCoupon) {
156:             $userCoupon['disabled'] = false;
157:             if(empty($useCoupon) && $cartTotalPrice == 0) {
158:                 $userCoupon['disabled'] = true;
159:             }
160:             $coupon = $userCoupon['coupon'];
161:             // 总金额为0时，取勾选的券type
162:             if($cartTotalPrice == 0 && isset($userCoupon['checked']) && $userCoupon['checked'] == true) {
163:                 $checkedTypes[] = in_array($coupon['type'], self::PLATFORM_TYPES) ? 3 : $coupon['type'];
164:             }
165:             // 状态
166:             if($coupon['status'] !== 1) {
167:                 $userCoupon['disabled'] = true;
168:             }
169:             // 是否删除
170:             if($coupon['is_del'] !== 0) {
171:                 $userCoupon['disabled'] = true;
172:             }
173:             // 是否到门槛
174:             if($coupon['use_min_price'] > 0 && $cartTotalPrice < $coupon['use_min_price']) {
175:                 $userCoupon['disabled'] = true;
176:             }
177:             // 平台券
178:             if($coupon['mer_id'] == 0 ){
179:                 // 品类券：获取购物车列表中的所有商品的品类，判断该券支持的品类是否在所有商品品类列表中，不在则标记失效
180:                 if($coupon['type'] == 11) {
181:                     if(!$this->isUsableCategoryCoupon($cartInfo, $userCoupon)) {
182:                         $userCoupon['disabled'] = true;
183:                     }
184:                 }
185:                 // 跨店券：获取该券支持的商户ids，判断该商户id是否在当前商户ids里，不在则标记失效
186:                 if($coupon['type'] == 12) {
187:                     $meryIds = array_column($userCoupon['product'], 'product_id');
188:                     if(!in_array($merId, $meryIds)) {
189:                         $userCoupon['disabled'] = true;
190:                     }
191:                 }
192:             }
193:             // 商户券
194:             if($coupon['mer_id'] !== 0){
195:                 // 商品券
196:                 if($coupon['type'] == 1) {
197:                     $productIds = array_column($userCoupon['product'], 'product_id');
198:                     $cartProductIds = array_column(array_column($cartInfo, 'product'), 'product_id');
199:                     // 对比两个数组，找出两个数组的交集，如果交集为空，则说明购物车里没有该券支持的商品，则标记失效
200:                     if(empty(array_intersect($productIds, $cartProductIds))) {
201:                         $userCoupon['disabled'] = true;
202:                     }
203:                 }
204:             }
205:         }
206:         // 总金额为0时，将未勾选的其他类别券标记失效
207:         foreach($userCoupons as $key => &$value) {
208:             $coupon = $value['coupon'];
209:             if(isset($value['checked']) && $value['checked'] == true) {
210:                 continue;
211:             }
212: 
213:             $type = in_array($coupon['type'], self::PLATFORM_TYPES) ? 3 : $coupon['type'];
214:             if($cartTotalPrice == 0 && !in_array($type, $checkedTypes)) {
215:                 $value['disabled'] = true;
216:             }
217:             // 取出失效的优惠券，放到另外一个数组里
218:             if($value['disabled']) {
219:                 $failCoupons[] = $value;
220:                 unset($userCoupons[$key]);
221:             }
222:         }
223: 
224:         // 合并数组，将失效优惠券的放到后边返回
225:         return array_merge($userCoupons, $failCoupons);
226:     }
227:     /**
228:      * 是否为可用的品类优惠券
229:      *
230:      * @return boolean
231:      */
232:     public function isUsableCategoryCoupon($cartInfo, $userCoupon)
233:     {
234:         // 优惠券支持的品类id列表
235:         $cartgoryIds = array_column($userCoupon['product'], 'product_id');
236:         // 购物车里商品的品类id列表
237:         $productCartgoryIds = array_column(array_column($cartInfo, 'product'), 'cate_id');
238:         // 取出购物车商品品类ID的所有父级id列表
239:         $cateIds = [];
240:         $cates = array_column(array_column(array_column($cartInfo, 'product'), 'storeCategory'), 'path');
241:         foreach($cates as $cate) {
242:             $tmp = explode('/', trim($cate, '/'));
243:             $cateIds = array_merge($cateIds, $tmp);
244:         }
245:         // 合并品类id列表，去除重复的id
246:         $cateIds = array_unique(array_merge($cateIds, $productCartgoryIds));
247:         // 对比两个数组，找出两个数组的交集，如果交集为空，则说明购物车里没有该券支持的商品，则要标记失效，返回false
248:         if(empty(array_intersect($cartgoryIds, $cateIds))) {
249:             return false;
250:         }
251: 
252:         return true;
253:     }
254: }
