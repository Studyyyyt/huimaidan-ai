 29:     public function __construct(SystemNoticeDao $dao)
 30:     {
 31:         $this->dao = $dao;
 32:     }
 33: 
 34:     /**
 35:      * 创建通知
 36:      * 根据传入的数据和管理员ID，创建相应的通知，并根据不同的条件筛选商户，将通知与商户关联。
 37:      *
 38:      * @param array $data 包含通知信息和筛选条件的数据数组
 39:      * @param int $admin_id 管理员ID，用于标识通知的创建者
 40:      * @return object 创建的通知对象
 41:      * @throws ValidateException 如果商户类型错误或没有有效的商户信息，则抛出验证异常
 42:      */
 43:     public function create(array $data, $admin_id)
 44:     {
 45:         // 为通知数据添加管理员ID
 46:         $data['admin_id'] = $admin_id;
 47:         // 根据不同的商户类型，筛选商户ID并生成相应的type_str
 48:         $ids = $this->merchantIds($data);
 49:         // 在事务中执行通知的创建和商户通知关联的插入
 50:         return Db::transaction(function () use ($data, $ids) {
 51:             // 创建通知
 52:             $notice = $this->dao->create($data);
 53:             // 获取系统通知日志仓库实例
 54:             $systemNoticeLogRepository = app()->make(SystemNoticeLogRepository::class);
 55:             // 准备商户通知关联的插入数据
 56:             $inserts = [];
 57:             foreach ($ids as $id) {
 58:                 if (!$id) continue;
 59:                 $inserts[] = [
 60:                     'mer_id' => (int)$id,
 61:                     'notice_id' => $notice->notice_id
 62:                 ];
 63:             }
 64:             // 批量插入商户通知关联数据
 65:             $systemNoticeLogRepository->insertAll($inserts);
 66:             // 返回创建的通知对象
 67:             return $notice;
 68:         });
 69:     }
 70:     /**
 71:      * 更新通知
 72:      *
 73:      * 根据提供的ID、数据和管理员ID，更新数据库中的通知记录。
 74:      * 该方法用于处理通知的编辑操作，确保只有授权的管理员才能更新通知。
 75:      *
 76:      * @param integer $noticeId 要更新的通知记录的ID。
 77:      * @param array $data 包含更新数据的关联数组，键为字段名，值为新的字段值。
 78:      * @param int $admin_id 执行更新操作的管理员ID，用于验证权限。
 79:      * @return void 无返回值，直接更新数据库记录。
 80:      */
 81:     public function update(int $noticeId, array $data, int $admin_id)
 82:     {
 83:         // 为通知数据添加管理员ID
 84:         $data['admin_id'] = $admin_id;
 85:         // 根据不同的商户类型，筛选商户ID并生成相应的type_str
 86:         $ids = $this->merchantIds($data);
 87:         // 在事务中执行通知的创建和商户通知关联的插入
 88:         return Db::transaction(function () use ($noticeId, $data, $ids) {
 89:             // 更新通知
 90:             $this->dao->update($noticeId, $data);
 91:             // 获取系统通知日志仓库实例
 92:             $systemNoticeLogRepository = app()->make(SystemNoticeLogRepository::class);
 93:             // 删除旧的商户通知关联记录
 94:             $systemNoticeLogRepository->getSearch(['notice_id' => $noticeId])->delete();
 95:             // 准备新的商户通知关联数据
 96:             $inserts = [];
 97:             foreach ($ids as $id) {
 98:                 if (!$id) continue;
 99:                 $inserts[] = [
100:                     'mer_id' => (int)$id,
101:                     'notice_id' => $noticeId
102:                 ];
