 33:     /**
 34:      * 根据条件获取列表数据
 35:      *
 36:      * 本函数用于根据给定的条件数组$where，从数据库中检索满足条件的数据列表。
 37:      * 它支持分页查询，每页的数据数量由$limit参数指定，查询的页码由$page参数指定。
 38:      * 查询结果包括满足条件的数据总数$count和实际返回的数据列表$list。
 39:      *
 40:      * @param array $where 查询条件数组
 41:      * @param int $page 查询的页码
 42:      * @param int $limit 每页的数据数量
 43:      * @return array 包含数据总数和数据列表的数组
 44:      */
 45:     public function getList(array $where, int $page, int $limit)
 46:     {
 47:         // 初始化查询，根据$where条件搜索，并加载关联的product信息，但只获取指定的字段
 48:         $query = $this->dao->search($where)->with([
 49:             'product' => function($query){
 50:                 $query->field('product_id,mer_id,store_name,image');
 51:             }
