 97:     /**
 98:      * 根据配置信息获取组件实例
 99:      *
100:      * 该方法根据传入的配置信息和商家ID，动态生成并返回相应的组件实例。
101:      * 支持的组件类型包括图片、图片组、文件上传、下拉选择、复选框、单选框、开关等。
102:      * 对于不同的组件类型，会根据配置规则设置相应的属性和选项。
103:      *
104:      * @param array $config 配置信息，包含组件的类型、键、名及其他配置项
105:      * @param int $merId 商家ID，用于判断是商家后台还是管理员后台的配置
106:      * @return \think\component\Elm 组件实例
107:      */
108:     public function getComponent($config, $merId)
109:     {
110:         // 根据配置的类型动态处理
111:         switch ($config['config_type']) {
112:             case 'image':
113:                 // 创建图片组件，设置图片地址和一些属性
114:                 $component = Elm::frameImage($config['config_key'], $config['config_name'], '/' . config('admin.' . ($merId ? 'merchant' : 'admin') . '_prefix') . '/setting/uploadPicture?field=' . $config['config_key'] . '&type=1')->icon('el-icon-camera')->modal(['modal' => false])->width('1000px')->height('600px')->props(['footer' => false]);
115:                 break;
116:             case 'images':
117:                 // 创建图片组组件，设置图片地址和一些属性
118:                 $component = Elm::frameImage($config['config_key'], $config['config_name'], '/' . config('admin.' . ($merId ? 'merchant' : 'admin') . '_prefix') . '/setting/uploadPicture?field=' . $config['config_key'] . '&type=2')->maxLength(5)->icon('el-icon-camera')->modal(['modal' => false])->width('1000px')->height('600px')->props(['footer' => false]);
119:                 break;
120:             case 'file':
121:                 // 创建文件上传组件，设置上传地址和头部令牌
122:                 $component = Elm::uploadFile($config['config_key'], $config['config_name'], rtrim(systemConfig('site_url'), '/') . Route::buildUrl('configUpload', ['field' => 'file'])->build())->headers(['X-Token' => request()->token()]);
123:                 break;
124:             case 'select':
125:             case 'checkbox':
126:                 // 处理下拉选择和复选框，根据配置规则生成选项
127:                 $options = array_map(function ($val) {
128:                     [$value, $label] = explode(':', $val, 2);
129:                     return compact('value', 'label');
130:                 }, explode("\n", $config['config_rule']));
131:                 $component = Elm::{$config['config_type']}($config['config_key'], $config['config_name'])->options($options);
132:                 break;
133:             case 'radio':
134:                 // 处理单选框，包括联动效果
135:                 $options = array_map(function ($val) {
136:                     [$value, $label] = explode(':', $val, 2);
137:                     return compact('value', 'label');
138:                 }, explode("\n", $config['config_rule']));
139:                 $component = Elm::{$config['config_type']}($config['config_key'], $config['config_name'])->options($options);
140:                 //处理联动显示
141:                 $controls = $this->dao->search([])->where('linked_status', 1)->where('linked_id', $config['config_id'])->column('config_id,config_key,linked_value');
142:                 $restructuredArray = [];
143:                 foreach ($controls as $c) {
144:                     $restructuredArray[$c['linked_value']][] = $c['config_key'];
145:                 }
146:                 $restructuredArray = array_map(function($k, $v) {
147:                     return ['value' => (string) $k, 'rule' => $v];
148:                 }, array_keys($restructuredArray), $restructuredArray);
149:                 if (!empty($restructuredArray)) {
150:                     $component->control($restructuredArray);
151:                 }
152:                 break;
153:             case 'switches':
154:                 // 创建开关组件，并处理联动效果
155:                 $component = Elm::{$config['config_type']}($config['config_key'], $config['config_name'])->className('switch-width-double')->activeText('开启')->inactiveText('关闭');
156: 
157:                 //处理联动显示
158:                 $controls = $this->dao->search([])->where('linked_status', 1)->where('linked_id', $config['config_id'])->column('config_id,config_key,linked_value');
159:                 $restructuredArray = [];
160:                 foreach ($controls as $c) {
161:                     $restructuredArray[$c['linked_value']][] = $c['config_key'];
162:                 }
163:                 $restructuredArray = array_map(function($k, $v) {
164:                     return ['value' => (string) $k, 'rule' => $v];
165:                 }, array_keys($restructuredArray), $restructuredArray);
166:                 if (!empty($restructuredArray)) {
167:                     $component->control($restructuredArray);
168:                 }
169:                 break;
170:             default:
171:                 // 默认情况下，直接创建对应类型的组件
172:                 $component = Elm::{$config['config_type']}($config['config_key'], $config['config_name']);
173:                 break;
174:         }
175:         // 设置组件的必填属性
176:         if ($config['required']) $component->required();
177:         // 处理额外的配置属性
178:         if ($config['config_props'] ?? '') {
179:             $props = @parse_ini_string($config['config_props'], false, INI_SCANNER_TYPED);
180:             if (is_array($props)) {
181:                 $guidance_uri = $props['guidance_uri'] ?? '';
182:                 $guidance_image = $props['guidance_image'] ?? '';
183:                 if ($guidance_image) {
184:                     $config['guidance'] = [
185:                         'uri' => $guidance_uri,
186:                         'image' => $guidance_image,
187:                     ];
188:                 }
189:                 if (isset($props['required']) && $props['required']) {
190:                     $component->required();
191:                 }
192:                 if (isset($props['defaultValue'])) {
193:                     $component->value($props['defaultValue']);
194:                 }
195:                 unset($props['guidance_image'], $props['guidance_uri']);
196:                 $component->props($props);
197:             }
198:         }
199:         // 添加额外的规则信息，如帮助信息
200:         if ($config['info']) {
201:             $component->appendRule('suffix', [
202:                 'type' => 'guidancePop',
203:                 'props' => [
204:                     'info' => $config['info'],
205:                     'url' => $config['guidance']['uri'] ?? '',
206:                     'image' => $config['guidance']['image'] ?? '',
207:                 ]
208:             ]);
209:         }
210:         return $component;
211:     }
