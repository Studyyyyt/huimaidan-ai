141: 
142:     /**
143:      * 创建活动商品 的活动关联氛围图等
144:      * @param $data 主要信息
145:      * @param $type 商品类型
146:      * @return mixed
147:      * @author Qinii
148:      * @day 2024/4/15
149:      */
150:     public function saveByType(array $data, int $type)
151:     {
152:         $createData = [
153:             'activity_name' => $data['activity_name'],
154:             'start_time' => $data['start_time'],
155:             'end_time' => $data['end_time'],
156:             'pic' => $data['pic'],
157:             'link_id' => $data['link_id'],
158:             'activity_type' => $data['activity_type'],
159:         ];
160:         if (!in_array($data['activity_type'], [self::ACTIVITY_TYPE_ATMOSPHERE,self::ACTIVITY_TYPE_BORDER]))
161:             throw new ValidateException('活动类型错误');
162:         if (!in_array($type, $this->activeProductType))
163:             throw new ValidateException('请选择指定商品');
164:         if (count(array_filter($createData ?? [])) < 6)
165:             throw new ValidateException('缺少必传参数');
166:         $scope_type = $this->getActiveScopeType($type);
167:         $res = $this->getSearch(['activity_type' => $createData['activity_type']])
168:             ->where(['scope_type' => $scope_type, 'link_id' => $createData['link_id'],])->find();
169: 
170:         try {
171:             if ($res) {
172:                 $this->dao->update($res->activity_id,$createData);
173:             } else {
174:                 $createData['scope_type'] = $scope_type;
175:                 $createData['status'] = strtotime($createData['start_time']) <= time() ? 1 : 0;
176:                 $createData['sort'] = 999;
177:                 $createData['is_display'] = 0;
178:                 $createData['is_show'] = 1;
179:                 $this->createActivity($createData);
180:             }
181:             return true;
182:         }catch (Exception $e) {
183:             throw new ValidateException($e->getMessage());
184:         }
185:     }
186: 
187:     /**
188:      *  创建活动
189:      * @param data['activity_name'] 名称
190:      * @param data['start_time'] 开始时间
191:      * @param data['end_time'] 结束时间
192:      * @param data['pic'] 活动图片
193:      * @param data['is_show'] 是否显示
194:      * @param data['status'] 是否在活动中
195:      * @param data['sort'] 排序
196:      * @param data['activity_type'] 活动类型
197:      * @param data['is_display'] 是否展示活动
198:      * @param data['link_id'] 关联ID
199:      * @param array $data
200:      * @param $extend
201:      * @param $func
202:      * @author Qinii
203:      * @day 2023/10/13
204:      */
205:     public function createActivity(array $data, $extend = null, $func = null)
206:     {
207:         $paramsData =  $extend ? $this->getParams($data, $extend) : [];
208:         return Db::transaction(function () use ($data, $extend, $func, $paramsData) {
209:             $createData = $this->dao->create($data);
210:             if (isset($paramsData['ids']) && !empty($paramsData['ids']))
211:                 app()->make(RelevanceRepository::class)->createMany($createData->activity_id, $paramsData['ids'], $paramsData['type']);
212:             if ($func && function_exists($func)) $this->$func($createData, $extend);
213:         });
214:     }
215: 
216:     /**
217:      * 整理关联参数
218:      * @param $data
219:      * @param $extend
220:      * @return array
221:      * @author Qinii
222:      * @day 2023/10/13
223:      */
224:     public function getParams($data, $extend)
225:     {
226:         if (!$extend) return [];
227:         $res = [];
228:         $type = '';
229:         switch ($data['scope_type']) {
230:             case self::TYPE_ALL;
231:                 break;
232:             case self::TYPE_MUST_PRODUCT:
233:                 if (!isset($extend['spu_ids']) || empty($extend['spu_ids']))
234:                     throw new ValidateException('请选择指定商品');
235:                 $res = app()->make(SpuRepository::class)->getSearch(['spu_ids' => $extend['spu_ids'], 'status' => 1])->column('spu_id');
236:                 $type = RelevanceRepository::SCOPE_TYPE_PRODUCT;
237:                 break;
238:             case self::TYPE_MUST_CATEGORY:
239:                 if (!isset($extend['cate_ids']) || empty($extend['cate_ids']))
240:                     throw new ValidateException('请选择指定商品分类');
241:                 $res = app()->make(StoreCategoryRepository::class)->getSearch(['ids' => $extend['cate_ids'], 'status' => 1])->column('store_category_id');
242:                 $type = RelevanceRepository::SCOPE_TYPE_CATEGORY;
243:                 break;
244:             case self::TYPE_MUST_STORE:
245:                 if (!isset($extend['mer_ids']) || empty($extend['mer_ids']))
246:                     throw new ValidateException('请选择指定商户');
247:                 $res = app()->make(MerchantRepository::class)->getSearch(['mer_ids' => $extend['mer_ids']])->column('mer_id');
248:                 $type = RelevanceRepository::SCOPE_TYPE_STORE;
249:                 break;
250:             case self::TYPE_MUST_PRODUCT_LABEL:
251:                 if (!isset($extend['label_ids']) || empty($extend['label_ids']))
252:                     throw new ValidateException('请选择指定商品标签');
253:                 $res = app()->make(ProductLabelRepository::class)->getSearch(['product_label_id' => $extend['label_ids']])->column('product_label_id');
254:                 $type = RelevanceRepository::SCOPE_TYPE_PRODUCT_LABEL;
255:                 break;
256:             default:
257:                 throw new ValidateException('缺少活动类型');
258:                 break;
259:         }
260:         $ids = array_unique($res);
261:         return compact('ids', 'type');
262:     }
263: 
264:     /**
265:      * 更新活动信息，并处理相关的扩展数据。
266:      *
267:      * 本函数用于更新指定ID的活动数据，并根据传入的扩展数据进行相关的关联操作。
268:      * 如有需要，还可以执行额外的自定义函数。
269:      *
270:      * @param int $id 活动的唯一标识ID。
271:      * @param array $data 需要更新的活动数据数组。
272:      * @param mixed $extend 扩展数据，可以是数组或者null，用于更新关联数据。
273:      * @param callable|null $func 自定义函数，如果传入则会在更新完成后调用。
274:      */
275:     public function updateActivity(int $id, array $data, $extend = null, $func = null)
276:     {
277:         // 获取参数数据，包括直接传入的数据和扩展数据。
278:         $paramsData = $this->getParams($data, $extend);
279: 
280:         // 使用数据库事务来确保更新操作的原子性。
281:         Db::transaction(function () use ($id, $data, $extend, $func, $paramsData) {
282:             // 清除旧的关联数据。
283:             $info = $this->dao->getSearch([$this->dao->getPk() => $id])->find()->toArray();
284:             app()->make(RelevanceRepository::class)->clear($id, $this->typeData[$info['scope_type']], 'left_id');
285:             // 更新活动的基本信息。
286:             $createData = $this->dao->update($id, $data);
287: 
288:             // 如果有扩展参数数据，则处理关联数据。
289:             if (!empty($paramsData)) {
290:                 // 清除旧的关联数据。
291:                 app()->make(RelevanceRepository::class)->clear($id, $paramsData['type'], 'left_id');
292: 
293:                 // 根据新的关联ID创建新的关联数据。
294:                 if (isset($paramsData['ids']) && !empty($paramsData['ids'])) {
295:                     app()->make(RelevanceRepository::class)->createMany($id, $paramsData['ids'], $paramsData['type']);
296:                 }
297:             }
298: 
299:             // 如果传入了自定义函数，并且该函数存在，则调用它。
300:             if ($func && function_exists($func)) {
301:                 $this->$func($createData, $extend);
302:             }
303:         });
304:     }
