1549:     protected function validateCartBasic($data, $res)
1550:     {
1551:         // 购物车所有商户的信息
1552:         if (count($data['product_type']) > 1)throw new ValidateException('存在多类型商品');
1553:         if (count($data['is_pays']) > 1 || $data['is_pays'][0] == 1) throw new ValidateException('存在已购买商品请重新添加购物车');
1554: 
1555:         $order_type = $data['product_type'][0];
1556:         $mer_form_id = 0;
1557:         $order_model = 0;
1558:         $productNum = $data['productNum'];
1559: 
1560:         $storeOrderRepository = app()->make(StoreOrderRepository::class);
1561:         foreach ($res as $k => $cart) {
1562:             if (!$cart['checkCartProduct']) $this->returnFail($cart);
1563:             if ($cart['is_pay'])throw new ValidateException('存在以支付购物车信息');
1564:             if ($cart['cart_num'] <= 0) throw new ValidateException('购买商品数必须大于0');
1565:             if (!$mer_form_id) $mer_form_id = $cart['product']['mer_form_id'];
1566:             if (!$order_model) $order_model = $cart['product']['type'];
1567:             if ($mer_form_id && $k) throw new ValidateException('存在表单信息商品，请单独购买');
1568:             if ($order_model && $k) throw new ValidateException('虚拟商品必须单独购买');
1569:             if ($order_model == 4 && !$this->validateReservation($cart))
1570:                 throw new ValidateException('当前时间已经预约满了～');
1571:             if ($order_type == 0 ) {
1572:                 if ($cart['product']['pay_limit'] == 1) {
1573:                     if ($cart['product']['once_max_count'] < $cart['cart_num']) {
1574:                         throw new ValidateException('[超出单次限购数：' . $cart['product']['once_max_count'] . ']' . mb_substr($cart['product']['store_name'], 0, 10) . '...');
1575:                     }
1576:                 } else if ($cart['product']['pay_limit'] == 2) {
1577:                     $count = $productNum[$cart['product_id']];
1578:                     if ($count > $cart['product']['once_max_count']) {
1579:                         throw new ValidateException('[超出限购总数：' . $cart['product']['once_max_count'] . ']' . mb_substr($cart['product']['store_name'], 0, 10) . '...');
1580:                     }
1581:                     $pay_count = $storeOrderRepository->getMaxCountNumber($cart['uid'], $cart['product_id']);
1582:                     if (($count + $pay_count) > $cart['product']['once_max_count']) {
1583:                         throw new ValidateException('[超出限购总数：' . $cart['product']['once_max_count'] . ']' . mb_substr($cart['product']['store_name'], 0, 10) . '...');
1584:                     }
1585:                 } else {
1586:                     if ($cart['product']['once_min_count'] > 0 && $cart['product']['once_min_count'] > $cart['cart_num']) {
1587:                         throw new ValidateException('[低于起购数:' . $cart['product']['once_min_count'] . ']' . mb_substr($cart['product']['store_name'], 0, 10) . '...');
1588:                     }
1589:                 }
1590:             } else {
1591:                 if (($order_type != 10 && $k != 0) || (count($data['merIds']) != 1) ) {
1592:                     throw new ValidateException('活动商品必须单独购买');
1593:                 }
1594:             }
1595:         }
1596:         return [$order_type, $order_model, $mer_form_id];
1597:     }
