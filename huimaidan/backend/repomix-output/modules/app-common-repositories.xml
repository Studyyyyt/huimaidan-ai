239:     /**
240:      * 获取指定ID对应字段的键名列表
241:      *
242:      * 本函数通过查询特定ID的字段信息，然后提取出这些信息中的键名，最终返回一个包含所有键名的数组。
243:      * 这样做的目的是为了提供一种方式，以字段键名为基础，进行后续的数据处理或检索操作。
244:      *
245:      * @param int $id 需要查询的记录ID
246:      * @return array 返回包含所有字段键名的数组
247:      */
248:     public function keys(int $id): array
249:     {
250:         // 使用array_column函数从字段信息数组中提取出所有字段的键名
251:         return array_column($this->fields($id), 'field');
252:     }
