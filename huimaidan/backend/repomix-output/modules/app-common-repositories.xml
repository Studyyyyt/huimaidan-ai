 789:     /**
 790:      * 根据商家ID和类型检查商家的特定数量限制
 791:      *
 792:      * 本函数用于根据商家的ID和指定的类型，检查该商家在特定方面的数量限制。
 793:      * 这些类型包括复制产品和导出数据等，具体限制数量在商家的配置中设定。
 794:      *
 795:      * @param int $merId 商家的ID，用于查询商家的具体配置
 796:      * @param string $type 类型标识，用于确定检查哪方面的数量限制，如'copy'表示复制产品，'dump'表示导出数据
 797:      * @return int 返回对应类型的数量限制，如果未设置或不适用，则返回0
 798:      */
 799:     public function checkCrmebNum(int $merId, string $type)
 800:     {
 801:         // 通过商家ID查询商家信息
 802:         $merchant = $this->dao->get($merId);
 803:         $number = 0; // 初始化数量为0，用于在未设置或不适用的情况下返回
 804: 
 805:         // 根据类型进行不同的数量检查
 806:         switch ($type) {
 807:             case 'copy':
 808:                 // 如果系统配置允许复制产品，并且商家设置了复制产品数量，则返回商家的复制产品数量
 809:                 if (systemConfig('copy_product_status') && $merchant['copy_product_num'])
 810:                     $number = $merchant['copy_product_num'];
 811:                 break;
 812:             case 'dump':
 813:                 // 如果系统配置不允许导出数据，或者商家未设置导出数据数量，则返回商家的导出数据数量
 814:                 if (!systemConfig('crmeb_serve_dump') || !$merchant['export_dump_num'])
 815:                     $number = $merchant['export_dump_num'];
