215:             $count5 = $this->dao->search($where + ['filter_delivery' => 5])->count('*');
216: 
217:             return [
218:                 ['name' => '快递发货', 'value' => $count1,],
219:                 ['name' => '配送订单', 'value' => $count2,],
220:                 ['name' => '虚拟发货', 'value' => $count3,],
221:                 ['name' => '核销订单', 'value' => $count4,],
222:                 ['name' => '自动发货', 'value' => $count5,],
223:             ];
224:         }, self::CACHA_TIME);
225:     }
