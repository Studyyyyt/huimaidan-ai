662:     /**
663:      * 查询返回的状态整理
664:      * @param $data
665:      * @return array
666:      * @author Qinii
667:      * @day 6/23/21
668:      */
669:     public function getApplymentState($data)
670:     {
671:         //CHECKING：资料校验中
672:         //ACCOUNT_NEED_VERIFY：待账户验证
673:         //AUDITING：审核中
674:         //REJECTED：已驳回
675:         //NEED_SIGN：待签约
676:         //FINISH：完成
677:         //FROZEN：已冻结
678:         $result = [];
679:         $message = '';
680:         $status = 10;
681:         switch (($data['applyment_state']))
682:         {
683:             //申请状态: 0.平台未提交，-1.平台驳回，10.平台提交审核中，11.需用户操作 ，20.已完成，30.已冻结，40.驳回
684:             case 'ACCOUNT_NEED_VERIFY':
685:                 $status = 11;
686:                 if(isset($data['account_validation'])){
687:                     $ret = $data['account_validation'];
688:                     $message = '通过申请银行账号向以下信息汇款完成验证,'.PHP_EOL;
689:                     $message .= '收款方信息：'.PHP_EOL;
690:                     $message .= "汇款金额：".$ret['pay_amount'].'（单位：分）;'.PHP_EOL;
691:                     $message .= "收款卡号：".$ret['destination_account_number'].';'.PHP_EOL;
692:                     $message .= "收款户名：".$ret['destination_account_name'].';'.PHP_EOL;
693:                     $message .= "开户银行：".$ret['destination_account_bank'].';'.PHP_EOL;
694:                     $message .= "省市信息：".$ret['city'].';'.PHP_EOL;
695:                     $message .= "备注信息：".$ret['remark'].';'.PHP_EOL;
696:                     $message .= "汇款截止时间：".$ret['deadline'].'。';
697:                 }
698:                 if(isset($data['legal_validation_url'])){
699:                     $message = '商户法人通过此链接完成验证：'.$data['legal_validation_url'];
700:                 }
701:                 break;
702:             case 'REJECTED':
703:                 $message = '';
704:                 foreach ($data['audit_detail'] as $datum){
705:                     $message .= '参数名称:'.$datum['param_name'].PHP_EOL;
706:                     $message .= '驳回原因:'.$datum['reject_reason'].PHP_EOL;
707:                 }
708:                 $status = 40;
709:                 break;
710:             case 'NEED_SIGN':
711:                 $status = 11;
712:                 $message = $data['sign_url'];
713:                 break;
714:             case 'FINISH':
715:                 $result['sub_mchid'] = $data['sub_mchid'];
716:                 $status = 20;
717:                 $message = '完成';
718:                 break;
719:             case 'FROZEN':
720:                 $status = 30;
721:                 break;
722:             default:
723:                 break;
724:         }
725:         $result['status'] = $status;
726:         $result['message'] = $message;
727:         return $result;
728:     }
