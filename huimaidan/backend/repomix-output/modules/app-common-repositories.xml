135:     public  function filter_params($filter_params)
136:     {
137:         $productId = [];
138:         if (!empty($filter_params)) {
139:             if (!is_array($filter_params)) $filter_params = json_decode($filter_params,true);
140:             $value = [];
141:             foreach ($filter_params as $k => $v) {
142:                 $id[] = $k;
143:                 $value = array_merge($value,$v);
144:             }
145:             if (empty($id) || empty($value)) return false;
146:             $productData = $this->dao->getSearch([])->alias('P')
147:                 ->join('ParameterValue V','P.product_id = V.product_id')
148:                 ->whereIn('P.parameter_id',$id)->whereIn('P.value',$value)
149:                 ->whereIn('V.parameter_id',$id)->whereIn('V.value',$value)
150:                 ->group('P.product_id')
151:                 ->field('P.product_id')
152:                 ->select();
153:             if ($productData) {
154:                 $productData = $productData->toArray();
155:                 $productId = array_column($productData,'product_id');
156:             }
157:         }
