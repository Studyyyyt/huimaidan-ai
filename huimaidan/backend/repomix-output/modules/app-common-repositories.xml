357:     /**
358:      * 获取服务订单列表
359:      *
360:      * 根据给定的条件和分页参数，从数据库中检索服务订单列表。此方法专注于查询操作，不涉及数据的增删改。
361:      *
362:      * @param array $where 查询条件，允许通过数组传递多个条件。
363:      * @param int $page 当前页码，用于分页查询。
364:      * @param int $limit 每页的记录数，用于分页查询。
365:      * @return array 返回包含订单总数和订单列表的数组。
366:      */
367:     public function getList(array $where, int $page, int $limit)
368:     {
369:         // 默认不查询已删除的订单
370:         $where['is_del'] = 0;
371: 
372:         // 构建查询语句，包括关联查询和排序
373:         $query = $this->dao->search($where)
374:             ->with([
375:                 'merchant' => function($query){
376:                     // 关联查询商家信息，包括商家类型，并只选取需要的字段
377:                     $query->with(['merchantType']);
378:                     $query->field('mer_id,mer_name,is_trader,mer_avatar,type_id,mer_phone,mer_address,is_margin,margin,real_name,ot_margin');
379:                 }
380:             ])
381:             ->order('ServeOrder.create_time DESC');
382: 
383:         // 计算满足条件的订单总数
384:         $count = $query->count();
385: 
386:         // 分页查询满足条件的订单列表
387:         $list = $query->page($page, $limit)->select();
388: 
389:         // 将订单总数和订单列表打包成数组返回
390:         return compact('count', 'list');
391:     }
392: }
