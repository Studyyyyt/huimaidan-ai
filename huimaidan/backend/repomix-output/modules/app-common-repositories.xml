 25: /**
 26:  * Class UserRechargeRepository
 27:  * @package app\common\repositories\user
 28:  * @author xaboy
 29:  * @day 2020/6/2
 30:  * @mixin UserRechargeDao
 31:  */
 32: class UserRechargeRepository extends BaseRepository
 33: {
 34:     const TYPE_WECHAT = 'weixin';
 35:     const TYPE_ROUTINE = 'routine';
 36:     /**
 37:      * UserRechargeRepository constructor.
 38:      * @param UserRechargeDao $dao
 39:      */
 40:     public function __construct(UserRechargeDao $dao)
 41:     {
 42:         $this->dao = $dao;
 43:     }
 44: 
 45:     /**
 46:      * 创建充值订单
 47:      *
 48:      * 本函数用于生成一个新的充值订单。它根据传入的用户ID、充值金额、赠送金额和充值类型，
 49:      * 创建一个订单并返回订单数据。订单初始状态为未支付。
 50:      *
 51:      * @param int $uid 用户ID，用于关联订单和用户。
 52:      * @param float $price 充值金额，单位为元，精确到小数点后两位。
 53:      * @param float $givePrice 赠送金额，单位为元，精确到小数点后两位。
 54:      * @param string $type 充值类型，用于区分不同的充值方式，如：支付宝、微信等。
 55:      * @return array 返回新创建的订单数据。
 56:      */
 57:     public function create($uid, float $price, float $givePrice, string $type)
 58:     {
 59:         // 生成订单数据数组，包含用户ID、充值金额、赠送金额、充值类型、初始支付状态和订单ID。
 60:         $orderData = [
 61:             'uid' => $uid,
 62:             'price' => $price,
 63:             'give_price' => $givePrice,
 64:             'recharge_type' => $type,
 65:             'paid' => 0, // 订单初始支付状态为未支付。
 66:             'order_id' => $this->dao->createOrderId($uid) // 生成唯一的订单ID。
 67:         ];
 68: 
 69:         // 调用DAO层的方法创建订单，并返回创建的订单数据。
 70:         return $this->dao->create($orderData);
 71:     }
 72: 
 73:     /**
 74:      * 获取列表数据
 75:      * 通过此方法可以从数据库中检索满足特定条件的列表数据。它支持分页查询，以优化大型数据集的处理。
 76:      *
 77:      * @param string $where 查询条件，用于筛选数据。这是一个字符串，可能包含SQL的WHERE子句条件。
 78:      * @param int $page 当前页码，用于分页查询。
 79:      * @param int $limit 每页的数据条数，用于分页查询。
 80:      * @return array 返回一个包含两个元素的数组，'count'表示数据总数，'list'表示当前页的数据列表。
 81:      */
 82:     public function getList($where, $page, $limit)
 83:     {
 84:         // 构建查询语句，包括JOIN操作和排序规则
 85:         $query = $this->dao->searchJoinQuery($where)->order('a.pay_time DESC,a.create_time DESC');
 86: 
 87:         // 计算满足条件的数据总数
 88:         $count = $query->count();
 89: 
 90:         // 执行分页查询，并获取当前页的数据列表
 91:         $list = $query->page($page, $limit)->select();
 92: 
 93:         // 将数据总数和数据列表打包成数组返回
 94:         return compact('count', 'list');
 95:     }
 96: 
 97: 
 98: 
 99:     /**
100:      * 根据充值金额获取赠送金额。
101:      *
102:      * 本函数用于根据用户充值的金额，确定相应的赠送金额。系统预设了不同充值金额区间的赠送规则，
103:      * 本函数通过查询这些规则，找到适用的赠送金额。
104:      *
105:      * @param float $price 充值金额。
106:      * @return float 返回应赠送的金额。
107:      */
108:     public function priceByGive($price)
109:     {
110:         // 获取系统设置的充值额度和赠送额度规则
111:         $quota = systemGroupData('user_recharge_quota');
112:         $give = 0.0; // 初始化赠送金额为0
113: 
114:         // 遍历规则数组，找出适用的赠送规则
115:         foreach ($quota as $item) {
116:             $min = floatval($item['price']); // 当前规则的最低充值金额
117:             $_give = floatval($item['give']); // 当前规则的赠送金额
118: 
119:             // 如果当前充值金额大于等于当前规则的最低充值金额，更新赠送金额
120:             if ($price >= $min) {
121:                 $give = $_give;
122:             }
123:         }
124: 
125:         return $give; // 返回计算出的赠送金额
126:     }
127: 
128:     /**
129:      * 处理用户充值支付逻辑。
130:      *
131:      * 根据支付类型和是否为APP环境，生成相应的支付配置。支持微信和支付宝两种支付方式，
132:      * 当在APP环境中支付时，支付类型会相应地加上App后缀。在支付前，会触发一个before充值事件，
133:      * 允许其他功能模块在充值前进行额外的操作或校验。最终，返回包含支付配置和充值ID等信息的数组。
134:      *
135:      * @param string $type 支付方式，支持'weixin'和'alipay'。
136:      * @param User $user 进行充值的用户对象。
137:      * @param UserRecharge $recharge 用户充值记录对象。
138:      * @param string $return_url 支付宝充值成功后的回调URL，可选。
139:      * @param bool $isApp 是否在APP环境中支付，默认为false。
140:      * @return array 包含支付配置和充值ID等信息的数组。
141:      */
142:     public function pay(string $type, User $user, UserRecharge $recharge, $return_url = '', $isApp = false)
143:     {
144:         // 根据支付方式和是否为APP环境，调整支付类型
145:         if (in_array($type, ['weixin', 'alipay'], true) && $isApp) {
146:             $type .= 'App';
147:         }
148: 
149:         // 触发用户充值前的事件，允许其他功能模块介入
150:         event('user.recharge.before', compact('user', 'recharge', 'type', 'isApp'));
151: 
152:         // 根据支付类型创建支付服务对象，并初始化支付参数
153:         $service = new PayService($type, $recharge->getPayParams($type === 'alipay' ? $return_url : ''), 'user_recharge');
154: 
155:         // 生成支付配置
156:         $config = $service->pay($user);
157: 
158:         // 返回支付配置，加上充值ID和支付类型，供前端进行支付操作
159:         return $config + ['recharge_id' => $recharge['recharge_id'], 'type' => $type];
160:     }
161: 
162:     /**
163:      * //TODO 余额充值成功
164:      *
165:      * @param $orderId
166:      * @throws \think\db\exception\DataNotFoundException
167:      * @throws \think\db\exception\DbException
168:      * @throws \think\db\exception\ModelNotFoundException
169:      * @author xaboy
170:      * @day 2020/6/19
171:      */
172:     public function paySuccess($orderId)
173:     {
174:         $recharge = $this->dao->getWhere(['order_id' => $orderId]);
175:         if ($recharge->paid == 1) return;
176:         $recharge->paid = 1;
