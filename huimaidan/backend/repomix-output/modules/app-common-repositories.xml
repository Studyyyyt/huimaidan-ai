 73:      * @param int $productId 产品ID
 74:      * @param int $activityId 活动ID
 75:      * @param int $productType 产品类型，默认为0
 76:      * @return bool 更新或插入操作的执行结果
 77:      */
 78:     public function baseUpdate(array $param, int $productId, int $activityId, $productType = 0)
 79:     {
 80:         /* 构建查询条件 */
 81:         $where = [
 82:             'product_id' => $productId,
 83:             'activity_id' => $activityId,
 84:             'product_type' => $productType,
 85:         ];
 86: 
 87:         /* 根据条件查询现有数据 */
