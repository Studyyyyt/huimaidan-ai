2662:     /**
2663:      *  更新商品的库存和销量
2664:      * @param $order
2665:      * @param $cart
2666:      * @param $productNum
2667:      * @return void
2668:      * @author Qinii
2669:      */
2670:     public function orderProductIncStock($order, $cart, $productNum = null)
2671:     {
2672:         $productNum = $productNum ?? $cart['product_num'];
2673:         Db::transaction(function () use ($order, $cart, $productNum) {
2674:             $productAttrValueRepository = app()->make(ProductAttrValueRepository::class);
2675:             if ($cart['product_type'] == '1') {
2676:                 $oldId = $cart['cart_info']['product']['old_product_id'];
2677:                 $productAttrValueRepository->incSkuStock($oldId, $cart['cart_info']['productAttr']['sku'], $productNum);
2678:                 $this->dao->incStock($oldId, $productNum);
2679: //                $this->dao->descSales($oldId, $productNum);
2680:             } else if ($cart['product_type'] == '2') {
2681:                 $presellSku = app()->make(ProductPresellSkuRepository::class);
2682:                 $presellSku->incStock($cart['cart_info']['productPresellAttr']['product_presell_id'], $cart['cart_info']['productPresellAttr']['unique'], $productNum);
2683:                 $productAttrValueRepository->incStock($cart['product_id'], $cart['cart_info']['productAttr']['unique'], $productNum);
2684:                 $this->dao->incStock($cart['product_id'], $productNum);
2685:             } else if ($cart['product_type'] == '3') {
2686:                 app()->make(ProductAssistSkuRepository::class)->incStock($cart['cart_info']['productAssistAttr']['product_assist_id'], $cart['cart_info']['productAssistAttr']['unique'], $productNum);
2687:                 $productAttrValueRepository->incStock($cart['cart_info']['product']['old_product_id'], $cart['cart_info']['productAttr']['unique'], $productNum);
2688:                 $this->dao->incStock($cart['cart_info']['product']['old_product_id'], $productNum);
2689:             } else if ($cart['product_type'] == '4') {
2690:                 app()->make(ProductGroupSkuRepository::class)->incStock($cart['cart_info']['activeSku']['product_group_id'], $cart['cart_info']['activeSku']['unique'], $productNum);
2691:                 $this->dao->incStock($cart['cart_info']['product']['old_product_id'], $productNum);
2692:                 $productAttrValueRepository->incStock($cart['cart_info']['product']['old_product_id'], $cart['cart_info']['productAttr']['unique'], $productNum);
2693:             } else {
2694:                 if (isset($cart['cart_info']['product']['old_product_id']) && $cart['cart_info']['product']['old_product_id'] > 0) {
2695:                     $oldId = $cart['cart_info']['product']['old_product_id'];
2696:                     $productAttrValueRepository->incSkuStock($oldId, $cart['cart_info']['productAttr']['sku'], $productNum);
2697:                     $this->dao->incStock($oldId, $productNum);
2698:                 } else {
2699:                     $productAttrValueRepository->incStock($cart['product_id'], $cart['cart_info']['productAttr']['unique'], $productNum);
2700:                     $this->dao->incStock($cart['product_id'], $productNum);
2701:                 }
2702:                 if ($cart->integral > 0) {
2703:                     $totalIntegral = bcmul($productNum, $cart->integral, 0);
2704:                     $this->dao->descIntegral($cart->product_id, $totalIntegral, bcmul(bcdiv($totalIntegral, $order->integral, 2), $order->integral_price, 2));
2705:                 }
2706:             }
2707:         });
2708:     }
