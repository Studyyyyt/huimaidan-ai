 891:     /**
 892:      * 计算并处理商户的锁定资金
 893:      *
 894:      * 本函数用于在订单完成时，计算商户的锁定资金，并进行相应的资金处理。
 895:      * 这包括但不限于：解锁预售订单锁定的资金、更新订单锁定资金的状态、增加商户的待解冻余额。
 896:      *
 897:      * @param StoreOrder $order 商户的订单对象，用于获取订单相关信息。
 898:      */
 899:     public function computedLockMoney(StoreOrder $order)
 900:     {
 901:         // 使用数据库事务确保操作的原子性
 902:         Db::transaction(function () use ($order) {
 903:             $money = 0;
 904:             // 创建用户账单仓库实例
 905:             $make = app()->make(UserBillRepository::class);
 906: 
 907:             // 查询订单锁定的资金信息
 908:             $bill = $make->search(['category' => 'mer_lock_money', 'type' => 'order', 'link_id' => '1' . $order->order_id, 'status' => 0])->find();
 909:             if ($bill) {
 910:                 // 计算订单锁定资金的可解冻金额
 911:                 $money = bcsub($bill->number, $make->refundMerchantMoney($bill->link_id, $bill->type, $bill->mer_id), 2);
 912:                 // 如果存在预售订单，处理预售订单的锁定资金
 913:                 if ($order->presellOrder) {
 914:                     // 查询预售订单锁定的资金信息
 915:                     $presellBill = $make->search(['category' => 'mer_lock_money', 'type' => 'presell', 'link_id' => '2' . $order->presellOrder->presell_order_id, 'status' => 0])->find();
 916:                     if ($presellBill) {
 917:                         // 计算预售订单锁定资金的可解冻金额，并累加到总金额
 918:                         $money = bcadd($money, bcsub($presellBill->number, $make->refundMerchantMoney($presellBill->link_id, $presellBill->type, $presellBill->mer_id), 2), 2);
 919:                         // 更新预售订单锁定资金的状态
 920:                         $presellBill->status = 1;
 921:                         $presellBill->save();
 922:                     }
 923:                 }
 924:                 // 更新订单锁定资金的状态
 925:                 $bill->status = -1;
 926:                 $bill->save();
 927:             }
 928: 
 929:             // 如果存在可解冻的金额，增加商户的待解冻余额
 930:             if ($money > 0) {
 931:                 // 创建用户账单仓库实例（如果之前未创建）
 932:                 $make = app()->make(UserBillRepository::class);
 933:                 // 增加商户的待解冻余额
 934:                 $make->incBill($order->uid, 'mer_computed_money', 'order', [
 935:                     'link_id' => $order->order_id,
 936:                     'mer_id' => $order->mer_id,
 937:                     'status' => 0,
 938:                     'title' => '商户待解冻余额',
 939:                     'number' => $money,
 940:                     'mark' => '交易完成,商户待解冻余额' . floatval($money) . '元',
 941:                     'balance' => 0
 942:                 ]);
 943:             }
 944:         });
 945:     }
