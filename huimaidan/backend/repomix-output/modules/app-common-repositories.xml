309:                 $diyInfo['value'] = json_decode($diyInfo['value'], true);
310:             } else {
311:                 $diyInfo = [];
312:             }
313:             return json_encode($diyInfo, JSON_UNESCAPED_UNICODE);
314:         }, 3600);
315:         $data = json_decode($data);
316:         return compact('data');
317:     }
