690:     /**
691:      * 根据存储服务类型和提供的信息构造存储服务的域名。
692:      *
693:      * 本函数用于根据不同的存储服务类型（如阿里云、腾讯云等），构造对应服务的域名。
694:      * 通过传入存储服务的类型、名称、区域和可选的应用程序ID，生成用于访问存储服务的URL。
695:      *
696:      * @param int $type 存储服务的类型，对应于服务常量中的定义（如ALIYUN、TENGXUN等）。
697:      * @param string $name 存储服务的名称，用于构成域名的一部分。
698:      * @param string $reagion 存储服务所在的区域，用于构成域名的一部分。
699:      * @param string $appid 应用程序的ID，对于某些存储服务（如腾讯云），可以用于区分不同的应用程序实例。
700:      * @return string 返回构造的存储服务域名。
701:      */
702:     public function getDomain(int $type, string $name, string $reagion, string $appid = '')
703:     {
704:         $domainName = '';
705:         // 根据存储服务类型选择不同的域名构造方式
706:         switch ($type) {
707:             case $this->service::STORAGE_QINIU:
708:                 $domianList = $this->service::create($this->service::STORAGE_QINIU)->getDomian($name);
709:                 $domainName = $domianList[count($domianList) - 1] ?? '';
710:                 break;
711:             case  $this->service::STORAGE_ALIYUN:
712:                 // 阿里云对象存储域名格式
713:                 $domainName = 'https://' . $name . '.' . $reagion;
714:                 break;
715:             case $this->service::STORAGE_TENGXUN:
716:                 // 腾讯云对象存储域名格式，支持appid作为域名的一部分
717:                 $domainName = 'https://' . $name . ($appid ? '-' . $appid : '') . '.cos.' . $reagion . '.myqcloud.com';
718:                 break;
719:             case  $this->service::STORAGE_JINGDONG:
720:                 // 京东云对象存储域名格式
721:                 $domainName = 'https://' . $name . '.s3.' . $reagion . '.jdcloud-oss.com';
722:                 break;
723:             case  $this->service::STORAGE_HUAWEI:
724:                 // 华为云对象存储域名格式
725:                 $domainName = 'https://' . $name . '.obs.' . $reagion . '.myhuaweicloud.com';
726:                 break;
727:             case  $this->service::STORAGE_TIANYI:
728:                 // 天翼云对象存储域名格式
729:                 $domainName = 'https://' . $name . '.obs.' . $reagion . '.ctyun.cn';
730:                 break;
731:             case  $this->service::STORAGE_UCLOUD:
732:                 // 优刻得对象存储域名格式
733:                 $domainName = 'https://' . $name .'.' . $reagion .'.ufileos.com';
734:                 break;
735: 
736:         }
737:         return $domainName;
738:     }
739: 
740:     /**
741:      * 根据上传类型和区域名称获取对应的区域主机地址。
742:      *
743:      * 本函数旨在通过上传服务获取特定类型上传所对应的区域主机列表，
744:      * 然后在这些列表中查找包含指定区域名称的主机地址，最后返回该地址。
745:      * 如果找不到匹配的主机地址，则返回空字符串。
746:      *
747:      * @param int $type 上传类型，用于确定上传服务和对应的区域列表。
748:      * @param string $reagion 指定的区域名称，用于在区域列表中查找匹配的主机地址。
749:      * @return string 匹配的主机地址，如果找不到则返回空字符串。
750:      */
751:     public function getReagionHost(int $type, string $reagion)
752:     {
753:         // 创建上传服务实例，参数$type用于指定上传类型。
754:         $upload = UploadService::create($type);
755:         // 通过上传服务实例获取区域列表。
756:         $reagionList = $upload->getRegion();
757:         // 遍历区域列表，查找包含指定区域名称的主机地址。
758:         foreach ($reagionList as $item) {
759:             // 如果当前项的值包含指定的区域名称，则返回该主机地址。
760:             if (strstr($item['value'], $reagion) !== false) {
761:                 return $item['value'];
762:             }
763:         }
764:         // 如果遍历完毕没有找到匹配的主机地址，则返回空字符串。
765:         return '';
766:     }
767: 
768:     /**
769:      * 获取指定类型的域名列表
770:      *
771:      * 本函数用于查询并返回指定上传类型对应的域名列表。如果未指定类型，则根据系统配置的默认上传类型获取。
772:      * 主要用于支持多域名配置下的文件上传服务，使得可以灵活切换不同的域名进行文件访问。
773:      *
774:      * @param int|null $type 上传类型标识，null表示使用系统默认上传类型。
775:      * @return array 域名列表，如果没有找到任何域名则返回空数组。
776:      */
777:     public function domains(?int $type)
778:     {
779:         // 如果未指定上传类型，则使用系统配置的默认上传类型
780:         $type = $type ?: (systemConfig('upload_type') ?: 1);
781: 
782:         // 查询数据库，获取指定类型且未被删除的域名列表
783:         $domain = $this->dao->getSearch([])->where(['type' => $type,'is_del' => 0])->where('domain','>',0)->column('domain');
784: 
785:         // 返回查询结果，如果结果为空则返回空数组
786:         return $domain ?: [];
787:     }
788: }
</file>

