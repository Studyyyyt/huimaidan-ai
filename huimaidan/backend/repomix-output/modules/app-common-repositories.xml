164:     /**
165:      * 根据给定的关键字获取结果数据。
166:      *
167:      * 本函数旨在通过提供的关键字，从预定义的同意列表中查找对应的标签，并从数据访问对象（DAO）中获取该关键字对应的数据。
168:      * 如果关键字在同意列表中找到，将设置标题为对应的标签。然后，从DAO获取关键字对应的结果数据，如果数据不存在，则设置为空字符串。
169:      * 最后，返回包含标题和结果数据的数组。
170:      *
171:      * @param string $key 需要查询结果的关键字。
172:      * @return array 包含标题和查询结果的数据数组。
173:      */
174:     public function getResult($key)
175:     {
176:         // 初始化标题为空字符串
177:         $data['title'] = '';
178: 
179:         // 遍历同意列表中所有项目，寻找与关键字匹配的标签
180:         foreach ($this->getAgreeList(1) as $item) {
181:             if ($item['key'] == $key) {
182:                 // 如果找到匹配的关键字，设置标题为对应的标签
183:                 $data['title'] = $item['label'];
184:             }
185:         }
186: 
187:         // 从数据访问对象中获取关键字对应的结果数据，如果不存在则设置为空字符串
188:         $data[$key] = $this->dao->getResult($key) ?? '';
189: 
190:         // 返回包含标题和结果数据的数组
191:         return $data;
192:     }
