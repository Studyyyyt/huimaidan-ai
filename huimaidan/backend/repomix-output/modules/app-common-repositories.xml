113:     /**
114:      * 获取所有类型为$type$的数据
115:      *
116:      * 本函数通过调用DAO层的search方法，查询类型为$type$的所有数据。
117:      * 查询结果将按照经纪等级（brokerage_level）升序和创建时间（create_time）降序进行排序。
118:      * 最后，函数返回查询结果。
119:      *
120:      * @param int $type 数据的类型，用于筛选查询条件。
121:      * @return array 返回查询结果，是一个包含多个数据项的数组。
122:      */
123:     public function all(int $type)
124:     {
125:         // 调用DAO层的search方法查询数据，指定类型为$type$，并设定排序规则
126:         // 返回查询结果，未对返回值做进一步处理，直接返回查询结果数组
127:         return $this->dao->search(['type' => $type])->order('brokerage_level ASC,create_time DESC')->select();
