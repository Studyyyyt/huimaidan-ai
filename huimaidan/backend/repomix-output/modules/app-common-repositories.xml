107:      * @author yyw
108:      */
109:     protected function changeField(array $data, $type = true)
110:     {
111:         // 获取数据库连接实例
112:         $db = Db::connect();
113:         //操作的数据表
114:         $tableName = env('database.prefix', 'eb_') . 'user_fields';
115:         // 操作的字段名称
116:         $fieldName = $data['field'];
117:         // 验证字段端名是否合法
118:         $this->isValidColumnName($fieldName);
119:         //
120:         if ($type) {
121:             // 字段类型，可以根据需要进行修改
122:             $fieldType = $this->type[$data['type']]['type'] ?? 'varchar(255)';
123:             $comment = $data['title'] ?: $data['msg'];
124:             $default = $this->type[$data['type']]['default'];
125:             $sql = "ALTER TABLE `$tableName` ADD COLUMN `$fieldName` $fieldType NULL DEFAULT ".($default === NULL ? 'NULL' : "'$default'")." COMMENT '$comment'";
126:         } else {
127:             $sql = "ALTER TABLE `$tableName` DROP COLUMN `$fieldName`";
128: 
129:         }
130:         $this->executeSql($db, $sql);
131:         return true;
132:     }
