146: 
147:         // 将微秒和秒转换为毫秒，并去掉小数点，确保编号是整数
148:         $msectime = number_format((floatval($msec) + floatval($sec)) * 1000, 0, '', '');
149: 
150:         // 生成订单编号：毫秒时间戳后跟一个4位随机数，确保唯一性
151:         // 随机数生成范围是10000到当前毫秒时间戳转换的整数加10000，或98369之间的较大值
152:         // 这样做是为了避免在极短的时间内生成相同的订单编号
153:         // $orderId = $msectime . random_int(10000, max(intval($msec * 10000) + 10000, 98369));
154: 
155:         return $msectime;
156:     }
