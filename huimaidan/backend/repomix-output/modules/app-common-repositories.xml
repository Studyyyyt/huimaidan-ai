 97:      * 这种做法是为了确保不会意外删除那些仍然有活跃数据的帖子，从而影响用户体验或数据完整性。
 98:      *
 99:      * @param int $id 要删除的帖子的ID
100:      * @throws ValidateException 如果帖子下存在显示中的数据，则抛出此异常
101:      */
102:     public function delete(int $id)
103:     {
104:         // 通过依赖注入获取CommunityRepository实例
105:         $make = app()->make(CommunityRepository::class);
106:         // 检查帖子下是否存在显示中的数据
107:         if ( $make->getWhereCount(CommunityRepository::IS_SHOW_WHERE) ) {
108:             throw new ValidateException('该话题下存在数据');
109:         }
110:         // 如果没有显示中的数据，执行删除操作
111:         $this->dao->delete($id);
112:     }
