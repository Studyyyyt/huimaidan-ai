3868:             ->where('start_time','<=',$currentHour)->where('end_time','>',$currentHour)
3869:             ->where('status',1)
3870:             ->value('seckill_time_id');
3871:         $key .= '_'.$seckill_time_id. '_'. $unique;
3872:         $stock = $this->getLen($key,1);
3873:         return compact('key','stock');
3874:     }
