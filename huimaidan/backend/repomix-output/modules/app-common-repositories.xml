267:                 $name = 'yi_lian_yun';
268:                 $configData = [
269:                     'partner' => $item['printer_appid'],
270:                     'clientId' => $item['printer_appkey'],
271:                     'apiKey' => $item['printer_secret'],
272:                     'terminal' => $item['printer_terminal'],
273:                     'type' => 0,
274:                 ];
275:                 $content = $this->ylyContent(json_decode($item['print_content'], true), $order, $product, $item['times'], $print_type);
276:             } else { //飞鹅云
277:                 $name = 'fei_e_yun';
278:                 $configData = [
279:                     'partner' => $item['printer_appid'],
280:                     'clientId' => $item['printer_appkey'],
281:                     'terminal' => $item['printer_terminal'],
282:                     'type' => 1,
283:                 ];
284:                 $content = $this->feyContent(json_decode($item['print_content'], true), $order, $product, $print_type);
