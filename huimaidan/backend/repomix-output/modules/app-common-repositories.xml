 245:     public function create1(array $data)
 246:     {
 247:         // 如果提供了总数量，则计算剩余数量
 248:         if (isset($data['total_count'])) {
 249:             $data['remain_count'] = $data['total_count'];
 250:         }
 251: 
 252:         // 使用事务来确保数据的一致性
 253:         Db::transaction(function () use ($data) {
 254:             // 提取产品ID，并删除不再需要的product_id键
 255:             $products = array_column((array)$data['product_id'], 'id');
 256:             unset($data['product_id']);
