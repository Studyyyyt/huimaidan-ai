254:     /**
255:      * 删除记录并清理关联数据。
256:      *
257:      * 本函数通过开启数据库事务，确保删除操作和关联数据清理操作要么同时成功，
258:      * 要么同时失败，以维护数据的一致性。具体操作包括：
259:      * 1. 删除指定ID的记录。
260:      * 2. 清理与被删除记录相关的分组数据。
261:      *
262:      * @param int $id 需要删除的记录的ID。
263:      */
264:     public function delete($id)
265:     {
266:         // 开启数据库事务处理
267:         Db::transaction(function () use ($id) {
268:             // 删除指定ID的记录
269:             $this->delete($id);
270: 
271:             // 实例化分组数据仓库，用于后续的清理操作
272:             /** @var GroupDataRepository $make */
273:             $make = app()->make(GroupDataRepository::class);
274:             // 清理与被删除记录相关的分组数据
275:             $make->clearGroup($id);
276:         });
277:     }
