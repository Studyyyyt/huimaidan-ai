261:     public function batchMerCate(int $mer_id, array $ids, array $mer_cate_ids)
262:     {
263:         foreach ($ids as $id) {
264:             // 整理分类数据
265:             $mer_cate = app()->make(ProductRepository::class)->setMerCate($mer_cate_ids, $id, $mer_id);
266:             // 删除以前分类数据
267:             $productCateRepository = app()->make(ProductCateRepository::class);
268:             $productCateRepository->clearAttr($id);
269:             // 保存新的分类数据
270:             if (!empty($mer_cate)) {
271:                 $productCateRepository->insert($mer_cate);
272:             }
273:         }
274:         return true;
