351:     /**
352:      * 批量更新表单ID
353:      * @param int $mer_id
354:      * @param int $form_id
355:      * @return bool
356:      * @throws \think\db\exception\DbException
357:      *
358:      * @date 2023/10/11
359:      * @author yyw
360:      */
361:     public function batchForm(int $mer_id, array $ids = [], int $form_id = 0)
362:     {
363:         if ($form_id) {
364:             //验证模板是不存在
365:             /** @var FormRepository $formRepository */
366:             $formRepository = app()->make(FormRepository::class);
367:             if (!$form_info = $formRepository->get($form_id)) {
368:                 throw new ValidateException('表单数据异常');
369:             }
370:             if ($form_info['mer_id'] != $mer_id) {
371:                 throw new ValidateException('请选择自己的表单');
372:             }
373: 
374:             $this->dao->updates($ids, ['mer_form_id' => $form_id]);
375:         } else {
376:             $this->dao->updates($ids, ['mer_form_id' => 0]);
377:         }
378: 
379:         return true;
380:     }
381: 
382:     /**
383:      * 计算价格
384:      * @param string $ot_price
385:      * @param string $type
386:      * @param string $number
387:      * @return mixed|string|null
388:      *
389:      * @date 2023/10/09
390:      * @author yyw
391:      */
392:     public function calculatePrice(string $ot_price, string $type, string $number)
393:     {
394:         switch ($type) {
395:             case 'add':
396:                 $price = bcadd($ot_price, $number, 2);
397:                 break;
398:             case 'sub':
399:                 $price = max(bcsub($ot_price, $number, 2), 0);
400:                 break;
401:             case 'mul':
402:                 $pct = bcdiv($number, '100', 4);
403:                 $price = bcmul($ot_price, $pct, 2);
404:                 break;
405:             case 'div':
406:                 if ($number === '0') {
407:                     throw new ValidateException('分母不能为0');
408:                 }
409:                 $pct = bcdiv($number, '100', 4);
410:                 $price = bcdiv($ot_price, $pct, 2);
411:                 break;
412:             default:
413:                 throw new ValidateException('修改价格类型错误');
414:         }
415:         return $price;
416:     }
417: 
418:     /**
419:      * 修改商品
420:      * @param int $mer_id
421:      * @param string $type
422:      * @param string $number
423:      * @param $productInfo
424:      * @return void
425:      *
426:      * @date 2023/10/12
427:      * @author yyw
428:      */
429:     public function updateProduct(int $mer_id, string $type, string $number, $productInfo, $admin_info = []): void
430:     {
431: 
432:         Db::transaction(function () use ($mer_id, $type, $number, $productInfo, $admin_info) {
433:             $id = $productInfo['product_id'];
434:             $price = $this->calculatePrice($productInfo['price'], $type, $number);
435:             $this->dao->update($id, ['price' => $price]);
436:             $update_infos = [
437:                 OperateLogRepository::MERCHANT_INC_PRODUCT_PRICE => '',
438:                 OperateLogRepository::MERCHANT_DEC_PRODUCT_PRICE => '',
439:             ];
440:             //计算sku价格
441:             foreach ($productInfo['attrValue'] as $attrValue) {
442:                 $sku_price = $this->calculatePrice($attrValue['price'], $type, $number);
443: 
444:                 $change_price = bcsub($sku_price, $attrValue['price'], 2);
445:                 if ($change_price > 0) {
446:                     $update_infos[OperateLogRepository::MERCHANT_INC_PRODUCT_PRICE] .= $attrValue['sku'] . '价格增加了' . $change_price . ',';
447:                 } else {
448:                     $update_infos[OperateLogRepository::MERCHANT_DEC_PRODUCT_PRICE] .= $attrValue['sku'] . '价格减少了' . -$change_price . ',';
449:                 }
450: 
451:                 //更新sku
452:                 app()->make(ProductAttrValueRepository::class)->update($attrValue['value_id'], ['price' => $sku_price]);
453:             }
454:             //更新spu
455:             app()->make(SpuRepository::class)->updatePrice($mer_id, $id, $price);
456:             if (!empty($admin_info)) {
457:                 event('create_operate_log', [
458:                     'category' => OperateLogRepository::MERCHANT_EDIT_PRODUCT,
459:                     'data' => [
460:                         'product' => $productInfo,
461:                         'admin_info' => $admin_info,
462:                         'update_infos' => $update_infos,
463:                     ],
464:                 ]);
465:             }
466: 
467:         });
468:     }
469: 
470: }
