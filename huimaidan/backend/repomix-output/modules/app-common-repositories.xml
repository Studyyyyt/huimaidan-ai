 756:     /**
 757:      * 添加冻结资金
 758:      *
 759:      * 该方法用于在特定条件下为商户添加冻结资金。冻结资金是指在交易过程中被暂时锁定的资金，
 760:      * 用于确保商户在交易完成前不会错误地使用这些资金。
 761:      *
 762:      * @param int $merId 商户ID，用于标识哪个商户的资金被冻结
 763:      * @param string $orderType 订单类型，用于区分不同类型的订单，可能的值包括但不限于"order"表示订单冻结
 764:      * @param int $orderId 订单ID，与订单类型配合使用，用于唯一标识订单
 765:      * @param float $money 冻结的资金金额，如果金额小于等于0，则不执行任何操作
 766:      */
 767:     public function addLockMoney(int $merId, string $orderType, int $orderId, float $money)
 768:     {
 769:         // 检查资金金额是否有效，如果小于等于0，则直接返回，不进行后续操作
 770:         if ($money <= 0) return;
 771:         // 检查系统配置，如果启用了商户资金冻结时间，则通过UserBillRepository增加商户的冻结资金记录
 772:         if (systemConfig('mer_lock_time')) {
 773:             // 使用依赖注入的方式获取UserBillRepository实例，并增加商户的冻结资金
 774:             app()->make(UserBillRepository::class)->incBill($merId, 'mer_lock_money', $orderType, [
 775:                 'link_id' => ($orderType === 'order' ? 1 : 2) . $orderId, // 根据订单类型组合链接ID
 776:                 'mer_id' => $merId, // 商户ID
 777:                 'status' => 0, // 资金变动状态，0表示冻结
 778:                 'title' => '商户冻结余额', // 资金变动标题
 779:                 'number' => $money, // 资金变动金额
 780:                 'mark' => '商户冻结余额', // 资金变动备注
 781:                 'balance' => 0 // 新的余额，此处设置为0，因为是冻结资金
 782:             ]);
 783:         } else {
 784:             // 如果系统配置未启用商户资金冻结时间，则直接调用dao层方法增加商户的资金
 785:             $this->dao->addMoney($merId, $money);
 786:         }
 787:     }
