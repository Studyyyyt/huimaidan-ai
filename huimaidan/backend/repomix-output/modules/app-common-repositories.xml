226:     /**
227:      * 更新产品信息。
228:      *
229:      * 该方法用于根据给定的ID和数据更新产品的详细信息。它处理产品模板名称、排序、
230:      * 参数和类别关联的更新。使用事务来确保数据库操作的一致性。
231:      *
232:      * @param int $id 产品的ID
233:      * @param array $data 包含产品更新信息的数组，如模板名称、排序、参数和类别ID
234:      * @param int $merId 商家ID，默认为0，用于指定操作的商家
235:      */
236:     public function update($id, $data, $merId = 0)
237:     {
238:         // 提取参数数据
239:         $params = $data['params'];
240:         // 去重处理类别ID数组
241:         $cate = array_unique($data['cate_ids']);
242:         // 构建要更新的模板名称和排序信息
243:         $tem = [
244:             'template_name' => $data['template_name'],
245:             'sort' => $data['sort'],
246:         ];
247:         if ($data['delete_params'] ?? []) {
248:             app()->make(ParameterValueRepository::class)->dostory($data['delete_params'], $merId);
249:         }
250: 
251:         // 实例化参数仓库和关联仓库
252:         $paramMake = app()->make(ParameterRepository::class);
253:         $releMake = app()->make(RelevanceRepository::class);
254: 
255:         // 使用事务处理数据库操作
256:         Db::transaction(function () use ($id, $params, $tem, $cate, $paramMake, $releMake, $merId) {
257:             // 更新产品的基本模板和排序信息
258:             $this->dao->update($id, $tem);
259:             $paramMake->createOrUpdate($id, $merId, $params);
260:             // 删除旧的类别关联，创建新的类别关联
261:             $releMake->batchDelete($id, RelevanceRepository::PRODUCT_PARAMES_CATE);
262:             if (!empty($cate)) {
263:                 $releMake->createMany($id, $cate, RelevanceRepository::PRODUCT_PARAMES_CATE);
264:             }
265:         });
266:     }
