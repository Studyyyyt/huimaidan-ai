26:     /**
27:      * 批量添加秒杀商品
28:      * @param   $activeId
29:      * @param  $productList
30:      * @param  $status
31:      * @return void
32:      * FerryZhao 2024/4/12
33:      */
34:     public function createSeckillProduct($activeId,$productList,$status = 0)
35:     {
36:         if(!$activeId){
37:             throw new ValidateException('活动ID参数错误');
38:         }
39:         $spuRepository = app()->make(SpuRepository::class);
40:         if(!empty($productList) && is_array($productList)){
41:             //拆分处理
42:             $productListArr = array_chunk($productList,2);
43:             foreach ($productListArr as $item){
44:                 foreach ($item as $value){
45:                     $value['product_type'] = 1;
46:                     $value['status'] = $status;//平台免审or店铺开启免审
47:                     $value['is_gift_bag'] = 0;
48:                     $value['cate_hot'] = 0;
49:                     $value['active_id'] = $activeId;
50:                     $product_id = app()->make(ProductRepository::class)->create($value,1,0,$activeId);
51:                     $spuRepository->changeStatus($product_id,1);
52:                 }
53:             }
54:         }
55:     }
