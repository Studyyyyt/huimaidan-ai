 36: 
 37:     /**
 38:      * 根据条件获取商户列表
 39:      *
 40:      * 本函数用于根据给定的条件数组 $where，获取指定页码 $page 和每页数量 $limit 的商户列表。
 41:      * 它首先通过条件搜索查询商户数据，然后计算总记录数，最后分页并排序后返回商户列表。
 42:      *
 43:      * @param array $where 搜索条件数组
 44:      * @param int $page 当前页码
 45:      * @param int $limit 每页的记录数
 46:      * @return array 包含 'count' 和 'list' 两个元素的数组，'count' 为总记录数，'list' 为分页后的商户列表
 47:      */
 48:     public function getList(array $where, $page, $limit)
 49:     {
 50:         // 根据条件搜索商户数据
 51:         $query = $this->dao->search($where);
 52: 
 53:         // 计算搜索结果的总记录数
 54:         $count = $query->count();
 55: 
 56:         // 进行分页，并按照创建时间降序和状态升序排序，同时加载关联的商户类别和类型信息
 57:         $list = $query->page($page, $limit)->order('create_time DESC , status ASC')->with(['merchantCategory', 'merchantType'])->select();
 58: 
 59:         // 返回包含总记录数和分页后的商户列表的数组
 60:         return compact('count', 'list');
 61:     }
 62: 
 63:     /**
 64:      * 获取意向商家详情
 65:      *
 66:      * 本函数用于根据提供的意向商家ID和可选的用户ID，从数据库中检索对应的意向商家详情。
 67:      * 如果提供了用户ID，则只返回该用户相关的意向商家详情；否则，返回所有与指定意向商家ID相关的详情。
 68:      *
 69:      * @param int $id 意向商家的唯一标识ID
 70:      * @param int|null $uid 可选的用户ID，用于过滤结果，仅返回该用户相关的意向商家详情
 71:      * @return array|null 返回符合条件的意向商家详情数组，如果未找到则返回null
 72:      */
 73:     public function detail($id, ?int $uid)
 74:     {
 75:         // 定义查询条件，初始只包含意向商家ID
 76:         $where = ['mer_intention_id' => $id];
 77: 
 78:         // 如果提供了用户ID，则将其添加到查询条件中
 79:         if (!is_null($uid)) {
 80:             $where['uid'] = $uid;
 81:         }
 82: 
 83:         // 执行查询并返回结果
 84:         return $this->dao->search($where)->find();
 85:     }
 86: 
 87:     /**
 88:      * 更新意向商家的信息。
 89:      *
 90:      * 此方法用于更新意向商家在数据库中的信息。它首先检查该意向商家是否存在以及其状态是否为启用，
 91:      * 如果存在且状态为启用，则抛出一个异常，表示当前状态不能修改。然后，它处理图片数据，
 92:      * 将图片数组转换为以逗号分隔的字符串，并设置默认的状态、失败消息。最后，它调用DAO层的方法
 93:      * 来更新数据库中的记录。
 94:      *
 95:      * @param int $id 意向商家的ID。
 96:      * @param array $data 包含要更新的意向商家信息的数组。
 97:      * @return bool 更新操作的结果，true表示成功，false表示失败。
 98:      * @throws ValidateException 如果意向商家当前状态不允许修改，则抛出此异常。
 99:      */
100:     public function updateIntention($id, array $data)
101:     {
102:         // 检查意向商家是否存在且状态为启用，如果存在则抛出异常
103:         if ($this->dao->existsWhere(['mer_intention_id' => $id, 'status' => '1']))
104:             throw new ValidateException('当前状态不能修改');
105: 
106:         // 处理图片数据，将数组转换为以逗号分隔的字符串
107:         $data['images'] = implode(',', (array)$data['images']);
108: 
109:         // 设置默认的状态和失败消息
110:         $data['status'] = 0;
111:         $data['fail_msg'] = '';
112: 
113:         // 调用DAO层的方法更新数据库中的记录
114:         return $this->dao->update($id, $data);
115:     }
116: 
117:     /**
118:      * 标记商家意向的表单生成方法
119:      *
120:      * 本方法用于生成一个用于修改商家意向备注的表单。通过给定的商家意向ID，获取当前备注信息，
121:      * 并构建一个表单以允许用户输入新的备注。表单提交的URL是基于当前商家意向ID动态生成的。
122:      *
123:      * @param int $id 商家意向的唯一标识ID，用于获取当前商家意向的备注信息以及构建表单提交的URL。
124:      * @return \FormBuilder\Form|\Phper6\Elm\Form
125:      */
126:     public function markForm($id)
127:     {
128:         // 通过商家意向ID获取当前商家意向的备注信息
129:         $data = $this->dao->get($id);
130: 
131:         // 构建表单提交的URL，使用商家意向ID作为参数
132:         $form = Elm::createForm(Route::buildUrl('systemMerchantIntentionMark', ['id' => $id])->build());
133: 
134:         // 设置表单的验证规则，这里仅包含一个文本区域用于输入备注信息
135:         $form->setRule([
136:             Elm::textarea('mark', '备注：', $data['mark'])->placeholder('请输入备注')->required('请输入备注'),
137:         ]);
138: 
139:         // 设置表单的标题为“修改备注”
140:         return $form->setTitle('修改备注');
141:     }
142: 
143:     /**
144:      * 创建用于修改商户意向状态的表单
145:      *
146:      * 该方法通过Elm库构建一个表单，用于修改商户的意向状态。表单中包含一个选择字段，用于选择审核状态（同意或拒绝）。
147:      * 根据所选的审核状态，表单会动态显示不同的字段：如果选择同意，则需要选择是否自动创建商户；如果选择拒绝，则需要输入拒绝的原因。
148:      *
149:      * @param int $id 商户意向的ID，用于构建表单的提交URL。
150:      * @return \FormBuilder\Form|\think\form\Form
151:      */
152:     public function statusForm($id)
153:     {
154:         // 构建表单提交的URL，使用Route类生成带ID的URL
155:         $form = Elm::createForm(Route::buildUrl('systemMerchantIntentionStatus', ['id' => $id])->build());
156: 
157:         // 设置表单的验证规则
158:         $form->setRule([
159:             // 创建一个选择字段，用于选择商户的审核状态
160:             Elm::select('status', '审核状态：', 1)->options([
161:                 ['value' => 1, 'label' => '同意'],
162:                 ['value' => 2, 'label' => '拒绝'],
163:             ])->control([
164:                 // 当选择同意时，显示一个选择字段，用于选择是否自动创建商户
165:                 [
166:                     'value' => 1,
167:                     'rule' => [
168:                         Elm::radio('create_mer', '自动创建商户：', 1)->options([
169:                             ['value' => 1, 'label' => '创建'],
170:                             ['value' => 2, 'label' => '不创建'],
171:                         ])
172:                     ]
173:                 ],
174:                 // 当选择拒绝时，显示一个文本区域，用于输入拒绝的原因
175:                 [
176:                     'value' => 2,
177:                     'rule' => [
178:                         Elm::textarea('fail_msg', '失败原因：', '信息填写有误')->placeholder('请输入失败原因')
179:                     ]
180:                 ]
181:             ]),
182:         ]);
183: 
184:         // 设置表单的标题
185:         return $form->setTitle('审核状态');
186:     }
187: 
188:     /**
189:      * 更新商家意向状态
190:      * 此函数用于处理商家意向的更新操作，包括状态更改、信息完善等。
191:      * @param $id 商家意向ID
192:      * @param $data 更新的数据数组
193:      * @throws ValidateException 当信息不存在或状态不正确时抛出异常
194:      */
195:     public function updateStatus($id, $data)
196:     {
197:         // 判断是否创建商家
198:         $create = $data['create_mer'] == 1;
199:         // 移除创建商家标记
200:         unset($data['create_mer']);
201:         // 根据ID查询商家意向信息
202:         $intention = $this->search(['mer_intention_id' => $id])->find();
203:         // 如果商家意向不存在，抛出异常
204:         if (!$intention)
205:             throw new ValidateException('信息不存在');
206:         // 如果商家意向状态已设置，抛出异常
207:         if ($intention->status)
208:             throw new ValidateException('状态有误,修改失败');
209:         // 获取系统配置信息
210:         $config = systemConfig(['broadcast_room_type', 'broadcast_goods_type']);
211: 
212:         // 获取商家类型信息
213:         $margin = app()->make(MerchantTypeRepository::class)->get($intention['mer_type_id']);
214:         // 设置商家意向的保证金相关字段
215:         $data['is_margin'] = $margin['is_margin'] ?? -1;
216:         $data['margin'] = $margin['margin'] ?? 0;
217: 
218:         // 初始化商家数据和短信数据数组
219:         $merData = [];
220:         $smsData = [];
221:         // 如果是创建商家
222:         if ($create == 1) {
223:             // 处理商家密码
224:             $password = substr($intention['phone'], -6);
225:             // 构建商家信息数组
226:             $merData = [
227:                 'mer_name' => $intention['mer_name'],
228:                 'mer_phone' => $intention['phone'],
229:                 'mer_account' => $intention['phone'],
230:                 'category_id' => $intention['merchant_category_id'],
231:                 'type_id' => $intention['mer_type_id'],
232:                 'real_name' => $intention['name'],
233:                 'region_id' => $intention['circle_id'],
234:                 'business_id' => $intention['business_id'],
235:                 'status' => 1,
236:                 'is_audit' => 1,
237:                 'is_bro_room' => $config['broadcast_room_type'] == 1 ? 0 : 1,
238:                 'is_bro_goods' => $config['broadcast_goods_type'] == 1 ? 0 : 1,
239:                 'mer_password' => $password,
240:                 'is_margin' => $margin['is_margin'] ?? -1,
241:                 'margin' => $margin['margin'] ?? 0,
242:                 'mark' => $margin['margin'] ?? 0,
243:             ];
244:             // 设置失败原因为空
245:             $data['fail_msg'] = '';
246:             // 构建短信数据数组
247:             $smsData = [
248:                 'date' => date('m月d日', strtotime($intention->create_time)),
249:                 'mer' => $intention['mer_name'],
250:                 'phone' => $intention['phone'],
251:                 'pwd' => $password ?? '',
252:                 'site_name' => systemConfig('site_name'),
253:             ];
254:         }
255:         // 如果状态更新为2（可能是审核不通过）
256:         if ($data['status'] == 2) {
257:             // 设置短信数据
258:             $smsData = [
259:                 'phone' => $intention['phone'],
260:                 'date' => date('m月d日', strtotime($intention->create_time)),
261:                 'mer' => $intention['mer_name'],
262:                 'site' => systemConfig('site_name'),
263:             ];
264:         }
265: 
266:         // 开启数据库事务处理
267:         Db::transaction(function () use ($config, $intention, $data, $create,$margin,$merData,$smsData) {
268:             // 如果状态更新为1（审核通过）
269:             if ($data['status'] == 1) {
270:                 // 如果需要创建商家
271:                 if ($create == 1) {
272:                     // 创建商家
273:                     $merchant = app()->make(MerchantRepository::class)->createMerchant($merData);
274:                     // 保存商家证书信息
275:                     app()->make(ConfigValueRepository::class)->setFormData(['mer_certificate' => $intention['images']], $merchant->mer_id);
276:                     // 设置商家ID
277:                     $data['mer_id'] = $merchant->mer_id;
278:                     // 添加发送短信任务
279:                     Queue::push(SendSmsJob::class, ['tempId' => 'APPLY_MER_SUCCESS', 'id' => $smsData]);
280:                 }
281:             } else {
282:                 // 添加发送短信任务（审核不通过）
283:                 Queue::push(SendSmsJob::class, ['tempId' => 'APPLY_MER_FAIL', 'id' => $smsData]);
284:             }
285:             // 保存商家意向信息
286:             $intention->save($data);
287:         });
288:     }
289: 
290: }
