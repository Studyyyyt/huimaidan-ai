 84:     protected function checkValue(array $data)
 85:     {
 86:         // 初始化一个数组，用于存储已存在的规则值，以检查是否有重复。
 87:         $arr = [];
 88:         // 遍历模板值数组，对每个规则进行详细检查。
 89:         foreach ($data['template_value'] as $k => $value) {
 90:             // 如果当前规则值不是数组，则抛出异常，表示规则有误。
 91:             if (!is_array($value)) throw new ValidateException('规则有误');
 92:             // 如果当前规则的名称为空，则抛出异常，提示输入规则名称。
 93:             if (!($value['value'] ?? null)) throw new ValidateException('请输入规则名称');
 94:             // 如果当前规则的详细值为空或为空数组，则抛出异常，提示添加规则值。
 95:             if (!($value['detail'] ?? null) || !count($value['detail'])) throw new ValidateException('请添加规则值');
 96:             // 如果当前规则值已存在于已记录的规则值数组中，则抛出异常，表示规格重复。
 97:             if(in_array($value['value'],$arr)) throw new ValidateException('规格重复');
 98:             // 将当前规则值添加到已记录的规则值数组中。
 99:             $arr[] = $value['value'];
100:             // 如果当前规则的详细值经去除重复后长度不等于原数组长度，则抛出异常，表示属性重复。
101:             if (count($value['detail']) != count(array_unique($value['detail']))) throw new ValidateException('属性重复') ;
102:             // 更新数据数组中的当前规则值，保留验证通过的值和详细信息。
103:             $data['template_value'][$k] = [
104:                 'value' => $value['value'],
105:                 'detail' => $value['detail'],
106:             ];
107:         }
108:         // 返回经过验证和可能修改后的数据数组。
109:         return $data;
110:     }
