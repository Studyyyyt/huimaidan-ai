348:     /**
349:      * 处理直播间的申请操作。
350:      *
351:      * 根据传入的状态对直播间进行相应的处理，包括修改直播间状态、记录错误信息、创建直播间、发送通知等。
352:      * 当状态为-1时，表示申请未通过，会记录失败原因；其他状态表示申请通过并进行相应的直播间创建和通知发送操作。
353:      *
354:      * @param int $id 直播间ID。
355:      * @param int $status 直播间状态，用于确定具体的处理流程。
356:      * @param string $msg 当状态为-1时，用于记录申请未通过的原因。
357:      */
358:     public function apply($id, $status, $msg = '')
359:     {
360:         // 根据ID获取直播间信息
361:         $room = $this->dao->get($id);
362:         // 开启数据库事务，确保一系列操作的原子性
363:         Db::transaction(function () use ($msg, $status, $room) {
364:             // 更新直播间状态
365:             $room->status = $status;
366:             // 当状态为-1时，记录未通过的原因
367:             if ($status == -1) {
368:                 $room->error_msg = $msg;
369:             } else {
370:                 // 通过微信接口创建直播间，并更新直播间ID和状态
371:                 $room_id = $this->wxCreate($room);
372:                 $room->room_id = $room_id;
373:                 $room->status = 2;
374:                 // 如果直播间类型需要，生成并记录推流地址
375:                 if ($room->type) {
376:                     $path = MiniProgramService::create()->miniBroadcast()->getPushUrl($room_id);
377:                     $room->push_url = $path->pushAddr;
378:                 }
379:             }
380:             // 保存更新后的直播间信息
381:             $room->save();
382: 
383:             // 发送审核状态通知给商家
384:             SwooleTaskService::merchant('notice', [
385:                 'type' => 'broadcast_status_' . ($status == -1 ? 'fail' : 'success'),
386:                 'data' => [
387:                     'title' => '直播间审核通知',
388:                     'message' => $status == -1 ? '您的直播间审核未通过!' : '您的直播间审核已通过',
389:                     'id' => $room->broadcast_room_id
390:                 ]
391:             ], $room->mer_id);
392: 
393:             // 当状态为-1时，将未通过审核的信息推送到短信队列
394:             if ($status == -1) {
395:                 Queue::push(SendSmsJob::class, [
396:                     'tempId' => 'BROADCAST_ROOM_FAIL',
397:                     'id' => $room['broadcast_room_id']
398:                 ]);
399:             }
400:         });
401:     }
