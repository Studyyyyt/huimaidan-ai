 21: 
 22: class StoreGroupRepository extends BaseRepository
 23: {
 24:     use CategoresRepository;
 25: 
 26:     const LIST_FIELDS = 'store_group_id,pid,name,sort,status,diy_temp_id,level,positioning_status,longitude,latitude';
 27:     
 28:     public function __construct(StoreGroupDao $dao)
 29:     {
 30:         $this->dao = $dao;
 31:     }
 32:     /**
 33:      * 获取组织列表
 34:      *
 35:      * @param array $where
 36:      * @param array $with
 37:      * @return void
 38:      */
 39:     public function getList(array $where, array $with = [])
 40:     {
 41:         $query = $this->dao->search($where)
 42:             ->when(!empty($with), function ($query) use ($with) {
 43:                 $query->with($with);
 44:             });
 45: 
 46:         $count = $query->count();
 47:         $list = formatCategory($query->field(self::LIST_FIELDS)->append(['merchant', 'merchant_count'])->select()->toArray(), $this->dao->getPk());
 48: 
 49:         return compact('list', 'count');
 50:     }
 51:     /**
 52:      * 创建组织
 53:      *
 54:      * @param array $data
 55:      * @return void
 56:      */
 57:     public function create(array $data)
 58:     {
 59:         if ($data['pid'] && !$this->dao->exists($data['pid'])) {
 60:             throw new ValidateException('上级不存在!');
 61:         }
 62: 
 63:         if ($data['pid'] && ($this->getLevelById($data['pid']) >= $this->dao->getMaxLevel())) {
 64:             throw new ValidateException('最多' . $this->dao->getMaxLevel() . '级!');
 65:         }
 66:         $data[$this->dao->getPath()] = $this->getPathById($data[$this->dao->getParentId()]);
 67:         $data[$this->dao->getLevel()] = $this->getLevelById($data[$this->dao->getParentId()]);
 68: 
 69:         return Db::transaction(function () use ($data) {
 70:             // 创建分组
 71:             $res = $this->dao->create($data);
 72:             // 写入关联商户
 73:             $merchantIds = $data['merchant_ids'];
 74:             unset($data['merchant_ids']);
 75:             app()->make(RelevanceRepository::class)->createMany(
 76:                 $res->store_group_id,
 77:                 $merchantIds,
 78:                 RelevanceRepository::STORE_GROUP
 79:             );
 80: 
 81:             return true;
 82:         });
 83:     }
 84:     /**
 85:      * 更新组织
 86:      *
 87:      * @param integer $id
 88:      * @param array $data
 89:      * @return void
 90:      */
 91:     public function update(int $id, array $data)
 92:     {
 93:         $info = $this->dao->get($id);
 94:         if (!$info) {
 95:             throw new ValidateException('记录不存在!');
 96:         }
 97:         if ($data['pid'] && !$this->dao->exists($data['pid'])) {
 98:             throw new ValidateException('上级不存在!');
 99:         }
100:         if ($data['pid'] && ($this->getLevelById($data['pid']) >= $this->dao->getMaxLevel())) {
101:             throw new ValidateException('最多' . $this->dao->getMaxLevel() . '级!');
102:         }
103:         if ($this->dao->checkChangeToChild($id, $data['pid'])) {
104:             throw new ValidateException('无法修改到当前分类到子集，请先修改子类');
105:         }
106:         if (!$this->checkChildLevel($id, $data['pid'])) {
107:             throw new ValidateException('子类超过最高等级限制，请先修改子类');
108:         }
109: 
110:         $data[$this->dao->getPath()] = $this->getPathById($data[$this->dao->getParentId()]);
111:         $data[$this->dao->getLevel()] = $this->getLevelById($data[$this->dao->getParentId()]);
112:         $data['update_time'] = date('Y-m-d H:i:s');
113: 
114:         return Db::transaction(function () use ($id, $data) {
115:             $relevanceRepository = app()->make(RelevanceRepository::class);
116:             // 删除关联商户
117:             $relevanceRepository->batchDelete($id, RelevanceRepository::STORE_GROUP);
118:             // 写入关联商户
119:             $merchantIds = $data['merchant_ids'];
120:             unset($data['merchant_ids']);
121:             $relevanceRepository->createMany($id, $merchantIds, RelevanceRepository::STORE_GROUP);
122:             // 更新分组信息
123:             $this->dao->update($id, $data);
124: 
125:             return true;
126:         });
127:     }
