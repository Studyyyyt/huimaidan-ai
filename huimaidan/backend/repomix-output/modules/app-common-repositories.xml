612:     /**
613:      * 种草完成给用户增加积分
614:      *
615:      * @param object $communityInfo 种草信息
616:      * @return void
617:      */
618:     public function giveIntegral(object $communityInfo)
619:     {
620:         $giveIntegralConfig = systemConfig(['integral_community_give', 'integral_community_give_limit']);
621:         if (!$giveIntegralConfig['integral_community_give'] || !$giveIntegralConfig['integral_community_give_limit']) {
622:             return false;
623:         }
624:         $uid = $communityInfo->uid;
625:         $createDay = date('Y-m-d', strtotime($communityInfo->create_time));
626:         // 计算用户在当天发布的审核通过的图文内容数量, 判断是否超过每日限制
627:         $communityCount = $this->getWhereCount(['uid' => $uid, 'status' => 1, ['create_time', 'like', $createDay.'%']]);
628:         if($communityCount <= $giveIntegralConfig['integral_community_give_limit']) {
629:             // 使用依赖注入的方式创建用户账单仓库实例，并增加用户的积分账单
630:             app()->make(UserBillRepository::class)->incBill($uid, 'integral', 'lock', [
631:                 'link_id' => $communityInfo->community_id, // 图文内容id，关联的订单ID，用于记录积分的来源
632:                 'status' => 0, // 积分状态，这里假设0表示积分锁定，即还未完全发放
633:                 'title' => '种草发帖送积分', // 积分的描述，表明积分的来源是种草发帖
634:                 'number' => $giveIntegralConfig['integral_community_give'], // 赠送的积分数量
635:                 'mark' => $communityInfo->author->nickname.'【用户ID: '.$uid.'】于'.$createDay.', 成功发布第' . floatval($communityCount) . '篇种草, 赠送积分' . floatval($giveIntegralConfig['integral_community_give']), // 积分的备注信息
636:                 'balance' => $communityInfo->author->integral // 用户当前的积分余额，用于记录积分的变化
637:             ]);
638:         }
639:     }
