194:             $value->save();
195:             // 实例化产品仓库，用于获取和更新产品的整体库存信息
196:             $product = app()->make(ProductRepository::class)->getWhere(['product_id' => $value['product_id']]);
197:             // 如果找到了对应的产品信息
198:             if ($product) {
199:                 // 更新产品的库存数量
200:                 $product->stock = $product->stock + $num;
201:                 $product->save();
202:             }
203:         }
204:     }
