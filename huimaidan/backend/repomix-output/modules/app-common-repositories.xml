425:         // 下载并获取封面图片路径
426:         $coverImg = './public' . $DownloadImageService->downloadImage($room['cover_img'], 'def', '', 1)['path'];
427:         // 下载并获取分享图片路径
428:         $shareImg = './public' . $DownloadImageService->downloadImage($room['share_img'], 'def', '', 1)['path'];
429:         // 下载并获取Feed流图片路径
430:         $feedsImg = './public' . $DownloadImageService->downloadImage($room['feeds_img'], 'def', '', 1)['path'];
431: 
432:         // 准备直播房间相关信息
433:         $data = [
434:             'name' => $room['name'], // 直播间名称
435:             'coverImg' => $miniProgramService->material()->uploadImage($coverImg)->media_id, // 封面图片ID
436:             'startTime' => strtotime($room['start_time']), // 直播开始时间戳
437:             'endTime' => strtotime($room['end_time']), // 直播结束时间戳
438:             'anchorName' => $room['anchor_name'], // 主播姓名
439:             'anchorWechat' => $room['anchor_wechat'], // 主播微信号
440:             'shareImg' => $miniProgramService->material()->uploadImage($shareImg)->media_id, // 分享图片ID
441:             'feedsImg' => $miniProgramService->material()->uploadImage($feedsImg)->media_id, // Feed流图片ID
442:             'type' => $room['type'], // 直播类型
443:             'closeLike' => $room['close_like'], // 是否关闭点赞
444:             'closeGoods' => $room['close_goods'], // 是否关闭商品
445:             'closeComment' => $room['close_comment'], // 是否关闭评论
446: 
447:             'screenType' => $room['screen_type'], // 屏幕类型
448:             'closeShare' => $room['close_share'], // 是否关闭分享
449:             'closeKf' => $room['close_kf'], // 是否关闭客服
450:             'closeReplay' => $room['replay_status'] == 1 ? 0 : 1, // 是否关闭回放
451:             'isFeedsPublic' => $room['is_feeds_public'] == 1 ? 0 : 1, // 是否关闭Feed流公开
452:         ];
453: 
454:         // 删除本地临时图片文件
455:         @unlink($coverImg);
456:         @unlink($shareImg);
457:         @unlink($feedsImg);
458: 
459:         try {
460:             // 创建直播房间，并获取房间ID
461:             $roomId = $miniProgramService->miniBroadcast()->createLiveRoom($data)->roomId;
462:         } catch (Exception $e) {
463:             // 如果创建失败，抛出验证异常，异常信息为微信返回的错误信息
464:             throw new ValidateException($e->getMessage());
465:         }
466: 
467:         // 将发送短信的任务推入队列
468:         Queue::push(SendSmsJob::class, [
469:             'tempId' => 'BROADCAST_ROOM_CODE',
470:             'id' => $room['broadcast_room_id']
471:         ]);
472: 
473:         // 返回创建的直播房间ID
474:         return $roomId;
475:     }
