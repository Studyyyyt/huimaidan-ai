 39:     /**
 40:      * 获取列表数据
 41:      *
 42:      * 根据给定的条件数组 $where、页码 $page 和每页数据数量 $limit，查询并返回符合条件的数据列表。
 43:      * 此方法主要用于数据的分页查询，通过 dao 层的 search 方法进行查询，首先根据条件进行筛选，
 44:      * 然后按照佣金级别升序、创建时间降序进行排序。最后，根据页码和每页数据数量进行分页，返回查询结果。
 45:      *
 46:      * @param array $where 查询条件数组
 47:      * @param int $page 当前页码
 48:      * @param int $limit 每页数据数量
 49:      * @return array 返回包含列表数据和总条数的数组
 50:      */
 51:     public function getList(array $where, $page, $limit)
 52:     {
 53:         // 根据条件进行查询，并按照佣金级别升序、创建时间降序排序
 54:         $query = $this->dao->search($where)->order('brokerage_level ASC,create_time DESC');
 55: 
 56:         // 统计符合条件的数据总条数
 57:         $count = $query->count();
 58: 
 59:         // 根据当前页码和每页数据数量进行分页查询，并获取查询结果
 60:         $list = $query->page($page, $limit)->select()->each(function ($item) {
 61:             $item->user_num = User::where([
 62:                 'brokerage_level' => $item->brokerage_level,
 63:                 'promoter_switch' => 1,
 64:                 'is_promoter' => 1
 65:             ])->count(); 
 66:         });
