2411:             $day = ($data['type'] == 1 ? '+ ' : '- ') . (int)$data['add_time'];
2412:             $endtime = ($user['svip_endtime'] && $user['is_svip'] != 0) ? $user['svip_endtime'] : date('Y-m-d H:i:s', time());
2413:             $is_svip = 1;
2414:             $svip_endtime = date('Y-m-d H:i:s', strtotime("$endtime  $day day"));
2415:             //结束时间小于当前 就关闭付费会员
2416:             if (strtotime($svip_endtime) <= time()) {
2417:                 $is_svip = 0;
2418:             }
2419:         } else {
2420:             $is_svip = 0;
2421:             $svip_endtime = date('Y-m-d H:i:s', time());
