540:     public function cartCheck(array $data,$userInfo)
541:     {
542:         // 检查是否为新团商品，如果不是，则抛出异常。
543:         /**
544:          * 1.是否有团ID
545:          *     1.1 有团，验证团是否满，状态是否可加入
546:          * 2.购买数量是否超过限制
547:          * 3.商品的限购库存
548:          * 4.原商品的库存
549:          * 5.限购数是否超出
550:          */
551:         if(!$data['is_new']) throw new ValidateException('拼团商品不可加入购物车');
552: 
553:         // 查询商品的购买限制等信息。
554:         $where = $this->dao->actionShow();
