2249:                 ]);
2250:                 $user->member->user_num--;
2251:                 $user->member->save();
2252: 
2253:                 $user->member_value = 0;
2254:             } else {
2255:                 $user->brokerage->user_num--;
2256:                 $user->brokerage->save();
2257: 
2258:             }
2259:             // 保存用户更新
2260:             $user->save();
2261:             // 如果是更新代理级别，删除相关的代理佣金记录
2262:             if ($type == 0) app()->make(UserBillRepository::class)->search(['category' => 'sys_brokerage'])->where('uid', $id)->delete();
2263:         });
