452:      *
453:      * @param array $formData 管理员当前的信息数据，用于填充表单的默认值。
454:      * @return Form|\think\response\View
455:      */
456:     public function editForm(array $formData)
457:     {
458:         // 通过路由生成编辑管理员信息的URL，用于表单的提交动作
459:         $form = Elm::createForm(Route::buildUrl('merchantAdminEdit')->build());
460: 
461:         // 设置表单的验证规则，包括管理员姓名和联系电话两个字段
462:         $form->setRule([
463:             // 管理员姓名字段，必填，用于输入管理员的姓名
464:             Elm::input('merchant_admin_id', '管理员ID：')->disabled(true),
465:             Elm::input('real_name', '管理员姓名：')->placeholder('请输入管理员姓名')->required('请输入管理员姓名'),
466:             // 联系电话字段，用于输入管理员的联系电话
467:             Elm::input('phone', '联系电话：')->placeholder('请输入联系电话')
468:         ]);
