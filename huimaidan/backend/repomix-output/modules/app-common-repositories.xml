4008:     public function merchantCartCheck(array $data, $userInfo, $touristUniqueKey = '')
4009:     {
4010:         $cart = null;
4011:         $where = $this->dao->productShow();
4012:         $where['product_id'] = $data['product_id'];
4013:         unset($where['is_gift_bag']);
4014:         $product = $this->dao->search(null, $where)->find();
4015: 
4016:         if (!$product) throw new ValidateException('商品已下架');
4017:         if ($product['once_min_count'] > 0 && $product['once_min_count'] > $data['cart_num'])
4018:             throw new ValidateException('[低于起购数:' . $product['once_min_count'] . ']' . mb_substr($product['store_name'], 0, 10) . '...');
4019:         if ($product['pay_limit'] == 1 && $product['once_max_count'] < $data['cart_num'])
4020:             throw new ValidateException('[超出单次限购数：' . $product['once_max_count'] . ']' . mb_substr($product['store_name'], 0, 10) . '...');
4021:         if ($product['pay_limit'] == 2) {
4022:             //如果长期限购
4023:             //已购买数量
4024:             $storeOrderRepository = app()->make(StoreOrderRepository::class);
4025:             if($userInfo) {
4026:                 $count = $storeOrderRepository->getMaxCountNumber($userInfo->uid, $product['product_id']);
4027:                 if (($data['cart_num'] + $count) > $product['once_max_count'])
4028:                     throw new ValidateException('[超出限购总数：' . $product['once_max_count'] . ']' . mb_substr($product['store_name'], 0, 10) . '...');
4029:             }
4030:         }
4031:         if ($product['type'] && !$data['is_new']) throw new ValidateException('虚拟商品不可加入购物车');
4032:         if ($product['type'] == self::DEFINE_TYPE_CARD && $data['cart_num'] != 1)
4033:             throw new ValidateException('卡密商品只能单个购买');
4034:         $value_make = app()->make(ProductAttrValueRepository::class);
4035:         $sku = $value_make->getOptionByUnique($data['product_attr_unique'], $data['product_id']);
4036:         if (!$sku) throw new ValidateException('SKU不存在');
4037:         //分销礼包
4038:         if ($product['is_gift_bag']) {
4039:             $config = systemConfig(['extension_status', 'promoter_type']);
4040:             if (!$config['extension_status']) throw new ValidateException('分销功能未开启');
4041:             if ($config['promoter_type']) throw new ValidateException('后台未开启礼包分销模式');
4042:             if (!$data['is_new']) throw new ValidateException('礼包商品不可加入购物车');
4043:             if ($data['cart_num'] !== 1) throw new ValidateException('礼包商品只能购买一个');
4044:             if($userInfo) {
4045:                 $extensionInfo = get_extension_info($userInfo);//获取用户是否可以分销以及是否内购
4046:                 if ($extensionInfo['isPromoter']) throw new ValidateException('您已经是分销员了');
4047:             }
4048:         }
4049:         //立即购买 限购
4050:         if ($data['is_new']) {
4051:             $cart_num = $data['cart_num'];
4052:         } else {
4053:             //加入购物车
4054:             //购物车现有
4055:             $_num = $this->productOnceCountCart($where['product_id'], $data['product_attr_unique'], $data['uid']);
4056:             $cart_num = $_num + $data['cart_num'];
4057:         }
4058:         if ($sku['stock'] < $cart_num) throw new ValidateException('库存不足');
4059:         //添加购物车
4060:         if (!$data['is_new']) {
4061:             $cart = app()->make(StoreCartRepository::class)->getCartByProductSku($data['product_attr_unique'], $data['uid'], $touristUniqueKey);
4062:         }
4063: 
4064:         return compact('product', 'sku', 'cart');
4065:     }
