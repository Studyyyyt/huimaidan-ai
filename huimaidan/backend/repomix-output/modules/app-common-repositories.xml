556:         $res = $this->dao->search($where)->find();
557:         // 如果商品信息不存在，则抛出异常。
558:         if(!$res) throw new ValidateException('商品已下架');
559: 
560:         // 检查购买数量是否超过单次购买限制。
561:         if($data['cart_num'] > $res['once_pay_count']) throw new ValidateException('购买数量超过单次限制');
562: 
563:         // 如果有拼团ID，检查拼团状态是否允许加入。
564:         if($data['group_buying_id']){
565:             $buging_make = app()->make(ProductGroupBuyingRepository::class);
566:             $group_status = $buging_make->checkGroupStatus($data['group_buying_id'],$userInfo);
567:             if(!$group_status) throw new ValidateException('不可加入此团');
568:         }
569: 
570:         // 查询商品的SKU信息。
571:         $make = app()->make(ProductAttrValueRepository::class);
572:         //$old_sku = $make->getWhere(['unique' => $data['product_attr_unique']]);
573:         //if($old_sku['stock'] < $res['cart_num']) throw new ValidateException('原商品库存不足');
574: 
575:         $sku_make = app()->make(ProductGroupSkuRepository::class);
576:         $sku = $sku_make->getWhere(['product_group_id' => $data['product_id'],'unique' => $data['product_attr_unique']]);
577:         // 检查商品限购数量是否充足。
578:         if($sku['stock'] < $data['cart_num']) throw new ValidateException('商品限购数量不足');
579: 
580:         // 如果商品有限购数量，检查购买数量是否超过限购数量。
581:         if($res['pay_count'] !== 0 ) {
582:             if($data['cart_num'] > $res['pay_count']) throw new ValidateException('购买数量超过活动限制');
583:             $order_make = app()->make(StoreOrderRepository::class);
584:             $where = ['product_id' => $res['product_id'], 'product_type' => 4];
585:             // 计算用户已购买的数量，检查是否超过限购数量。
586:             $count = (int)$order_make->getTattendCount($where, $userInfo->uid)->sum('product_num');
587:             if(($count + $data['cart_num']) > $res['pay_count']) throw new ValidateException('购买数量超过活动限制');
588:         }
589: 
590:         // 准备返回的商品、SKU和购物车信息。
591:         $product = $res['product'];
592:         $cart = null;
593: 
594:         // 返回验证后的商品信息。
595:         return compact('product','sku','cart');
596:     }
