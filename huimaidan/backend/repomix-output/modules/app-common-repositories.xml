 961:                 // 实例化品类仓库，用于查询子品类ID
 962:                 $storeCategoryRepository = app()->make(StoreCategoryRepository::class);
 963:                 // 获取所有子品类ID，并合并原品类ID
 964:                 $cateId = $storeCategoryRepository->selectChildrenId($ids);
 965:                 $cateId = array_merge($cateId, $ids);
 966:                 // 实例化产品仓库，查询属于这些品类ID的产品
 967:                 $query = app()->make(ProductRepository::class)->getSearch([])->whereIn('cate_id', $cateId);
 968:                 // 定义查询的字段
 969:                 $field = 'product_id,store_name,image,stock,price,sales,cate_id';
 970:                 // 计算产品总数
 971:                 $count = $query->count();
