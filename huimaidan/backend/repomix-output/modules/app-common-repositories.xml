308:     /**
309:      * 根据用户ID和条件获取用户的MSN信息
310:      *
311:      * 本函数用于查询指定用户ID的MSN相关信息。支持根据商家ID和服務ID进行过滤查询，
312:      * 提供分页功能，以满足前端或业务需求的分批获取数据。
313:      *
314:      * @param int $uid 用户ID，用于指定查询哪个用户的MSN信息。
315:      * @param string $page 分页参数，指定当前页码。
316:      * @param string $limit 分页参数，指定每页显示的记录数。
317:      * @param int|null $merId 商家ID，可选参数，用于过滤属于特定商家的MSN信息。
318:      * @param int|null $serviceId 服务ID，可选参数，用于过滤属于特定服务的MSN信息。
319:      * @return array 返回包含记录总数和用户MSN信息列表的数组。
320:      */
321:     public function getUserMsn(int $uid, $page, $limit, ?int $merId = null, ?int $serviceId = null)
322:     {
323:         // 初始化查询条件
324:         $where['uid'] = $uid;
325: 
326:         // 如果提供了商家ID，则添加到查询条件中
327:         if ($merId) $where['mer_id'] = $merId;
328: 
329:         // 如果提供了服务ID，则添加到查询条件中
330:         if ($serviceId) $where['service_id'] = $serviceId;
331: 
332:         // 构建查询对象，并设置排序方式
333:         $query = $this->search($where)->order('service_log_id DESC');
334: 
335:         // 计算符合条件的记录总数
336:         $count = $query->count();
337: 
338:         // 执行分页查询，并加载关联数据（用户、服务信息）以及附加MSN信息
339:         $list = $query->page($page, $limit)->with(['user', 'service'])->append(['msn_info'])->select();
340: 
341:         // 返回记录总数和查询结果列表
342:         return compact('count', 'list');
343:     }
