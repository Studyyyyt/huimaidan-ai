2435:             'admin_id' => $adminId,
2436:             'end_time' => $svip_endtime,
2437:             'other' => $user->is_svip == -1 ? 'first' : '',
2438:         ];
2439: 
2440:         Db::transaction(function () use ($user, $res, $is_svip, $svip_endtime, $make) {
2441:             $make->create($res);
2442:             $user->is_svip = $is_svip;
