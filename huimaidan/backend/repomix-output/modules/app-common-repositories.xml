129:      * 删除组织
130:      *
131:      * @param integer $id
132:      * @return void
133:      */
134:     public function delete(int $id)
135:     {
136:         $info = $this->dao->get($id);
137:         if (!$info) {
138:             throw new ValidateException('记录不存在!');
139:         }
140:         if ($this->dao->hasChild($id)) {
