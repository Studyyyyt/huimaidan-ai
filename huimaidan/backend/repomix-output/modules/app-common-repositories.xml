 58:     public function top($date, $merId = '')
 59:     {
 60:         $adminId = app('request')->adminId() ?: '';
 61:         [$cacheky, $cacheTags] = CacheService::setWithTags(
 62:             CacheService::ANALYTICS_ORDER_TOP,
 63:             compact('merId','date', 'adminId')
