217:     /**
218:      * 分页获取数据列表
219:      *
220:      * 本函数用于根据指定的页码和每页数据量来获取数据列表，并同时返回数据总数。
221:      * 这样可以在前端实现分页功能，展示数据时既可以知道总数据量，也可以根据页码获取对应页的数据。
222:      *
223:      * @param int $page 当前页码，用于指定要获取哪一页的数据。
224:      * @param int $limit 每页的数据量，用于指定每页显示多少条数据。
225:      * @return array 返回包含数据列表和数据总数的数组。
226:      */
227:     public function page(int $page, int $limit)
228:     {
229:         // 根据页码和每页数据量进行分页查询，并隐藏某些字段，按创建时间降序排序
230:         $list = $this->dao->page($page, $limit)->hidden(['fields', 'sort'])->order('create_time DESC')->select();
231: 
232:         // 统计总数据量
233:         $count = $this->dao->count();
234: 
235:         // 将数据总数和数据列表一起返回
236:         return compact('count', 'list');
237:     }
