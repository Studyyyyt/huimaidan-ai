 973:                 $list = $query->page($page, $limit)->setOption('field',[])->field($field)->select();
 974:                 break;
 975:             case 12: // 商户优惠券
 976:                 // 如果商户ID为空，抛出异常
 977:                 if (empty($ids)) throw new ValidateException('商户信息不存在');
 978:                 // 实例化商户仓库，用于查询商户信息
 979:                 $make = app()->make(MerchantRepository::class);
 980:                 // 定义查询字段
 981:                 $field = 'mer_id,category_id,type_id,mer_name,mer_phone,is_trader';
 982:                 // 带上关联信息查询商户，并根据商户ID筛选
 983:                 $with = ['merchantType','merchantCategory'];
 984:                 $query = $make->search([])->whereIn($make->getPk(),$ids)->with($with);
 985:                 // 计算商户总数
 986:                 $count = $query->count();
 987:                 // 分页查询商户，并指定查询字段
 988:                 $list = $query->page($page, $limit)->setOption('field',[])->field($field)->select();
 989:                 break;
 990:             default:
 991:                 // 如果优惠券类型不匹配任何条件，不执行任何操作
 992:                 break;
