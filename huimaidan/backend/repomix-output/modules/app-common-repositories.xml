323:      * @throws ValidateException 如果城市ID不是数组，则抛出验证异常。
324:      */
325:     public function settleFree($data,$id)
326:     {
327:         // 遍历数据集，处理每个配送区域的信息
328:         foreach ($data as $v){
329:             // 检查城市ID是否为数组，确保数据格式正确
330:             if (isset($v['city_id']) && !is_array($v['city_id'])) {
331:                 throw new ValidateException('包邮参数类型错误');
332:             }
333:             // 将城市ID转换为字符串格式，用于后续处理
334:             $city = '/'.implode('/',$v['city_id']).'/';
335:             // 构建免费配送信息数组
336:             $free[] = [
337:                 'temp_id' => $id,
338:                 'city_id' => $city,
339:                 'number' => $v['number'],
340:                 'price' => $v['price']
341:             ];
342:         }
343:         // 返回处理后的免费配送信息数组
344:         return $free;
345:     }
