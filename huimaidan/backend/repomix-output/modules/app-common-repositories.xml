 73:      * 本函数通过遍历给定的配置数组，针对每个配置项调用getComponent方法，
 74:      * 并将结果收集到一个数组中返回。这样做的目的是为了根据不同的配置和商家ID，
 75:      * 组装出一系列的组件规则。
 76:      *
 77:      * @param array $configs 配置数组，包含需要生成组件的配置信息
 78:      * @param string $merId 商家ID，用于生成特定商家的组件规则
 79:      * @return array 返回包含所有组件的数组
 80:      */
 81:     public function getRule(array $configs, $merId)
 82:     {
 83:         // 初始化一个空数组，用于存放遍历过程中生成的组件
 84:         $components = [];
 85: 
 86:         // 遍历配置数组，针对每个配置生成一个组件
 87:         foreach ($configs as $config) {
 88:             // 调用getComponent方法生成组件，并将结果添加到组件数组中
 89:             $component = $this->getComponent($config, $merId);
 90:             $components[] = $component;
 91:         }
 92: 
 93:         // 返回包含所有组件的数组
 94:         return $components;
 95:     }
