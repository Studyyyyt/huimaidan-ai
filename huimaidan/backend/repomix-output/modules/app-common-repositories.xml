282:     /**
283:      * 检查商家令牌的有效性
284:      *
285:      * 本函数用于验证传入的商家令牌是否有效。它首先检查令牌是否存在缓存中，
286:      * 如果不存在，则抛出一个表示令牌无效的异常。如果令牌存在缓存中，
287:      * 它将进一步检查令牌是否过期。如果令牌过期，则同样抛出一个表示令牌过期的异常。
288:      * 这样做的目的是为了确保只有有效的令牌才能用于授权和访问受保护的资源。
289:      *
290:      * @param string $token 商家令牌。这是一个用于标识和验证商家的唯一字符串。
291:      * @throws AuthException 如果令牌无效或过期，则抛出此异常。
292:      */
293:     public function checkToken(string $token)
294:     {
295:         // 检查缓存中是否存在指定的商家令牌
296:         $has = Cache::has('mer_' . $token);
297:         // 如果令牌不存在于缓存中，则抛出无效令牌异常
298:         if (!$has)
299:             throw new AuthException('无效的token');
300: 
301:         // 获取商家令牌的缓存时间
302:         $lastTime = Cache::get('mer_' . $token);
303:         // 检查令牌是否过期，如果过期则抛出异常
304:         if (($lastTime + (intval(Config::get('admin.token_valid_exp', 15))) * 60) < time())
305:             throw new AuthException('token 已过期，请重新登录');
306:     }
