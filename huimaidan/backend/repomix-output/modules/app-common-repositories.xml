1145:      * 验证码键的生成结合了微秒时间和随机数，以确保唯一性。
1146:      * 验证码在缓存中的有效期通过配置文件设定，以分钟为单位。
1147:      *
1148:      * @param string $code 登录验证码
1149:      * @return string 生成的验证码键
1150:      */
1151:     public function createLoginKey(string $code)
1152:     {
1153:         // 生成一个唯一的验证码键，基于当前微秒时间戳和随机数
1154:         $key = uniqid(microtime(true), true);
1155: 
1156:         // 将验证码与键关联，存储到缓存中，并设定过期时间
1157:         // 缓存有效期通过配置文件获取，默认为5分钟
1158:         Cache::set('am_captcha' . $key, $code, Config::get('admin.captcha_exp', 5) * 60);
1159: 
1160:         // 返回生成的验证码键
1161:         return $key;
1162:     }
