301:         $where['id'] = $id;
302:         ksort($where);
303:         $cache_unique = 'get_sys_diy_' . md5(json_encode($where));
304:         $data = Cache::remember($cache_unique,function()use($merId,$id,$where){
305:             $diyInfo = $this->dao->getWhere($where);
306:             if ($diyInfo) {
307:                 if ($diyInfo['mer_id'] != $merId && !$diyInfo['is_default']) throw new ValidateException('模板不存在或不属于您');
