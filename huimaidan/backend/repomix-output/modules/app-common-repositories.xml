 822:     /**
 823:      * 解锁商户冻结资金
 824:      * 当商户的冻结资金满足特定条件时，本函数用于处理资金的解锁操作。它首先检查是否有相应的冻结资金记录，
 825:      * 如果没有，则直接解冻资金；如果有，则通过退款方式处理资金解锁。
 826:      *
 827:      * @param int $merId 商户ID，用于标识商户
 828:      * @param string $orderType 订单类型，用于区分不同类型的订单
 829:      * @param int $orderId 订单ID，与订单类型一起用于查询冻结资金记录
 830:      * @param float $money 解锁的资金金额，如果小于等于0，则不执行任何操作
 831:      */
 832:     public function subLockMoney(int $merId, string $orderType, int $orderId, float $money = 0)
 833:     {
 834:         Log::info('订单退款解冻商户冻结资金1：'.var_export([$merId,$orderType, 'order',
 835:                 $orderId, $money],true));
 836:         // 通过依赖注入获取用户账单仓库实例
 837:         $make = app()->make(UserBillRepository::class);
 838:         $link_id = ($orderType === 'order' ? 1 : 2) . $orderId;
 839:         // 查询是否有对应的冻结资金记录
 840:         $bill = $make->search([
 841:             'category' => 'mer_lock_money',
 842:             'type' => $orderType,
 843:             'mer_id' => $merId,
 844:             'link_id' => $link_id,
 845:             'status' => 0
 846:         ])->find();
 847:         // 如果没有对应的冻结资金记录，则直接解冻资金
 848:         if (!$bill) {
 849:             // 检查资金金额是否有效，如果小于等于0，则直接返回，不执行任何操作
 850:             if ($money <= 0) return;
 851:             $merComputedMoney = $make->search([
 852:                 'category' => 'mer_computed_money',
 853:                 'type' => $orderType,
 854:                 'mer_id' => $merId,
 855:                 'link_id' => $orderId,
 856:                 'status' => 0
 857:             ])->find();
 858:             // 是否有待解冻的资金记录
 859:             if($merComputedMoney) {
 860:                 // 更新待解冻的资金记录为已失效，防止重复计算
 861:                 $merComputedMoney->status = -1;
 862:                 $merComputedMoney->save();
 863:                 // 存在待解冻的资金记录，通过退款方式处理资金解锁
 864:                 $make->decBill($merId, 'mer_refund_money', $orderType, [
 865:                     'link_id' => $link_id,
 866:                     'mer_id' => $merId,
 867:                     'status' => 1,
 868:                     'title' => '商户冻结余额退款',
 869:                     'number' => $money,
 870:                     'mark' => '商户冻结余额退款',
 871:                     'balance' => 0
 872:                 ]);
 873:             } else {
 874:                 // 不存在待解冻的资金记录，直接减余额
 875:                 $this->dao->subMoney($merId, $money);
 876:             }
 877:         } else {
 878:             // 如果有对应的冻结资金记录，则通过退款方式处理资金解锁
 879:             $make->decBill($merId, 'mer_refund_money', $orderType, [
 880:                 'link_id' => $link_id,
 881:                 'mer_id' => $merId,
 882:                 'status' => 1,
 883:                 'title' => '商户冻结余额退款',
 884:                 'number' => $money,
 885:                 'mark' => '商户冻结余额退款',
 886:                 'balance' => 0
 887:             ]);
 888:         }
 889:     }
