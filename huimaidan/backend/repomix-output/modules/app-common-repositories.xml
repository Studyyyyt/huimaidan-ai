 793: 
 794:         // 根据优惠券类型处理不同的逻辑
 795:         switch ($data['type']) {
 796:             case 1: // 商品优惠券
 797:                 // 提取产品ID，去除无关数据
 798:                 $products = array_column((array)$data['product_id'], 'id');
 799:                 unset($data['product_id']);
