336:         }
337: 
338:         foreach ($data as $key => $value) {
339:             try {
340:                 // 尝试根据$key获取菜单的父ID，如果失败则处理特别情况
341:                 $result = $this->dao->getMenuPid($key, $isMer, 0, $isAgent);
342:                 if (!$result) {
343:                     // 处理新增菜单项的特殊情况，包括附加权限和自定义路由
344:                     $route = $key;
345:                     $isAppend = 0;
346:                     if (substr($key, 0, 7) === 'append_') {
347:                         $isAppend = 1;
348:                         $route = substr($key, 7);
349:                     }
350:                     // 再次尝试获取菜单的父ID，如果仍然失败且$key不是'self'，则记录未找到菜单的信息并跳过当前循环
351:                     $result = $this->dao->getMenuPid($route, $isMer, 1, $isAgent);
352:                     if (!$result && $key !== 'self') {
353:                         printf($this->styles['info'], '未找到菜单: ' . $key);
354:                         echo PHP_EOL;
355:                         continue;
356:                     } else {
357:                         // 创建新的菜单项
358:                         $result = $this->dao->create([
359:                             'pid' => $key == 'self' ? 0 : $result['menu_id'],
360:                             'path' => $key == 'self' ? '/' : $result['path'] . $result['menu_id'] . '/',
361:                             'menu_name' => $isAppend ? '附加权限' : '权限',
362:                             'route' => $key,
363:                             'is_mer' => $isMer,
364:                             'is_menu' => 0,
365:                             'is_agent' => $isAgent
366:                         ]);
367:                     }
368:                 }
369:                 // 将处理后的菜单项数据合并到结果集中
370:                 $res = array_merge($res, $this->createSlit($isMer, $result['menu_id'], $result['path'], $value, $isAgent));
371:             } catch (\Exception $exception) {
372:                 // 抛出异常，处理菜单创建过程中的错误
373:                 throw new Exception($key);
374:             }
375:         }
376:         // 插入处理后的菜单项数据到数据库，并返回处理的菜单项数量
377:         if (!empty($res)) $this->dao->insertAll($res);
378:         return count($res);
379:     }
380: 
381:     /**
382:      * 新增权限数据整理
383:      * @param int $isMer
384:      * @param int $menuId
385:      * @param string $path
386:      * @param array $data
387:      * @return array
388:      * @author Qinii
389:      * @day 3/18/22
390:      */
391:     public function createSlit(int $isMer, int $menuId, string $path, array $data, int $isAgent)
392:     {
393:         $arr = [];
394:         try {
395:             foreach ($data as $k => $v) {
396:                 $result = $this->dao->getWhere(['route' => $v['route'], 'pid' => $menuId]);
397:                 if (!$result) {
398:                     $arr[] = [
399:                         'pid' => $menuId,
400:                         'path' => $path . $menuId . '/',
401:                         'menu_name' => $v['menu_name'],
402:                         'route' => $v['route'],
403:                         'is_mer' => $isMer,
404:                         'is_menu' => 0,
405:                         'params' => $v['params'] ?? [],
406:                         'is_agent' => $isAgent,
407:                     ];
408:                     if ($this->prompt == 's') {
409:                         printf($this->styles['success'], '新增权限: ' . $v['menu_name'] . ' [' . $v['route'] . ']');
410:                         echo PHP_EOL;
411:                     }
412:                 }
413:             }
414:             return $arr;
415:         } catch (\Exception $exception) {
416:             halt($isMer, $menuId, $path, $data, $isAgent);
417:         }
418:     }
419: 
420:     /**
421:      * 快捷搜索
422:      * @param int $isMer 是否商户
423:      * @param string $keyWord 关键词
424:      * @return array
425:      * @throws DataNotFoundException
426:      * @throws DbException
427:      * @throws ModelNotFoundException
428:      * FerryZhao 2024/4/3
429:      */
430:     public function getMenusList($isMer, $keyWord)
431:     {
432:         $pre = '/' . config('admin.' . ($isMer ? 'merchant' : 'admin') . '_prefix');
433:         $configRepository = app()->make(ConfigRepository::class);
434:         $configData = $configRepository->getSearch([])
435:             ->where('user_type', $isMer)
436:             ->whereLike('config_name', '%' . $keyWord . '%')
437:             ->field('config_id,config_name,config_classify_id')
438:             ->with(['classConfig.parent'])->select()->toArray();
439:         $configMenus = [];
440:         $configMenusPath = [];
441:         $param = [];
442:         if ($configData) {
443:             foreach ($configData as $configDatum) {
444:                 if ($_p = $this->valSpecial($isMer, $configDatum['config_name'])) {
445:                     $configMenus[$_p] = [
446:                         'title' => $configDatum['config_name'],
447:                         'path' => $_p,
448:                     ];
449:                 } else if ($classConfig = $configDatum['classConfig']) {
450:                     $classConfigId = !empty($classConfig['parent']) ? $classConfig['parent']['config_classify_id'] : $classConfig['config_classify_id'];
451:                     $classifyKey = !empty($classConfig['parent']) ? $classConfig['parent']['classify_key'] : $classConfig['classify_key'];
452:                     $title = !empty($classConfig['parent']) ? $classConfig['parent']['classify_name'] : $classConfig['classify_name'];
453:                     $path = '/systemForm/Basics/' . $classifyKey;
454:                     $configMenus[$classConfigId] = [
455:                         'title' => $title,
456:                         'path' => $path,
457:                     ];
458:                     $param[$path] = '/' . $classConfig['config_classify_id'];
459:                 }
460:             }
461:             $configMenus = array_values($configMenus);
462:             $configMenusPath = array_column($configMenus, 'path');
463:         }
464:         $menuData = $this->dao->getSearch([])
465:             ->where('is_mer', $isMer)
466:             ->where('is_menu', 1)
467:             ->where('is_show', 1)
468:             ->where(function ($query) use ($keyWord, $configMenusPath) {
469:                 $query->whereLike('menu_name', '%' . $keyWord . '%')->whereOr('route', 'in', $configMenusPath);
470:             })->select()->append(['parents', 'child'])->toArray();
471:         $menus = [];
472:         foreach ($menuData as $datum) {
473:             if (in_array($datum['route'], $this->unsetConfigArray)) {
474:                 continue;
475:             }
476:             if (!empty($datum['child'])) {
477:                 continue;
478:             }
479:             $title = '';
480:             if ($parents = $datum['parents']) {
481:                 $path = explode('/', trim($datum['path'], '/'));
482:                 $parents = array_combine(array_column($parents, 'pid'), $parents);
483:                 $menu = $parents[0]['menu_name'] ?? '';
484:                 foreach ($path as $item) {
485:                     if (isset($parents[$item])) {
486:                         $menu .= ' - ' . $parents[$item]['menu_name'];
487:                     }
488:                 }
489:                 $menu .= ' - ' . $datum['menu_name'];
490:                 $title = trim($menu, '-');
491:             }
492:             $menus[] = [
493:                 'path' => $pre . $datum['route'] . ($param[$datum['route']] ?? ''),
494:                 'title' => $title ?: $datum['menu_name'],
495:             ];
496:         }
497:         return compact('menus');
498:     }
499: }
