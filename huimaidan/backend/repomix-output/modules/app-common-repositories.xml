 893:         }
 894: 
 895:         // 如果优惠券有类型限制，转换使用时间范围为数组格式
 896:         if ($couponInfo['coupon_type']) {
 897:             $couponInfo['use_start_time'] = [$couponInfo['use_start_time'], $couponInfo['use_end_time']];
 898:         }
 899: 
 900:         // 初始化产品ID列表，用于后续处理
 901:         $couponInfo['product_id'] = [];
 902: 
 903:         // 如果有指定产品，根据优惠券类型处理产品信息
 904:         if (count($couponInfo['product'])) {
 905:             if ($couponInfo['type'] == 11) {
 906:                 // 对于类型为11的优惠券，将产品ID收集到cate_ids数组中
 907:                 foreach ($couponInfo['product'] as $product) {
 908:                     $couponInfo['cate_ids'][] = $product['product_id'];
 909:                 }
 910:             } else {
 911:                 // 对于其他类型的优惠券，获取商家信息，并将商家ID和图片信息收集到mer_ids数组中
 912:                 $productIds = array_column($couponInfo['product'], 'product_id');
 913:                 $make = app()->make(MerchantRepository::class);
 914:                 $products = $make->merIdByImage($productIds);
 915:                 foreach ($products as $product) {
 916:                     $couponInfo['mer_ids'][] = ['id' => $product['mer_id'], 'src' => $product['mer_avatar']];
 917:                 }
 918:             }
 919:         }
