130:      * 它结合了商家ID、当前时间和订单金额等信息，创建了一个唯一且难以伪造的键名，
131:      * 同时也构造了订单的参数数组，包含了订单的状态、支付方式等重要信息。
132:      *
133:      * @param string $merId 商家ID，用于区分不同商家的订单
134:      * @param array $data 包含订单价格和支付方式等信息的数据数组
135:      * @return array 返回包含键名和参数的数组，供其他部分使用
136:      */
137:     public function delivery($merId, $data)
138:     {
139:         // 生成唯一的键名，用于标识和存储订单信息
140:         $key = 'Delivery_'.$merId.'_'.md5(date('YmdH',time()).$data['price']);
141: 
142:         // 初始化订单详细信息数组，这里仅包含订单价格
143:         $arr = ['price' => $data['price']];
144: 
145:         // 构造订单参数数组，包含了订单的各种状态和信息
146:         $param = [
147:             'status' => 0, // 订单状态，初始为0表示未处理
148:             'is_del' => 0, // 订单删除状态，0表示未删除
149:             'mer_id' => $merId, // 商家ID
150:             'type'   => 20, // 订单类型，这里假设为20表示配送订单
151:             'meal_id'=> 0, // 餐品ID，初始为0，可能根据实际业务进行修改
152:             'pay_type' => $data['pay_type'], // 支付方式，从$data中获取
153:             'attach' => 'meal', // 订单附加信息，这里标识为meal
154:             'order_info' => json_encode($arr,JSON_UNESCAPED_UNICODE), // 将订单详细信息编码为JSON格式
155:             'pay_price' => $data['price'], // 订单支付价格，从$data中获取
156:         ];
157: 
158:         // 返回包含键名和参数的数组
159:         return compact('key', 'param');
