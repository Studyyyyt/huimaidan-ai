 504:     /**
 505:      * 创建优惠券数据
 506:      *
 507:      * 本函数用于根据传入的优惠券信息和用户ID，生成用于存储的优惠券数据数组。
 508:      * 这包括了优惠券的基本信息，以及根据不同的优惠券类型和获取方式，设定相应的有效时间。
 509:      *
 510:      * @param StoreCoupon $coupon 优惠券对象，包含优惠券的详细信息
 511:      * @param int $uid 用户ID，表示该优惠券归属的用户
 512:      * @param string $type 优惠券的发放类型，默认为'send'，表示发放类型的枚举值
 513:      * @return array 返回包含优惠券所有必要信息的数据数组
 514:      */
 515:     public function createData(StoreCoupon $coupon, $uid, $type = 'send')
 516:     {
 517:         // 初始化优惠券数据数组，包含基本属性
 518:         $data = [
 519:             'uid' => $uid,
 520:             'coupon_title' => $coupon['title'],
 521:             'coupon_price' => $coupon['coupon_price'],
 522:             'use_min_price' => $coupon['use_min_price'],
 523:             'type' => $type,
 524:             'coupon_id' => $coupon['coupon_id'],
 525:             'mer_id' => $coupon['mer_id']
 526:         ];
 527: 
 528:         // 根据优惠券的获取类型，设置不同的有效时间
 529:         if ($coupon['send_type'] == self::GET_COUPON_TYPE_SVIP) {
 530:             // SVIP获取的优惠券，有效时间为当前月的第一天到下个月的最后一天
 531:             $data['start_time'] = date('Y-m-d 00:00:00', time());
 532:             $firstday = date('Y-m-01', time());
 533:             $data['end_time'] = date('Y-m-d 23:59:59', strtotime("$firstday +1 month -1 day"));
 534:         } else {
 535:             // 根据优惠券类型，设置固定有效时间或即时生效并设定过期时间
 536:             if ($coupon['coupon_type'] == 1) {
 537:                 // 固定有效期的优惠券，使用优惠券的开始和结束时间
 538:                 $data['start_time'] = $coupon['use_start_time'];
 539:                 $data['end_time'] = $coupon['use_end_time'];
 540:             } else {
 541:                 // 即时生效的优惠券，有效期为当前时间往后推设定的天数
 542:                 $data['start_time'] = date('Y-m-d H:i:s');
 543:                 $data['end_time'] = date('Y-m-d H:i:s', strtotime("+ {$coupon['coupon_time']}day"));
 544:             }
 545:         }
 546: 
 547:         // 返回构建好的优惠券数据数组
 548:         return $data;
 549:     }
