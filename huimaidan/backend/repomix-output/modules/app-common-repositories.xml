563:      * @param int $id 主键ID，用于唯一标识SPU。
564:      * @param int|null $merId 商户ID，可选，用于指定特定商户的数据。
565:      * @param array $data 包含更新信息的数据数组。
566:      * @return mixed 返回更新排序后的结果。
567:      * @throws ValidateException 如果数据不存在，则抛出此异常。
568:      */
569:     public function updateSort(int $id, ?int $merId, array $data)
570:     {
571:         // 根据主键ID准备查询条件
572:         $where[$this->dao->getPk()] = $id;
573:         // 如果提供了商户ID，则加入查询条件
574:         if ($merId) $where['mer_id'] = $merId;
575: 
576:         // 根据条件查询数据
577:         $ret = $this->dao->getWhere($where);
578:         // 如果查询结果为空，则抛出异常
579:         if (!$ret) throw new  ValidateException('数据不存在');
580: 
581:         // 更新产品的相关信息
582:         app()->make(ProductRepository::class)->update($ret['product_id'], $data);
583: 
584:         // 制造SPU仓库实例，用于更新SPU的排序信息
585:         $make = app()->make(SpuRepository::class);
586:         // 更新SPU的排序信息，并返回结果
587:         return $make->updateSort($ret['product_id'], $id, 2, $data);
588:     }
589: 
590:     /**
591:      * 切换商品预售价状态
592:      *
593:      * 该方法用于更新商品的预售价状态，并触发相应的事件。
594:      * 它首先验证数据存在性，然后更新数据，并发送通知给相关的商户。
595:      * 主要用于处理商品的上架、下架以及审核状态的变更。
596:      *
597:      * @param int $id 商品ID
598:      * @param array $data 包含商品状态的数据
599:      * @throws ValidateException 如果商品数据不存在
600:      */
601:     public function switchStatus($id, $data)
602:     {
603:         // 将状态值复制到product_status字段，以保持数据一致性
604:         $data['product_status'] = $data['status'];
605: 
606:         // 尝试获取商品信息
607:         $ret = $this->dao->get($id);
608:         // 如果商品信息不存在，则抛出异常
609:         if (!$ret)
610:             throw new ValidateException('数据不存在');
611: 
612:         // 在更新商品状态前触发预售状态变更的前置事件
613:         event('product.presellStatus.before', compact('id', 'data'));
614: 
615:         // 更新商品状态
616:         $this->dao->update($id, $data);
617: 
618:         // 在更新商品状态后触发预售状态变更的事件
619:         event('product.presellStatus', compact('id', 'data'));
620: 
621:         // 根据商品状态确定通知类型
622:         $type = ProductRepository::NOTIC_MSG[$data['status']][2];
623:         // 构造通知消息
624:         $message = '您有1个预售'. ProductRepository::NOTIC_MSG[$data['status']]['msg'];
625: 
626:         // 发送通知给商户
627:         SwooleTaskService::merchant('notice', [
628:             'type' => $type,
629:             'data' => [
630:                 'title' => $data['status'] == -2 ? '下架提醒' : '审核结果',
631:                 'message' => $message,
632:                 'id' => $id
633:             ]
634:         ], $ret->mer_id);
635: 
636:         // 更新SPU的状态
637:         app()->make(SpuRepository::class)->changeStatus($id,2);
638:     }
639: }
