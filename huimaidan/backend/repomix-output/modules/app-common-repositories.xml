145:      * 然后在数据库事务中更新产品和相关的SKU信息。此外，它还处理了事件监听和通知。
146:      */
147:     public function edit(int $id,array $data)
148:     {
149:         // 组装产品信息数组
150:         $product = [
151:             'image' => $data['image'],
152:             'store_name' => $data['store_name'],
153:             'store_info' => $data['store_info'],
154:             'slider_image' => implode(',', $data['slider_image']),
155:             'temp_id' => $data['temp_id'],
156:             'unit_name' => $data['unit_name'],
157:             'sort' => $data['sort'],
158:             'guarantee_template_id'=>$data['guarantee_template_id'],
159:             'delivery_way' => implode(',',$data['delivery_way']),
160:             'delivery_free' => $data['delivery_free'],
161:         ];
162:         // 计算购买数量和虚构数量
163:         $slt = $this->sltNumber($data);
164:         // 组装活动信息数组
165:         $active = [
166:             'start_time' => $data['start_time'],
167:             'end_time' => $data['end_time'],
168:             'status' => 1,
