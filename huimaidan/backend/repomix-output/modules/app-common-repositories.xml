 97:      * @author Qinii
 98:      * @day 6/8/21
 99:      */
100:     public function create(int $uid)
101:     {
102:         /**
103:          *  用户昨天的签到情况,如果有就是连续签到，如果没有就是第一天签到
104:          *  根据签到天数计算签到积分等操作
105:          *  计算用户剩余积分
106:          *
107:          */
108:         $yesterday = date("Y-m-d",strtotime("-1 day"));
109:         $sign_num = ($this->getSign($uid,$yesterday) ?: 0) + 1;
110:         //签到规则计算
111:         $sign_task = $this->getDay($sign_num);
112:         $user = app()->make(UserRepository::class)->get($uid);
113:         $integral = $sign_task['sign_integral'];
114:         if ($user->is_svip > 0) {
115:             $makeInteres = app()->make(MemberinterestsRepository::class);
116:             $integral = $integral * $makeInteres->getSvipInterestVal($makeInteres::HAS_TYPE_SIGN);;
117:         }
118:         $user_make = app()->make(UserRepository::class);
119:         $user = $user_make->get($uid);
120:         $integral_ = $user['integral'] + $integral;
121:         $data = [
122:             'uid'      => $uid,
123:             'sign_num' => $sign_num,
124:             'number'   => $integral,
125:             'integral' => $integral_,
126:             'title'    =>   '签到',
127:         ];
128:         //增加记录
129:         $arr = [
130:             'status' => 1,
131:             'mark'   => '签到,获得积分'. $integral,
132:             'number' => $integral,
133:             'balance'=> $integral_,
134:         ];
135:         return Db::transaction(function() use($uid,$data,$user_make,$sign_task,$arr,$integral){
136:            $ret = $this->dao->create($data);
137:             $user_make->incIntegral($uid,$integral,'签到'.$sign_task['sign_day'],'sign_integral',$arr);
138:             app()->make(UserBrokerageRepository::class)->incMemberValue($uid, 'member_sign_num', $ret->sign_id);
139:             return compact('integral');
140:         });
141:     }
142: 
143:     /**
144:      * 获取列表数据
145:      *
146:      * 根据给定的条件数组、页码和每页的记录数，从数据库中检索并返回列表数据。
147:      * 这个方法主要用于处理数据的分页查询，支持根据条件进行筛选。
148:      *
149:      * @param array $where 查询条件数组，用于构建SQL查询的WHERE子句。
150:      * @param int $page 当前页码，用于计算查询的起始记录。
151:      * @param int $limit 每页的记录数，用于限制查询返回的记录数量。
152:      * @return array 返回包含 'count' 和 'list' 两个元素的数组，'count' 表示总记录数，'list' 表示当前页的记录列表。
153:      */
154:     public function getList(array $where,int $page,int $limit)
155:     {
156:         // 构建查询条件，根据创建时间降序排序
157:         $query = $this->dao->getSearch($where)->order('create_time DESC');
158: 
159:         // 计算满足条件的总记录数
160:         $count = $query->count();
161: 
162:         // 根据当前页码和每页的记录数，从查询结果中获取当前页的记录列表
163:         $list = $query->page($page,$limit)->select();
164: 
165:         // 将总记录数和当前页的记录列表作为一个数组返回
166:         return compact('count','list');
167:     }
168: 
169:     /**
170:      *  连续签到日期展示 1 - 7天
171:      *  是否签到
172:      *  累计签到数
173:      */
174:     public function info(int $uid = 0)
175:     {
176:         $is_sign = false;
177:         $sign_num = 0;
178:         $count = 0;
179:         $userInfo = [];
180:         if($uid) {
181:             $ret = $this->signStatus($uid);
182:             $is_sign = $ret['is_sign'];
183:             $sign_num = $ret['sign_num'];
184:             $userInfo = app()->make(UserRepository::class)->getWhere(['uid' => $uid],'uid,avatar,nickname,integral');
185:             $count = $this->dao->getSearch(['uid' => $uid])->count('*');
186:         }
187:         $title = $this->signConfig();
188:         return compact('userInfo','is_sign','sign_num','count','title');
189: 
190:     }
191: 
192:     /**
193:      * 获取签名配置
194:      *
195:      * 本函数用于获取签到配置的相关信息，特别是针对一周内每一天的签到标题。
196:      * 它首先通过依赖注入的方式创建了一个GroupRepository的实例，用于后续获取签到天数的配置。
197:      * 接着，利用GroupDataRepository来查询具体的签到标题数据，这些数据是根据签到天数配置来获取的，并且只包含状态为1（有效）的数据。
198:      * 最后，将查询结果转换为数组并返回，这个结果包含了签到标题在内的相关信息，而一些敏感或不必要的信息（如ID、创建时间等）被隐藏。
199:      *
200:      * @return array 返回包含签到配置信息的数组，特别是每一天的签到标题。
201:      */
202:     public function signConfig(){
203:         // 通过依赖注入创建GroupRepository实例，用于查询签到天数配置
204:         $group_make = app()->make(GroupRepository::class);
205:         // 根据ID获取签到天数配置
206:         $sign_day_config = $group_make->keyById('sign_day_config');
207: 
208:         // 通过依赖注入创建GroupDataRepository实例，用于查询签到标题数据
209:         $title = app()->make(GroupDataRepository::class)
210:             // 根据签到天数配置查询签到标题数据，并限制查询结果为最近7天
211:             ->getGroupDataWhere(0,$sign_day_config)
212:             // 筛选出状态为有效的数据
213:             ->where('status',1)
214:             // 限制查询结果数量为7条
215:             ->limit(7)
216:             // 隐藏某些字段
217:             ->hidden(['group_data_id','group_id','create_time','mer_id'])
218:             // 执行查询并转换为数组形式返回
219:             ->select()->toArray();
220: 
221:         // 返回查询结果
222:         return $title;
223:     }
224: 
225:     /**
226:      * 连续签到 获取 1- 7 天
227:      * @param $uid
228:      * @return array
229:      * @author Qinii
230:      * @day 6/10/21
231:      */
232:     public function signStatus($uid)
233:     {
234:         $day = date('Y-m-d',time());
235:         $sign_num = 0;
236:         $sign_num = $this->getSign($uid,$day);
237:         $is_sign = $sign_num ? 1 : 0;
238: 
239:         if($sign_num > 7){
240:             $sign_num = ($sign_num % 7);
241:             if(!$sign_num) $sign_num = 7;
242:         }
243: 
244:         if(!$is_sign){
245:             $yesterday = date("Y-m-d",strtotime("-1 day"));
246:             $sign_num = $this->getSign($uid,$yesterday) ?: 0;
247:             if($sign_num > 7){
248:                 $sign_num = ($sign_num % 7);
249:             }
250:         }
251:         return compact('is_sign','sign_num');
252:     }
253: 
254:     /**
255:      * 按月显示签到记录
256:      * @param array $where
257:      * @return array
258:      * @author Qinii
259:      * @day 6/10/21
260:      */
261:     public function month(array $where)
262:     {
263:         $group = $this->dao->getSearch($where)->field('FROM_UNIXTIME(unix_timestamp(create_time),"%Y-%m") as time')
264:             ->order('time DESC')->group('time')->select();
265:         $ret = [];
266:         foreach ($group as $k => $item){
267:             $ret[$k]['month'] = $item['time'];
268:             $query = $this->dao->getSearch($where)->field('title,number,create_time')->whereMonth('create_time',$item['time']);
269:             $ret[$k]['list'] = $query->order('create_time DESC')->select();
270:         }
271:         return $ret;
272:     }
273: }
