1115:     /**
1116:      * 验证验证码是否正确。
1117:      * 该方法用于校验用户输入的验证码是否与缓存中存储的验证码一致。如果不一致或验证码已过期，则抛出异常。
1118:      *
1119:      * @param string $key 验证码的唯一标识键，用于拼接缓存键名。
1120:      * @param string $code 用户输入的验证码。
1121:      * @throws ValidateException 如果验证码过期或输入错误，则抛出验证异常。
1122:      */
1123:     public function checkCode(string $key, string $code)
1124:     {
1125:         // 从缓存中获取存储的验证码
1126:         $_code = Cache::get('am_captcha' . $key);
1127:         // 如果缓存中没有验证码，表示验证码已过期，抛出异常
1128:         if (!$_code) {
1129:             throw new ValidateException('验证码过期');
1130:         }
1131:         // 比较用户输入的验证码和缓存中的验证码，不区分大小写
1132:         // 如果不一致，抛出验证码错误的异常
1133:         if (strtolower($_code) != strtolower($code)) {
1134:             throw new ValidateException('验证码错误');
1135:         }
1136:         // 验证码验证通过后，删除缓存中的验证码，防止重复使用
1137:         // 删除code
1138:         Cache::delete('am_captcha' . $key);
1139:     }
