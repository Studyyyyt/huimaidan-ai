360:         $cartData = [];
361: 
362:         // 遍历购物车中的商品
363:         foreach ($products as $item) {
364:             // 检查商品ID是否已存在，防止重复
365:             if (in_array($item['product_id'], $productId))
366:                 throw new ValidateException('套餐商品不能重复');
367:             // 检查商品ID是否为空
368:             if (!$item['product_id'])
369:                 throw new ValidateException('商品ID不能为空');
370:             // 检查商品SKU是否为空
371:             if (!$item['product_attr_unique'])
372:                 throw new ValidateException('ID: '. $item['product_id'] .',商品SKU不能为空');
373:             // 检查购买数量是否正确
374:             if ($item['cart_num'] != 1)
375:                 throw new ValidateException('套餐商品每单只能购买1件');
376:             if ($item['cart_num'] <= 0)
377:                 throw new ValidateException('购买数量有误');
378: 
379:             // 根据优惠套餐ID和商品ID检查商品是否在优惠套餐中
380:             $ret = $make->getWhere(['discount_id' => $discountId, 'product_id' => $item['product_id']]);
381:             if (!$ret) throw new ValidateException('商品ID:'.$item['product_id'].',不在套餐内');
382:             // 根据SKU信息检查商品是否在优惠套餐中
383:             $sku = $productSkuRepository->getWhere(
384:                 [
385:                     'unique' => $item['product_attr_unique'],
386:                     'active_product_id' => $ret['discount_product_id'],
387:                 ],
388:                 '*',
389:                 ['attrValue']
390:             );
391:             // 检查SKU是否存在于优惠套餐中
392:             if (!$sku)
393:                 throw new ValidateException('商品ID:'.$item['product_id'].'的SKU不在套餐内');
394:             // 检查商品库存是否充足
395:             if (!$sku['attrValue']['stock'])
396:                 throw new ValidateException('商品ID:'.$item['product_id'].'的库存不足');
397:             // 将商品ID添加到产品ID数组中
398:             $productId[] = $item['product_id'];
399: 
400:             // 设置购物车数据数组中的商品信息
401:             $item['uid'] = $userInfo->uid;
402:             $item['mer_id'] = $discountData['mer_id'];
403:             $item['product_type'] = 10;
404:             $item['source'] = 10;
405:             $item['source_id'] = $discountId;
406: 
407:             // 将商品数据添加到购物车数据数组中
408:             $cartData[] = $item;
409:         }
410:         // 如果优惠套餐类型为1，检查优惠套餐是否包含主商品
411:         if ($discountData['type'] == 1){
412:             if (!in_array($discountData['product_ids'], $productId))
413:                 throw new ValidateException('此套餐必须包含主商品');
414:         }
415:         // 返回符合条件的购物车商品数据数组
416:         return $cartData;
417:     }
418: 
419: }
