151: 
152:     /**
153:      * 根据组ID和可选的ID、商家ID以及表单数据生成表单对象。
154:      * 此方法主要用于创建或更新数据组的表单，根据不同的场景（是否存在商家ID）和操作类型（创建或更新）构建不同的表单URL。
155:      * 表单字段根据组的字段定义动态生成，支持多种字段类型，包括图像、多图像、分类、标签、选择、复选框、单选框、文件等。
156:      *
157:      * @param int $groupId 组ID，用于确定表单的字段定义。
158:      * @param int|null $id 可选的ID，用于确定是进行更新操作还是创建操作。
159:      * @param int|null $merId 商家ID，用于确定表单的URL路径和某些字段的选项。
160:      * @param array $formData 可选的表单数据数组，用于预填充表单。
161:      * @return Form 返回生成的表单对象，该对象包含了表单的规则、标题和初始数据。
162:      */
163:     public function form(int $groupId, ?int $id = null, ?int $merId = null, array $formData = []): Form
164:     {
165:         // 根据组ID获取组的字段定义
166:         $fields = app()->make(GroupRepository::class)->fields($groupId);
167: 
168:         // 根据是否存在商家ID和ID，构建不同的表单URL
169:         if (is_null($merId)) {
170:             $url = is_null($id)
171:                 ? Route::buildUrl('groupDataCreate', compact('groupId'))->build()
172:                 : Route::buildUrl('groupDataUpdate', compact('groupId', 'id'))->build();
173:         } else {
174:             $url = is_null($id)
175:                 ? Route::buildUrl('merchantGroupDataCreate', compact('groupId'))->build()
176:                 : Route::buildUrl('merchantGroupDataUpdate', compact('groupId', 'id'))->build();
177:         }
178: 
179:         // 创建表单对象并设置表单URL
180:         $form = Elm::createForm($url);
181: 
182:         // 初始化表单规则数组
183:         $rules = [];
184: 
185:         // 遍历组的字段定义，根据字段类型生成相应的表单规则
186:         foreach ($fields as $field) {
187:             $rule = null;
188:             if ($field['type'] == 'image') {
189:                 // 图像字段生成框架图像组件
190:                 $rule = Elm::frameImage($field['field'], $field['name'], '/' . config('admin.' . ($merId ? 'merchant' : 'admin') . '_prefix') . '/setting/uploadPicture?field=' . $field['field'] . '&type=1')->icon('el-icon-camera')->modal(['modal' => false])->width('1000px')->height('600px')->props(['footer' => false]);
191:             } else if ($field['type'] == 'images') {
192:                 // 多图像字段生成框架图像组件，支持多图
