185:      * @return mixed 如果更新折扣，则返回更新后的折扣ID；如果创建新折扣，则返回新创建的折扣ID。
186:      *
187:      * 此函数负责处理折扣的保存逻辑，包括更新现有折扣和创建新折扣。
188:      * 它还处理与折扣相关的产品数据验证和处理。
189:      */
190:     public function save($data)
191:     {
192:         // 初始化折扣数据数组，包含标题、图片、类型等信息。
193:         $discountsData = [];
194:         $discountsData['title'] = $data['title'];
195:         $discountsData['image'] = $data['image'];
196:         $discountsData['type'] = $data['type'];
197:         $discountsData['is_limit'] = $data['is_limit'];
198:         $discountsData['limit_num'] = $data['is_limit'] ? $data['limit_num'] : 0;
199:         $discountsData['is_time'] = $data['is_time'];
200:         $discountsData['start_time'] = $data['is_time'] ? strtotime($data['time'][0]) : 0;
201:         $discountsData['stop_time'] = $data['is_time'] ? strtotime($data['time'][1]) : 0;
202:         $discountsData['sort'] = $data['sort'];
203:         $discountsData['free_shipping'] = $data['free_shipping'];
204:         $discountsData['status'] = $data['status'];
205:         $discountsData['is_show'] = $data['is_show'];
206:         $discountsData['mer_id'] = $data['mer_id'];
207: 
208:         // 初始化产品ID数组。
209:         $product_ids = [];
210:         // 创建产品仓库实例，用于后续的产品数据查询和操作。
211:         $productRepository = app()->make(ProductRepository::class);
212: 
213:         // 遍历产品数据，进行验证和处理。
214:         foreach ($data['products'] as $product) {
215:             // 根据产品ID查询产品信息，确保产品存在且状态正常。
216:             $productData = $productRepository->getSearch([])
217:                 ->where('mer_id', $data['mer_id'])
218:                 ->where('product_id', $product['product_id'])
219:                 ->where('status', 1)
220:                 ->find();
221:             if (!$productData) throw new ValidateException('商品「 '.$product['store_name'].' 」不存在或未审核');
222:             if ($productData['is_gift_bag']) throw new ValidateException('商品「 '.$product['store_name'].' 」分销礼包不能参与');
223:             // 检查是否重复选择同一产品。
224:             if (in_array($product['product_id'], $product_ids))
225:                 throw new ValidateException('商品「 '.$product['store_name'].' 」重复选择');
226: 
227:             // 如果产品类型为单一产品，则重置产品ID数组并结束循环。
228:             if ($product['type']) {
229:                 $product_ids = [];
230:                 $product_ids[] = $product['product_id'];
231:                 break;
232:             } else {
233:                 // 否则，将产品ID添加到数组中。
234:                 $product_ids[] = $product['product_id'];
235:             }
236: 
237:             // 检查产品规格是否为空，确保产品规格设置完整。
238:             if(empty($product['items'])){
239:                 throw new ValidateException('请设置商品「 '.$product['store_name'].' 」规格');
240:             }
241:         }
242: 
243:         // 将产品ID数组转换为字符串，用作折扣产品的ID列表。
244:         $discountsData['product_ids'] = implode(',', $product_ids);
245: 
246:         // 使用事务处理方式，执行折扣数据的保存操作。
247:         return Db::transaction(function () use($data, $discountsData){
248:             // 如果折扣ID存在，则更新折扣信息；否则，创建新折扣。
249:             if (isset($data['discount_id'])) {
250:                 $discountsId = $data['discount_id'];
251:                 $this->dao->update($discountsId, $discountsData);
252:                 // 清除与折扣关联的产品缓存。
253:                 app()->make(StoreDiscountProductRepository::class)->clear($discountsId,'discount_id');
254:                 // 清除与折扣关联的SKU缓存。
255:                 app()->make(ProductSkuRepository::class)->clear($discountsId, ProductSkuRepository::ACTIVE_TYPE_DISCOUNTS);
256:             } else {
257:                 $res = $this->dao->create($discountsData);
258:                 $discountsId = $res['discount_id'];
259:             }
260:             // 保存折扣与产品的关联关系。
261:             return $this->saveProduct($discountsId, $data['products'], $data['mer_id']);
262:         });
263:     }
