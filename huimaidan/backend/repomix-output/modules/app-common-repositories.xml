148:      *
149:      * @param integer $id
150:      * @param array $data
151:      * @return void
152:      */
153:     public function switch(int $id, array $data)
154:     {
155:         $info = $this->dao->get($id);
156:         if (!$info) {
157:             throw new ValidateException('记录不存在!');
158:         }
159: 
160:         $info->status = $data['status'];
161: 
162:         // 开启事物
163:         return Db::transaction(function () use ($id, $data, $info) {
164:             $info->save();
165:             // 切换子分类状态
166:             if($info->level < 2) {
167:                 $this->dao->search(['path' => $id])->update(['status' => $data['status']]);
168:             }
169: 
170:             return true;
171:         });
172:     }
