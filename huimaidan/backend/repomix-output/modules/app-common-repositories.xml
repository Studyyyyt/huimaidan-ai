 85:         $data[$this->dao->getLevel()] = $this->getLevelById($data[$this->dao->getParentId()]);
 86:         $this->checkRate($data);
 87:         // 检查身份权限数据
 88:         $this->checkRole($data);
 89:         return Db::transaction(function () use ($data) {
 90:             $res = $this->dao->create($data);
 91:             // 商圈创建后更新商圈管理员账号所属商圈ID
 92:             $this->updateAdminRegionIds($data['circle_agent_id'], $res->circle_id, true);
 93: 
 94:             $merchantIds = $data['merchant_ids'];
 95:             unset($data['merchant_ids']);
 96:             if($merchantIds) {
 97:                 $merchantRepository = app()->make(MerchantRepository::class);
 98:                 // 更新店铺所属区域id
 99:                 if ($data['type'] == CircleDao::TYPE['REGION']) {
100:                     $merchantRepository->search(['region_id' => $res->circle_id])->update(['region_id' => 0]);
101:                     $merchantRepository->search(['mer_id' => $merchantIds])->update(['region_id' => $res->circle_id]);
102:                 }
103:                 // 更新店铺所属商户id
104:                 if ($data['type'] == CircleDao::TYPE['MERCHANT']) {
105:                     $merchantRepository->search(['business_id' => $res->circle_id])->update(['business_id' => 0]);
106:                     $merchantRepository->search(['mer_id' => $merchantIds])->update(['business_id' => $res->circle_id]);
107:                 }
108:             }
109: 
110:             return true;
111:         });
112:     }
113:     /**
114:      * 更新组织
115:      *
116:      * @param integer $id
117:      * @param array $data
118:      * @return void
119:      */
120:     public function update(int $id, array $data)
121:     {
122:         $info = $this->dao->get($id);
123:         if (!$info) {
124:             throw new ValidateException('记录不存在!');
125:         }
126:         if($data['pid'] && !$this->dao->exists($data['pid'])) {
127:             throw new ValidateException('上级商圈不存在!');
128:         }
129:         if ($data['pid'] && ($this->getLevelById($data['pid']) >= $this->dao->getMaxLevel())) {
130:             throw new ValidateException('最多' . $this->dao->getMaxLevel() . '级!');
131:         }
132:         if ($this->dao->checkChangeToChild($id, $data['pid'])) {
133:             throw new ValidateException('无法修改到当前分类到子集，请先修改子类');
134:         }
135:         if (!$this->checkChildLevel($id, $data['pid'])) {
136:             throw new ValidateException('子类超过最高等级限制，请先修改子类');
137:         }
138: 
139:         $data[$this->dao->getPath()] = $this->getPathById($data[$this->dao->getParentId()]);
140:         $data[$this->dao->getLevel()] = $this->getLevelById($data[$this->dao->getParentId()]);
141:         $this->checkRate($data, $id, $info);
142:         // 检查身份权限数据
143:         $this->checkRole($data);
144: 
145:         $data['update_time'] = date('Y-m-d H:i:s');
146:         $data['commission_rate'] = $data['commission_type'] == 0 ? 0 : $data['commission_rate'];
147:         unset($data['type']);
148: 
149:         return Db::transaction(function () use ($id, $data, $info) {
150:             if ($data['circle_agent_id'] !== $info->circle_agent_id) {
151:                 if($info['circle_agent_id']) {
152:                     // 清除原商圈管理员所属商圈ID
153:                     $this->updateAdminRegionIds($info['circle_agent_id'], $id, false);
154:                 }
155:                 // 更新新商圈管理员账号所属商圈ID
156:                 $this->updateAdminRegionIds($data['circle_agent_id'], $id, true);
157:             }
158: 
159:             $merchantIds = $data['merchant_ids'];
160:             unset($data['merchant_ids']);
161:             if($merchantIds) {
162:                 $merchantRepository = app()->make(MerchantRepository::class);
163:                 // 更新店铺所属区域id
164:                 if ($info['type'] == CircleDao::TYPE['REGION']) {
165:                     $merchantRepository->search(['region_id' => $info['circle_id']])->update(['region_id' => 0]);
166:                     $merchantRepository->search(['mer_id' => $merchantIds])->update(['region_id' => $id]);
167:                 }
168:                 // 更新店铺所属商户id
169:                 if ($info['type'] == CircleDao::TYPE['MERCHANT']) {
170:                     $merchantRepository->search(['business_id' => $info['circle_id']])->update(['business_id' => 0]);
171:                     $merchantRepository->search(['mer_id' => $merchantIds])->update(['business_id' => $id]);
172:                 }
173:             }
174: 
175:             $this->dao->update($id, $data);
176: 
177:             return true;
178:         });
179:     }
