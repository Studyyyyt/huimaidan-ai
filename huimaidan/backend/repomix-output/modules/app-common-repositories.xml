 61:         // 统计查询结果的总数量
 62:         $count = $query->count();
 63: 
 64:         // 分页查询用户详细信息，并加载关联数据（用户、服务信息），同时追加发送时间和日期字段
 65:         $list = $query->page($page, $limit)->with(['user', 'service'])->select()->append(['send_time', 'send_date']);
 66: 
 67:         // 如果是第一页，则标记数据为已读，更新读取状态
 68:         if ($page == 1) {
 69:             $this->dao->userRead($merId, $uid);
 70:             app()->make(StoreServiceUserRepository::class)->read($merId, $uid);
 71:         }
 72: 
 73:         // 反转列表顺序，可能是为了满足特定的展示需求
 74:         $list = array_reverse($this->getSendDataList($list)->toArray());
