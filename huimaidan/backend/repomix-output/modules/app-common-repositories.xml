 484:     /**
 485:      * 预发送优惠券
 486:      *
 487:      * 该方法用于在发送优惠券前进行必要的数据准备和校验，确保优惠券的发送符合业务规则。
 488:      * 主要用于优惠券的批量发送或自动发送场景，例如在用户下单后自动发送优惠券。
 489:      *
 490:      * @param StoreCoupon $coupon 优惠券对象，包含待发送的优惠券的具体信息。
 491:      * @param int $uid 接收优惠券的用户ID，用于指定优惠券的接收者。
 492:      * @param string $type 发送类型，默认为'send'，可扩展其他发送类型以满足不同的业务需求。
 493:      * @return mixed 返回创建的优惠券用户记录，通常是一个包含优惠券ID等信息的对象或数组。
 494:      */
 495:     public function preSendCoupon(StoreCoupon $coupon, $uid, $type = 'send')
 496:     {
 497:         // 根据传入的优惠券、用户ID和发送类型，创建优惠券发送的数据对象。
 498:         $data = $this->createData($coupon, $uid, $type);
 499: 
 500:         // 使用依赖注入获取StoreCouponUserRepository实例，并调用其create方法，将优惠券发送数据持久化到数据库中。
 501:         return app()->make(StoreCouponUserRepository::class)->create($data);
 502:     }
