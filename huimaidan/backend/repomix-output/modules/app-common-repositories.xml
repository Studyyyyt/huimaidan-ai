 803:         $make = app()->make(MerchantRepository::class);
 804:         //应付商户金额 = 所有商户的余额之和
 805:         $all = $make->search(['is_del' => 0])->sum('mer_money');
 806:         //商户可提现金额 = （每个商户的余额 - 平台设置的最低提现额度） 之和
 807:         $extract_minimum_line = systemConfig('extract_minimum_line') ?: 0;
 808:         $ret = $make->search(['is_del' => 0])->where('mer_money', '>', $extract_minimum_line)
 809:             ->field("sum(mer_money - $extract_minimum_line) as  money")
 810:             ->find();
 811:         $money = $ret->money;
 812:         //申请转账的商户数 = 申请提现且未转账的商户数量
 813:         $where['financial_status'] = 0;
 814:         $query = $this->dao->getSearch($where)->where('status', '>', -1);
 815:         $count = $query->group('mer_id')->count();
 816:         //申请转账的总金额 = 申请提现已通过审核，且未转账的申请金额 之和
 817:         $where['status'] = 1;
 818:         $all_ = $this->dao->search($where)->sum('extract_money');
 819:         $where['status'] = 0;
 820:         $all_0 = $this->dao->search($where)->sum('extract_money');
