338:     /**
339:      * 创建管理员令牌
340:      *
341:      * 本函数用于生成针对管理员的JWT令牌，该令牌用于管理员的身份验证。
342:      * 令牌的过期时间通过配置文件定义，默认为3小时。
343:      *
344:      * @param MerchantAdmin $admin 管理员对象，包含管理员信息。
345:      * @return array 返回包含令牌和过期时间的信息。
346:      */
347:     public function createToken(MerchantAdmin $admin)
348:     {
349:         // 实例化JWT令牌服务类
350:         $service = new JwtTokenService();
351: 
352:         // 从配置文件中获取管理员令牌的过期时间，默认为3小时
353:         $exp = intval(Config::get('admin.token_exp', 3));
354: 
355:         // 生成令牌，指定管理员ID和令牌过期时间
356:         $token = $service->createToken($admin->merchant_admin_id, 'mer', strtotime("+ {$exp}hour"));
357: 
358:         // 缓存令牌信息
359:         $this->cacheToken($token['token'], $token['out']);
360: 
361:         // 返回生成的令牌信息
362:         return $token;
363:     }
