 39: 
 40:     /**
 41:      * 查询管理员操作日志列表
 42:      *
 43:      * 该方法用于根据给定的条件和分页参数，从数据库中检索管理员的操作日志。
 44:      * 它首先构造一个查询，包括与商家关联的条件，并指定要包含的关联数据（如菜单）。
 45:      * 然后，它计算满足条件的日志总数，以便于分页。
 46:      * 最后，它构造一个包含日志列表和总数的数组，并返回该数组。
 47:      *
 48:      * @param string $merId 商家ID，用于限定查询的商家范围
 49:      * @param array $where 查询条件，用于过滤日志
 50:      * @param int $page 当前页码，用于分页查询
 51:      * @param int $limit 每页记录数，用于分页查询
 52:      * @return array 返回一个包含日志总数和日志列表的数组
 53:      */
 54:     public function lst($merId, array $where, $page, $limit)
 55:     {
 56:         // 构造查询，包括指定的条件和商家ID，以及要加载的关联数据（这里指菜单）
 57:         $query = $this->dao->search($where, $merId)->with([
 58:             'menu' => function($query){
 59:                 // 仅加载菜单的名称和路由
 60:                 $query->field('menu_name,route');
 61:             }
 62:         ]);
 63: 
 64:         // 计算满足条件的日志总数
 65:         $count = $query->count($this->dao->getPk());
 66: 
 67:         // 确定查询的字段，进行分页查询，并按创建时间降序排序
 68:         // 这里指定了要查询的字段，包括创建时间、日志ID、管理员名称、路由、方法、URL、IP和管理员ID
 69:         $list = $query->setOption('field', [])->field(['create_time', 'log_id', 'admin_name', 'route', 'method', 'url', 'ip', 'admin_id'])
 70:             ->page($page, $limit)->order('create_time DESC')->select();
 71: 
 72:         // 返回包含日志总数和日志列表的数组
 73:         return compact('count', 'list');
 74:     }
 75: 
 76:     /**
 77:      * 添加日志记录
 78:      *
 79:      * 该方法用于根据传入的请求信息和商家ID添加一条日志记录。
 80:      * 它首先解析请求数据，然后使用解析后的数据和商家ID来创建新的日志条目。
 81:      *
 82:      * @param Request $request 本次请求的对象，用于解析请求数据。
 83:      * @param int $merId 商家ID，用于标识日志所属的商家。默认为0，表示系统日志。
 84:      * @return mixed 返回添加日志的结果，具体类型取决于create方法的实现。
 85:      */
 86:     public function addLog(Request $request, int $merId = 0)
 87:     {
 88:         // 解析请求数据并创建日志条目
 89:         return $this->create($merId, self::parse($request));
 90:     }
 91: 
 92:     /**
 93:      * 创建一个新的实体对象
 94:      *
 95:      * 本函数用于在数据库中创建一个新的实体记录。它首先将传入的商家ID添加到数据数组中，然后调用DAO层的创建方法来执行实际的数据库操作。
 96:      * 这里的商家ID是作为外部传入的参数，它被用于指定新记录所属的商家。
 97:      *
 98:      * @param int $merId 商家ID，用于标识记录所属的商家。
 99:      * @param array $data 包含新记录数据的数组，不包含商家ID。
100:      * @return mixed 返回DAO层创建方法的执行结果，可能是新创建记录的ID或其他数据。
101:      */
102:     public function create(int $merId, array $data)
103:     {
104:         // 将商家ID添加到数据数组中
105:         $data['mer_id'] = $merId;
106: 
107:         // 调用DAO层的创建方法，传入完整的数据数组，执行数据库插入操作
108:         return $this->dao->create($data);
109:     }
