2233:         if (!$bro) throw new ValidateException('等级不存在');
2234:         // 使用数据库事务处理更新操作
2235:         Db::transaction(function () use ($id, $data, $field, $user, $type, $bro) {
2236:             // 更新用户级别
2237:             $user->$field = $data[$field];
2238:             $bro->user_num++;
2239:             $bro->save();
2240:             // 如果是更新会员级别
2241:             if ($type) {
