196:      *      - mer_id: 商家ID（冗余参数，与函数参数相同，用于内部操作）。
197:      */
198:     public function create($merId, $data)
199:     {
200:         // 提取参数信息
201:         $params = $data['params'];
202:         // 去除重复的类别ID
203:         $cate = array_unique($data['cate_ids']);
204:         // 构建模板的基础信息
205:         $tem = [
206:             'template_name' => $data['template_name'],
207:             'sort' => $data['sort'],
208:             'mer_id' => $merId
209:         ];
210:         // 实例化参数仓库和关联仓库
211:         $paramMake = app()->make(ParameterRepository::class);
212:         $releMake = app()->make(RelevanceRepository::class);
213:         // 使用数据库事务来确保操作的一致性
214:         //Db::transaction(function () use ($params, $tem, $cate, $merId, $paramMake, $releMake) {
215:             // 创建模板
216:             $temp = $this->dao->create($tem);
217:             // 创建或更新模板参数
218:             $paramMake->createOrUpdate($temp->template_id, $merId, $params);
219:             // 如果有类别ID，创建模板与类别的关联
220:             if (!empty($cate)) {
221:                 $releMake->createMany($temp->template_id, $cate, RelevanceRepository::PRODUCT_PARAMES_CATE);
222:             }
223:         //});
