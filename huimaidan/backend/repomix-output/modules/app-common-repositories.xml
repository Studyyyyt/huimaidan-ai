163:     /**
164:      * 生成二维码
165:      *
166:      * 该方法用于根据商家ID、二维码类型和具体数据生成相应的二维码配置。
167:      * 它首先尝试从缓存中获取二维码配置，如果缓存不存在，则生成新的二维码配置，
168:      * 并将其与相关数据一起存储在缓存中，以供后续使用。
169:      *
170:      * @param int $merId 商家ID，用于标识商家
171:      * @param string $type 二维码类型，决定使用哪种方式生成二维码
172:      * @param array $data 生成二维码所需的具体数据，包括支付类型等
173:      * @return array 返回包含二维码配置、过期时间和价格的信息
174:      */
175:     public function QrCode(int $merId, string $type, array $data)
176:     {
177:         // 根据二维码类型调用相应的方法，并获取生成二维码所需的键值和参数
178:         $res = $this->{$type}($merId, $data);
179:         $key = $res['key'];
180:         $param = $res['param'];
181: 
182:         // 尝试从缓存中获取二维码配置
183:         if(!$result = Cache::store('file')->get($key)){
184:             // 生成新的订单号
185:             $order_sn = app()->make(StoreOrderRepository::class)->getNewOrderId(StoreOrderRepository::TYPE_SN_SERVER_ORDER);
186:             // 使用订单号作为订单描述和支付body
187:             $param['order_sn'] = $order_sn;
188:             $param['body'] = $order_sn;
189:             // 根据支付类型创建支付服务实例，并生成支付二维码
190:             $payType = $data['pay_type'] == 1 ? 'weixinQr' : 'alipayQr';
191:             $service = new PayService($payType,$param);
192:             $code = $service->pay(null);
193: 
194:             // 设置二维码过期时间，并生成包含配置、过期时间和价格的数组
195:             $endtime = time() + 1800 ;
196:             $result = [
197:                 'config' => $code['config'],
198:                 'endtime'=> date('Y-m-d H:i:s',$endtime),
199:                 'price'  => $param['pay_price']
200:             ];
201:             // 将二维码配置存储在缓存中，设置过期时间为30分钟
202:             Cache::store('file')->set($key,$result,30);
203:             // 将订单号和相关参数存储在缓存中，过期时间为24小时
204:             $param['key'] = $key;
205:             Cache::store('file')->set($order_sn,$param,60 * 24);
206:         }
207: 
208:         // 返回二维码配置信息
209:         return $result;
210:     }
211: 
212:     /**
213:      * 处理支付成功的逻辑。
214:      * 当收到支付成功的通知时，本函数将验证订单是否存在。如果订单不存在于数据库中，则尝试从缓存中恢复订单数据，
215:      * 并将订单状态更新为已支付，同时清除相关的缓存数据。
216:      *
217:      * @param array $data 包含订单信息的数据数组，其中应包含订单号(order_sn)。
218:      */
219:     public function paySuccess($data)
220:     {
221:         // 根据订单号尝试从数据库中获取订单信息
222:         $get = $this->dao->getWhere(['order_sn' => $data['order_sn']]);
223:         // 如果订单不存在于数据库中
224:         if(!$get){
225:             // 尝试从缓存中获取订单数据
226:             $dat = Cache::store('file')->get($data['order_sn']);
227:             $key = $dat['key'];
228:             // 移除不需要的字段，以准备更新数据库中的订单信息
229:             unset($dat['attach'],$dat['body'],$dat['key']);
230: 
231:             // 设置订单状态为已支付，并记录支付时间
232:             $dat['status'] = 1;
233:             $dat['pay_time'] = date('y_m-d H:i:s', time());
234:             // 使用事务处理来确保数据的一致性
235:             Db::transaction(function () use($data, $dat,$key){
236:                 // 在数据库中创建（或更新）订单信息
237:                 $res = $this->dao->create($dat);
238:                 // 处理支付成功后的逻辑，如发送通知等
239:                 $this->payAfter($dat,$res);
240:                 // 清除订单号和key相关的缓存数据
241:                 Cache::store('file')->delete($data['order_sn']);
242:                 Cache::store('file')->delete($key);
243:             });
244:         }
245:     }
246: 
247:     /**
248:      * 根据支付类型处理支付后业务逻辑
249:      *
250:      * @param array $dat 包含订单信息和支付类型的数组
251:      * @param null $ret 保留参数，未使用
252:      * @return void
253:      */
254:     public function payAfter($dat, $ret = null)
255:     {
256:         // 解析订单信息
257:         $info = json_decode($dat['order_info']);
258: 
259:         // 根据支付类型执行不同的业务逻辑
260:         switch ($dat['type']) {
261:             case self::TYPE_COPY_PRODUCT:
262:                 // 处理复制产品套餐支付
263:                 app()->make(ProductCopyRepository::class)->add([
264:                     'type' => 'pay_copy',
265:                     'num' => $info->num,
266:                     'info' => $dat['order_info'],
267:                     'message' => '购买复制商品套餐',
268:                 ], $dat['mer_id']);
269:                 break;
270:             case self::TYPE_DUMP:
271:                 // 处理电子面单套餐支付
272:                 app()->make(ProductCopyRepository::class)->add([
273:                     'type' => 'pay_dump',
274:                     'num' => $info->num,
275:                     'info' => $dat['order_info'],
276:                     'message' => '购买电子面单套餐',
277:                 ], $dat['mer_id']);
278:                 break;
279:             case self::TYPE_MARGIN:
280:                 // 处理保证金支付逻辑
281:                 $res = app()->make(MerchantRepository::class)->get($dat['mer_id']);
282:                 if ($res['is_margin'] == 1) {
283:                     // 如果已经缴纳保证金，则更新保证金金额
284:                     $margin = $res->margin;
285:                     $ot_margin = $res->margin;
286:                     $_margin = $res->margin;
287:                 } else {
288:                     // 否则，更新原保证金和现保证金金额，并计算差额
289:                     $margin = $res->ot_margin;
290:                     $ot_margin = $res->ot_margin;
291:                     $_margin = bcsub($res->ot_margin, $res->margin, 2);
292:                 }
293:                 if (bccomp($_margin, $dat['pay_price'], 2) === 0) {
294:                     // 如果支付金额与差额相符，更新保证金状态
295:                     $res->ot_margin = $ot_margin;
296:                     $res->margin = $margin;
297:                     $res->margin_remind_time = '';
298:                     $res->is_margin = 10;
299:                 } else {
300:                     // 否则，设置为保证金支付异常状态
301:                     // 支付金额与订单金额不一致
302:                     $res->is_margin = 20;
303:                 }
304:                 $res->save();
305:                 // 记录保证金缴纳账单
306:                 $bill = [
307:                     'title' => '线上缴纳保证金',
308:                     'mer_id' => $dat['mer_id'],
309:                     'number' => $dat['pay_price'],
310:                     'mark' => '缴纳保证金',
311:                     'balance' => $res->margin,
312:                 ];
313:                 app()->make(UserBillRepository::class)->bill(0, 'mer_margin', 'mer_margin', 1, $bill);
314:                 break;
315:             case self::TYPE_MARGIN_MAKE_UP:
316:                 // 处理保证金补缴逻辑
317:                 $res = app()->make(MerchantRepository::class)->get($dat['mer_id']);
318:                 if (bccomp($res['margin'], $dat['pay_price'], 2) === 0) {
319:                     // 如果支付金额与保证金补齐金额相符，更新保证金余额
320:                     $res->margin = bcadd($res['margin'], $dat['pay_price'], 2);
321:                     $res->margin_remind_time = '';
322:                     $res->is_margin = 10;
323:                 } else {
324:                     // 否则，设置为保证金支付异常状态
325:                     // 支付金额与订单金额不一致
326:                     $res->is_margin = 20;
327:                 }
328:                 $res->save();
329:                 // 记录保证金补缴账单
330:                 $bill = [
331:                     'mer_id' => $dat['mer_id'],
332:                     'number' => $dat['pay_price'],
333:                     'mark' => '线上补缴保证金',
334:                     'balance' => $res->margin,
335:                 ];
336:                 app()->make(UserBillRepository::class)->bill(0, 'mer_margin', 'pay_margin', 1, $bill);
337:                 break;
338:             case self::TYPE_DELIVERY:
339:                 // 处理同城配送充值
340:                 $res = app()->make(MerchantRepository::class)->get($dat['mer_id']);
341:                 if ($res) {
342:                     // 更新配送余额
343:                     $res->delivery_balance = bcadd($res->delivery_balance, $dat['pay_price'], 2);
344:                     $res->save();
345:                 } else {
346:                     // 记录异常信息
347:                     Log::info('同城配送充值异常 ：' . json_encode($dat));
348:                 }
349:                 break;
350:             default:
351:                 break;
352:         }
353:         return;
354:     }
