 53:      * @param int $limit 每页数量，用于分页查询
 54:      * @return array 返回包含用户列表数量和详细信息的数据结构
 55:      */
 56:     public function userList($merId, $uid, $page, $limit)
 57:     {
 58:         // 根据商家ID和用户ID查询符合条件的记录，并按照服务日志ID降序排列
 59:         $query = $this->search(['mer_id' => $merId, 'uid' => $uid])->order('service_log_id DESC');
