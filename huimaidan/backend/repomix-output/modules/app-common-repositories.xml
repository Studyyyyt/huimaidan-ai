1698:     /**
1699:      * 检查同城配送范围
1700:      *
1701:      * @param array $merchantCart
1702:      * @param array $address
1703:      * @return boolean
1704:      */
1705:     protected function checkCityTake(array $merchantCart, array $address) : bool
1706:     {
