72:             throw new ValidateException('活动不存在');
73:         if(!$activeInfo['status'] && $merId)
74:             throw new ValidateException('活动已关闭，无法参与');
75:         Db::transaction(function () use ($activeId, $productList,$merId) {
76:             app()->make(ProductRepository::class)->deleteActiveProduct($activeId,$merId);
77:             if(!empty($productList)){
78:                 $this->createSeckillProduct($activeId,$productList);
79:             }
80:         });
81:     }
