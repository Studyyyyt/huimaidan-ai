174:      * 设置首页模板
175:      *
176:      * @param integer $id
177:      * @param array $data
178:      * @return void
179:      */
180:     public function setTemplate(int $id, array $data)
181:     {
182:         $info = $this->dao->get($id);
183:         if (!$info) {
184:             throw new ValidateException('记录不存在!');
185:         }
186: 
187:         $info->diy_temp_id = $data['diy_temp_id'];
188: 
189:         return $info->save();
190:     }
191:     /**
192:      * 获取分组下关联的店铺列表
193:      *
194:      * @param integer $id
195:      * @param integer $page
196:      * @param integer $limit
197:      * @param array $where
198:      * @return void
199:      */
200:     public function stores($id, $page, $limit, $where)
201:     {
202:         $info = $this->dao->get($id);
203:         if (!$info) {
204:             throw new ValidateException('记录不存在!');
205:         }
206: 
207:         $where['mer_id'] = app()->make(RelevanceRepository::class)->getRightIds($id, RelevanceRepository::STORE_GROUP);
208:         if(empty($where['mer_id'])){
209:             return [];
210:         }
211: 
212:         $query = app()->make(MerchantRepository::class)->search($where);
213:         $count = $query->count();
214:         $list = $query->page($page, $limit)->field('mer_id, mer_name, real_name ,mer_phone, region_id,status,mer_state')->select();
215: 
216:         return compact('list', 'count');
217:     }
218:     /**
219:      * 移动端获取推荐分组列表
220:      *
221:      * @param array $params
222:      * @return void
223:      */
224:     public function recommendList(array $params)
225:     {
226:         $where = [
227:             'status' => 1,
228:             'positioning_status' => 1
229:         ];
230:         $list = $this->search($where)->field(self::LIST_FIELDS)->select()->toArray();
231:         // 取距离最近的前6个商圈
232:         $data = [];
233:         foreach ($list as &$item) {
234:             if (count($data) >= 6) {
235:                 break;
236:             }
237: 
238:             $distance = getDistance($params['latitude'], $params['longitude'], $item['latitude'], $item['longitude']);
239:             $item['distanceM'] = $distance;
240:             // 距离单位转换
241:             if ($distance < 0.9) {
242:                 $distance = max(bcmul($distance, 1000, 0), 1) . 'm';
243:                 if ($distance == '1m') {
244:                     $distance = '100m以内';
245:                 }
246:             } else {
247:                 $distance .= 'km';
248:             }
249:             $item['distance'] = $distance;
250: 
251:             $data[] = $item;
252:         }
253: 
254:         // 距离排序
255:         usort($data, function ($a, $b) {
256:             return $a['distanceM'] > $b['distanceM'];
257:         });
258: 
259:         return $data;
260:     }
261:  }
