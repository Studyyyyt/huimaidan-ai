367:      * 该方法主要用于在非开发环境下验证用户输入的验证码是否与缓存中的验证码匹配。如果验证码不匹配或已过期，
368:      * 将抛出ValidateException异常。在开发环境下，验证码的验证逻辑被跳过，以方便开发。
369:      *
370:      * @param string $key 验证码的唯一标识键，用于拼接缓存键名。
371:      * @param string $code 用户输入的验证码内容。
372:      * @throws ValidateException 如果验证码过期或不正确，则抛出此异常。
373:      */
374:     public function checkCode(string $key, string $code)
375:     {
376:         // 如果不在开发模式下，则进行验证码的验证
377:         if (!env('DEVELOPMENT',false)){
378:             // 从缓存中获取存储的验证码，键名为'am_captcha'加上$key。
379:             $_code = Cache::get('am_captcha' . $key);
380:             // 如果缓存中没有找到验证码，表示验证码已过期，抛出异常。
381:             if (!$_code) {
382:                 throw new ValidateException('验证码过期');
383:             }
384:             // 将存储的验证码和用户输入的验证码转换为小写后比较，不匹配则抛出异常。
385:             if (strtolower($_code) != strtolower($code)) {
386:                 throw new ValidateException('验证码错误');
387:             }
388:             // 验证码验证通过后，删除缓存中的验证码。
389:             //删除code
390:             Cache::delete('am_captcha' . $key);
391:         }
392:     }
