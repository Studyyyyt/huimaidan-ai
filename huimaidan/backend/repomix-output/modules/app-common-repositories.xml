144:      *
145:      * 本函数用于根据给定的键值对结果进行保存。如果键不存在，则创建一个新的记录；
146:      * 如果键已存在，则更新该记录的相关信息。保存的信息包括键、结果和过期时间。
147:      *
148:      * @param string $key 存储的键名，用于唯一标识一条记录。
149:      * @param mixed $result 要保存的结果数据，可以是任意类型。
150:      * @param int $expire_time 记录的过期时间，0表示永不过期。
151:      */
152:     public function save(string $key, $result, int $expire_time = 0)
153:     {
154:         // 检查键是否已存在
155:         if (!$this->dao->fieldExists('key', $key)) {
156:             // 如果键不存在，则创建新记录
157:             $this->dao->create(compact('key', 'result', 'expire_time'));
158:         } else {
159:             // 如果键已存在，则更新记录的结果和过期时间
160:             $this->dao->keyUpdate($key, compact('result', 'expire_time'));
161:         }
162:     }
