351:      * 主要用于在订单系统中，对特定条件下未成功配送的订单进行特别处理，例如，更改配送城市或取消订单等。
352:      *
353:      * @param array $data 包含订单相关信息的数据数组
354:      * @param int $id 临时ID，用于标识待处理的订单
355:      * @throws ValidateException 如果$data['city_id']不是数组且设置了'city_id'，则抛出验证异常
356:      * @return array 返回一个包含临时ID和城市ID的数组，用于进一步的订单处理
357:      */
358:     public function settleUndelives($data,$id)
359:     {
360:         // 检查$data中是否设置了'city_id'且其类型不是数组，如果是，则抛出类型错误异常
361:         if (isset($v['city_id']) && !is_array($data['city_id'])) throw new ValidateException('指定不配送参数类型错误');
362: 
363:         // 返回一个数组，包含临时ID和城市ID，用于后续的订单处理
364:         return ['temp_id' => $id, 'city_id' => $data['city_id']];
365:     }
366: 
367:     /**
368:      * 结算区域信息处理函数
369:      * 该函数用于处理给定的区域数据，并根据这些数据生成一个结构化的数组，每个数组元素代表一个区域的结算信息。
370:      * @param array $data 包含区域详细信息的数组，每个元素本身是一个数组，包含城市ID、首次配送费用、续费配送费用等信息。
371:      * @param int $id 用于标识当前操作的临时ID，具体用途根据上下文决定。
372:      * @return array 返回一个结构化数组，每个元素包含城市ID路径、临时ID、首次配送费用、续费配送费用等信息。
373:      */
374:     public function settleRegion($data,$id)
375:     {
376:         // 初始化一个空数组，用于存储处理后的结果
377:         $result = [];
378:         // 遍历输入的区域数据数组
379:         foreach ($data as $k => $v){
380:             // 构建结果数组的单个元素，包含城市ID路径、临时ID、首次配送费用、续费配送费用等信息
381:             // 如果当前键值$k大于0，说明是一个非首个元素，将城市ID用'/'连接并添加到路径中，否则设置为0
382:             $result[] = [
383:                 'city_id' => ($k > 0 ) ? '/'.implode('/',$v['city_id']).'/' : 0,
384:                 'temp_id' => $id,
385:                 'first' => $v['first'],
386:                 'first_price'=> $v['first_price'],
387:                 'continue' => $v['continue'],
388:                 'continue_price'=> $v['continue_price'],
389:             ];
390:         }
391:         // 返回处理后的结果数组
392:         return $result;
393:     }
394: 
395:     /**
396:      * 创建默认配送模板
397:      * 该方法用于生成一个默认的配送模板，适用于没有特定配送设置的商家。默认模板设置了基本的配送规则配置。
398:      *
399:      * @param int $merId 商家ID，用于关联模板和商家。
400:      * @return mixed 返回创建的配送模板的数据，具体类型取决于create方法的实现。
401:      */
402:     public function createDefault(int $merId)
403:     {
404:         // 定义默认配送模板的数据结构
405:         $data = [
406:             "name" => "默认模板", // 模板名称
407:             "type" => 1, // 配送类型，这里假设为一种固定的类型
408:             "appoint" => 0, // 是否允许指定配送，这里设置为不允许
409:             "undelivery" => 0, // 是否允许不配送，这里设置为不允许
410:             'mer_id' => $merId, // 商家ID，用于关联模板和商家
411:             "region" => [[ // 配送区域设置，这里以最简单的形式初始化
412:                 "first" => 0, // 首重价格
413:                 "first_price" => 0, // 首重费用
414:                 "continue" => 0, // 续重价格
415:                 "continue_price" => 0, // 续重费用
416:                 "city_id" => 0 // 默认城市ID，用于初始配置
417:               ]]
418:         ];
419: 
420:         // 调用create方法来创建配送模板
421:         return $this->create($data);
422:     }
423: 
424: 
425:     /**
426:      * 检查商户模板是否可以删除。
427:      *
428:      * 此函数用于在删除商户模板前进行一系列的验证，以确保模板可以被安全删除。
429:      * 它主要检查以下三个条件：
430:      * 1. 模板是否存在。
431:      * 2. 模板是否为默认模板，默认模板不允许删除。
432:      * 3. 模板是否正在被使用，正在使用的模板不允许删除。
433:      * 如果任何检查失败，将抛出一个ValidateException异常，异常信息包含具体的错误原因。
434:      *
435:      * @param string $merId 商户ID，用于标识模板所属的商户。
436:      * @param int $id 模板ID，用于唯一标识模板。
437:      * @throws ValidateException 如果模板不存在、是默认模板或正在使用中，则抛出此异常。
438:      */
439:     public function check($merId, $id)
440:     {
441:         // 检查模板是否存在，如果不存在则抛出异常。
442:         if(!$this->merExists($merId, $id))
443:             throw new ValidateException('数据不存在,ID:'.$id);
444: 
445:         // 检查模板是否为默认模板，如果是则抛出异常。
446:         if($this->merDefaultExists($merId, $id))
447:             throw new ValidateException('默认模板不能删除,ID:'.$id);
448: 
449:         // 检查模板是否正在被使用，如果正在使用则抛出异常。
450:         if($this->getProductUse($merId, $id))
451:             throw new ValidateException('模板使用中，不能删除,ID:'.$id);
452:     }
453: 
454: }
