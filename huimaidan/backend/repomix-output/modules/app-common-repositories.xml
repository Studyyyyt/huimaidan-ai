 91:     public function getMonth($date)
 92:     {
 93:         // 解析传入的日期，获取年月
 94:         $dateObj = new \DateTime($date);
 95:         $year = $dateObj->format('Y');
 96:         $month = $dateObj->format('m');
 97: 
 98:         // 获取当月第一天和最后一天
 99:         $firstDay = date('Y-m-01', strtotime("$year-$month-01"));
100:         $lastDay = date('Y-m-t', strtotime("$year-$month-01"));
101:         return [$firstDay, $lastDay];
102:     }
