 943:     public function getProductList(int $id,int $page,int $limit)
 944:     {
 945:         // 通过优惠券ID获取优惠券信息
 946:         $res = $this->dao->get($id);
 947:         // 实例化优惠券产品仓库，用于后续根据优惠券ID查询相关产品ID
