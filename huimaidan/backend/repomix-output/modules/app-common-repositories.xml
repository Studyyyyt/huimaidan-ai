110: 
111:         // 初始化用于存储整理后字段信息的数组
112:         $data = [];
113:         // 初始化用于存储已处理字段键的数组
114:         $fieldKey = [];
115: 
116:         // 遍历字段数组，对每个字段进行处理
117:         foreach ($fields as $field) {
118:             // 检查字段是否缺少类型定义，如果缺少则抛出异常
119:             if (!isset($field['type']))
120:                 throw new ValidateException('字段类型不能为空');
121:             // 检查字段是否缺少键定义，如果缺少则抛出异常
122:             if (!isset($field['field']))
123:                 throw new ValidateException('字段key不能为空');
124:             // 检查字段是否缺少名称定义，如果缺少则抛出异常
125:             if (!isset($field['name']))
126:                 throw new ValidateException('字段名称不能为空');
127:             // 检查字段键是否重复，如果重复则抛出异常
128:             if (in_array($field['field'], $fieldKey))
129:                 throw new ValidateException('字段key不能重复');
130: 
131:             // 将字段的键添加到已处理字段键的数组中
132:             $fieldKey[] = $field['field'];
133:             // 整理字段信息，并添加到整理后字段信息的数组中
134:             $data[] = [
135:                 'name' => $field['name'],
136:                 'field' => $field['field'],
137:                 'type' => $field['type'],
138:                 'param' => $field['param'] ?? '', // 如果字段有参数，则使用字段的参数，否则使用空字符串
139:                 'props' => $field['props'] ?? '' // 如果字段有属性，则使用字段的属性，否则使用空字符串
140:             ];
141:         }
142: 
143:         // 返回整理后的字段信息数组
144:         return $data;
145:     }
