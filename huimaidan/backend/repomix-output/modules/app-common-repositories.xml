2925:     /**
2926:      * 生成微信二维码
2927:      *
2928:      * 该函数用于根据订单信息生成微信支付二维码。二维码的内容是根据订单号和特定格式生成的URL，
2929:      * 用于在微信支付中进行扫码支付。如果二维码图片已存在，则直接返回图片URL；否则，生成新的二维码图片
2930:      * 并保存，然后返回新图片的URL。
2931:      *
2932:      * @param string $orderId 订单号
2933:      * @param object $order 订单对象，包含订单的相关信息
2934:      * @return string 二维码图片的URL
2935:      */
2936:     public function wxQrcode($orderId, $order)
2937:     {
2938:         // 从订单对象中获取验证码和商家ID
2939:         $verify_code = $order->verify_code;
2940:         $mer_id = $order->mer_id;
2941: 
2942:         // 获取网站的根URL，用于构造二维码的链接
2943:         $siteUrl = systemConfig('site_url');
2944: 
2945:         // 根据订单号、当前日期和固定字符串生成唯一的二维码文件名
2946:         $name = md5('owx' . $orderId . date('Ymd')) . '.jpg';
2947: 
2948:         // 获取附件仓库实例，用于后续操作二维码图片
2949:         $attachmentRepository = app()->make(AttachmentRepository::class);
2950: 
2951:         // 根据文件名查询已存在的二维码图片信息
2952:         $imageInfo = $attachmentRepository->getWhere(['attachment_name' => $name]);
2953: 
2954:         // 检查已存在的二维码图片是否有效，如果无效则删除并置为空
2955:         if (isset($imageInfo['attachment_src']) && strstr($imageInfo['attachment_src'], 'http') !== false && curl_file_exist($imageInfo['attachment_src']) === false) {
2956:             $imageInfo->delete();
2957:             $imageInfo = null;
2958:         }
2959: 
2960:         // 如果没有找到有效的二维码图片，则生成新的二维码
2961:         if (!$imageInfo) {
2962:             // 构造二维码的链接，包含验证码和商家ID
2963:             $codeUrl = set_http_type(rtrim($siteUrl, '/') . '/pages/admin/cancellate_result/index?cal_code=' . $verify_code . '&mer_id=' . $mer_id . '&is_jump=1', request()->isSsl() ? 0 : 1);
2964: 
2965:             // 生成二维码图片并获取图片路径
2966:             $imageInfo = app()->make(QrcodeService::class)->getQRCodePath($codeUrl, $name);
2967: 
2968:             // 如果生成二维码失败，则抛出异常
2969:             if (is_string($imageInfo)) throw new ValidateException('二维码生成失败');
2970: 
2971:             // 处理二维码图片的路径，确保路径是相对网站根目录的
2972:             $imageInfo['dir'] = tidy_url($imageInfo['dir'], null, $siteUrl);
2973: 
2974:             // 保存二维码图片信息到附件仓库
2975:             $attachmentRepository->create(systemConfig('upload_type') ?: 1, -2, $orderId, [
2976:                 'attachment_category_id' => 0,
2977:                 'attachment_name' => $imageInfo['name'],
2978:                 'attachment_src' => $imageInfo['dir']
2979:             ]);
2980: 
2981:             // 新二维码的URL
2982:             $urlCode = $imageInfo['dir'];
2983:         } else {
2984:             // 使用已存在的二维码图片URL
2985:             $urlCode = $imageInfo['attachment_src'];
2986:         }
2987: 
2988:         // 返回二维码图片的URL
2989:         return $urlCode;
2990:     }
