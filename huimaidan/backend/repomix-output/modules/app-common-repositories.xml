14: namespace app\common\repositories\system;
15: 
16: use app\common\dao\system\RecordDao;
17: use app\common\repositories\BaseRepository;
18: use app\common\repositories\user\UserAddressRepository;
19: 
20: class RecordRepository extends BaseRepository
21: {
22: 
23:     //文章关联商品
24:     const TYPE_ADDRESS_RECORD  =  'address_record';
25: 
26:     protected $dao;
27: 
28:     /**
29:      * @param RecordDao $dao
30:      */
31:     public function __construct(RecordDao $dao)
32:     {
33:         $this->dao = $dao;
34:     }
35: 
36:     /**
37:      * 添加记录到数据库。
38:      *
39:      * 根据传入的类型和数据，对特定类型的记录进行增加操作。目前支持的类型主要是地址记录。
40:      * 该方法首先检查传入的数据是否为空，如果为空，则直接返回，不进行任何操作。
41:      * 根据传入的类型，使用工厂模式获取相应的用户地址仓库实例。
42:      * 对于地址记录，通过地址ID获取地址详情，然后根据地址的省市信息，分别对省份和城市（如果城市为市辖区，则为区县）的记录数量进行增加操作。
43:      *
44:      * @param string $type 记录的类型，用于确定具体的操作逻辑。
45:      * @param array $data 记录的数据，包含相关字段的信息，如地址ID和增加的数量。
46:      */
47:     public function addRecord(string $type, array $data)
48:     {
49:         // 如果数据为空，则直接返回，不进行后续操作。
50:         if (empty($data)) return ;
51: 
52:         // 根据类型执行不同的操作逻辑。
53:         switch ($type) {
54:             case self::TYPE_ADDRESS_RECORD :
55:                 // 通过依赖注入获取用户地址仓库实例。
56:                 $userAddressRepository = app()->make(UserAddressRepository::class);
57:                 // 根据地址ID获取地址详情。
58:                 $addres = $userAddressRepository->getWhere(['address_id' => $data['address_id']]);
59: 
60:                 // 如果城市为市辖区，则使用区县ID和区县名称，否则使用城市ID和城市名称。
61:                 $cityid =  ($addres['city'] == '市辖区') ? $addres['district_id'] : $addres['city_id'] ;
62:                 $city =  ($addres['city'] == '市辖区') ? $addres['district'] : $addres['city'] ;
63: 
64:                 // 分别对省份和城市（区县）的记录数量进行增加操作。
65:                 $this->dao->incType($type, $addres['province_id'], $data['num'],['title' => $addres['province']]);
66:                 $this->dao->incType($type, $cityid, $data['num'],['title' => $city]);
67:                 break;
68:         }
69:     }
70: }
