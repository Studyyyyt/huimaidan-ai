350:         // 初始化一个空数组，用于存放转换后的类型信息
351:         $res = [];
352: 
353:         // 遍历内部类型数组，对每个类型进行处理
354:         foreach ($this->type as $k => $v) {
355:             // 将类型标识作为值赋给当前类型信息
356:             $v['value'] = $k;
357:             // 移除原始类型数组中的'type'键，避免冗余信息
358:             unset($v['type']);
359:             // 将处理后的类型信息添加到结果数组中
360:             $res[] = $v;
361:         }
362: 
363:         // 返回转换后的类型信息数组
364:         return $res;
365:     }
