130:     /**
131:      * 用户佣金增加函数
132:      *
133:      * 该函数用于处理用户佣金的增加逻辑。它首先根据当前用户的经纪等级获取下一个等级信息，
134:      * 然后检查是否存在相应的佣金记录。如果存在，则更新该记录的金额；如果不存在，则创建新的佣金记录。
135:      * 最后，检查用户是否满足升级到下一个经纪等级的条件。
136:      *
137:      * @param User $user 用户对象，表示当前操作的用户
138:      * @param string $type 佣金类型，用于区分不同种类的佣金
139:      * @param float $inc 佣金增加的金额，使用浮点数表示
140:      * @return bool 返回布尔值，表示用户是否成功升级到下一个经纪等级
141:      */
142:     public function inc(User $user, $type, $inc)
143:     {
144:         // 获取用户下一个经纪等级信息
145:         $nextLevel = $this->getNextLevel($user->brokerage_level);
146:         // 如果没有下一个等级，则返回false
147:         if (!$nextLevel) return false;
148: 
149:         // 实例化用户账单仓库类
150:         $make = app()->make(UserBillRepository::class);
151:         // 根据条件查询是否存在对应的佣金记录
152:         $bill = $make->getWhere(['uid' => $user->uid, 'link_id' => $nextLevel->user_brokerage_id, 'category' => 'sys_brokerage', 'type' => $type]);
153:         // 如果记录存在，则更新记录的金额并保存
154:         if ($bill) {
155:             $bill->number = bcadd($bill->number, $inc, 2);
156:             $bill->save();
157:         } else {
158:             // 如果记录不存在，则创建新的佣金记录
159:             $make->incBill($user->uid, 'sys_brokerage', $type, [
160:                 'number' => $inc,
161:                 'title' => $type,
162:                 'balance' => 0,
163:                 'status' => 0,
164:                 'link_id' => $nextLevel->user_brokerage_id
165:             ]);
166:         }
167: 
168:         // 检查用户是否满足升级到下一个经纪等级的条件，并返回检查结果
169:         return $this->checkLevel($user, $nextLevel);
170:     }
171: 
172:     /**
173:      * 检查用户是否满足升级经纪人的条件
174:      *
175:      * 本函数用于评估当前用户是否满足升级为其指定经纪人的条件。它通过查询用户的交易记录，
176:      * 并对比经纪人的升级规则，来判断用户是否达到升级标准。如果用户满足条件，则进行升级操作，
177:      * 包括更新用户和经纪人的相关数据，并记录用户的经纪级别。
178:      *
179:      * @param User $user 当前待评估的用户对象
180:      * @param UserBrokerage $nextLevel 用户待升级的下一个经纪级别对象
181:      * @return bool 如果用户满足升级条件，则返回true；否则返回false。
182:      */
183:     public function checkLevel(User $user, UserBrokerage $nextLevel)
184:     {
185:         // 查询用户的交易记录，满足特定条件的记录将用于评估升级条件
186:         $info = app()->make(UserBillRepository::class)->search(['uid' => $user->uid, 'category' => 'sys_brokerage', 'link_id' => $nextLevel->user_brokerage_id])
187:             ->column('number', 'type');
188: 
189:         // 遍历经纪人的升级规则，检查用户是否满足所有规则条件
190:         foreach ($nextLevel['brokerage_rule'] as $k => $rule) {
191:             // 如果用户交易记录中不存在对应类型的记录，且规则要求的交易数量大于0，则不满足升级条件
192:             if (!isset($info[$k]) && $rule['num'] > 0) return false;
193:             // 如果用户交易记录数量小于规则要求的数量，则不满足升级条件
194:             if ($rule['num'] > 0 && $rule['num'] > $info[$k]) return false;
195:         }
196: 
197:         // 用户满足升级条件，准备进行数据更新
198:         $nextLevel->user_num++;
199:         Db::transaction(function () use ($nextLevel, $user) {
200:             // 保存更新后的下一个经纪级别信息
201:             $nextLevel->save();
202:             // 如果当前用户已有经纪人，并且其用户数量大于0，则减少该经纪人的用户数量
203:             if ($user->brokerage && $user->brokerage->user_num > 0) {
204:                 $user->brokerage->user_num--;
205:                 $user->brokerage->save();
206:             }
207:             // 更新用户经纪级别，并保存
208:             $user->brokerage_level = $nextLevel->brokerage_level;
209:             $user->save();
210: 
211:             // 将用户的经纪级别信息缓存起来，以便后续快速查询
212:             $key = 'notice_brokerage_level_' . $user->uid;
213:             app()->make(CacheRepository::class)->save($key,$nextLevel->brokerage_level);
214:         });
215: 
216:         // 返回true，表示用户满足升级条件
217:         return true;
218:     }
219: 
220:     /**
221:      * 根据用户的交易记录和下级经纪人的佣金规则，计算下级经纪人的佣金比率。
222:      *
223:      * @param User $user 当前用户对象
224:      * @param UserBrokerage $nextLevel 下级经纪人的佣金规则对象
225:      * @return array 返回计算后的佣金比率和任务完成情况
226:      */
227:     public function getLevelRate(User $user, UserBrokerage $nextLevel)
228:     {
229:         // 查询用户指定条件的交易记录，用于后续计算佣金比率
230:         $info = app()->make(UserBillRepository::class)->search(['uid' => $user->uid, 'category' => 'sys_brokerage', 'link_id' => $nextLevel->user_brokerage_id])
231:             ->column('number', 'type');
232: 
233:         // 获取下级经纪人的佣金规则
234:         $brokerage_rule = $nextLevel['brokerage_rule'];
235: 
236:         // 遍历佣金规则，计算每个规则对应的佣金比率和完成任务的数量
237:         foreach ($nextLevel['brokerage_rule'] as $k => $rule) {
238:             // 如果规则的交易数量要求为0或负数，则移除该规则
239:             if ($rule['num'] <= 0) {
240:                 unset($brokerage_rule[$k]);
241:                 continue;
242:             }
243: 
244:             // 根据用户的交易数量和规则的要求数量，计算佣金比率
245:             if (!isset($info[$k])) {
246:                 $rate = 0;
247:             } else if ($rule['num'] > $info[$k]) {
248:                 $rate = bcdiv($info[$k], $rule['num'], 2) * 100;
249:             } else {
250:                 $rate = 100;
251:             }
252: 
253:             // 更新规则信息，添加佣金比率和已完成的任务数量
254:             $brokerage_rule[$k]['rate'] = $rate;
255:             $brokerage_rule[$k]['task'] = (float)(min($info[$k] ?? 0, $rule['num']));
256:         }
