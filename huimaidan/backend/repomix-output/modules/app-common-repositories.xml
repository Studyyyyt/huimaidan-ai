 75:         $this->dao = $dao;
 76:     }
 77: 
 78:     /**
 79:      * 获取活动范围类型
 80:      *
 81:      * 此方法用于根据传入的类型参数返回相应的活动范围类型。如果没有指定类型参数，
 82:      * 则返回所有活动范围类型的映射数组。这个方法主要用于内部逻辑，以确定活动的范围和类型。
 83:      *
 84:      * @param null $type 活动的类型标识，如果为null，则返回所有类型。
 85:      * @return array|mixed 如果$type有值，返回对应的活动范围类型；否则返回所有类型的整体映射。
 86:      */
 87:     public function getActiveScopeType($type = null)
 88:     {
 89:         // 定义活动范围类型的映射
 90:         $data = [
 91:             1 => self::TYPE_MUST_SECKILL_ACTIVE,
 92:         ];
 93:         // 根据$type是否有值，返回相应的结果
 94:         return $type ? $data[$type] : $data;
 95:     }
