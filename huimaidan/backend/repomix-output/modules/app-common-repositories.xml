1244:                 'meal_id' => 0,
1245:                 'pay_type'=> ServeOrderRepository::PAY_TYPE_SYS,
1246:                 'order_sn'=> $order_sn,
1247:                 'pay_price'=>$data['number'],
1248:                 'order_info'=> json_encode(['type_id' => 0, 'is_margin' => 10, 'margin' => $data['number'], 'ot_margin' => $balance,]),
1249:                 'type'   => ServeOrderRepository::TYPE_MARGIN,
1250:                 'status' => 1,
1251:                 'mer_id' => $id,
1252:                 'pay_time' => date('Y-m-d H:i:s',time())
1253:             ];
1254:             $bill = [
1255:                 'title' => '线下补缴保证金',
1256:                 'mer_id' => $merchant['mer_id'],
1257:                 'number' => $data['number'],
1258:                 'mark'=> '操作者：'.request()->adminId().'/'.request()->adminInfo()->real_name,
1259:                 'balance'=> $balance,];
1260: 
1261:             // 商户操作记录
1262:             event('create_operate_log', [
1263:                 'category' => OperateLogRepository::PLATFORM_EDIT_MERCHANT_AUDIT_MARGIN,
1264:                 'data' => [
1265:                     'merchant' => $merchant,
1266:                     'admin_info' => request()->adminInfo(),
1267:                     'update_infos' => ['status' => 10, 'action' => '线下补缴保证金', 'number' => $data['number']]
1268:                 ],
1269:             ]);
1270: 
1271:             Db::transaction(function () use ($merchant, $data,$userBillRepository,$bill,$balance,$serveOrder,$serveOrderRepository) {
1272:                 $merchant->margin = $balance;
1273:                 $merchant->margin_remind_time = null;
1274:                 $merchant->is_margin = 10;
1275:                 $merchant->mark = $data['mark'];
1276:                 $merchant->save();
1277:                 $serveOrderData = $serveOrderRepository->create($serveOrder);
1278:                 $bill['link_id'] = $serveOrderData->order_id;
1279:                 $userBillRepository->bill(0, 'mer_margin', 'local_margin', 1, $bill);
