 65:         // 尝试从缓存中获取产品信息，如果存在则直接返回
 66:         if ($result= Cache::get($key)) return json_decode($result,true);
 67: 
 68:         // 检查商家是否有可用的采集次数
 69:         $number = app()->make(MerchantRepository::class)->checkCrmebNum($merId,'copy');
