554:     /**
555:      * 同步商品审核状态
556:      * 该方法用于从小程序端获取商品的审核状态，并更新到数据库中，确保数据的一致性。
557:      * 主要处理商品的审核状态变更，以及根据审核状态更新商品的可用性。
558:      */
559:     public function syncGoodStatus()
560:     {
561:         // 获取所有商品的ID
562:         $goodsIds = $this->dao->goodsStatusAll();
563: 
564:         // 如果商品ID为空，则直接返回，不进行后续操作
565:         if (!count($goodsIds)) return;
566: 
567:         // 调用小程序服务类，获取小程序中商品仓库的数据
568:         $res = MiniProgramService::create()->miniBroadcast()->getGoodsWarehouse(array_keys($goodsIds))->toArray();
569: 
570:         // 遍历获取的商品数据
571:         foreach ($res['goods'] as $item) {
572:             // 检查商品ID在获取的商品ID列表中是否存在，并且审核状态是否发生变化
573:             if (isset($goodsIds[$item['goods_id']]) && $item['audit_status'] != $goodsIds[$item['goods_id']]) {
574:                 // 准备要更新的数据
575:                 $data = ['audit_status' => $item['audit_status']];
576: 
577:                 // 如果审核状态为2（审核中）或3（审核未通过），则更新商品的状态，并设置相应的错误信息
578:                 if (in_array($item['audit_status'], [2, 3])) {
579:                     $data['status'] = $item['audit_status'] == 3 ? -1 : 2;
580:                     if (-1 == $data['status']) {
581:                         $data['error_msg'] = '微信审核未通过';
582:                     }
583:                 }
584: 
585:                 // 更新商品的审核状态
586:                 // 同步商品审核状态
587:                 $this->dao->updateGoods($item['goods_id'], $data);
588:             }
589:         }
590:     }
591: }
