147:     /**
148:      * 创建或编辑组合数据表单
149:      *
150:      * 该方法用于生成一个用于添加或编辑组合数据的表单。表单包含了一系列的输入字段和选择项，
151:      * 用于收集关于组合数据的各种信息，如后台类型、组合数据名称、键等。
152:      *
153:      * @param int|null $id 组合数据的ID，如果为null，则表示创建新组合数据；否则，表示编辑已有的组合数据。
154:      * @param array $formData 表单的初始数据，用于填充表单字段。
155:      * @return Form 返回生成的表单对象。
156:      */
157:     public function form(?int $id = null, array $formData = []): Form
158:     {
159:         // 根据$id的值决定表单提交的URL，如果是新建，则提交到'groupCreate'路由；如果是编辑，则提交到'groupUpdate'路由。
160:         $formUrl = is_null($id) ? Route::buildUrl('groupCreate')->build() : Route::buildUrl('groupUpdate', ['id' => $id])->build();
161:         $form = Elm::createForm($formUrl);
162: 
163:         // 定义表单的验证规则和字段。包括选择后台类型、输入组合数据名称、键、说明等字段。
164:         $form->setRule([
165:             // 选择后台类型字段，是一个下拉列表，必须选择。
166:             Elm::select('user_type', '后台类型：', 0)->options([
167:                 ['label' => '总后台配置', 'value' => 0],
168:                 ['label' => '商户后台配置', 'value' => 1],
169:             ])->placeholder('请选择后台类型')->requiredNum('请选择后台类型'),
170:             // 输入组合数据名称字段，必须输入。
171:             Elm::input('group_name', '组合数据名称：')->placeholder('请输入组合数据名称')->required('请输入组合数据名称'),
172:             // 输入组合数据键字段，必须输入。
173:             Elm::input('group_key', '组合数据key：')->placeholder('请输入组合数据key')->required('请输入组合数据key'),
174:             // 输入组合数据说明字段，非必须。
175:             Elm::input('group_info', '组合数据说明：')->placeholder('请输入组合数据说明'),
176:             // 输入排序字段，是一个数字输入框，默认为0，最大值为99999。
177:             Elm::number('sort', '排序：', 0)->precision(0)->max(99999),
178:             // 字段组，用于定义一组相关的字段，这里包括了类型、名称、键等字段。
179:             Elm::group('fields', '字段：')->rules([
180:                 // 选择字段类型，是一个必选的下拉列表，选项根据self::TYPES动态生成。
181:                 Elm::select('type', '类型：')->required('请选择字段类型')->options(function () {
182:                     $options = [];
183:                     foreach (self::TYPES as $value => $label) {
184:                         $options[] = compact('value', 'label');
185:                     }
186:                     return $options;
187:                 }),
188:                 // 输入字段名称字段。
189:                 Elm::input('name', '字段名称：')->placeholder('请输入字段名称'),
190:                 // 输入字段键字段。
191:                 Elm::input('field', '字段key：')->placeholder('请输入字段key'),
192:                 // 输入选择项字段，用于配置多选框等需要选择项的字段类型。
193:                 Elm::textarea('param', '选择项：'),
194:                 // 输入配置字段，用于配置字段的额外属性。
195:                 Elm::textarea('props', '配置：'),
196:             ]),
197:         ]);
198: 
199:         // 设置表单的标题，并根据$id的值决定是添加还是编辑组合数据。最后设置表单的初始数据。
200:         return $form->setTitle(is_null($id) ? '添加组合数据' : '编辑组合数据')->formData($formData);
201:     }
