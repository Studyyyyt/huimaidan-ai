245:     /**
246:      * 同步调账订单和退款订单到调账表
247:      *
248:      * 本函数用于将订单和退款订单的信息同步到调账表中，以确保调账表中的数据与实际发生的订单和退款一致。
249:      * 这对于财务对账来说是非常重要的，可以确保所有的交易都能在调账表中找到相应的记录。
250:      *
251:      * @param array $order_ids 订单ID列表，包含需要同步到调账表的订单ID。
252:      * @param array $refund_ids 退款ID列表，包含需要同步到调账表的退款ID。
253:      * @param int $reconciliation_id 调账ID，用于标识这次调账操作。
254:      *
255:      * @return bool 返回操作结果，true表示成功插入所有数据，false表示插入数据失败。
256:      */
257:     public function reconciliationOrder($order_ids, $refund_ids, $reconciliation_id)
258:     {
259:         // 初始化数据数组，用于存储待插入调账表的订单和退款信息。
260:         $data = [];
261: 
262:         // 遍历订单ID列表，构建订单类型的调账数据，并加入到数据数组中。
263:         foreach ($order_ids as $item) {
264:             $data[] = [
265:                 'order_id' => $item,
266:                 'reconciliation_id' => $reconciliation_id,
267:                 'type' => 0, // 订单类型标识。
268:             ];
269:         }
270: 
271:         // 遍历退款ID列表，构建退款类型的调账数据，并加入到数据数组中。
272:         foreach ($refund_ids as $item) {
273:             $data[] = [
274:                 'order_id' => $item,
275:                 'reconciliation_id' => $reconciliation_id,
276:                 'type' => 1, // 退款类型标识。
277:             ];
278:         }
279: 
280:         // 使用依赖注入的方式，创建调账订单仓库实例，并调用其insertAll方法，批量插入调账数据。
281:         // 返回操作结果，true表示成功插入所有数据，false表示插入数据失败。
282:         return app()->make(MerchantReconciliationOrderRepository::class)->insertAll($data);
283:     }
