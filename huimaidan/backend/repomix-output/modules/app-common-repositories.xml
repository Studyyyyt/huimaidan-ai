396:      *
397:      * 本函数用于生成一个唯一的登录验证码键，并将该验证码与键关联起来存储在缓存中。
398:      * 验证码键的生成结合了微秒时间和随机数，以确保唯一性。
399:      * 验证码在缓存中的有效期通过配置文件设定，以分钟为单位。
400:      *
401:      * @param string $code 登录验证码
402:      * @return string 生成的验证码键
403:      */
404:     public function createLoginKey(string $code)
405:     {
406:         // 生成一个唯一的验证码键，基于当前微秒时间戳和随机数
407:         $key = uniqid(microtime(true), true);
408: 
409:         // 将验证码与键关联，存储到缓存中，并设定过期时间
410:         // 缓存有效期通过配置文件获取，默认为5分钟
411:         Cache::set('am_captcha' . $key, $code, Config::get('admin.captcha_exp', 5) * 60);
412: 
413:         // 返回生成的验证码键
414:         return $key;
415:     }
