139:     public function lineChart($date = '', $merId = '')
140:     {
141:         $adminId = app('request')->adminId() ?: '';
142:         [$cacheky, $cacheTags] = CacheService::setWithTags(
143:             CacheService::ANALYTICS_ORDER_LINE_CHART,
144:             compact('merId','date', 'adminId')
145:         );
146: 
147:         return Cache::tag($cacheTags)->remember($cacheky, function () use ($date, $merId) {
148:             $merId = $merId ? : '';
149:             [$dates, $customFormat] = getStepLength($date);
150:             $format = $customFormat ? $customFormat : self::$formatMap[$date] ?? '%m-%d';
151: 
152:             $field = Db::raw("from_unixtime(unix_timestamp(StoreOrder.create_time),'{$format}') as month,sum(pay_price) as pay_price,count(*) as order_num");
153:             $res = $this->dao->search(['date' => $date, 'mer_id' => $merId, 'paid' => 1])
154:                 ->field($field)
155:                 ->group("month")
156:                 ->select()->toArray();
157:             $field = Db::raw("from_unixtime(unix_timestamp(StoreRefundOrder.create_time),'{$format}') as month,sum(refund_price) as refund_price,count(*) as refund_num");
158:             $refundOrderRepository = app()->make(StoreRefundOrderRepository::class);
159:             $refundRes = $refundOrderRepository->search(['date' => $date, 'mer_id' => $merId])
160:                 ->field($field)
161:                 ->group("month")
162:                 ->select()->toArray();
163:             $data = [];
164:             foreach ($res as $re) {
165:                 $data[$re['month']] = ['xaxis' => $re['month'], 'pay_price' => $re['pay_price'], 'order_num' => $re['order_num'],];
166:             }
167:             foreach ($refundRes as $re) {
168:                 if (isset($data[$re['month']])){
169:                     $data[$re['month']]['refund_price'] = $re['refund_price'];
170:                     $data[$re['month']]['refund_num'] = $re['refund_num'];
171:                 } else {
172:                     $data[$re['month']] = [
173:                         'xaxis' => $re['month'],
174:                         'pay_price' => 0,
175:                         'order_num'=> 0,
176:                         'refund_price' =>$re['refund_price'],
177:                         'refund_num' => $re['refund_num'],
178:                     ];
179:                 }
180:             }
181:             $redata =  [];
182:             foreach ($dates as $mo) {
183:                 $redata[] = isset($data[$mo]) ? $data[$mo] : [
184:                     'xaxis' => $mo,
185:                     'pay_price' => 0,
186:                     'order_num'=> 0,
187:                     'refund_price' => 0,
188:                     'refund_num' => 0,
189:                 ];
190:             }
191:             return $redata;
192:         }, self::CACHA_TIME);
193:     }
