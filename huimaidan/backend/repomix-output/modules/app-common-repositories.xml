3796:      * @param $res
3797:      * @param $attrValue
3798:      * @return true
3799:      * @author Qinii
3800:      */
3801:     public function seckillStockCache($res, $reset = false)
3802:     {
3803:         /**
3804:          * 秒杀商品生成缓存库存
3805:          * 缓存key格式: self::SECKILL_STOCK_CACHE_KEY . 活动ID . 日期 . 商品ID . 秒杀时间段ID . 属性unique
3806:          */
3807:         $storeSeckillActiveRepository = app()->make(StoreSeckillActiveRepository::class);
3808:         $active = $storeSeckillActiveRepository->get($res['active_id']);
3809:         $today = strtotime(date('Y-m-d'));
3810:         if ($today < strtotime($active['start_day']) || $today > strtotime($active['end_day'])) return ;
3811: 
3812:         $product_today = [self::SECKILL_STOCK_CACHE_KEY, $res['active_id'],  date('Y-m-d',$today) , $res['product_id']];
3813:         $redis = app()->make(RedisCacheService::class);
3814:         $product_today_key = implode('_',$product_today);
3815: 
3816:         $key = $redis->get($product_today_key);
3817:         if (!$reset && $key) return ;
3818: 
3819:         //需要组合的key
3820:         $cache_attr = [];
3821:         $cache_array = [];
3822:         $cache_key_times = [];
3823:         $cache_attr[] = $product_today;
3824:         foreach ($active['seckill_time_ids'] as $id) {
3825:             $cache_key = array_map(function($item) use($id) {
3826:                 $item[] = $id;
3827:                 return $item;
3828:             },$cache_attr);
3829:             $cache_key_times = array_merge($cache_key_times,$cache_key);
3830:         }
3831: 
3832:         $cache_key_unique = [];
3833:         foreach ($res['sku'] as $value) {
3834:             $cache_keys = array_map(function($item) use($value) {
3835:                 $item[] = $value['unique'];
3836:                 $item = implode('_',$item);
3837:                 return $item;
3838:             },$cache_key_times);
3839:             $cache_array = array_combine($cache_keys, array_fill(0, count($cache_keys), $value['stock']));
3840:             $cache_key_unique = array_merge($cache_key_unique,$cache_array);
3841:         }
3842:         $redis->set($product_today_key, 1, 60 * 60 * 24);
3843:         //批量存入redis
3844:         foreach ($cache_key_unique as $k => $v) {
3845:             $this->push($k,1,$v);
3846:         }
3847:         return true;
3848:     }
