162:      * @return bool|\think\response\Json
163:      * @throws \think\db\exception\DbException
164:      *
165:      * @date 2023/10/09
166:      * @author yyw
167:      */
168:     public function batchProcess(int $mer_id, string $type, array $ids = [], array $data = [], array $where = [], $admin_info = [])
169:     {
170:         if (empty($this->type_list[$type])) {
171:             throw new ValidateException('类型异常');
172:         }
173: 
174:         if ($type != 'price' && empty($ids)) {
175:             throw new ValidateException('批量设置商品id为空，请检查');
176:         }
177:         if (empty($mer_id)) {
178:             throw new ValidateException('商户id异常，请检查');
179:         }
180: 
181:         $data = $this->validateData($type, $data);;
182: 
183:         switch ($type) {
184:             case 'cate':
185:                 $this->dao->updates($ids, $data);
186:                 break;
187:             case 'mer_cate':
188:                 $this->batchMerCate($mer_id, $ids, $data['mer_cate_ids']);
189:                 break;
190:             case 'label':
191:                 app()->make(SpuRepository::class)->batchLabels($ids, $data, $mer_id);
192:                 break;
193:             case 'delivery_method':
194:                 //验证参数
195:                 if (count($data['delivery_way']) > 3 || !is_array($data['delivery_way'])) {
196:                     throw new ValidateException('配送方式参数异常');
197:                 }
198:                 // 1:自提/到店 2:快递/上门 3:同城配送
199:                 foreach ($data['delivery_way'] as $value) {
200:                     if (!in_array($value, [1, 2, 3])) {
201:                         throw new ValidateException('没有该配送方式，请选择正确的配送方式');
202:                     }
203:                 }
204:                 if(isset($data['reservation_type']) && !empty($data['reservation_type'])) {
205:                     foreach ($data['reservation_type'] as $value) {
206:                         if (!in_array($value, [1, 2])) {
207:                             throw new ValidateException('预约商品，请选择正确的预约服务方式');
208:                         }
209:                     }
210:                     $reservationType = count($data['reservation_type']) == 2 ? 3 : $data['reservation_type'][0];
211:                     $this->reservationDao->query([])->whereIn($this->dao->getPk(), $ids)->update(['reservation_type' => $reservationType]);
212:                 }
213:                 unset($data['reservation_type']);
214: 
215:                 if (in_array(1, $data['delivery_way'])) {
216:                     $this->dao->query([])->whereIn($this->dao->getPk(), $ids)->where('type', 1)->update(['delivery_way' => 1]);
217:                 }
218:                 $data['delivery_way'] = implode(',', $data['delivery_way']);
219:                 $this->dao->query([])->whereIn($this->dao->getPk(), $ids)->where('type', 0)->update($data);
220:                 break;
221:             case 'postage':
222:                 if ($data['delivery_free'] == 1) {
223:                     $data['temp_id'] = 0;
224:                 } else {
225:                     if (!app()->make(ShippingTemplateRepository::class)->merInExists($mer_id, [$data['temp_id']]))
226:                         throw new ValidateException('请选择您自己的运费模板');
227:                 }
228:                 $this->dao->updates($ids, $data);
229:                 break;
230:             case 'commission':
231:                 if ($data['extension_one'] > 1 || $data['extension_one'] < 0 || $data['extension_two'] < 0 || $data['extension_two'] > 1) {
232:                     return app('json')->fail('比例0～1之间');
233:                 }
234:                 app()->make(ProductAttrValueRepository::class)->updatesExtension($ids, $data);
235:                 break;
236:             case 'member':
237:                 $this->dao->updates($ids, $data);
238:                 break;
239:             case 'sys_form':
240:                 $this->batchForm($mer_id, $ids, (int)$data['mer_form_id']);
241:                 break;
242:             case 'price':
243:                 $message = $this->queueBatchPrice($mer_id, $data['price_type'], $data['price_number'], $ids, $where, $admin_info);
244:                 break;
245:         }
246: 
247:         return $message ?? true;
248:     }
