211:         if (!$data)  throw new ValidateException('数据不存在');
212: 
213:         // 创建表单对象，并设置表单提交的URL
214:         $form = Elm::createForm(Route::buildUrl('systemMerchantTypeMark', ['id' => $id])->build());
215: 
216:         // 设置表单的验证规则，包括一个文本输入框用于修改备注信息
217:         $form->setRule([
