203:     /**
204:      * 根据日志列表中的MSN类型和号码，将相关数据存储在缓存中，以减少重复数据的存储。
205:      * 对于特定类型的日志，将其相关数据设置到日志对象中。
206:      *
207:      * @param array $list 日志对象的列表。
208:      * @return array 处理后的日志对象列表。
209:      */
210:     public function getSendDataList($list)
211:     {
212:         // 初始化缓存数组，用于存储按MSN类型和号码组合的唯一数据。
213:         $cache = [];
214:         foreach ($list as $log) {
215:             // 忽略非指定类型的日志，以减少后续处理的负担。
216:             if (!in_array($log->msn_type, [4, 5, 6, 7, 8])) continue;
217: 
218:             // 创建键，用于根据MSN类型和号码查找缓存数据。
219:             $key = $log->msn_type . $log->msn;
220: 
221:             // 如果缓存中已存在该键的数据，则直接从缓存中获取数据并设置到日志对象中。
222:             if (isset($cache[$key])) {
223:                 if ($log->msn_type == 4)
224:                     $log->set('product', $cache[$key]);
225:                 else if ($log->msn_type == 5)
226:                     $log->set('orderInfo', $cache[$key]);
227:                 else if ($log->msn_type == 6)
228:                     $log->set('refundOrder', $cache[$key]);
229:                 else if ($log->msn_type == 8)
230:                     $log->set('productGroup', $cache[$key]);
231:                 else
232:                     $log->set('presell', $cache[$key]);
233:             } else {
234:                 // 如果缓存中不存在该键的数据，则从日志对象中获取数据并存储到缓存中。
235:                 if ($log->msn_type == 4)
236:                     $cache[$key] = $log->product;
237:                 else if ($log->msn_type == 5)
238:                     $cache[$key] = $log->orderInfo;
239:                 else if ($log->msn_type == 6)
240:                     $cache[$key] = $log->refundOrder;
241:                 else if ($log->msn_type == 8)
242:                     $cache[$key] = $log->productGroup;
243:                 else
244:                     $cache[$key] = $log->presell;
245:             }
246:         }
247:         return $list;
248:     }
