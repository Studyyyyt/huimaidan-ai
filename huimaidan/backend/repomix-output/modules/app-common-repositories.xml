 950:         $ids = $productRepository->search(['coupon_id' => $id])->column('product_id');
 951: 
 952:         // 初始化产品总数和列表
 953:         $count = 0;
 954:         $list = [];
 955: 
 956:         // 根据优惠券类型进行不同逻辑的查询
 957:         switch ($res['type']) {
 958:             case 11: // 品类优惠券
