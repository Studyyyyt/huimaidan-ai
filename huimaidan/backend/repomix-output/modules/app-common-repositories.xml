251: 
252:         // 如果当前分类有父分类（pid大于0），则递归调用本方法获取父分类的名称
253:         if ($info['pid'] > 0) {
254:             $parentName = $this->getAllFatherName($info['pid']);
255:             // 构建当前分类及其所有父分类的路径，并返回
256:             return $parentName . '/' . $info['cate_name'];
257:         } else {
