2744:     public function cartCheck(array $data, $userInfo)
2745:     {
2746:         $cart = null;
2747:         $where = $this->dao->productShow();
2748:         $where['product_id'] = $data['product_id'];
2749:         unset($where['is_gift_bag']);
2750:         $product = $this->dao->search(null, $where)->find();
2751:         if (!$product) throw new ValidateException('商品已下架');
2752:         if ($product['once_min_count'] > 0 && $product['once_min_count'] > $data['cart_num'])
2753:             throw new ValidateException('[低于起购数:' . $product['once_min_count'] . ']' . mb_substr($product['store_name'], 0, 10) . '...');
2754:         if ($product['pay_limit'] == 1 ){
2755:             if($product['once_max_count'] < $data['cart_num']) {
2756:                 throw new ValidateException('[超出单次限购数：' . $product['once_max_count'] . ']' . mb_substr($product['store_name'], 0, 10) . '...');
2757:             }
2758:             $cart_num = $this->productOnceCountCart($product['product_id'], $data['product_attr_unique'],$userInfo->uid);
2759:             if($cart_num && ($cart_num + $data['cart_num']) > $product['once_max_count']) {
2760:                 throw new ValidateException('[加购总数量超出单次限购数：' . $product['once_max_count'] . ']' . mb_substr($product['store_name'], 0, 10) . '...');
2761:             }
