410:     public function today_pay_count($params = [])
411:     {
412:         return $this->cache(function() use($params) {
413:             $h = date('H');
414:             $j = ($h <= 12) ? 0 : 1;
415:             $i = '0';
416:             do {
417:                 $dates[] = (string)($i < 10 ? '0' . $i : $i);
418:                 $i++;
419:                 $i = $i + $j;
420:             } while ($h >= $i);
421:             $storeOrderRepository = app()->make(StoreOrderRepository::class);
422:             $field = Db::raw('from_unixtime(unix_timestamp(create_time),\'%H\') as hours,count(order_id) order_count,count(distinct uid) as user_count');
423:             $query = $storeOrderRepository->getSearch([])->where('paid',1)->whereDay('create_time');
424:             $orderList = $query->field($field)->order('hours ASC')->group('hours')->select()->toArray();
425:             $orderList = array_combine(array_column($orderList, 'hours'), $orderList);
426: 
427:             $today_pay_count = [];
428:             foreach ($dates as $date) {
429:                 if ($j) {
430:                     $_k = $date + $j;
431:                     $k = (string)($_k < 10 ? '0' . $_k : $_k);
432:                     $arr = [
433:                         'hours' => (string)$date.'~'.$k,
434:                         'user_count' => $orderList[$date]['user_count'] ?? 0,
435:                         'order_count' => $orderList[$date]['order_count'] ?? 0,
436:                     ];
437:                     if (isset($orderList[$k])) {
438:                         $arr['user_count']  = $arr['user_count'] + $orderList[$k]['user_count'];
439:                         $arr['order_count'] = $arr['order_count'] + $orderList[$k]['order_count'];
440:                     }
441:                 } else {
442:                     $arr = [
443:                         'hours' => (string)$date,
444:                         'user_count' => $orderList[$date]['user_count'] ?? 0,
445:                         'order_count' => $orderList[$date]['order_count'] ?? 0,
446:                     ];
447:                 }
448:                 $today_pay_count[] = $arr;
449:             }
450:             return $today_pay_count;
451:         });
452:     }
