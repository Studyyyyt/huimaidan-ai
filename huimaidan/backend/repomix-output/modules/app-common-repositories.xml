 865:     /**
 866:      * 修改状态
 867:      * @param $id
 868:      * @param $type
 869:      * @param $data
 870:      * @return int
 871:      * @throws \think\db\exception\DataNotFoundException
 872:      * @throws \think\db\exception\DbException
 873:      * @throws \think\db\exception\ModelNotFoundException
 874:      * @author wuhaotian
 875:      * @email 442384644@qq.com
 876:      * @date 2024/7/23
 877:      */
 878:     public function switchStatus($id, $type, $data)
 879:     {
 880:         $where = [
 881:             'financial_id' => $id,
 882:             'is_del' => 0,
 883:             'status' => 0,
 884:             'type' => $type
 885:         ];
 886: 
 887:         $res = $this->dao->getWhere($where);
 888:         if (!$res) throw new ValidateException('数据不存在');
 889:         switch ($type) {
 890:             case 0:
 891:                 if ($data['status'] == -1) $this->cancel(null, $id, $data);
 892:                 break;
 893:             case 1:
 894:                 $bill['number'] = $res['extract_money'];
 895:                 $bill['mer_id'] = $res->merchant->mer_id;
 896:                 if ($data['status'] == 1) {
 897:                     $this->agree($res);
 898:                     $data['financial_status'] = 1;
 899:                     $tempId = 'REFUND_MARGIN_SUCCESS';
 900:                     $bill['title'] = '审核通过';
 901:                     $bill['balance'] = 0;
 902:                     $bill['mark'] = '【 操作者：' . request()->adminId() . '|' . request()->adminInfo()->real_name . '】';
 903:                     $pm = 0;
 904:                 } else if ($data['status'] == -1) {
 905:                     $number = bcadd($res->merchant->margin, $res->extract_money, 2);
 906:                     $res->merchant->is_margin = 10;
 907:                     $res->merchant->margin = $number;
 908:                     $res->merchant->save();
 909:                     $tempId = 'REFUND_MARGIN_FAIL';
 910:                     $bill['title'] = '审核拒绝';
 911:                     $bill['balance'] = $number;
 912:                     $bill['mark'] = $data['refusal'] . '【 操作者：' . request()->adminId() . '|' . request()->adminInfo()->real_name . '】';
 913:                     $pm = 1;
 914:                 }
 915:                 $userBillRepository = app()->make(UserBillRepository::class);
