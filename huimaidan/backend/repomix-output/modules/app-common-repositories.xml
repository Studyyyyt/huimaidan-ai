 22:     /**
 23:      * 检查用户购物车信息、地址信息以及订单相关数据，并准备创建订单所需的数据。
 24:      * 此函数主要用于在用户提交订单前，验证和整理所有必要的信息，包括购物车商品、收货地址、积分使用等。
 25:      *
 26:      * @param User $user 当前用户对象。
 27:      * @param int $cartId 购物车ID，代表用户选中的购物车。
 28:      * @param int $addressId 收货地址ID，代表用户选择的收货地址。
 29:      * @param bool $useIntegral 是否使用积分，用于标记是否在本次订单中使用积分。
 30:      * @param Order|null $createOrder 创建的订单对象，如果提供了订单对象，则表示在此基础上进行订单数据的填充和验证。
 31:      * @return array 返回一个包含订单创建所需数据的数组，包括加密的key、订单类型、订单模型等。
 32:      */
 33:     public function check($user, $cartId, $addressId,  $useIntegral , $createOrder = null)
 34:     {
 35:         // 生成一个唯一的key，用于标识此次订单请求，防止重复提交等安全问题。
 36:         $key = md5(json_encode(compact('cartId', 'useIntegral', 'addressId'))) .  $user->uid;
 37: 
 38:         // 验证并获取用户选择的收货地址详情。
 39:         $address = $this->validateAddress($user,$addressId);
 40: 
 41:         // 验证购物车列表，同时获取订单模型、订单扩展信息和订单类型。
 42:         [$merchantCartList,$order_model,$order_extend,$order_type] = $this->validateCartList($cartId,$user,$address);
 43: 
 44:         // 验证并处理商家列表，准备订单中商家信息的展示和处理。
 45:         $successData = $this->validateMerchantList($merchantCartList);
 46: 
 47:         // 返回整理后的所有订单创建所需数据，包括用户积分、收货地址等。
 48:         return $successData + [
 49:                 'key' => $key,
 50:                 'order_type' => $order_type,
 51:                 'order_model' => $order_model,
 52:                 'order_extend' => $order_extend,
 53:                 'true_integral' => (int)$user->integral,
 54:                 'address' => $address,
 55:                 ];
 56:     }
