370:      * @param $id
371:      * @param array $ids
372:      * @author xaboy
373:      * @day 2020-05-11
374:      */
375:     public function sendNews($id, array $ids)
376:     {
377:         if (!count($ids)) return;
378:         /** @var ArticleRepository $make */
379:         $make = app()->make(ArticleRepository::class);
380:         $articles = $make->wechatNewIdByData($id);
381:         $news = [];
382:         foreach ($articles as $article) {
383:             $news[] = [
384:                 'title' => $article['title'],
385:                 'image' => $article['image_input'],
386:                 'date' => $article['create_time'],
387:                 'description' => $article['synopsis'],
388:                 'id' => $article['article_id']
389:             ];
390:         }
391:         $make = app()->make(UserRepository::class);
392:         foreach ($ids as $_id) {
393:             $user = $make->get($_id);
394:             if ($this->dao->isSubscribeWechatUser($user->wechat_user_id)) {
395:                 Queue::push(SendNewsJob::class, [$user->wechat_user_id, $news]);
396:             }
397:         }
398:     }
