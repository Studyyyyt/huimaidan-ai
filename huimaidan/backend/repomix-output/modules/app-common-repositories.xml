170:             'pay_count' => $data['pay_count'],
171:             'once_pay_count' => $data['once_pay_count'],
172:             'buying_count_num' => $data['buying_count_num'],
173:             'buying_num' => $slt['buying_num'],
174:             'ficti_status' => $data['ficti_status'],
175:             'ficti_num' => $slt['ficti_num'],
176:             'time' => $data['time'],
177:             'product_status' => 0,
178:             'action_status' => 0,
179:             'leader_extension' => $data['leader_extension'],
180:             'leader_rate' => $data['leader_rate'],
181:         ];
182: 
183:         // 使用数据库事务来确保数据一致性
184:         Db::transaction(function()use($id,$active,$product,$data){
185:             $product_make = app()->make(ProductRepository::class);
186:             $sku_make = app()->make(ProductGroupSkuRepository::class);
187:             // 触发产品更新前的事件
188:             event('product.groupUpdate.before',compact('id','data'));
189:             // 获取当前产品信息
190:             $resData = $this->dao->get($id);
191:             // 处理SKU相关数据
192:             $data['product_id'] = $resData['product_id'];
193:             $res = $this->sltSku($data,$id);
194:             // 更新活动信息
195:             $active['price'] = $res['price'];
196:             $this->dao->update($id,$active);
