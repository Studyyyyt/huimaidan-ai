114:     /**
115:      * 根据条件获取列表数据
116:      *
117:      * 本函数用于根据给定的条件、分页和限制从数据库获取列表数据。它首先应用条件查询，其中包括一个固定的条件（is_del = 0），
118:      * 然后按照排序规则获取数据的总数和实际数据。最后，它以数组的形式返回数据总数和数据列表。
119:      *
120:      * @param array $where 查询条件数组
121:      * @param int $page 当前页码
122:      * @param int $limit 每页数据的数量
123:      * @return array 包含数据总数和数据列表的数组
124:      */
125:     public function getList(array $where, int $page, int $limit)
126:     {
127:         // 将删除标记设置为0，确保只获取未被删除的数据
128:         $where['is_del'] = 0;
129: 
130:         // 初始化查询，应用条件、关联加载和排序规则
131:         $query = $this->dao->getSearch($where)->with(['category'])
132:             ->order('sort DESC,create_time DESC');
133: 
134:         // 计算满足条件的数据总数
135:         $count = $query->count();
136: 
137:         // 根据当前页码和每页数据数量进行分页查询，并获取数据列表
138:         $list = $query->page($page, $limit)->select();
139: 
140:         // 返回包含数据总数和数据列表的数组
141:         return compact('count','list');
142:     }
