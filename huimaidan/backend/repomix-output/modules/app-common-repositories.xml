30:     /**
31:      * 修改预约商品库存
32:      *
33:      * @param array $data
34:      * @return void
35:      */
36:     public function updateAttrReservations(array $data)
37:     {
38:         foreach ($data as $item) {
39:             $reservation = $this->dao->get($item['attr_reservation_id']);
40:             if (!$reservation) {
41:                 throw new ValidateException('预约库存信息不存在,请检查');
42:             }
43: 
44:             $reservation->update(['stock' => $item['stock']], ['attr_reservation_id' => $item['attr_reservation_id']]);
45:         }
46:     }
47: 
48:     /**
49:      *  检测预约商品某个日期的某个时间段库存是否足够
50:      * @param $product_id
51:      * @param $reservation_id
52:      * @param $date
53:      * @param $num
54:      * @return bool
55:      * @author Qinii
56:      */
57:     public function validateStock($product_id ,$reservation_id, $date, $num)
58:     {
59:         $product = app()->make(ProductReservationRepository::class)->getSearch(['product_id' =>  $product_id])->find();
60:         if (!$product) throw new ValidateException('数据不存在');
61:         $day = date('Y-m-d',time());
62:         if ($date < date('Y-m-d',time() || $product['show_reservation_days'] > ($date - $day)))
63:             throw new ValidateException('超出可预约时间');
64: 
65:         $reservation = $this->dao->get($reservation_id);
66:         if (!$reservation) throw new ValidateException('预约库存信息不存在,请检查');
67: 
68:         //如果需提前，计算时间与当前时间差
69:         if ($product['is_advance'] == ProductReservationRepository::ADVANCE_TYPE_ALLOW) {
70:             $advance_time = $product['advance_time'] * 60 * 60;
71:             $time = strtotime($date . ' ' . $reservation['start_time']);
72:             if ($time - time() < $advance_time)
73:                 throw new ValidateException('超出提前可预约时间，请刷新重试');
74:         }
75: 
76:         $orderProductRepository = app()->make(StoreOrderProductRepository::class);
77:         $_stock = (int)$orderProductRepository->getReservationSum($product_id, $date, $reservation_id);
78:         $stock = $reservation['stock'] - $_stock;
79:         return  $stock >= $num ? $stock : false;
80:     }
81: }
