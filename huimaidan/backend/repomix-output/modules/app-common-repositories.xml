432:             'offline_switch' => $config['offline_switch'] && $merchant['offline_switch'] ? 1 : 0,
433:             'now_money' => $user['now_money'] ?? 0,
434:             'pay_weixin_open' => $config['pay_weixin_open'],
435:             'alipay_open' => $config['alipay_open'],
436:             'yue_pay_status' => ($config['yue_pay_status'] && $config['balance_func_status'] && $uid) ? 1 : 0,
437:             'invalid_time' => time() + $timer * 60,
438:         ];
439:         return $data;
