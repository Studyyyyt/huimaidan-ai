226:             // 根据字段的属性设置组件的属性、验证规则和默认值
227:             if ($field['props'] ?? '') {
228:                 $props = @parse_ini_string($field['props'], false, INI_SCANNER_TYPED);
229:                 if (is_array($props)) {
230:                     $rule->props($props);
