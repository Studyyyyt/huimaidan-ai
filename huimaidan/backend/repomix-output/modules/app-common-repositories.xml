145:     /**
146:      * 根据不同的类型检查MSN的有效性。
147:      *
148:      * 该方法用于在不同的业务场景下，验证给定的MSN（可能代表商品ID、订单ID、退款单ID等）是否有效。
149:      * 通过传入的类型参数来决定检查的逻辑，如果MSN无效，则抛出ValidateException异常。
150:      *
151:      * @param string $merId 商家ID，用于限定查询的范围。
152:      * @param string $uid 用户ID，用于限定查询的范围。
153:      * @param int $type 类型标识，决定后续检查的逻辑和对应的业务实体。
154:      * @param string $msn 待检查的MSN，根据类型的不同，可能代表不同的ID。
155:      * @throws ValidateException 如果MSN无效，则抛出该异常。
156:      */
157:     public function checkMsn($merId, $uid, $type, $msn)
158:     {
159:         // 检查类型为4时，对应的商品是否存在
160:         if ($type == 4 && !app()->make(ProductRepository::class)->merExists($merId, $msn))
161:             throw new ValidateException('商品不存在');
162:         // 检查类型为5时，对应的订单是否存在
163:         else if ($type == 5 && !app()->make(StoreOrderRepository::class)->existsWhere(['uid' => $uid, 'mer_id' => $merId, 'order_id' => $msn]))
164:             throw new ValidateException('订单不存在');
165:         // 检查类型为6时，对应的退款单是否存在
166:         else if ($type == 6 && !app()->make(StoreRefundOrderRepository::class)->existsWhere(['uid' => $uid, 'mer_id' => $merId, 'refund_order_id' => $msn]))
167:             throw new ValidateException('退款单不存在');
168:         // 检查类型为7时，对应的预售商品是否存在
169:         else if ($type == 7 && !app()->make(ProductPresellRepository::class)->existsWhere(['product_presell_id' => $msn, 'mer_id' => $merId]))
170:             throw new ValidateException('商品不存在');
171:         // 检查类型为8时，对应的拼团商品是否存在
172:         else if ($type == 8 && !app()->make(ProductGroupRepository::class)->existsWhere(['product_group_id' => $msn, 'mer_id' => $merId]))
173:             throw new ValidateException('商品不存在');
174:     }
