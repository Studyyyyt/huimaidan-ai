 377:     /**
 378:      * 根据条件获取商家列表
 379:      *
 380:      * @param array $where 查询条件
 381:      * @param int $page 分页页码
 382:      * @param int $limit 每页数量
 383:      * @param array $userInfo 用户信息
 384:      * @return array 商家列表和总数
 385:      */
 386:     public function getList($where, $page, $limit, $userInfo)
 387:     {
 388:         // 定义需要查询的字段
 389:         $field = 'care_count,is_trader,type_id,mer_id,mer_banner,mini_banner,mer_name,mark,mer_avatar,product_score,service_score,postage_score,sales,status,is_best,create_time,long,lat,is_margin,care_ficti';
 390: 
 391:         // 默认查询条件：状态为正常，商家状态为开启，未删除
 392:         $where['status'] = 1;
 393:         $where['mer_state'] = 1;
 394:         $where['is_del'] = 0;
 395: 
 396:         // 处理位置查询条件
 397:         if (isset($where['location'])) {
 398:             $data = @explode(',', (string)$where['location']);
 399:             if (2 != count(array_filter($data ?: []))) {
 400:                 unset($where['location']);
 401:             } else {
 402:                 $where['location'] = [
 403:                     'lat' => (float)$data[0],
 404:                     'long' => (float)$data[1],
 405:                 ];
 406:             }
 407:         }
 408: 
 409:         // 如果有关键字，记录用户搜索行为
 410:         if ($where['keyword'] !== '') {
 411:             app()->make(UserVisitRepository::class)->searchMerchant($userInfo ? $userInfo['uid'] : 0, $where['keyword']);
 412:         }
 413: 
 414:         // 构建查询对象，并处理位置查询
 415:         $query = $this->dao->search($where)->with(['type_name']);
 416:         $count = $query->count();
 417:         $status = systemConfig('mer_location') && isset($where['location']);
 418: 
 419:         // 分页查询商家列表，并处理距离计算
 420:         $list = $query->page($page, $limit)->setOption('field', [])->field($field)->select()
 421:             ->each(function ($item) use ($status, $where) {
 422:                 if ($status && $item['lat'] && $item['long'] && isset($where['location']['lat'], $where['location']['long'])) {
 423:                     $distance = getDistance($where['location']['lat'], $where['location']['long'], $item['lat'], $item['long']);
 424:                     if ($distance < 0.9) {
 425:                         $distance = max(bcmul($distance, 1000, 0), 1).'m';
 426:                         if ($distance == '1m') {$distance = '100m以内';}
 427:                     } else {
 428:                         $distance .= 'km';
 429:                     }
 430:                     $item['distance'] = $distance;
 431:                 }
 432:                 // 根据配送方式处理推荐图片
 433:                 $item['recommend'] = isset($where['delivery_way']) ? $item['CityRecommend'] : $item['AllRecommend'];
 434:                 $item['recommend'] = getThumbWaterImage( $item['recommend'], ['image'], 'small');
 435:                 $item['care_count'] = (int)$item['care_ficti'] + $item['care_count'];
 436:                 return $item;
 437:             });
 438: 
 439:         // 返回商家总数和列表
 440:         return compact('count', 'list');
