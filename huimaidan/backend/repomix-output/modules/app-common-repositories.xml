 59:      * @param array $fieldRule 字段规则数组，用于验证数据数组中的字段值是否符合要求。
 60:      * @return mixed 返回DAO层创建方法的执行结果，通常是新创建数据的ID或其他标识符。
 61:      */
 62:     public function create(int $merId, array $data, array $fieldRule)
 63:     {
 64:         // 验证传入的数据是否符合预设的规则
 65:         $this->checkData($data['value'], $fieldRule);
 66:         // 将商家ID添加到数据数组中
 67:         $data['mer_id'] = $merId;
 68:         // 调用DAO层的创建方法，实际执行数据插入操作
