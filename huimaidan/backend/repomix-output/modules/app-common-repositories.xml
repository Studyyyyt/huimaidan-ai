4027:         $cancel_status = false;
4028:         $reservation = $order['orderProduct'][0]['cart_info']['reservation'] ?? '';
4029:         if ($order->is_cancel && $reservation && $reservation['is_cancel_reservation'] == 1) {
4030:             $star = explode('-',$order['orderProduct'][0]['reservation_time_part']);
4031:             $cancelTime = strtotime($order['orderProduct'][0]['reservation_date'] . ' ' .$star[0]);
4032:             $cancelTime = $cancelTime - time() >= $reservation['cancel_reservation_time'] * 3600;
4033:             $cancel_status = $cancelTime;
4034:         }
4035:         if (!$cancel_status) throw new ValidateException('订单无法取消，请联系客服');
4036:         $order->is_del = 0;
4037:         $order->is_cancel = 0;
4038:         if ($order->paid) {
4039:             $repository = app()->make(StoreRefundOrderRepository::class);
4040:             $refund = $repository->createRefund($order,1,'用户取消预约订单');
4041:             $repository->agree($refund[$repository->getPk()], []);
4042:         }
4043:         $order->save();
4044:     }
