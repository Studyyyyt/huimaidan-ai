 11: // +----------------------------------------------------------------------
 12: 
 13: 
 14: namespace app\validate\api;
 15: 
 16: use think\Validate;
 17: 
 18: class OrderVirtualFieldValidate extends Validate
 19: {
 20:     protected $failException = true;
 21: 
 22:     protected $rule = [];
 23: 
 24:     public function load(array $extend, array $value)
 25:     {
 26:         $extend = array_combine(array_column($extend, 'title'), $extend);
 27:         $rule = [];
 28:         foreach ($extend as $title => $val) {
 29:             $item = [];
 30:             if ($val['key'] === 'image') {
 31:                 if ($val['require']) {
 32:                     $item[] = 'isRequireImage';
 33:                 } else {
 34:                     $item[] = 'isImage';
 35:                 }
 36: 
 37:             } else {
 38:                 if ($val['require']) {
 39:                     $item[] = 'require';
 40:                 }
 41:                 $item[] = 'is' . ucfirst($val['key']);
 42:             }
 43:             $rule[$title.' '] = implode('|', $item);
 44:         }
 45:         $this->rule = $rule;
 46:         $data = [];
 47:         foreach ($value as $v) {
 48:             $data[(string)$v['title'].' '] = $v['value'] ?? '';
 49:         }
 50:         $this->check($data);
 51:         return $data;
 52:     }
 53: 
 54:     public function isMobile($val)
 55:     {
 56:         return $this->regex($val, 'mobile');
 57:     }
 58: 
 59:     public function isDate($val)
 60:     {
 61:         return $this->dateFormat($val, 'Y-m-d');
 62:     }
 63: 
 64:     public function isTime($val)
 65:     {
 66:         return $this->dateFormat($val, 'H:i');
 67:     }
 68: 
 69:     public function isRequireImage($val)
 70:     {
 71:         if (!count($val)) return false;
 72:         foreach ($val as $v) {
 73:             if (!is_string($v)) return false;
 74:         }
 75:         return true;
 76:     }
 77: 
 78:     public function isImage($val)
 79:     {
 80:         if (!count($val)) return true;
 81:         return $this->isRequireImage($val);
 82:     }
 83: 
 84:     public function isEmail($val)
 85:     {
 86:         return $this->filter($val, FILTER_VALIDATE_EMAIL);
 87:     }
 88: 
 89:     public function isNumber($val)
 90:     {
 91:         return ctype_digit((string)$val);
 92:     }
 93: 
 94:     public function isText($val)
 95:     {
 96:         return (bool)trim((string)$val);
 97:     }
 98: 
 99:     public function isIdCard($val)
100:     {
101:         return $this->regex($val, 'idCard');
102:     }
103: }
</file>

