200:         // 调用商品组仓库的更新排序方法
201:         $this->repository->updateSort($id, $this->request->merId(), ['sort' => $sort]);
202:         // 返回操作成功提示
203:         return app('json')->success('修改成功');
204:     }
205: 
206: 
207:     /**
208:      * 预览商品信息
209:      *
210:      * @param ProductRepository $repository 商品仓库对象
211:      * @return \think\response\Json 返回JSON格式的预览结果
