 53:     /**
 54:      * 创建商品组
 55:      *
 56:      * @param StoreProductGroupValidate $validate 商品组验证器
 57:      * @return \think\response\Json
 58:      */
 59:     public function create(StoreProductGroupValidate $validate)
 60:     {
 61:         // 校验参数
 62:         $data = $this->checkParams($validate);
 63:         $this->repository->create($this->request->merId(), $data);
 64:         // 返回操作成功结果
 65:         return app('json')->success('添加成功');
 66:     }
 67: 
 68: 
 69:     /**
 70:      * 获取指定ID的商品详情
 71:      *
 72:      * @param int $id 商品ID
 73:      * @return \think\response\Json
 74:      */
 75:     public function detail($id)
 76:     {
 77:         // 构建查询条件
 78:         $where = [
 79:             $this->repository->getPk() => $id,
 80:             'mer_id' => $this->request->merId()
 81:         ];
 82:         if (!$this->repository->getWhere($where))
 83:             return app('json')->fail('数据不存在');
 84:         $data = $this->repository->detail($this->request->merId(), $id);
 85:         // 返回成功响应
 86:         return app('json')->success($data);
 87:     }
 88: 
 89:     /**
 90:      * 根据ID删除商品组
 91:      *
 92:      * @param int $id 商品组ID
 93:      * @return \think\response\Json
 94:      */
 95:     public function delete($id)
 96:     {
 97:         // 构建查询条件
 98:         $where = [
 99:             $this->repository->getPk() => $id, // 主键ID
100:             'mer_id' => $this->request->merId() // 商家ID
101:         ];
102:         // 判断数据是否存在
103:         if (!$this->repository->getWhere($where))
104:             return app('json')->fail('数据不存在');
105:         // 更新商品组状态为已删除
106:         $this->repository->update($id, ['is_del' => 1]);
107:         // 触发商品组删除事件
108:         event('product.groupDelete', compact('id'));
109:         // 修改SPU状态为已删除
110:         app()->make(SpuRepository::class)->changeStatus($id, 4);
111:         // 返回删除成功信息
112:         return app('json')->success('删除成功');
113:     }
