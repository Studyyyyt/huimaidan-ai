242:      *
243:      * @param int $id 商品ID
244:      * @return \think\response\Json 返回JSON格式的操作结果
245:      */
246:     public function setLabels($id)
247:     {
248:         // 获取请求参数中的标签信息
249:         $data = $this->request->params(['mer_labels']);
250: //        if (empty($data['mer_labels'])) return app('json')->fail('标签为空');
251: 
252:         // 调用SPU仓库的设置标签方法并返回JSON格式的操作结果
253:         app()->make(SpuRepository::class)->setLabels($id, 4, $data, $this->request->merId());
254:         return app('json')->success('修改成功');
255:     }
