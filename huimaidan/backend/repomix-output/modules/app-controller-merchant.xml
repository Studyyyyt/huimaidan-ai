 69:     /**
 70:      * 更新商家信息
 71:      *
 72:      * @param MerchantUpdateValidate $validate 商家更新验证器
 73:      * @param MerchantTakeValidate $takeValidate 商家配送验证器
 74:      * @param MerchantTakeRepository $repository 商家配送仓库
 75:      * @return \think\response\Json
 76:      */
 77:     public function update(MerchantUpdateValidate $validate, MerchantTakeValidate $takeValidate, MerchantTakeRepository $repository)
 78:     {
 79:         $type = $this->request->param('type', 1);
 80:         // 获取当前登录的商家信息
 81:         $merchant = $this->request->merchant();
 82:         // 如果 type 为 2，则表示更新商家配送信息
 83:         if ($type == 2) {
 84:             // 获取请求参数中的指定字段
 85:             $data = $this->request->params([
 86:                 'mer_info',
 87:                 'mer_certificate',
 88:                 'service_phone',
 89:                 'mer_avatar',
 90:                 'mer_banner',
 91:                 'mer_state',
 92:                 'mini_banner',
 93:                 'mer_keyword',
 94:                 'mer_address',
 95:                 'long',
 96:                 'lat',
 97:                 ['delivery_way', [2]],
 98:                 ['services_type', 0],
 99:             ]);
100:             // 对获取到的数据进行验证
101:             $validate->check($data);
102:             // 判断系统配置中的 sys_bases_status 是否为 0，如果是，则将 $sys_bases_status 设为 0，否则设为 1
103:             $sys_bases_status = systemConfig('sys_bases_status') === '0' ? 0 : 1;
104:             // 如果 $sys_bases_status 为 true，并且 $data['mer_certificate'] 为空，则返回错误信息
105:             if ($sys_bases_status && empty($data['mer_certificate']))
106:                 return app('json')->fail('店铺资质不可为空');
107: 
108:             // 调用 ConfigValueRepository 类的 setFormData 方法，将 $data['mer_certificate'] 和 $data['services_type'] 存储到数据库中
109:             app()->make(ConfigValueRepository::class)->setFormData([
110:                 'mer_certificate' => $data['mer_certificate'],
111:                 'services_type' => $data['services_type']
112:             ], $this->request->merId());
113:             // 删除 $data 数组中的 mer_certificate 和 services_type 两个元素
114:             unset($data['mer_certificate'], $data['services_type']);
115:             sort($data['delivery_way']);
116:             $delivery_way = implode(',', $data['delivery_way']);
117:             if (count((array)$data['delivery_way']) == 1 && $data['delivery_way'] != $merchant->delivery_way) {
118:                 app()->make(ProductRepository::class)->getSearch([])
119:                     ->where('mer_id', $merchant->mer_id)
120:                     ->update(['delivery_way' => $delivery_way]);
121:             }
122:             $data['delivery_way'] = $delivery_way;
123:         } else {
124:             $data = $this->request->params(['mer_state']);
125: 
126:             if ($merchant->is_margin == 1 && $data['mer_state'] == 1)
127:                 return app('json')->fail('开启店铺前请先支付保证金');
128: 
129:             //if ($data['mer_state'] && !$merchant->sub_mchid && systemConfig('open_wx_combine'))
130:             //    return app('json')->fail('开启店铺前请先完成微信子商户入驻');
131:         }
132:         $merchant->save($data);
133: 
134:         // 商户编辑记录日志
135:         event('create_operate_log', [
136:             'category' => OperateLogRepository::MERCHANT_EDIT_AUDIT_STATUS,
137:             'data' => [
138:                 'merchant' => $merchant,
139:                 'admin_info' => $this->request->adminInfo(),
140:                 'update_infos' => ['status' => $data['mer_state']]
141:             ],
142:         ]);
143: 
144:         Queue::push(ChangeMerchantStatusJob::class, $this->request->merId());
145:         return app('json')->success('修改成功');
146:     }
