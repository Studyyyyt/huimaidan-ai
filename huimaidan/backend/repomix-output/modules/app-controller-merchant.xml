119:         $upload = UploadService::create(1);
120:         $ret = $upload->to('excel')->move('file');
121:         if ($ret === false) return app('json')->fail($upload->getError());
122:         $res = $upload->getUploadInfo();
123:         $path = rtrim(public_path(),'/').$res['dir'];
124:         $data = [];
125:         $spreadsheet = SpreadsheetExcelService::instance();
126:         switch ($type){
127:              case 'delivery' :
