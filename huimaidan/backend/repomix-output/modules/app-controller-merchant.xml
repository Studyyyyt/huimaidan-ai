115: 
116:     /**
117:      * 更新商品分组
118:      *
119:      * @param int $id 商品分组ID
120:      * @param StoreProductGroupValidate $validate 验证器实例
121:      * @return \think\response\Json
122:      */
123:     public function update($id, StoreProductGroupValidate $validate)
124:     {
125:         // 获取验证通过的参数
126:         $data = $this->checkParams($validate);
127:         // 构建查询条件
128:         $where = [
129:             $this->repository->getPk() => $id,
130:             'mer_id' => $this->request->merId()
131:         ];
132:         // 判断数据是否存在
133:         if (!$this->repository->getWhere($where))
134:             return app('json')->fail('数据不存在');
135: 
136:         // 更新数据
137:         $this->repository->edit($id, $data);
138:         // 返回操作结果
139:         return app('json')->success('编辑成功');
140:     }
141: 
142: 
143:     /**
144:      * 切换商品组状态
145:      *
146:      * @param int $id 商品组ID
147:      * @return \think\response\Json
148:      */
149:     public function switchStatus($id)
150:     {
151:         // 获取状态值
152:         $status = $this->request->param('status', 0) == 1 ? 1 : 0;
153:         if (!$this->repository->detail($this->request->merId(), $id))
154:             return app('json')->fail('数据不存在');
155:         // 更新商品组状态
156:         $this->repository->update($id, ['is_show' => $status]);
157:         app()->make(SpuRepository::class)->changeStatus($id, 4);
158:         return app('json')->success('修改成功');
159:     }
160: 
161: 
162:     /**
163:      * 检查参数并返回数据
164:      * @param StoreProductGroupValidate $validate 商品组验证器
165:      * @return array 返回验证后的数据
166:      * @throws ValidateException 如果开团人数小于2或活动开始时间大于结束时间或团长分佣比例不在0-100之间则抛出异常
167:      */
168:     public function checkParams(StoreProductGroupValidate $validate)
169:     {
170:         // 定义需要验证的参数
171:         $params = [
172:             "image", "slider_image", "store_name", "store_info", "product_id", "is_show", "temp_id", "once_pay_count", "guarantee_template_id",
173:             "start_time", "end_time", "buying_num", "buying_count_num", "status", "pay_count", "time", "ficti_status", "ficti_num", "attrValue",
174:             'unit_name', 'content', 'sort', 'mer_labels', 'delivery_way', 'delivery_free', ['leader_extension', 0], ['leader_rate', 0]
175:         ];
176:         // 获取请求参数
177:         $data = $this->request->params($params);
178:         // 如果开团人数小于2则抛出异常
179:         if ($data['buying_count_num'] < 2) throw new ValidateException('开团人数不得少于2人');
180:         // 如果活动开始时间大于结束时间则抛出异常
181:         if ($data['end_time'] < $data['start_time']) throw new ValidateException('活动开始时间必须大于结束时间');
182:         // 如果团长分佣比例不在0-100之间则抛出异常
183:         if ($data['leader_extension'] && ($data['leader_rate'] < 0 || $data['leader_rate'] > 100)) {
184:             throw new ValidateException('团长分佣比例需在0-100之间');
185:         }
186:         // 验证数据
187:         $validate->check($data);
188:         // 返回验证后的数据
189:         return $data;
190:     }
191: 
192:     /**
