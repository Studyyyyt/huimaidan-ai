264:             'delivery_type',
265:             'delivery_name',
266:             'remark',
267:             ['select_type', 'select'],
268:             ['where', []],
269:         ]);
270:         if (!in_array($params['select_type'], ['all', 'select'])) return app('json')->fail('选择了类型错误');
271:         if (!in_array($params['delivery_type'], [2, 3, 4])) return app('json')->fail('发货类型错误');
272:         if ($params['delivery_type'] ==2 ) {
273:             $data = $this->request->params(['delivery_type', 'delivery_name', 'delivery_id', 'remark',]);
274:             if (!$data['delivery_type'] || !$data['delivery_name'] || !$data['delivery_id'])
