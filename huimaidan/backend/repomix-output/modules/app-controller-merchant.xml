130:      * 校验参数
131:      * @return array 返回校验后的参数数组
132:      * @throws \app\common\exception\ValidateException 如果参数校验失败则抛出异常
133:      */
134:     public function checkParams()
135:     {
136:         // 定义参数数组
137:         $params = [
138:             ['title', ''],
139:             ['image', ''],
140:             ['type', 0],
141:             ['is_limit', 0],
142:             ['limit_num', 0],
143:             ['is_time', 0],
144:             ['time', []],
145:             ['sort', 0],
146:             ['free_shipping', 0],
147:             ['status', 0],
148:             ['is_show', 1],
149:             ['products', []],
150:             ['temp_id', 0],
151:         ];
152:         // 获取请求参数并校验
153:         $data = $this->request->params($params);
154:         app()->make(StoreDiscountsValidate::class)->check($data);
155: 
156:         // 如果设置了时间限制，则校验时间格式和时间范围
157:         if ($data['is_time'] && is_array($data['time'])) {
158:             if (empty($data['time'])) throw new ValidateException('开始时间必须填写');
159:             [$start, $end] = $data['time'];
160:             $start = strtotime($start);
161:             $end = strtotime($end);
162:             if ($start > $end) {
163:                 throw new ValidateException('开始时间必须小于结束时间');
164:             }
165:             if ($start < time() || $end < time()) {
166:                 throw new ValidateException('套餐时间不能小于当前时间');
167:             }
168:         }
169:         // 校验商品属性
170:         foreach ($data['products'] as $item) {
171:             if (!isset($item['items']))
172:                 throw new ValidateException('请选择' . $item['store_name'] . '的规格');
173:             foreach ($item['attr'] as $attr) {
174:                 if ($attr['active_price'] > $attr['price']) throw new ValidateException('套餐价格高于原价');
175:             }
176:         }
177:         $data['mer_id'] = $this->request->merId();
178:         return $data;
179:     }
