 61:     public function list()
 62:     {
 63:         $params = $this->request->params(['uid', 'tourist_unique_key']);
 64:         $validate = $this->getValidate();
 65:         if (!$validate->listCheck($params)) {
 66:             return app('json')->fail($validate->getError());
