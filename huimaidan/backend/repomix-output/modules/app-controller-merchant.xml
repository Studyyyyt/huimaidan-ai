220:             'is_trader' => $this->request->merchant()->is_trader,
221:             'mer_avatar' => $this->request->merchant()->mer_avatar,
222:             'product_score' => $this->request->merchant()->product_score,
223:             'service_score' => $this->request->merchant()->service_score,
224:             'postage_score' => $this->request->merchant()->postage_score,
225:             'service_phone' => $this->request->merchant()->service_phone,
226:             'care_count' => $this->request->merchant()->care_count,
227:             'type_name' => $this->request->merchant()->type_name->type_name ?? '',
228:             'care' => true,
229:             'recommend' => $this->request->merchant()->recommend,
230:         ];
231:         // 添加商家ID和状态信息到请求参数中
232:         $data['mer_id'] = $this->request->merId();
233:         $data['status'] = 1;
234:         $data['mer_status'] = 1;
235:         $data['rate'] = 3;
236:         // 调用商品仓库的预览方法并返回JSON格式的预览结果
237:         return app('json')->success($repository->preview($data));
238:     }
239: 
240:     /**
