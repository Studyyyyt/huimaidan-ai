 85:     /**
 86:      * 购物车创建
 87:      *
 88:      * @return void
 89:      */
 90:     public function create()
 91:     {
 92:         $params = $this->request->params(['uid', 'cart_num', 'product_id', 'product_attr_unique', 'tourist_unique_key']);
 93: 
 94:         $validate = $this->getValidate();
 95:         if (!$validate->createCheck($params)) {
 96:             return app('json')->fail($validate->getError());
 97:         }
 98: 
 99:         // 如果存在uid则获取用户信息。如果不存在，则不检测用户信息，视为游客
100:         $user = null;
101:         if (!empty($params['uid'])) {
102:             $user = $this->getUserRepository()->userInfo($params['uid']);
103:             if (!$user) {
104:                 return app('json')->fail('用户不存在');
105:             }
106:         }
107:         $params['is_new'] = 0;
108:         // 触发购物车添加前的事件，允许其他功能插件在此事件中进行干预
109:         event('user.cart.before', compact('user', 'params'));
110: 
111:         $repository = $this->getRepository();
112:         // 检测商品是否存在。如果购物车中已存在该商品，则更新数量；否则添加到购物车。
113:         $check = app()->make(ProductRepository::class)->merchantCartCheck($params, $user, $params['tourist_unique_key']);
114:         if ($cart = $check['cart']) {
115:             $cart_id = $cart['cart_id'];
116:             $cart_num = ['cart_num' => ($cart['cart_num'] + $params['cart_num'])];
117:             $storeCart = $repository->update($cart_id, $cart_num);
118:         } else {
119:             $params['mer_id'] = $this->request->merId();
120:             $cart = $storeCart = $repository->create($params);
121:         }
122: 
123:         // 触发购物车处理后的事件
124:         event('user.cart', compact('user', 'storeCart'));
125: 
126:         $result['cart_id'] = (int)$cart['cart_id'];
127:         return app('json')->success('添加成功', $result);
128:     }
129:     /**
130:      * 购物车修改
131:      *
132:      * @return void
133:      */
134:     public function change($id)
135:     {
136:         if (!$id) {
137:             return app('json')->fail('参数错误');
138:         }
139: 
140:         $params = $this->request->params(['uid', 'cart_num', 'product_attr_unique']);
141:         $validate = $this->getValidate();
142:         if (!$validate->changeCheck($params)) {
143:             return app('json')->fail($validate->getError());
144:         }
145: 
146:         $cart = $this->repository->getOne($id, $params['uid']);
147:         if (!$cart) {
148:             return app('json')->fail('购物车信息不存在');
149:         }
150:         $params['cart_num'] = $params['cart_num'] ?? $cart['cart_num'];
151:         $params['product_attr_unique'] = !empty($params['product_attr_unique']) ? $params['product_attr_unique'] : $cart['product_attr_unique'];
152: 
153:         // 如果商品有单次购买限制，检查此次购买数量是否超过限制
154:         if ($cart->product->once_count) {
155:             if (!app()->make(ProductRepository::class)->isOverLimit($cart, $params)) {
156:                 return app('json')->fail('单次购买限制 ' . $cart->product->once_count . ' 件');
157:             }
158:         }
159: 
160:         // 根据唯一属性ID检查SKU是否存在，如果不存在，则返回错误信息
161:         if (!$res = app()->make(ProductAttrValueRepository::class)->getOptionByUnique($params['product_attr_unique'], $cart['product_id'])) {
162:             return app('json')->fail('SKU不存在');
163:         }
164: 
165:         // 检查库存是否足够，如果不足，则返回错误信息
166:         if ($res['stock'] < $params['cart_num']) {
167:             return app('json')->fail('库存不足');
168:         }
169:         // 检测购物车是否存在和该商品相同sku的购物车记录，如果有则合并加数量，并删除多余的
170:         if(!empty($params['product_attr_unique'])){
171:             $isExist = $this->repository->getCartByProductSku($params['product_attr_unique'], $params['uid'], $cart['tourist_unique_key'], $id);
172:             if($isExist){
173:                 $params['cart_num'] = bcadd($cart['cart_num'], $isExist['cart_num']);
174:                 $this->repository->delete($isExist['cart_id']);
175:             }
176:         }
177: 
178:         $this->repository->update($id, $params);
179: 
180:         return app('json')->success('修改成功');
181:     }
