276:             $ser = app()->make(DeliveryServiceRepository::class)->get($data['delivery_name']);
277:             $data['delivery_name'] = $ser['name'];
278:         }
279:         if ($params['delivery_type'] == 4) {
280:             $data = $this->request->params([
281:                 'from_name',
282:                 'from_tel',
283:                 'from_addr',
284:                 'temp_id',
285:                 'remark',
286:                 ['is_cargo', 1],
287:             ]);
288:             $params = array_merge($params, $data);
289:             if (!systemConfig('crmeb_serve_dump') || merchantConfig($this->request->merId(), 'mer_dump_switch') == 0)
290:                 return app('json')->fail('电子面单功能未开启');
291:             if (!merchantConfig($this->request->merId(), 'mer_dump_type'))
292:                 return app('json')->fail('通用打印机不支持批量打印');
293:         }
294:         if ($params['select_type'] == 'select' && !$params['order_id']) return app('json')->fail('需要订单ID');
295:         if ($params['select_type'] == 'all' && empty($params['where'])) return app('json')->fail('需要搜索条件');
296:         //$this->repository->batchDelivery($this->request->merId(),$params);
297:         Queue::push(BatchDeliveryJob::class, [
298:             'mer_id' => $this->request->merId(),
299:             'data' => $params
300:         ]);
301:         return app('json')->success('已开始批量发货，请稍后查看');
302:     }
