135:                      $data['path'] = $path;
136:                      $data['import_id'] = $res->import_id;
137:                      $data['mer_id'] = $this->request->merId();
138:                      Queue::push(ImportSpreadsheetExcelJob::class,$data);
139:                      return app('json')->success('开始导入数据，请稍后在批量发货记录中查看！');
140:                  }
141:                 break;
142:             case 'cdkey':
143:                 $data['library_id'] = $this->request->param('library_id');
144:                 if (!$data['library_id'])  return app('json')->fail('缺少卡密库 ID');
145:                 $spreadsheet->checkImport($path,['B1' => '卡号','C1' => '卡密']);
