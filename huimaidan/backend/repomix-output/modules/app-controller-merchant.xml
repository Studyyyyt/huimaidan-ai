152:     {
153:         $params = $this->request->params(['uid']);
154:         $validate = $this->getValidate();
155:         if (!$validate->scenePayConfig($params)) {
156:             return app('json')->fail($validate->getError());
157:         }
158:         $uid = $params['uid'];
159: 
160:         $config = $this->repository->merchantPayConfig($uid, $this->request->merId());
161:         if (!$config) {
162:             return app('json')->fail('获取支付配置失败');
163:         }
164: 
165:         $config['yue_pay_status'] = $uid ? $config['yue_pay_status'] : 0;
166:         return app('json')->success($config);
167:     }
168:     /**
169:      * 订单付款操作
170:      *
171:      * @param [type] $id
172:      * @return json
173:      */
174:     public function pay($id, StoreGroupOrderRepository $groupOrderRepository)
175:     {
176:         $params = $this->request->params(['uid', 'pay_type', 'phone', 'sms_code', 'auth_code']);
177:         $params['id'] = $id;
178:         $validate = $this->getValidate();
179:         $groupOrder = $groupOrderRepository->detail($params['uid'], $id, false);
180:         if (!$validate->scenePay($params, $groupOrder)) {
181:             return app('json')->fail($validate->getError());
182:         }
183: 
184:         $repository = $this->getRepository();
185:         $payType = $params['pay_type'];
186:         if ($payType == 'balance') {
187:             $smsCode = app()->make(SmsService::class)->checkSmsCode($params['phone'], $params['sms_code'], 'balance');
188:             if (!$smsCode) {
189:                 return app('json')->fail('验证码不正确');
190:             }
191:         }
192:         $repository->changePayType($groupOrder, array_search($payType, MerchantOrderCreateRepository::PAY_TYPE));
193:         // 金额为0，直接设置为已付款
194:         if ($groupOrder['pay_price'] == 0) {
195:             $repository->paySuccess($groupOrder);
196:             return app('json')->success('支付成功', ['order_id' => $groupOrder['group_order_id']]);
197:         }
198:         // 线下支付，直接返回成功
199:         if ($payType == 'offline') {
200:             return app('json')->success('线下支付，请确认', ['order_id' => $groupOrder['group_order_id']]);
201:         }
202:         $user = $this->getUserRepository()->userInfo($params['uid']);
203:         // 支付操作
204:         try {
205:             return $repository->merchantPay($params, $user, $groupOrder);
206:         } catch (\Exception $e) {
207:             return app('json')->fail('支付失败', $e->getMessage(), ['order_id' => $groupOrder->group_order_id, 'pay_price' => $groupOrder->pay_price]);
208:         }
209:     }
210:     /**
211:      * 获取支付状态
212:      *
213:      * @param $id
214:      * @return void
215:      */
216:     public function payStatus($id)
217:     {
218:         $params = $this->request->params(['uid', 'pay_type']);
219:         $params['id'] = $id;
220: 
221:         $validate = $this->getValidate();
222:         if (!$validate->sceneStatus($params)) {
223:             return app('json')->fail($validate->getError());
224:         }
225:         $orderRepository = $this->getRepository();
226:         $status = $orderRepository->payStatus($params);
227: 
228:         return app('json')->success($status);
229:     }
230:     /**
231:      * 余额支付获取验证码
232:      *
233:      * @param UserAuthValidate $validate
234:      * @return void
235:      */
236:     public function verify(UserAuthValidate $validate)
237:     {
238:         $data = $this->request->params(['phone', ['type', 'balance']]);
239:         $validate->sceneVerify()->check($data);
240:         $smsLimitKey = 'sms_limit_' . $data['phone'];
241:         $limit = Cache::get($smsLimitKey) ?? 0;
242:         $smsLimit = systemConfig('smsLimit');
243:         if ($smsLimit && $limit > $smsLimit) {
244:             return app('json')->fail('请求太频繁请稍后再试');
245:         }
246:         try {
247:             $smsCode = str_pad(random_int(1, 9999), 4, 0, STR_PAD_LEFT);
248:             $smsTime = systemConfig('sms_time') ?? 30;
249:             SmsService::create()->send($data['phone'], 'VERIFICATION_CODE', ['code' => $smsCode, 'time' => $smsTime]);
250:         } catch (\Exception $e) {
251:             return app('json')->fail($e->getMessage());
252:         }
253: 
254:         $smsKey = app()->make(SmsService::class)->sendSmsKey($data['phone'], $data['type']);
255:         Cache::set($smsKey, $smsCode, $smsTime * 60);
256:         Cache::set($smsLimitKey, $limit + 1, 60);
257:         // 短信发送成功
258:         return app('json')->success('短信发送成功');
259:     }
260: 
261:     private function isValidIntersection(array $cartIds, int $uid, int $merId, string $touristUniqueKey)
262:     {
263:         return (count($cartIds) == count($this->getCartRepository()->validIntersection($cartIds, $uid, $merId, $touristUniqueKey)));
264:     }
265: }
