178:         $date = $this->request->param('date') ?: 'today';
179: 
180:         $res = Cache::store('file')->remember(self::class . '@userRate' . $this->merId . $date, function () use ($userRepository, $repository, $date) {
181:             $uids = $repository->orderUserGroup($date, 1, $this->merId)->toArray();
182:             $userPayCount = $userRepository->idsByPayCount(array_column($uids, 'uid'));
183:             $user = count($uids);
184:             $oldUser = 0;
185:             $totalPrice = 0;
186:             $oldTotalPrice = 0;
187:             foreach ($uids as $uid) {
188:                 $totalPrice = bcadd($uid['pay_price'], $totalPrice, 2);
189:                 if (($userPayCount[$uid['uid']] ?? 0) > $uid['total']) {
190:                     $oldUser++;
191:                     $oldTotalPrice = bcadd($uid['pay_price'], $oldTotalPrice, 2);
192:                 }
193:             }
194:             $newTotalPrice = bcsub($totalPrice, $oldTotalPrice, 2);
195:             $newUser = $user - $oldUser;
196:             return compact('newTotalPrice', 'newUser', 'oldTotalPrice', 'oldUser', 'totalPrice', 'user');
197:         }, 2000 + random_int(600, 1200));
198: 
199:         return app('json')->success($res);
