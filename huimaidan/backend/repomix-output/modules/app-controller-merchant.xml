185:     /**
186:      * 发货
187:      * @param $id
188:      * @return mixed
189:      * @author Qinii
190:      */
191:     public function delivery($id)
192:     {
193:         $type = $this->request->param('delivery_type');
194:         $split = $this->request->params(['is_split', ['split', []]]);
195:         if (!$this->repository->merDeliveryExists($id, $this->request->merId()))
196:             return app('json')->fail('订单信息或状态错误');
197: 
198:         if (!$this->repository->hasRefund($id))
199:             return app('json')->fail('该订单存在退款申请，请先处理');
200: 
201:         switch ($type) {
202:             case OrderStatus::DELIVER_TYPE_DELIVERY:
203:                 $data = $this->request->params(['delivery_type', 'delivery_name', 'delivery_id', 'remark',]);
204:                 if (!$data['delivery_type'] || !$data['delivery_name'] || !$data['delivery_id'])
205:                     return app('json')->fail('填写配送信息');
206:                 $ser = app()->make(DeliveryServiceRepository::class)->get($data['delivery_name']);
207:                 $data['delivery_name'] = $ser['name'] ?? $data['delivery_name'];
208:                 $method = 'delivery';
209:                 break;
210:             case OrderStatus::DELIVER_TYPE_VIRTUAL: //虚拟发货
211:                 $data = $this->request->params([
212:                     'delivery_type',
213:                     'remark',
214:                 ]);
215:                 $data['delivery_name'] = '';
216:                 $data['delivery_id'] = '';
217:                 $method = 'delivery';
218:                 break;
219:             case OrderStatus::DELIVER_TYPE_DUMP: //电子面单
220:                 if (!systemConfig('crmeb_serve_dump') || merchantConfig($this->request->merId(), 'mer_dump_switch') == 0)
221:                     return app('json')->fail('电子面单功能未开启');
222:                 $data = $this->request->params(['delivery_type', 'delivery_name', 'from_name', 'from_tel', 'from_addr', 'temp_id', 'remark', ['is_cargo', 1],]);
223:                 if (!$data['from_name'] || !$data['delivery_name'] || !$data['from_tel'] || !$data['from_addr'] || !$data['temp_id'])
224:                     return app('json')->fail('填写配送信息');
225:                 $method = 'dump';
226:                 break;
227:             case OrderStatus::DELIVER_TYPE_SAME_CITY: //同城配送
228:                 if (systemConfig('delivery_status') != 1)
229:                     return app('json')->fail('未开启第三方配送');
230:                 $data = $this->request->params(['delivery_type', 'station_id', 'mark', ['cargo_weight', 0], 'remark',]);
231:                 if ($data['cargo_weight'] < 0) return app('json')->fail('包裹重量能为负数');
232:                 if (!$data['station_id']) return app('json')->fail('请选择门店');
233:                 $method = 'cityDelivery';
234:                 break;
235:             case OrderStatus::DELIVER_TYPE_SHIP_MENT:
236:                 $data = $this->request->params(['delivery_type', 'delivery_name', 'from_name', 'from_tel', 'from_addr', 'temp_id', 'remark', ['is_cargo', 1],['day_type', 0],'service_type','pickup_start_time','pickup_end_time','weight']);
237:                 if(!isset($data['day_type']) || $data['day_type'] === ''){
238:                     return app('json')->fail('请选择取件日期');
239:                 }
240:                 $method = 'shoipment';
241:                 break;
242:             default: //快递
243:                 $data = $this->request->params(['delivery_type', 'delivery_name', 'delivery_id', 'remark',]);
244:                 if (!$data['delivery_type'] || !$data['delivery_name'] || !$data['delivery_id'])
245:                     return app('json')->fail('填写配送信息');
246:                 $method = 'delivery';
247:                 break;
248:         }
249:         $res = $this->repository->runDelivery($id, $this->request->merId(), $data, $split, $method);
250:         return app('json')->success($type == OrderStatus::DELIVER_TYPE_SHIP_MENT ?'商家寄件订单创建成功' : '发货成功', $res);
251:     }
