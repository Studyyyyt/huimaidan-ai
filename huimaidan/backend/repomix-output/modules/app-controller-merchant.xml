 66:     /**
 67:      * 检查订单
 68:      *
 69:      * @return void
 70:      */
 71:     public function check()
 72:     {
 73:         $params = $this->request->params(['uid', 'cart_ids', 'address_id', 'delivery_way', ['use_coupon', []], 'is_free_shipping', 'use_integral', 'tourist_unique_key']);
 74: 
 75:         $validate = $this->getValidate();
 76:         if (!$validate->sceneCheck($params)) {
 77:             return app('json')->fail($validate->getError());
 78:         }
 79:         $params['merId'] = $this->request->merId();
 80: 
 81:         if (!$this->isValidIntersection($params['cart_ids'], $params['uid'], $params['merId'], $params['tourist_unique_key'])) {
 82:             return app('json')->fail('数据无效');
 83:         }
 84: 
 85:         return app('json')->success('ok', $this->getRepository()->checkOrder($params));
 86:     }
 87:     /**
 88:      * 创建订单
 89:      *
 90:      * @return void
 91:      */
 92:     public function create()
 93:     {
 94:         $params = $this->request->params(
 95:             [
 96:                 'uid',                  // 用户ID
 97:                 'cart_ids',             // 购物车ID集合,数组类型
 98:                 'address_id',           // 地址ID
 99:                 'delivery_way',         // 配送方式
100:                 ['use_coupon', []],     // 使用的优惠券ID集合,数组类型
101:                 'is_free_shipping',     // 是否免运费
102:                 'use_integral',         // 是否使用积分
103:                 'tourist_unique_key',   // 游客唯一标识
104:                 'pay_type',             // 支付方式
105:                 'key',                  // 订单key
106:                 'mark',                 // 备注
107:                 'old_pay_price'        // 原支付价格
108:             ]
109:         );
110: 
111:         $params['merId'] = $this->request->merId();
112:         $merchant = $this->getRepository()->merchantInfo($params['merId']);
113: 
114:         // 验证参数
115:         $validate = $this->getValidate();
116:         if (!$validate->sceneCreate($params, $merchant)) {
117:             return app('json')->fail($validate->getError());
118:         }
119:         $params['pay_type'] = ($params['pay_type'] === 'pc') ? 'balance' : $params['pay_type'];
120:         if (!in_array($params['pay_type'], MerchantOrderCreateRepository::PAY_TYPE, true)) {
121:             return app('json')->fail('请选择正确的支付方式');
122:         }
123:         // 幂等验证，防止重复提交订单
124:         if (!$this->isValidIntersection($params['cart_ids'], $params['uid'], $params['merId'], $params['tourist_unique_key'])) {
125:             return app('json')->fail('已生成订单，请勿重复提交～');
126:         }
127:         // 创建订单
128:         $repository = $this->getRepository();
129:         $groupOrder = $repository->createOrder($params);
130:         if (!$groupOrder) {
131:             return app('json')->fail('创建订单失败');
132:         }
133:         $data = ['order_id' => $groupOrder->group_order_id, 'pay_type' => $params['pay_type'], 'pay_price' => $groupOrder['pay_price']];
134:         // 金额为0，直接设置为已付款,并返回支付成功信息
135:         if ($groupOrder['pay_price'] == 0) {
136:             $repository->paySuccess($groupOrder);
137:             return app('json')->success('支付成功', $data);
138:         }
139:         // 线下支付，直接返回成功
140:         if ($params['pay_type'] == 'offline') {
141:             return app('json')->success('线下支付，请确认', $data);
142:         }
143: 
144:         return app('json')->success('创建订单成功', $data);
145:     }
146:     /**
147:      * 获取支付方式列表，支付方式配置信息等
148:      *
