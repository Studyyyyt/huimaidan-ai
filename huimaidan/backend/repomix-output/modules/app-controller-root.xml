857:     public function w_getSysInfo()
858:     {
859:         $sysEnv = [];
860:         // Get content of phpinfo
861:         ob_start();
862:         phpinfo();
863:         $sysInfo = ob_get_contents();
864:         ob_end_clean();
865:         // Explode phpinfo content
866:         if ($this->env['php']['run_mode'] == 'cli') {
867:             $sysInfoList = explode('\n', $sysInfo);
868:         } else {
869:             $sysInfoList = explode('</tr>', $sysInfo);
870:         }
871:         foreach ($sysInfoList as $sysInfoItem) {
872:             if (preg_match('/thread safety/i', $sysInfoItem)) {
873:                 $sysEnv['thread_safety'] = (preg_match('/(enabled|yes)/i', $sysInfoItem) != 0);
874:             }
875:             if (preg_match('/swoole_loader support/i', $sysInfoItem)) {
876:                 $sysEnv['swoole_loader'] = (preg_match('/(enabled|yes)/i', $sysInfoItem) != 0);
877:             }
878:             if (preg_match('/swoole_loader version/i', $sysInfoItem)) {
879:                 preg_match('/\d+.\d+.\d+/s', $sysInfoItem, $match);
880:                 $sysEnv['swoole_loader_version'] = isset($match[0]) ? $match[0] : false;
881:             }
882:         }
883:         return $sysEnv;
884:     }
885: }
