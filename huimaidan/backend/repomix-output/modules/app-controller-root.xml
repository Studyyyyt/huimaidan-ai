513:         $conn = @mysqli_connect($data['dbhost'], $data['dbuser'], $data['dbpw'], NULL, $data['dbport']);
514:         if (mysqli_connect_errno($conn)) return 0;
515:         $result = mysqli_query($conn, "SELECT @@global.sql_mode");
516:         $result = $result->fetch_array();
517:         $version = mysqli_get_server_info($conn);
518:         if ($version < 5.6) return (json_encode(-4));
519: 
520:         if (strstr($result[0], 'STRICT_TRANS_TABLES') || strstr($result[0], 'STRICT_ALL_TABLES') || strstr($result[0], 'TRADITIONAL') || strstr($result[0], 'ANSI'))
521:             return ($version < 8.0) ? -1 : -2;
522: 
523:         $result = mysqli_query($conn, "select count(table_name) as c from information_schema.`TABLES` where table_schema='$dbName'");
524:         $result = $result->fetch_array();
525:         if ($result['c'] > 0) return -3;
526:         return 1;
527:     }
