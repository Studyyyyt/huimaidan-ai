385:     /**
386:      * 执行数据库文件安装
387:      * @param $sql
388:      * @param $conn
389:      * @param $dbPrefix
390:      * @return string
391:      * @author Qinii
392:      * @day 2020-07-16
393:      */
394:     public function install($sql, $conn, $dbPrefix)
395:     {
396:         // 建表
397:         if (strstr($sql, 'CREATE TABLE')) {
398:             preg_match('/CREATE TABLE `eb_([^ ]*)`/is', $sql, $matches);
399:             mysqli_query($conn, "DROP TABLE IF EXISTS `$matches[1]");
400:             $sql = str_replace('`eb_', '`' . $dbPrefix, $sql);//替换表前缀
401:             $ret = mysqli_query($conn, $sql);
402:             if ($ret) {
403:                 $message = '创建数据表[' . $dbPrefix . $matches[1] . ']完成!';
404:             } else {
405:                 $message = '创建数据表[' . $dbPrefix . $matches[1] . ']失败!失败原因：' . mysqli_error($conn);
406:             }
407: 
408:         } //插入数据
409:         else {
410:             $message = '';
411:             if (trim($sql) !== '') {
412:                 $sql = str_replace('`eb_', '`' . $dbPrefix, $sql);//替换表前缀
413:                 $ret = mysqli_query($conn, $sql);
414:                 $sql = htmlspecialchars($sql);
415:                 $msg = substr($sql, 0, 30);
416:                 if ($ret) {
417:                     $message = '执行 [' . $msg . '...]成功!' . date('Y-m-d H:i:s');
418:                 } else {
419:                     $message = '执行[' . $msg . '..]失败!' . date('Y-m-d H:i:s');
420:                 }
421:             }
422:         }
423:         return $message;
424:     }
