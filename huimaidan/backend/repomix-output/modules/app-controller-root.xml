337:     /**
338:      * 链接数据库 读取sql
339:      * @param $n
340:      * @return array
341:      * @author Qinii
342:      * @day 2020-07-16
343:      */
344:     public function perform($n)
345:     {
346:         $data = $this->request->param();
347:         $dbName = strtolower(trim($data['dbname']));
348:         $conn = @mysqli_connect($data['dbhost'], $data['dbuser'], $data['dbpw'], NULL, $data['dbport']);
349:         if (mysqli_connect_errno($conn)) {
350:             throw new ValidateException("连接数据库失败!" . mysqli_connect_error($conn));
351:         }
352:         if (!mysqli_select_db($conn, $dbName)) {
353:             //创建数据时同时设置编码
354:             if (!mysqli_query($conn, "CREATE DATABASE IF NOT EXISTS `" . $dbName . "` DEFAULT CHARACTER SET utf8;")) {
355:                 throw new ValidateException('数据库 ' . $dbName . ' 不存在，也没权限创建新的数据库！');
356:             }
357:         }
358:         mysqli_select_db($conn, $dbName);
359:         mysqli_query($conn, 'SET NAMES utf8;');
360:         //读取数据文件
361:         $sqldata = file_get_contents(__DIR__ . '/../../install/' . $this->sqlFile);
362:         $sqldata = str_replace('mer1.crmeb.net', $this->_url, $sqldata);
363:         $sqldata = str_replace('mer.crmeb.net', $this->_url, $sqldata);
364:         $sqlFormat = $this->sql_split($sqldata, $data['dbprefix']);
365:         $counts = count($sqlFormat);
366:         if ($n <= $counts && isset($sqlFormat[$n])) {
367:             $sql = trim($sqlFormat[$n]);
368:             $message = $this->install($sql, $conn, $data['dbprefix']);
369:             $n++;
370:         } else {
371:             if ($data['demo'] == '') $this->clear($conn, $data['dbprefix']);
372:             $this->setConfig($data);
373:             $message = $this->setDatabase($conn, $data);
374:             $n = 999999;
375:         }
376:         return [
377:             'n' => $n,
378:             'count' => $counts,
379:             'msg' => $message,
380:             'time' => date('Y-m-d H:i:s')
381:         ];
382:     }
