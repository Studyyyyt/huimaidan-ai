431:      * @day 2020-07-16
432:      */
433:     public function clear($conn, $dbPrefix)
434:     {
435:         $result = mysqli_query($conn, "show tables");
436:         $tables = mysqli_fetch_all($result);//参数MYSQL_ASSOC、MYSQLI_NUM、MYSQLI_BOTH规定产生数组类型
437:         $bl_table = self::DEMO_SQL_TABLE;
438:         foreach ($bl_table as $k => $v) {
439:             $bl_table[$k] = str_replace('eb_', $dbPrefix, $v);
440:         }
441: 
442:         foreach ($tables as $key => $val) {
443:             if (!in_array($val[0], $bl_table)) {
444:                 mysqli_query($conn, "truncate table " . $val[0]);
445:             }
446:         }
447:     }
