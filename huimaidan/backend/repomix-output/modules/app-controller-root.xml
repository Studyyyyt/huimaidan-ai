592:     /**
593:      * 格式化mysql文件
594:      * @param $sql
595:      * @param $tablepre
596:      * @return array
597:      * @author Qinii
598:      * @day 2020-07-16
599:      */
600:     public function sql_split($sql, $tablepre)
601:     {
602: 
603:         if ($tablepre != "tp_")
604:             $sql = str_replace("tp_", $tablepre, $sql);
605: 
606:         $sql = preg_replace("/TYPE=(InnoDB|MyISAM|MEMORY)( DEFAULT CHARSET=[^; ]+)?/", "ENGINE=\\1 DEFAULT CHARSET=utf8", $sql);
607: 
608:         $sql = str_replace("\r", "\n", $sql);
609:         $ret = array();
610:         $num = 0;
611:         $queriesarray = explode(";\n", trim($sql, "\xEF\xBB\xBF"));
612:         unset($sql);
613:         foreach ($queriesarray as $query) {
614:             $ret[$num] = '';
615:             $queries = explode("\n", trim($query));
616:             $queries = array_filter($queries);
617:             foreach ($queries as $query) {
618:                 $str1 = substr($query, 0, 1);
619:                 if ($str1 != '#' && $str1 != '-')
620:                     $ret[$num] .= $query;
621:             }
622:             $num++;
623:         }
624:         return $ret;
625:     }
