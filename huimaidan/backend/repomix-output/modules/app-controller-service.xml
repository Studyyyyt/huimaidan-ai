  1: <?php
  2: 
  3: namespace app\controller\service;
  4: 
  5: use app\common\repositories\store\service\StoreServiceRepository;
  6: use crmeb\basic\BaseController;
  7: use Gregwar\Captcha\CaptchaBuilder;
  8: use Gregwar\Captcha\PhraseBuilder;
  9: use think\facade\Cache;
 10: 
 11: class Login extends BaseController
 12: {
 13:     /**
 14:      * 扫码登录
 15:      * @return \think\response\Json
 16:      * @throws \Exception
 17:      * @author wuhaotian
 18:      * @email 442384644@qq.com
 19:      * @date 2024/7/8
 20:      */
 21:     public function scanLogin()
 22:     {
 23:         $uni = uniqid(true, false) . random_int(1, 100000000);
 24:         $key = 'S' . md5(time() . $uni);
 25:         $siteUrl = rtrim(systemConfig('site_url'), '/');
 26:         $timeout = 600;
 27:         Cache::set('_scan_ser_login' . $key, 0, $timeout);
 28:         return app('json')->success(['timeout' => $timeout, 'key' => $key, 'qrcode' => $siteUrl . '/pages/chat/customer_login/index?key=' . $key]);
 29:     }
 30: 
 31:     /**
 32:      * 验证扫码
 33:      * @return \think\response\Json
 34:      * @author wuhaotian
 35:      * @email 442384644@qq.com
 36:      * @date 2024/7/8
 37:      */
 38:     public function checkScanLogin()
 39:     {
 40:         $key = (string)$this->request->param('key');
 41:         if ($key) {
 42:             $uid = Cache::get('_scan_ser_login' . $key);
 43:             if ($uid) {
 44:                 Cache::delete('_scan_ser_login' . $key);
 45:                 $repository = app()->make(StoreServiceRepository::class);
 46:                 $user = $repository->get($uid);
 47:                 if (!$user) {
 48:                     return app('json')->status(400, '登录失败');
 49:                 }
 50:                 if (!$user['is_open'])
 51:                     return app('json')->status(400, '登录失败');
 52:                 if (!$user['status'])
 53:                     return app('json')->status(400, '登录失败');
 54: 
 55:                 $tokenInfo = $repository->createToken($user);
 56:                 $user = $user->toArray();
 57:                 unset($user['pwd']);
 58:                 $data = [
 59:                     'token' => $tokenInfo['token'],
 60:                     'exp' => $tokenInfo['out'],
 61:                     'admin' => $user
 62:                 ];
 63:                 return app('json')->status(200, $data);
 64:             }
 65:         }
 66:         return app('json')->status(201, '未登录');
 67:     }
 68: 
 69:     /**
 70:      * 登录
 71:      * @param StoreServiceRepository $repository
 72:      * @return \think\response\Json
 73:      * @author wuhaotian
 74:      * @email 442384644@qq.com
 75:      * @date 2024/7/8
 76:      */
 77:     public function login(StoreServiceRepository $repository)
 78:     {
 79:         $data = $this->request->params(['account', 'password', 'key', 'code']);
 80:         if (Cache::get('ser_login_freeze_' . $data['account']))
 81:             return app('json')->fail('账号或密码错误次数太多，请稍后在尝试');
 82:         $repository->checkCode($data['key'], $data['code']);
 83: 
 84:         $service = $repository->getWhere(['account' => $data['account'], 'is_del' => 0]);
 85: 
 86:         if (!$service) {
 87:             return app('json')->fail('账号不存在');
 88:         }
 89:         if (!$service['is_open'])
 90:             return app('json')->fail('账号未开启');
 91:         if (!$service['status'])
 92:             return app('json')->fail('账号已被禁用');
 93: 
 94:         if (!password_verify($data['password'], $service['pwd'])) {
 95:             return $this->loginFailure($data['account']);
 96:         }
 97:         $tokenInfo = $repository->createToken($service);
 98:         $admin = $service->toArray();
 99:         unset($admin['pwd']);
100:         $data = [
101:             'token' => $tokenInfo['token'],
102:             'exp' => $tokenInfo['out'],
103:             'admin' => $admin
104:         ];
105: 
106:         return app('json')->success($data);
107:     }
108: 
109:     /**
110:      * 退出登录
111:      * @param StoreServiceRepository $repository
112:      * @return \think\response\Json
113:      * @author wuhaotian
114:      * @email 442384644@qq.com
115:      * @date 2024/7/8
116:      */
117:     public function logout(StoreServiceRepository $repository)
118:     {
119:         if ($this->request->isLogin())
120:             $repository->clearToken($this->request->token());
121:         return app('json')->success('退出登录');
122:     }
123: 
124:     /**
125:      * 获取验证码
126:      * @return mixed
127:      * @author xaboy
128:      * @day 2020-04-09
129:      */
130:     public function getCaptcha(StoreServiceRepository $repository)
131:     {
132:         $codeBuilder = new CaptchaBuilder(null, new PhraseBuilder(4));
133:         $key = $repository->createLoginKey($codeBuilder->getPhrase());
134:         $captcha = $codeBuilder->build()->inline();
135:         return app('json')->success(compact('key', 'captcha'));
136:     }
137: 
138:     /**
139:      * 登录尝试次数限制
140:      * @param $account
141:      * @param int $number
142:      * @param int $n
143:      * @author Qinii
144:      * @day 7/6/21
145:      */
146:     public function loginFailure($account, $number = 5, $n = 3)
147:     {
148:         $key = 'ser_login_failuree_' . $account;
149:         $numb = Cache::get($key) ?? 0;
150:         $numb++;
151:         if ($numb >= $number) {
152:             $fail_key = 'ser_login_freeze_' . $account;
153:             Cache::set($fail_key, 1, 15 * 60);
154:             return app('json')->fail('账号或密码错误次数太多，请稍后在尝试');
155:         }
156:         Cache::set($key, $numb, 5 * 60);
157:         $msg = '账号或密码错误';
158:         $_n = $number - $numb;
159:         if ($_n <= $n) {
160:             $msg .= ',还可尝试' . $_n . '次';
161:         }
162:         return app('json')->fail($msg);
163:     }
164: }
