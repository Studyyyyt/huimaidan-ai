195:     /**
196:      * 商户给用户发
197:      * @param array $result
198:      * @return \think\response\Json
199:      */
200:     public function service_chat(array $result)
201:     {
202:         $data = $result['data'];
203:         $frame = $result['frame'];
204:         if (!isset($data['msn_type']) || !isset($data['msn']) || !isset($data['uid']) || !isset($data['mer_id']))
205:             return app('json')->message('err_tip', '数据格式错误');
206:         if (!$data['msn']) return app('json')->message('err_tip', '请输入发送内容');
207:         if (!in_array($data['msn_type'], [1, 2, 3, 4, 5, 6, 7, 8, 100]))
208:             return app('json')->message('err_tip', '消息类型有误');
209:         $service = app()->make(StoreServiceRepository::class)->getService($frame->uid, (int)$data['mer_id']);
210:         if (!$service || !$service['status'])
211:             return app('json')->message('err_tip', '没有权限');
212:         $storeServiceLogRepository = app()->make(StoreServiceLogRepository::class);
213:         if ($service->mer_id && !$storeServiceLogRepository->issetLog($data['uid'], $service->mer_id))
214:             return app('json')->message('err_tip', '不能主动发送给用户');
215: 
216:         $this->switchServiceChat($frame->uid, $frame->fd, $service->mer_id, $data['uid']);
217: 
218:         $data['msn'] = trim(strip_tags(htmlspecialchars_decode($data['msn'])));
219:         $data['mer_id'] = $service->mer_id;
220:         $data['service_id'] = $service->service_id;
221:         $data['send_type'] = 1;
222:         try {
223:             $storeServiceLogRepository->checkMsn($service->mer_id, $data['uid'], $data['msn_type'], $data['msn']);
224:         } catch (ValidateException $e) {
225:             return app('json')->message('err_tip', $e->getMessage());
226:         }
227:         if ($data['msn_type'] == 100) {
228:             if (!$storeServiceLogRepository->query(['service_log_id' => $data['msn']])
229:                 ->where('create_time', '>', date('Y-m-d H:i:s', strtotime('- 120 seconds')))->where('mer_id', $data['mer_id'])->where('send_type', 1)->count()) {
230:                 return app('json')->message('err_tip', '消息不能撤回');
231:             }
232:         }
233:         $log = $storeServiceLogRepository->create($data);
234:         if ($data['msn_type'] == 100) {
235:             $storeServiceLogRepository->query(['service_log_id' => $data['msn']])->delete();
236:         }
237:         app()->make(StoreServiceUserRepository::class)->updateInfo($log, false);
238:         $storeServiceLogRepository->getSendData($log);
239:         $log->set('service', $service->visible(['service_id', 'avatar', 'nickname'])->toArray());
240:         $log = $log->toArray();
241:         $log['send_time'] = strtotime($log['create_time']);
242:         $log['send_date'] = date('H:i', strtotime($log['create_time']));
243:         SwooleTaskService::chatToUser([
244:             'uid' => $data['uid'],
245:             'data' => $log,
246:             'except' => [$frame->fd]
247:         ]);
248: 
249:         return app('json')->message('chat', $log);
250:     }
251: 
252:     /**
253:      * 用户给商户发
254:      * @param array $result
255:      * @return \think\response\Json
256:      * @throws DataNotFoundException
257:      * @throws DbException
258:      * @throws ModelNotFoundException
259:      */
260:     public function send_chat(array $result)
261:     {
262:         $data = $result['data'];
263:         $frame = $result['frame'];
264:         if (!isset($data['msn_type']) || !isset($data['msn']) || !isset($data['mer_id']))
265:             return app('json')->message('err_tip', '数据格式错误');
266:         if (!$data['msn']) return app('json')->message('err_tip', '请输入发送内容');
267:         if (!in_array($data['msn_type'], [1, 2, 3, 4, 5, 6, 7, 8, 100]))
268:             return app('json')->message('err_tip', '消息类型有误');
269:         if ($data['mer_id'] && !app()->make(MerchantRepository::class)->exists(intval($data['mer_id'])))
270:             return app('json')->message('err_tip', '商户不存在');
271:         if (!$data['mer_id'] && systemConfig('is_open_service') != 1)
272:             return app('json')->message('err_tip', '功能未开启');
273:         $service = app()->make(StoreServiceRepository::class)->getChatService($data['mer_id'], $frame->uid);
274:         if (!$service)
275:             return app('json')->message('err_tip', '该商户暂无有效客服');
276:         $data['msn'] = trim(strip_tags(htmlspecialchars_decode($data['msn'])));
277:         if (!$data['msn'])
278:             return app('json')->message('err_tip', '内容字符无效');
279:         $this->switchChat($frame->uid, $frame->fd, $data['mer_id']);
280:         $data['uid'] = $frame->uid;
281:         $data['service_id'] = $service->service_id;
282:         $data['send_type'] = 0;
283:         $storeServiceLogRepository = app()->make(StoreServiceLogRepository::class);
284:         try {
285:             $storeServiceLogRepository->checkMsn($data['mer_id'], $frame->uid, $data['msn_type'], $data['msn']);
286:         } catch (ValidateException $e) {
287:             return app('json')->message('err_tip', $e->getMessage());
288:         }
289:         if ($data['msn_type'] == 100) {
290:             if (!$storeServiceLogRepository->query(['service_log_id' => $data['msn']])
291:                 ->where('create_time', '>', date('Y-m-d H:i:s', strtotime('- 120 seconds')))->where('uid', $data['uid'])->where('send_type', 0)->count()) {
292:                 return app('json')->message('err_tip', '消息不能撤回');
293:             }
294:         }
295:         $log = $storeServiceLogRepository->create($data);
296:         if ($data['msn_type'] == 100) {
297:             $storeServiceLogRepository->query(['service_log_id' => $data['msn']])->delete();
298:         }
299:         app()->make(StoreServiceUserRepository::class)->updateInfo($log, true);
300:         $storeServiceLogRepository->getSendData($log);
301:         $log->user;
302:         $log = $log->toArray();
303:         $log['send_time'] = strtotime($log['create_time']);
304:         $log['send_date'] = date('H:i',strtotime($log['create_time']));
