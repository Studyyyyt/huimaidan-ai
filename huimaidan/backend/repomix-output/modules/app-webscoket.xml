 30: 
 31: /**
 32:  * Class Manager
 33:  * @package app\webscoket
 34:  * @author xaboy
 35:  * @day 2020-04-29
 36:  */
 37: class Manager extends Websocket
 38: {
 39: 
 40:     /**
 41:      * @var \Swoole\WebSocket\Server
 42:      */
 43:     protected $server;
 44: 
 45:     /**
 46:      * @var Ping
 47:      */
 48:     protected $pingService;
 49: 
 50:     /**
 51:      * @var int
 52:      */
 53:     protected $cache_timeout;
 54: 
 55:     const USER_TYPE = ['admin', 'user', 'mer', 'ser'];
 56: 
 57:     /**
 58:      * Manager constructor.
 59:      * @param Server $server
 60:      * @param Room $room
 61:      * @param Event $event
 62:      * @param Ping $ping
 63:      * @param Config $config
 64:      */
 65:     public function __construct(Server $server, Room $room, Event $event, Ping $ping, Config $config)
 66:     {
 67:         parent::__construct($server, $room, $event);
 68:         $this->pingService = $ping;
 69:         $this->cache_timeout = (int)($config->get('swoole.websocket.ping_timeout', 60000) / 1000) + 2;
 70:         app()->bind('websocket_handler_admin', AdminHandler::class);
 71:         app()->bind('websocket_handler_user', UserHandler::class);
 72:         app()->bind('websocket_handler_mer', MerchantHandler::class);
 73:         app()->bind('websocket_handler_ser', ServiceHandler::class);
 74:     }
 75: 
 76:     /**
 77:      * @param int $fd
 78:      * @param Request $request
 79:      * @return mixed
 80:      * @author xaboy
 81:      * @day 2020-05-06
 82:      */
 83:     public function onOpen($fd, Request $request)
 84:     {
 85:         $type = $request->get('type');
 86:         $token = $request->get('token');
 87:         if (!$token || !in_array($type, self::USER_TYPE)) {
 88:             return $this->server->close($fd);
 89:         }
 90:         try {
 91:             $data = $this->exec($type, 'login', compact('fd', 'request', 'token'))->getData();
 92:         } catch (\Exception $e) {
 93:             return $this->server->close($fd);
 94:         }
 95:         if (!isset($data['status']) || $data['status'] != 200 || !($data['data']['uid'] ?? null)) {
 96:             return $this->server->close($fd);
 97:         }
 98:         $type = array_search($type, self::USER_TYPE);
 99:         $this->login($type, $fd, $data['data']);
100:         $this->pingService->createPing($fd, time(), $this->cache_timeout);
101:         return $this->send($fd, app('json')->message('ping', ['now' => time()]));
102:     }
103: 
104:     public function login($type, $fd, $data)
105:     {
106:         $key = '_ws_' . $type;
107:         Cache::set('_ws_f_' . $fd, [
108:             'type' => $type,
109:             'uid' => $data['uid'],
110:             'fd' => $fd,
111:             'payload' => $data['payload'] ?? null,
112:             'mer_id' => $data['mer_id'] ?? null
113:         ], 3600);
114: 
115:         if (isset($data['mer_id'])) {
116:             $groupKey = $key . '_group' . $data['mer_id'];
117:             Cache::sadd($groupKey, $fd);
118:             Cache::expire($groupKey, 3600);
119:         } else {
120:             Cache::sadd($key, $fd);
121:         }
122:         $this->refresh($type, $fd, $data['uid']);
123:     }
124: 
125:     public function refresh($type, $fd, $uid)
126:     {
127:         $key = '_ws_' . $type;
128:         Cache::expire($key, 3600);
129:         Cache::expire($key . $uid, 3600);
130:         Cache::expire('_ws_f_' . $fd, 3600);
131:     }
132: 
133:     public function logout($type, $fd)
134:     {
135:         $data = Cache::get('_ws_f_' . $fd);
136:         $key = '_ws_' . $type;
137:         Cache::srem($key, $fd);
138:         if ($data) {
139:             Cache::delete('_ws_f_' . $fd);
140:             Cache::srem($key . $data['uid'], $fd);
141:             if (($data['mer_id'] ?? null) !== null) {
142:                 $groupKey = $key . '_group' . $data['mer_id'];
143:                 Cache::srem($groupKey, $fd);
144:             }
145:         }
146:     }
147: 
148:     public static function merFd($merId)
149:     {
150:         return Cache::smembers('_ws_2_group' . $merId) ?: [];
151:     }
152: 
153:     public static function userFd($type, $uid = '')
154:     {
155:         $key = '_ws_' . $type . $uid;
156:         return Cache::smembers($key) ?: [];
157:     }
158: 
159:     /**
160:      * @param $type
161:      * @param $method
162:      * @param $result
163:      * @return null|Json
164:      * @author xaboy
165:      * @day 2020-05-06
166:      */
167:     protected function exec($type, $method, $result)
168:     {
169:         $handler = app()->make('websocket_handler_' . $type);
170:         if (!method_exists($handler, $method)) return null;
171:         /** @var Json $response */
172:         return $handler->{$method}($result);
173:     }
174: 
175:     /**
176:      * @param Frame $frame
177:      * @return bool
178:      * @author xaboy
179:      * @day 2020-04-29
180:      */
181:     public function onMessage(Frame $frame)
182:     {
183:         $info = Cache::get('_ws_f_' . $frame->fd);
184:         $result = json_decode($frame->data, true) ?: [];
185:         if (!isset($result['type']) || !$result['type']) return true;
186:         if (!$info) return true;
187:         $this->refresh($info['type'], $frame->fd, $info['uid']);
188:         if (($info['mer_id'] ?? null) !== null) {
189:             $groupKey = '_ws_' . $info['type'] . '_group' . $info['mer_id'];
190:             Cache::expire($groupKey, 3600);
191:         }
192:         if ($result['type'] == 'ping') {
193:             return $this->send($frame->fd, app('json')->message('ping', ['now' => time() ]));
194:         }
195:         if ($result['type'] == 'data_status') {
196:             $k = env('APP_KEY','merchant').'_data_status';
197:             Cache::set($k, time(),60);
198:             $data = app()->make(DataScreenRepository::class)->data_screen();
199:             return $this->send($frame->fd,  app('json')->message('data_screen', $data));
200:         }
201:         $data = $result['data'] ?? [];
202:         $frame->uid = $info['uid'];
203:         $frame->payload = $info['payload'];
204:         /** @var Json $response */
205:         $response = $this->exec(self::USER_TYPE[$info['type']], $result['type'], compact('data', 'frame', 'info'));
206:         if ($response) return $this->send($frame->fd, $response);
207:         return true;
208:     }
209: 
210:     protected function send($fd, Json $json)
211:     {
212:         $this->pingService->createPing($fd, time(), $this->cache_timeout);
213:         if ($this->server->isEstablished($fd) && $this->server->exist($fd)) {
214:             $this->server->push($fd, json_encode($json->getData()));
215:         }
216:         return true;
217:     }
218: 
219:     /**
220:      * @param int $fd
221:      * @param int $reactorId
222:      * @author xaboy
223:      * @day 2020-04-29
224:      */
225:     public function onClose($fd, $reactorId)
226:     {
227:         $data = Cache::get('_ws_f_' . $fd);
228:         if ($data) {
229:             $this->logout($data['type'], $fd);
230:             $this->exec(self::USER_TYPE[$data['type']], 'close', $data);
231:         }
232:         $this->pingService->removePing($fd);
233:     }
234: }
