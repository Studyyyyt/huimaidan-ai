 19: /**
 20:  * Class Ping
 21:  * @package app\webscoket
 22:  * @author xaboy
 23:  * @day 2020-04-29
 24:  */
 25: class Ping
 26: {
 27:     /**
 28:      * @var \Redis
 29:      */
 30:     protected $redis;
 31: 
 32: 
 33:     const CACHE_PINK_KEY = 'ws.p.';
 34: 
 35: 
 36:     const CACHE_SET_KEY = 'ws.s';
 37: 
 38: 
 39:     /**
 40:      * Ping constructor.
 41:      */
 42:     public function __construct()
 43:     {
 44:         $this->redis = Cache::store('redis')->handler();
 45:         $this->destroy();
 46:     }
 47: 
 48:     /**
 49:      * @param $id
 50:      * @param $time
 51:      * @param int $timeout
 52:      * @author xaboy
 53:      * @day 2020-04-29
 54:      */
 55:     public function createPing($id, $time, $timeout = 0)
 56:     {
 57:         $this->updateTime($id, $time, $timeout);
 58:         $this->redis->sAdd(self::CACHE_SET_KEY, $id);
 59:     }
 60: 
 61:     /**
 62:      * @param $id
 63:      * @param $time
 64:      * @param int $timeout
 65:      * @author xaboy
 66:      * @day 2020-04-29
 67:      */
 68:     public function updateTime($id, $time, $timeout = 0)
 69:     {
 70:         $this->redis->set(self::CACHE_PINK_KEY . $id, $time, $timeout);
 71:     }
 72: 
 73:     /**
 74:      * @param $id
 75:      * @author xaboy
 76:      * @day 2020-05-06
 77:      */
 78:     public function removePing($id)
 79:     {
 80:         $this->redis->del(self::CACHE_PINK_KEY . $id);
 81:         $this->redis->del(self::CACHE_SET_KEY, $id);
 82:     }
 83: 
 84:     /**
 85:      * @param $id
 86:      * @return bool|string
 87:      * @author xaboy
 88:      * @day 2020-04-29
 89:      */
 90:     public function getLastTime($id)
 91:     {
 92:         return $this->redis->get(self::CACHE_PINK_KEY . $id);
 93:     }
 94: 
 95:     /**
 96:      * @author xaboy
 97:      * @day 2020-04-29
 98:      */
 99:     public function destroy()
100:     {
101:         $members = $this->redis->sMembers(self::CACHE_SET_KEY) ?: [];
102:         foreach ($members as $k => $member) {
103:             $members[$k] = self::CACHE_PINK_KEY . $member;
104:         }
105:         if (count($members))
106:             $this->redis->del(self::CACHE_SET_KEY, ...$members);
107:     }
108: }
