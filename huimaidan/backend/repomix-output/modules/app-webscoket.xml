 95:             return app('json')->message('err_tip', '账号已被禁用');
 96:         $this->switchServiceChat($service->uid, $data['fd'], 0, 0);
 97:         return app('json')->success(['uid' => $service->uid, 'payload' => [$service->service_id], 'data' => $service->toArray()]);
