139:     /**
140:      * 商户给用户发
141:      * @param array $result
142:      * @return \think\response\Json
143:      */
144:     public function service_chat(array $result)
145:     {
146:         $data = $result['data'];
147:         $frame = $result['frame'];
148:         if (!isset($data['msn_type']) || !isset($data['msn']) || !isset($data['uid']) || !isset($data['mer_id']))
149:             return app('json')->message('err_tip', '数据格式错误');
150:         if (!$data['msn']) return app('json')->message('err_tip', '请输入发送内容');
151:         if (!in_array($data['msn_type'], [1, 2, 3, 4, 5, 6, 7, 8, 100]))
152:             return app('json')->message('err_tip', '消息类型有误');
153:         $service = app()->make(StoreServiceRepository::class)->get($frame->payload[0]);
154:         if (!$service || !$service['status'] || !$service['is_open'])
155:             return app('json')->message('err_tip', '没有权限');
156:         $storeServiceLogRepository = app()->make(StoreServiceLogRepository::class);
157:         if ($service->mer_id && !$storeServiceLogRepository->issetLog($data['uid'], $service->mer_id))
158:             return app('json')->message('err_tip', '不能主动发送给用户');
159: 
160:         $this->switchServiceChat($frame->uid, $frame->fd, $service->mer_id, $data['uid']);
161: 
162:         $data['msn'] = trim(strip_tags(htmlspecialchars_decode($data['msn'])));
163:         $data['mer_id'] = $service->mer_id;
164:         $data['service_id'] = $service->service_id;
165:         $data['send_type'] = 1;
166:         try {
167:             $storeServiceLogRepository->checkMsn($service->mer_id, $data['uid'], $data['msn_type'], $data['msn']);
168:         } catch (ValidateException $e) {
169:             return app('json')->message('err_tip', $e->getMessage());
170:         }
171:         if ($data['msn_type'] == 100) {
172:             if (!$storeServiceLogRepository->query(['service_log_id' => $data['msn']])
173:                 ->where('create_time', '>', date('Y-m-d H:i:s', strtotime('- 120 seconds')))->where('mer_id', $data['mer_id'])->where('send_type', 1)->count()) {
174:                 return app('json')->message('err_tip', '消息不能撤回');
175:             }
176:         }
177:         $log = $storeServiceLogRepository->create($data);
178:         if ($data['msn_type'] == 100) {
179:             $storeServiceLogRepository->query(['service_log_id' => $data['msn']])->delete();
180:         }
181:         app()->make(StoreServiceUserRepository::class)->updateInfo($log, false);
182:         $storeServiceLogRepository->getSendData($log);
183:         $log->set('service', $service->visible(['service_id', 'avatar', 'nickname'])->toArray());
184:         $log = $log->toArray();
185:         $log['send_time'] = strtotime($log['create_time']);
186:         $log['send_date'] = date('H:i',strtotime($log['create_time']));
187:         SwooleTaskService::chatToUser([
188:             'uid' => $data['uid'],
189:             'data' => $log,
190:             'except' => [$frame->fd]
191:         ]);
192: 
193:         return app('json')->message('chat', $log);
194:     }
195: 
196:     public function close($result)
197:     {
198:         $this->closeServiceChat($result['uid'], $result['fd']);
199:     }
