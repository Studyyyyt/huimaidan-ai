24: /**
25:  * Class SwooleWorkerStart
26:  * @package app\webscoket
27:  * @author xaboy
28:  * @day 2020-04-29
29:  */
30: class SwooleWorkerStart implements ListenerInterface
31: {
32: 
33:     /**
34:      * @var \Swoole\WebSocket\Server
35:      */
36:     protected $server;
37: 
38:     /**
39:      * @var Config
40:      */
41:     protected $config;
42: 
43:     /**
44:      * SwooleWorkerStart constructor.
45:      * @param Server $server
46:      * @param Config $config
47:      */
48:     public function __construct(Server $server, Config $config)
49:     {
50:         $this->server = $server;
51:         $this->config = $config;
52:     }
53: 
54:     /**
55:      * @param $event
56:      * @author xaboy
57:      * @day 2020-04-29
58:      */
59:     public function handle($event): void
60:     {
61:         if (!env('INSTALLED', false)) return;
62:         if ($this->server->worker_id == ($this->config->get('swoole.server.options.worker_num')) && $this->config->get('swoole.websocket.enable', false)) {
63:             $keys = array_merge(Cache::keys('m_chat*') ?: [], Cache::keys('u_chat*') ?: []);
64:             if (count($keys)) {
65:                 Cache::del(...$keys);
66:             }
67:             $this->ping();
68:             app()->make(StoreServiceUserRepository::class)->onlineDown();
69:         }
70:     }
71: 
72:     /**
73:      * @author xaboy
74:      * @day 2020-05-06
75:      */
76:     protected function ping()
77:     {
78:         /**
79:          * @var $pingService Ping
80:          */
81:         $pingService = app()->make(Ping::class);
82:         $server = $this->server;
83:         $timeout = (int)($this->config->get('swoole.websocket.ping_timeout', 60000) / 1000);
84:         Timer::tick(1500, function (int $timer_id) use (&$server, &$pingService, $timeout) {
85:             $nowTime = time();
86:             foreach ($server->connections as $fd) {
87:                 if ($server->isEstablished($fd) && $server->exist($fd)) {
88:                     $last = $pingService->getLastTime($fd);
89:                     if ($last && ($nowTime - $last) > $timeout) {
90:                         $server->close($fd);
91:                     }
92:                 }
93:             }
94:         });
95:     }
96: }
