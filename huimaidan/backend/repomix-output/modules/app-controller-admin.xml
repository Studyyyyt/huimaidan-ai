129:      * @author xaboy
130:      * @day 2020-05-06
131:      */
132:     public function update($id, MerchantValidate $validate, MerchantCategoryRepository $merchantCategoryRepository)
133:     {
134:         $data = $this->checkParam($validate, true);
135:         if (!$merchant = $this->repository->get($id))
136:             return app('json')->fail('数据不存在');
137:         if ($this->repository->fieldExists('mer_name', $data['mer_name'], $id))
138:             return app('json')->fail('商户名已存在');
139:         if ($data['mer_phone'] && isPhone($data['mer_phone']))
140:             return app('json')->fail('请输入正确的手机号');
141:         if (!$data['category_id'] || !$merchantCategoryRepository->exists($data['category_id']))
142:             return app('json')->fail('商户分类不存在');
143: 
144:         unset($data['mer_account'], $data['mer_password']);
145:         $margin = $this->repository->checkMargin($id, $data['type_id']);
146:         $data['margin'] = $margin['margin'];
147:         $data['is_margin'] = $margin['is_margin'];
148:         $data['ot_margin'] = $margin['ot_margin'];
149: 
150:         // 商户编辑记录日志
151:         event('create_operate_log', [
152:             'category' => OperateLogRepository::PLATFORM_EDIT_MERCHANT,
153:             'data' => [
154:                 'merchant' => $merchant,
155:                 'admin_info' => $this->request->adminInfo(),
156:                 'update_infos' => $data
157:             ],
158:         ]);
159: 
160:         Db::transaction(function () use ($id, $data) {
161:             // 处理关联店铺分组
162:             $relevanceRepository = app()->make(RelevanceRepository::class);
163:             $storeGroupIds = $data['store_group_ids'] ?? [];
164:             unset($data['store_group_ids']);
165:             if ($storeGroupIds) {
166:                 $relevance = [];
167:                 // 先删除旧的关联关系
168:                 $relevanceRepository->batchDeleteByRightId($id, RelevanceRepository::STORE_GROUP);
169:                 foreach ($storeGroupIds as $storeGroupId) {
170:                     // 新增新的关联关系
171:                     $relevance[] = [
172:                         'left_id' => $storeGroupId,
173:                         'right_id' => $id,
174:                         'type' => RelevanceRepository::STORE_GROUP,
175:                     ];
176:                 }
177:                 // 批量新增关联关系
178:                 $relevanceRepository->insertAll($relevance);
179:             }
180: 
181:             $this->repository->update($id, $data);
182:         });
183: 
184:         try{
185:             if (isset($data['applyment_id']) && $data['applyment_id']) {
186:                 (new Pay('partner'))->receiversAdd($data['applyment_id']);
187:             }
188:         } catch (\Exception $e) {
189: 
190:         }
191:         return app('json')->success('编辑成功');
192:     }
