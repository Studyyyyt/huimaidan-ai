 13: namespace app\controller\admin\system\safety;
 14: 
 15: use crmeb\exceptions\UploadFailException;
 16: use crmeb\services\MysqlBackupService;
 17: use think\App;
 18: use crmeb\basic\BaseController;
 19: use think\facade\Db;
 20: use think\facade\Env;
 21: 
 22: /**
 23:  * 数据库备份
 24:  */
 25: class Database extends BaseController
 26: {
 27: 
 28:     protected $service;
 29: 
 30:     public function __construct(App $app)
 31:     {
 32:         parent::__construct($app);
 33:         $config = array(
 34:             'level' => 5,//数据库备份卷大小
 35:             'compress' => 1,//数据库备份文件是否启用压缩 0不压缩 1 压缩
 36:         );
 37:         $this->service = new MysqlBackupService($config);
 38:     }
 39: 
 40:     /**
 41:      * 获取数据列表
 42:      *
 43:      * 本函数用于封装服务层的数据列表获取操作，并通过JSON格式返回成功响应。
 44:      * 主要用于API接口开发，提供数据列表的获取功能，响应格式化由app('json')工具类处理。
 45:      *
 46:      * @return \Illuminate\Http\JsonResponse 返回一个JSON格式的成功响应，包含数据列表。
 47:      */
 48:     public function lst()
 49:     {
 50:         // 调用app('json')的success方法返回数据列表的成功响应
 51:         return app('json')->success($this->service->dataList());
 52:     }
 53: 
 54:     /**
 55:      * 获取文件列表信息
 56:      *
 57:      * 本函数通过调用服务层的方法获取文件列表，然后对这些文件信息进行加工，
 58:      * 最后以特定格式返回给前端。加工过程中，文件信息被重新组织以包含更多易读的细节，
 59:      * 如文件大小显示为带'B'的字符串，以及为方便后续处理，添加了'backtime'字段。
 60:      *
 61:      * @return \Illuminate\Http\JsonResponse 文件列表的JSON响应
 62:      */
 63:     public function fileList()
 64:     {
 65:         // 从服务层获取文件列表
 66:         $files = $this->service->fileList();
 67:         $data = [];
 68: 
 69:         // 遍历文件列表，重新组织数据格式
 70:         foreach ($files as $key => $t) {
 71:             $data[] = [
 72:                 'filename' => $t['filename'], // 文件名
 73:                 'part' => $t['part'], // 文件部分（如果适用）
 74:                 'size' => $t['size'] . 'B', // 文件大小，单位为字节
 75:                 'compress' => $t['compress'], // 文件压缩状态
 76:                 'backtime' => $key, // 原始数组的键，用作文件的备份时间戳
 77:                 'time' => $t['time'], // 文件的时间戳
 78:             ];
 79:         }
 80: 
 81:         // 返回加工后的文件列表数据
 82:         // krsort($data);//根据时间降序
 83:         return app('json')->success($data);
 84:     }
 85: 
 86:     /**
 87:      * 获取数据库表的列详情
 88:      * 本函数通过查询information_schema.columns表，来获取指定数据库表的列信息。
 89:      * 这些信息包括列名、列类型、默认值、是否可为空、额外信息（如自增标识）以及列注释。
 90:      *
 91:      * @param string $name 表名
 92:      * @return json 返回查询结果的JSON格式
 93:      */
 94:     public function detail($name)
 95:     {
 96:         // 从环境变量中获取当前使用的数据库名称
 97:         $database = Env::get("database.database");
 98: 
 99:         // 执行SQL查询，获取指定表的列详细信息
100:         // SQL语句中拼接了表名和数据库名，以确保查询的准确性
101:         $result = Db::query("select COLUMN_NAME,COLUMN_TYPE,COLUMN_DEFAULT,IS_NULLABLE,EXTRA,COLUMN_COMMENT from information_schema.columns where table_name = '" . $name . "' and table_schema = '" . $database . "'");
102: 
103:         // 使用JSON工具类将查询结果包装成成功响应的JSON格式返回
104:         return app('json')->success($result);
105:     }
106: 
107:     /**
108:      * 备份指定的数据库表。
109:      *
110:      * 此方法接受一个表名的数组，逐个对表进行备份。如果表名不是数组，
111:      * 则认为是一个错误的情况。对于每个表，首先检查该表是否存在，
112:      * 如果不存在，则返回错误信息。如果表存在，则尝试进行备份。
113:      * 如果备份失败，将失败的表名记录下来。最后，根据备份是否全部成功，
114:      * 返回相应的成功或失败信息。
115:      *
116:      * @param array $name 表名的数组。
117:      * @return \Illuminate\Http\JsonResponse 返回JSON格式的响应，包含备份结果的信息。
118:      */
119:     public function backups($name)
120:     {
121:         // 初始化用于存储备份失败的表名的变量
122:         $data = [];
123:         // 检查$name是否为数组，如果是，逐个处理每个表名
124:         if (is_array($name)) {
125:             foreach ($name as $item) {
126:                 // 检查表是否存在，如果不存在，返回错误信息
127:                 if (!$this->detail($item))
128:                     return app('json')->fail('不存在的表名');
129:                 // 尝试备份表，如果备份失败且不是因为已存在，则将表名添加到$data
130:                 $res = $this->service->backup($item, 0);
131:                 if ($res == false && $res != 0) {
132:                     $data .= $item . '|';
133:                 }
134:             }
135:         }
136:         // 如果$data不为空，说明有备份失败的表，返回失败信息
137:         if ($data) return app('json')->fail('备份失败' . $data);
138:         // 如果$data为空，说明所有备份都成功，返回成功信息
139:         return app('json')->success('备份成功');
140:     }
141: 
142:     /**
143:      * 执行优化操作
144:      *
145:      * 本函数旨在调用服务层的优化功能，并返回一个表示优化成功的结果消息。
146:      * 通过传递优化目标的名称，可以对特定的优化任务进行触发。
147:      *
148:      * @param string $name 优化目标的名称。这是调用优化功能所必需的参数，用于指定要执行的优化任务。
149:      * @return Json 响应优化成功的消息。使用应用的JSON工具类生成成功消息的JSON响应。
150:      */
151:     public function optimize($name)
152:     {
153:         // 调用服务层的optimize方法，传入优化目标的名称，执行具体的优化操作。
154:         $this->service->optimize($name);
155: 
156:         // 返回一个表示优化成功的结果消息，使用应用的JSON工具类构建响应。
157:         return app('json')->success('优化成功');
158:     }
159: 
160:     /**
161:      * 修复指定名称的物品
162:      *
163:      * 本函数通过遍历传入的物品名称列表，并调用service层的repair方法，逐一尝试修复这些物品。
164:      * 它的设计目的是用于处理一批物品的修复操作，而不是单个物品的修复。
165:      *
166:      * @param array $name 物品名称的数组。每个元素代表一个需要修复的物品的名称。
167:      * @return string 返回一个表示修复成功的信息。使用了app('json')->success方法来生成标准化的成功响应。
168:      */
169:     public function repair($name)
170:     {
171:         // 遍历物品名称数组，对每个物品调用service层的修复方法
172:         foreach ($name as $item) {
173:             $this->service->repair($item);
174:         }
175:         // 返回修复成功的消息
176:         return app('json')->success('修复成功');
177:     }
178: 
179:     /**
180:      * 下载文件的方法
181:      *
182:      * 本方法旨在处理文件下载请求。它通过接收请求中的参数，获取对应的文件信息，
183:      * 并触发文件下载。如果下载过程中出现错误，将捕获异常并返回错误信息。
184:      *
185:      * @return mixed 返回文件下载流或错误信息
186:      */
187:     public function downloadFile()
188:     {
189:         try {
190:             // 从请求中获取文件名参数，并转换为整型
191:             $time = intval($this->request->param('feilname'));
192: 
193:             // 通过服务层获取指定时间的文件信息
194:             $file = $this->service->getFile('time', $time);
195: 
196:             // 解析文件信息，获取文件名
197:             $fileName = $file[0];
198: 
199:             // 触发文件下载
200:             return download($fileName, $time);
201:         } catch (UploadFailException $e) {
202:             // 捕获上传失败异常，返回下载失败的响应
203:             return app('json')->fail('下载失败');
204:         }
205:     }
206: 
207:     /**
208:      * 删除文件
209:      *
210:      * 本函数用于处理文件删除请求。它首先从请求中获取文件名的参数，
211:      * 然后调用服务层的方法删除该文件。如果删除成功，它将返回一个表示成功的JSON响应。
212:      *
213:      * @return \think\Response 成功删除文件后的JSON响应
214:      */
215:     public function deleteFile()
216:     {
217:         // 将请求中的文件名参数转换为整数
218:         $feilname = intval($this->request->param('feilname'));
219:         // 调用服务层的方法删除文件
220:         $files = $this->service->delFile($feilname);
221:         // 返回一个表示删除成功的JSON响应
222:         return app('json')->success('删除成功');
223:     }
224: 
225: 
226: }
