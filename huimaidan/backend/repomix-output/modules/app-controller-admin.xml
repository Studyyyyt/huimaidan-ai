267:             ['send_type', 0],
268:             ['full_reduction', 0],
269:             ['is_limited', 0],
270:             ['is_timeout', 0],
271:             ['total_count', ''],
272:             ['status', 0],
273:             ['cate_ids', []],
274:             'mer_type',
275:             'is_trader',
276:             'category_id',
277:             'type_id',
278:             ['mer_ids', []],
279:         ]);
280:         app()->make(StoreCouponValidate::class)->check($data);
281:         if ($data['send_type'] == $this->repository::GET_COUPON_TYPE_SVIP) {
282:             $data['coupon_type'] = 0;
283:             $data['is_timeout'] = 0;
284:         }
285:         if ($data['is_timeout']) {
286:             [$data['start_time'], $data['end_time']] = $data['range_date'];
287:             if (strtotime($data['end_time']) <= time())
288:                 throw new ValidateException('优惠券领取结束时间不能小于当前');
289:         }
290:         if (!$data['use_type']) $data['use_min_price'] = 0;
291:         unset($data['use_type']);
292:         if ($data['coupon_type']) {
293:             if (count(array_filter($data['use_start_time'])) != 2)
294:                 throw new ValidateException('请选择有效期限');
295:             [$data['use_start_time'], $data['use_end_time']] = $data['use_start_time'];
296:             if ($data['use_start_time'] > $data['use_end_time']) {
297:                 throw new ValidateException('使用开始时间小于结束时间');
298:             }
299:         } else unset($data['use_start_time']);
300:         unset($data['range_date']);
301:         if ($data['is_limited'] == 0) $data['total_count'] = 0;
302:         if (!in_array($data['type'], [10, 11, 12])) {
303:             throw new ValidateException('请选择有效的优惠券类型');
304:         }
305:         $data['mer_id'] = $this->request->merId();
306:         return $data;
307:     }
