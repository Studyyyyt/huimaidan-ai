 62:      * @throws ModelNotFoundException
 63:      * @author xaboy
 64:      * @day 2020-04-10
 65:      */
 66:     public function login(LoginValidate $validate)
 67:     {
 68:         $data = $this->request->params(['account', 'password', 'code', 'key', ['captchaType', ''], ['captchaVerification', ''], 'token']);
 69:         $validate->check($data);
 70:         //图形验证码废弃
 71:         #$this->repository->checkCode($data['key'], $data['code']);
 72: 
 73:         $key = 'sys_login_failuree_' . $data['account'];
 74:         $numb = Cache::get($key) ?? 0;
 75:         if ($numb > 2) {
 76:             if (!$data['captchaType'] || !$data['captchaVerification']) {
 77:                 return app('json')->fail('请滑动滑块验证');
 78:             }
 79:             try {
