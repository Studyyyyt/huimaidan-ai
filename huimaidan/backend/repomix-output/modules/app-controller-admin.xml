 88:         unset($admin['pwd']);
 89:         $data = [
 90:             'token' => $tokenInfo['token'],
 91:             'exp' => $tokenInfo['out'],
 92:             'admin' => $admin
 93:         ];
 94:         Cache::delete($key);
 95:         return app('json')->success($data);
