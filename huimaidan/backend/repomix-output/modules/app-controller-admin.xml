124:      * @return mixed
125:      */
126:     public function getLinks($id, PageCategoryRepository $pageCategoryServices)
127:     {
128:         if (!$id) return app('json')->fail('缺少参数');
129:         $category = $pageCategoryServices->get((int)$id);
130:         if (!$category) {
131:             return app('json')->fail('页面分类不存在');
132:         }
133:         $type = $this->request->param('type', 0);
134:         [$page, $limit] = $this->getPage();
135:         switch ($category['type']) {
136:             case 'special':
137:                 $diyServices = app()->make(ArticleRepository::class);
138:                 $data = $diyServices->search(0, ['status' => 1], $page, $limit);
139:                 break;
140:             case 'article_category':
141:                 $articleCategory = app()->make(ArticleCategoryRepository::class);
142:                 $data = $articleCategory->list(['status' => 1], $page, $limit);
143:                 break;
144:             case 'product_category':
145:                 $storeCategoryServices = app()->make(StoreCategoryRepository::class);
146:                 $data = $storeCategoryServices->getApiFormatList($this->request->merId(), 1);
