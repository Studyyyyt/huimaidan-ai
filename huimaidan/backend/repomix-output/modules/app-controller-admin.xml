186:         if (!$id) return app('json')->fail('参数错误');
187:         if (!$this->repository->existsWhere(['id' => $id]))
188:             return app('json')->fail('数据不存在');
189:         $this->repository->delete($id);
190:         return app('json')->success('删除成功!');
191:     }
