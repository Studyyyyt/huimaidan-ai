148:             case 'merchant':
149:                 $data = app()->make(MerchantRepository::class)->lst(['mer_state' => 1, 'status' => 1], $page, $limit);
150:                 break;
151:             case 'active':
152:                 $groupid = $this->request->merId() ? 95 : 94;
153:                 $query = app()->make(GroupDataRepository::class)
154:                     ->getGroupDataWhere($this->request->merId(), $groupid)
155:                     ->where('status', 1);
156:                 $data['count'] = $query->count();
157:                 $data['list'] = $query->page($page, $limit)->select()->toArray();
158:                 break;
159:             case 'points_cate':
160:                 $storeCategoryServices = app()->make(StoreCategoryRepository::class);
161:                 $data = $storeCategoryServices->getApiFormatList($this->request->merId(), 1, 1);
162:                 break;
163:             case 'micro':
164:                 $data = app()->make(DiyRepository::class)->getList(['is_diy' => 0], $page, $limit);
165:                 break;
166:             case 'activity_form': //报名活动
167:                 $where['activity_type'] = StoreActivityRepository::ACTIVITY_TYPE_FORM;
168:                 $where['status'] = 1;
169:                 $where['is_show'] = 1;
170:                 $data = app()->make(StoreActivityRepository::class)->getList($where, $page, $limit);
171:                 break;
172:             default:
173:                 $data = $this->repository->getLinkList($id, $type == 1 ? 1 : $this->request->merId());
174:                 break;
175:         }
176:         return app('json')->success($data);
177:     }
178: 
