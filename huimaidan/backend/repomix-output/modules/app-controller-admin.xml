 41: 
 42:     /**
 43:      * Sms constructor.
 44:      * @param App $app
 45:      */
 46:     public function __construct(App $app)
 47:     {
 48:         parent::__construct($app);
 49:         $this->service = YunxinSmsService::create();
 50:     }
 51: 
 52:     /**
 53:      * 发送验证码
 54:      *
 55:      * 本函数用于处理用户请求发送验证码的逻辑。它首先验证用户提供的手机号码是否有效，
 56:      * 然后调用服务层方法尝试发送验证码。如果手机号码无效或发送失败，函数将返回相应的错误信息；
 57:      * 如果发送成功，函数将返回成功的消息。
 58:      *
 59:      * @return json 返回包含发送结果的JSON对象
 60:      */
 61:     public function captcha()
 62:     {
 63:         // 获取请求中的手机号码
 64:         $phone = request()->param('phone');
 65: 
 66:         // 检查手机号码是否存在
 67:         if (!$phone)
 68:             return app('json')->fail('请输入手机号');
 69: 
 70:         // 验证手机号码格式是否正确
 71:         if (!preg_match('/^1[3456789]{1}\d{9}$/', $phone))
 72:             return app('json')->fail('请输入正确的手机号');
 73: 
 74:         // 调用服务层方法发送验证码
 75:         $res = $this->service->captcha($phone);
 76: 
 77:         // 检查发送结果，如果发送失败则返回错误信息
 78:         if (!isset($res['status']) && $res['status'] !== 200)
 79:             return app('json')->fail($res['data']['message'] ?? $res['msg'] ?? '发送失败');
 80: 
 81:         // 如果发送成功，则返回成功的消息
 82:         return app('json')->success($res['data']['message'] ?? $res['msg'] ?? '发送成功');
 83:     }
 84: 
 85:     /**
 86:      * 保存注册信息并进行验证
 87:      *
 88:      * 本函数负责接收注册请求，对请求数据进行验证，加密密码，然后将数据发送给服务层进行注册操作。
 89:      * 如果注册失败，会根据错误码返回相应的错误信息；如果注册成功，则会更新配置信息。
 90:      *
 91:      * @param SmsRegisterValidate $validate 验证数据的验证器对象
 92:      * @return json 返回注册结果的JSON对象，包含成功或失败的信息
 93:      */
 94:     public function save(SmsRegisterValidate $validate)
 95:     {
 96:         // 从请求中获取注册信息
 97:         $data = $this->request->params(['account', 'password', 'phone', 'code', 'url', 'sign']);
 98: 
 99:         // 使用验证器对获取的注册信息进行验证
100:         $validate->check($data);
101: 
102:         // 对密码进行MD5加密
103:         $data['password'] = md5($data['password']);
104: 
105:         // 调用服务层方法进行注册操作
106:         $res = $this->service->registerData($data);
107: 
108:         // 如果注册失败，返回相应的错误信息
109:         if ($res['status'] == 400) return app('json')->fail('短信平台：' . $res['msg']);
110: 
111:         // 如果注册成功，更新配置信息
112:         $this->service->setConfig($data['account'], $data['password']);
113: 
114:         // 返回注册成功的消息
115:         return app('json')->success('短信平台：' . $res['msg']);
116:     }
117: 
118:     /**
119:      * 保存基本配置信息，用于短信平台的账号密码存储。
120:      *
121:      * 本函数主要用于处理用户提交的短信平台账号密码，并进行验证和保存。
122:      * 它首先从请求中提取账号和密码，然后使用验证器对输入进行检查。
123:      * 如果验证成功，它将账号和加密的密码保存到服务中，并尝试获取公共短信模板。
124:      * 如果获取模板成功，说明账号密码正确，保存配置信息并返回登录成功的响应。
125:      * 如果获取模板失败，说明账号或密码错误，返回相应的错误响应。
126:      *
127:      * @param SmsRegisterValidate $validate 验证器对象，用于校验输入数据的合法性。
128:      * @param ConfigValueRepository $repository 配置信息存储对象，用于保存账号密码信息。
129:      * @return json 返回登录成功或失败的JSON响应。
130:      */
131:     public function save_basics(SmsRegisterValidate $validate, ConfigValueRepository $repository)
132:     {
133:         // 从请求中提取账号和密码参数。
134:         $data = $this->request->params([
135:             'account', 'password'
136:         ]);
137: 
138:         // 验证用户是否已登录，并检查输入数据的合法性。
139:         $validate->isLogin()->check($data);
140: 
141:         // 设置短信服务的账号和加密后的密码。
142:         $this->service->setConfig($data['account'], md5($data['password']));
143: 
144:         // 尝试获取公共短信模板，用于验证账号密码是否有效。
145:         // 添加公共短信模板
146:         $templateList = $this->service->publictemp([]);
147: 
148:         // 如果获取模板成功，说明账号密码正确，保存配置并返回成功响应。
149:         if ($templateList['status'] != 400) {
150:             $repository->setFormData(['sms_account' => $data['account'], 'sms_token' => md5($data['password'])], 0);
151:             return app('json')->success('登录成功');
152:         } else {
153:             // 如果获取模板失败，说明账号或密码错误，返回失败响应。
154:             return app('json')->fail('账号或密码错误');
155:         }
156:     }
157: 
158:     /**
159:      * 检查用户是否已登录。
160:      *
161:      * 本函数通过调用服务层的方法来获取用户的账号信息，以此来判断用户是否已登录。
162:      * 如果用户已登录，即账号信息存在，将返回一个包含登录状态和账号信息的JSON对象。
163:      * 如果用户未登录，或者账号信息获取失败，将返回一个包含登录状态为false的JSON对象。
164:      *
165:      * @return \Illuminate\Http\JsonResponse 返回一个JSON响应，其中包含登录状态和/或账号信息。
166:      */
167:     public function is_login()
168:     {
169:         // 尝试获取用户的账号信息
170:         if ($sms_info = $this->service->account()) {
171:             // 如果账号信息获取成功，返回一个包含登录状态为true和账号信息的JSON响应
172:             return app('json')->success(['status' => true, 'info' => $sms_info]);
173:         } else {
174:             // 如果账号信息获取失败，返回一个包含登录状态为false的JSON响应
175:             return app('json')->success(['status' => false]);
176:         }
177:     }
178: 
179:     /**
180:      * 获取短信记录
181:      *
182:      * 本方法用于根据请求参数获取指定条件下的短信记录列表。它支持分页查询，通过调用SmsRecordRepository中的getList方法来实现。
183:      * 参数包括页码和每页记录数，以及请求中可能携带的短信类型参数。
184:      *
185:      * @param SmsRecordRepository $repository 短信记录仓库对象，用于执行查询操作。
186:      * @return json 返回包含查询结果的JSON对象，成功时包含数据列表，错误时包含错误信息。
187:      */
188:     public function record(SmsRecordRepository $repository)
189:     {
190:         // 获取请求中的页码和每页记录数
191:         [$page, $limit] = $this->getPage();
192: 
193:         // 从请求中获取类型参数，默认为0
194:         $where = $this->request->params(['type', 0]);
195: 
196:         // 调用getList方法获取短信记录列表，并使用json助手函数返回成功响应
197:         return app('json')->success($repository->getList($where, $page, $limit));
198:     }
199: 
200:     /**
201:      * 获取短信记录相关数据
202:      *
203:      * 本函数通过调用服务层获取短信发送数量及总数，并结合短信记录仓库获取已记录的短信数量，
204:      * 以及获取当前的短信账户信息，最终组装成数据集返回。
205:      *
206:      * @param SmsRecordRepository $repository 短信记录仓库，用于获取短信记录的数量。
207:      * @return json 返回包含短信数量、总数、记录数量及账户信息的数据集。
208:      */
209:     public function data(SmsRecordRepository $repository)
210:     {
211:         // 调用服务层方法获取短信发送统计信息
212:         $countInfo = $this->service->count();
213: 
214:         // 根据获取的统计信息状态判断是否成功获取数据
215:         if ($countInfo['status'] == 400) {
216:             // 如果获取数据失败，初始化短信数量和总数为0
217:             $info['number'] = 0;
218:             $info['total_number'] = 0;
219:         } else {
220:             // 如果获取数据成功，填充短信数量和总数
221:             $info['number'] = $countInfo['data']['number'];
222:             $info['total_number'] = $countInfo['data']['send_total'];
223:         }
224: 
225:         // 获取短信记录的数量
226:         $info['record_number'] = $repository->count();
227: 
228:         // 获取当前短信账户信息
229:         $info['sms_account'] = $this->service->account();
230: 
231:         // 返回组装后的数据集
232:         return app('json')->success($info);
233:     }
234: 
235:     /**
236:      * 用户退出登录操作
237:      *
238:      * 本函数负责清除与用户登录状态相关的缓存数据，确保用户安全退出。
239:      * 它通过删除特定的缓存键来实现，这些键包括用户的短信账户信息、服务账户信息以及相关的令牌。
240:      * 使用缓存系统和配置值仓库的结合，本函数能够高效且彻底地清理用户的登录状态。
241:      *
242:      * @param ConfigValueRepository $repository 配置值仓库实例，用于清除特定配置项的值。
243:      * @return \Illuminate\Http\JsonResponse 返回一个表示成功退出的JSON响应。
244:      */
245:     public function logout(ConfigValueRepository $repository)
246:     {
247:         // 从缓存中删除短信账户信息
248:         Cache::delete('sms_account');
249:         // 从缓存中删除服务账户信息
250:         Cache::delete('serve_account');
251: 
252:         // 使用配置值仓库清除特定键值相关的缓存，包括短信令牌和服务器令牌
253:         $repository->clearBykey(['sms_account', 'sms_token', 'serve_account', 'serve_token'], 0);
254: 
255:         // 返回一个表示成功退出的JSON响应
256:         return app('json')->success('退出成功');
257:     }
258: 
259: 
260:     /**
261:      *  修改密码
262:      * @Author:Qinii
263:      * @Date: 2020/9/2
264:      * @return mixed
265:      */
266:     public function changePassword()
267:     {
268:         $data = $this->request->params(['password', 'phone', 'code']);
269:         if (empty($data['password']))
270:             return app('json')->fail('密码不能为空');
271:         $data['password'] = md5($data['password']);
272:         $res = $this->service->smsChange($data);
273:         if ($res['status'] == 400) return app('json')->fail('短信平台：' . $res['msg']);
274:         $this->service->setConfig($this->service->account(), $data['password']);
275:         return app('json')->success('修改成功');
276:     }
277: 
278:     /**
279:      *  修改签名
280:      * @Author:Qinii
281:      * @Date: 2020/9/2
282:      * @return mixed
283:      */
284:     public function changeSign()
285:     {
286:         $data = $this->request->params(['sign', 'phone', 'code']);
287:         if (empty($data['sign'])) return app('json')->fail('签名不能为空');
288:         $res = $this->service->smsChange($data);
289:         if ($res['status'] == 400) return app('json')->fail('短信平台：' . $res['msg']);
290:         return app('json')->success('修改已提交,审核通过后自动更改');
291:     }
292: }
