 93:     {
 94:         return ProductGroupSku::where('product_group_id',$this->product_group_id)->sum('stock_count');
 95:     }
 96: 
 97:     public function getUsStatusAttr()
 98:     {
 99:         return ($this->product_status == 1) ? ($this->status == 1 ? ( $this->is_show ? 1 : 0 ) : -1) : -1;
100:     }
101: 
102:     //销量
103:     public function getSalesAttr()
104:     {
105:         $make = app()->make(StoreOrderRepository::class);
106:         $where = [
107:             'product_id' => $this->product_id,
108:             'product_type' => 4,
109:         ];
110:         return $make->getTattendCount($where,null)->sum('product_num');
111:     }
