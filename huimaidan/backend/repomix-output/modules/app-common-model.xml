 62:     }
 63: 
 64:     public function getUsedNumAttr()
 65:     {
 66:         return app()->make(StoreCouponUserRepository::class)->usedNum($this->coupon_id);
 67:     }
 68: 
 69:     public function getSendNumAttr()
 70:     {
 71:         return app()->make(StoreCouponUserRepository::class)->sendNum($this->coupon_id);
 72:     }
 73: 
 74:     public function getCouponPriceAttr($value)
 75:     {
 76:         // 格式化为两位小数
 77:         $formatted = number_format($value, 2, '.', '');
 78:         // 转换格式化后的数字
 79:         $formatted = rtrim($formatted, '0'); // 去除末尾的0
 80:         $formatted = rtrim($formatted, '.'); // 去除末尾的小数点（如果存在）
 81:         return $formatted;
 82:     }
 83: 
 84:     public function getProductLstAttr()
 85:     {
 86:         $where['spu_status'] = 1;
 87:         $where['mer_status'] = 1;
 88:         //优惠券类型 0-店铺 1-商品券 10 平台通用券 11平台品类券 12平台跨店券
 89:         switch ($this['type']) {
 90:             case 0:
 91:                 $where['mer_id'] = $this->mer_id;
 92:                 break;
 93:             case 1:
 94:                 $where['product_ids'] = StoreCouponProduct::where('coupon_id', $this->coupon_id)->limit(5)->column('product_id');
 95:                 break;
 96:             case 10:
 97:                 break;
 98:             case 11:
 99:                 $ids = StoreCouponProduct::where('coupon_id', $this->coupon_id)->limit(5)->column('product_id');
100:                 $where['cate_pid'] = $ids;
101:                 break;
102:             case 12:
103:                 $ids = StoreCouponProduct::where('coupon_id', $this->coupon_id)->limit(5)->column('product_id');
104:                 $where['mer_ids'] = $ids;
105:                 break;
106:         }
107: 
108:         $where['order'] = 'none';
109:         $where['common'] = 1;
110:         $where['product_type'] = 0;
111:         $product = app()->make(SpuRepository::class)->search($where)->field(
112:             'S.spu_id,S.product_id,S.store_name,S.image,activity_id,S.keyword,S.price,S.mer_id,spu_id,S.status,P.store_info,brand_id,cate_id,unit_name,S.star,S.rank,S.sort,sales,S.product_type,P.ot_price'
113:         )->limit(3)->orderRand()->select()->toArray();
114:         return $product;
115:     }
116: }
</file>

