121:             ->with(['reservation','merchant'])
122:             ->where((new ProductDao())->productShow())
123:             ->whereLike('delivery_way',"%1%")
124:             ->field('mer_id,product_id,store_name,image,price,is_show,status,is_gift_bag,is_good,cate_id,activity_label_ids,delivery_free,give_coupon_ids,delivery_way,type,product_type')
