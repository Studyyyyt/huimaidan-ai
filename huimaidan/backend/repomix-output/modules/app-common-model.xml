 64:      * @day 2020-10-14
 65:      */
 66:     public function getPresellStatusAttr()
 67:     {
 68:         $start_time = strtotime($this->start_time);
 69:         $end_time = strtotime($this->end_time);
 70:         $time = time();
 71:         //已结束
 72:         if($this->action_status == -1) return 2;
 73:         //未开始
 74:         if($start_time > $time) return 0;
 75:         //进行中
 76:         if($start_time <= $time && $end_time > $time) {
 77:             if($this->product_status !== 1 || $this->status !==1 || $this->is_show !== 1) return 0;
 78:             return 1;
 79:         }
 80:         //已结束
 81:         if($end_time <= $time) {
 82:             if($this->presell_type == 1 || ($this->presell_type == 2 && (strtotime($this->final_end_time) < $time))){
 83:                 $this->action_status = -1;
 84:                 $this->save();
 85:             }
 86:             app()->make(SpuRepository::class)->changeStatus($this->product_presell_id,2);
 87:             return 2;
 88:         }
 89:     }
