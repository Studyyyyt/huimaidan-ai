313:     public function getActivityLabelsAttr($value, $data)
314:     {
315:         // 类型映射
316:         $productTypeMap = [
317:             1 => 7, // 秒杀
318:             2 => 9, // 预售
319:             3 => 8, // 助力
320:             4 => 6  // 拼团
321:         ];
322:         $defaltLabelWhere = [];
323:         if (isset($data['delivery_free']) && $data['delivery_free'] == 1) {
324:             $defaltLabelWhere[] = 1; // 包邮
325:         }
326:         if (isset($this->issetCoupon) && !empty($this->issetCoupon)) {
327:             $defaltLabelWhere[] = 2; // 领券
328:         }
329:         if(isset($data['type'])) {
330:             if($data['type'] == 4 && isset($this->reservation) && !empty($this->reservation)) {
331:                 // 预约类型处理,上门+到店
332:                 if ($this->reservation->reservation_type == 3) {
333:                     $defaltLabelWhere[] = 3; 
334:                     $defaltLabelWhere[] = 4;
335:                 } else { // 3:上门 4:到店
336:                     $defaltLabelWhere[] = $this->reservation->reservation_type == 1 ? 4 : 3;
337:                 }
338:             }
339:             if(isset($data['delivery_way'])) {
340:                 $deliveryWay = is_string($data['delivery_way']) ? explode(',', $data['delivery_way']) : $data['delivery_way'];
341:                 if ($data['type'] == 0 && in_array(3, $deliveryWay)) {
342:                     $defaltLabelWhere[] = 5; // 同城
343:                 }
344:             }
345:         }
346:         if (isset($data['product_type']) && isset($productTypeMap[$data['product_type']])) {
347:             $defaltLabelWhere[] = $productTypeMap[$data['product_type']]; // 如果产品类型在映射中存在，直接使用映射值
348:         }
349:         if (isset($this->merchant) && $this->merchant->is_trader === 1) {
350:             $defaltLabelWhere[] = 10; // 自营
351:         }
352:         // 构建基础查询条件
353:         $field = 'id,label_name,style_type,color,bg_color,border_color,icon,default_type,is_show,status';
354:         $baseQuery = StoreActivityLabel::where('status', 1);
355:         // 复用查询对象，分别获取默认标签和自定义标签
356:         $defaultLabels = [];
357:         if ($defaltLabelWhere) {
358:             $defaultLabels = (clone $baseQuery)->whereIn('default_type', $defaltLabelWhere)->column($field);
359:         }
360:         $labels = [];
361:         if ($this->activity_label_ids) {
362:             $labels = $baseQuery->whereIn('id', $this->activity_label_ids)->column($field);
363:         }
364: 
365:         return array_merge($defaultLabels, $labels);
366:     }
