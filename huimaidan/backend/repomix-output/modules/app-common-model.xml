 65:     public function getActionStatusAttr($value)
 66:     {
 67:         if($value== -1) return -1;
 68:         $start_time = strtotime($this->start_time);
 69:         $end_time = strtotime($this->end_time);
 70:         if($start_time > time()) return 0;
 71: 
 72: 
 73:         if($start_time <= time() && $end_time > time()){
 74:             $this->action_status = 1;
 75:             $this->save();
 76:             return 1;
 77:         }
 78:         if($end_time <= time()){
 79:             $this->action_status = -1;
 80:             $this->save();
 81:             queue(ChangeSpuStatusJob::class, ['id' => $this->product_group_id, 'product_type' => 4]);
 82:             //app()->make(SpuRepository::class)->changeStatus($this->product_group_id,4);
 83:             return -1;
 84:         }
 85:     }
