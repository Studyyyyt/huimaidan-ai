39:     {
40:         return ($data['commission_type'] == 0) ? systemConfig(self::SYSTEMC_COMMISSION[$data['level']]) : $value;
41:     }
42: 
43:     public function circleAgent()
44:     {
45:         return $this->hasOne(CircleAgent::class, 'circle_agent_id', 'circle_agent_id')
46:             ->field('circle_agent_id, name, phone, qualification, create_time, status')
47:             ->where('status', 1);
48:     }
49: 
50:     public function merchant()
51:     {
52:         $data = $this->getData();
53:         $type = $data['type'];
54:         if($type == 0) {
55:             return $this->hasMany(Merchant::class, 'region_id', 'circle_id')->field('mer_id,mer_name,region_id,business_id,status');
56:         }
57:         if ($type == 1) {
58:             return $this->hasMany(Merchant::class, 'business_id', 'circle_id')->field('mer_id,mer_name,region_id,business_id,status');
59:         }
60:     }
61: 
62:     public function parent()
63:     {
64:         return $this->hasOne(Circle::class, 'circle_id', 'pid')
65:             ->field('name, circle_id, circle_agent_id, pid, commission_type, commission_rate, level, status, type');
66:     }
67: 
68:     public function getMerchantCountAttr()
69:     {
70:         return $this->merchant()->count();
71:     }
72: }
