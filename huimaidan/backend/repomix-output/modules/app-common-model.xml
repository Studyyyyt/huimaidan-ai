 70:     public function getConfigAttr()
 71:     {
 72:         $configKeys = [
 73:             'mer_integral_status',  // 积分状态
 74:             'mer_integral_rate',    // 积分抵扣比例
 75:             'mer_store_stock',      // 警戒库存
 76:             'mer_take_status',      // 自提点状态
 77:             'mer_take_name',        // 自提点名称
 78:             'mer_take_phone',       // 自提点电话
