 82:             'svip_coupon_merge',    // 是否支持付费会员和优惠卷合并使用
 83:             'mer_take_time',        // 自提点时间
 84:             'mer_open_receipt'      // 是否开启发票
 85:         ];
 86:         return merchantConfig($this->mer_id, $configKeys);
 87:     }
