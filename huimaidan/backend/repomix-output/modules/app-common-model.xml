 89:     public function showProduct()
 90:     {
 91:         return $this->hasMany(Product::class, 'mer_id', 'mer_id')
 92:             ->where((new ProductDao())->productShow())
 93:             ->field('mer_id,product_id,store_name,image,price,is_show,status,is_gift_bag,is_good')
 94:             ->order('is_good DESC,sort DESC');
 95:     }
 96: 
 97:     /**
 98:      *  商户列表下的推荐
 99:      * @return \think\Collection
100:      * @author Qinii
101:      * @day 4/20/22
102:      */
103:     public function getAllRecommendAttr()
104:     {
105:         $list = Product::where('mer_id', $this['mer_id'])
106:             ->with(['reservation','merchant'])
107:             ->where((new ProductDao())->productShow())
108:             ->field('mer_id,product_id,store_name,image,price,is_show,status,is_gift_bag,is_good,cate_id,activity_label_ids,delivery_free,give_coupon_ids,delivery_way,type,product_type')
109:             ->order('is_good DESC, sort DESC, create_time DESC')
110:             ->limit(10)
111:             ->select()->append(['show_svip_info','activity_labels']);
112:         if ($list) {
113:             $list = app()->make(StoreActivityRepository::class)->getPic($list->toArray(),StoreActivityRepository::ACTIVITY_TYPE_BORDER);
