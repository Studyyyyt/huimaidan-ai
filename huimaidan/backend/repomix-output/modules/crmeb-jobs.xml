16: 
17: use app\common\repositories\store\coupon\StoreCouponUserRepository;
18: use app\common\repositories\store\order\StoreGroupOrderRepository;
19: use app\common\repositories\store\product\ProductAttrValueRepository;
20: use app\common\repositories\store\product\ProductRepository;
21: use app\common\repositories\store\product\StoreDiscountRepository;
22: use crmeb\interfaces\JobInterface;
23: use think\facade\Db;
24: use think\facade\Log;
25: 
26: class CancelGroupOrderJob implements JobInterface
27: {
28: 
29:     public function fire($job, $groupOrderId)
30:     {
31:         $groupOrderRepository = app()->make(StoreGroupOrderRepository::class);
32:         $groupOrder = $groupOrderRepository->getCancelDetail($groupOrderId);
33:         if (!$groupOrder) return $job->delete();
34:         Db::transaction(function () use ($groupOrder) {
35:             $couponId = $groupOrder->coupon_id ? [$groupOrder->coupon_id] : [];
36:             $productRepository = app()->make(ProductRepository::class);
37:             foreach ($groupOrder->orderList as $order) {
38:                 if ($order->coupon_id)
39:                     $couponId = array_merge($couponId, explode(',', $order->coupon_id));
40:                 foreach ($order->orderProduct as $cart) {
41:                     $productRepository->orderProductIncStock($order, $cart);
42:                 }
43:                 if ($order->activity_type == 10) {
44:                     app()->make(StoreDiscountRepository::class)->incStock($order->orderProduct[0]['activity_id']);
45:                 }
46:             }
47:             if (count($couponId)) {
48:                 app()->make(StoreCouponUserRepository::class)->updates($couponId, ['status' => 0]);
49:             }
50:         });
51:         return $job->delete();
52:     }
53: 
54:     public function failed($data)
55:     {
56:         Log::info('取消订单执行失败:' . var_export($data, true));
57:     }
58: }
</file>

