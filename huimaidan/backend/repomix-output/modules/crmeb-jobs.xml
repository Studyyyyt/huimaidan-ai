<file path="SyncProductTopJob.php">
 1: <?php
 2: 
 3: namespace crmeb\jobs;
 4: 
 5: use app\common\repositories\store\product\SpuRepository;
 6: use app\common\repositories\store\StoreCategoryRepository;
 7: use app\common\repositories\system\merchant\MerchantRepository;
 8: use crmeb\interfaces\JobInterface;
 9: use crmeb\services\RedisCacheService;
10: use think\facade\Cache;
11: use think\facade\Log;
12: use function app;
13: 
14: class SyncProductTopJob implements JobInterface
15: {
16: 
17:     public function fire($job, $data)
18:     {
19:         try{
20:             $hot = systemConfig(['hot_ranking_switch','hot_ranking_lv']);
21:             if ($hot['hot_ranking_switch'] != 1) return $job->delete();
22: 
23:             $SpuRepository = app()->make(SpuRepository::class);
24:             $RedisCacheService = app()->make(RedisCacheService::class);
25:             $prefix = env('queue_name','merchant').'_hot_ranking_';
26:             $oldKeys1 = $RedisCacheService->keys($prefix.'top_*') ?: [];
27:             $oldKeys1 = array_combine($oldKeys1, $oldKeys1);
28:             $mset = [];
29:             $where = ['product_type' => 0, 'spu_status' => 1, 'mer_status' => 1, 'order' => 'sales'];
30:             $ids = $SpuRepository->search($where)->limit(15)->column('spu_id');
31:             $mset[$prefix.'top_0'] = implode(',', $ids);
32:             unset($oldKeys1[$prefix.'top_0']);
33:             $make = app()->make(StoreCategoryRepository::class);
34:             foreach ([1,2,3] as $level) {
35:                 $cateList = $make->getSearch(['status' => 1, 'mer_id' => 0, 'type' => 0])
36:                     ->where('level','<',$level)->column('store_category_id,cate_name,pic');
37:                 foreach ($cateList as $item) {
38:                     $id = $item['store_category_id'];
39:                     $ids = $make->findChildrenId($id);
40:                     $ids[] = $id;
41:                     $where['cate_id'] = $ids;
42:                     $spuList = $SpuRepository->search($where)->limit(15)->select();
43:                     if (count($spuList)) {
44:                         foreach ($spuList as $i => $spu) {
45:                             $key = $prefix.'top_item_' . $id . '_' . $spu['spu_id'];
46:                             $mset[$key] = json_encode([$item['cate_name'], $i + 1, $id], JSON_UNESCAPED_UNICODE);
47:                             unset($oldKeys1[$key]);
48:                         }
49:                         $_key = $prefix.'top_' . $id;
50:                         $mset[$_key] = implode(',', $spuList->column('spu_id'));
51:                         unset($oldKeys1[$_key]);
52:                     }
53:                 }
54:                 Cache::set($prefix.'topCate', implode(',', array_column($cateList, 'store_category_id')));
55:             }
56:             if (count($mset)) {
57:                 $RedisCacheService->mSet($mset);
58:             }
59:             if (count($oldKeys1)) {
60:                 $RedisCacheService->handler()->del(...array_values($oldKeys1));
61:             }
62:         }catch (\Exception $e){
63:             Log::info('热卖排行统计:' . $e->getMessage());
64:         }
65:         $job->delete();
66:     }
67: 
68:     public function failed($data)
69:     {
70:         // TODO: Implement failed() method.
71:     }
72: 
73:     public function work()
74:     {
75: 
76:     }
77: }
</file>

