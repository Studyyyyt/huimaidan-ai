22: class MerchantSendCouponJob implements JobInterface
23: {
24: 
25:     public function fire($job, $sendId)
26:     {
27:         $storeCouponSendRepository = app()->make(StoreCouponSendRepository::class);
28:         $send = $storeCouponSendRepository->get((int)$sendId);
29:         if (!$send || $send->status == 1) {
30:             return $job->delete();
31:         }
32:         $cacheKey = '_send_coupon' . $sendId;
33:         $cache = Cache::store('file');
34:         if (!$cache->has($cacheKey)) {
35:             $send->status = -1;
36:             return $job->delete();
37:         }
38:         $storeCouponRepository = app()->make(StoreCouponRepository::class);
39:         $storeCouponUserRepository = app()->make(StoreCouponUserRepository::class);
40:         $coupon = $storeCouponRepository->get($send->coupon_id);
41:         if (!$coupon) {
42:             $send->status = -1;
43:             return $job->delete();
44:         }
45:         $uids = $cache->get($cacheKey);
46:         do {
47:             $install = [];
48:             foreach (array_splice($uids, -30) as $k => $uid) {
49:                 $data = $storeCouponRepository->createData($coupon, $uid);
50:                 $data['send_id'] = $sendId;
51:                 $install[] = $data;
52:             }
53:             try {
54:                 $storeCouponUserRepository->insertAll($install);
55:             } catch (\Exception $e) {
56:             }
57:             usleep(100);
58:         } while (count($uids));
59:         $send->status = 1;
60:         $send->save();
61:         return $job->delete();
62:     }
63: 
