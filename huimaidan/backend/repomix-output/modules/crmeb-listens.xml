222:         /** @var UserVisitRepository $make */
223:         $make = app()->make(UserVisitRepository::class);
224:         $make->create($data);
225:     }
226: 
227:     public function log(array $data)
228:     {
229:         app()->make(AdminLogRepository::class)->create($data['merId'], $data['result']);
230:     }
231: }
