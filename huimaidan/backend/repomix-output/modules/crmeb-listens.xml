26: class AuthTakeOrderListen extends TimerService implements ListenerInterface
27: {
28: 
29:     public function handle($event): void
30:     {
31:         $this->tick(1000 * 60 * 60, function () {
32:             $storeOrderRepository = app()->make(StoreOrderRepository::class);
33:             request()->clearCache();
34:             /**
35:              *  设置自动确认收获的时间默认为 15
36:              *  查询确认收货 15天前发货，再向前查询15天；
37:              *  超过这个时间未处理的订单将不做处理，
38:              *  比如：发货时间 10-1 ； 自动确认时间：15天，当10-15日查询的范围：9-15 ～ 10-15 期间未处理订单，9-15日以前订单不做处理
39:              */
40:             $timer = ((int)systemConfig('auto_take_order_timer')) ?: 15;
41:             $end = date('Y-m-d H:i:s', strtotime("- $timer day"));
42:             $start = date('Y-m-d H:i:s', strtotime("- 15 day",strtotime($end)));
43:             $ids = app()->make(StoreOrderStatusRepository::class)->getTimeoutDeliveryOrder($start,$end);
44:             foreach ($ids as $id) {
45:                 try {
46:                     $storeOrderRepository->takeOrder($id);
47:                     Queue::push(OrderReplyJob::class, $id);
48:                 } catch (\Exception $e) {
49:                     Log::error('自动收货失败:['. $id .']'. $e->getMessage());
50:                 }
51:             }
52:         });
53:     }
54: }
