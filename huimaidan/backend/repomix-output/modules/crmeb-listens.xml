23: class AutoUnLockBrokerageListen extends TimerService implements ListenerInterface
24: {
25: 
26:     public function handle($event): void
27:     {
28:         //TODO 自动解冻佣金
29:         $this->tick(1000 * 60 * 20, function () {
30:             $userBill = app()->make(UserBillRepository::class);
31:             request()->clearCache();
32:             $timer = ((int)systemConfig('lock_brokerage_timer'));
33:             $time = date('Y-m-d H:i:s', $timer ? strtotime("- $timer day") : time());
34:             $bills = $userBill->getTimeoutBrokerageBill($time);
35:             Db::transaction(function () use ($userBill, $bills) {
36:                 foreach ($bills as $bill) {
37:                     if ($bill->number > 0 && $bill->user) {
38:                         $brokerage = bcsub($bill->number, $userBill->refundBrokerage($bill->link_id, $bill->uid), 2);
39:                         if ($brokerage > 0) {
40:                             $bill->user->brokerage_price = bcadd($bill->user->brokerage_price, $brokerage, 2);
