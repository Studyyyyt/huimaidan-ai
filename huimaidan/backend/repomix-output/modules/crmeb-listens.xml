14: namespace crmeb\listens;
15: 
16: 
17: use app\common\model\user\User;
18: use app\common\repositories\store\IntegralRepository;
19: use app\common\repositories\user\UserBillRepository;
20: use app\common\repositories\user\UserRepository;
21: use crmeb\interfaces\ListenerInterface;
22: use crmeb\jobs\ClearUserIntegralJob;
23: use crmeb\jobs\SendSmsJob;
24: use crmeb\services\TimerService;
25: use Swoole\Timer;
26: use think\facade\Cache;
27: use think\facade\Db;
28: use think\facade\Queue;
29: 
30: class AutoClearIntegralListen extends TimerService implements ListenerInterface
31: {
32: 
33:     public function handle($event): void
34:     {
35:         //TODO 自动清除积分
36:         $this->tick(1000 * 60 * 20, function () {
37:             request()->clearCache();
38:             if (!systemConfig('integral_status')) return;
39:             $make = app()->make(IntegralRepository::class);
40:             $end = $make->getTimeoutDay();
41:             if ($end == strtotime(date('Y-m-d') . ' 00:00:00')) {
42:                 $start = $make->getInvalidDay();
43:                 $make->clearTimeoutDay();
44:                 if ($start) {
45:                     $startTime = date('Y-m-d H:i:s', $start);
46:                     $endTime = date('Y-m-d H:i:s', $end);
47:                     User::getDB()->where('integral', '>', 0)->field('uid')->chunk(1000, function ($users) use ($startTime, $endTime) {
48:                         foreach ($users as $user) {
49:                             $uid = $user['uid'];
50:                             Queue::later(1800, ClearUserIntegralJob::class, compact('uid', 'startTime', 'endTime'));
51:                         }
52:                         usleep(100);
53:                     });
54:                 }
55:             } else if ($end < strtotime('+15 day')) {
56:                 $make1 = app()->make(UserBillRepository::class);
57:                 $invalidDay = $make->getInvalidDay();
58:                 $cache = Cache::store('file');
59:                 $checkKey = 'integral_check';
60:                 if ($cache->has($checkKey)) {
61:                     return;
62:                 }
63:                 $endTime = $end;
64:                 $startTime = date('Y-m-d H:i:s', $invalidDay);
65:                 User::getDB()->where('integral', '>', 0)->where('phone', '<>', '')->field('uid,phone,integral')->chunk(1000, function ($users) use ($endTime, $startTime, $invalidDay, $end, $make1, $cache) {
66:                     foreach ($users as $user) {
67:                         $cacheKey = 'integral_sms' . $user['uid'];
68:                         if ($cache->has($cacheKey)) {
69:                             continue;
70:                         }
71:                         $integral = $user['integral'];
72:                         if ($integral > 0 && $invalidDay) {
73:                             $validIntegral = $make1->validIntegral($user['uid'], $startTime, $endTime);
74:                             if ($integral > $validIntegral) {
75:                                 $nextClearIntegral = (int)bcsub($integral, $validIntegral, 0);
76:                                 $cache->set($cacheKey, 1, 3600 * 24 * 20);
77:                                 Queue::push(SendSmsJob::class, [
78:                                     'tempId' => 'INTEGRAL_INVALID',
79:                                     'id' => [
80:                                         'integral' => $nextClearIntegral,
81:                                         'phone' => $user['phone'],
82:                                         'date' => $endTime
83:                                     ]
84:                                 ]);
85:                                 continue;
86:                             }
87:                         }
88:                         $cache->set($cacheKey, 1, 3600 * 24 * 2);
89:                     }
90:                     usleep(200);
91:                 });
92:                 $cache->set($checkKey, 1, 3600 * 24 * 1);
93:             }
94:         });
95:     }
96: }
</file>

