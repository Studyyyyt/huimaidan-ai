 16: 
 17: /**
 18:  * 小程序发货信息管理事件
 19:  * Class MiniOrderShippingListen
 20:  * @author yyw @date 2023/10/19
 21:  */
 22: class MiniOrderShippingListen implements ListenerInterface
 23: {
 24:     public function handle($event): void
 25:     {
 26:         [$order_type, $order, $delivery_type, $delivery_id, $delivery_name] = $event;
 27:         $order_shipping_open = systemConfig('order_shipping_open', 0);  // 小程序发货信息管理服务开关
 28:         if (empty($order) || !$order_shipping_open) {
 29:             return;
 30:         }
 31:         try {
 32:             $this->pushDeliveryMiniOrder($order_type, $order, $delivery_type, $delivery_id, $delivery_name);
 33:         } catch (\Exception $exception) {
 34:             Log::error([
 35:                 'title' => '小程序发发货管理异常',
 36:                 'message' => $exception->getMessage(),
 37:                 'file' => $exception->getFile(),
 38:                 'line' => $exception->getLine()
 39:             ]);
 40:         }
 41:     }
 42: 
 43:     public function pushDeliveryMiniOrder($order_type, $order, $delivery_type = 1, $delivery_id = '', $delivery_name = '')
 44:     {
 45:         $secs = 0;
 46:         //判断订单是否拆单
 47:         $delivery_mode = 1;
 48:         $is_all_delivered = true;
 49: 
 50:         switch ($order_type) {
 51:             case 'product':
 52:                 $order_id = (int)$order['order_id'];
 53:                 if ($order['pay_type'] != 2 && $order['pay_price'] <= 0) {
 54:                     return false;
 55:                 }
 56:                 $item_desc = '订单支付';
 57:                 $storeGroupOrderRepository = app()->make(StoreGroupOrderRepository::class);
 58:                 // 产找group 订单
 59:                 $group_order_info = $storeGroupOrderRepository->get($order['group_order_id']);
 60:                 if (empty($group_order_info)) {
 61:                     throw new ValidateException('用户订单异常');
 62:                 }
 63: 
 64:                 $order_sn = $group_order_info['group_order_sn'];
 65: 
 66:                 // 判断是不是拆单发货
 67:                 /** @var StoreOrderRepository $orderServices */
 68:                 $orderServices = app()->make(StoreOrderRepository::class);
 69:                 $order_son_count = $orderServices->query(['group_order_id' => $order['group_order_id'], 'status' => 0])->count();
 70:                 if ($order_son_count > 1) {
 71:                     $delivery_mode = 2;
 72:                     $is_all_delivered = $orderServices->checkSubOrderNotSend((int)$order['group_order_id'], $order_id);
 73:                 }
 74:                 $order_key = [
 75:                     'out_trade_no' => $order_sn
 76:                 ];
 77: 
 78:                 if ($order['order_type'] == 1) {
 79:                     $secs = 60;
 80:                 }
 81:                 if ($order['activity_type'] == 20) {    // 积分商品
 82:                     $path = '/pages/points_mall/integral_order_details?order_id=' . $order_id;
 83:                 } else {
 84:                     $path = '/pages/order_details/index?order_id=' . $order_id;
 85:                 }
 86:                 break;
 87:             case 'recharge':
 88:                 if ($order['recharge_type'] != 'routine' && $order['price'] <= 0) {   // 不是小程序订单终止
 89:                     return false;
 90:                 }
 91:                 $order_id = $order['order_id'];
 92:                 $delivery_type = 3;
 93:                 $item_desc = '用户充值' . $order['price'];
 94:                 $order_key = [
 95:                     'out_trade_no' => $order_id
 96:                 ];
 97:                 $secs = 60;
 98:                 $path = '/pages/users/user_bill/index';
 99:                 break;
100:             case 'member':
101:                 if ($order['pay_type'] != 'routine' && $order['pay_price'] <= 0) {
102:                     return false;
103:                 }
104:                 $order_id = $order['order_sn'];
105:                 $delivery_type = 3;
106:                 $item_desc = '用户购买' . $order['member_type'] . '会员卡';
107:                 $order_key = [
108:                     'out_trade_no' => $order_id
109:                 ];
110:                 $secs = 60;
111:                 $path = '/pages/annex/vip_center/index';
112:                 break;
113:             default:
114:                 throw new ValidateException('订单类型异常');
115:         }
116: 
117:         // 整理商品信息
118:         $logistics_type = $this->getLogisticsType($delivery_type);
119:         $shipping_list = $this->getShippingList($logistics_type, $item_desc, $order['user_phone'] ?? '', $delivery_id, $delivery_name);
120:         //查找支付者openid
121:         $payer_openid = $this->getPayerOpenid($order['uid']);
122:         $queue_param = compact('order_key', 'logistics_type', 'shipping_list', 'payer_openid', 'path', 'delivery_mode', 'is_all_delivered');
123: 
124: //        MiniProgramService::create()->uploadShippingInfo($order_key, $logistics_type, $shipping_list, $payer_openid, $path, $delivery_mode, $is_all_delivered);
125:         if ($secs) {
126:             Queue::later($secs, MiniOrderShippingJob::class, $queue_param);
127:         } else {
128:             Queue::push(MiniOrderShippingJob::class, $queue_param);
129:         }
130:     }
131: 
132:     /**
133:      * 转换发货类型
134:      * @param string $delivery_type
135:      * @return int
136:      *
137:      * @date 2023/10/18
138:      * @author yyw
139:      */
140:     public function getLogisticsType(string $delivery_type)
141:     {
142: 
143:         switch ($delivery_type) {
144:             case OrderStatus::DELIVER_TYPE_SHIPPING:   // 发货
145:             case OrderStatus::DELIVER_TYPE_DUMP:   //电子面单
146:             case OrderStatus::DELIVER_TYPE_SHIP_MENT:   //商家寄件
147:                 $logistics_type = 1;
148:                 break;
149:             case OrderStatus::DELIVER_TYPE_SAME_CITY:  // 同城
150:             case OrderStatus::DELIVER_TYPE_DELIVERY:    // 送货
151:                 $logistics_type = 2;
152:                 break;
153:             case OrderStatus::DELIVER_TYPE_VIRTUAL:    // 虚拟
154:             case OrderStatus::DELIVER_TYPE_CARD_KEY:    // 卡密
155:                 $logistics_type = 3;
156:                 break;
157:             case OrderStatus::DELIVER_TYPE_VERIFY:    // 自提
158:                 $logistics_type = 4;
159:                 break;
160:             default:
161:                 throw new ValidateException('发货类型异常');
162:         }
163: 
164:         return $logistics_type;
165:     }
166: 
167:     /**
168:      * 获取商品发货信息
169:      * @param string $logistics_type
170:      * @param string $receiver_contact
171:      * @param string $delivery_id
172:      * @param string $delivery_name
173:      * @return array|array[]
174:      *
175:      * @date 2023/10/18
176:      * @author yyw
177:      */
178:     public function getShippingList(string $logistics_type, string $item_desc, string $receiver_contact = '', string $delivery_id = '', string $delivery_name = '')
179:     {
180:         if ($logistics_type == 1) {
181:             return [
182:                 [
183:                     'tracking_no' => $delivery_id ?? '',
184:                     'express_company' => $delivery_name ?? '',
185:                     'contact' => [
186:                         'receiver_contact' => $receiver_contact
187:                     ],
188:                     'item_desc' => $item_desc
189:                 ]
190:             ];
191:         } else {
192:             return [
193:                 ['item_desc' => $item_desc]
194:             ];
195:         }
196:     }
197: 
198:     /**
199:      * 获取支付者openid
200:      * @param int $uid
201:      * @return mixed
202:      * @throws \think\db\exception\DataNotFoundException
203:      * @throws \think\db\exception\DbException
204:      * @throws \think\db\exception\ModelNotFoundException
205:      *
206:      * @date 2023/10/18
207:      * @author yyw
208:      */
209:     public function getPayerOpenid(int $uid)
210:     {
211:         $user = app()->make(UserRepository::class)->get($uid);
212:         if (empty($user)) {
213:             throw new ValidateException('用户异常');
214:         }
215:         $wechatUser = app()->make(WechatUserRepository::class)->get($user['wechat_user_id']);
216:         if (empty($wechatUser)) {
217:             throw new ValidateException('微信用户异常');
218:         }
219:         if (empty($wechatUser['routine_openid'])) {
220:             throw new ValidateException('订单支付者不是小程序');
221:         }
222: 
223:         return $wechatUser['routine_openid'];
224:     }
225: }
