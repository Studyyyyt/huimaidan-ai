 32: class SwooleTaskListen implements ListenerInterface
 33: {
 34:     /**
 35:      * @var Task
 36:      */
 37:     protected $task;
 38: 
 39:     public function handle($task): void
 40:     {
 41:         request()->clearCache();
 42:         $this->task = $task;
 43:         if (method_exists($this, $task->data['type']))
 44:             $this->{$task->data['type']}($task->data['data']);
 45:     }
 46: 
 47:     public function message(array $data)
 48:     {
 49:         $server = app()->make(Server::class);
 50:         $uid = is_array($data['uid']) ? $data['uid'] : [$data['uid']];
 51:         $except = $data['except'] ?? [];
 52:         if (!count($uid) && $data['type'] != 'user') {
 53:             $fds = $data['type'] == 'mer' ? Manager::merFd($data['mer_id'] ?? 0) : Manager::userFd(0);
 54:             foreach ($fds as $fd) {
 55:                 if (!in_array($fd, $except) && $server->isEstablished($fd) && $server->exist($fd))
 56:                     $server->push((int)$fd, json_encode($data['data']));
 57:             }
 58:         } else {
 59:             foreach ($uid as $id) {
 60:                 $fds = Manager::userFd(array_search($data['type'], Manager::USER_TYPE), $id);
 61:                 foreach ($fds as $fd) {
 62:                     if (!in_array($fd, $except) && $server->isEstablished($fd) && $server->exist($fd))
 63:                         $server->push((int)$fd, json_encode($data['data']));
 64:                 }
 65:             }
 66:         }
 67:     }
 68: 
 69:     /**
 70:      * //TODO 用户给客服发送消息
 71:      *
 72:      * @param array $data
 73:      * @author xaboy
 74:      * @day 2020/6/15
 75:      */
 76:     public function chatToService(array $data)
 77:     {
 78:         $flag = UserHandler::serviceOnline($data['uid'], $data['data']['uid']);
 79:         $serviceLogRepository = app()->make(StoreServiceLogRepository::class);
 80:         $lst = Cache::sMembers('m_chat' . $data['uid']) ?: [];
 81:         $server = app()->make(Server::class);
 82:         foreach ($lst as $item) {
 83:             [$fd, $merId, $toUid] = explode('/', $item);
 84:             if (!in_array($fd, $data['except'] ?? []) && $server->isEstablished($fd) && $server->exist($fd)) {
 85:                 $data['data']['is_get'] = 1;
 86:                 $server->push((int)$fd, json_encode(['type' => $toUid == $data['data']['uid'] ? 'chat' : 'back_chat', 'data' => $data['data']]));
 87:             }
 88:         }
 89:         if (!$flag) {
 90:             //TODO 客服消息提醒
 91:             $nickname = app()->make(UserRepository::class)->getUsername($data['data']['uid']);
 92:             Queue::push(SendNewsJob::class, [
 93:                 $data['uid'],
 94:                 [
 95:                     'title' => '收到用户【' . $nickname . '】的咨询消息，请及时查看',
 96:                     'description' => $data['data'],
 97:                     'url' => rtrim(systemConfig('site_url'), '/') . '/pages/chat/customer_list/chat?userId=' . $data['data']['uid'] . '&mer_id=' . $data['data']['mer_id'],
 98:                     'image' => rtrim(systemConfig('site_url'), '/') . '/static/service_wechat_msg.jpg'
 99:                 ]
100:             ]);
101:             //TODO 客服消息提醒
102: //            $user = app()->make(UserRepository::class)->get($data['data']['uid']);
103: //            $params = [
104: //                'mer_id' => $data['data']['mer_id'],
105: //                'keyword1' => date('Y-m-d H:i:s',time()),
106: //                'keyword2' => $data['data']['msn'],
107: //                'url' => '/pages/chat/customer_list/chat?userId=' . $data['data']['uid'] . '&mer_id=' . $data['data']['mer_id']
108: //            ];
109: //            Queue::push(SendSmsJob::class, ['tempId' => 'SERVER_NOTICE', 'id' => $data['uid'], 'params' => $params]);
110:         }else{
111:             $serviceLogRepository->serviceRead($data['data']['mer_id'], $data['data']['uid'], $data['data']['service_id']);
112:             app()->make(StoreServiceUserRepository::class)->read($data['data']['mer_id'], $data['data']['uid'], true);
113:         }
114:         if ($data['data']['msn_type'] === 1) {
115:             $serviceLogRepository = app()->make(StoreServiceLogRepository::class);
116:             $reply = app()->make(StoreServiceReplyRepository::class)->keywordByValidData($data['data']['msn'], $data['data']['mer_id']);
117:             if ($reply) {
118:                 $log = null;
119:                 if (($reply->type === 2 || $reply->type === 1) && $reply['content']) {
120:                     $log = $serviceLogRepository->create([
121:                         'mer_id' => $data['data']['mer_id'],
122:                         'msn' => $reply['content'],
123:                         'uid' => $data['data']['uid'],
124:                         'service_id' => $data['data']['service_id'],
125:                         'remind' => 1,
126:                         'send_type' => 1,
127:                         'msn_type' => $reply->type === 2 ? 3 : 1,
128:                         'type' => 1,
129:                         'service_type' => 0,
130:                     ]);
131:                 }
132:                 if ($log) {
133:                     $lst = Cache::sMembers('u_chat' . $data['data']['uid']) ?: [];
134:                     $log->append(['service']);
135:                     $server = app()->make(Server::class);
136:                     foreach ($lst as $item) {
137:                         [$fd, $merId] = explode('/', $item);
138:                         if ($server->isEstablished($fd) && $server->exist($fd) && $merId == $data['data']['mer_id']) {
139:                             $server->push((int)$fd, json_encode(['type' => 'chat', 'data' => $log->toArray()]));
140:                         }
141:                     }
142:                     $lst = Cache::sMembers('m_chat' . $log->service->uid) ?: [];
143:                     $server = app()->make(Server::class);
144:                     foreach ($lst as $item) {
145:                         [$fd, $merId, $toUid] = explode('/', $item);
146:                         if ($server->isEstablished($fd) && $server->exist($fd) && $toUid == $data['data']['uid']) {
147:                             $server->push((int)$fd, json_encode(['type' => 'chat', 'data' => $log->toArray()]));
148:                         }
149:                     }
150:                 }
151:             }
152:         }
153:     }
154: 
155:     /**
156:      * //TODO 客服给用户发送消息
157:      * @param array $data
158:      * @author xaboy
159:      * @day 2020/6/15
160:      */
161:     public function chatToUser(array $data)
162:     {
163:         $flag = UserHandler::userOnline($data['uid'], $data['data']['mer_id']);
164:         if ($flag) {
165:             $serviceLogRepository = app()->make(StoreServiceLogRepository::class);
166:             $lst = Cache::sMembers('u_chat' . $data['uid']) ?: [];
167:             $server = app()->make(Server::class);
168:             foreach ($lst as $item) {
169:                 [$fd, $merId] = explode('/', $item);
170:                 if (!in_array($fd, $data['except'] ?? []) && $server->isEstablished($fd) && $server->exist($fd) && $merId == $data['data']['mer_id']) {
171:                     $data['data']['is_get'] = 1;
172:                     $server->push((int)$fd, json_encode(['type' => 'chat', 'data' => $data['data']]));
173:                 }
174:             }
175:             $serviceLogRepository->userRead($data['data']['mer_id'], $data['data']['uid']);
176:             app()->make(StoreServiceUserRepository::class)->read($data['data']['mer_id'], $data['data']['uid']);
177:         } else {
178:             //TODO 用户消息提醒
179:             Queue::push(SendNewsJob::class, [
180:                 $data['uid'],
181:                 [
182:                     'title' => '您收到新的消息，请及时查看',
183:                     'description' => $data['data'],
184:                     'url' => rtrim(systemConfig('site_url'), '/') . '/pages/chat/customer_list/chat?mer_id=' . $data['data']['mer_id'],
185:                     'image' => rtrim(systemConfig('site_url'), '/') . '/static/service_wechat_msg.jpg'
186:                 ]
187:             ]);
188:             //TODO 客服给用户发送消息
189: //            $params = [
190: //                'mer_id' => $data['data']['mer_id'],
191: //                'keyword1' =>  date('Y-m-d H:i:s', time()),
192: //                'keyword2' =>  $data['data']['msn'],
193: //                'url' =>   '/pages/chat/customer_list/chat?mer_id=' . $data['data']['mer_id']
194: //            ];
195: //            Queue::push(SendSmsJob::class, ['id' => $data['uid'], 'tempId' => 'SERVER_NOTICE', 'params' => $params]);
196:         }
197:     }
198: 
199:     public function admin(array $data)
200:     {
201:         $this->message([
202:                 'uid' => $data['uid'] ?? [],
203:                 'type' => 'admin',
204:                 'data' => $data['data']
205:             ]
206:         );
207:     }
208: 
209:     public function merchant(array $data)
