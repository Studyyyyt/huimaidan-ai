18: use app\common\repositories\store\broadcast\BroadcastRoomRepository;
19: use crmeb\interfaces\ListenerInterface;
20: use crmeb\services\TimerService;
21: use Swoole\Timer;
22: use think\facade\Cache;
23: use think\facade\Log;
24: 
25: class SyncBroadcastStatusListen extends TimerService implements ListenerInterface
26: {
27: 
28:     public function handle($event): void
29:     {
30:         $this->tick(1000 * 60 * 5, function () {
31:             $broadcastGoodsRepository = app()->make(BroadcastGoodsRepository::class);
32:             try {
33:                 $broadcastGoodsRepository->syncGoodStatus();
34:             } catch (\Exception $e) {
35:                 Log::error('同步直播商品:' . $e->getMessage());
36:             }
37:         });
38: 
39:         $this->tick(1000 * 60 * 5, function () {
40:             if (Cache::has('_sys_break_b_room')) {
41:                 return;
42:             }
43:             $broadcastRoomRepository = app()->make(BroadcastRoomRepository::class);
44:             try {
45:                 $broadcastRoomRepository->syncRoomStatus();
46:             } catch (\Exception $e) {
47:                 if ($e instanceof \EasyWeChat\Core\Exceptions\HttpException && $e->getCode() == '48001') {
48:                     Cache::set('_sys_break_b_room', 1, 3600);
49:                 }
50:                 Log::error('同步直播间:' . $e->getMessage());
51:             }
52:         });
53:     }
54: }
