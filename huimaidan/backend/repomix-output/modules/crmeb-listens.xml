21: class AutoUpDownShelvesListen extends TimerService implements ListenerInterface
22: {
23: 
24:     /**
25:      * 自动上下架
26:      * @param $event
27:      * @return void
28:      * @author FerryZhao
29:      * @day 2024/4/3
30:      */
31:     public function handle($event): void
32:     {
33:         $this->tick(1000 * 5, function () {
34:             try {
35:                 $today = strtotime("today");
36:                 $time = time() + 60;
37:                 $redis = app()->make(RedisCacheService::class);
38:                 $status = Cache::get(ProductRepository::AUTO_TIME_STATUS);
39:                 $productRepository = app()->make(ProductRepository::class);
40:                 if ($status) {
41:                     $times = $redis->zRangeByScore(ProductRepository::AUTO_PREFIX_SET.ProductRepository::AUTO_ON_TIME,$today,$time);
42:                     if ($times) {
43:                         $productUpIds = $productRepository->autoSwitchShow($times,ProductRepository::AUTO_ON_TIME);
44:                         Log::info('自动上架商品：'.$productUpIds);
45:                     }
46:                     $times = $redis->zRangeByScore(ProductRepository::AUTO_PREFIX_SET.ProductRepository::AUTO_OFF_TIME,$today,$time);
47:                     if ($times) {
48:                         $productDownIds = $productRepository->autoSwitchShow($times,ProductRepository::AUTO_OFF_TIME);
49:                         Log::info('自动下架商品：'.$productDownIds);
50:                     }
51:                 } else {
52:                     $productUpIds = $productRepository->getSearch([])
53:                         ->whereNotNull('auto_on_time')
54:                         ->where([
55:                             ['is_show', '=', 2],
56:                         ])->column('auto_on_time','product_id');
57: 
58:                     $productRepository->bathAutoOntime($productUpIds,$productRepository::AUTO_ON_TIME);
59:                     $productDownIds = $productRepository->getSearch([])
60:                         ->whereNotNull('auto_off_time')
61:                         ->where([
62:                             ['is_show', '=', 1],
63:                             ['auto_off_time', '<>', 0],
64:                             ['auto_off_time', '<=', time()],
65:                         ])
66:                         ->column('product_id','auto_off_time');
67:                     $productRepository->bathAutoOntime($productDownIds,$productRepository::AUTO_OFF_TIME);
68:                     Cache::set(ProductRepository::AUTO_TIME_STATUS,1);
69:                 }
70:             } catch (\Exception $e) {
71:                 Log::error('商品自动上下架失败' . var_export($e, true));
72:             }
73:         });
74:     }
75: }
</file>

