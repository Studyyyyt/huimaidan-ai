17: use crmeb\services\TimerService;
18: use think\facade\Cache;
19: use think\facade\Log;
20: 
21: class BarCodePayStatusListen extends TimerService implements ListenerInterface
22: {
23:     public function handle($data): void
24:     {
25:         $this->tick(1000 * 3, function () {
26:             try {
27:                 // 从redis中获取数据
28:                 $redisData = Cache::store('redis')->handler()->hGetAll('bar_code_pay');
29:                 if($redisData) {
30:                     Log::info('BarCodePayStatusListen 从redis中获取数据：' . json_encode($redisData));
31:                     foreach($redisData as $key => $value) {
32:                         // 从数据库中获取订单信息
33:                         $groupOrder = app()->make(StoreGroupOrderRepository::class)->getWhere([
34:                             'paid' => 0,
35:                             'is_del' => 0,
36:                             'group_order_sn' => $key
37:                         ]);
38:                         // 如果订单不存在，则删除redis中的数据
39:                         if(!$groupOrder) {
40:                             $redis = Cache::store('redis')->handler();
41:                             $redis->hDel('bar_code_pay', $key);
42:                             continue;
43:                         }
44:                         // 查询支付状态
45:                         $payStatus = (new PayStatusService($value, $groupOrder->getPayParams()))->query();
46:                         // 如果支付成功，则更新订单状态
47:                         if (!empty($payStatus)) {
48:                             app()->make(StoreOrderRepository::class)->paySuccess($groupOrder, 0, $payStatus, 1);
49:                             // 删除redis中的数据
50:                             $redis = Cache::store('redis')->handler();
51:                             $redis->hDel('bar_code_pay', $key);
52:                         }
53:                     }
54:                 }
55:             } catch (\Exception $e) {
56:                 Log::error('BarCodePayStatusListen 订单结果变更错误：' . $e->getMessage());
57:             }
58:         });
59:     }
60: }
