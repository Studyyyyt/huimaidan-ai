 87:     private function displayItem($name, $value)
 88:     {
 89:         if ($value === true) {
 90:             $value = 'true';
 91:         }
 92:         elseif ($value === false) {
 93:             $value = 'false';
 94:         }
 95:         elseif ($value === null) {
 96:             $value = 'null';
 97:         }
 98:         $this->context .= "\e[32m" . str_pad($name, 25, ' ', STR_PAD_RIGHT) .'|    '. "\e[34m" . $value . "\e[0m \n";
 99:         $this->context .= self::LINE;
100:     }
101: 
102:     private function opCacheClear()
103:     {
