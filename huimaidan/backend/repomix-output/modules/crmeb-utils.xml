 12: namespace crmeb\utils;
 13: 
 14: use think\App;
 15: 
 16: /**
 17:  * Start输出类
 18:  * Class Json
 19:  * @package crmeb\utils
 20:  */
 21: class Start
 22: {
 23:     protected $context = '';
 24:     const LINE = '------------------------------------------------'.PHP_EOL;
 25:     public function show()
 26:     {
 27:         $this->opCacheClear();
 28:         $this->context = $this->logo();
 29:         $this->context .= self::LINE;
 30:         $this->displayItem('php      version', phpversion());
 31:         $this->displayItem('swoole   version', phpversion('swoole'));
 32:         $this->displayItem('swoole_loader version', phpversion('swoole_loader'));
 33:         $this->displayItem('thinkphp version', App::VERSION);
 34:         $this->displayItem('crmeb    version', get_code_version());
 35: 
 36:         //http配置
 37:         $httpConf = \config("swoole.server");
 38:         $this->displayItem('http host', $httpConf["host"]);
 39:         $this->displayItem('http port', $httpConf["port"]);
 40:         $this->displayItem('http worker_num', $httpConf['options']["worker_num"]);
 41: 
 42:         //websocket配置
 43:         $this->displayItem('websocket enable', \config("swoole.websocket.enable"));
 44: 
 45:         //rpc配置
 46:         $rpcConf = \config("swoole.rpc.server");
 47:         $this->displayItem('rpc enable', $rpcConf["enable"]);
 48:         if ($rpcConf["enable"]) {
 49:             $this->displayItem('rpc host', $rpcConf["host"]);
 50:             $this->displayItem('rpc port', $rpcConf["port"]);
 51:             $this->displayItem('rpc worker_num', $rpcConf["worker_num"]);
 52:         }
 53: 
 54:         //队列配置
 55:         $this->displayItem('queue enable', \config("swoole.queue.enable"));
 56: 
 57:         //热更新配置
 58:         $this->displayItem('hot_update enable', (bool)\config("swoole.hot_update.enable"));
 59: 
 60:         //debug配置
 61:         $this->displayItem('app_debug enable', (bool)env("APP_DEBUG"));
 62: 
 63:         $this->displayItem('time', date('Y-m-d H:i:s'));
 64:         $this->displayItem('可在命令行执行，查看更多 ','php think cm_cli');
 65: 
 66:         //打印信息
 67:         echo $this->context;
 68:     }
