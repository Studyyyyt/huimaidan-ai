1186: /*
1187:  *  腾讯地图转换百度地图 GCJ02 转 BD09
1188:  * 中国正常GCJ02坐标---->百度地图BD09坐标
1189:  * 腾讯地图/高德地图用的也是GCJ02坐标
1190:  * @param double $lat 纬度
1191:  * @param double $lng 经度
1192:  */
1193: if (!function_exists('gcj02ToBd09')) {
1194:     function gcj02ToBd09($lng, $lat)
1195:     {
1196:         $x_pi = 3.14159265358979324 * 3000.0 / 180.0;
1197:         $x = $lng;
1198:         $y = $lat;
1199:         $z = sqrt($x * $x + $y * $y) - 0.00002 * sin($y * $x_pi);
1200:         $theta = atan2($y, $x) - 0.000003 * cos($x * $x_pi);
1201: 
1202:         $lng = $z * cos($theta) + 0.0065;
1203:         $lat = $z * sin($theta) + 0.006;
1204:         return [$lng,$lat];
1205:     }
1206: }
