 581: if (!function_exists('getDatesBetweenTwoDays')) {
 582:     function getDatesBetweenTwoDays($startDate, $endDate, $md = 'm-d')
 583:     {
 584:         $dates = [];
 585:         if (strtotime($startDate) > strtotime($endDate)) {
 586:             //如果开始日期大于结束日期，直接return 防止下面的循环出现死循环
 587:             return $dates;
 588:         } elseif ($startDate == $endDate) {
 589:             //开始日期与结束日期是同一天时
 590:             array_push($dates, date($md, strtotime($startDate)));
 591:             return $dates;
 592:         } else {
 593:             array_push($dates, date($md, strtotime($startDate)));
 594:             $currentDate = $startDate;
 595:             do {
 596:                 $nextDate = date('Y-m-d', strtotime($currentDate . ' +1 days'));
 597:                 array_push($dates, date($md, strtotime($currentDate . ' +1 days')));
 598:                 $currentDate = $nextDate;
 599:             } while ($endDate != $currentDate);
 600:             return $dates;
 601:         }
 602:     }
 603: }
