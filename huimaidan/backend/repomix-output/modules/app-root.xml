1515:      * @param $current
1516:      * @param $previous
1517:      * @param $scale
1518:      * @return string
1519:      * @author Qinii
1520:      */
1521:     function growthRate($current, $previous, $scale = 2)
1522:     {
1523:         // 转为字符串，避免浮点数精度问题
1524:         $current = (string)$current;
1525:         $previous = (string)$previous;
1526: 
1527:         if (bccomp($previous, '0', $scale) === 0) {
1528:             // 上期为0的情况处理
1529:             return bccomp($current, '0', $scale) === 1 ? '100.00' : '0.00';
1530:         }
1531: 
1532:         // 计算增长额
1533:         $growth = bcsub($current, $previous, $scale + 2);
1534: 
1535:         // 计算增长率
1536:         $rate = bcdiv($growth, $previous, $scale + 4);
1537:         $percentage = bcmul($rate, '100', $scale);
1538:         return $percentage;
1539:     }
1540: }
