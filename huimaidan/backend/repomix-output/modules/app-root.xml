22: use think\exception\ValidateException;
23: use think\Response;
24: use Throwable;
25: 
26: /**
27:  * 应用异常处理类
28:  */
29: class ExceptionHandle extends Handle
30: {
31:     /**
32:      * 不需要记录信息（日志）的异常类列表
33:      * @var array
34:      */
35:     protected $ignoreReport = [
36:         HttpException::class,
37:         HttpResponseException::class,
38:         ModelNotFoundException::class,
39:         DataNotFoundException::class,
40:         ValidateException::class,
41:     ];
42: 
43:     /**
44:      * 记录异常信息（包括日志或者其它方式记录）
45:      *
46:      * @access public
47:      * @param Throwable $exception
48:      * @return void
49:      */
50:     public function report(Throwable $exception): void
51:     {
52:         // 使用内置的方式记录异常日志
53:         parent::report($exception);
54:     }
55: 
56:     /**
57:      * Render an exception into an HTTP response.
58:      *
59:      * @access public
60:      * @param \think\Request $request
61:      * @param Throwable $e
62:      * @return Response
63:      */
64:     public function render($request, Throwable $e): Response
65:     {
66:         // 添加自定义异常处理机制
67:         $this->report($e);
68:         // 其他错误交给系统处理
69:         if ($e instanceof ValidateException)
70:             return app('json')->fail($e->getMessage());
71:         else if ($e instanceof DataNotFoundException)
72:             return app('json')->fail(isDebug() ? $e->getMessage() : '数据不存在');
73:         else if ($e instanceof ModelNotFoundException)
74:             return app('json')->fail(isDebug() ? $e->getMessage() : '数据不存在');
75:         else if ($e instanceof PDOException)
76:             return app('json')->fail(isDebug() ? $e->getMessage() : '数据库操作失败', isDebug() ? $e->getData() : []);
77:         else if ($e instanceof ErrorException)
78:             return app('json')->fail(isDebug() ? $e->getMessage() : '系统错误', isDebug() ? $e->getData() : []);
79:         else if ($e instanceof \PDOException)
80:             return app('json')->fail(isDebug() ? $e->getMessage() : '数据库连接失败');
81:         else if ($e instanceof \EasyWeChat\Core\Exceptions\HttpException)
82:             return app('json')->fail($e->getMessage());
83: 
84:         return parent::render($request, $e);
85:     }
86: }
