1613:                 for ($i = 29; $i >= 0; $i--) {
1614:                     $timestamp = strtotime("-$i days");
1615:                     $dates[] = date($format, $timestamp);
1616:                 }
1617:                 break;
1618: 
1619:             default:
1620:                 $dates = [];
1621:                 $customDate  = explode('-', $date);
1622:                 $customFormat = $format;
1623:                 if (count($customDate) !== 2) {
1624:                     // 默认返回最近7天
1625:                     for ($i = 6; $i >= 0; $i--) {
1626:                         $timestamp = strtotime("-$i days");
1627:                         $dates[] = date($format, $timestamp);
1628:                     }
1629:                 } else {
1630:                     // 自定义日期范围，例如：2023/12/01-2024-12-07,如果区间小于30天则按天返回;大于小于一年则按月返回;大于一年则按年返回
1631:                     $startDate = strtotime($customDate[0]);
1632:                     $endDate   = strtotime($customDate[1]);
1633:                     $diffDays = abs(($endDate - $startDate) / 86400); // 计算天数差
1634:                     if ($diffDays <= 30) {
1635:                         // 按天返回
1636:                         while ($startDate <= $endDate) {
1637:                             $dates[] = date($format, $startDate);
1638:                             $startDate += 86400; // 加一天的时间戳
1639:                         }
1640:                         $customFormat = '%m-%d';
1641:                     } elseif (date('Y', $startDate) === date('Y', $endDate)) {
1642:                         // 按月返回
1643:                         for ($month = date('m', $startDate); $month <= date('m', $endDate); $month++) {
1644:                             $timestamp = strtotime(date('Y-') . sprintf('%02d', $month) . '-01');
1645:                             $dates[] = date(sprintf('%02d', $month) , $timestamp);
1646:                         }
1647:                         $customFormat = '%m';
1648:                     } else {
1649:                         // 按年返回
1650:                         for ($year = date('Y', $startDate); $year <= date('Y', $endDate); $year++) {
1651:                             $timestamp = strtotime($year . '-01-01');
1652:                             $dates[] = date('Y', $timestamp);
1653:                         }
1654:                         $customFormat = '%Y';
1655:                     }
1656: 
1657:                 }
1658:                 break;
1659:         }
1660: 
1661:         return [$dates, $customFormat];
1662:     }
1663: }
1664: 
1665: if (!function_exists('getWhereParams')) {
1666: 
1667:     /**
1668:      * 安全获取 $where 参数（支持类型验证 + 默认值 + 零值有效）
1669:      * @param array  $where   请求参数数组
1670:      * @param string $key     键名
1671:      * @param mixed  $default 默认值（默认 null）
1672:      * @param string $type    验证类型：string|int|float|bool|array|numeric|json|in:1,2,3
1673:      * @return mixed
1674:      */
1675:     function getWhereParams($where, $key, $default = '', $type = 'string')
1676:     {
1677:         if (!isset($where[$key])) {
1678:             return $default;
1679:         }
1680:         $value = $where[$key];
1681:         switch ($type) {
1682:             case 'string':
1683:                 return is_string($value) ? trim($value) : ($value === '' ? '' : $default);
1684: 
1685:             case 'int':
1686:                 return filter_var($value, FILTER_VALIDATE_INT) !== false ? (int)$value : $default;
1687: 
1688:             case 'float':
1689:                 return filter_var($value, FILTER_VALIDATE_FLOAT) !== false ? (float)$value : $default;
1690: 
1691:             case 'numeric':
1692:                 return is_numeric($value) ? $value : $default;
1693: 
1694:             case 'bool':
1695:                 return filter_var($value, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE) ?? $default;
1696: 
1697:             case 'array':
1698:                 return is_array($value) ? $value : (is_string($value) && $value !== '' ? explode(',', $value) : $default);
1699: 
1700:             case 'json':
1701:                 if (is_string($value) && ($json = json_decode($value, true)) !== null) {
1702:                     return $json;
1703:                 }
1704:                 return $default;
1705: 
1706:             default:
1707:                 // 支持 in:1,2,3 格式
1708:                 if (strpos($type, 'in:') === 0) {
1709:                     $allow = explode(',', substr($type, 3));
1710:                     $allow = array_map('trim', $allow);
1711:                     return in_array($value, $allow, true) ? $value : $default;
1712:                 }
1713:                 return $value; // 默认返回原值
1714:         }
1715:     }
1716: }
