 324: /**
 325:  * 通过传入时间，获取到对应的环比时间
 326:  * @param $section
 327:  * @return void
 328:  * @author Qinii
 329:  */
 330: if (!function_exists('momTime')) {
 331:     function momTime(BaseQuery $model, string $section, $prefix = 'create_time', $field = '-')
 332:     {
 333:         switch ($section) {
 334:             case 'today':
 335:                 $model->whereDay($prefix, 'yesterday');
 336:                 break;
 337:             case 'week':
 338:                 $model->whereWeek($prefix, 'last week');
 339:                 break;
 340:             case 'month':
 341:                 $model->whereMonth($prefix, 'last month');
 342:                 break;
 343:             case 'year':
 344:                 $model->whereYear($prefix, 'last year');
 345:                 break;
 346:             case 'yesterday':
 347:                 $yesterday = date('Y-m-d', strtotime('-2 day'));
 348:                 $model->whereDay($prefix, $yesterday);
 349:                 break;
 350:             case 'quarter':
 351:                 //获取上季度开始时间
 352:                 list($startTime, $endTime) = getMonth($section, -1);
 353:                 $model = $model->whereBetweenTime($prefix, $startTime , $endTime);
 354:                 break;
 355:             case 'lately7':
 356:                 $model = $model->whereBetweenTime($prefix, date('Y-m-d H:i:s', strtotime("-14 day")), date('Y-m-d H:i:s',
 357:                     strtotime("-7 day")));
 358:                 break;
 359:             case 'lately30':
 360:                 $model = $model->whereBetweenTime($prefix,date('Y-m-d H:i:s', strtotime("-60 day")), date('Y-m-d H:i:s',
 361:                     strtotime("-30 day")));
 362:                 break;
 363:             default:
 364:                 // 单日 → 上周同期
 365:                 //1周内 → 上月同期
 366:                 //1月内 → 上季度同期
 367:                 //超过1月 → 去年同期
 368:                 if (strstr($section, $field) !== false) {
 369:                     list($startTime, $endTime) = explode($field, $section);
 370:                     // 计算时间跨度（天数）
 371:                     $daysDiff = (strtotime($endTime) - strtotime($startTime)) / 86400 + 1;
 372:                     // 根据时间跨度选择环比周期
 373:                     if ($daysDiff == 1) {
 374:                         // 单日：按周环比（上周同一天）
 375:                         $interval = '-1 week';
 376:                     } else if ($daysDiff <= 7) {
 377:                         // 1周内：按月环比（上月同期）
 378:                         $interval = '-1 month';
 379:                     } else if ($daysDiff <= 30) {
 380:                         // 1月内：按季度环比（上季度同期）
 381:                         $interval = '-3 month';
 382:                     } else {
 383:                         // 超过1月：按年环比（去年同期）
 384:                         $interval = '-1 year';
 385:                     }
 386:                     $compareStart = date('Y-m-d H:i:s', strtotime($startTime . $interval));
 387:                     $compareEnd = date('Y-m-d H:i:s', strtotime($endTime . $interval));
 388: 
 389:                     $model->whereBetweenTime($prefix, $compareStart, $compareEnd);
 390:                 }
 391:                 break;
 392:         }
 393:     }
 394: }
