 398:     function hasMany($collection, $field, $model, $searchKey, $insertKey, $where = [] ,$select = '*')
 399:     {
 400:         $ids = [];
 401:         $link = [];
 402: 
 403:         if (!$collection) return [];
 404:         $collection = $collection->toArray();
 405:         foreach ($collection as $k => $item) {
 406:             if (is_array($item[$field])) {
 407:                 $link[$k] = array_unique($item[$field]);
 408:                 $ids = array_merge($item[$field], $ids);
 409:             } else {
 410:                 $link[$k] = array_unique(explode(',', $item[$field]));
 411:             }
 412:             $ids = array_merge($link[$k], $ids);
 413:             if (isset($collection[$k][$insertKey])) unset($collection[$k][$insertKey]);
 414:         }
 415:         $ids = array_filter(array_unique($ids));
 416:         if (!count($ids)) {
 417:             return $collection;
 418:         }
 419:         $many = $model::whereIn($searchKey, array_unique($ids))->where($where)->field($select)->select();
 420: 
 421:         if (!$many) return $collection;
 422:         $many = $many->toArray();
 423:         foreach ($link as $k => $val) {
 424:             foreach ($many as $item) {
 425:                 if (in_array($item[$searchKey], $val)) {
 426: 
 427:                     if (!isset($collection[$k][$insertKey])) $collection[$k][$insertKey] = [];
 428: 
 429:                     $collection[$k][$insertKey][] = $item;
 430:                 }
 431:             }
 432:         }
 433: 
 434:         return $collection;
 435:     }
