 212: if (!function_exists('getMonth')) {
 213:     /**
 214:      * 获取本季度 time
 215:      * @param int|string $time
 216:      * @param int $offset 0:当前时间，-1:上一个季度，1:下一个季度
 217:      * @param $ceil
 218:      * @return array
 219:      */
 220:     function getMonth($time = null, $offset = 0)
 221:     {
 222:         // 处理时间参数
 223:         if ($time === null) {
 224:             $timestamp = time();
 225:         } elseif (is_numeric($time)) {
 226:             $timestamp = (int)$time;
 227:         } else {
 228:             $timestamp = strtotime($time);
 229:         }
 230: 
 231:         // 获取当前月份和年份
 232:         $currentMonth = (int)date('n', $timestamp);
 233:         $currentYear = (int)date('Y', $timestamp);
 234:         // 计算当前季度 (1-4)
 235:         $currentQuarter = (int)ceil($currentMonth / 3);
 236: 
 237:         // 应用偏移量
 238:         $targetQuarter = $currentQuarter + $offset;
 239:         $targetYear = $currentYear;
 240: 
 241:         // 处理跨年的情况
 242:         if ($targetQuarter > 4) {
 243:             $targetQuarter -= 4;
 244:             $targetYear += 1;
 245:         } elseif ($targetQuarter < 1) {
 246:             $targetQuarter += 4;
 247:             $targetYear -= 1;
 248:         }
 249:         // 计算季度的首月和末月
 250:         $firstMonth = ($targetQuarter - 1) * 3 + 1;
 251:         $lastMonth = $targetQuarter * 3;
 252: 
 253:         // 生成季度的首日和末日
 254:         $firstDay = date('Y-m-01', mktime(0, 0, 0, $firstMonth, 1, $targetYear));
 255:         $lastDay = date('Y-m-t', mktime(0, 0, 0, $lastMonth, 1, $targetYear));
 256: 
 257:         return [$firstDay, $lastDay];
 258:     }
 259: }
