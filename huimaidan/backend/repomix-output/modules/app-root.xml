1474:      * @param string $startTime
1475:      * @param string $endTime
1476:      * @param integer $intervalMinutes
1477:      * @return array
1478:      */
1479:     function generateTimeRanges(string $startTime, string $endTime, int $intervalMinutes = 10) : array
1480:     {
1481:         // 验证时间间隔
1482:         if ($intervalMinutes < 10) {
1483:             throw new \think\exception\ValidateException('时间间隔必须大于等于10分钟');
1484:         }
1485:         // 转换起止时间为时间戳
1486:         $startTimestamp = strtotime($startTime);
1487:         $endTimestamp = strtotime($endTime);
1488:         if ($startTimestamp >= $endTimestamp) {
1489:             throw new \think\exception\ValidateException('起始时间必须小于结束时间');
1490:         }
1491:         // 时间间隔转换为秒
1492:         $intervalSeconds = $intervalMinutes * 60;
1493:         // 初始化时间段数组,生成时间段
1494:         $timeRanges = [];
1495:         for ($current = $startTimestamp; $current < $endTimestamp; $current += $intervalSeconds) {
1496:              // 下一个时间段的开始时间
1497:             $next = $current + $intervalSeconds;
1498:             // 处理最后一个时间段
1499:             if ($next > $endTimestamp) {
1500:                 $next = $endTimestamp;
1501:             }
1502:             // 添加时间段到数组中
1503:             $timeRanges[] = [
1504:                 'start' => date('H:i', $current),
1505:                 'end' => date('H:i', $next)
1506:             ];
1507:         }
1508:         return $timeRanges;
1509:     }
1510: }
