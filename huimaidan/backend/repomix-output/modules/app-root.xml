1428: if (!function_exists('filter_str')) {
1429:     /**
1430:      * 过滤字符串敏感字符
1431:      * @param $str
1432:      * @return array|mixed|string|string[]|null
1433:      */
1434:     function filter_str($str)
1435:     {
1436:         $rules = [
1437:             '/\.\./', // 禁用包含 ../ 的参数
1438:             '/\<\?/', // 禁止 php 脚本出现
1439:             '/\bor\b.*=.*/i', // 匹配 'or 1=1'，防止 SQL 注入（注意边界词 \b 和不区分大小写 i 修饰符）
1440:             '/(select[\s\S]*?)(from|limit)/i', // 防止 SQL 注入
1441:             '/(union[\s\S]*?select)/i', // 防止 SQL 注入
1442:             '/(having|updatexml|extractvalue)/i', // 防止 SQL 注入
1443:             '/sleep\((\s*)(\d*)(\s*)\)/i', // 防止 SQL 盲注
1444:             '/benchmark\((.*)\,(.*)\)/i', // 防止 SQL 盲注
1445:             '/base64_decode\(/i', // 防止 SQL 变种注入
1446:             '/(?:from\W+information_schema\W)/i', // 注意这里的 (?:...) 是不合法的，应该是 (?:...) 表示非捕获组，但通常我们不需要这个
1447:             '/(?:current_|user|database|schema|connection_id)\s*\(/i', // 防止 SQL 注入（注意去掉了不必要的 (?:...)）
1448:             '/(?:etc\/\W*passwd)/i', // 防止窥探 Linux 用户信息
1449:             '/into(\s+)(?:dump|out)file\s*/i', // 禁用 MySQL 导出函数
1450:             '/group\s+by.+\(/i', // 防止 SQL 注入
1451:             '/(?:define|eval|file_get_contents|include|require|require_once|shell_exec|phpinfo|system|passthru|preg_\w+|execute|echo|print|print_r|var_dump|(fp)open|alert|showmodaldialog)\(/i', // 禁用 webshell 相关某些函数
1452:             '/(gopher|doc|php|glob|file|phar|zlib|ftp|ldap|dict|ogg|data)\:\/\//i', // 防止一些协议攻击（注意协议后的三个斜杠）
1453:             '/\$_(GET|POST|COOKIE|FILES|SESSION|ENV|GLOBALS|SERVER)\[/i', // 禁用一些内置变量，注意 PHP 变量名通常是大写的
1454:             '/<(iframe|script|body|img|layer|div|meta|style|base|object|input)/i', // 防止 XSS 标签植入
1455:             '/(onmouseover|onerror|onload|onclick)\=/i', // 防止 XSS 事件植入
1456:             '/\|\|.*?(?:ls|pwd|whoami|ll|ifconfig|ipconfig|&&|chmod|cd|mkdir|rmdir|cp|mv)/i', // 防止执行 shell（注意去掉了不合适的 ifconfog）
1457:             '/\sand\s+.*=.*/i' // 匹配 and 1=1
1458:         ];
1459:         if (filter_var($str, FILTER_VALIDATE_URL)) {
1460:             $url = parse_url($str);
1461:             if (!isset($url['scheme'])) return $str;
1462:             $host = $url['scheme'] . '://' . $url['host'];
1463:             $str = $host . preg_replace($rules, '', str_replace($host, '', $str));
1464:         } else {
1465:             $str = preg_replace($rules, '', $str);
1466:         }
1467:         return $str;
1468:     }
1469: }
