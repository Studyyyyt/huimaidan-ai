414:      * @param $key
415:      * @param $method
416:      * @param $config
417:      * @return string
418:      */
419:     public function getSignature($opt, $key, $method, $config)
420:     {
421:         $formatString = $method . $config['domain'] . '/?' . $this->json2str($opt, 1);
422:         $sign = hash_hmac('sha1', $formatString, $key);
423:         $sign = base64_encode($this->_hex2bin($sign));
424:         return $sign;
425:     }
