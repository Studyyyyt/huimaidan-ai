12: 
13: namespace crmeb\services\easywechat\certficates;
14: 
15: 
16: use crmeb\exceptions\WechatException;
17: use crmeb\services\easywechat\BaseClient;
18: use EasyWeChat\Core\AbstractAPI;
19: use think\exception\InvalidArgumentException;
20: use think\facade\Cache;
21: 
22: class Client extends BaseClient
23: {
24:     public function get()
25:     {
26:         $is = $this->isService ? 'service_payment':'payment';
27:         //如果是自动分账 或者 普通支付但是用的是v3支付 获取公钥
28:         if ($this->app['config']['type'] == 'wechat') {
29:             $public_key = $this->app['config'][$is]['pay_weixin_public_key'];
30:         } else {
31:             $public_key = $this->app['config'][$is]['pay_routine_public_key'];
32:         }
33:         if ($public_key && ($this->isService || $this->app['config']['is_v3'])) {
34:             $certficates = [
35:                 'serial_no' => $this->app['config'][$is]['pay_routine_public_key'],
36:                 'certificates' => $this->app['config'][$is]['pay_routine_public_id']
37:             ];
38:             //如果获取公钥成功则返回
39:             if ($certficates['serial_no'] && $certficates['certificates']) {
40:                 return  $certficates;
41:             }
42:         }
43:         // v2支付，或者是未获取到公钥，则平台证书获取操作
44:         $driver = Cache::store('file');
45:         $cacheKey = '_wx_v3' . $this->app['config'][$is]['serial_no'];
46:         if ($driver->has($cacheKey)) {
47:             return $driver->get($cacheKey);
48:         }
49:         $certficates = $this->getCertficates();
50:         $driver->set($cacheKey, $certficates, 3600 * 24 * 30);
51: 
52:         return $certficates;
53:     }
54: 
55:     /**
56:      * get certficates.
57:      *
58:      * @return array
59:      */
60:     public function getCertficates()
61:     {
62:         $response = $this->request('/v3/certificates', 'GET', [], false);
63:         if (isset($response['code']))  throw new WechatException($response['message']);
64:         $certificates = $response['data'][0];
65:         $certificates['certificates'] = $this->decrypt($certificates['encrypt_certificate']);
66:         unset($certificates['encrypt_certificate']);
67:         return $certificates;
68:     }
69: }
</file>

