553:     /**
554:      * 处理签名数据
555:      * @param $method
556:      * @param $headers
557:      * @param $pathArgs
558:      * @param $bucketName
559:      * @param $objectKey
560:      * @param null $expires
561:      * @return string
562:      * @author 等风来
563:      * @email 136327134@qq.com
564:      * @date 2023/5/17
565:      */
566:     public function makeCanonicalstring($method, $headers, $pathArgs, $bucketName, $objectKey, $expires = null)
567:     {
568:         $buffer = [];
569:         $buffer[] = $method;
570:         $buffer[] = "\n";
571:         $interestHeaders = [];
572: 
573:         foreach ($headers as $key => $value) {
574:             $key = strtolower($key);
575:             if (in_array($key, self::INTEREST_HEADER_KEY_LIST) || strpos($key, self::HEADER_PREFIX) === 0) {
576:                 $interestHeaders[$key] = $value;
577:             }
578:         }
579: 
580:         if (array_key_exists(self::ALTERNATIVE_DATE_HEADER, $interestHeaders)) {
581:             $interestHeaders['date'] = '';
582:         }
583: 
584:         if ($expires !== null) {
585:             $interestHeaders['date'] = strval($expires);
586:         }
587: 
588:         if (!array_key_exists('content-type', $interestHeaders)) {
589:             $interestHeaders['content-type'] = '';
590:         }
591: 
592:         if (!array_key_exists('content-md5', $interestHeaders)) {
593:             $interestHeaders['content-md5'] = '';
594:         }
595: 
596:         ksort($interestHeaders);
597: 
598:         foreach ($interestHeaders as $key => $value) {
599:             if (strpos($key, self::HEADER_PREFIX) === 0) {
600:                 $buffer[] = $key . ':' . $value;
601:             } else {
602:                 $buffer[] = $value;
603:             }
604:             $buffer[] = "\n";
605:         }
606: 
607:         $uri = '';
608: 
609:         $bucketName = $this->isCname ? $headers['Host'] : $bucketName;
610: 
611:         if ($bucketName) {
612:             $uri .= '/';
613:             $uri .= $bucketName;
614:             if (!$this->pathStyle) {
615:                 $uri .= '/';
616:             }
617:         }
618: 
619:         if ($objectKey) {
620:             if (!($pos = strripos($uri, '/')) || strlen($uri) - 1 !== $pos) {
621:                 $uri .= '/';
622:             }
623:             $uri .= $objectKey;
624:         }
625: 
626:         $buffer[] = $uri === '' ? '/' : $uri;
627: 
628: 
629:         if (!empty($pathArgs)) {
630:             ksort($pathArgs);
631:             $_pathArgs = [];
632:             foreach ($pathArgs as $key => $value) {
633:                 if (in_array(strtolower($key), self::ALLOWED_RESOURCE_PARAMTER_NAMES) || strpos($key, self::HEADER_PREFIX) === 0) {
634:                     $_pathArgs[] = $value === null || $value === '' ? $key : $key . '=' . urldecode($value);
635:                 }
636:             }
637:             if (!empty($_pathArgs)) {
638:                 $buffer[] = '?';
639:                 $buffer[] = implode('&', $_pathArgs);
640:             }
641:         }
642: 
643:         return implode('', $buffer);
644:     }
