136:     protected function upload(string $file = null, bool $isStream = false, string $fileContent = null)
137:     {
138:         if (!$isStream) {
139:             $fileHandle = app()->request->file($file);
140:             if (!$fileHandle) {
141:                 return $this->setError('上传的文件不存在');
142:             }
143:             if ($this->validate) {
144:                 if (!in_array($fileHandle->getOriginalExtension(), $this->validate['fileExt'])) {
145:                     return $this->setError('不合法的文件后缀:'.$fileHandle->getOriginalExtension());
146:                 }
147:                 if (filesize($fileHandle) > $this->validate['filesize']) {
148:                     return $this->setError('文件过大');
149:                 }
150:                 if (!in_array($fileHandle->getOriginalMime(), $this->validate['fileMime'])) {
151:                     return $this->setError('不合法的文件类型:'.$fileHandle->getOriginalMime());
152:                 }
153:             }
154:             $key = $this->saveFileName($fileHandle->getRealPath(), $fileHandle->getOriginalExtension());
155:             $body = fopen($fileHandle->getRealPath(), 'rb');
156:             $body = (string)Utils::streamFor($body);
157:         } else {
158:             $key = $file;
159:             $body = $fileContent;
160:         }
161: 
162:         try {
163:             $key = $this->getUploadPath($key);
164: 
165:             $this->fileInfo->uploadInfo = $this->app()->putObject($key, $body);
166:             $this->fileInfo->filePath = ($this->cdn ?: $this->uploadUrl) . '/' . $key;
167:             $this->fileInfo->realName = isset($fileHandle) ? $fileHandle->getOriginalName() : $key;
