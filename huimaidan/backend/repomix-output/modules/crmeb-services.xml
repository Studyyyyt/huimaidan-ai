311:                     $xml .= '<' . $kk . '>' . $v . '</' . $kk . '>';
312:                 }
313:             } else {
314:                 $xml .= '<' . $kk . '>' . $vv . '</' . $kk . '>';
315:             }
316:         }
317:         $xml .= '</' . $itemKey . '>';
318:         $xml .= '</' . $root . '>';
319: 
320:         return $xml;
321:     }
