31:      */
32:     protected $namespace = '\\crmeb\\services\\printer\\storage\\';
33: 
34:     /**
35:      * @var object
36:      */
37:     protected $handleAccessToken;
38: 
39:     /**
40:      * 默认驱动
41:      * @return mixed
42:      */
43:     protected function getDefaultDriver()
44:     {
45:         return Config::get('printer.default', 'yi_lian_yun');
46:     }
47: 
48:     /**
49:      * 获取类的实例
50:      * @param $class
51:      * @return mixed|void
52:      */
53:     protected function invokeClass($class)
54:     {
55:         if (!class_exists($class)) {
56:             throw new \RuntimeException('class not exists: ' . $class);
57:         }
58:         $this->getConfigFile();
59: 
60:         if (!$this->config) {
61:             $this->config = Config::get($this->configFile . '.stores.' . $this->name, []);
62:         }
63: 
64:         if (!$this->handleAccessToken) {
65:             $this->handleAccessToken = new AccessToken($this->config, $this->name, $this->configFile);
66:         }
67: 
68:         $handle = Container::getInstance()->invokeClass($class, [$this->name, $this->handleAccessToken, $this->configFile]);
69:         $this->config = [];
70:         return $handle;
71:     }
72: 
73: }
