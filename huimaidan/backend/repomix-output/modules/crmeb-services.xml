188:     public function payOrderRefund(string $order_sn, array $options)
189:     {
190:         $params = [
191:             'sub_mchid' => $options['sub_mchid'],
192:             'sp_appid' => $this->app['config']['app_id'],
193:             'out_trade_no' => $options['order_sn'],
194:             'out_refund_no' => $options['refund_order_sn'],
195:             'amount' => [
196:                 'refund' => intval($options['refund_price'] * 100),
197:                 'total' => intval($options['pay_price'] * 100),
198:                 'currency' => 'CNY'
199:             ]
200:         ];
201:         if (isset($options['reason'])) {
202:             $params['reason'] = $options['reason'];
203:         }
204:         if (isset($options['refund_account'])) {
205:             $params['refund_account'] = $options['refund_account'];
206:         }
207:         $content = json_encode($params);
208:         $res = $this->request('/v3/ecommerce/refunds/apply', 'POST', ['sign_body' => $content], true);
209:         if (isset($res['code'])) {
210:             throw new ValidateException('微信接口报错:' . $res['message']);
211:         }
212:         return $res;
