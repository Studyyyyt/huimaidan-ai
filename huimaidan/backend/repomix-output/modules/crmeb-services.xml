646:     /**
647:      * 发起请求
648:      * @param string $url
649:      * @param string $method
650:      * @param array $data
651:      * @param array $clientHeader
652:      * @param int $timeout
653:      * @return false|string
654:      * @author 等风来
655:      * @email 136327134@qq.com
656:      * @date 2023/5/16
657:      */
658:     public function request(string $url, string $method, array $data = [], array $clientHeader = [], int $timeout = 10)
659:     {
660:         $method = strtoupper($method);
661:         $urlAttr = pathinfo($url);
662:         $urlParse = parse_url($urlAttr['dirname'] ?? '');
663: 
664:         $uriParam = '';
665:         if ($urlAttr['dirname'] !== 'https:') {
666:             if (isset($urlParse['path'])) {
667:                 $uriParam .= substr($urlParse['path'], 1) . '/';
668:             }
669:             if (isset($urlAttr['basename'])) {
670:                 $uriParam .= $urlAttr['basename'];
671:             }
672:         }
673: 
674:         $result = $this->getSign([
675:             'method' => $method,
676:             'headers' => $clientHeader,
677:             'pathArgs' => '',
678:             'dnsParam' => $data['bucket'] ?? '',
679:             'uriParam' => $uriParam,
680:         ]);
681: 
682:         return $this->requestClient($url, $method, $data, $result['headers'], $timeout);
683:     }
