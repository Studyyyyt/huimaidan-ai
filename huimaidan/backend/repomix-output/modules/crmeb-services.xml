 22:     }
 23: 
 24:     // obj 转 query string
 25:     function json2str($obj, $notEncode = false)
 26:     {
 27:         ksort($obj);
 28:         $arr = array();
 29:         if (!is_array($obj)) {
 30:             throw new \Exception('$obj must be an array, the actual value is:' . json_encode($obj));
 31:         }
 32:         foreach ($obj as $key => $val) {
 33:             array_push($arr, $key . '=' . ($notEncode ? $val : rawurlencode($val)));
 34:         }
 35:         return join('&', $arr);
 36:     }
