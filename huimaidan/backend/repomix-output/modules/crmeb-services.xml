 21: abstract class BaseUpload extends BaseStorage
 22: {
 23:     /**
 24:      * 缩略图
 25:      * @var string[]
 26:      */
 27: //    protected $thumb = ['thumb_big', 'thumb_mid', 'thumb_small','thumb_water_big', 'thumb_water_mid', 'thumb_water_small'];
 28:     protected $thumb = ['big', 'mid', 'small'];
 29: 
 30:     /**
 31:      * 缩略图配置
 32:      * @var array
 33:      */
 34:     protected $thumbConfig = [
 35:         'thumb_big_height' => 800,
 36:         'thumb_big_width' => 800,
 37:         'thumb_mid_height' => 300,
 38:         'thumb_mid_width' => 300,
 39:         'thumb_small_height' => 100,
 40:         'thumb_small_width' => 100
 41:     ];
 42:     /**
 43:      * 水印配置
 44:      * @var array
 45:      */
 46:     protected $waterConfig = [
 47:         'image_watermark_status' => 0,
 48:         'watermark_type' => 1,
 49:         'watermark_image' => '',
 50:         'watermark_opacity' => 0,
 51:         'watermark_position' => 1,
 52:         'watermark_rotate' => 0,
 53:         'watermark_text' => '',
 54:         'watermark_text_angle' => "",
 55:         'watermark_text_color' => '#000000',
 56:         'watermark_text_size' => '5',
 57:         'watermark_text_font' => '',
 58:         'watermark_x' => 0,
 59:         'watermark_y' => 0
 60:     ];
 61:     /**
 62:      * 图片信息
 63:      * @var array
 64:      */
 65:     protected $fileInfo;
 66: 
 67:     /**
 68:      * 上传缩略图开启
 69:      */
 70:     protected $image_thumb_status;
 71:     /**
 72:      * 下载图片信息
 73:      */
 74:     protected $downFileInfo;
 75: 
 76:     /**
 77:      * 要生成缩略图、水印的图片地址
 78:      * @var string
 79:      */
 80:     protected $filePath;
 81: 
 82:     /**
 83:      * 验证配置
 84:      * @var string
 85:      */
 86:     protected $validate;
 87: 
 88:     /**
 89:      * 保存路径
 90:      * @var string
 91:      */
 92:     protected $path = '';
 93: 
 94:     /**
 95:      * 是否自动裁剪
 96:      * @var bool
 97:      */
 98:     protected $authThumb = true;
 99: 
100:     protected function initialize(array $config)
101:     {
102:         $this->fileInfo = $this->downFileInfo = new \StdClass();
103:         $thumbConfig = $this->thumbConfig;
104:         $config['thumb'] = $config['thumb'] ?? [];
105:         $this->thumbConfig = $config['thumb'] ?? [];
106:         foreach ($config['thumb'] as $item) {
107:             if ($item == '' || $item == 0) {
108:                 $this->thumbConfig = $thumbConfig;
109:             }
110:         }
111:         $this->image_thumb_status = $config['image_thumb_status'];
112:         $this->waterConfig = array_merge($this->waterConfig, $config['water'] ?? []);
113:     }
114: 
115:     /**
116:      * 设置处理缩略图、水印图片路径
117:      * @param string $filePath
118:      * @return $this
119:      */
120:     public function setFilepath(string $filePath)
121:     {
122:         $this->filePath = substr($filePath, 0, 1) === '.' ? substr($filePath, 1) : $filePath;
123:         return $this;
124:     }
125: 
126:     /**
127:      * 是否自动裁剪
128:      * @param bool $auth
129:      * @return $this
130:      */
131:     public function setAuthThumb(bool $auth)
132:     {
133:         $this->authThumb = $auth;
134:         return $this;
135:     }
136: 
137:     /**
138:      * 上传文件路径
139:      * @param string $path
140:      * @return $this
141:      */
142:     public function to(string $path)
143:     {
144:         $this->path = $path;
145:         return $this;
146:     }
147: 
148:     /**
149:      * 获取文件信息
150:      * @return array
151:      */
152:     public function getFileInfo()
153:     {
154:         return $this->fileInfo;
155:     }
156: 
157:     /**
158:      * 检测是否是图片
159:      * @param $filePath
160:      * @return bool
161:      */
162:     protected function checkImage($filePath)
163:     {
164:         //获取图像信息
165:         $info = @getimagesize($filePath);
166:         //检测图像合法性
167:         if (false === $info || (IMAGETYPE_GIF === $info[2] && empty($info['bits']))) {
168:             return false;
169:         }
170:         return true;
171:     }
172: 
173:     /**
174:      * 验证合法上传域名
175:      * @param string $url
176:      * @return string
177:      */
178:     protected function checkUploadUrl(string $url)
179:     {
180:         if ($url && strstr($url, 'http') === false) {
181:             $url = 'http://' . $url;
182:         }
183:         return $url;
184:     }
185: 
186:     /**
187:      * 获取系统配置
188:      * @return mixed
189:      */
190:     protected function getConfig()
191:     {
192:         $config['filesize'] = Config::get($this->configFile . '.filesize', []);
193:         $config['fileExt'] = Config::get($this->configFile . '.fileExt', []);
194:         $config['fileMime'] = Config::get($this->configFile . '.fileMime', []);
195:         return $config;
196:     }
197: 
198:     /**
199:      * 设置验证规则
200:      * @param array|null $validate
201:      * @return $this
202:      */
203:     public function validate(?array $validate = null)
204:     {
205:         if (is_null($validate)) {
206:             $validate = $this->getConfig();
207:         }
208:         $this->validate = $validate;
209:         return $this;
210:     }
211: 
212:     /**
213:      * 验证目录是否正确
214:      * @param string $key
215:      * @return false|string
216:      */
217:     protected function getUploadPath(string $key)
218:     {
219:         $path = ($this->path ? $this->path . '/' : '') . $key;
220:         if ($path && $path[0] === '/') {
221:             $path = substr($path, 1);
222:         }
223:         return $path;
224:     }
225: 
226:     /**
227:      * 提取文件名
228:      * @param string $path
229:      * @param string $ext
230:      * @return string
231:      */
232:     protected function saveFileName(string $path = null, string $ext = 'jpg')
233:     {
234:         return ($path ? substr(md5($path), 0, 5) : '') . date('YmdHis') . rand(0, 9999) . '.' . $ext;
235:     }
236: 
237:     /**
238:      * 提取文件后缀以及之前部分
239:      * @param string $path
240:      * @return false|string[]
241:      */
242:     protected function getFileName(string $path)
243:     {
244:         $_empty = ['', ''];
245:         if (!$path) return $_empty;
246:         if (strpos($path, '?')) {
247:             $_tarr = explode('?', $path);
248:             $path = trim($_tarr[0]);
249:         }
250:         $arr = explode('.', $path);
251:         if (!is_array($arr) || count($arr) <= 1) return $_empty;
252:         $ext_name = trim($arr[count($arr) - 1]);
253:         $ext_name = !$ext_name ? 'jpg' : $ext_name;
254:         return [explode('.' . $ext_name, $path)[0], $ext_name];
255:     }
256: 
257:     /**
258:      * 获取图片地址
259:      * @param string $filePath
260:      * @param bool $is_parse_url
261:      * @return string
262:      */
263:     protected function getFilePath(string $filePath = '', bool $is_parse_url = false)
264:     {
265:         $path = $filePath ?: $this->filePath;
266:         if ($is_parse_url) {
267:             $data = parse_url($path);
268:             //远程地址处理
269:             if (isset($data['host']) && isset($data['path'])) {
270:                 if (file_exists(app()->getRootPath() . 'public' . $data['path'])) {
271:                     $path = $data['path'];
272:                 }
273:             }
274:         }
275:         return $path;
276:     }
277: 
278:     /**
279:      * 获取文件类型和大小
280:      * @param string $url
281:      * @param bool $isData
282:      * @return array
283:      */
284:     protected function getFileHeaders(string $url, $isData = true)
285:     {
286:         stream_context_set_default(['ssl' => ['verify_peer' => false, 'verify_peer_name' => false]]);
287:         $header['size'] = 0;
288:         $header['type'] = 'image/jpeg';
289:         if (!$isData) {
290:             return $header;
291:         }
292:         try {
293:             $headerArray = get_headers(str_replace('\\', '/', $url), true);
294:             if (!isset($headerArray['Content-Length'])) {
295:                 $header['size'] = 0;
296:             }
297:             if (!isset($headerArray['Content-Type'])) {
298:                 $header['type'] = 'image/jpeg';
299:             }
300:             if (is_array($headerArray['Content-Length']) && count($headerArray['Content-Length']) == 2) {
301:                 $header['size'] = $headerArray['Content-Length'][1];
302:             }
303:             if (is_array($headerArray['Content-Type']) && count($headerArray['Content-Type']) == 2) {
304:                 $header['type'] = $headerArray['Content-Type'][1];
305:             }
306:         } catch (\Exception $e) {
307:         }
308:         return $header;
309:     }
310: 
311:     /**
312:      * 获取上传信息
313:      * @return array
314:      */
315:     public function getUploadInfo()
316:     {
317:         if (isset($this->fileInfo->filePath)) {
318:             if (strstr($this->fileInfo->filePath, 'http') === false) {
319:                 $url = request()->domain() . $this->fileInfo->filePath;
320:             } else {
321:                 $url = $this->fileInfo->filePath;
322:             }
323:             $headers = $this->getFileHeaders($url);
324:             return [
325:                 'name' => $this->fileInfo->fileName,
326:                 'real_name' => $this->fileInfo->realName ?? '',
327:                 'size' => $headers['size'] ?? 0,
328:                 'type' => $headers['type'] ?? 'image/jpeg',
329:                 'dir' => $this->fileInfo->filePath,
330:                 'thumb_path' => $this->fileInfo->filePath,
331:                 'thumb_path_big' => $this->fileInfo->filePathBig ?? '',
