 38:     // 计算临时密钥用的签名
 39:     function getSignature($opt, $key, $method, $config)
 40:     {
 41:         $host = "sts.tencentcloudapi.com";
 42: 
 43:         if (array_key_exists('domain', $config)) {
 44:             $host = $config['domain'];
 45:         }
 46: 
 47:         if (array_key_exists('endpoint', $config)) {
 48:             $host = "sts." . $config['endpoint'];
 49:         }
 50: 
 51:         $formatString = $method . $host . '/?' . $this->json2str($opt, 1);
 52:         $sign = hash_hmac('sha1', $formatString, $key);
 53:         $sign = base64_encode($this->_hex2bin($sign));
 54:         return $sign;
 55:     }
