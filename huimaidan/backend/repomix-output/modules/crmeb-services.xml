 11: namespace crmeb\services\crud;
 12: 
 13: use think\exception\ValidateException;
 14: use crmeb\services\crud\CrudOperatorEnum;
 15: use crmeb\services\crud\CrudFormEnum;
 16: 
 17: class SearchUtilsServices
 18: {
 19: 
 20:     /**
 21:      *  每个类型代表的意思，以及是否存在需要输入的筛选条件
 22:      * @return array[]
 23:      * @author Qinii
 24:      */
 25:     public function getComparator()
 26:     {
 27:         return [
 28:             CrudOperatorEnum::OPERATOR_IN => ['label' => '包含', 'children' => true],
 29:             CrudOperatorEnum::OPERATOR_NOT_IN => ['label' => '不包含', 'children' => true],
 30:             CrudOperatorEnum::OPERATOR_GT => ['label' => '大于', 'children' => true],
 31:             CrudOperatorEnum::OPERATOR_LT => ['label' => '小于', 'children' => true],
 32:             CrudOperatorEnum::OPERATOR_EQ => ['label' => '等于', 'children' => true],
 33:             CrudOperatorEnum::OPERATOR_GT_EQ => ['label' => '大于等于', 'children' => true],
 34:             CrudOperatorEnum::OPERATOR_LT_EQ => ['label' => '小于等于', 'children' => true],
 35:             CrudOperatorEnum::OPERATOR_NOT_EQ => ['label' => '不等于', 'children' => true],
 36:             CrudOperatorEnum::OPERATOR_BT => ['label' => '介于', 'children' => true],
 37:             CrudOperatorEnum::OPERATOR_N_DAY => ['label' => 'N天前', 'children' => true],
 38:             CrudOperatorEnum::OPERATOR_LAST_DAY => ['label' => '最近N天', 'children' => true],
 39:             //CrudOperatorEnum::OPERATOR_NEXT_DAY => ['label' => '未来N天', 'children' => true],
 40:             CrudOperatorEnum::OPERATOR_TO_DAY => ['label' => '今天', 'children' => false],
 41:             CrudOperatorEnum::OPERATOR_WEEK => ['label' => '本周', 'children' => false],
 42:             CrudOperatorEnum::OPERATOR_MONTH => ['label' => '本月', 'children' => false],
 43:             CrudOperatorEnum::OPERATOR_QUARTER => ['label' => '本季度', 'children' => false],
 44:             CrudOperatorEnum::OPERATOR_IS_EMPTY => ['label' => '为空', 'children' => false],
 45:             CrudOperatorEnum::OPERATOR_NOT_EMPTY => ['label' => '不为空', 'children' => false],
 46:         ];
 47:     }
 48: 
 49:     /**
 50:      *  获取搜索
 51:      * @param array $comparator
 52:      * @param $type
 53:      * @param $options
 54:      * @return array
 55:      * @author Qinii
 56:      */
 57:     public function get(array $comparator, $type, $options = [])
 58:     {
 59:         $this->checkType($type);
 60:         $data = $this->getComparator();
 61:         $res = [];
 62:         foreach ($comparator as $omparator) {
 63:             if (!isset($data[$omparator])) {
 64:                 throw new ValidateException('类型不存在');
 65:             }
 66:             $res[] = [
 67:                 'value' => $omparator,
 68:                 'label' => $data[$omparator]['label'],
 69:                 'type' => $type,
 70:                 'children' => $data[$omparator]['children'],
 71:                 'options' => $options
 72:             ];
 73:         }
 74:         return $res;
 75:     }
 76: 
 77:     /**
 78:      *  时间类型筛选
 79:      * @return array
 80:      * @author Qinii
 81:      */
 82:     public function getDate()
 83:     {
 84:         $date = [
 85:             CrudOperatorEnum::OPERATOR_EQ,
 86:             CrudOperatorEnum::OPERATOR_GT,
 87:             CrudOperatorEnum::OPERATOR_GT_EQ,
 88:             CrudOperatorEnum::OPERATOR_LT,
 89:             CrudOperatorEnum::OPERATOR_LT_EQ,
 90:             CrudOperatorEnum::OPERATOR_NOT_EQ,
 91:             CrudOperatorEnum::OPERATOR_TO_DAY,
 92:             CrudOperatorEnum::OPERATOR_WEEK,
 93:             CrudOperatorEnum::OPERATOR_MONTH,
 94:             CrudOperatorEnum::OPERATOR_QUARTER,
 95:         ];
 96:         $int = [
 97:             //CrudOperatorEnum::OPERATOR_N_DAY,
 98:             CrudOperatorEnum::OPERATOR_LAST_DAY,
 99:             //CrudOperatorEnum::OPERATOR_NEXT_DAY,
100:         ];
101:         $res = $this->get($int, CrudFormEnum::FORM_INPUT_NUMBER);
102:         $resDate = $this->get($date, CrudFormEnum::FORM_DATE_TIME_PICKER, []);
103:         $resDates = $this->get([CrudOperatorEnum::OPERATOR_BT,], CrudFormEnum::FORM_DATE_TIME_PICKER);
104:         $res = array_merge($res, $resDates, $resDate);
105:         return $res;
106:     }
107: 
108:     /**
109:      *  数字类型筛选
110:      * @return array
111:      * @author Qinii
112:      */
113:     public function getNumber()
114:     {
115:         $op = [
116:             CrudOperatorEnum::OPERATOR_EQ,
117:             CrudOperatorEnum::OPERATOR_GT,
118:             CrudOperatorEnum::OPERATOR_GT_EQ,
119:             CrudOperatorEnum::OPERATOR_LT,
120:             CrudOperatorEnum::OPERATOR_LT_EQ,
121:             CrudOperatorEnum::OPERATOR_NOT_EQ,
122:         ];
123:         $res = $this->get($op, CrudFormEnum::FORM_INPUT_NUMBER, []);
124:         $res = array_merge($res, $this->get([CrudOperatorEnum::OPERATOR_BT], CrudFormEnum::FORM_INPUT_NUMBER));
125:         return $res;
126:     }
127: 
128:     /**
129:      *  定义筛选的填写方式
130:      * @param $type
131:      * @return void
132:      * @author Qinii
133:      * @day 2024/6/4
134:      */
135:     public function getType()
136:     {
137:         return [
138:             CrudFormEnum::FORM_INPUT_NUMBER,
139:             CrudFormEnum::FORM_INPUT,
140:             CrudFormEnum::FORM_SELECT,
141:             CrudFormEnum::FORM_DATE_TIME_PICKER
142:         ];
143:     }
144: 
145: 
146: 
147:     /**
148:      *  检测筛选方式是否在设置范围内
149:      * @param $comparator
150:      * @return bool
151:      * @author Qinii
152:      * @day 2024/6/4
153:      */
154:     public function checkComparator($comparator)
155:     {
156:         if (!in_array($comparator, array_keys($this->getComparator()))) {
157:             throw new ValidateException('筛选方式错误：' . $comparator);
158:         }
159:         return true;
160:     }
161: 
162:     /**
163:      * @param $type
164:      * @return true
165:      * @author Qinii
166:      * @day 2024/6/4
167:      */
168:     public function checkType($type)
169:     {
170:         if (!in_array($type, $this->getType())) {
171:             throw new ValidateException('数据类型错误：' . $type);
172:         }
173:         return true;
174:     }
175: 
176:     /**
177:      *  循环筛选参数，过滤掉不在允许范围内的参数，检查比较器是不是设置中的类型
178:      * @param $data
179:      * @param $field
180:      * @return array
181:      * @author Qinii
182:      * @day 2024/6/4
183:      */
184:     public function checkFilterConditions($data, $field)
185:     {
186:         $res = [];
187:         if (!empty($data)) {
188:             foreach ($data as $datum) {
189:                 if (in_array($datum['property'], $field)) {
190:                     $this->checkComparator($datum['comparator']);
191:                     $this->checkType($datum['type']);
192: //                    $datum = $this->checkFilterType($datum);
193:                     $res[] = $datum;
194:                 }
195:             }
196:         }
197:         return $res;
198:     }
199: }
</file>

