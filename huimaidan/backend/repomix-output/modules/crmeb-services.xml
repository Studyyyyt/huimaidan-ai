447:     // v2接口的key首字母小写，v3改成大写，此处做了向下兼容
448:     public function backwardCompat($result)
449:     {
450:         if (!is_array($result)) {
451:             return $this->setError($result . " must be a array");
452:         }
453:         $compat = array();
454:         foreach ($result as $key => $value) {
455:             if (is_array($value)) {
456:                 $compat[lcfirst($key)] = $this->backwardCompat($value);
457:             } elseif ($key == 'Token') {
458:                 $compat['sessionToken'] = $value;
459:             } else {
460:                 $compat[lcfirst($key)] = $value;
461:             }
462:         }
463:         return $compat;
464:     }
