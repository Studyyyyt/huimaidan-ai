 143:     {
 144:         $surDir = rtrim($surDir, '/') . '/';
 145:         $toDir = rtrim($toDir, '/') . '/';
 146:         if (!file_exists($surDir)) {
 147:             return false;
 148:         }
 149: 
 150:         if (!file_exists($toDir)) {
 151:             $this->createDir($toDir);
 152:         }
 153:         $file = opendir($surDir);
 154:         while ($fileName = readdir($file)) {
 155:             $file1 = $surDir . '/' . $fileName;
 156:             $file2 = $toDir . '/' . $fileName;
 157:             if ($fileName != '.' && $fileName != '..') {
 158:                 if (is_dir($file1)) {
