 33: class Client extends BaseClient
 34: {
 35:     protected $isService = false;
 36:     //文档地址：https://developers.weixin.qq.com/miniprogram/dev/OpenApiDoc/sec-center/sec-check/msgSecCheck.html
 37:     const MSG_API = 'https://api.weixin.qq.com/wxa/msg_sec_check?access_token=';
 38:     const MEDIA_API = 'https://api.weixin.qq.com/wxa/media_check_async?access_token=';
 39:     const LABEL = [
 40:         100   => '正常',
 41:         10001 => '广告',
 42:         20001 => '时政',
 43:         20002 => '色情',
 44:         20003 => '辱骂',
 45:         20006 => '违法犯罪',
 46:         20008 => '欺诈',
 47:         20012 => '低俗',
 48:         20013 => '版权',
 49:         21000 => '其他'
 50:     ];
 51: 
 52:     public function msgSecCheck($content, $scene, $openId)
 53:     {
 54:        $access_token = $this->accessToken->getToken();
 55:         //scene 场景枚举值（1 资料；2 评论；3 论坛；4 社交日志）
 56:         $_url = self::MSG_API.$access_token;
 57:         $params = [
 58:             'content' => $content,
 59:             'version' => (int)2,
 60:             'scene' => (int)$scene,
 61:             'openid' => $openId,
 62:         ];
 63: 
 64:         try{
 65:             $res = $this->parseJSON('json',[$_url, $params]);
 66:             if (isset($res->errcode) && $res->errcode == 0) {
 67:                 if($res->result['label'] == 100) {
 68:                     return true;
 69:                 } else if ($res->result['label'] == 21000) {
 70:                     throw new ValidateException('内容存在敏感信息无法提交');
 71:                 } else {
 72:                     throw new ValidateException('内容包含：【'.self::LABEL[$res->result['label']].'】无法提交');
 73:                 }
 74:             }
 75:         }catch (Exception $exception) {
 76:             throw new ValidateException($exception->getMessage());
 77:         }
 78:     }
 79: 
 80: 
 81:     /**
 82:      * 图片或音频是异步回调，暂未使用
