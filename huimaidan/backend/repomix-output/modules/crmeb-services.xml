479:     /**
480:      * 发起请求
481:      * @param string $url
482:      * @param string $method
483:      * @param array $data
484:      * @param array $header
485:      * @param int $timeout
486:      * @return array|false|\SimpleXMLElement|string
487:      * @author 等风来
488:      * @email 136327134@qq.com
489:      * @date 2022/9/29
490:      */
491:     public function request(string $url, string $method, array $data, array $header = [], int $timeout = 5)
492:     {
493: 
494:         $this->request['body'] = $data;
495:         $this->request['host'] = $url;
496: 
497: 
498:         $urlAttr = parse_url($url);
499:         $curl = curl_init($url);
500:         $method = strtoupper($method);
501:         //请求方式
502:         curl_setopt($curl, CURLOPT_CUSTOMREQUEST, $method);
503: 
504:         //超时时间
505:         curl_setopt($curl, CURLOPT_TIMEOUT, $timeout);
506:         //设置header头
507: 
508:         $header = array_merge($header, $this->getSign($url, $method, $urlAttr['path'] ?? '', [], $header));
509: 
510:         $this->request['header'] = $header;
511: 
512:         $clientHeader = [];
513:         foreach ($header as $key => $item) {
514:             $clientHeader[] = $key . ':' . $item;
515:         }
516: 
517:         curl_setopt($curl, CURLOPT_HTTPHEADER, $clientHeader);
518: 
519: 
520:         curl_setopt($curl, CURLOPT_FAILONERROR, false);
521:         //返回抓取数据
522:         curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
523:         //输出header头信息
524:         curl_setopt($curl, CURLOPT_HEADER, true);
525:         //TRUE 时追踪句柄的请求字符串，从 PHP 5.1.3 开始可用。这个很关键，就是允许你查看请求header
526:         curl_setopt($curl, CURLINFO_HEADER_OUT, true);
527:         //https请求
528:         if (1 == strpos("$" . $url, "https://")) {
529:             curl_setopt($curl, CURLOPT_SSL_VERIFYPEER, false);
530:             curl_setopt($curl, CURLOPT_SSL_VERIFYHOST, false);
531:         }
532: 
533:         //post请求
534:         if ($method == 'PUT' && !empty($data['body'])) {
535:             curl_setopt($curl, CURLOPT_RETURNTRANSFER, 1);
536:             // 注意这里的'file'是上传地址指定的key名
537:             curl_setopt($curl, CURLOPT_POSTFIELDS, $data['body']);
538:         }
539: 
540:         if (!empty($data['xml'])) {
541:             curl_setopt($curl, CURLOPT_POSTFIELDS, $data['xml']);
542:         }
543: 
544:         list($content, $status) = [curl_exec($curl), curl_getinfo($curl), curl_close($curl)];
545: 
546:         $content = trim(substr($content, $status['header_size']));
547: 
548:         $this->response['content'] = $content;
549:         $this->response['code'] = $status['http_code'];
550:         $this->response['header'] = $status;
551: 
552:         $res = XML::parse($content);
553:         if ($res) {
554:             return $res;
555:         }
556:         return (intval($status["http_code"]) === 200) ? $content : false;
557:     }
558: 
559:     /**
560:      * 获取签名
561:      * @param string $method
562:      * @param string $urlPath
563:      * @param array $query
564:      * @param array $headers
565:      * @return array
566:      * @author 等风来
567:      * @email 136327134@qq.com
568:      * @date 2022/9/27
569:      */
570:     public function getSign(string $url, string $method, string $urlPath, array $query = [], array $headers = [])
571:     {
572:         return (new Signature($this->accessKey, $this->secretKey, ['signHost' => $url]))->signRequest($method, $urlPath, $query, $headers);
573:     }
574: }
