46:      */
47:     protected function invokeClass($class)
48:     {
49:         if (!class_exists($class)) {
50:             throw new \RuntimeException('class not exists: ' . $class);
51:         }
52:         $this->getConfigFile();
53: 
54:         if (!$this->config) {
55:             $this->config = Config::get($this->configFile . '.stores.' . $this->name, []);
56:         }
57:         $handleAccessToken = new AccessTokenServeService($this->config);
58:         $handle = Container::getInstance()->invokeClass($class, [$this->name, $handleAccessToken, $this->configFile]);
59:         $this->config = [];
60:         return $handle;
61:     }
62: }
