237:             if (strpos($filePath, '?') === false) {
238:                 $filePath .= '?watermark';
239:             } else {
240:                 $filePath .= '|watermark';
241:             }
242:             switch ($waterConfig['watermark_type']) {
243:                 case 1://图片
244:                     if (!$waterConfig['watermark_image']) {
245:                         throw new AdminException('请上传水印图');
246:                     }
247:                     $waterPath = $filePath .= '/1/image/' . base64_encode($waterConfig['watermark_image']) . '/gravity/' . ($this->position[$waterConfig['watermark_position']] ?? 'SouthEest') . '/dissolve/' . $waterConfig['watermark_opacity'] . '/dx/' . $waterConfig['watermark_x'] . '/dy/' . $waterConfig['watermark_y'];
248:                     break;
249:                 case 2://文字
250:                     if (!$waterConfig['watermark_text']) {
251:                         throw new AdminException('请填写水印文字');
252:                     }
253:                     $fontSize = $waterConfig['watermark_text_size'] / 72 * 20 * 240;
254:                     $waterPath = $filePath .= '/2/text/' . base64_encode($waterConfig['watermark_text']) . '/fill/' . base64_encode($waterConfig['watermark_text_color']) . '/fontsize/' . floor($fontSize) . '/dissolve/' . $waterConfig['watermark_opacity'] . '/gravity/' . ($this->position[$waterConfig['watermark_position']] ?? 'SouthEest') . '/dx/' . $waterConfig['watermark_x'] . '/dy/' . $waterConfig['watermark_y'];
255:                     break;
256:             }
257:         }
258:         return $waterPath;
