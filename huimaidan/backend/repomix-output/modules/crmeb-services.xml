303:     public function paymentPrepare($openid, $out_trade_no, $total_fee, $attach, $body, $detail = '', $trade_type = 'JSAPI', $options = [])
304:     {
305:         $order = $this->paymentOrder($openid, $out_trade_no, $total_fee, $attach, $body, $detail, $trade_type, $options);
306:         // 获取配置  判断是否为新支付
307:         if (isset($this->config['pay_routine_new_mchid']) && $this->config['pay_routine_new_mchid']) {
308:             $result = $this->service->minipay->createorder($order);
309:             if ($result->errcode === 0) {
310:                 return $result->payment_params;
