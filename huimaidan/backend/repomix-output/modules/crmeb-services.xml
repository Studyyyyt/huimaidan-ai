 474:                 return $result;
 475:             } else {
 476:                 if ($result->return_code == 'FAIL') {
 477:                     throw new WechatException('微信支付错误返回：' . $result->return_msg);
 478:                 } else if (isset($result->err_code)) {
 479:                     throw new WechatException('微信支付错误返回：' . $result->err_code_des);
 480:                 } else {
 481:                     throw new WechatException('没有获取微信支付的预支付ID，请重新发起支付!');
 482:                 }
 483:             }
