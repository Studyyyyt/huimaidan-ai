161:     public function fileList()
162:     {
163:         if (!is_dir($this->config['path'])) {
164:             mkdir($this->config['path'], 0755, true);
165:         }
166:         $path = realpath($this->config['path']);
167:         $flag = \FilesystemIterator::KEY_AS_FILENAME;
168:         $glob = new \FilesystemIterator($path, $flag);
169:         $list = array();
170:         foreach ($glob as $name => $file) {
171:             if (preg_match('/^\\d{8,8}-\\d{6,6}-\\d+\\.sql(?:\\.gz)?$/', $name)) {
172:                 $info['filename'] = $name;
173:                 $name = sscanf($name, '%4s%2s%2s-%2s%2s%2s-%d');
174:                 $date = "{$name[0]}-{$name[1]}-{$name[2]}";
175:                 $time = "{$name[3]}:{$name[4]}:{$name[5]}";
176:                 $part = $name[6];
177:                 if (isset($list["{$date} {$time}"])) {
178:                     $info = $list["{$date} {$time}"];
179:                     $info['part'] = max($info['part'], $part);
180:                     $info['size'] = $info['size'] + $file->getSize();
181:                 } else {
182:                     $info['part'] = $part;
183:                     $info['size'] = $file->getSize();
184:                 }
185:                 $extension = strtoupper(pathinfo($file->getFilename(), PATHINFO_EXTENSION));
186:                 $info['compress'] = $extension === 'SQL' ? '-' : $extension;
187:                 $info['time'] = strtotime("{$date} {$time}");
188:                 $list["{$date} {$time}"] = $info;
189:             }
190:         }
191:         return $list;
192:     }
