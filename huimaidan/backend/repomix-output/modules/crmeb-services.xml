 75:      * @param array $params
 76:      * @return string
 77:      */
 78:     public static function build(string $template, array $params = []): string
 79:     {
 80:         $key = $template;
 81:         foreach ($params as $param => $value) {
 82:             $key = str_replace('{' . $param . '}', $value, $key);
 83:         }
 84:         return $key;
 85:     }
 86: 
 87:     /**
 88:      * 获取缓存标签
 89:      */
 90:     public static function getTags(string $template, array $params = []): array
 91:     {
 92:         $tags = self::$keyTags[$template] ?? [];
 93:         $processedTags = [];
 94: 
 95:         foreach ($tags as $tag) {
 96:             $processedTag = $tag;
 97:             foreach ($params as $param => $value) {
 98:                 $processedTag = str_replace('{' . $param . '}', (string)$value, $processedTag);
 99:             }
100:             $processedTags[] = $processedTag;
101:         }
102: 
103:         return $processedTags;
104:     }
105: 
106:     /**
