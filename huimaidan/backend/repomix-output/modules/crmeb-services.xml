212:             case 'timeverif':
213:                 $name = date('Ymd-His', $time) . '-*.sql*';
214:                 $path = realpath($this->config['path']) . DIRECTORY_SEPARATOR . $name;
215:                 $files = glob($path);
216:                 $list = array();
217:                 foreach ($files as $name) {
218:                     $basename = basename($name);
219:                     $match = sscanf($basename, '%4s%2s%2s-%2s%2s%2s-%d');
220:                     $gz = preg_match('/^\\d{8,8}-\\d{6,6}-\\d+\\.sql.gz$/', $basename);
221:                     $list[$match[6]] = array($match[6], $name, $gz);
222:                 }
223:                 $last = end($list);
224:                 if (count($list) === $last[0]) {
225:                     return $list;
226:                 } else {
227:                     throw new \Exception("File {$files['0']} may be damaged, please check again");
228:                 }
229:                 break;
230:             case 'pathname':
231:                 return "{$this->config['path']}{$this->file['name']}-{$this->file['part']}.sql";
232:                 break;
233:             case 'filename':
234:                 return "{$this->file['name']}-{$this->file['part']}.sql";
235:                 break;
236:             case 'filepath':
237:                 return $this->config['path'];
238:                 break;
239:             default:
240:                 $arr = array('pathname' => "{$this->config['path']}{$this->file['name']}-{$this->file['part']}.sql", 'filename' => "{$this->file['name']}-{$this->file['part']}.sql", 'filepath' => $this->config['path'], 'file' => $this->file);
241:                 return $arr;
242:         }
243:     }
