 943:     public function readExcel($filePath, $row_num = 1, $suffix = 'Xlsx')
 944:     {
 945:         if (!$filePath) return false;
 946:         $pathInfo = pathinfo($filePath, PATHINFO_EXTENSION);
 947:         if (!$pathInfo || $pathInfo != "xlsx") throw new ValidateException('必须上传xlsx格式文件');
 948:         //加载读取模型
 949:         $readModel = \PhpOffice\PhpSpreadsheet\IOFactory::createReader($suffix);
 950:         // 创建读操作
 951:         // 打开文件 载入excel表格
 952:         try {
 953:             $spreadsheet = $readModel->load($filePath);
 954:             $sheet = $spreadsheet->getActiveSheet();
 955:             $sheet->getHighestColumn();
 956:             $highestRow = $sheet->getHighestRow();
 957:             $lines = $highestRow - 1;
 958:             if ($lines <= 0) {
 959:                 throw new ValidateException('数据不能为空');
 960:             }
 961:             // 用于存储表格数据
 962:             $data = [];
 963:             for ($i = $row_num; $i <= $highestRow; $i++) {
 964:                 $t1 = $this->objToStr($sheet->getCellByColumnAndRow(1, $i)->getValue()) ?? '';
 965:                 $t2 = $this->objToStr($sheet->getCellByColumnAndRow(2, $i)->getValue());
 966:                 if ($t2) {
 967:                     $data[] = [
 968:                         'key' => $t1,
 969:                         'value' => $t2
 970:                     ];
 971:                 }
 972:             }
 973:             return $data;
 974:         } catch (\Exception $e) {
 975:             throw new ValidateException($e->getMessage());
 976:         }
 977:     }
