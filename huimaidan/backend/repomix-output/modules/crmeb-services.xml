288:     /**
289:      * 保存表格数据
290:      * @param $filename 文件名称
291:      * @param $suffix 文件后缀名
292:      * @param $path 是否保存文件文件
293:      * @return 保存文件：return string
294:      */
295:     public function excelSave($fileName = '',$suffix = 'xlsx',$path)
296:     {
297:         if(empty($fileName)) $fileName = date('YmdHis').time();
298:         if(empty($suffix)) $suffix = 'xlsx';
299:         // 重命名表（UTF8编码不需要这一步）
300:         if (mb_detect_encoding($fileName) != "UTF-8") $fileName = iconv("utf-8", "gbk//IGNORE", $fileName);
301: 
302:         $save_path = self::$path.$path;
303:         $root_path = app()->getRootPath().'public/'.$save_path;
304:         if(!is_dir($root_path)) mkdir($root_path, 0755,true);
305:         $spreadsheet = self::$spreadsheet;
306:         $writer = new \PhpOffice\PhpSpreadsheet\Writer\Xlsx($spreadsheet);
307:         $writer->save($root_path.'/'.$fileName.'.'.$suffix);
308: 
309:         return $save_path.'/'.$fileName.'.'.$suffix;
310:     }
311: 
312:     /**
313:      * 读取文件
314:      * @param $filePath 文件路径
315:      * @param array $sql  需要入库的字段 => excel表的列  例 [order_sn => 'B']
316:      * @param array $where  每条入库的条件 同上
317:      * @param int $startRow 有效数据从第几行开始
318:      * @return array
319:      * @author Qinii
320:      * @day 3/15/21
321:      */
322:     public function _import($filePath,array $sql,$where = [],$startRow = 1)
323:     {
324:         if(!file_exists($filePath)) return [];
325:         $ext = ucfirst(pathinfo($filePath, PATHINFO_EXTENSION));
326:         $ret = [];
327:         if (in_array($ext, ['Xlsx', 'Xls'])) {
328:             $reader = \PhpOffice\PhpSpreadsheet\IOFactory::createReader($ext);
329:             $spreadsheet = $reader->load($filePath);
330:             $sheet = $spreadsheet->getActiveSheet();
331:             $row_count = $sheet->getHighestDataRow();//取得总行数
332:             for ($row = $startRow; $row <= $row_count; $row++) {
333:                 // where条件
334:                 $con = [];
335:                 // 导入数据
336:                 $item = [];
337:                 // 每一行数据
338:                 $one = [];
339: //                $getK = $sheet->getCell('A'.$row)->getValue();
340: //                if ($getK) {
341: //                    $getV = $sheet->getCell('B'.$row)->getValue();
342: //                    $one[] = [$getK => $getV];
343: //                }
344:                 if (!empty($where)) {
345:                     foreach ($where as $k => $v) {
346:                         $con_value = $sheet->getCell($v . $row)->getValue();
347:                         if ($con_value) {
348:                             $con[$k] = $con_value;
349:                         }
350:                     }
351:                     if (!empty($con)) $one['where'] = $con;
352:                 }
353:                 if (!empty($sql)) {
354:                     foreach ($sql as $key => $value) {
355:                         $key_value = $sheet->getCell($value . $row)->getValue();
356:                         $item[$key] = $key_value ?? '';
357:                     }
358:                     if (!empty($item)) $one['value'] = $item;
359:                 }
360:                 if ($one) $ret[] = $one;
361:             }
362:         }
363:         return $ret;
364:     }
365: 
366:     /**
367:      *  检测导入格式
368:      * @param $filePath
369:      * @param array $check
370:      * @return bool
371:      * @author Qinii
372:      * @day 5/7/21
373:      */
374:     public function checkImport($filePath,$check = [])
375:     {
376:         $ext = ucfirst(pathinfo($filePath, PATHINFO_EXTENSION));
377:         $reader = \PhpOffice\PhpSpreadsheet\IOFactory::createReader($ext);
378:         $spreadsheet = $reader->load($filePath);
379:         $sheet = $spreadsheet->getActiveSheet();
380:         if(!empty($check)){
381:             foreach ($check as $s => $c){
382:                 $_c = $sheet->getCell($s)->getValue();
383:                 if($_c !== $c)  throw new ValidateException('表格"'.$s.'"不是"'.$c.'"不可导入');
384:             }
385:         }
386:         return true;
387:     }
388: 
389: }
