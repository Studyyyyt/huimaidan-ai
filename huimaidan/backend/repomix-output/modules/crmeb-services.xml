 18:     //错误信息
 19:     private static $curlError;
 20:     //header头信息
 21:     private static $headerStr;
 22:     //请求状态
 23:     private static $status;
 24: 
 25:     /**
 26:      * @return string
 27:      */
 28:     public static function getCurlError()
 29:     {
 30:         return self::$curlError;
 31:     }
 32: 
 33:     /**
 34:      * @return mixed
 35:      */
 36:     public static function getStatus()
 37:     {
 38:         return self::$status;
 39:     }
 40: 
 41:     /**
 42:      * 模拟GET发起请求
 43:      * @param $url
 44:      * @param array $data
 45:      * @param bool $header
 46:      * @param int $timeout
 47:      * @return bool|string
 48:      */
 49:     public static function getRequest($url, $data = array(), $header = false, $timeout = 10)
 50:     {
 51:         if (!empty($data)) {
 52:             $url .= (stripos($url, '?') === false ? '?' : '&');
 53:             $url .= (is_array($data) ? http_build_query($data) : $data);
 54:         }
 55: 
 56:         return self::request($url, 'get', array(), $header, $timeout);
 57:     }
 58: 
 59:     /**
 60:      * curl 请求
 61:      * @param $url
 62:      * @param string $method
 63:      * @param array $data
 64:      * @param bool $header
 65:      * @param int $timeout
 66:      * @return bool|string
 67:      */
 68:     public static function request($url, $method = 'get', $data = array(), $header = false, $timeout = 15)
 69:     {
 70:         self::$status = null;
 71:         self::$curlError = null;
 72:         self::$headerStr = null;
 73:         $method = strtoupper($method);
 74:         if ($method == 'GET' && !empty($data)) $url .= "?". http_build_query($data);
 75: 
 76:         $curl = curl_init($url);
 77:         //请求方式
 78:         curl_setopt($curl, CURLOPT_CUSTOMREQUEST, $method);
 79:         //post请求
 80:         if ($method == 'POST') curl_setopt($curl, CURLOPT_POSTFIELDS, $data);
 81:         //超时时间
 82:         curl_setopt($curl, CURLOPT_TIMEOUT, $timeout);
 83:         //设置header头
 84:         if ($header !== false) curl_setopt($curl, CURLOPT_HTTPHEADER, $header);
 85:         curl_setopt($curl, CURLOPT_FAILONERROR, false);
 86:         //返回抓取数据
 87:         curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
 88:         //输出header头信息
 89:         curl_setopt($curl, CURLOPT_HEADER, true);
 90:         //TRUE 时追踪句柄的请求字符串，从 PHP 5.1.3 开始可用。这个很关键，就是允许你查看请求header
 91:         curl_setopt($curl, CURLINFO_HEADER_OUT, true);
 92:         //https请求
 93:         if (1 == strpos("$" . $url, "https://")) {
 94:             curl_setopt($curl, CURLOPT_SSL_VERIFYPEER, false);
 95:             curl_setopt($curl, CURLOPT_SSL_VERIFYHOST, false);
 96:         }
 97:         self::$curlError = curl_error($curl);
 98:         list($content, $status) = [curl_exec($curl), curl_getinfo($curl), curl_close($curl)];
 99:         self::$status = $status;
100:         self::$headerStr = trim(substr($content, 0, $status['header_size']));
101:         $content = trim(substr($content, $status['header_size']));
102:         return (intval($status["http_code"]) === 200) ? $content : false;
103:     }
104: 
105:     /**
106:      * 模拟POST发起请求
107:      * @param $url
108:      * @param array $data
109:      * @param bool $header
110:      * @param int $timeout
111:      * @return bool|string
112:      */
113:     public static function postRequest($url, array $data = array(), $header = false, $timeout = 10)
114:     {
115:         return self::request($url, 'post', $data, $header, $timeout);
116:     }
