 22: 
 23: class Client extends BaseClient
 24: {
 25:     protected $isService = false;
 26: 
 27:     //发起转账
 28:     const API_TRANSFER_BILLS_URL = '/v3/fund-app/mch-transfer/transfer-bills';
 29: 
 30:     /**
 31:      * 商家转账到零钱
 32:      * https://pay.weixin.qq.com/wiki/doc/apiv3/apis/chapter4_3_1.shtml
 33:      * @param $type
 34:      * @param array $order
 35:      * @return mixed
 36:      */
 37:     public function send(array $order)
 38:     {
 39:         $params = [
 40:             'appid'        => $this->app['config']['app_id'],
 41:             'out_batch_no' => $order['out_batch_no'],
 42:             'batch_name'   => $order['batch_name'],
 43:             'batch_remark' => $order['batch_remark'],
 44:             'total_amount' => $order['total_amount'],
 45:             'total_num'    => $order['total_num'],
 46:             'transfer_detail_list' => $order['transfer_detail_list'],
 47:         ];
 48:         $content = json_encode($params, JSON_UNESCAPED_UNICODE);
 49: 
 50:         $res = $this->request('/v3/transfer/batches', 'POST', ['sign_body' => $content]);
 51:         if (isset($res['code'])) {
 52:             throw new ValidateException('微信接口报错:' . $res['message']);
 53:         }
 54:         return $res;
 55:     }
 56:     /**
 57:      * 发起转账新接口(2025年1月15日升级)
 58:      *
 59:      * @param string $outBatchNo
 60:      * @param string $amount
 61:      * @param string $openid
 62:      * @param string $userName
 63:      * @param string $remark
 64:      * @param array $transferDetailList
 65:      * @param string $transferSceneId
 66:      * @param string $type
 67:      * @param string $perception
 68:      * @return void
 69:      */
 70:     public function transferBills(
 71:         string $outBatchNo,
 72:         string $amount,
 73:         string $openid,
 74:         string $userName,
 75:         string $remark,
 76:         array $transferDetailList,
 77:         string $transferSceneId = '1000', 
 78:         string $type = 'wechat'
 79:     ) {
 80:         $appId = $this->app['config']['app_id'];
 81:         $data = [
 82:             'appid' => $appId,
 83:             'out_bill_no' => $outBatchNo,
 84:             'transfer_scene_id' => $transferSceneId,
 85:             'openid' => $openid,
 86:             'transfer_amount' => (int)bcmul($amount, 100, 0),
 87:             'transfer_remark' => $remark,
 88:             'notify_url' => systemConfig('site_url') . Route::buildUrl('mchNotify',['type' => $type])->build(),
 89:             'transfer_scene_report_infos' => $transferDetailList
 90:         ];
 91: 
 92:         if ($amount >= 200000) {
 93:             if (empty($userName)) {
 94:                 throw new ValidateException('明细金额大于等于2000时,收款人姓名必须填写');
 95:             }
 96:             $data['user_name'] = $this->encryptSensitiveInformation($userName);
 97:         }
 98:         Log::info('发起转账 data :' . var_export($data, 1));
 99:         $res = $this->request(self::API_TRANSFER_BILLS_URL, 'POST', ['sign_body' => json_encode($data)]);
100:         if (!$res || isset($res['code'], $res['message'])) {
101:             throw new ValidateException('微信商家转账：'.$res['message'] ?? '发起商家转账失败');
102:         }
103: 
104:         $res['app_id'] = $appId;
105:         $res['mch_id'] = $this->app['config']['payment']['merchant_id'];
106: 
107:         return $res;
108:     }
109: 
110:     public function handleNotify($callback)
111:     {
112:         $request = request();
113:         $data = $request->post('resource', []);
114:         $data = $this->decrypt($data);
115: 
116:         $handleResult = call_user_func_array($callback, [json_decode($data, true)]);
117:         if (is_bool($handleResult) && $handleResult) {
118:             $response = [
119:                 'code' => 'SUCCESS',
120:                 'message' => 'OK',
121:             ];
122:         } else {
123:             $response = [
124:                 'code' => 'FAIL',
125:                 'message' => $handleResult,
126:             ];
127:         }
128: 
129:         return response($response, 200, [], 'json');
130:     }
131: }
