 26: 
 27:     public static function query($no, $type = '',$phone = '')
 28:     {
 29:         $express = systemConfig('crmeb_serve_express') ?:2;
 30: 
 31:         if($express == 2){
 32:             //一号通
 33:             return self::serve($no, $type,$phone);
 34:         } else {
 35:             //阿里云
 36:             return self::ali($no, $type);
