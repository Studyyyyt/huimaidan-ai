14: namespace crmeb\services;
15: 
16: 
17: use crmeb\exceptions\AuthException;
18: use Firebase\JWT\BeforeValidException;
19: use Firebase\JWT\ExpiredException;
20: use Firebase\JWT\JWT;
21: use Firebase\JWT\SignatureInvalidException;
22: use think\facade\Config;
23: use UnexpectedValueException;
24: 
25: class JwtTokenService
26: {
27:     /**
28:      * @param int $id
29:      * @param string $type
30:      * @param $exp
31:      * @param array $params
32:      * @return array
33:      * @author xaboy
34:      * @day 2020/10/13
35:      */
36:     public function createToken(int $id, string $type, $exp, array $params = [])
37:     {
38:         $time = time();
39:         $host = app('request')->host();
40:         $params += [
41:             'iss' => $host,
42:             'aud' => $host,
43:             'iat' => $time,
44:             'nbf' => $time,
45:             'exp' => $exp,
46:         ];
47:         $params['jti'] = [$id, $type];
48:         $token = JWT::encode($params, Config::get('app.app_key', 'default'));
49:         $params['token'] = $token;
50:         $params['out'] = $exp - time();
51:         return $params;
52:     }
53: 
54:     /**
55:      * @param string $token
56:      * @return object
57:      * @throws SignatureInvalidException    Provided JWT was invalid because the signature verification failed
58:      * @throws BeforeValidException         Provided JWT is trying to be used before it's eligible as defined by 'nbf'
59:      * @throws BeforeValidException         Provided JWT is trying to be used before it's been created as defined by 'iat'
60:      * @throws ExpiredException             Provided JWT has since expired, as defined by the 'exp' claim
61:      * @throws UnexpectedValueException     Provided JWT was invalid
62:      * @author xaboy
63:      * @day 2020-04-09
64:      */
65:     public function parseToken(string $token)
66:     {
67:         return JWT::decode($token, Config::get('app.app_key', 'default'), array('HS256'));
68:     }
69: 
70:     /**
71:      * @param string $token
72:      * @return object
73:      * @author xaboy
74:      * @day 2020-04-10
75:      */
76:     public function decode(string $token)
77:     {
78:         $tks = explode('.', $token);
79:         if (count($tks) != 3)
80:             throw new AuthException('Invalid token');
81: 
82:         if (null === $payload = JWT::jsonDecode(JWT::urlsafeB64Decode($tks[1])))
83:             throw new AuthException('Invalid token');
84: 
85:         return $payload;
86:     }
87: }
