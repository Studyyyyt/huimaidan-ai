 396:         $new_path = $this->dirReplace($new_path);
 397:         if (file_exists($new_path) && $overWrite = FALSE) {
 398:             return FALSE;
 399:         } else if (file_exists($new_path) && $overWrite = TRUE) {
 400:             $this->unlinkFile($new_path);
 401:         }
 402: 
 403:         $aimDir = dirname($new_path);
 404:         $this->createDir($aimDir);
 405:         switch ($type) {
 406:             case 'copy':
 407:                 return copy($old_path, $new_path);
 408:                 break;
 409:             case 'move':
 410:                 return @rename($old_path, $new_path);
 411:                 break;
