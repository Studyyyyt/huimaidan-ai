394:      * 文件流上传
395:      * @param string $fileContent
396:      * @param string|null $key
397:      * @return array|bool|mixed|\StdClass
398:      */
399:     public function stream($fileContent, string $key = null)
400:     {
401:         $file = sys_get_temp_dir() . $key;
402:         file_put_contents($file, $fileContent, true);
403:         if (!$key) {
404:             $key = $this->saveFileName();
405:         }
406:         $path = ($this->path ? trim($this->path, '/') . '/' : '');
407: 
408: 
409:         try {
410:             $uploadMgr = new UcloudUploadManager($this->app());
411:             list($result, $err) = $uploadMgr->MultipartForm($this->storageName, $path . $key, $file);
412:             unlink($file);
413:             if ($err !== null) {
414:                 // return array(null, $err);
415:                 return $this->setError($err->ErrMsg);
416:             }
417:             if ($this->cdn) {
418:                 $src = $this->cdn . '/' . $path . $key;
419:             } else {
420:                 $src = 'https://' . $uploadMgr->MakePublicUrl($this->storageName, $path . $key);
421:             }
422: 
423:             if ($this->thumb_status) $src = $this->thumb($src);
424:             $this->fileInfo->uploadInfo = $result;
425:             $this->fileInfo->filePath = $src;
426:             $this->fileInfo->fileName = $key;
427:             return $this->fileInfo;
428:         } catch (UploadException $e) {
429:             return $this->setError($e->getMessage());
430:         }
