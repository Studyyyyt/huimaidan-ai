 57:     // v2接口的key首字母小写，v3改成大写，此处做了向下兼容
 58:     function backwardCompat($result)
 59:     {
 60:         if (!is_array($result)) {
 61:             throw new \Exception('$result must be an array, the actual value is:' . json_encode($result));
 62:         }
 63:         $compat = array();
 64:         foreach ($result as $key => $value) {
 65:             if (is_array($value)) {
 66:                 $compat[lcfirst($key)] = $this->backwardCompat($value);
 67:             } elseif ($key == 'Token') {
 68:                 $compat['sessionToken'] = $value;
 69:             } else {
 70:                 $compat[lcfirst($key)] = $value;
 71:             }
 72:         }
 73:         return $compat;
 74:     }
