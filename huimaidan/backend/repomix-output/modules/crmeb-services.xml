<file path="upload/XML.php">
  1: <?php
  2: 
  3: namespace crmeb\services\upload;
  4: 
  5: class XML
  6: {
  7:     /**
  8:      * XML to array.
  9:      *
 10:      * @param string $xml XML string
 11:      *
 12:      * @return array
 13:      */
 14:     public static function parse($xml)
 15:     {
 16:         $backup = PHP_MAJOR_VERSION < 8 ? libxml_disable_entity_loader(true) : null;
 17: 
 18:         $result = self::normalize(simplexml_load_string(self::sanitize($xml), 'SimpleXMLElement', LIBXML_COMPACT | LIBXML_NOCDATA | LIBXML_NOBLANKS));
 19: 
 20:         PHP_MAJOR_VERSION < 8 && libxml_disable_entity_loader($backup);
 21: 
 22:         return $result;
 23:     }
 24: 
 25:     /**
 26:      * XML encode.
 27:      *
 28:      * @param mixed $data
 29:      * @param string $root
 30:      * @param string $item
 31:      * @param string $attr
 32:      * @param string $id
 33:      *
 34:      * @return string
 35:      */
 36:     public static function build(
 37:         $data,
 38:         $root = 'xml',
 39:         $item = 'item',
 40:         $attr = '',
 41:         $id = 'id'
 42:     )
 43:     {
 44:         if (is_array($attr)) {
 45:             $_attr = [];
 46: 
 47:             foreach ($attr as $key => $value) {
 48:                 $_attr[] = "{$key}=\"{$value}\"";
 49:             }
 50: 
 51:             $attr = implode(' ', $_attr);
 52:         }
 53: 
 54:         $attr = trim($attr);
 55:         $attr = empty($attr) ? '' : " {$attr}";
 56:         $xml = "<{$root}{$attr}>";
 57:         $xml .= self::data2Xml($data, $item, $id);
 58:         $xml .= "</{$root}>";
 59: 
 60:         return $xml;
 61:     }
 62: 
 63:     /**
 64:      * Build CDATA.
 65:      *
 66:      * @param string $string
 67:      *
 68:      * @return string
 69:      */
 70:     public static function cdata($string)
 71:     {
 72:         return sprintf('<![CDATA[%s]]>', $string);
 73:     }
 74: 
 75:     /**
 76:      * Object to array.
 77:      *
 78:      *
 79:      * @param SimpleXMLElement $obj
 80:      *
 81:      * @return array
 82:      */
 83:     protected static function normalize($obj)
 84:     {
 85:         $result = null;
 86: 
 87:         if (is_object($obj)) {
 88:             $obj = (array)$obj;
 89:         }
 90: 
 91:         if (is_array($obj)) {
 92:             foreach ($obj as $key => $value) {
 93:                 $res = self::normalize($value);
 94:                 if (('@attributes' === $key) && ($key)) {
 95:                     $result = $res; // @codeCoverageIgnore
 96:                 } else {
 97:                     $result[$key] = $res;
 98:                 }
 99:             }
100:         } else {
101:             $result = $obj;
102:         }
103: 
104:         return $result;
105:     }
106: 
107:     /**
108:      * Array to XML.
109:      *
110:      * @param array $data
111:      * @param string $item
112:      * @param string $id
113:      *
114:      * @return string
115:      */
116:     protected static function data2Xml($data, $item = 'item', $id = 'id')
117:     {
118:         $xml = $attr = '';
119: 
120:         foreach ($data as $key => $val) {
121:             if (is_numeric($key)) {
122:                 $id && $attr = " {$id}=\"{$key}\"";
123:                 $key = $item;
124:             }
125: 
126:             $xml .= "<{$key}{$attr}>";
127: 
128:             if ((is_array($val) || is_object($val))) {
129:                 $xml .= self::data2Xml((array)$val, $item, $id);
130:             } else {
131:                 $xml .= is_numeric($val) ? $val : self::cdata($val);
132:             }
133: 
134:             $xml .= "</{$key}>";
135:         }
136: 
137:         return $xml;
138:     }
139: 
140:     /**
141:      * Delete invalid characters in XML.
142:      *
143:      * @see https://www.w3.org/TR/2008/REC-xml-20081126/#charsets - XML charset range
144:      * @see http://php.net/manual/en/regexp.reference.escape.php - escape in UTF-8 mode
145:      *
146:      * @param string $xml
147:      *
148:      * @return string
149:      */
150:     public static function sanitize($xml)
151:     {
152:         return preg_replace('/[^\x{9}\x{A}\x{D}\x{20}-\x{D7FF}\x{E000}-\x{FFFD}\x{10000}-\x{10FFFF}]+/u', '', $xml);
153:     }
154: }
