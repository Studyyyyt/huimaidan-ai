266:     protected function getAuthorization(string $url, string $method, string $body)
267:     {
268:         $nonce_str = uniqid();
269:         $timestamp = time();
270:         $message = $method . "\n" .
271:             $url . "\n" .
272:             $timestamp . "\n" .
273:             $nonce_str . "\n" .
274:             $body . "\n";
275:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
276:         $sign = base64_encode($raw_sign);
277:         $schema = 'WECHATPAY2-SHA256-RSA2048 ';
278:         $token = sprintf('mchid="%s",nonce_str="%s",timestamp="%d",serial_no="%s",signature="%s"',
279:             ($this->isService ? $this->app['config']['service_payment']['merchant_id'] : $this->app['config']['payment']['merchant_id']),
280:             $nonce_str,
281:             $timestamp,
282:             ($this->isService ? $this->app['config']['service_payment']['serial_no'] : $this->app['config']['payment']['serial_no']),
283:             $sign);
284: 
285:         return $schema . $token;
286:     }
287: 
288:     /**
289:      * 获取商户私钥
290:      * @return bool|resource
291:      */
292:     protected function getPrivateKey()
293:     {
294:         $key_path = $this->isService ?
295:             $this->app['config']['service_payment']['key_path'] :
296:             $this->app['config']['payment']['key_path'];
297:         if (!file_exists($key_path) || !is_file($key_path)) {
298:             throw new \InvalidArgumentException("【请上传".($this->isService ? '服务商':'微信')."支付书】SSL certificate not found");
299:         }
300:         return openssl_pkey_get_private(file_get_contents($key_path));
301:     }
302: 
303:     /**
304:      * decrypt ciphertext.
305:      *
306:      * @param array $encryptCertificate
307:      *
308:      * @return string
309:      */
310:     public function decrypt(array $encryptCertificate)
311:     {
312:         $ciphertext = base64_decode($encryptCertificate['ciphertext'], true);
313:         $associatedData = $encryptCertificate['associated_data'];
314:         $nonceStr = $encryptCertificate['nonce'];
315:         $aesKey = ($this->isService ? $this->app['config']['service_payment']['apiv3_key'] : $this->app['config']['payment']['apiv3_key']);
316:         if (strlen($aesKey) !== 32) {
317:             throw new InvalidArgumentException('The length of the key must be 32 bytes');
318:         }
319:         try {
320:             // ext-sodium (default installed on >= PHP 7.2)
321:             if (function_exists('\sodium_crypto_aead_aes256gcm_is_available') && \sodium_crypto_aead_aes256gcm_is_available()) {
322:                 return \sodium_crypto_aead_aes256gcm_decrypt($ciphertext, $associatedData, $nonceStr, $aesKey);
323:             }
324:             // ext-libsodium (need install libsodium-php 1.x via pecl)
325:             if (function_exists('\Sodium\crypto_aead_aes256gcm_is_available') && \Sodium\crypto_aead_aes256gcm_is_available()) {
326:                 return \Sodium\crypto_aead_aes256gcm_decrypt($ciphertext, $associatedData, $nonceStr, $aesKey);
327:             }
328:             // openssl (PHP >= 7.1 support AEAD)
329:             if (PHP_VERSION_ID >= 70100 && in_array('aes-256-gcm', \openssl_get_cipher_methods())) {
330:                 $ctext = substr($ciphertext, 0, -self::AUTH_TAG_LENGTH_BYTE);
331:                 $authTag = substr($ciphertext, -self::AUTH_TAG_LENGTH_BYTE);
332:                 return \openssl_decrypt($ctext, 'aes-256-gcm', $aesKey, \OPENSSL_RAW_DATA, $nonceStr, $authTag, $associatedData);
333:             }
334:         } catch (\Exception $exception) {
335:             throw new InvalidArgumentException($exception->getMessage(), $exception->getCode());
336:         } catch (\SodiumException $exception) {
337:             throw new InvalidArgumentException($exception->getMessage(), $exception->getCode());
338:         }
339:         throw new InvalidArgumentException('AEAD_AES_256_GCM 需要 PHP 7.1 以上或者安装 libsodium-php');
340:     }
341: }
</file>

