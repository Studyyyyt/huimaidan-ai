 515:         }else if($result->return_code == 'FAIL'){
 516:             throw new ValidateException('微信扫码枪支付错误返回：' . $result->return_msg);
 517:         }
 518: 
 519:         return [
 520:             'paid' => $paid,
 521:             'transaction_id' => $transaction_id ?? 0,
 522:             'payInfo' => $result
