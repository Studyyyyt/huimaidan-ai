 12: namespace crmeb\services\upload\extend\cos;
 13: 
 14: /**
 15:  * Class 生成签名
 16:  * @author 等风来
 17:  * @email 136327134@qq.com
 18:  * @date 2022/9/26
 19:  * @package crmeb\services\upload\extend\cos
 20:  */
 21: class Signature
 22: {
 23:     /**
 24:      * @var string
 25:      */
 26:     private $accessKey;
 27: 
 28:     /**
 29:      * @var string
 30:      */
 31:     private $secretKey;
 32: 
 33:     /**
 34:      * @var array
 35:      */
 36:     private $options;
 37: 
 38:     /**
 39:      * Signature constructor.
 40:      * @param string $accessKey
 41:      * @param string $secretKey
 42:      * @param array $options
 43:      * @param string $token
 44:      */
 45:     public function __construct(string $accessKey, string $secretKey, array $options = [], string $token = '')
 46:     {
 47:         $this->accessKey = $accessKey;
 48:         $this->secretKey = $secretKey;
 49:         $this->options = $options;
 50:         $this->token = $token;
 51:         $this->signHeader = [
 52:             'cache-control',
 53:             'content-disposition',
 54:             'content-encoding',
 55:             'content-length',
 56:             'content-md5',
 57:             'content-type',
 58:             'expect',
 59:             'expires',
 60:             'host',
 61:             'if-match',
 62:             'if-modified-since',
 63:             'if-none-match',
 64:             'if-unmodified-since',
 65:             'origin',
 66:             'range',
 67:             'response-cache-control',
 68:             'response-content-disposition',
 69:             'response-content-encoding',
 70:             'response-content-language',
 71:             'response-content-type',
 72:             'response-expires',
 73:             'transfer-encoding',
 74:             'versionid',
 75:         ];
 76:         date_default_timezone_set('PRC');
 77:     }
 78: 
 79:     public function needCheckHeader($header)
 80:     {
 81:         if ($this->startWith($header, 'x-cos-')) {
 82:             return true;
 83:         }
 84:         if (in_array($header, $this->signHeader)) {
 85:             return true;
 86:         }
 87:         return false;
 88:     }
 89: 
 90:     /**
 91:      * @author 等风来
 92:      * @email 136327134@qq.com
 93:      * @date 2022/9/29
 94:      * @param $haystack
 95:      * @param $needle
 96:      * @return bool
 97:      */
 98:     protected function startWith($haystack, $needle)
 99:     {
100:         $length = strlen($needle);
101:         if ($length == 0) {
102:             return true;
103:         }
104:         return (substr($haystack, 0, $length) === $needle);
105:     }
106: 
107:     /**
108:      * @param string $method
109:      * @param string $urlPath
110:      * @param array $querys
111:      * @param array $headers
112:      * @return string[]
113:      * @author 等风来
114:      * @email 136327134@qq.com
115:      * @date 2022/9/26
116:      */
117:     public function signRequest(string $method, string $urlPath, array $querys = [], array $headers = [])
118:     {
119:         $authorization = $this->createAuthorization($method, $urlPath, $querys, $headers);
120:         return ['Authorization' => $authorization];
121:     }
122: 
123:     /**
124:      * @param string $method
125:      * @param string $urlPath
126:      * @param array $querys
127:      * @param array $headers
128:      * @param string $expires
129:      * @return string
130:      * @author 等风来
131:      * @email 136327134@qq.com
132:      * @date 2022/9/26
133:      */
134:     public function createAuthorization(string $method, string $urlPath, array $querys = [], array $headers = [], $expires = '+30 minutes')
135:     {
136:         if (is_null($expires) || !strtotime($expires)) {
137:             $expires = '+30 minutes';
138:         }
139:         $signTime = ( string )(time() - 60) . ';' . ( string )(strtotime($expires));
140:         $urlParamListArray = [];
141:         foreach ($querys as $query) {
142:             if (!empty($query)) {
143:                 $tmpquery = explode('=', $query);
144:                 //为了保证CI的key中有=号的情况也能正常通过，ci在这层之前已经encode了，这里需要拆开重新encode，防止上方explode拆错
145:                 $key = strtolower(rawurlencode(urldecode($tmpquery[0])));
146:                 if (count($tmpquery) >= 2) {
147:                     $value = $tmpquery[1];
148:                 } else {
149:                     $value = "";
150:                 }
151:                 //host开关
152:                 if (!$this->options['signHost'] && $key == 'host') {
153:                     continue;
154:                 }
155:                 $urlParamListArray[$key] = $key . '=' . $value;
156:             }
157:         }
158:         ksort($urlParamListArray);
159:         $urlParamList = join(';', array_keys($urlParamListArray));
160:         $httpParameters = join('&', array_values($urlParamListArray));
161: 
162:         $headerListArray = [];
163:         foreach ($headers as $key => $value) {
164:             $key = strtolower(urlencode($key));
165:             $value = rawurlencode($value);
166:             if (!$this->options['signHost'] && $key == 'host') {
167:                 continue;
168:             }
169:             if ($this->needCheckHeader($key)) {
170:                 $headerListArray[$key] = $key . '=' . $value;
171:             }
172:         }
173:         ksort($headerListArray);
174:         $headerList = join(';', array_keys($headerListArray));
175:         $httpHeaders = join('&', array_values($headerListArray));
176:         $httpString = strtolower($method) . "\n" . urldecode($urlPath) . "\n" . $httpParameters .
177:             "\n" . $httpHeaders . "\n";
178: 
179:         $sha1edHttpString = sha1($httpString);
180:         $stringToSign = "sha1\n$signTime\n$sha1edHttpString\n";
181:         $signKey = hash_hmac('sha1', $signTime, trim($this->secretKey));
182:         $signature = hash_hmac('sha1', $stringToSign, $signKey);
183:         $authorization = 'q-sign-algorithm=sha1&q-ak=' . trim($this->accessKey) .
184:             "&q-sign-time=$signTime&q-key-time=$signTime&q-header-list=$headerList&q-url-param-list=$urlParamList&" .
185:             "q-signature=$signature";
186:         return $authorization;
187:     }
188: 
189:     /**
190:      * @param string $url
191:      * @param string $method
192:      * @param string $urlPath
193:      * @param array $querys
194:      * @param array $headers
195:      * @param string $expires
196:      * @return string[]
197:      * @author 等风来
198:      * @email 136327134@qq.com
199:      * @date 2022/9/26
200:      */
201:     public function createPresignedUrl(string $url, string $method, string $urlPath, array $querys = [], array $headers = [], string $expires = '+30 minutes')
202:     {
203:         $authorization = $this->createAuthorization($method, $urlPath, $querys, $headers, $expires);
204:         $uri = $url;
205:         $query = 'sign=' . urlencode($authorization) . '&' . implode('&', $querys);
206:         if ($this->token != null) {
207:             $query = $query . '&x-cos-security-token=' . $this->token;
208:         }
209:         return [$uri, $query];
210:     }
211: }
