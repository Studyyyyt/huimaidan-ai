241:      */
242:     public function setExcelContent($data = [])
243:     {
244:         if (!empty($data) && is_array($data)) {
245:             $column = self::$topNumber+1;
246:             // 行写入
247:             foreach ($data as $key => $rows) {
248:                 $span = 'A';
249:                 // 列写入
250:                 foreach ($rows as $keyName => $value) {
251:                     self::$sheet->setCellValue($span . $column, $value);
252:                     $span++;
253:                 }
254:                 $column++;
255:             }
256:             $span = chr(ord($span) -1);
257:             self::$colum = $column;
258:             self::$sheet->getDefaultRowDimension()->setRowHeight(self::$height);
