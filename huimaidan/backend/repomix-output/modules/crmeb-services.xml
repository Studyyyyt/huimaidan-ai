313:             }
314:         } else {
315:             if ($this->isV3()) {
316:                 if ($trade_type == 'MWEB') $trade_type = 'H5';
317:                 $payFunction = 'pay' . ucfirst($trade_type);
318:                 return $this->service->v3Pay->{$payFunction}($order);
319:             } else {
320:                 $result = $this->paymentService()->prepare($order);
321:                 if ($result->return_code == 'SUCCESS' && $result->result_code == 'SUCCESS') {
322:                     return $result->prepay_id;
323:                 } else {
324:                     if ($result->return_code == 'FAIL') {
325:                         throw new ValidateException('微信支付错误返回：' . $result->return_msg);
326:                     } else if (isset($result->err_code)) {
327:                         throw new ValidateException('微信支付错误返回：' . $result->err_code_des);
328:                     } else {
329:                         throw new ValidateException('没有获取微信支付的预支付ID，请重新发起支付!');
330:                     }
331:                 }
332:             }
333:         }
334:     }
