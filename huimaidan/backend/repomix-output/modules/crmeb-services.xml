252:     {
253:         if ($time) {
254:             $file = $this->getFile('time', $time);
255:             array_map("unlink", $this->getFile('time', $time));
256:             if (count($this->getFile('time', $time))) {
257:                 throw new \Exception("File {$time} deleted failed");
258:             } else {
259:                 return $time;
260:             }
261:         } else {
262:             throw new \Exception("{$time} Time parameter is incorrect");
263:         }
