193:     protected function encryptSensitiveInformation(string $string)
194:     {
195:         $encrypted = '';
196:         $is = $this->isService ? 'service_payment':'payment';
197:         if ($this->app['config']['type'] == 'wechat') {
198:             $public_key = $this->app['config'][$is]['pay_weixin_public_key'];
199:         } else {
200:             $public_key = $this->app['config'][$is]['pay_routine_public_key'];
201:         }
202:         if ($public_key && ($this->isService || $this->app['config']['is_v3'])) {
203:             $public_key = rtrim(public_path(),'/').$public_key;
204:             //如果获取公钥成功则返回
205:             if ($public_key) {
206:                 if (!is_file($public_key))
207:                     throw new InvalidConfigException('公钥文件不存在');
208:                 $public_content = file_get_contents($public_key);
209:                 if (openssl_public_encrypt($string, $encrypted, $public_content,
210:                     OPENSSL_PKCS1_OAEP_PADDING)) {
211:                     //base64编码
212:                     $sign = base64_encode($encrypted);
213:                     return  $sign;
214:                 } else {
215:                     throw new InvalidConfigException('encrypt failed');
216:                 }
217:             }
218:         }
219: 
220:         $certificates = $this->app->certficates->setServiceStatus($this->isService)->get()['certificates'];
221:         if (null === $certificates) {
222:             throw new InvalidConfigException('config certificate connot be empty.');
223:         }
224:         if (openssl_public_encrypt($string, $encrypted, $certificates, OPENSSL_PKCS1_OAEP_PADDING)) {
225:             //base64编码
226:             $sign = base64_encode($encrypted);
227:         } else {
228:             throw new EncryptionException('Encryption of sensitive information failed');
229:         }
230: 
231:         return $sign;
232:     }
