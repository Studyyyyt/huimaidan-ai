356:                 if(!(is_integer($config['durationSeconds']))){
357:                     throw new Exception("durationSeconds must be a int type");
358:                 }
359:             }
360:             $params = array(
361:                 'SecretId'=> $config['secretId'],
362:                 'Timestamp'=> $Timestamp,
363:                 'Nonce'=> $Nonce,
364:                 'Action'=> $Action,
365:                 'DurationSeconds'=> $config['durationSeconds'],
366:                 'Version'=>'2018-08-13',
367:                 'Name'=> 'cos',
368:                 'Region'=> $config['region'],
369:                 'Policy'=> urlencode($policyStr)
370:             );
371:             $params['Signature'] = $this->getSignature($params, $config['secretKey'], $Method, $config);
372:             $url = $config['url'];
373:             $ch = curl_init($url);
374:             if(array_key_exists('proxy', $config)){
375:                 $config['proxy'] && curl_setopt($ch, CURLOPT_PROXY, $config['proxy']);
376:             }
377:             curl_setopt($ch, CURLOPT_HEADER, 0);
378:             curl_setopt($ch,CURLOPT_SSL_VERIFYPEER,0);
379:             curl_setopt($ch,CURLOPT_SSL_VERIFYHOST,0);
380:             curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
381:             curl_setopt($ch, CURLOPT_POST, 1);
382:             curl_setopt($ch, CURLOPT_POSTFIELDS, $this->json2str($params));
383:             $result = curl_exec($ch);
384:             if(curl_errno($ch)) $result = curl_error($ch);
385:             curl_close($ch);
386:             $result = json_decode($result, 1);
387:             if (isset($result['Response'])) {
388:                 $result = $result['Response'];
389:                 if(isset($result['Error'])){
390:                     throw new Exception("get cam failed");
391:                 }
392:                 $result['startTime'] = $result['ExpiredTime'] - $config['durationSeconds'];
393:             }
394:             $result = $this->backwardCompat($result);
395:             $result['url'] = $this->uploadUrl . '/';
396:             $result['type'] = 'COS';
397:             $result['cdn'] = $this->cdn;
398:             $result['bucket'] = $this->storageName;
399:             $result['region'] = $this->storageRegion;
400:             return $result;
401:         }catch(\Exception $e){
402:             if($result == null){
403:                 $result = "error: " . + $e->getMessage();
404:             }else{
405:                 $result = json_encode($result);
406:             }
407:             throw new Exception($result);
408:         }
409:     }
