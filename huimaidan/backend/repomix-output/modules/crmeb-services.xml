448:      * @date 2022/10/17
449:      */
450:     public function noBodyRequest(string $method, string $bucket, string $region = '', string $acl = null, bool $isExc = true)
451:     {
452: 
453:         $url = $this->getRequestHost($bucket, $region);
454: 
455:         $header = [
456:             'Host' => $url
457:         ];
458: 
459:         if ($acl) {
460:             $header['x-cos-acl'] = $acl;
461:         }
462: 
463:         if (in_array($method, ['put', 'post'])) {
464:             $header['Content-Length'] = 0;
465:         }
466: 
467:         $res = $this->request('https://' . $url . '/' . ($this->action ? '?' . $this->action : ''), $method, [], $header);
468:         $this->action = '';
469: 
470:         if ($isExc) {
471:             if ($res && !empty($res['Message'])) {
472:                 throw new UploadException($res['Message']);
473:             }
474:         }
475: 
476:         return $res;
477:     }
