267:      * 下载备份
268:      *
269:      * @param $time
270:      * @param int $part
271:      * @throws \Exception
272:      */
273:     public function downloadFile($time, $part = 0)
274:     {
275:         $file = $this->getFile('time', $time);
276:         $fileName = $file[$part];
277:         if (file_exists($fileName)) {
278:             ob_end_clean();
279:             header("Cache-Control: must-revalidate, post-check=0, pre-check=0");
280:             header('Content-Description: File Transfer');
