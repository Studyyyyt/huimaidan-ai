 16: 
 17: use app\common\repositories\system\attachment\AttachmentRepository;
 18: use app\common\repositories\system\merchant\MerchantRepository;
 19: use app\common\repositories\wechat\RoutineQrcodeRepository;
 20: use Endroid\QrCode\QrCode;
 21: use think\exception\ValidateException;
 22: use think\facade\Config;
 23: 
 24: class QrcodeService
 25: {
 26: 
 27:     /**
 28:      * 获取二维码
 29:      * @param $url
 30:      * @param $name
 31:      * @return array|bool|string
 32:      */
 33:     public function getQRCodePath($url, $name)
 34:     {
 35:         if (!strlen(trim($url)) || !strlen(trim($name))) return false;
 36:         try {
 37:             $uploadType = systemConfig('upload_type');
 38:             //TODO 没有选择默认使用本地上传
 39:             if (!$uploadType) $uploadType = 1;
 40:             $uploadType = (int)$uploadType;
 41:             $siteUrl = systemConfig('site_url');
 42:             if (!$siteUrl) return '请前往后台设置->系统设置->网站域名 填写您的域名格式为：http://域名';
 43:             $info = [];
 44:             $outfile = Config::get('qrcode.cache_dir');
 45:             $code = new QrCode($url);
 46:             if ($uploadType === 1) {
 47:                 if (!is_dir('./public/' . $outfile))
 48:                     mkdir('./public/' . $outfile, 0777, true);
 49:                 $code->writeFile('./public/' . $outfile . '/' . $name);
 50:                 $info["code"] = 200;
 51:                 $info["name"] = $name;
 52:                 $info["dir"] = rtrim($siteUrl, '/') . '/' . $outfile . '/' . $name;
 53:                 $info["time"] = time();
 54:                 $info['size'] = 0;
 55:                 $info['type'] = 'image/png';
 56:                 $info["image_type"] = 1;
 57:                 $info['thumb_path'] = $info["dir"];
 58:                 return $info;
 59:             } else {
 60:                 $upload = UploadService::create($uploadType);
 61:                 $res = $upload->to('/public/' . $outfile)->validate()->stream($code->writeString(), $name);
 62:                 if ($res === false) {
 63:                     return $upload->getError();
 64:                 }
 65:                 $info = $upload->getUploadInfo();
 66:                 $info['image_type'] = $uploadType;
 67:                 return $info;
 68:             }
 69:         } catch (\Exception $e) {
 70:             return $e->getMessage();
 71:         }
 72:     }
 73: 
 74: 
 75:     /**
 76:      * 获取二维码完整路径，不存在则自动生成
 77:      * @param string $name 路径名
 78:      * @param string $link 需要生成二维码的跳转路径
 79:      * @param bool $force 是否返回false
 80:      * @return bool|mixed|string
 81:      */
 82:     public function getWechatQrcodePath(string $name, string $link, bool $force = false, $key = '')
 83:     {
 84:         $imageInfo = app()->make(AttachmentRepository::class)->getWhere(['attachment_name' => $name]);
 85:         if($imageInfo) {
 86:             return $imageInfo['attachment_src'];
 87:         }
 88: 
 89:         $siteUrl = rtrim(systemConfig('site_url'), '/');
 90:         $codeUrl = tidy_url($link, null, $siteUrl);
 91:         if ($key && systemConfig('open_wechat_share')) {
 92:             $qrcode = WechatService::create(false)->qrcodeService();
 93:             $codeUrl = $qrcode->forever('_scan_url_' . $key)->url;
 94:         }
 95: 
 96:         $imageInfo = $this->getQRCodePath($codeUrl, $name);
 97:         if (is_string($imageInfo) && $force)  {
 98:             return false;
 99:         }
100:         if (is_string($imageInfo)) {
101:             throw new ValidateException('请检查存储配置，错误提示：'.$imageInfo);
102:         }
103: 
104:         $imageInfo['dir'] = tidy_url($imageInfo['dir'], null, $siteUrl);
105:         app()->make(AttachmentRepository::class)->create($imageInfo['image_type'], -1, 0, [
106:             'attachment_category_id' => 0,
107:             'attachment_name' => $imageInfo['name'],
108:             'attachment_src' => $imageInfo['dir']
109:         ]);
110:         return $imageInfo['dir'];
111:     }
112: 
113:     /**
114:      * 获取小程序分享二维码
115:      * @param int $id
116:      * @param int $uid
117:      * @param int $type 1 = 拼团,2 = 秒杀
118:      * @param array $parame
119:      * @return bool|string
120:      */
121:     public function hotQrcodePath(int $id, int $uid, int $type, array $parame = [])
122:     {
123:         $page = '';
124:         $namePath = '';
125:         $data = 'id=' . $id . '&spid=' . $uid;
126:         switch ($type) {
127:             case 1:
128:                 $page = 'pages/activity/goods_combination_details/index';
129:                 $namePath = 'combination_' . $id . '_' . $uid . '.jpg';
130:                 break;
131:             case 2:
132:                 $page = 'pages/activity/goods_seckill_details/index';
133:                 $namePath = 'seckill_' . $id . '_' . $uid . '.jpg';
134:                 if (isset($parame['stop_time']) && $parame['stop_time']) {
135:                     $data .= '&time=' . $parame['stop_time'];
136:                     $namePath = $parame['stop_time'] . $namePath;
137:                 }
138:                 break;
139:         }
140:         if (!$page || !$namePath) {
141:             return false;
142:         }
143: 
144:         return $this->getRoutineQrcodePath($namePath, $page, $data);
145:     }
146: 
147:     /**
148:      * @param $namePath
149:      * @param $page
150:      * @param $data
151:      * @return bool|int|mixed|string
152:      * @author xaboy
153:      * @day 2020/6/18
154:      */
155:     public function getRoutineQrcodePath($namePath, $page, $data, $to = 'routine/product')
156:     {
157:         //try {
158:             $attachmentRepository = app()->make(AttachmentRepository::class);
159:             $imageInfo =   $attachmentRepository->getWhere(['attachment_name' => $namePath]);
160:             if ($imageInfo) {
161:                 $url = $imageInfo['attachment_src'];
162:                 $urlArr = parse_url($url);
163:                 if (!$urlArr['path'] || !is_file(public_path().$urlArr['path']))
164:                     $imageInfo = null;
165:             }
166: 
167:             if (!$imageInfo) {
168:                 $res = app()->make(RoutineQrcodeRepository::class)->getPageCode($page, $data, 400);
169:                 if (!$res)  throw new ValidateException('二维码生成失败，请检查域名白名单等');
170:                 $uploadType = (int)systemConfig('upload_type') ?: 1;
171:                 $upload = UploadService::create($uploadType);
172:                 $res = $upload->to($to)->validate()->stream((string)$res, $namePath);
173:                 if ($res === false)
174:                     throw new ValidateException('文件流上传失败，存储类型：'.$uploadType);;
175:                 $imageInfo = $upload->getUploadInfo();
176:                 $imageInfo['image_type'] = $uploadType;
177:                 $imageInfo['dir'] = tidy_url($imageInfo['dir'], 0);
178:                 $remoteImage = remoteImage($imageInfo['dir']);
179:                 if (!$remoteImage['status'])  throw new ValidateException('小程序二维码生成失败');
180:                 $attachmentRepository->create($uploadType, -1, 0, [
181:                     'attachment_category_id' => 0,
182:                     'attachment_name' => $imageInfo['name'],
183:                     'attachment_src' => $imageInfo['dir']
184:                 ]);
185:                 $url = $imageInfo['dir'];
186:             }
187:             if (substr($url,0,5) != 'https')
188:                 throw new ValidateException('图片地址必须为hppts');
189:             return $url;
190:         //} catch (\Throwable $e) {
191:         //    throw new ValidateException($e->getMessage());
192:         //}
193:     }
194: 
195: }
