126:     public function move(string $file = 'file')
127:     {
128:         $fileHandle = app()->request->file($file);
129:         if (!$fileHandle) {
130:             return $this->setError('上传的文件不存在');
131:         }
132:         if ($this->validate) {
133:             if (!in_array($fileHandle->getOriginalExtension(), $this->validate['fileExt'])) {
134:                 return $this->setError('不合法的文件后缀:'.$fileHandle->getOriginalExtension());
135:             }
136:             if (filesize($fileHandle) > $this->validate['filesize']) {
137:                 return $this->setError('文件过大');
138:             }
139:             if (!in_array($fileHandle->getOriginalMime(), $this->validate['fileMime'])) {
140:                 return $this->setError('不合法的文件类型:'.$fileHandle->getOriginalMime());
141:             }
142:         }
143:         $key = $this->saveFileName($fileHandle->getRealPath(), $fileHandle->getOriginalExtension());
144:         $key = $this->getUploadPath($key);
145:         try {
146:             $uploadInfo = $this->app()->putObject([
147:                 'Bucket' => $this->storageName,
148:                 'Key' => $key,
149:                 'SourceFile' => $fileHandle->getRealPath()
150:             ]);
151:             if (!isset($uploadInfo['ObjectURL'])) {
152:                 return $this->setError('Upload failure');
153:             }
154:             $this->fileInfo->uploadInfo = $uploadInfo;
155:             $this->fileInfo->realName = isset($fileHandle) ? $fileHandle->getOriginalName() : $key;
156:             $this->fileInfo->filePath = ($this->cdn ?: $this->uploadUrl) . '/' . $key;
157:             $this->fileInfo->fileName = $key;
158: //            $this->fileInfo->filePathWater = $this->water($this->fileInfo->filePath);
159: //            $this->authThumb && $this->thumb($this->fileInfo->filePath);
160:             return $this->fileInfo;
