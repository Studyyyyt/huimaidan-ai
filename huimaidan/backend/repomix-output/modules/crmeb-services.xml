317:             $params['timestamp'] . "\n" .
318:             $params['noncestr'] . "\n" .
319:             $params['prepayid'] . "\n";
320:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
321:         $sign = base64_encode($raw_sign);
