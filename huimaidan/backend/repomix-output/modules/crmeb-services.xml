 12: namespace crmeb\services;
 13: 
 14: use app\common\repositories\system\config\ConfigValueRepository;
 15: use think\exception\ValidateException;
 16: use think\facade\Cache;
 17: 
 18: /**
 19:  * Class AccessTokenServeService
 20:  * @package crmeb\services
 21:  */
 22: class AccessTokenServeService extends HttpService
 23: {
 24:     /**
 25:      * 配置
 26:      * @var string
 27:      */
 28:     protected $account;
 29: 
 30:     /**
 31:      * @var string
 32:      */
 33:     protected $secret;
 34: 
 35:     /**
 36:      * @var Cache|null
 37:      */
 38:     protected $cache;
 39: 
 40:     /**
 41:      * @var string
 42:      */
 43:     protected $accessToken;
 44: 
 45:     /**
 46:      * @var string
 47:      */
 48:     protected $cacheTokenPrefix = "_crmeb_plat";
 49: 
 50:     /**
 51:      * @var string
 52:      */
 53:     protected $apiHost = 'http://sms.crmeb.net/api/v2/';
 54:     //protected $apiHost = 'https://test-api.crmeb.com/api/v2/';
 55: 
 56:     /**
 57:      * 沙盒地址
 58:      * @var string
 59:      */
 60:     protected $sandBoxApi = 'https://api_v2.crmeb.net/api/';
 61: 
 62:     /**
 63:      * 沙盒模式
 64:      * @var bool
 65:      */
 66:     protected $sandBox = false;
 67: 
 68:     /**
 69:      * 登录接口
 70:      */
 71:     const USER_LOGIN = "user/login";
 72: 
 73:     protected $merId;
 74: 
 75:     /**
 76:      * AccessTokenServeService constructor.
 77:      * @param string $account
 78:      * @param string $secret
 79:      * @param Cache|null $cache
 80:      */
 81:     public function __construct($config)
 82:     {
 83:         $this->account = $config['account'] ?? '';
 84:         $this->secret = $config['secret'] ?? '';
 85:         $this->merId = $config['merId'] ?? 0 ;
 86:     }
 87: 
 88:     /**
 89:      * 获取配置
 90:      * @return array
 91:      */
 92:     public function getConfig()
 93:     {
 94:         return [
 95:             'access_key' => $this->account,
 96:             'secret_key' => $this->secret
 97:         ];
 98:     }
 99: 
100:     /**
101:      * 获取缓存token
102:      * @return mixed
103:      * @throws \Psr\SimpleCache\InvalidArgumentException
104:      */
105:     public function getToken()
106:     {
107:         $accessTokenKey = md5($this->account . '_' . $this->secret . $this->cacheTokenPrefix);
108:         $cacheToken = Cache::get($accessTokenKey);
109:         if (!$cacheToken) {
110:             $getToken = $this->getTokenFromServer();
111:             Cache::set($accessTokenKey, $getToken['access_token'], 300);
112:             $cacheToken = $getToken['access_token'];
113:         }
114:         $this->accessToken = $cacheToken;
115: 
116:         return $cacheToken;
117:     }
118: 
119:     /**
120:      * 从服务器获取token
121:      * @return mixed
122:      */
123:     public function getTokenFromServer()
124:     {
125:         $params = $this->getConfig();
126:         if (!$this->account || !$this->secret ) {
127:             $msg = $this->merId ? '请先配置:设置 》一号通 》配置管理 》一号通' : '请先配置:设置 》第三方接口 》一号通';
128:             throw new ValidateException($msg);
129:         }
130:         $response = $this->postRequest($this->get(self::USER_LOGIN), $params);
131:         $response = json_decode($response, true);
132:         if (!$response) {
133:             throw new ValidateException('获取token失败');
134:         }
135:         if ($response['status'] === 200) {
136:             return $response['data'];
137:         } else {
138:             throw new ValidateException($response['msg']);
139:         }
140:     }
141: 
142:     /**
143:      * 请求
144:      * @param string $url
145:      * @param array $data
146:      * @param string $method
147:      * @param bool $isHeader
148:      * @return array|mixed
149:      */
150:     public function httpRequest(string $url, array $data = [], string $method = 'POST', bool $isHeader = true,$header = [])
151:     {
152:         if ($isHeader) {
153:             $this->getToken();
154:             if (!$this->accessToken) {
155:                 throw new ValidateException('配置已更改或token已失效');
156:             }
157:             $header =  array_merge(['Authorization:Bearer-' . $this->accessToken] , $header);
158:         }
159:         $res = $this->request($this->get($url), $method, $data, $header);
160:         if (!$res) {
161:             throw new ValidateException('平台错误：发生异常，请稍后重试');
162:         }
163:         $result = json_decode($res, true) ?: false;
164:         if (!isset($result['status']) || $result['status'] != 200) {
165:             if ($result['msg'] == '接口请求失败:用户或密码错误') {
166:                app()->make(CrmebServeServices::class)->logout();
167:             }
168:             throw new ValidateException(isset($result['msg']) ? '平台错误：' . $result['msg'] : '平台错误：发生异常，请稍后重试');
169:         }
170:         return $result['data'] ?? [];
171: 
172:     }
173: 
174:     /**
175:      * @param string $apiUrl
176:      * @return string
177:      */
178:     public function get(string $apiUrl = '')
179:     {
180:         $host = $this->sandBox ? $this->sandBoxApi : $this->apiHost;
181:         return $host . $apiUrl;
182:     }
183: }
