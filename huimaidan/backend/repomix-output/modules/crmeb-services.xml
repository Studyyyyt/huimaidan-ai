 11: 
 12: namespace crmeb\services\upload;
 13: 
 14: /**
 15:  * 基础请求
 16:  * Class BaseClient
 17:  * @author 等风来
 18:  * @email 136327134@qq.com
 19:  * @date 2023/5/18
 20:  * @package crmeb\services\upload
 21:  */
 22: abstract class BaseClient
 23: {
 24: 
 25:     /**
 26:      * 是否解析为xml
 27:      * @var bool
 28:      */
 29:     protected $isXml = true;
 30: 
 31:     /**
 32:      *
 33:      * @var []callable
 34:      */
 35:     protected $curlFn = [];
 36: 
 37:     /**
 38:      * @param callable $curlFn
 39:      * @return $this
 40:      * @author 等风来
 41:      * @email 136327134@qq.com
 42:      * @date 2023/5/18
 43:      */
 44:     public function middleware(callable $curlFn)
 45:     {
 46:         $this->curlFn[] = $curlFn;
 47:         return $this;
 48:     }
 49: 
 50:     /**
 51:      * 发起请求
 52:      * @param string $url
 53:      * @param string $method
 54:      * @param array $data
 55:      * @param array $clientHeader
 56:      * @param int $timeout
 57:      * @return array|extend\cos\SimpleXMLElement
 58:      * @author 等风来
 59:      * @email 136327134@qq.com
 60:      * @date 2023/5/18
 61:      */
 62:     protected function requestClient(string $url, string $method, array $data = [], array $clientHeader = [], int $timeout = 10)
 63:     {
 64:         $headers = [];
 65:         foreach ($clientHeader as $key => $item) {
 66:             $headers[] = $key . ':' . $item;
 67:         }
 68:         $curl = curl_init($url);
 69:         //请求方式
 70:         curl_setopt($curl, CURLOPT_CUSTOMREQUEST, $method);
 71:         //post请求
 72:         if (!empty($data['body'])) {
 73:             curl_setopt($curl, CURLOPT_POSTFIELDS, $data['body']);
 74:         } else if (!empty($data['json'])) {
 75:             curl_setopt($curl, CURLOPT_POSTFIELDS, json_encode($data['json']));
 76:         } else {
 77:             $curlFn = $this->curlFn;
 78:             foreach ($curlFn as $item) {
 79:                 if ($item instanceof \Closure) {
 80:                     $curlFn($curl);
 81:                 }
 82:             }
 83:         }
 84:         //超时时间
 85:         curl_setopt($curl, CURLOPT_TIMEOUT, $timeout);
 86:         //设置header头
 87:         curl_setopt($curl, CURLOPT_HTTPHEADER, $headers);
 88: 
 89:         curl_setopt($curl, CURLOPT_FAILONERROR, false);
 90:         //返回抓取数据
 91:         curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
 92:         //输出header头信息
 93:         curl_setopt($curl, CURLOPT_HEADER, true);
 94:         //TRUE 时追踪句柄的请求字符串，从 PHP 5.1.3 开始可用。这个很关键，就是允许你查看请求header
 95:         curl_setopt($curl, CURLINFO_HEADER_OUT, true);
 96:         //https请求
 97:         if (1 == strpos("$" . $url, "https://")) {
 98:             curl_setopt($curl, CURLOPT_SSL_VERIFYPEER, false);
 99:             curl_setopt($curl, CURLOPT_SSL_VERIFYHOST, false);
100:         }
101:         [$content, $status] = [curl_exec($curl), curl_getinfo($curl)];
102:         $content = trim(substr($content, $status['header_size']));
103:         if ($this->isXml) {
104:             return XML::parse($content);
105:         } else {
106:             return json_decode($content, true);
107:         }
108:     }
109: }
</file>

