 40:     /**
 41:      * 一号通查询
 42:      * @param $no
 43:      * @param $type
 44:      * @return array
 45:      * @author Qinii
 46:      * @day 8/28/21
 47:      */
 48:     public static function serve($no,$type,$phone)
 49:     {
 50:         $res = app()->make(CrmebServeServices::class)->express()->query($no,'',$phone);
 51:         if (!$res) $res = app()->make(CrmebServeServices::class)->express()->query($no,$type,$phone);
 52:         $cacheTime = 1800;
 53:         if(!empty($res)){
 54:             if($res['status'] == 3){
 55:                 $cacheTime = 0;
 56:             }
 57:         }
 58:         $list = $res['content'] ?? [];
 59:         return compact('cacheTime','list');
 60:     }
 61: 
 62:     /**
 63:      * 阿里云查询
 64:      * @param $no
 65:      * @param $re
 66:      * @return array|bool
 67:      * @author Qinii
 68:      * @day 8/28/21
 69:      */
 70:     public static function ali($no, $re)
 71:     {
 72:         //阿里云
 73:         $appCode = systemConfig('express_app_code');
 74:         if (!$appCode) return false;
 75:         $type = '';
 76: 
 77:         $res = HttpService::getRequest(self::API, compact('no', 'type'), ['Authorization:APPCODE ' . $appCode]);
 78:         if (!$res) throw new ValidateException('未查询到快递信息,请确认单号及余额是否充足');
 79:         $result = json_decode($res, true) ?: null;
 80: 
 81:         if(!is_null($result) && $result['status'] != 200){
 82:             if (in_array($result['status'],[201,203,204,207,205])){
 83:                 throw new ValidateException($result['msg']);
 84:             }
 85:         }
 86:         $cacheTime = 1800;
 87:         if (is_array($result) && isset($result['result']) && isset($result['result']['deliverystatus']) && $result['result']['deliverystatus'] >= 3){
 88:             $cacheTime = 0;
 89:         }
 90:         $list = $result['result']['list'] ?? [];
 91:         return compact('cacheTime','list');
 92:     }
