 27:     const DEFAULT_FAIL_CODE = 400;
 28: 
 29:     public function __construct(Json $response)
 30:     {
 31:         $this->response = $response;
 32:     }
 33: 
 34:     public function code(int $code)
 35:     {
 36:         $this->response->code($code);
 37: 
 38:         return $this;
 39:     }
 40: 
 41:     /**
 42:      * @param $data
 43:      * @return array|string|null
 44:      */
 45:     private function parseData($data)
 46:     {
 47:         if ($data instanceof Arrayable)
 48:             return $data->toArray();
 49:         else
 50:             return $data;
 51:     }
 52: 
 53:     /**
 54:      * @param int $status
 55:      * @param string $message
 56:      * @param array|Arrayable|null $data
 57:      * @return Json
 58:      */
 59:     public function make(int $status, string $message, $data = null): Json
 60:     {
 61:         $content = compact('status', 'message');
 62:         if (!is_null($data))
 63:             $content['data'] = $this->parseData($data);
 64:         $this->response->data($content);
 65:         return $this->response;
 66:     }
 67: 
 68:     /**
 69:      * @param string|array|Arrayable $message
 70:      * @param array|Arrayable|null $data
 71:      * @return Json
 72:      */
 73:     public function success($message = self::DEFAULT_SUCCESS_MESSAGE, $data = null)
 74:     {
 75:         $message = $this->parseData($message);
 76:         if (is_array($message)) {
 77:             $data = $message;
 78:             $message = self::DEFAULT_SUCCESS_MESSAGE;
 79:         } else {
 80:             $data = $this->parseData($data);
 81:         }
 82:         return $this->make(self::DEFAULT_SUCCESS_CODE, $message, $data);
 83:     }
 84: 
 85: 
 86:     public function encode($message = self::DEFAULT_SUCCESS_MESSAGE, $data = null)
 87:     {
 88:         $message = $this->parseData($message);
 89:         if (is_array($message)) {
 90:             $data = $message;
 91:             $message = self::DEFAULT_SUCCESS_MESSAGE;
 92:         } else {
 93:             $data = $this->parseData($data);
 94:         }
 95:         $status = self::DEFAULT_SUCCESS_CODE;
 96:         $encode = true;
 97:         $content = compact('status','encode', 'message');
 98:         if (is_null($data) || env('APP_DEBUG', false))
 99:             return $this->success($message, $data['data'] ?? $data);
100:         if (!is_array($data) || !isset($data['data'])) {
101:             $res['data'] = $data;
102:         } else {
103:             $res = $data;
104:         }
105:         $res['status'] = $status;
106:         $res['message'] = $message;
107:         $content['data'] =  base64_encode(gzdeflate(json_encode($res,JSON_UNESCAPED_UNICODE),9));
108:         $this->response->data($content);
109:         return $this->response;
110:     }
111: 
112:     /**
113:      * @param string|array|Arrayable $message
114:      * @param array|Arrayable|null $data
115:      * @return Json
116:      */
117:     public function fail($message = self::DEFAULT_FAIL_MESSAGE, $data = null)
118:     {
119:         $message = $this->parseData($message);
120:         if (is_array($message)) {
121:             $data = $message;
122:             $message = self::DEFAULT_FAIL_MESSAGE;
123:         } else {
124:             $data = $this->parseData($data);
125:         }
126:         return $this->make(self::DEFAULT_FAIL_CODE, $message, $data);
127:     }
128: 
129:     /**
130:      * @param $status
131:      * @param string|array|Arrayable $message
132:      * @param array|Arrayable $result
133:      * @return Json
134:      */
135:     public function status($status, $message, $result = [])
136:     {
137:         $message = $this->parseData($message);
138:         if (is_array($message)) {
139:             $result = $message;
140:             $message = self::DEFAULT_SUCCESS_MESSAGE;
141:         } else {
142:             $result = $this->parseData($result);
143:         }
144:         return $this->make(self::DEFAULT_SUCCESS_CODE, $message, compact('status', 'result'));
145:     }
146: 
147:     /**
148:      * @param string $type
149:      * @param $data
150:      * @return Json
151:      * @author xaboy
152:      * @day 2020/6/13
153:      */
154:     public function message(string $type, $data)
155:     {
156:         $this->response->data(compact('type', 'data'));
157:         return $this->response;
158:     }
159: 
160: }
