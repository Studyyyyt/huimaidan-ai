 3: namespace crmeb\services;
 4: 
 5: use Swoole\Coroutine\System;
 6: use think\facade\Cache;
 7: 
 8: class LockService
 9: {
10: 
11:     /**
12:      * @param $key
13:      * @param $fn
14:      * @param int $ex
15:      * @throws \Throwable
16:      */
17:     public function exec($key, $fn, int $ex = 6)
18:     {
19:         try {
20:             $this->lock($key, $key, $ex);
21:             return $fn();
22:         } finally {
23:             $this->unlock($key, $key);
24:         }
25:     }
26: 
27:     public function tryLock($key, $value = '1', $ex = 6)
28:     {
29:         return Cache::store('redis')->handler()->set('lock_' . $key, $value, ["NX", "EX" => $ex]);
30:     }
31: 
32:     public function lock($key, $value = '1', $ex = 6)
33:     {
34:         if ($this->tryLock($key, $value, $ex)) {
35:             return true;
36:         }
37:         System::sleep(1);
38:         return $this->lock($key, $value, $ex);
39:     }
40: 
41:     public function unlock($key, $value = '1')
42:     {
43:         $script = <<< EOF
44: if (redis.call("get", "lock_" .. KEYS[1]) == ARGV[1]) then
45: 	return redis.call("del", "lock_" .. KEYS[1])
46: else
47: 	return 0
48: end
49: EOF;
50:         return Cache::store('redis')->handler()->eval($script, [$key, $value], 1) > 0;
51:     }
52: }
