 991:      * @param string $destination 压缩后的保存地址
 992:      * @param string $folder 文件夹前缀，保存时需要去掉的父级文件夹
 993:      * @return boolean
 994:      */
 995:     function addZip($source, $destination, $folder = '')
 996:     {
 997:         if (!extension_loaded('zip') || !file_exists($source)) {
 998:             return false;
 999:         }
1000: 
1001:         $zip = new \ZipArchive;
1002:         if (!$zip->open($destination, $zip::CREATE)) {
1003:             return false;
1004:         }
1005:         $source = str_replace('\\', '/', $source);
1006:         $folder = str_replace('\\', '/', $folder);
1007:         if (is_dir($source) === true) {
1008:             $files = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($source), \RecursiveIteratorIterator::SELF_FIRST);
1009:             foreach ($files as $file) {
1010:                 $file = str_replace('\\', '/', $file);
1011:                 if (in_array(substr($file, strrpos($file, '/') + 1), array('.', '..'))) continue;
1012:                 if (is_dir($file) === true) {
1013:                     $zip->addEmptyDir(str_replace($folder . '/', '', $file . '/'));
1014:                 } else if (is_file($file) === true) {
1015:                     $zip->addFromString(str_replace($folder . '/', '', $file), file_get_contents($file));
1016:                 }
1017:             }
1018:         } else if (is_file($source) === true) {
1019:             $zip->addFromString(basename($source), file_get_contents($source));
1020:         }
1021:         return $zip->close();
1022:     }
