 84:      * @param $scene
 85:      * @param $openId
 86:      * @param $media_type
 87:      * @return bool
 88:      * @author Qinii
 89:      * @day 2023/2/1
 90:      */
 91:     public function mediaSecCheck($media_url,$scene,$openId,$media_type)
 92:     {
 93:         $access_token = $this->accessToken->getToken();
 94:         //$media_type 1:音频;2:图片
 95:         //scene 场景枚举值（1 资料；2 评论；3 论坛；4 社交日志）
 96:         $params = [
 97:             'media_url' => $media_url,
 98:             'media_type' => $media_type,
 99:             'version' => (int)2,
100:             'scene' => (int)$scene,
101:             'openid' => $openId,
102:         ];
103:         $_url = self::MEDIA_API.$access_token;
104:         try{
105:             $res = $this->parseJSON('json',[$_url, $params]);
106:             if (isset($res->errcode) && $res->errcode == 0) {
107:                 return true;
108:             } else {
109:                 throw new ValidateException($res->errmsg);
110:             }
111:         }catch (Exception $exception) {
112:             throw new ValidateException($exception->getMessage());
113:         }
114:     }
115: }
