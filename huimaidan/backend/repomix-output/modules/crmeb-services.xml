102:      */
103:     public static function express($sn,$name,$phone)
104:     {
105:         $com = app()->make(ExpressRepository::class)->getSearch(['name' => $name])->value('code');
106:         $key = 'express_' . $com.'_'.$sn;
107:         $has = Cache::has($key);
108:         if ($has) {
109:             $result = Cache::get($key);
110:         } else {
111:             $suffix = '';
112:             $is_shunfeng  = strtoupper(substr($sn,0,2));
113:             if  ($is_shunfeng ==  'SF') {
114:                 $suffix = ':'.substr($phone,7);
115:             }
116:             if ($name == '中通快递') {
117:                 $suffix = ':'.substr($phone,7);
118:             }
119:             $result = self::query($sn.$suffix, $com, $phone);
120:             if(!empty($result['list'])){
121:                 Cache::set($key, $result['list'], $result['cacheTime']);
122:                 $result  =  $result['list'];
123:             }
124:         }
125:         return $result ?? [];
126:     }
127: }
