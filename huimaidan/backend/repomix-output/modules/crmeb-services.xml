156:     /**
157:      * 发起请求
158:      * @param string $url
159:      * @param string $method
160:      * @param array $data
161:      * @param array $clientHeader
162:      * @param int $timeout
163:      * @return array|\crmeb\services\upload\extend\cos\SimpleXMLElement
164:      * @author 等风来
165:      * @email 136327134@qq.com
166:      * @date 2023/5/18
167:      */
168:     protected function request(string $url, string $method, array $data = [], array $clientHeader = [], int $timeout = 10)
169:     {
170:         $canonicalUri = '/';
171:         $canonicalQueryString = '';
172:         $canonicalHeaders = '';
173:         $signedHeaders = '';
174:         $payload = '';
175: 
176:         $urlAttr = pathinfo($url);
177:         if ($urlAttr['dirname'] !== 'https:') {
178:             $urlParse = parse_url($urlAttr['dirname'] ?? '');
179:             if (isset($urlParse['path'])) {
180:                 $canonicalUri .= substr($urlParse['path'], 1) . '/';
181:             }
182:             if (isset($urlAttr['basename'])) {
183:                 $canonicalUri .= $urlAttr['basename'];
184:             }
185:             if (!($pos = strripos($canonicalUri, '/')) || strlen($canonicalUri) - 1 !== $pos) {
186:                 $canonicalUri .= '/';
187:             }
188:         }
189: 
190:         if (!empty($data['query'])) {
191:             $query = $payload = $data['query'];
192:             ksort($query);
193:             $queryAttr = [];
194:             foreach ($query as $key => $item) {
195:                 $queryAttr[urlencode($key)] = urlencode($item);
196:             }
197:             if ($queryAttr) {
198:                 $canonicalQueryString = implode('&', $queryAttr);
199:             }
200:         } elseif (!empty($data['body'])) {
201:             $payload = $data['body'];
202:         } elseif (!empty($data['json'])) {
203:             $payload = json_encode($data['json']);
204:         }
205: 
206:         if ($clientHeader) {
207:             $canonicalHeadersAtrr = $signedHeadersAttr = [];
208:             ksort($clientHeader);
209:             foreach ($clientHeader as $key => $item) {
210:                 $canonicalHeadersAtrr[] = strtolower($key) . ':' . trim($item);
211:                 $signedHeadersAttr[] = strtolower($key);
212:             }
213:             if ($canonicalHeadersAtrr) {
214:                 $canonicalHeaders = implode("\n", $canonicalHeadersAtrr);
215:                 $signedHeaders = implode(';', $signedHeadersAttr);
216:             }
217:         }
218: 
219:         $clientHeader['Authorization'] = $this->generateAwsSignatureV4(
220:             $data['region'] ?? self::DEFAULT_REGION,
221:             $method,
222:             $canonicalUri,
223:             $canonicalQueryString,
224:             $canonicalHeaders,
225:             $signedHeaders,
226:             $payload);
227: 
228:         return $this->requestClient($url, $method, $data, $clientHeader, $timeout);
229:     }
230: 
231:     /**
232:      * 生成签名
233:      * @param string $region
234:      * @param string $httpMethod
235:      * @param string $canonicalUri
236:      * @param string $canonicalQueryString
237:      * @param string $canonicalHeaders
238:      * @param string $signedHeaders
239:      * @param $payload
240:      * @param string $service
241:      * @return string
242:      * @author 等风来
243:      * @email 136327134@qq.com
244:      * @date 2023/5/18
245:      */
246:     protected function generateAwsSignatureV4(string $region, string $httpMethod, string $canonicalUri, string $canonicalQueryString, string $canonicalHeaders, string $signedHeaders, $payload, string $service = 's3')
247:     {
248:         $algorithm = 'AWS4-HMAC-SHA256';
249:         $t = new \DateTime('UTC');
250:         $amzDate = $t->format('Ymd\THis\Z');
251:         $dateStamp = $t->format('Ymd');
252: 
253:         $canonicalRequest = $httpMethod . "\n" . $canonicalUri . "\n" . $canonicalQueryString . "\n" . $canonicalHeaders . "\n" . $signedHeaders . "\n" . hash('sha256', $payload);
254:         $credentialScope = $dateStamp . '/' . $region . '/' . $service . '/aws4_request';
255:         dump(compact('region', 'httpMethod', 'canonicalUri', 'canonicalQueryString', 'canonicalHeaders', 'signedHeaders', 'payload', 'service'));
256:         $stringToSign = $algorithm . "\n" . $amzDate . "\n" . $credentialScope . "\n" . hash('sha256', $canonicalRequest);
257:         $signingKey = hash_hmac('sha256', 'aws4_request',
258:             hash_hmac('sha256', $service,
259:                 hash_hmac('sha256', $region,
260:                     hash_hmac('sha256', $dateStamp, 'AWS4' . $this->secretKey, true),
261:                     true),
262:                 true),
263:             true);
264:         $signature = hash_hmac('sha256', $stringToSign, $signingKey);
265: 
266:         return $algorithm . ' Credential=' . $this->accessKeyId . '/' . $credentialScope . ', SignedHeaders=' . $signedHeaders . ', Signature=' . $signature;
267:     }
