396:      */
397:     public function sendSmsKey($phone, $type = 'login')
398:     {
399:         switch ($type) {
400:             case 'login': //登录
401:                 return 'api_login_' . $phone;
402:                 break;
403:             case 'binding': //绑定手机号
404:                 return 'api_binding_' . $phone;
405:                 break;
406:             case 'intention': //申请入住
407:                 return 'merchant_intention_' . $phone;
408:                 break;
409:             case 'change_pwd': //修改密码
410:                 return 'change_pwd_' . $phone;
411:                 break;
412:             case 'change_phone': //修改手机号
413:                 return 'change_phone_' . $phone;
414:                 break;
415:             default:
416:                 return 'crmeb_' . $phone;
417:                 break;
418:         }
419:     }
