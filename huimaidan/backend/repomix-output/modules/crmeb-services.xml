446:     public function setBucketCors(string $name, string $region)
447:     {
448:         try {
449:             $handle = new OssClient($this->accessKey, $this->secretKey, $region);
450:             $corsConfig = new CorsConfig();
451:             $rule = new CorsRule();
452:             // 设置允许跨域请求的响应头。AllowedHeader可以设置多个，每个AllowedHeader中最多只能使用一个通配符星号（*）。
453:             // 建议无特殊需求时设置AllowedHeader为星号（*）。
454:             $rule->addAllowedHeader("*");
455:             // 设置允许用户从应用程序中访问的响应头。ExposeHeader可以设置多个，ExposeHeader中不支持使用通配符星号（*）。
456:             $rule->addExposeHeader("ETag");
457:             // 设置允许的跨域请求的来源。AllowedOrigin可以设置多个，每个AllowedOrigin中最多只能使用一个通配符星号（*）。
458:             // 设置AllowedOrigin为星号（*）时，表示允许所有域的来源。
459:             $rule->addAllowedOrigin("*");
460:             // 设置允许的跨域请求方法。
461:             $rule->addAllowedMethod("POST");
462:             $rule->addAllowedMethod("GET");
463:             $rule->addAllowedMethod("DELETE");
464:             $rule->addAllowedMethod("PUT");
465:             $rule->addAllowedMethod("HEAD");
466:             // 设置浏览器对特定资源的预取（OPTIONS）请求返回结果的缓存时间，单位为秒。
467:             $rule->setMaxAgeSeconds(600);
468:             // 每个Bucket最多支持添加10条规则。
469:             $corsConfig->addRule($rule);
470:             return $handle->putBucketCors($name, $corsConfig);
471:         } catch (\Throwable $e) {
472:             return $this->setError($e->getMessage());
473:         }
474:     }
