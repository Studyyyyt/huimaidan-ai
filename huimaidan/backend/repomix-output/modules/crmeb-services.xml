108:      * @param string $template
109:      * @param array $params
110:      * @return array
111:      */
112:     public static function setWithTags(string $template, array $params = []): array
113:     {
114:         $key = self::build($template, $params);
115:         $tags = self::getTags($template, $params);
116:         return [$key, $tags];
117:     }
118: }
