289:             $params['nonceStr'] . "\n" .
290:             $params['package'] . "\n";
291:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
292:         $sign = base64_encode($raw_sign);
293: 
294:         $params['paySign'] = $sign;
295: 
296:         return $json ? json_encode($params) : $params;
