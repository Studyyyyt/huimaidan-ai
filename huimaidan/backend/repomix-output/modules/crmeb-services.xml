293:     {
294:         if (!is_array($scopes)) {
295:             return null;
296:         }
297:         $statements = array();
298: 
299:         for ($i = 0, $counts = count($scopes); $i < $counts; $i++) {
300:             $actions = array();
301:             $resources = array();
302:             array_push($actions, $scopes[$i]->get_action());
303:             array_push($resources, $scopes[$i]->get_resource());
304: 
305:             $statement = array(
306:                 'action' => $actions,
307:                 'effect' => $scopes[$i]->get_effect(),
308:                 'resource' => $resources
309:             );
310:             array_push($statements, $statement);
311:         }
312: 
313:         $policy = array(
314:             'version' => '2.0',
315:             'statement' => $statements
316:         );
317:         return $policy;
318:     }
