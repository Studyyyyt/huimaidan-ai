204:             if (in_array($key, $this->required, true) && empty($value) && empty($this->message[$key])) {
205:                 throw new InvalidArgumentException("Attribute '$key' can not be empty!");
206:             }
207: 
208:             $params[$key] = empty($value) ? $this->message[$key] : $value;
209:         }
