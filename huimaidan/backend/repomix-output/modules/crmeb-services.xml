 13: namespace crmeb\services\printer;
 14: 
 15: use crmeb\services\HttpService;
 16: use think\facade\Config;
 17: use think\facade\Log;
 18: use think\helper\Str;
 19: use think\facade\Cache;
 20: 
 21: /**
 22:  *
 23:  * Class AccessToken
 24:  * @package crmeb\services\printer
 25:  */
 26: class AccessToken extends HttpService
 27: {
 28: 
 29:     /**
 30:      * token
 31:      * @var array
 32:      */
 33:     protected $accessToken;
 34: 
 35:     /**
 36:      * 请求接口
 37:      * @var string
 38:      */
 39:     protected $apiUrl;
 40: 
 41:     /**
 42:      * @var string
 43:      */
 44:     protected $clientId;
 45: 
 46:     /**
 47:      * 终端号码
 48:      * @var string
 49:      */
 50:     protected $machineCode;
 51: 
 52:     /**
 53:      * 开发者id
 54:      * @var string
 55:      */
 56:     protected $partner;
 57: 
 58:     /**
 59:      * 驱动类型
 60:      * @var string
 61:      */
 62:     protected $name;
 63: 
 64:     /**
 65:      * 配置文件名
 66:      * @var string
 67:      */
 68:     protected $configFile;
 69: 
 70:     /**
 71:      * api key
 72:      * @var string
 73:      */
 74:     protected $apiKey ;
 75:     protected $type;
 76:     const HOST = [
 77:         'https://open-api.10ss.net/',
 78:         'http://api.feieyun.cn/Api/Open/',
 79:     ];
 80: 
 81:     public function __construct(array $config = [], string $name, string $configFile)
 82:     {
 83:         //打印机编号
 84:         $this->machineCode = $config['terminal'] ?? null;
 85:         //appkey
 86:         $this->clientId = $config['clientId'] ?? null;
 87:         //用户
 88:         $this->partner = $config['partner'] ?? null;
 89:         $this->apiKey = $config['apiKey'] ?? null;
 90:         //打印机类型
 91:         $this->type = $config['type'] ?? 0;
 92:         $this->name = $name;
 93:         $this->configFile = $configFile;
 94:         $this->apiUrl = self::HOST[$this->type];
 95:     }
 96: 
 97:     /**
 98:      * 获取token
 99:      * @return mixed|null|string
100:      * @throws \Exception
101:      */
102:     public function getAccessToken()
103:     {
104:         if (isset($this->accessToken[$this->name])) {
105:             return $this->accessToken[$this->name];
106:         }
107: 
108:         $action = 'get' . Str::studly($this->name) . 'AccessToken';
109:         if (method_exists($this, $action)) {
110:             return $this->{$action}();
111:         } else {
112:             throw new \RuntimeException(__CLASS__ . '->' . $action . '(),Method not worn in');
113:         }
114:     }
115: 
116:     /**
117:      * 获取易联云token
118:      * @return mixed|null|string
119:      * @throws \Exception
120:      */
121:     protected function getYiLianYunAccessToken()
122:     {
123:          if(!$this->accessToken[$this->name] = Cache::get('YLY_access_token_'.$this->clientId)){
124:              $token = $this->getToken();
125:              Cache::set('YLY_access_token_'.$this->clientId,$token, 18 * 86400);
126:              $this->accessToken[$this->name] = $token;
127:          }
128:         if (!$this->accessToken[$this->name])
129:             Log::info('易联云打印机获取access_token获取失败:'.$this->clientId);
130:         return $this->accessToken[$this->name];
131:     }
132: 
133: 
134:     protected function getToken () {
135:         $data = [
136:             'client_id' => $this->clientId,
137:             'grant_type' => 'client_credentials',
138:             'sign' => strtolower(md5($this->clientId . time() . $this->apiKey)),
139:             'scope' => 'all',
140:             'timestamp' => time(),
141:             'id' => $this->createUuid(),
142:         ];
143:         $request = self::postRequest($this->apiUrl . 'oauth/oauth',$data );
144:         $request = json_decode($request, true);
145:         $request['error'] = $request['error'] ?? 0;
146:         $request['error_description'] = $request['error_description'] ?? '';
147:         if ($request['error'] == 0 && $request['error_description'] == 'success') {
148:             return $request['body']['access_token'] ?? '';
149:         }
150: 
151:         return '';
152:     }
153: 
154:     /**
155:      * 获取请求链接
156:      * @return string
157:      */
158:     public function getApiUrl(string $url = '')
159:     {
160:         return $url ? $this->apiUrl . $url : $this->apiUrl;
161:     }
162: 
163:     /**
164:      * 生成UUID4
165:      * @return string
166:      */
167:     public function createUuid()
168:     {
169:         return sprintf('%04x%04x-%04x-%04x-%04x-%04x%04x%04x', mt_rand(0, 0xffff), mt_rand(0, 0xffff), mt_rand(0, 0xffff),
170:             mt_rand(0, 0x0fff) | 0x4000, mt_rand(0, 0x3fff) | 0x8000, mt_rand(0, 0xffff), mt_rand(0, 0xffff), mt_rand(0, 0xffff));
171:     }
172: 
173:     /**
174:      * 获取属性
175:      * @param $name
176:      * @return mixed
177:      */
178:     public function __get($name)
179:     {
180:         if (in_array($name, ['clientId', 'apiKey', 'accessToken', 'partner', 'terminal', 'machineCode'])) {
181:             return $this->{$name};
182:         }
183:     }
184: }
</file>

