321:     /**
322:      * 写入初始数据
323:      *
324:      * @return boolean true - 写入成功，false - 写入失败
325:      */
326:     public function Backup_Init()
327:     {
328:         $sql = "-- -----------------------------\n";
329:         $sql .= "-- Think MySQL Data Transfer \n";
330:         $sql .= "-- \n";
331:         $sql .= "-- Host     : " . $this->dbconfig['hostname'] . "\n";
332:         $sql .= "-- Port     : " . $this->dbconfig['hostport'] . "\n";
333:         $sql .= "-- Database : " . $this->dbconfig['database'] . "\n";
334:         $sql .= "-- \n";
335:         $sql .= "-- Part : #{$this->file['part']}\n";
336:         $sql .= "-- Date : " . date("Y-m-d H:i:s") . "\n";
337:         $sql .= "-- -----------------------------\n\n";
338:         $sql .= "SET FOREIGN_KEY_CHECKS = 0;\n\n";
339:         return $this->write($sql);
340:     }
341: 
342:     /**
343:      * 备份表结构
344:      *
345:      * @param string $table
346:      * @param int $start
347:      * @return bool|int
348:      * @throws \think\db\exception\BindParamException
349:      * @throws \think\exception\PDOException
350:      */
351:     public function backup(string $table, int $start)
352:     {
353:         $db = self::connect();
354:         // 备份表结构
355:         if (0 == $start) {
356:             $result = $db->query("SHOW CREATE TABLE `{$table}`");
357:             $sql = "\n";
358:             $sql .= "-- -----------------------------\n";
359:             $sql .= "-- Table structure for `{$table}`\n";
360:             $sql .= "-- -----------------------------\n";
361:             $sql .= "DROP TABLE IF EXISTS `{$table}`;\n";
362:             $sql .= trim($result[0]['Create Table']) . ";\n\n";
363:             if (false === $this->write($sql)) {
364:                 return false;
365:             }
366:         }
367:         //数据总数
368:         $result = $db->query("SELECT COUNT(*) AS count FROM `{$table}`");
369:         $count = $result['0']['count'];
370:         //备份表数据
371:         if ($count) {
372:             //写入数据注释
373:             if (0 == $start) {
374:                 $sql = "-- -----------------------------\n";
375:                 $sql .= "-- Records of `{$table}`\n";
376:                 $sql .= "-- -----------------------------\n";
377:                 $this->write($sql);
378:             }
379:             //备份数据记录
380:             $result = $db->query("SELECT * FROM `{$table}` LIMIT :MIN, 1000", ['MIN' => intval($start)]);
381:             foreach ($result as $row) {
382:                 $row = array_map('addslashes', $row);
383:                 $sql = "INSERT INTO `{$table}` VALUES ('" . str_replace(array("\r", "\n"), array('\\r', '\\n'), implode("', '", $row)) . "');\n";
384:                 if (false === $this->write($sql)) {
385:                     return false;
386:                 }
387:             }
388:             //还有更多数据
389:             if ($count > $start + 1000) {
390:                 //return array($start + 1000, $count);
391:                 return $this->backup($table, $start + 1000);
392:             }
393:         }
394:         //备份下一表
395:         return 0;
396:     }
