428:                     'uid' => $this->config['sms_account'],
429:                     'phone' => $phone,
430:                     'content' => $resource['content'],
431:                     'template' => $resource['template'],
432:                     'record_id' => $resource['id'],
433:                 ]);
434:             }
435:         } catch (\Exception $exception) {
436:             throw new SmsException($exception->getMessage());
437:         }
