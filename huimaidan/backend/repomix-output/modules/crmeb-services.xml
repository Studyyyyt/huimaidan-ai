209:                     $key = 'filePath' . ucfirst($v);
210: //                    if (systemConfig('image_thumbnail_status') && isset($config[$height]) && isset($config[$width])) {
211:                     if (isset($config[$height]) && isset($config[$width])) {
212:                         if (!strpos($filePath, '?watermark')) {
213:                             $this->fileInfo->$key = $filePath . '?imageView2/2/w/' . $config[$width] . '/h/' . $config[$height];
214:                         }
215:                         $this->fileInfo->$key = $this->water($this->fileInfo->$key);
216:                         $data[$v] = $this->fileInfo->$key;
217:                     } else {
