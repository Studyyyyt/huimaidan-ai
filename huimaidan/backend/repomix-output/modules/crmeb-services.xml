215:     public function returnAdvance($refund_id, $sub_mchid)
216:     {
217:         $res = $this->request('/v3/ecommerce/refunds/' . $refund_id . '/return-advance', 'POST', ['sign_body' => json_encode(compact('sub_mchid'))], true);
218:         if (isset($res['code'])) {
219:             throw new ValidateException('微信接口报错:' . $res['message']);
220:         }
221:         return $res;
222:     }
223: 
224:     public function configForPayment($prepayId, $json = true)
225:     {
226:         $params = [
227:             'appId' => $this->app['config']['app_id'],
228:             'timeStamp' => strval(time()),
229:             'nonceStr' => uniqid(),
230:             'package' => "prepay_id=$prepayId",
231:             'signType' => 'RSA',
232:         ];
233:         $message = $params['appId'] . "\n" .
234:             $params['timeStamp'] . "\n" .
235:             $params['nonceStr'] . "\n" .
236:             $params['package'] . "\n";
237:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
238:         $sign = base64_encode($raw_sign);
239: 
240:         $params['paySign'] = $sign;
241: 
242:         return $json ? json_encode($params) : $params;
243:     }
244: 
245:     /**
246:      * Generate app payment parameters.
247:      *
248:      * @param string $prepayId
249:      *
250:      * @return array
251:      */
252:     public function configForAppPayment($prepayId)
253:     {
254:         $params = [
255:             'appid' => $this->app['config']['app_id'],
256:             'partnerid' => $this->app['config']['service_payment']['merchant_id'],
257:             'prepayid' => $prepayId,
258:             'noncestr' => uniqid(),
259:             'timestamp' => time(),
260:             'package' => 'Sign=WXPay',
261:         ];
262:         $message = $params['appid'] . "\n" .
263:             $params['timestamp'] . "\n" .
264:             $params['noncestr'] . "\n" .
265:             $params['prepayid'] . "\n";
266:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
267:         $sign = base64_encode($raw_sign);
268: 
269:         $params['sign'] = $sign;
270: 
271:         return $params;
272:     }
273: 
274:     public function configForJSSDKPayment($prepayId)
275:     {
276:         $config = $this->configForPayment($prepayId, false);
277: 
278:         $config['timestamp'] = $config['timeStamp'];
279:         unset($config['timeStamp']);
280: 
281:         return $config;
282:     }
283: 
284: }
