171:     /**
172:      *  原 send 方法 （弃用）
173:      * 发送短信
174:      * @param string $phone
175:      * @param string $templateId
176:      * @param array $data
177:      * @return bool|string
178:      * @throws SmsException
179:      */
180:     public function sendDe(string $phone, string $templateId, array $data = [])
181:     {
182:         if (!$phone) {
183:             throw new SmsException('Mobile number cannot be empty');
184:         }
185: 
186:         $this->checkConfig();
187: 
188:         $formData['uid'] = $this->config['sms_account'];
189:         $formData['token'] = $this->config['sms_token'];
190:         $formData['mobile'] = $phone;
191:         $formData['template'] = $this->getTemplateCode($templateId);
192:         if (is_null($formData['template']))
193:             throw new SmsException('Missing template number');
194: 
195:         $formData['param'] = json_encode($data);
196:         $resource = json_decode(HttpService::postRequest(self::API . 'sms/send', $formData), true);
197:         if ($resource['status'] === 400) {
198:             throw new SmsException($resource['msg']);
199:         } else {
200:             app()->make(SmsRecordDao::class)->create([
201:                 'uid' => $formData['uid'],
202:                 'phone' => $phone,
203:                 'content' => $resource['data']['content'],
204:                 'template' => $resource['data']['template'],
205:                 'record_id' => $resource['data']['id']
206:             ]);
207:         }
208:         return $resource;
209:     }
