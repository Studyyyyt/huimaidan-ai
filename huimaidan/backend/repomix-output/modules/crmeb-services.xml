290:     public function import($start)
291:     {
292:         //还原数据
293:         $db = self::connect();
294:         if ($this->config['compress']) {
295:             $gz = gzopen($this->file[1], 'r');
296:             $size = 0;
297:         } else {
298:             $size = filesize($this->file[1]);
299:             $gz = fopen($this->file[1], 'r');
300:         }
301:         $sql = '';
302:         if ($start) {
303:             $this->config['compress'] ? gzseek($gz, $start) : fseek($gz, $start);
304:         }
305:         for ($i = 0; $i < 1000; $i++) {
306:             $sql .= $this->config['compress'] ? gzgets($gz) : fgets($gz);
307:             if (preg_match('/.*;$/', trim($sql))) {
308:                 if (false !== $db->execute($sql)) {
309:                     $start += strlen($sql);
310:                 } else {
311:                     return false;
312:                 }
313:                 $sql = '';
314:             } elseif ($this->config['compress'] ? gzeof($gz) : feof($gz)) {
315:                 return 0;
316:             }
317:         }
318:         return array($start, $size);
319:     }
