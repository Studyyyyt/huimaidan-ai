529:     /**
530:      * 获取签名
531:      * @param array $result
532:      * @return array
533:      * @author 等风来
534:      * @email 136327134@qq.com
535:      * @date 2023/5/17
536:      */
537:     protected function getSign(array $result)
538:     {
539:         $result['headers']['Date'] = gmdate('D, d M Y H:i:s \G\M\T');
540:         $canonicalstring = $this->makeCanonicalstring($result['method'], $result['headers'], $result['pathArgs'], $result['dnsParam'], $result['uriParam']);
541: 
542:         $result['cannonicalRequest'] = $canonicalstring;
543: 
544:         $signature = base64_encode(hash_hmac('sha1', $canonicalstring, $this->secretKey, true));
545: 
546:         $authorization = 'OBS ' . $this->accessKeyId . ':' . $signature;
547: 
548:         $result['headers']['Authorization'] = $authorization;
549: 
550:         return $result;
551:     }
