 21: class DownloadImageService
 22: {
 23: 
 24:     //存储位置
 25:     protected $path = 'attach';
 26: 
 27:     protected $rules = ['thumb', 'thumbWidth', 'thumHeight', 'path'];
 28: 
 29:     /**
 30:      * 获取即将要下载的图片扩展名
 31:      * @param string $url
 32:      * @param string $ex
 33:      * @return array|string[]
 34:      */
 35:     public function getImageExtname($url = '', $ex = 'jpg')
 36:     {
 37:         $_empty = ['file_name' => '', 'ext_name' => $ex];
 38:         if (!$url) return $_empty;
 39:         if (strpos($url, '?')) {
 40:             $_tarr = explode('?', $url);
 41:             $url = trim($_tarr[0]);
 42:         }
 43:         $arr = explode('.', $url);
 44:         if (!is_array($arr) || count($arr) <= 1) return $_empty;
 45:         $ext_name = trim($arr[count($arr) - 1]);
 46:         $ext_name = !$ext_name ? $ex : $ext_name;
 47:         return ['file_name' => md5($url) . '.' . $ext_name, 'ext_name' => $ext_name];
 48:     }
 49: 
 50:     /**
 51:      * @param $url
 52:      * @param string $name
 53:      * @param int $upload_type
 54:      * @return mixed
 55:      * @author xaboy
 56:      * @day 2020/8/1
 57:      */
 58:     public function downloadImage($url, $path = 'def', $name = '', $upload_type = null)
 59:     {
 60:         if (!$name) {
 61:             //TODO 获取要下载的文件名称
 62:             $downloadImageInfo = $this->getImageExtname($url);
 63:             $ext = $downloadImageInfo['ext_name'];
 64:             $name = $downloadImageInfo['file_name'];
 65:             if (!$name) throw new ValidateException('上传图片不存在');
 66:         }else {
 67:             $ext = $this->getImageExtname($name)['ext_name'];
 68:         }
 69:         if (!in_array($ext, Config::get('upload.fileExt'))) {
 70:             throw new AdminException('图片格式错误，无法下载');
 71:         }
 72:         if (strstr($url, 'http://') === false && strstr($url, 'https://') === false) {
 73:             $url = 'http:' . $url;
 74:         }
 75:         $url = str_replace('https://', 'http://', $url);
 76:         if ($this->path == 'attach') {
 77:             $date_dir = date('Y') . DIRECTORY_SEPARATOR . date('m') . DIRECTORY_SEPARATOR . date('d');
 78:             $to_path = $this->path . '/' . $date_dir;
 79:         } else {
 80:             $to_path = $this->path;
 81:         }
 82:         checkSuffix($url);
 83:         ob_start();
 84:         readfile($url);
 85:         $content = ob_get_contents();
 86:         ob_end_clean();
 87:         $size = strlen(trim($content));
 88:         if (!$content || $size <= 2) throw new ValidateException('图片流获取失败');
 89: 
 90:         $upload = UploadService::create($upload_type);
 91:         if ($upload->to($to_path)->stream($content, $name) === false) {
 92:             throw new ValidateException('图片下载失败');
 93:         }
 94:         $imageInfo = $upload->getUploadInfo();
 95:         $date['path'] = $imageInfo['dir'];
 96:         $date['name'] = $imageInfo['name'];
 97:         $date['size'] = $imageInfo['size'];
 98:         $date['mime'] = $imageInfo['type'];
 99:         return $date;
100:     }
