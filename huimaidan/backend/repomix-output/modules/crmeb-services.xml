  21: class FileService
  22: {
  23: 
  24:     /**
  25:      * 创建目录
  26:      * @param string $dir
  27:      * @return bool
  28:      */
  29:     public static function mkDir(string $dir)
  30:     {
  31:         $dir = rtrim($dir, '/') . '/';
  32:         if (!is_dir($dir)) {
  33:             if (mkdir($dir, 0700) == false) {
  34:                 return false;
  35:             }
  36:             return true;
  37:         }
  38:         return true;
  39:     }
  40: 
  41:     /**
  42:      * @param $filename 写入文件名
  43:      * @param $writetext 保存内容
  44:      * @param string $openmod 打开方式
  45:      * @return bool
  46:      */
  47:     public static function writeFile(string $filename, string $writetext, string $openmod = 'w')
  48:     {
  49:         if (@$fp = fopen($filename, $openmod)) {
  50:             flock($fp, 2);
  51:             fwrite($fp, $writetext);
  52:             fclose($fp);
  53:             return true;
  54:         } else {
  55:             return false;
  56:         }
  57:     }
  58: 
  59:     /**
  60:      *  删除目录下所有满足条件文件
  61:      * @param $path 文件目录
  62:      * @param $start 开始时间
  63:      * @param $end 结束时间
  64:      *  return bool
  65:      */
  66:     public static function del_where_dir($path, $start = '', $end = '')
  67:     {
  68:         if (!file_exists($path)) {
  69:             return false;
  70:         }
  71:         $dh = @opendir($path);
  72:         if ($dh) {
  73:             while (($d = readdir($dh)) !== false) {
  74:                 if ($d == '.' || $d == '..') {//如果为.或..
  75:                     continue;
  76:                 }
  77:                 $tmp = $path . '/' . $d;
  78:                 if (!is_dir($tmp)) {//如果为文件
  79:                     $file_time = filemtime($tmp);
  80:                     if ($file_time) {
  81:                         if ($start != '' && $end != '') {
  82:                             if ($file_time >= $start && $file_time <= $end) {
  83:                                 @unlink($tmp);
  84:                             }
  85:                         } elseif ($start != '' && $end == '') {
  86:                             if ($file_time >= $start) {
  87:                                 @unlink($tmp);
  88:                             }
  89:                         } elseif ($start == '' && $end != '') {
  90:                             if ($file_time <= $end) {
  91:                                 @unlink($tmp);
  92:                             }
  93:                         } else {
  94:                             @unlink($tmp);
  95:                         }
  96:                     }
  97:                 } else {//如果为目录
  98:                     self::delDir($tmp, $start, $end);
  99:                 }
 100:             }
 101:             //判断文件夹下是否 还有文件
 102:             $count = count(scandir($path));
 103:             closedir($dh);
 104:             if ($count <= 2) @rmdir($path);
 105:         }
 106:         return true;
 107:     }
 108: 
 109:     /**
 110:      * 删除目录
 111:      * @param $dirName
 112:      * @return bool
 113:      */
 114:     public static function delDir($dirName)
 115:     {
 116:         if (!file_exists($dirName)) {
 117:             return false;
 118:         }
 119: 
 120:         $dir = opendir($dirName);
 121:         while ($fileName = readdir($dir)) {
 122:             $file = $dirName . '/' . $fileName;
 123:             if ($fileName != '.' && $fileName != '..') {
 124:                 if (is_dir($file)) {
 125:                     self::delDir($file);
 126:                 } else {
 127:                     unlink($file);
 128:                 }
 129:             }
 130:         }
 131:         closedir($dir);
 132:         return rmdir($dirName);
 133:     }
