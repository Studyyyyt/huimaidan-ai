316:     /**
317:      * @param string $name
318:      * @param string $region
319:      * @return bool|mixed
320:      */
321:     public function createBucket(string $name, string $region = 'z0')
322:     {
323:         $regionData = $this->getRegion();
324:         if (!in_array($region, array_column($regionData, 'value'))) {
325:             return $this->setError('七牛云:无效的区域');
326:         }
327:         $url = 'https://' . Config::UC_HOST . '/mkbucketv3/' . $name . '/region/' . $region;
328:         $body = null;
329:         $headers = $this->app()->authorizationV2($url, 'POST', $body, 'application/json');
330:         $headers["Content-Type"] = 'application/json';
331:         $ret = Client::post($url, $body, $headers);
332: 
