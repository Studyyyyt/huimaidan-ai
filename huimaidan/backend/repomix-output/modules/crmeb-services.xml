 30: 
 31:     public function handleNotify($callback)
 32:     {
 33:         $request = request();
 34:         $success = $request->post('event_type') === 'TRANSACTION.SUCCESS';
 35:         $data = $this->decrypt($request->post('resource', []));
 36: 
 37:         $handleResult = call_user_func_array($callback, [json_decode($data, true), $success]);
 38:         if (is_bool($handleResult) && $handleResult) {
 39:             $response = [
 40:                 'code' => 'SUCCESS',
 41:                 'message' => 'OK',
 42:             ];
 43:         } else {
 44:             $response = [
 45:                 'code' => 'FAIL',
 46:                 'message' => $handleResult,
 47:             ];
 48:         }
 49: 
 50:         return response($response, 200, [], 'json');
 51:     }
 52: 
 53:     public function pay($type, array $order)
 54:     {
 55:         $params = [
 56:             'combine_out_trade_no' => $order['order_sn'],
 57:             'combine_mchid' => $this->app['config']['service_payment']['merchant_id'],
 58:             'combine_appid' => $this->app['config']['app_id'],
 59:             'scene_info' => [
 60:                 'device_id' => 'shop system',
 61:                 'payer_client_ip' => request()->ip(),
 62:             ],
 63:             'sub_orders' => [],
 64:             'notify_url' => $this->app['config']['service_payment']['notify_url'],
 65:         ];
 66: 
 67:         if ($type === 'h5') {
 68:             $params['scene_info']['h5_info'] = [
 69:                 'type' => $order['h5_type'] ?? 'Wap'
 70:             ];
 71:         }
 72: 
 73:         foreach ($order['sub_orders'] as $sub_order) {
 74:             $subOrder = [
 75:                 'mchid' => $this->app['config']['service_payment']['merchant_id'],
 76:                 'amount' => [
 77:                     'total_amount' => intval($sub_order['pay_price'] * 100),
 78:                     'currency' => 'CNY',
 79:                 ],
 80:                 'settle_info' => [
 81:                     'profit_sharing' => true
 82:                 ],
 83:                 'out_trade_no' => $sub_order['order_sn'],
 84:                 'sub_mchid' => $sub_order['sub_mchid']
 85:             ];
 86:             $subOrder['attach'] = $sub_order['attach'] ?? $order['attach'] ?? '';
 87:             $subOrder['description'] = $sub_order['body'] ?? $order['body'] ?? '';
 88:             $params['sub_orders'][] = $subOrder;
 89:         }
 90: 
 91:         if (isset($order['openid'])) {
 92:             $params['combine_payer_info'] = [
 93:                 'openid' => $order['openid'],
 94:             ];
 95:         }
 96:         $content = json_encode($params, JSON_UNESCAPED_UNICODE);
 97: 
 98:         $res = $this->request('/v3/combine-transactions/' . $type, 'POST', ['sign_body' => $content]);
 99:         if (isset($res['code'])) {
100:             throw new ValidateException('微信接口报错:' . $res['message']);
101:         }
102:         return $res;
103:     }
104: 
105:     public function payApp(array $options)
106:     {
