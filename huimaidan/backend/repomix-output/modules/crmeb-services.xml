16: 
17: use Payment\Contracts\IPayNotify;
18: use think\exception\ValidateException;
19: use think\facade\Log;
20: 
21: class AlipayNotify implements IPayNotify
22: {
23:     private $type;
24: 
25:     public function __construct($type)
26:     {
27:         $this->type = $type;
28:     }
29: 
30:     /**
31:      * 处理支付宝支付回调。
32:      *
33:      * 本函数负责接收并处理支付宝支付回调通知。它首先验证交易状态是否为成功或完成，
34:      * 如果验证失败，则抛出一个异常表明交易未支付。如果验证成功，它将触发一个事件来处理支付成功的逻辑。
35:      *
36:      * @param string $channel 支付渠道，此处固定为支付宝。
37:      * @param string $notifyType 通知类型，指示回调的具体类型。
38:      * @param string $notifyWay 通知方式，指示回调的通知途径。
39:      * @param array $notifyData 通知数据，包含支付宝返回的所有回调信息。
40:      * @return bool 返回处理结果，true表示处理成功，false表示处理失败。
41:      * @throws ValidateException 如果交易状态不是TRADE_SUCCESS或TRADE_FINISHED，则抛出此异常。
42:      */
43:     public function handle(string $channel, string $notifyType, string $notifyWay, array $notifyData)
44:     {
45:         // 记录回调数据到日志，用于后续的调试和审计。
46:         Log::info('支付宝支付回调 handle:' . var_export($notifyData, 1));
47: 
48:         // 验证交易状态是否为成功或完成，如果不是，则抛出异常。
49:         if (!in_array($notifyData['trade_status'], ['TRADE_SUCCESS', 'TRADE_FINISHED']))
50:             throw new ValidateException('未支付');
51:         try {
52:             // 触发支付成功事件，传入订单号和通知数据。
53:             Log::info('支付宝支付成功回调执行队列 handle:' . var_export([$this->type,$notifyData],1));
54:             event('pay_success_' . $this->type, ['order_sn' => $notifyData['out_trade_no'], 'data' => $notifyData]);
55:             return true;
56:         } catch (\Exception$e) {
57:             // 记录处理回调失败的原因到日志。
58:             Log::info('支付宝支付回调失败handle:' . $e->getMessage());
59:         }
60: 
61:         // 如果处理过程中发生异常或错误，则返回false。
62:         return false;
63:     }
64: }
