379:     public function checkSmsCode($phone, $code, $type)
380:     {
381:         if (!env('DEVELOPMENT',false)) {
382:             $sms_key = $this->sendSmsKey($phone, $type);
383:             if (!$cache_code = Cache::get($sms_key)) return false;
384:             if ($code != $cache_code) return false;
385:             Cache::delete($sms_key);
386:         }
387:         return true;
