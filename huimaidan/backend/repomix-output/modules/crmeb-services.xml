272:         }
273: 
274:         if (0 === stripos($method, 'and')) {
275:             $method = lcfirst(substr($method, 3));
276:         }
277: 
278:         if (isset($map[$method])) {
279:             $this->message[$map[$method]] = array_shift($args);
280:         }
281: 
282:         return $this;
283:     }
284: 
285: }
