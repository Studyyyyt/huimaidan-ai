 584:     /**
 585:      * 列出指定目录下符合条件的文件和文件夹
 586:      * @param string $dirname 路径
 587:      * @param boolean $is_all 是否列出子目录中的文件
 588:      * @param string $exts 需要列出的后缀名文件
 589:      * @param string $sort 数组排序
 590:      * @return ArrayObject
 591:      */
 592:     public function listDirInfo(string $dirname, bool $is_all = FALSE, string $exts = '', string $sort = 'ASC')
 593:     {
 594:         //处理多于的/号
 595:         $new = strrev($dirname);
 596:         if (strpos($new, '/') == 0) {
 597:             $new = substr($new, 1);
 598:         }
 599:         $dirname = strrev($new);
 600: 
 601:         $sort = strtolower($sort);//将字符转换成小写
 602: 
 603:         $files = [];
 604:         $subfiles = [];
 605: 
 606:         if (is_dir($dirname)) {
 607:             $fh = opendir($dirname);
 608:             while (($file = readdir($fh)) !== FALSE) {
 609:                 if (strcmp($file, '.') == 0 || strcmp($file, '..') == 0) continue;
 610: 
 611:                 $filepath = $dirname . '/' . $file;
 612: 
 613:                 switch ($exts) {
 614:                     case '*':
 615:                         if (is_dir($filepath) && $is_all == TRUE) {
 616:                             $files = array_merge($files, self::listDirInfo($filepath, $is_all, $exts, $sort));
 617:                         }
 618:                         array_push($files, $filepath);
 619:                         break;
 620:                     case 'folder':
 621:                         if (is_dir($filepath) && $is_all == TRUE) {
 622:                             $files = array_merge($files, self::listDirInfo($filepath, $is_all, $exts, $sort));
 623:                             array_push($files, $filepath);
 624:                         } elseif (is_dir($filepath)) {
 625:                             array_push($files, $filepath);
 626:                         }
 627:                         break;
 628:                     case 'file':
 629:                         if (is_dir($filepath) && $is_all == TRUE) {
 630:                             $files = array_merge($files, self::listDirInfo($filepath, $is_all, $exts, $sort));
 631:                         } elseif (is_file($filepath)) {
 632:                             array_push($files, $filepath);
 633:                         }
 634:                         break;
 635:                     default:
 636:                         if (is_dir($filepath) && $is_all == TRUE) {
 637:                             $files = array_merge($files, self::listDirInfo($filepath, $is_all, $exts, $sort));
 638:                         } elseif (preg_match("/\.($exts)/i", $filepath) && is_file($filepath)) {
 639:                             array_push($files, $filepath);
 640:                         }
 641:                         break;
 642:                 }
 643: 
 644:                 switch ($sort) {
 645:                     case 'asc':
 646:                         sort($files);
 647:                         break;
 648:                     case 'desc':
 649:                         rsort($files);
 650:                         break;
 651:                     case 'nat':
 652:                         natcasesort($files);
 653:                         break;
 654:                 }
 655:             }
 656:             closedir($fh);
 657:             return $files;
 658:         } else {
 659:             return FALSE;
 660:         }
 661:     }
