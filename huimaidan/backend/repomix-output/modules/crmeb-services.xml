398:     /**
399:      * 优化表
400:      *
401:      * @param array|string $tables
402:      * @throws \think\db\exception\BindParamException
403:      * @throws \think\exception\PDOException
404:      */
405:     public function optimize($tables)
406:     {
407:         if ($tables) {
408:             $db = self::connect();
409:             if (is_array($tables)) {
410:                 $tables = implode('`,`', $tables);
411:                 $list = $db->query("OPTIMIZE TABLE `{$tables}`");
412:             } else {
413:                 $list = $db->query("OPTIMIZE TABLE `{$tables}`");
414:             }
415:             if (!$list) {
416:                 throw new \Exception("data sheet'{$tables}'Repair mistakes please try again!");
417:             }
418:         } else {
419:             throw new \Exception("Please specify the table to be repaired!");
420:         }
421:     }
422: 
423:     /**
424:      * 修复表
425:      *
426:      * @param string|null $tables
427:      * @return array
428:      * @throws \think\db\exception\BindParamException
429:      * @throws \think\exception\PDOException
430:      */
431:     public function repair(?string $tables = null)
432:     {
433:         if ($tables) {
434:             $db = self::connect();
435:             if (is_array($tables)) {
436:                 $tables = implode('`,`', $tables);
437:                 $list = $db->query("REPAIR TABLE `{$tables}`");
438:             } else {
439:                 $list = $db->query("REPAIR TABLE `{$tables}`");
440:             }
441:             if ($list) {
442:                 return $list;
443:             } else {
444:                 throw new \Exception("data sheet'{$tables}'Repair mistakes please try again!");
445:             }
446:         } else {
447:             throw new \Exception("Please specify the table to be repaired!");
448:         }
449:     }
450: 
451:     /**
452:      * 写入SQL语句
453:      *
454:      * @param string $sql 要写入的SQL语句
455:      * @return boolean     true - 写入成功，false - 写入失败！
456:      */
457:     private function write(string $sql)
458:     {
459:         $size = strlen($sql);
460:         //由于压缩原因，无法计算出压缩后的长度，这里假设压缩率为50%，
461:         //一般情况压缩率都会高于50%；
462:         $size = $this->config['compress'] ? $size / 2 : $size;
463:         $this->open($size);
464:         return $this->config['compress'] ? @gzwrite($this->fp, $sql) : @fwrite($this->fp, $sql);
465:     }
466: 
467:     /**
468:      * 打开一个卷，用于写入数据
469:      *
470:      * @param integer $size 写入数据的大小
471:      */
472:     private function open(int $size)
473:     {
474:         if ($this->fp) {
475:             $this->size += $size;
476:             if ($this->size > $this->config['part']) {
477:                 $this->config['compress'] ? @gzclose($this->fp) : @fclose($this->fp);
478:                 $this->fp = null;
479:                 $this->file['part']++;
480:                 session('backup_file', $this->file);
481:                 $this->Backup_Init();
482:             }
483:         } else {
484:             $backuppath = $this->config['path'];
485:             $filename = "{$backuppath}{$this->file['name']}-{$this->file['part']}.sql";
486:             if ($this->config['compress']) {
487:                 $filename = "{$filename}.gz";
488:                 $this->fp = @gzopen($filename, "a{$this->config['level']}");
489:             } else {
490:                 $this->fp = @fopen($filename, 'a');
491:             }
492:             $this->size = filesize($filename) + $size;
493:         }
494:     }
495: 
496:     /**
497:      * 检查目录是否可写
498:      *
499:      * @param string $path
500:      * @return bool
501:      */
502:     protected function checkPath(string $path)
503:     {
504:         if (is_dir($path)) {
505:             return true;
506:         }
507:         if (mkdir($path, 0755, true)) {
508:             return true;
509:         } else {
510:             return false;
511:         }
512:     }
513: 
514:     /**
515:      * 析构方法，用于关闭文件资源
516:      */
517:     public function __destruct()
518:     {
519:         $this->config['compress'] ? @gzclose($this->fp) : @fclose($this->fp);
520:     }
521: }
