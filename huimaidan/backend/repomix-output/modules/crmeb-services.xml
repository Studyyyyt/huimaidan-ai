 240:             $wechatUserRepository = app()->make(WechatUserRepository::class);
 241:             $users = $wechatUserRepository->syncUser($openId, $userInfo, true);
 242:             $scanLogin = function () use ($message, $users) {
 243:                 $ticket = $message->EventKey;
 244:                 if (strpos($ticket, '_sys_scan_login.') === 0) {
 245:                     $key = str_replace('_sys_scan_login.', '', $ticket);
 246:                     if(Cache::has('_scan_login' . $key) && ($users[1]['uid'] ?? 0)){
 247:                         Cache::set('_scan_login' . $key, $users[1]['uid'] );
 248:                     }
 249:                 }
 250:             };
 251:             $response = null;
 252:             /** @var WechatReplyRepository $make * */
 253:             $make = app()->make(WechatReplyRepository::class);
 254:             event('wechat.message', compact('message'));
 255:             switch ($message->MsgType) {
 256:                 case 'event':
 257:                     event('wechat.event', compact('message'));
 258:                     switch (strtolower($message->Event)) {
 259:                         case 'subscribe':
 260:                             $scanLogin();
 261:                             $response = $this->qrKeyByMessage($message->EventKey) ?: $make->reply('subscribe');
 262:                             if (isset($message->EventKey) && $message->EventKey) {
 263:                                 /** @var WechatQrcodeRepository $qr */
 264:                                 $qr = app()->make(WechatQrcodeRepository::class);
 265:                                 if ($qrInfo = $qr->ticketByQrcode($message->Ticket)) {
 266:                                     $qrInfo->incTicket();
 267:                                     if (strtolower($qrInfo['third_type']) == 'spread' && $users) {
 268:                                         $spreadUid = $qrInfo['third_id'];
 269:                                         if ($users[1]['uid'] == $spreadUid)
 270:                                             return '自己不能推荐自己';
 271:                                         else if ($users[1]['spread_uid'])
 272:                                             return '已有推荐人!';
 273:                                         try {
 274:                                             $users[1]->setSpread($spreadUid);
 275:                                         } catch (Exception $e) {
 276:                                             return '绑定推荐人失败';
 277:                                         }
 278:                                     }
 279:                                 }
 280:                             }
 281:                             event('wechat.event.subscribe', compact('message'));
 282:                             break;
 283:                         case 'unsubscribe':
 284:                             $wechatUserRepository->unsubscribe($openId);
 285:                             event('wechat.event.unsubscribe', compact('message'));
 286:                             break;
 287:                         case 'scan':
 288:                             $scanLogin();
 289:                             $response = $this->qrKeyByMessage($message->EventKey) ?: $make->reply('subscribe');
 290:                             /** @var WechatQrcodeRepository $qr */
 291:                             $qr = app()->make(WechatQrcodeRepository::class);
 292:                             if ($message->EventKey && ($qrInfo = $qr->ticketByQrcode($message->Ticket))) {
 293:                                 $qrInfo->incTicket();
 294:                                 if (strtolower($qrInfo['third_type']) == 'spread' && $users) {
 295:                                     $spreadUid = $qrInfo['third_id'];
 296:                                     if ($users[1]['uid'] == $spreadUid)
 297:                                         return '自己不能推荐自己';
 298:                                     else if ($users[1]['spread_uid'])
 299:                                         return '已有推荐人!';
 300:                                     try {
 301:                                         $users[1]->setSpread($spreadUid);
 302:                                     } catch (Exception $e) {
 303:                                         return '绑定推荐人失败';
 304:                                     }
 305:                                 }
 306:                             }
 307:                             event('wechat.event.scan', compact('message'));
 308:                             break;
 309:                         case 'location':
 310:                             event('wechat.event.location', compact('message'));
 311:                             break;
 312:                         case 'click':
 313:                             $response = $make->reply($message->EventKey);
 314:                             event('wechat.event.click', compact('message'));
 315:                             break;
 316:                         case 'view':
 317:                             event('wechat.event.view', compact('message'));
 318:                             break;
 319:                         case 'funds_order_pay':
 320:                             if (($count = strpos($message['order_info']['trade_no'], '_')) !== false) {
 321:                                 $trade_no = substr($message['order_info']['trade_no'], $count + 1);
 322:                             } else {
 323:                                 $trade_no = $message['order_info']['trade_no'];
 324:                             }
 325:                             $prefix = substr($trade_no, 0, 3);
 326:                             //处理一下参数
 327:                             switch ($prefix) {
 328:                                 case StoreOrderRepository::TYPE_SN_ORDER:
 329:                                     $attach = 'order';
 330:                                     break;
 331:                                 case StoreOrderRepository::TYPE_SN_PRESELL:
 332:                                     $attach = 'presell';
 333:                                     break;
 334:                                 case StoreOrderRepository::TYPE_SN_USER_ORDER:
 335:                                     $attach = 'user_order';
 336:                                     break;
 337:                                 case StoreOrderRepository::TYPE_SN_USER_RECHARGE:
 338:                                     $attach = 'user_recharge';
 339:                                     break;
 340:                             }
 341:                             event('pay_success_' . $attach, ['order_sn' => $message['order_info']['trade_no'], 'data' => $message, 'is_combine' => 0]);
 342:                             break;
 343:                     }
 344:                     break;
 345:                 case 'text':
 346:                     if (preg_match('/^(\/@[1-9]{1}).*\*\//', $message->Content)) {
 347:                         $command = app()->make(CopyCommand::class)->getMassage($message->Content);
 348:                         if (empty($command)) {
 349:                             $response = self::textMessage('无效口令');
 350:                         } else {
 351:                             if ($command['type'] == 30) $command['type'] = 3;
 352:                             $key = '_scan_url_' . $command['type'] . '_' . $command['id'] . '_' . $command['uid'];
 353:                             $response = $this->qrKeyByMessage($key);
 354:                         }
 355:                     } else {
 356:                         $response = $make->reply($message->Content);
 357:                     }
 358:                     event('wechat.message.text', compact('message'));
 359:                     break;
 360:                 case 'image':
 361:                     event('wechat.message.image', compact('message'));
 362:                     break;
 363:                 case 'voice':
 364:                     event('wechat.message.voice', compact('message'));
 365:                     break;
 366:                 case 'video':
 367:                     event('wechat.message.video', compact('message'));
 368:                     break;
 369:                 case 'location':
 370:                     event('wechat.message.location', compact('message'));
 371:                     break;
 372:                 case 'link':
 373:                     event('wechat.message.link', compact('message'));
 374:                     break;
 375:                 // ... 其它消息
 376:                 default:
 377:                     event('wechat.message.other', compact('message'));
 378:                     break;
 379:             }
 380: 
 381:             return $response ?? false;
 382:         });
