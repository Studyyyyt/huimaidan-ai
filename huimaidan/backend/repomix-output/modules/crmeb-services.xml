 13: namespace crmeb\services\easywechat\pay;
 14: 
 15: 
 16: use crmeb\services\easywechat\BaseClient;
 17: use think\exception\ValidateException;
 18: use think\facade\Log;
 19: 
 20: class Client extends BaseClient
 21: {
 22: 
 23:     protected $isService = false;
 24: 
 25:     public function handleNotify($callback)
 26:     {
 27:         $request = request();
 28:         $success = $request->post('event_type') === 'TRANSACTION.SUCCESS';
 29:         $data = $this->decrypt($request->post('resource', []));
 30:         Log::info('支付回调参数v3：'.var_export($request->post(),1));
 31:         $handleResult = call_user_func_array($callback, [json_decode($data, true), $success]);
 32:         if (is_bool($handleResult) && $handleResult) {
 33:             $response = [
 34:                 'code' => 'SUCCESS',
 35:                 'message' => 'OK',
 36:             ];
 37:         } else {
 38:             $response = [
 39:                 'code' => 'FAIL',
 40:                 'message' => $handleResult,
 41:             ];
 42:         }
 43: 
 44:         return response($response, 200, [], 'json');
 45:     }
 46: 
 47:     public function pay($type, $order)
 48:     {
 49: 
 50:         $params = [
 51:             'appid' => $this->app['config']['app_id'],
 52:             'mchid' => $this->app['config']['payment']['merchant_id'],
 53:             'description' => $order['body'],
 54:             'out_trade_no' => $order['out_trade_no'],
 55:             'attach' => $order['attach'],
 56:             'notify_url' => $this->app['config']['payment']['notify_url'],
 57:             'amount' => [
 58:                 'total' => intval($order['total_fee']),
 59:                 'currency' => 'CNY'
 60:             ],
 61:             'scene_info' => [
 62:                 'device_id' => 'shop system',
 63:                 'payer_client_ip' => request()->ip(),
 64:             ],
 65:         ];
 66: 
 67:         if ($type === 'h5') {
 68:             $params['scene_info']['h5_info'] = [
 69:                 'type' => $order['h5_type'] ?? 'Wap'
 70:             ];
 71:         }
 72: 
 73:         if (isset($order['openid'])) {
 74:             $params['payer'] = [
 75:                 'openid' => $order['openid']
 76:             ];
 77:         }
 78:         Log::info('微信v3支付：'.var_export($params,true));
 79:         $content = json_encode($params, JSON_UNESCAPED_UNICODE);
 80: 
 81:         $res = $this->request('/v3/pay/transactions/' . $type, 'POST', ['sign_body' => $content]);
 82:         if (isset($res['code'])) {
 83:             throw new ValidateException('微信接口报错:' . $res['message']);
 84:         }
 85:         return $res;
 86:     }
 87: 
 88:     public function payApp($options)
 89:     {
 90:         $res = $this->pay('app', $options);
 91:         return $this->configForAppPayment($res['prepay_id']);
 92:     }
 93: 
 94:     /**
 95:      * @param string $type 场景类型，枚举值： iOS：IOS移动应用； Android：安卓移动应用； Wap：WAP网站应用
 96:      */
 97:     public function payH5($options, $type = 'Wap')
 98:     {
 99:         $options['h5_type'] = $type;
100:         return $this->pay('h5', $options);
101:     }
102: 
103:     public function payJsapi($options)
104:     {
105:         $res = $this->pay('jsapi', $options);
106:         return $this->configForJSSDKPayment($res['prepay_id']);
107:     }
108: 
109:     public function payNative($options)
110:     {
111:         unset($options['openid']);
112:         return $this->pay('native', $options);
113:     }
114: 
115:     public function refund($orderNo, $refundNo, $totalFee, $refundFee, $opUserId = null, $type, $refundAccount, $refundReason)
116:     {
117:         $params = [
118:             $type => $orderNo,
119:             'out_refund_no' => $refundNo,
120:             'amount' => [
121:                 'refund' => intval($refundFee),
122:                 'total' => intval($totalFee),
123:                 'currency' => 'CNY'
124:             ]
125:         ];
126: 
127:         if (isset($refundReason)) {
128:             $params['reason'] = $refundReason;
129:         }
130: //        if (isset($refundAccount)) {
131: //            $params['refund_account'] = $refundAccount;
132: //        }
133:         $content = json_encode($params);
134:         $res = $this->request('/v3/refund/domestic/refunds', 'POST', ['sign_body' => $content], true);
135:         if (isset($res['code'])) {
136:             throw new ValidateException('微信接口报错:' . $res['message']);
137:         }
138:         return $res;
139:     }
140: 
141:     public function configForPayment($prepayId, $json = true)
142:     {
143:         $params = [
144:             'appId' => $this->app['config']['app_id'],
145:             'timeStamp' => strval(time()),
146:             'nonceStr' => uniqid(),
147:             'package' => "prepay_id=$prepayId",
148:             'signType' => 'RSA',
149:         ];
150:         $message = $params['appId'] . "\n" .
151:             $params['timeStamp'] . "\n" .
152:             $params['nonceStr'] . "\n" .
153:             $params['package'] . "\n";
154:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
155:         $sign = base64_encode($raw_sign);
156: 
157:         $params['paySign'] = $sign;
158: 
159:         return $json ? json_encode($params) : $params;
160:     }
161: 
162:     /**
163:      * Generate app payment parameters.
164:      *
165:      * @param string $prepayId
166:      *
167:      * @return array
168:      */
169:     public function configForAppPayment($prepayId)
170:     {
171:         $params = [
172:             'appid' => $this->app['config']['app_id'],
173:             'partnerid' => $this->app['config']['payment']['merchant_id'],
174:             'prepayid' => $prepayId,
175:             'noncestr' => uniqid(),
176:             'timestamp' => time(),
177:             'package' => 'Sign=WXPay',
178:         ];
179:         $message = $params['appid'] . "\n" .
180:             $params['timestamp'] . "\n" .
181:             $params['noncestr'] . "\n" .
182:             $params['prepayid'] . "\n";
183:         openssl_sign($message, $raw_sign, $this->getPrivateKey(), 'sha256WithRSAEncryption');
184:         $sign = base64_encode($raw_sign);
185: 
186:         $params['sign'] = $sign;
187: 
188:         return $params;
189:     }
190: 
191:     public function configForJSSDKPayment($prepayId)
192:     {
193:         $config = $this->configForPayment($prepayId, false);
194: 
195:         $config['timestamp'] = $config['timeStamp'];
196:         unset($config['timeStamp']);
197: 
198:         return $config;
199:     }
200: 
201: }
</file>

