 420:      * @param boolean $overWrite 是否覆盖文件和文件夹
 421:      * @return boolean
 422:      */
 423:     public function handleDir(string $old_path, string $new_path, string $type = 'copy', bool $overWrite = FALSE)
 424:     {
 425:         $new_path = $this->checkPath($new_path);
 426:         $old_path = $this->checkPath($old_path);
 427:         if (!is_dir($old_path)) return FALSE;
 428: 
 429:         if (!file_exists($new_path)) $this->createDir($new_path);
 430: 
 431:         $dirHandle = opendir($old_path);
 432: 
 433:         if (!$dirHandle) return FALSE;
 434: 
 435:         $boolean = TRUE;
 436: 
 437:         while (FALSE !== ($file = readdir($dirHandle))) {
 438:             if ($file == '.' || $file == '..') continue;
 439: 
 440:             if (!is_dir($old_path . $file)) {
 441:                 $boolean = $this->handleFile($old_path . $file, $new_path . $file, $type, $overWrite);
 442:             } else {
 443:                 $this->handleDir($old_path . $file, $new_path . $file, $type, $overWrite);
 444:             }
 445:         }
 446:         switch ($type) {
 447:             case 'copy':
 448:                 closedir($dirHandle);
 449:                 return $boolean;
 450:                 break;
 451:             case 'move':
 452:                 closedir($dirHandle);
 453:                 return @rmdir($old_path);
 454:                 break;
 455:         }
 456:     }
