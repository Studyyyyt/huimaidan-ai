132:     /**
133:      *  需要分账的
134:      * @param array $options
135:      * @param bool $finish
136:      * @return mixed
137:      * @author Qinii
138:      */
139:     public function profitsharingOrder(array $options, bool $finish = false)
140:     {
141:         $params = [
142:             'appid' => $this->app['config']['app_id'],
143:             'sub_mchid' => $options['sub_mchid'],
144:             'transaction_id' => $options['transaction_id'],
145:             'out_order_no' => $options['out_order_no'],
146:             'receivers' => [],
147:             'finish' => $finish
148:         ];
149: 
150:         foreach ($options['receivers'] as $receiver) {
151:             $data = [
152:                 'amount' => intval($receiver['amount'] * 100),
153:                 'description' => $receiver['body'] ?? $options['body'] ?? '',
154:             ];
155:             $data['receiver_account'] = $receiver['receiver_account'];
156:             if (isset($receiver['receiver_name'])) {
157:                 $data['receiver_name'] = $receiver['receiver_name'];
158:                 $data['type'] = 'PERSONAL_OPENID';
159:             } else {
160:                 $data['type'] = 'MERCHANT_ID';
161:             }
162:             $params['receivers'][] = $data;
163:         }
164:         $content = json_encode($params);
165:         $res = $this->request('/v3/ecommerce/profitsharing/orders', 'POST', ['sign_body' => $content]);
166:         if (isset($res['code'])) {
167:             throw new ValidateException('微信接口报错:' . $res['message']);
168:         }
169:         return $res;
