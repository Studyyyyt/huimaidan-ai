686:     /**
687:      * 组合成xml
688:      * @param array $data
689:      * @param string $root
690:      * @param string $itemKey
691:      * @return string
692:      * @author 等风来
693:      * @email 136327134@qq.com
694:      * @date 2022/10/17
695:      */
696:     protected function xmlBuild(array $xmlAttr, string $root = 'xml', string $itemKey = 'item')
697:     {
698:         $xml = '<' . $root . '>';
699:         $xml .= '<' . $itemKey . '>';
700: 
701:         foreach ($xmlAttr as $kk => $vv) {
702:             if (is_array($vv)) {
703:                 foreach ($vv as $v) {
704:                     $xml .= '<' . $kk . '>' . $v . '</' . $kk . '>';
705:                 }
706:             } else {
707:                 $xml .= '<' . $kk . '>' . $vv . '</' . $kk . '>';
708:             }
709:         }
710:         $xml .= '</' . $itemKey . '>';
711:         $xml .= '</' . $root . '>';
712: 
713:         return $xml;
714:     }
