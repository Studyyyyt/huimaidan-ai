346:     /**
347:      * 上传文件
348:      * @param string $file
349:      * @return array|bool|mixed|\StdClass|string
350:      */
351:     public function move(string $file = 'file')
352:     {
353:         $fileHandle = app()->request->file($file);
354: 
355:         if (!$fileHandle) {
356:             return $this->setError('上传的文件不存在');
357:         }
358:         if ($this->validate) {
359:             if (!in_array($fileHandle->getOriginalExtension(), $this->validate['fileExt'])) {
360:                 return $this->setError('不合法的文件后缀:'.$fileHandle->getOriginalExtension());
361:             }
362:             if (filesize($fileHandle) > $this->validate['filesize']) {
363:                 return $this->setError('文件过大');
364:             }
365:             if (!in_array($fileHandle->getOriginalMime(), $this->validate['fileMime'])) {
366:                 return $this->setError('不合法的文件类型:'.$fileHandle->getOriginalMime());
367:             }
368:         }
369:         $key = $this->saveFileName($fileHandle->getRealPath(), $fileHandle->getOriginalExtension());
370:         $path = ($this->path ? trim($this->path, '/') . '/' : '');
371:         try {
372:             $uploadMgr = new UcloudUploadManager($this->app());
373:             [$result, $error] = $uploadMgr->PutFile($this->storageName, $path . $key, $fileHandle->getRealPath());
374:             if ($error !== null) {
375:                 return $this->setError($error->ErrMsg);
376:             }
377: 
378:             if ($this->cdn) {
379:                 $src = $this->cdn . $path . $key;
380:             } else {
381:                 $src = 'https://' . $uploadMgr->MakePublicUrl($this->storageName, $path . $key);
382:             }
383: 
384:             $this->fileInfo->uploadInfo = $result;
385:             $this->fileInfo->filePath = $src;
386:             $this->fileInfo->fileName = $key;
387:             return $this->fileInfo;
388:         } catch (UploadException $e) {
389:             return $this->setError($e->getMessage());
390:         }
391:     }
