 7: class Utility
 8: {
 9:     /**
10:      * @param int $padding
11:      */
12:     private static function paddingModeLimitedCheck(int $padding): void
13:     {
14:         if (!($padding === OPENSSL_PKCS1_OAEP_PADDING || $padding === OPENSSL_PKCS1_PADDING)) {
15:             throw new AdminException(sprintf("Doesn't supported padding mode(%d), here only support OPENSSL_PKCS1_OAEP_PADDING or OPENSSL_PKCS1_PADDING.", $padding));
16:         }
17:     }
18: 
19:     /**
20:      * 加密数据
21:      * @param string $plaintext
22:      * @param int $padding
23:      * @return string
24:      */
25:     public function encryptor(string $plaintext, int $padding = OPENSSL_PKCS1_OAEP_PADDING)
26:     {
27:         self::paddingModeLimitedCheck($padding);
28: 
29:         if (!openssl_public_encrypt($plaintext, $encrypted, $this->getPublicKey(), $padding)) {
30:             throw new AdminException('Encrypting the input $plaintext failed, please checking your $publicKey whether or nor correct.');
31:         }
32: 
33:         return base64_encode($encrypted);
34:     }
35: 
36:     public static function encryptTel($tel)
37:     {
38:         $new_tel = substr_replace($tel, '****', 3, 4);
39:         return $new_tel;
40:     }
