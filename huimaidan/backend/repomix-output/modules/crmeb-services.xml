104:         if ($urls) {
105:             try{
106:                 foreach ($urls as $url) {
107:                     $res[] = $this->downloadImage($url,$path,'',$upload_type);
108:                 }
109:                 return $res;
110:             }catch (\Exception $exception) {
111:                 throw new ValidateException($exception->getMessage());
112:             }
113:         }
114:         return [];
115:     }
