433:     // obj 转 query string
434:     public function json2str($obj, $notEncode = false)
435:     {
436:         ksort($obj);
437:         $arr = array();
438:         if (!is_array($obj)) {
439:             return $this->setError($obj . " must be a array");
440:         }
441:         foreach ($obj as $key => $val) {
442:             array_push($arr, $key . '=' . ($notEncode ? $val : rawurlencode($val)));
443:         }
444:         return join('&', $arr);
445:     }
