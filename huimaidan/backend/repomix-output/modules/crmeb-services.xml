234:                     $value = array_shift($item);
235:                 } else {
236:                     [$value] = $item;
237:                 }
238:             } else {
239:                 $value = 'error data item.';
240:             }
241: 
242:             $return[$key] = ['value' => $value];
243:         }
244: 
245:         return $return;
