192:     public function sceneUpdate(array $data)
193:     {
194:         if (!$this->scene('add')->check($data)) {
195:             return false;
196:         }
197:         if (!$data['spec_type'] && count($data['attrValue']) > 1) {
198:             $this->error = '单规格商品属性错误';
199:             return false;
200:         }
201: 
202:         if($data['type'] == NewProductRepository::DEFINE_TYPE_RESERVATION) {
203:             if(!$this->scene('reservation')->check($data)) {
204:                 return false;
205:             }
206:         }
207: 
208:         return true;
