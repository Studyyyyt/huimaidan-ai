116:     public function update(array $basicSettings, array $deliveryParams)
117:     {
118:         if(empty($basicSettings['mer_delivery_type'])) {
119:             $this->error = '配送方式不能为空';
120:             return false;
121:         }
122: 
123:         if(!$this->scene('basic')->check($basicSettings)) {
124:             return false;
125:         }
126:         if(!$this->scene('config')->check($deliveryParams)) {
127:             return false;
128:         }
129:         if($deliveryParams['is_premium_stack_enabled']) {
130:             // 距离溢价设置验证
131:             $kaishiDistance = $deliveryParams['distance_premium_config']['level_first']['lt_distance'];
132:             if(!empty($deliveryParams['distance_premium_config']['level_stairs'])) {
133:                 foreach ($deliveryParams['distance_premium_config']['level_stairs'] as $key => $item) {
134:                     $num = $key + 1;
135:                     if (!$this->scene('stair_distance')->check($item)) {
136:                         return false;
137:                     }
138:                     if($item['start_distance'] >= $item['end_distance']) {
139:                         $this->error = '第'.$num.'级阶梯公里数范围有误';
140:                         return false;
141:                     }
142:                     if($key == 0 && $kaishiDistance > $item['start_distance']) {
143:                         $this->error = '范围公里数，必须大于等于基础公里数';
144:                         return false;
145:                     }
146:                     if($kaishiDistance > $item['start_distance']) {
147:                         $this->error = '第'.$num.'级范围公里数必须大于等于第'.($num - 1).'级范围公里数';
148:                         return false;
149:                     }
150:                     if($item['add_distance'] === '' || $item['add_distance'] <= 0) {
151:                         $this->error = '第'.$num.'级范围公里数,增加公里数必须大于0';
152:                         return false;
153:                     }
154:                     if($item['add_amount'] === '' || $item['add_amount'] <= 0) {
155:                         $this->error = '第'.$num.'级范围公里数,增加运费必须大于0';
156:                         return false;
157:                     }
158: 
159:                     $kaishiDistance = $item['end_distance'];
160:                 }
161:             }
162:             if($kaishiDistance > $deliveryParams['distance_premium_config']['level_last']['gt_distance']) {
163:                 $this->error = '最后一级公里数,必须大于等于上一级公里数';
164:                 return false;
