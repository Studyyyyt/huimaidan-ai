173:     public function sceneCreate(array $data)
174:     {
175:         if (!$this->scene('add')->check($data)) {
176:             return false;
177:         }
178:         if (!$data['spec_type'] && count($data['attrValue']) > 1) {
179:             $this->error = '单规格商品属性错误';
180:             return false;
181:         }
182: 
183:         if($data['type'] == NewProductRepository::DEFINE_TYPE_RESERVATION) {
184:             if(!$this->scene('reservation')->check($data)) {
185:                 return false;
186:             }
187:         }
188: 
189:         return true;
