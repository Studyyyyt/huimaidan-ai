 80: 
 81:             //当证件持有人类型为经营者/法定代表人且证件类型为“身份证”时填写。
 82:             if ($item['identity_info']['id_doc_type'] == 'IDENTIFICATION_TYPE_IDCARD') {
 83:                 if (!$item['identity_info']['id_card_info']) return $this->error('身份证信息');
 84:                 if (!$item['identity_info']['id_card_info']['id_card_copy']) return $this->error('身份证人像面照片');
 85:                 if (!$item['identity_info']['id_card_info']['id_card_national']) return $this->error('身份证国徽面照片');
 86:                 if (!$item['identity_info']['id_card_info']['id_card_name']) return $this->error('身份证姓名');
 87:                 if (!$item['identity_info']['id_card_info']['id_card_number']) return $this->error('身份证号码');
 88:                 if (!$item['identity_info']['id_card_info']['card_period_begin']) return $this->error('身份证有效期开始时间');
 89:                 if (!$item['identity_info']['id_card_info']['card_period_end']) return $this->error('身份证有效期结束时间');
 90:             } else { //当证件持有人类型为经营者/法定代表人且证件类型不为“身份证”时填写。
 91:                 if (!$item['identity_info']['id_doc_info']) return $this->error('其他类型证件信息');
 92:                 if (!$item['identity_info']['id_doc_info']['id_doc_copy']) return $this->error('证件正面照片');
 93:                 if (!$item['identity_info']['id_doc_info']['id_doc_copy_back']) return $this->error('证件反面照片');
 94:                 if (!$item['identity_info']['id_doc_info']['id_doc_name']) return $this->error('证件姓名');
 95:                 if (!$item['identity_info']['id_doc_info']['id_doc_number']) return $this->error('证件号码');
 96:                 if (!$item['identity_info']['id_doc_info']['doc_period_begin']) return $this->error('证件有效期开始时间');
 97:                 if (!$item['identity_info']['id_doc_info']['doc_period_end']) return $this->error('证件有效期结束时间');
 98:             }
 99:         } else {
100:             if (!$item['identity_info']['authorize_letter_copy']) return $this->error('法定代表人说明函');
101:         }
102:         return true;
