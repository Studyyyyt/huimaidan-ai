211:     public function sceneBatchProductStock(array $data)
212:     {
213:         if(!isset($data['stockValue'])) {
214:             $this->error = '预约商品规格错误';
215:             return false;
216:         }
217:         foreach ($data['stockValue'] as $item) {
218:             if(!isset($item['value_id'])) {
219:                 $this->error = '预约商品规格传参错误';
220:                 return false;
221:             }
222:             foreach ($item['reservation'] as $reservation) {
223:                 if(!isset($reservation['stock']) || !isset($reservation['attr_reservation_id'])) {
224:                     $this->error = '预约商品规格错误';
225:                     return false;
226:                 }
227: 
228:                 if($reservation['stock'] < 0) {
229:                     $this->error = '预约库存不可小于0';
230:                     return false;
231:                 }
232: 
233:             }
234:         }
235: 
236:         return true;
237:     }
238: 
239:     protected function validateTimePeriods($periods)
240:     {
241:         if (!is_array($periods) || empty($periods)) {
242:             return '时段不能为空';
243:         }
244: 
245:         $uniquePeriods = [];
246:         $lastEndTime = null;
247:         foreach ($periods as $period) {
248:             if (!isset($period['start']) || !isset($period['end']) || !isset($period['is_show'])) {
249:                 return '时段传参错误';
250:             }
251: 
252:             $startTime = strtotime($period['start']);
253:             $endTime = strtotime($period['end']);
254:             if (!$startTime || !$endTime) {
255:                 return '时间格式错误';
256:             }
257:             if ($startTime >= $endTime) {
258:                 return '时段结束时间必须大于开始时间';
259:             }
260:             // 检查时间段是否递增且无交集
261:             if ($lastEndTime !== null && $startTime < $lastEndTime) {
262:                 return '时段必须递增且无交集';
263:             }
264: 
265:             $lastEndTime = $endTime;
266:             // 检查重复时段
267:             $timeKey = $period['start'] . '-' . $period['end'];
268:             if (in_array($timeKey, $uniquePeriods)) {
269:                 return '存在重复时段';
270:             }
271:             $uniquePeriods[] = $timeKey;
272:         }
273: 
274:         return true;
275:     }
276: }
