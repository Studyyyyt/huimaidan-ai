14: namespace app\validate\merchant;
15: 
16: use think\Validate;
17: 
18: class ShippingTemplateValidate extends Validate
19: {
20:     protected $failException = true;
21: 
22:     protected $rule = [
23:         'name|名称' => 'require|max:32',
24:         'type|计费方式' => 'require|in:0,1,2',
25:         'appoint|指定包邮状态' => 'require|in:0,1',
26:         'region|配送区域信息' => 'Array|require|min:1|region',
27:         'undelivery|区域不配送状态' => 'require|in:0,1,2',
28:         'free|包邮信息' => 'requireIf:appoint,1|Array|free',
29:         'undelives|不配送区域信息'=>'requireIf:undelivery,1|Array|undelive',
30:     ];
31: 
32:     protected function region($value,$rule,$data)
33:     {
34:         foreach ($value as $k => $v){
35:             if ($k != 0 && empty($v['city_id']))
36:                 return '配送城市信息不能为空';
37:             if (!is_numeric($v['first']) || $v['first'] < 0)
38:                 return '首件条件不能小0';
39:             if (!is_numeric($v['first_price']) || $v['first_price'] < 0)
40:                 return '首件金额不能小于0';
41:             if (!is_numeric($v['continue']) || ($v['continue'] < 0))
42:                 return '续件必须为不小于零的整数';
43:             if (!is_numeric($v['continue_price']) || $v['continue_price'] < 0 )
44:                 return '追加金额为不小于零的数';
45:         }
46:         return true;
47:     }
48:     protected function free($value,$rule,$data)
49:     {
50:         if(!$data['appoint']) return true;
51:         foreach ($value as $v){
52:             if (empty($v['city_id']))
53:                 return '包邮城市信息不能为空';
54:             if (!is_numeric($v['number']) || $v['number'] < 0)
55:                 return '包邮条件为不小于零的整数';
56:             if (!is_numeric($v['price']) ||$v['price'] < 0)
57:                 return '包邮金额必须为不小于零的数字';
58:         }
59:         return true;
60:     }
61: 
62:     protected function undelive($value,$rule,$data)
63:     {
64:         if($data['undelivery'] == 1){
65:             if (empty($value['city_id']))
66:                 return '不配送城市信息不能为空';
67:         }
68:         return true;
69:     }
70: }
</file>

