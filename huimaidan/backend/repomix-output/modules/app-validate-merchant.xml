 82:     protected function checkValueLength($array) {
 83:         $maxLength = 30;
 84:         foreach ($array as $item) {
 85:             if (isset($item['value']) && (mb_strlen($item['value']) > $maxLength)) {
 86:                 return '规格长度不能超过30个字符'; // 发现超过 20 的值，返回 false
 87:             }
 88:             if (isset($item['detail']) && is_array($item['detail'])) {
 89:                 foreach ($item['detail'] as $detailItem) {
 90:                     if (isset($detailItem['value']) && mb_strlen($detailItem['value']) > $maxLength) {
 91:                         return '规格值长度不能超过30个字符';
 92:                     }
 93:                 }
 94:             }
 95:         }
 96:         return true; // 所有值都符合长度限制
 97:     }
