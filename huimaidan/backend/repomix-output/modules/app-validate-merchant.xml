 99:     protected function payLimit($value,$rule,$data)
100:     {
101:         if ($value && ($data['once_max_count'] < $data['once_min_count']))
102:            return '限购数量不能小于最少购买件数';
103:         return true;
104:     }
105: 
106:     protected function productAttrValue($value,$rule,$data)
107:     {
108:         $arr = [];
109:         try{
110:             foreach ($value as $v){
111:                 $sku = '';
112:                 if(isset($v['detail']) && is_array($v['detail'])){
113:                     sort($v['detail'],SORT_STRING);
114:                     $sku = implode(',',$v['detail']);
115:                     if(in_array($sku,$arr)) return '商品SKU重复';
116:                     $arr[] = $sku;
117:                 }
118:                 if(isset($data['extension_type']) && $data['extension_type'] && systemConfig('extension_status')){
119:                     if(!isset($v['extension_one']) || !isset($v['extension_two'])) return '佣金金额必须填写';
120:                     if(($v['extension_one'] < 0) || ($v['extension_two'] < 0))
121:                         return '佣金金额不可存在负数';
122:                     if($v['price'] < bcadd($v['extension_one'],$v['extension_two'],2))
123:                         return '自定义佣金总金额不能大于商品售价';
124:                 }
125:                 if ($data['product_type'] == 20 && !$v['ot_price']) {
126:                     return '积分商品兑换积分必须大于0';
127:                 }
128:                 if($data['type'] == NewProductRepository::DEFINE_TYPE_RESERVATION) {
129:                     if(!isset($v['reservation'])) {
130:                         return '预约商品规格错误';
131:                     }
132:                     foreach ($v['reservation'] as $item) {
133:                         if(!isset($item['start_time'])
134:                             || !isset($item['end_time'])
135:                             || !isset($item['stock'])
136:                         ) {
137:                             return '预约商品规格错误';
138:                         }
139: 
140:                         if($item['stock'] < 0) {
141:                             return '预约库存不可小于0';
142:                         }
143:                     }
144:                 }
145:             }
146:         } catch (\Exception $exception) {
147:             return '商品属性格式错误';
148:         }
149:         return true;
150:     }
151: 
152:     protected function checkUnique($value,$rule,$data)
153:     {
154:         if($data['type'] == NewProductRepository::DEFINE_TYPE_RESERVATION && count($value) > 1) {
155:             return '预约商品规格最多只能添加一个';
156:         }
157: 
158:         $arr = [];
159:         foreach ($value as $item){
160:             if(in_array($item['value'],$arr))return '规格重复';
161:             $arr[] = $item['value'];
162:             if ($data['product_type'] == 20) {
163:                 $count = array_unique($item['detail']);
164:             } else {
165:                 $count = array_unique(array_column($item['detail'],'value'));
166:             }
167:             if (count($item['detail']) != count($count))
168:                 return '属性重复';
169:         }
170:         return true;
171:     }
