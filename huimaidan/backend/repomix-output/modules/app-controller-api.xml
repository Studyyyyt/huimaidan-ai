239:     /**
240:      * 获取购物车商品数量
241:      *
242:      * 本函数用于获取当前用户购物车中的商品总数。它通过调用仓库层的相应方法来实现，
243:      * 并使用JSON工具类对结果进行包装，以便于前端获取和显示。
244:      *
245:      * @return \Illuminate\Http\JsonResponse 返回一个包含购物车商品数量的JSON响应
246:      */
247:     public function cartCount()
248:     {
249:         // 调用应用程序中的JSON工具类，以成功状态返回用户购物车商品数量
250:         return app('json')->success($this->repository->getCartCount($this->request->uid()));
251:     }
252: 
253:     /**
254:      * 检查购物车中商品的合法性
255:      * 该方法用于在添加或更新购物车商品前，验证商品及相关属性的有效性，包括商品存在性、库存、属性唯一性等。
256:      * @param array $data 包含商品ID、属性唯一标识和购买数量的数据数组
257:      * @return array 返回经过验证和处理后的数据数组，包含是否为新商品、用户ID、商家ID等信息
258:      * @throws ValidateException 如果验证过程中发现任何问题，将抛出此异常
259:      */
260:     public function check($data)
261:     {
262:         // 根据商品ID获取商品信息
263:         $product = app()->make(ProductRepository::class)->get($data['product_id']);
264:         // 如果商品不存在，则抛出异常
265:         if (!$product) {
266:             throw new ValidateException('商品不存在');
267:         }
268:         // 如果购买数量小于0，则抛出异常
269:         if ($data['cart_num'] < 0) {
270:             throw new ValidateException('数量必须大于0');
271:         }
272:         // 根据商品属性唯一标识获取属性值信息
273:         if (!$res = app()->make(ProductAttrValueRepository::class)->getOptionByUnique($data['product_attr_unique'])) {
274:             throw new ValidateException('SKU不存在');
275:         }
276:         // 如果获取的属性值所属的商品ID与输入的商品ID不一致，则抛出异常
277:         if ($res['product_id'] != $data['product_id']) {
278:             throw new ValidateException('数据不一致');
279:         }
280:         // 如果购买数量超过属性值的库存，则抛出异常
281:         if ($res['stock'] < $data['cart_num']) {
282:             throw new ValidateException('库存不足');
283:         }
284:         // 设置数据数组中的字段，标记为新商品，设置用户ID和商家ID
285:         $data['is_new'] = 1;
286:         $data['uid'] = $this->request->uid();
287:         $data['mer_id'] = $product['mer_id'];
288:         // 返回处理后的数据数组
289:         return $data;
290:     }
291: 
292:     /**
293:      * 再次提交数据进行验证和创建
294:      * 本函数的目的是接收并验证一组数据，然后将这些数据提交给仓库创建购物车项。
295:      * 它首先通过验证器对每个数据项进行验证，然后将验证通过的数据项创建为购物车项。
296:      *
297:      * @param validate $validate 验证器对象，用于数据验证
298:      * @return json 返回一个包含创建的购物车项ID的JSON对象
299:      */
300:     public function again(validate $validate)
301:     {
302:         // 从请求中获取名为data的参数，如果不存在则默认为空数组
303:         $param = $this->request->param('data/a',[]);
304: 
305:         // 遍历参数数组中的每个数据项，进行验证和处理
306:         foreach ($param as $data){
307:             // 使用验证器对当前数据项进行验证
308:             $validate->check($data);
309:             // 调用本对象的check方法进行进一步处理，将处理结果存入$item数组
310:             $item[] = $this->check($data);
311:         }
312: 
313:         // 遍历$item数组，将每个数据项提交给仓库创建购物车项，并将购物车ID存入$ids数组
314:         foreach ($item as $it){
315:             // 在仓库中创建购物车项，并获取创建的购物车ID
316:             $it__id = $this->repository->create($it);
317:             // 将购物车ID转换为整数类型，并存入$ids数组
318:             $ids[] = (int)$it__id['cart_id'];
319:         }
320: 
321:         // 返回一个成功的JSON响应，包含所有创建的购物车项的ID
322:         return app('json')->success(['cart_id' => $ids]);
323:     }
324: 
325:     /**
326:      * 检查请求参数的合法性，并处理传播者ID的相关逻辑。
327:      *
328:      * 此方法主要用于在添加或更新购物车项时，验证请求参数是否符合预期规则，
329:      * 并对传播者ID进行特殊处理，确保其有效性。
330:      *
331:      * @param validate $validate 验证器对象，用于参数验证。
332:      * @return array 返回验证后的参数数据。
333:      */
334:     public function checkParams(validate $validate)
335:     {
336:         // 从请求中提取指定参数，包括产品ID、产品属性唯一标识、购物车数量、是否为新品、产品类型、团购ID和传播者ID。
337:         $data = $this->request->params(['product_id','product_attr_unique','cart_num','is_new',['product_type',0],['group_buying_id',0],['spread_id',0],['reservation_id',0],['reservation_date','']]);
338: 
339:         // 使用验证器对提取的参数数据进行验证。
340:         $validate->check($data);
341: 
342:         // 如果传播者ID存在
343:         if ($data['spread_id']) {
344:             // 如果传播者ID不等于当前用户ID，则检查该传播者ID对应的用户是否存在。
345:             if ($data['spread_id'] !== $this->request->userInfo()->uid){
346:                 // 如果传播者用户不存在，则将传播者ID设为0。
347:                 $user = app()->make(UserRepository::class)->get($data['spread_id']);
348:                 if (!$user) $data['spread_id'] = 0;
349:             } else {
350:                 // 如果传播者ID等于当前用户ID，为了防止自传播，将传播者ID设为0。
351:                 $data['spread_id'] = 0;
352:             }
353:         }
354: 
355:         // 返回处理后的参数数据。
356:         return $data;
357:     }
