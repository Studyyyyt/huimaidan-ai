184:      * @return json 返回包含二维码链接的JSON对象，如果生成失败则返回错误信息。
185:      */
186:     public function qrcode($id)
187:     {
188:         // 将ID转换为整数类型，确保数据类型的一致性和安全性
189:         $id = (int)$id;
190: 
191:         // 获取请求中的类型参数，以及默认的产品类型参数
192:         $param = $this->request->params(['type', ['product_type', 0]]);
193: 
194:         // 将产品类型参数转换为整数类型
195:         $param['product_type'] = (int)$param['product_type'];
196: 
197:         // 检查ID和产品类型是否有效，如果无效则返回错误信息
198:         if (!$id || !$product = $this->repository->existsProduct($id, $param['product_type']))
199:             return app('json')->fail('商品不存在');
200: 
201:         // 根据请求中的类型参数决定生成哪种类型的二维码
202:         if ($param['type'] == 'routine') {
203:             // 生成小程序商品二维码
