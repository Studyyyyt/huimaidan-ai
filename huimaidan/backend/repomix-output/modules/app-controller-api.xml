 55: 
 56:     /**
 57:      * 在确认订单前进行购物车检查
 58:      * 该方法主要用于在用户提交订单前，验证购物车中的商品是否有效，以及处理相关的优惠券和积分使用等逻辑。
 59:      *
 60:      * @param StoreCartRepository $cartRepository 购物车仓库对象，用于操作购物车数据。
 61:      *
 62:      * @return json 返回一个包含订单信息的JSON对象，如果数据无效，则返回错误信息。
 63:      */
 64:     public function beforCheck(StoreCartRepository $cartRepository)
 65:     {
 66:         // 获取请求中的购物车ID、收货地址ID、是否使用积分以及优惠券ID和代金券ID
 67:         $cartId = (array)$this->request->param('cart_id', []);
 68:         $addressId = (int)$this->request->param('address_id');
 69:         $useIntegral = (bool)$this->request->param('use_integral', true);
 70:         $params['couponIds'] = (array)$this->request->param('use_coupon', []);
 71:         $params['takes'] = (array)$this->request->param('takes', []);
 72: 
 73:         // 获取当前请求的用户信息
 74:         $user = $this->request->userInfo();
 75: 
 76:         // 验证购物车ID的数量是否有效，并检查购物车ID是否与用户ID匹配
 77:         if (!($count = count($cartId)) || $count != count($cartRepository->validIntersection($cartId, $user->uid)))
 78:             return app('json')->fail('数据无效');
 79: 
 80:         // 调用订单创建仓库的check方法，检查订单是否可以创建，并返回订单信息
 81:         $orderInfo = app()->make(PointsOrderCreateRepository::class)->check($user, $cartId, $addressId, $useIntegral, $params);
 82: 
 83:         // 返回订单信息的JSON对象
 84:         return app('json')->success($orderInfo);
 85:     }
 86: 
 87:     /**
 88:      * 创建订单
 89:      *
 90:      * 本函数负责根据用户购物车信息、收货地址、支付方式等创建订单。
 91:      * 它处理了PC端和移动端的不同支付方式，并对订单创建过程进行了事务处理，确保数据一致性。
 92:      *
 93:      * @param StoreCartRepository $cartRepository 购物车仓库，用于获取和验证购物车项。
 94:      * @return mixed 返回创建的订单信息，可能是一个支付成功的提示，或者是支付接口的跳转信息。
 95:      */
 96:     public function createOrder(StoreCartRepository $cartRepository)
 97:     {
 98:         // 获取购物车ID、收货地址ID、是否使用积分、标记和支付方式
 99:         $cartId = (array)$this->request->param('cart_id', []);
100:         $addressId = (int)$this->request->param('address_id');
101:         $useIntegral = (bool)$this->request->param('use_integral', true);
102:         $mark = $this->request->param('mark', '');
103:         $payType = $this->request->param('pay_type');
104: 
105:         // 判断是否为PC端支付，PC端默认支付方式为余额支付
106:         $isPc = $payType === 'pc';
107:         if ($isPc) $payType = 'balance';
108: 
109:         // 检查支付方式是否有效
110:         if (!in_array($payType, StoreOrderRepository::PAY_TYPE, true))
111:             return app('json')->fail('请选择正确的支付方式');
112: 
113:         // 获取用户ID
114:         $uid = $this->request->uid();
115: 
