 73:      * @param validate $validate 输入验证器，用于验证请求参数的合法性
 74:      * @return json 返回操作结果，如果失败则包含错误信息
 75:      */
 76:     public function create(validate $validate)
 77:     {
 78:         // 根据验证器验证参数，并获取验证后的数据
 79:         $data = $this->checkParams($validate);
 80: 
 81:         // 检查商品类型是否在允许的范围内
 82:         if(!in_array($data['product_type'],[0,1,2,3,4,20]))
 83:             return app('json')->fail('商品类型错误');
 84: 
 85:         // 检查购买数量是否大于0
 86:         if ($data['cart_num'] <= 0)
 87:             return app('json')->fail('购买数量有误');
 88: 
 89:         // 获取当前用户信息
 90:         $user = $this->request->userInfo();
 91: 
 92:         // 触发购物车添加前的事件，允许其他功能插件在此事件中进行干预
 93:         event('user.cart.before',compact('user','data'));
 94: 
 95:         // 初始化商品来源和来源ID
 96:         $data['source'] = $data['product_type'];
 97:         $data['source_id'] = $data['product_id'];
 98: 
 99:         // 根据商品类型执行不同的检查逻辑
100:         switch ($data['product_type'])
101:         {
102:             case 0:  // 普通商品
103:                 $result = app()->make(ProductRepository::class)->cartCheck($data,$this->request->userInfo());
104:                 // 处理商品来源，如果请求参数中包含有效的来源信息，则更新商品来源和来源ID
105:                 [$source, $sourceId, $pid] = explode(':', $this->request->param('source/d', '0'), 3) + ['', '', ''];
106:                 $data['source'] = (in_array($source, [0, 1]) && $pid == $data['product_id']) ? $source : 0;
107:                 if ($data['source'] > 0) $data['source_id'] = intval($sourceId);
108:                 break;
109:             case 1:  // 秒杀商品
110:                 $result = app()->make(ProductRepository::class)->cartSeckillCheck($data,$this->request->userInfo());
111:                 $data['source_id'] = $result['active_id'];
