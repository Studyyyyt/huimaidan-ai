115:             $activeIds = $storeSeckillActiveRepository->getSearch([])->where(['active_status'=>1])
116:             ->when(isset($storeSeckillTimeIds) && $storeSeckillTimeIds !== '',function($query)use($storeSeckillTimeIds){
117:                 $query->where(function($query) use ($storeSeckillTimeIds){
118:                     foreach ($storeSeckillTimeIds as $item) {
119:                         $query->whereOr(function($query) use ($item){
120:                             $query->whereFindInSet('seckill_time_ids', $item);
121:                         });
122:                     }
123:                 });
124:             })->column('seckill_active_id');
125:             $where['star'] = '';
