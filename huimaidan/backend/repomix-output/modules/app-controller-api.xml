120:                 break;
121:             case 4: // 拼团商品
122:                 $result = app()->make(ProductGroupRepository::class)->cartCheck($data,$this->request->userInfo());
123:                 $data['product_id'] = $result['product']['product_id'];
124:                 $data['source_id'] = $data['group_buying_id'];
125:                 break;
126:             case 20:// 积分商品
127:                 $result = app()->make(PointsProductRepository::class)->cartCheck($data,$this->request->userInfo());
128:                 $data['product_id'] = $result['product']['product_id'];
129:                 break;
130:         }
