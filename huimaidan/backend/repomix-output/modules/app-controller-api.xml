 14: namespace app\controller\api;
 15: 
 16: 
 17: use think\facade\View;
 18: use think\facade\Cache;
 19: use think\event\RouteLoaded;
 20: use crmeb\basic\BaseController;
 21: 
 22: class Route extends BaseController
 23: {
 24:     public $type = ['admin','merchant','api','openapi','manager','pc','service'];
 25:     public $type_name = [
 26:         'admin'     => '平台后台',
 27:         'merchant'  => '商户后台',
 28:         'api'       => '用户端',
 29:         'openapi'   => '开放接口',
 30:         'manager'   => '员工端',
 31:         'pc'        => 'PC端',
 32:         'service'   => '客服端'
 33:     ];
 34:     public function list()
 35:     {
 36:         return app('json')->success('请开发者注释当前行代码，才可查看路由列表');
 37: 
 38:         $type = $this->request->param('type','');
 39:         $type = $type == '' ? $this->type : [$type];
 40:         foreach ($type as $route) {
 41:             $data[$route] = $this->getRoute($route);
 42:         }
 43:         $table = '';
 44:         foreach ($data as $t => $list) {
 45:             foreach ($list as $item) {
 46:                 $table .= '<tr>';
 47:                 $table .= "<td> {$this->type_name[$t]} </td>";
 48:                 foreach ($item as $value) {
 49:                     $table .= "<td>" . htmlspecialchars($value, ENT_QUOTES, 'UTF-8') . "</td>";
 50:                 }
 51:                 $table .= '</tr>';
 52:             }
 53:         }
 54:         $html = $this->getHtml($table);
 55:         return  view::display($html);
 56:     }
 57: 
 58:     protected function getRoute($type)
 59:     {
 60:         $cache_key = $type.'_route_list';
 61:         $res = Cache::get($cache_key);
 62:         if ($res) return $res;
 63:         $this->app->route->clear();
 64:         $path = root_path(). 'route' . DIRECTORY_SEPARATOR . $type . DIRECTORY_SEPARATOR;
 65:         $file = root_path(). 'route' . DIRECTORY_SEPARATOR . $type . '.php';
 66:         if (is_file($file)) {
 67:             include $file;
 68:         }
 69:         if (is_dir($path)) {
 70:             $dir = scandir($path);
 71:             foreach ($dir as $file)  {
 72:                 if ($file == '.' || $file == '..') {
 73:                     continue;
 74:                 }
 75:                 include $path.$file;
 76:             }
 77:         }
 78:         $this->app->event->trigger(RouteLoaded::class);
 79:         $res = $this->routeList();
 80:         Cache::set($cache_key, $res, 60);
 81:         return $res;
 82:     }
 83: 
 84:     protected function reloadRoute()
 85:     {
 86:         $this->app->route->clear();
 87:         $path = root_path(). 'route' . DIRECTORY_SEPARATOR;
 88:         $dir = scandir($path);
 89:         foreach ($dir as $file) {
 90:             if ($file == '.' || $file == '..') {
 91:                 continue;
 92:             }
 93:             if (is_file($path.$file)) {
 94:                 include $path.$file;
 95:             }
 96:         }
 97:         $this->app->event->trigger(RouteLoaded::class);
 98:     }
 99: 
100:     protected function routeList()
101:     {
102:         $routeList = $this->app->route->getRuleList();
103:         $rows      = [];
104:         foreach ($routeList as $item) {
105:             $item['route'] = $item['route'] instanceof \Closure ? '<Closure>' : $item['route'];
106:             $row = [
107:                 $item['rule'],
108:                 ($item['option']['prefix'] ?? '').$item['route'],
109:                 $item['method'], $item['name'],
110:                 $item['option']['_alias'] ?? ''
111:             ];
112:             $rows[] = $row;
113:         }
114:         $this->reloadRoute();
115:         return $rows;
116:     }
117: 
118:     protected function getHtml($content)
119:     {
120:         $html = <<<HTML
121: <!doctype html>
122: <html class="x-admin-sm">
123:     <head>
124:         <meta charset="UTF-8">
125:         <title>路由列表</title>
126:         <meta name="renderer" content="webkit|ie-comp|ie-stand">
127:         <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
128:         <meta name="viewport" content="width=device-width,user-scalable=yes, minimum-scale=0.4, initial-scale=0.8,target-densitydpi=low-dpi" />
129:         <meta http-equiv="Cache-Control" content="no-siteapp" />
130:     </head>
131:     <body class="index">
132:         <table border="1" width="100%" height="200" align="left" cellpadding="10" cellspacing="0">
133:           <tr><th>所属端</th><th>路由</th><th>方法位置</th><th>请求方式</th><th>名称</th><th>方法注释</th></tr>
134:             $content
135:         </table>
136:     </body>
137: </html>
138: HTML;
139:         return $html;
140:     }
141: }
