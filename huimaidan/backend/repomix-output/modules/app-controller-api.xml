224:      * @date 2024/7/8
225:      */
226:     public function payPrice($merId, StoreOrderRepository $repository)
227:     {
228:         list($start, $stop, $month) = $this->request->params([
229:             ['start', strtotime(date('Y-m'))],
230:             ['stop', time()],
231:             'month'
232:         ], true);
233: 
234:         if ($month) {
235:             $start = date('Y/m/d', strtotime(getStartModelTime('month')));
236:             $stop = date('Y/m/d H:i:s', strtotime('+ 1day'));
237:             $front = date('Y/m/d', strtotime('first Day of this month', strtotime('-1 day', strtotime('first Day of this month'))));
238:             $end = date('Y/m/d H:i:s', strtotime($start . ' -1 second'));
239:         } else {
240:             if ($start == $stop) return app('json')->fail('参数有误');
241:             if ($start > $stop) {
242:                 $middle = $stop;
243:                 $stop = $start;
244:                 $start = $middle;
245:             }
246:             $space = bcsub($stop, $start, 0);//间隔时间段
247:             $front = bcsub($start, $space, 0);//第一个时间段
248: 
249:             $front = date('Y/m/d H:i:s', $front);
250:             $start = date('Y/m/d H:i:s', $start);
251:             $stop = date('Y/m/d H:i:s', $stop);
252:             $end = date('Y/m/d H:i:s', strtotime($start . ' -1 second'));
253:         }
254:         $frontPrice = $repository->dateOrderPrice($front . '-' . $end, $merId);
255:         $afterPrice = $repository->dateOrderPrice($start . '-' . date('Y/m/d H:i:s', strtotime($stop . '-1 second')), $merId);
256:         $chartInfo = $repository->chartTimePrice($start, date('Y/m/d H:i:s', strtotime($stop . '-1 second')), $merId);
257:         $data['chart'] = $chartInfo;//营业额图表数据
258:         $data['time'] = $afterPrice;//时间区间营业额
259:         $increase = (float)bcsub((string)$afterPrice, (string)$frontPrice, 2); //同比上个时间区间增长营业额
260:         $growthRate = abs($increase);
261:         if ($growthRate == 0) $data['growth_rate'] = 0;
262:         else if ($frontPrice == 0) $data['growth_rate'] = bcmul($growthRate, 100, 0);
263:         else $data['growth_rate'] = (int)bcmul((string)bcdiv((string)$growthRate, (string)$frontPrice, 2), '100', 0);//时间区间增长率
264:         $data['increase_time'] = abs($increase); //同比上个时间区间增长营业额
265:         $data['increase_time_status'] = $increase >= 0 ? 1 : 2; //同比上个时间区间增长营业额增长 1 减少 2
266: 
267:         return app('json')->success($data);
268:     }
