143: 
144:             usort($list, function($a, $b) {
145:                 return $a['skill_status'] < $b['skill_status'];
146:             });
147: 
148:             return $list;
149:         });
150: 
151:         $list = getThumbWaterImage($data, ['image'], 'mid');
