 14: namespace app\controller\api\store\order;
 15: 
 16: 
 17: use think\exception\ValidateException;
 18: use app\common\repositories\store\order\StoreOrderRepository;
 19: use crmeb\basic\BaseController;
 20: use think\App;
 21: 
 22: class StoreOrderVerify extends BaseController
 23: {
 24:     protected $merId;
 25: 
 26:     protected $user;
 27: 
 28:     protected $service;
 29: 
 30:     public function __construct(App $app)
 31:     {
 32:         parent::__construct($app);
 33:     }
 34: 
 35:     /**
 36:      * 根据订单ID查询订单详情
 37:      *
 38:      * 本函数用于通过提供的订单ID和商家ID来查询特定订单的详细信息。
 39:      * 它首先尝试根据ID获取订单，如果订单不存在，则返回错误信息。
 40:      * 如果订单存在但不属于请求的商家，则同样返回错误信息。
 41:      * 如果订单存在且属于请求的商家，则成功返回订单详情。
 42:      *
 43:      * @param int $merId 商家ID，用于权限检查，确定请求的商家是否有权查看该订单。
 44:      * @param int $id 订单ID，用于查询特定的订单。
 45:      * @param StoreOrderRepository $repository 订单仓库对象，用于执行订单查询操作。
 46:      * @return json 返回订单详情的JSON响应，如果订单不存在或无权查看，则返回错误的JSON响应。
 47:      */
 48:     public function detail(int $merId, $id, StoreOrderRepository $repository)
 49:     {
 50:         $this->merId = $merId;
 51:         // 根据订单ID查询订单详情
 52:         $order = $repository->codeByDetail($id);
 53: 
 54:         // 检查订单是否存在，如果不存在则返回错误信息
 55:         if (!$order) return app('json')->fail('订单不存在');
 56:         if ($order['is_virtual'] == 4) {
 57:             $auth = $this->checkStaffAuth($order);
 58:             if (!$auth) $this->checkServerAuth($order);
 59:         } else {
 60:             $auth = $this->checkServerAuth($order);
 61:         }
 62:         // 检查当前商家是否有权查看该订单，如果订单商家ID与请求的商家ID不匹配，则返回错误信息
 63:         if (!$auth)
 64:             return app('json')->fail('没有权限查询该订单');
 65: 
 66:         // 返回订单详情的成功响应
 67:         return app('json')->success($order);
 68:     }
 69: 
 70:     public function checkStaffAuth($order)
 71:     {
 72:         if ($this->request->isStaffs()){
 73:             if (!in_array($order->mer_id,$this->request->staffsMerIds())) {
 74:                 return false;
 75:             }
 76:             return true;
 77:         }
 78:         return false;
 79:     }
 80: 
 81:     public function checkServerAuth($order)
 82:     {
 83:         if ($this->request->isServer()){
 84:             if ($order->mer_id !== $this->merId) {
 85:                 return false;
 86:             }
 87:             return true;
 88:         }
 89:         return false;
 90:     }
 91: 
 92:     /**
 93:      * 核验订单
 94:      *
 95:      * 本函数用于验证商家订单的合法性并进行核销操作。通过接收商家ID和订单ID，结合请求中的验证数据，
 96:      * 调用存储层的相应方法来执行订单核销流程。此过程对于确保订单的准确性和维护业务正常运行至关重要。
 97:      *
 98:      * @param int $merId 商家ID，用于识别订单所属的商家
 99:      * @param string $id 订单ID，用于唯一标识待核销的订单
100:      * @param StoreOrderRepository $repository 订单存储层的接口，用于执行实际的订单核销操作
101:      * @return \think\Response 返回一个表示核销成功的结果对象
102:      */
103:     public function verify(int $merId, $id, StoreOrderRepository $repository)
104:     {
105:         $this->merId = $merId;
106:         // 从请求中获取核销数据和验证码
107:         $data = $this->request->params(['data','verify_code']);
108:         // 根据订单ID、商家ID、验证码和订单类型查询订单，并连带查询订单产品信息
109:         $order = $repository->getWhere(['order_id' => $id, 'mer_id' => $merId, 'verify_code' => $data['verify_code']], '*', ['orderProduct']);
110:         // 如果订单不存在，则抛出验证异常
111:         if (!$order)  return app('json')->fail('[1]订单不存在');
112:         // 如果订单未支付，则抛出验证异常
113:         if (!$order->paid)  return app('json')->fail('订单未支付');
114:         // 如果订单已全部核销，则抛出验证异常
115: 
116:         if ($order['status'] && $order['is_virtual'] !== 4 )  return app('json')->fail('[1]订单已全部核销，请勿重复操作');
117: 
118:         if ($order['is_virtual'] == 4) {
119:             $auth = $this->checkStaffAuth($order);
120:             $staffs_id = $this->request->staffsList()[$order->mer_id]['staffs_id'];
121:             if (!$auth){
122:                 $this->checkServerAuth($order);
123:                 $service_id = $this->request->serviceInfo()->service_id;
124:             }
125:         } else {
126:             $auth = $this->checkServerAuth($order);
127:             $service_id = $this->request->serviceInfo()->service_id;
128:         }
129:         if (!$auth) app('json')->fail('没有权限操作');
130:         if ($staffs_id ?? false)
131:             $repository->reservationVerify($id, $order->mer_id, 0,$staffs_id);
132:         if ($service_id ?? false)
133:             $repository->verifyOrder($order, $data,$service_id);
134:         // 返回表示核销成功的结果
135:         return app('json')->success('订单核销成功');
136:     }
137: }
