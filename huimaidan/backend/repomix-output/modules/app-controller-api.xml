 82:      * @param StoreCouponProductRepository $couponProductRepository 优惠券产品仓库接口，用于查询产品和优惠券的关系
 83:      * @return \think\response\Json 返回一个JSON对象，包含有效的优惠券信息或空数组
 84:      */
 85:     public function coupon(StoreCouponRepository $repository, StoreCouponProductRepository $couponProductRepository)
 86:     {
 87:         // 从请求中获取优惠券ID的字符串，然后过滤掉空值，得到一个数组
 88:         $ids = array_filter(explode(',', $this->request->param('ids/s')));
 89: 
 90:         // 如果获取的优惠券ID数组为空，则直接返回空的JSON成功响应
 91:         if (!count($ids))
 92:             return app('json')->success([]);
 93: 
 94:         // 根据优惠券ID数组，查询这些优惠券所关联的产品ID
 95:         $productCouponIds = $couponProductRepository->productByCouponId($ids);
 96: 
 97:         // 如果查询到关联产品ID，就进一步查询这些优惠券是否有效，并根据用户ID过滤，最后转换为数组
 98:         // 如果没有查询到关联产品ID，则直接返回空数组
 99:         $productCoupon = count($productCouponIds) ? $repository->validProductCoupon($productCouponIds, $this->uid)->toArray() : [];
100: 
101:         // 返回包含有效优惠券信息的JSON成功响应
102:         return app('json')->success($productCoupon);
103:     }
104: 
105:     /**
106:      * 获取商家优惠券信息
107:      *
108:      * 本函数用于根据商家ID和用户ID，获取指定商家的优惠券信息。如果请求参数中包含'all'参数，
109:      * 则表示获取所有优惠券，否则只获取可使用的优惠券。
110:      *
111:      * @param int $id 商家ID
112:      * @param StoreCouponRepository $repository 优惠券仓库对象，用于查询优惠券信息
113:      * @return json 返回包含优惠券信息的JSON对象，如果成功，则包含优惠券详情；如果失败，则包含错误信息。
114:      */
115:     public function merCoupon($id, StoreCouponRepository $repository)
116:     {
117:         // 获取请求参数'all'的值，用于判断是否查询所有优惠券
118:         $all = (int)$this->request->param('all');
119: 
120:         // 根据商家ID、用户ID和查询所有优惠券的标志，查询有效的商家优惠券信息
121:         // 如果'all'为1，则查询所有优惠券，否则只查询可使用的优惠券
122:         $coupon = $repository->validMerCoupon($id, $this->uid, $all === 1 ? null : 0)->toArray();
123: 
124:         // 返回查询结果，使用JSON格式响应
125:         return app('json')->success($coupon);
126:     }
127: 
128:     /**
129:      * 用户领取优惠券功能
130:      *
131:      * 此方法用于处理用户领取指定优惠券的操作。它首先检查优惠券是否存在，
132:      * 如果存在，则将该优惠券标记为被当前用户领取。如果优惠券不存在，
133:      * 则向用户返回错误信息；如果领取成功，则返回成功信息。
134:      *
135:      * @param int $id 优惠券ID
136:      * @param StoreCouponRepository $repository 优惠券仓库对象，用于操作优惠券数据
137:      * @return mixed 返回JSON格式的响应，包含成功或失败的信息
138:      */
139:     public function receiveCoupon($id, StoreCouponRepository $repository)
140:     {
141:         // 检查优惠券是否存在
142:         if (!$repository->exists($id)) {
143:             // 如果优惠券不存在，返回失败信息
144:             return app('json')->fail('优惠券不存在');
145:         }
146: 
147:         // 标记优惠券为被当前用户领取
148:         $repository->receiveCoupon($id, $this->uid);
149: 
150:         // 领取成功，返回成功信息
151:         return app('json')->success('领取成功');
152:     }
153: 
154:     /**
155:      * 可领取的优惠券列表
156:      * @author Qinii
157:      * @day 3/14/22
158:      */
159:     public function getList(StoreCouponRepository $couponRepository)
160:     {
161:         $where = $this->request->params(['type','mer_id', 'product','region_id','is_pc',['send_type',0]]);
162:         [$page, $limit] = $this->getPage();
163:         $data = $couponRepository->apiList($where, $page, $limit, $this->uid);
164:         return app('json')->success($data);
165:     }
166: 
167:     /**
168:      *  新人注册赠送优惠券
169:      * @param StoreCouponRepository $couponRepository
170:      * @return \think\response\Json
171:      * @author Qinii
172:      */
173:     public function newPeople(StoreCouponRepository $couponRepository)
174:     {
175:         $coupons = $couponRepository->newPeopleCoupon();
176:         foreach ($coupons as $coupon){
177:             if($coupon['coupon_type']){
178:                 $coupon['use_end_time'] = explode(' ', $coupon['use_end_time'])[0] ?? '';
179:                 $coupon['use_start_time'] = explode(' ', $coupon['use_start_time'])[0] ?? '';
180:             }else{
181:                 $coupon['use_start_time'] = date('Y-m-d');
182:                 $coupon['use_end_time'] = date('Y-m-d', strtotime('+ ' . $coupon['coupon_time'] . ' day'));
183:             }
184:             if($coupon['use_end_time']){
185:                 $coupon['use_end_time'] = date('Y.m.d',strtotime($coupon['use_end_time']));
186:             }
187:             if($coupon['use_start_time']){
188:                 $coupon['use_start_time'] = date('Y.m.d',strtotime($coupon['use_start_time']));
189:             }
190:         }
191:         $data = systemConfig(['newcomer_status','register_money_status','register_integral_status', 'register_give_integral','register_give_money','register_popup_pic','register_popup_url']);
192:         $data['coupon'] = $coupons;
193:         return app('json')->success($data);
194:     }
195: }
