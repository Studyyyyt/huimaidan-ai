 91:     public function seckill(ProductRepository $productRepository, StoreSeckillTimeRepository $storeSeckillTimeRepository)
 92:     {
 93:         $currentHour = date('H', time());
 94:         $storeSeckillTimeInfo = $storeSeckillTimeRepository->getSearch([])->where([
 95:             // ['start_time','<=',$currentHour],
 96:             ['status','=',1],
 97:             ['end_time','>',$currentHour],
 98:         ])->order('end_time','desc')->select();
 99:         if(empty($storeSeckillTimeInfo)){
100:             return app('json')->success(['list'=>[]]);
101:         }
102:         $stopTime =  date('Y-m-d',time()).' '.($storeSeckillTimeInfo[0]['end_time'].':00:00');
103:         $ttl = (strtotime($stopTime) - time() - 30) > 0 ?: 5;
104:         $data = $this->cache(function() use($productRepository, $storeSeckillTimeInfo, $stopTime) {
105:             $mer_id = $this->request->param('mer_id', '');
106:             $regionId = $this->request->param('region_id', 0);
