288:             $front = date('Y/m/d', strtotime('first Day of this month', strtotime('-1 day', strtotime('first Day of this month'))));
289:             $end = date('Y/m/d H:i:s', strtotime($start . ' -1 second'));
290:         } else {
291:             if ($start == $stop) return app('json')->fail('参数有误');
292:             if ($start > $stop) {
293:                 $middle = $stop;
294:                 $stop = $start;
295:                 $start = $middle;
296:             }
297:             $space = bcsub($stop, $start, 0);//间隔时间段
298:             $front = bcsub($start, $space, 0);//第一个时间段
299: 
300:             $front = date('Y/m/d H:i:s', $front);
301:             $start = date('Y/m/d H:i:s', $start);
302:             $stop = date('Y/m/d H:i:s', $stop);
303:             $end = date('Y/m/d H:i:s', strtotime($start . ' -1 second'));
