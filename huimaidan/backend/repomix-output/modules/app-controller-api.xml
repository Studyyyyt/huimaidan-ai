135: 
136:             $list = $query->whereIn('active_id',$activeIds)->limit($limit)->setOption('field', [])->field($field)->select()
137:                 ->each(function ($item) use ($storeOrderRepository,$stopTime) {
138:                     $item['stock'] = app()->make(ProductRepository::class)->getSeckillAttrValue($item['attrValue'], $item['old_product_id'])['stock'];
139:                     $item['sales'] = $storeOrderRepository->seckillOrderCounut($item['active_id'],$item['product_id']);
140:                     $item['stop'] = strtotime($stopTime);
