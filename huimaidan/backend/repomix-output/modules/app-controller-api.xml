554:     function decrypt(string $encryptedData, string $key)
555:     {
556:         $key = substr($key, 0, 32);
557:         $decodedData = base64_decode($encryptedData);
558:         $iv = substr($decodedData, 0, 16);
559:         $encrypted = substr($decodedData, 16);
560:         $decrypted = openssl_decrypt($encrypted, 'AES-256-CBC', $key, OPENSSL_RAW_DATA, $iv);
561:         return json_decode($decrypted, true);
562:     }
