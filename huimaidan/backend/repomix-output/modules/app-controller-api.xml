23: class PresellOrder extends BaseController
24: {
25:     protected $repository;
26: 
27:     public function __construct(App $app, PresellOrderRepository $repository)
28:     {
29:         parent::__construct($app);
30:         $this->repository = $repository;
31:     }
32: 
33:     /**
34:      * 处理支付请求
35:      *
36:      * 本函数旨在处理用户的支付操作，包括校验支付方式的有效性、检查订单状态和支付状态，
37:      * 以及根据不同的支付方式引导用户完成支付。如果订单无需支付或已支付，则直接标记支付成功。
38:      *
39:      * @param int $id 订单ID
40:      * @return mixed 返回支付结果，可能是支付成功的提示，也可能是支付网关的跳转指令
41:      */
42:     public function pay($id)
43:     {
44:         // 获取用户选择的支付方式
45:         $type = $this->request->param('type/s');
46: 
47:         // 校验支付方式是否有效
48:         if (!in_array($type, StoreOrderRepository::PAY_TYPE))
49:             return app('json')->fail('请选择正确的支付方式');
50: 
51:         // 根据用户ID和订单ID获取订单信息
52:         $order = $this->repository->userOrder($this->request->uid(), intval($id));
53: 
54:         // 检查订单是否存在
55:         if (!$order)
56:             throw new ValidateException('尾款订单不存在');
57: 
58:         // 检查订单是否已支付
59:         if ($order->paid)
60:             throw new ValidateException('已支付');
61: 
62:         // 检查订单是否失效
63:         if (!$order->status)
64:             throw new ValidateException('尾款订单以失效');
65: 
66:         // 检查支付时间是否有效
67:         if (strtotime($order->final_start_time) > time())
68:             throw new ValidateException('未到尾款支付时间');
69:         if (strtotime($order->final_end_time) < time())
70:             throw new ValidateException('已过尾款支付时间');
71: 
72:         // 更新订单支付方式
73:         $order->pay_type = array_search($type, StoreOrderRepository::PAY_TYPE);
74:         if ($type == 'offline')  {
75:             if (!systemConfig('offline_switch')) {
76:                 return app('json')->fail('未开启线下支付功能');
77:             }
78:             if (!(($order->merchant['offline_switch']) ?? '')) {
79:                 return app('json')->fail('该店铺未开启线下支付');
80:             }
81:             return app('json')->status('success', '线下支付，请告知收银员', ['order_id' => $order->presell_order_id]);
82:         }
83:         $order->save();
84:         // 如果订单金额为0，直接标记支付成功并返回
85:         if ($order['pay_price'] == 0) {
86:             $this->repository->paySuccess($order);
87:             return app('json')->status('success', '支付成功', ['order_id' => $order['presell_order_id']]);
88:         }
89:         // 尝试执行支付操作，可能会根据支付方式跳转到不同的支付网关
90:         try {
91:             return $this->repository->pay($type, $this->request->userInfo(), $order, $this->request->param('return_url'), $this->request->isApp());
92:         } catch (\Exception $e) {
93:             // 支付过程中发生异常，返回错误信息
94:             return app('json')->status('error', $e->getMessage(), ['order_id' => $order->presell_order_id]);
95:         }
96:     }
97: }
