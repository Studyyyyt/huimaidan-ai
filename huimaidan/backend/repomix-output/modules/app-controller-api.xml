 40:      * @author wuhaotian
 41:      * @email 442384644@qq.com
 42:      * @date 2024/7/10
 43:      */
 44:     public function brokerage(UserExtractRepository $userExtractRepository)
 45:     {
 46:         $brokerage = (float)$this->request->param('brokerage');
 47:         if ($brokerage <= 0)
 48:             return app('json')->fail('请输入正确的充值金额!');
 49:         $user = $this->request->userInfo();
 50:         //if ($user->brokerage_price < $brokerage)
 51:         //    return app('json')->fail('剩余可用佣金不足' . $brokerage);
 52:         //$config = systemConfig(['recharge_switch', 'balance_func_status']);
 53:         //if (!$config['recharge_switch'] || !$config['balance_func_status'])
 54:         //    return app('json')->fail('余额充值功能已关闭');
 55:         //$userRepository->switchBrokerage($user, $brokerage);
 56:         $data = [
 57:             'extract_type' => $userExtractRepository::EXTRACT_TYPE_YUE,
 58:             'extract_price'=> $brokerage,
 59:         ];
 60:         $userExtractRepository->create($user,$data);
 61:         return app('json')->success('转换成功');
 62:     }
 63: 
 64:     /**
 65:      * 用户充值
 66:      * @param GroupDataRepository $groupDataRepository
 67:      * @return \think\response\Json
 68:      * @throws \think\db\exception\DataNotFoundException
 69:      * @throws \think\db\exception\DbException
 70:      * @throws \think\db\exception\ModelNotFoundException
 71:      * @author wuhaotian
 72:      * @email 442384644@qq.com
 73:      * @date 2024/7/10
 74:      */
 75:     public function recharge(GroupDataRepository $groupDataRepository)
 76:     {
 77:         [$type, $price, $rechargeId, $return_url] = $this->request->params(['type', 'price', 'recharge_id', 'return_url'], true);
 78:         if (!in_array($type, ['weixin', 'routine', 'h5', 'alipay', 'alipayQr', 'weixinQr']))
 79:             return app('json')->fail('请选择正确的支付方式!');
 80:         if($price > 1000000){
 81:             return app('json')->fail('充值金额超出最大限制');
 82:         }
 83:         $app = $this->request->isApp();
 84:         $user = $this->request->userInfo();
 85:         $wechatUserId = $user['wechat_user_id'];
 86:         if (!$wechatUserId && in_array($type, [$this->repository::TYPE_ROUTINE, $this->repository::TYPE_WECHAT]) && !$app)
 87:             return app('json')->fail('请关联微信' . ($type == 'weixin' ? '公众号' : '小程序') . '!');
 88:         $config = systemConfig(['store_user_min_recharge', 'recharge_switch', 'balance_func_status']);
 89:         if (!$config['recharge_switch'] || !$config['balance_func_status'])
 90:             return app('json')->fail('余额充值功能已关闭');
 91:         if ($rechargeId) {
 92:             if (!intval($rechargeId))
 93:                 return app('json')->fail('请选择充值金额!');
 94:             $rule = $groupDataRepository->merGet(intval($rechargeId), 0);
 95:             if (!$rule || !isset($rule['price']) || !isset($rule['give']))
 96:                 return app('json')->fail('您选择的充值方式已下架!');
 97:             $give = floatval($rule['give']);
 98:             $price = floatval($rule['price']);
 99:             if ($price <= 0)
100:                 return app('json')->fail('请选择正确的充值金额!');
101:         } else {
102:             $price = floatval($price);
103:             if ($price <= 0)
104:                 return app('json')->fail('请输入正确的充值金额!');
105:             if ($price < $config['store_user_min_recharge'])
106:                 return app('json')->fail('最低充值' . floatval($config['store_user_min_recharge']));
107:             $give = 0;
108:         }
109:         $recharge = $this->repository->create($this->request->uid(), $price, $give, $type);
110:         return app('json')->success($this->repository->pay($type, $user, $recharge, $return_url, $app));
111:     }
112: }
