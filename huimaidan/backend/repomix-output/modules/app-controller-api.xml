396:      */
397:     public function priceRule($id)
398:     {
399:         // 生成缓存的唯一标识
400:         $cache_unique = md5('get_product_rule_' . $id);
401:         // 尝试从缓存中获取规则数据
402:         $res = Cache::get($cache_unique);
403:         // 如果缓存中没有规则数据
404:         if (!$res) {
405:             // 查询分类路径
406:             $path = app()->make(StoreCategoryRepository::class)->query(['store_category_id' => $id, 'mer_id' => 0])->value('path');
407:             // 如果路径存在且不为根路径
408:             if ($path && $path !== '/') {
409:                 // 将分类路径和当前分类ID分解为数组
410:                 $ids = explode('/', trim($path, '/'));
411:                 // 将当前分类ID添加到数组中
412:                 $ids[] = $id;
413:             } else {
414:                 // 如果路径不存在或为根路径，直接使用当前分类ID
415:                 $ids[] = $id;
416:             }
417:             // 查询有效的价格规则，按排序降序，规则ID降序
418:             $rule = app()->make(PriceRuleRepository::class)->search(['cate_id' => $ids, 'is_show' => 1])
419:                 ->order('sort DESC,rule_id DESC')->find();
420:             // 如果查询到规则
421:             if ($rule) {
422:                 // 将规则数据转为JSON字符串并缓存，缓存有效期为1小时
423:                 $res = json_encode($rule->toArray());
424:                 Cache::tag('get_product')->set($cache_unique, $res, 3600);
425:             }
426:         }
427:         // 如果有缓存数据或查询到规则
428:         if ($res) {
429:             // 返回成功的JSON响应，包含规则数据
430:             return app('json')->success(json_decode($res, true));
431:         }
432:         // 如果没有缓存数据且查询不到规则，返回失败的JSON响应
433:         return app('json')->fail('规则不存在');
434:     }
