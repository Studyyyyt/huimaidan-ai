 45:      * 本函数旨在根据前端请求中的参数，以及指定的产品ID，查询并返回特定类型的产品列表。
 46:      * 具体实现包括获取请求中的分页信息、筛选条件，然后调用仓库层的方法获取数据，并以JSON格式返回。
 47:      *
 48:      * @param int $id 产品ID，用于限定查询的产品范围
 49:      * @return json 返回查询结果的JSON对象，包含产品列表信息
 50:      */
 51:     public function lst($id)
 52:     {
 53:         // 获取请求中的分页信息
 54:         [$page, $limit] = $this->getPage();
 55: 
 56:         // 构建查询条件，包括产品类型和产品ID
 57:         $where['type'] = $this->request->param('type/d');
 58:         $where['product_id'] = $id;
 59: 
 60:         // 调用仓库层的getApiList方法获取数据，并返回成功响应的JSON对象
 61:         return app('json')->success($this->repository->getApiList($where, $page, $limit));
 62:     }
 63: 
 64:     /**
 65:      * 根据订单产品ID获取订单产品详情
 66:      *
 67:      * 本函数旨在通过提供的订单产品ID，检索特定用户的订单产品详情。
 68:      * 它首先验证订单是否存在且未被评价，然后返回订单产品的详细信息。
 69:      * 如果订单不存在或已评价，则返回相应的错误信息。
 70:      *
 71:      * @param int $id 订单产品ID
 72:      * @param StoreOrderProductRepository $orderProductRepository 订单产品仓库对象，用于订单产品的数据操作
 73:      * @return mixed 返回订单产品的详细信息数组，如果订单不存在或已评价，则返回错误信息
 74:      */
 75:     public function product($id, StoreOrderProductRepository $orderProductRepository)
 76:     {
 77:         // 根据订单产品ID和用户ID获取订单产品信息
 78:         $orderProduct = $orderProductRepository->userOrderProduct((int)$id, $this->request->uid());
 79: 
 80:         // 验证订单产品是否存在及其关联的订单信息
 81:         if (!$orderProduct || !$orderProduct->orderInfo) {
 82:             // 如果订单产品不存在或没有关联的订单信息，则返回“订单不存在”的错误信息
 83:             return app('json')->fail('订单不存在');
 84:         }
 85: 
 86:         // 检查订单产品是否已评价
 87:         if ($orderProduct->is_reply) {
 88:             // 如果订单产品已评价，则返回“该商品已评价”的错误信息
 89:             return app('json')->fail('该商品已评价');
 90:         }
 91: 
 92:         // 如果订单产品存在且未被评价，则返回订单产品的详细信息
 93:         return app('json')->success($orderProduct->toArray());
 94:     }
 95: 
 96:     /**
 97:      * 回复商品评价
 98:      *
 99:      * 本函数用于处理用户对商品的评价回复。它从请求中获取评价相关数据，
100:      * 验证数据的合法性，然后将用户评价信息保存到数据库。
101:      *
102:      * @param int $id 订单产品ID，用于关联评价和具体的产品。
103:      * @param ProductReplyValidate $validate 评价验证器，用于数据验证。
104:      * @return json 返回一个表示操作成功或失败的JSON响应。
105:      */
106:     public function reply($id, ProductReplyValidate $validate)
107:     {
108:         // 从请求中获取评价相关参数
109:         $data = $this->request->params(['comment', 'product_score', 'service_score', 'postage_score', ['pics', []]]);
110: 
111:         // 使用验证器检查获取的数据是否合法
112:         $validate->check($data);
113: 
114:         // 获取当前请求的用户信息
115:         $user = $this->request->userInfo();
116: 
117:         // 将用户ID、订单产品ID、用户昵称和头像添加到评价数据中
118:         $data['uid'] = $this->request->uid();
119:         $data['order_product_id'] = (int)$id;
120:         $data['nickname'] = $user['nickname'];
121:         $data['avatar'] = $user['avatar'];
122: 
123:         // 将评价数据提交到仓库进行保存
124:         $this->repository->reply($data);
125: 
126:         // 返回一个表示操作成功的JSON响应
127:         return app('json')->success('评价成功');
128:     }
129: 
130: }
