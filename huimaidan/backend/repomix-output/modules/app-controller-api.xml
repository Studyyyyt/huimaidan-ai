 42:         if($params['type']){
 43:             $deliveryOrderwhere['service_ids'] = $this->request->deliveryIds();
 44:             $deliveryOrderwhere['mer_ids'] = $merIds;
 45:             $orderIds = app()->make(DeliveryOrderRepository::class)->getOrderIds($deliveryOrderwhere);
 46:             if(!$orderIds) {
 47:                 return app('json')->success(['count' => 0, 'list' => []]);
 48:             }
 49:             $where['order_ids'] = $orderIds;
 50:             if($params['status'] == 2) {
 51:                 $where['status'] = 11;
