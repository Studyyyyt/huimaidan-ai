160:      *  审核
161:      * @param $id
162:      * @return \think\response\Json
163:      * @author Qinii
164:      */
165:     public function switchStatus($id)
166:     {
167:         if(!$this->repository->getStatusExists($this->merId,$id))
168:             return app('json')->fail('信息或状态错误');
169:         $status = ($this->request->param('status') == 1) ? 1 : -1;
170:         event('refund.status',compact('id','status'));
171:         if($status == 1){
172:             $data = $this->request->params(['mer_delivery_user','mer_delivery_address','phone']);
173:             if ($data['phone'] && isPhone($data['phone']))
174:                 return app('json')->fail('请输入正确的手机号');
175:             $data['status'] = $status;
176:             $this->repository->agree($id,$data,$this->service_id);
177:         }else{
178:             $fail_message = $this->request->param('fail_message','');
179:             if($status == -1 && empty($fail_message))
180:                 return app('json')->fail('未通过必须填写');
181:             $data['status'] = $status;
182:             $data['fail_message'] = $fail_message;
183:             $this->repository->refuse($id,$data, $this->service_id);
184:         }
185:         return app('json')->success('审核成功');
186:     }
