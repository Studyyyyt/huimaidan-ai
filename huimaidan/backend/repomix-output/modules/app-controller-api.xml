195:     public function refundPrice($id)
196:     {
197:         if(!$this->repository->getRefundPriceExists($this->merId,$id)){
198:             return app('json')->fail('信息或状态错误');
199:         }
200:         $params = $this->request->params(['status','fail_message']);
201:         if (!$params['status']) {
202:             return app('json')->fail('请选择状态');
203:         }
204:         if ($params['status'] == -1 && empty($params['fail_message'])) {
205:             return app('json')->fail('拒绝原因必须填写');
206:         }
207:         $this->repository->adminRefund($id, $params, $this->service_id);
208:         return app('json')->success('审核成功');
209:     }
210: 
211:     /**
212:      *  备注
213:      * @param $id
214:      * @return \think\response\Json
215:      * @author Qinii
216:      */
217:     public function mark($id){
218:         if(!$this->repository->getExistsById($this->merId,$id))
219:             return app('json')->fail('数据不存在');
220:         $this->repository->update($id,['mer_mark' => $this->request->param('mer_mark','')]);
221: 
222:         return app('json')->success('备注成功');
223:     }
224: }
