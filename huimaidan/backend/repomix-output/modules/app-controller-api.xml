457:             throw new ValidateException('授权信息类型有误');
458:         $data = $auth['auth'];
459:         if ($auth['type'] === 'routine') {
460:             $code = $data['code'] ?? '';
461:             $userInfoCong = Cache::get('eb_api_code_' . $code);
462:             if (!$code && !$userInfoCong)
463:                 throw new ValidateException('授权失败,参数有误');
464:             $miniProgramService = MiniProgramService::create();
465:             if ($code && !$userInfoCong) {
466:                 try {
467:                     $userInfoCong = $miniProgramService->getUserInfo($code);
468:                     Cache::set('eb_api_code_' . $code, $userInfoCong, 86400);
469:                 } catch (Exception $e) {
470:                     throw new ValidateException('获取session_key失败，请检查您的配置！' . $e->getMessage());
471:                 }
472:             }
473: //            try {
474: //                //解密获取用户信息
475: //                $userInfo = $miniProgramService->encryptor($userInfoCong['session_key'], $data['iv'], $data['encryptedData']);
476: //            } catch (Exception $e) {
477: //                if ($e->getCode() == '-41003') throw new ValidateException('获取会话密匙失败'.$e->getMessage());
478: //                throw $e;
479: //            }
480:             $userInfo = [];
481: //            if (!$userInfo) throw new ValidateException('openid获取失败');
482:             if (!isset($userInfo['openId'])) $userInfo['openId'] = $userInfoCong['openid'] ?? '';
483:             $userInfo['unionId'] = $userInfoCong['unionid'] ?? $userInfo['unionId'] ?? '';
484:             if (!$userInfo['openId']) throw new ValidateException('openid获取失败');
485: 
486:             /** @var WechatUserRepository $make */
487:             $make = app()->make(WechatUserRepository::class);
488:             $user = $make->syncRoutineUser($userInfo['openId'], $userInfo, $createUser);
489:             if (!$user)
490:                 throw new ValidateException('授权失败');
491:             return $user;
492:         } else if ($auth['type'] === 'wechat') {
493:             $request = $this->request;
494:             $oauth = WechatService::create()->getApplication()->oauth;
495:             $oauth->setRequest(new Request($data, $data, [], [], [], $request->server(), $request->getContent()));
496:             try {
497:                 $wechatInfo = $oauth->user()->getOriginal();
498:             } catch (Exception $e) {
499:                 throw new ValidateException('授权失败[001]');
500:             }
501:             if (!isset($wechatInfo['nickname'])) {
502:                 throw new ValidateException('授权失败[002]');
503:             }
504:             /** @var WechatUserRepository $make */
505:             $make = app()->make(WechatUserRepository::class);
506: 
507:             $user = $make->syncUser($wechatInfo['openid'], $wechatInfo, false, $createUser);
508:             if (!$user)
509:                 throw new ValidateException('授权失败[003]');
510:             return $user;
511:         } else if ($auth['type'] === 'app_wechat') {
512:             $oauth = WechatService::create()->getApplication()->oauth;
513:             try {
514:                 $wechatInfo = $oauth->user(new AccessToken(['access_token' => $data['code'], 'openid' => $data['openid']]))->getOriginal();
515:             } catch (Exception $e) {
516:                 throw new ValidateException('授权失败[001]' . $e->getMessage());
517:             }
518:             $user = app()->make(WechatUserRepository::class)->syncAppUser($wechatInfo['unionid'], $wechatInfo, 'App', $createUser);
519:             if (!$user)
520:                 throw new ValidateException('授权失败');
521:             return $user;
522:         } else if ($auth['type'] === 'apple') {
523:             $identityToken = $data['userInfo']['identityToken'];
524:             $tks = explode('.', $identityToken);
525:             if (count($tks) != 3) {
526:                 throw new ValidateException('Wrong number of segments');
527:             }
528:             list($headb64, $bodyb64, $cryptob64) = $tks;
529:             if (null === ($payload = JWT::jsonDecode(JWT::urlsafeB64Decode($bodyb64)))) {
530:                 throw new ValidateException('Invalid header encoding');
531:             }
532:             if ($payload->sub != $data['openId']) {
533:                 throw new ValidateException('授权失败');
534:             }
535:             $user = app()->make(WechatUserRepository::class)->syncAppUser($data['openId'], [
536:                 'nickName' => (string)$data['nickname'] ?: '用户' . strtoupper(substr(md5(time()), 0, 12))
537:             ], 'App', $createUser);
538:             if (!$user)
539:                 throw new ValidateException('授权失败');
540:             return $user;
541:         }
542:     }
