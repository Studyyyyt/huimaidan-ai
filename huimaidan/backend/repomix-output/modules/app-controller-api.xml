 29:     public function __construct(App $app, repository $repository)
 30:     {
 31:         parent::__construct($app);
 32:         $this->repository = $repository;
 33:     }
 34: 
 35:     /**
 36:      * 获取热门列表并以特定格式返回
 37:      * 此方法主要用于从仓库中获取热门数据，并对其进行格式化处理，以便前端以特定的结构展示。
 38:      * @return \Illuminate\Http\JsonResponse 返回格式化后的热门列表数据
 39:      */
 40:     public function lst()
 41:     {
 42:         $prefix = env('QUEUE_NAME','merchant').'_categorylist';
 43:         $cachekey=$prefix.'_list';
 44:         $res = Cache::get($cachekey);
 45:         if ($res) {
 46:             $categorylist = json_decode($res, true);
 47:             $data= $categorylist;
 48:             return app('json')->success($data);
 49:         }
 50:         // 获取热门数据，参数0表示获取所有热门数据
 51:         $data = $this->repository->getHot(0);
 52:         // 获取列表数据，并指定参数0和1，用于特定的API数据格式化
 53:         $list = $this->repository->getApiFormatList(0,1);
 54:         // 初始化用于存储处理后数据的数组
 55:         $ret =[];
 56:         // 遍历列表数据，对其中的嵌套数据进行处理
 57:         foreach ($list as $key => $value) {
 58:             // 检查当前项是否包含子项
 59:             if (isset($value['children'])) {
 60:                 $level = [];
 61:                 // 对当前项的子项进行遍历
 62:                 foreach ($value['children'] as $child) {
 63:                     // 检查子项是否还包含子项，用于多级嵌套处理
 64:                     if (isset($child['children'])) {
 65:                         $level[] = $child;
 66:                     }
 67:                 }
 68:                 // 如果当前项的子项经过处理后不为空，则将处理后的子项添加到结果数组中
 69:                 if (isset($level) && !empty($level)) {
 70:                     $value['children'] = $level;
 71:                     $ret[] = $value;
 72:                 }
 73:             }
 74:         }
 75:         // 将处理后的数据合并到原始热门数据中，并返回
 76:         $data['list'] = $ret;
 77:         Cache::tag('categorylist')->set($cachekey, json_encode($data), 30);
 78:         return app('json')->success($data);
 79:     }
