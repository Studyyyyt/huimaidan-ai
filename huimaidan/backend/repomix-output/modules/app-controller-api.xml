 62:         $orderList = $order['list']->toArray();
 63:         foreach($orderList as $key => &$item) {
 64:             if((isset($item['take']['type']) && $item['take']['type'])) {
 65:                 unset($orderList[$key]);
 66:             }
 67: 
 68:             if(!merchantConfig($item['mer_id'], 'mer_delivery_order_status') && $params['type'] == 0 && $params['status'] == 0) {
 69:                 unset($orderList[$key]);
 70:             }
 71:         }
