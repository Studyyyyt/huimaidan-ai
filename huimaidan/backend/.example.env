APP_KEY = '#APP_KEY#'
APP_DEBUG = false
INSTALLED = true
QUEUE_NAME = default

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = '#DB_HOST#'
HOSTPORT = '#DB_PORT#'
USERNAME = '#DB_USER#'
PASSWORD = '#DB_PWD#'
DATABASE = '#DB_NAME#'
PREFIX = '#DB_PREFIX#'
CHARSET = utf8
DEBUG = true

[LANG]
default_lang = zh-cn

[REDIS]
REDIS_HOSTNAME = '#RB_HOST#'
PORT = '#RB_PORT#'
REDIS_PASSWORD = '#RB_PWD#'
SELECT = '#RB_SELECT#'

HUIMAIDAN_AI_ENABLED = true
HUIMAIDAN_AI_LLM_DRIVER = bailian
BAILIAN_APP_ID = '#BAILIAN_APP_ID#'
BAILIAN_API_KEY = '#BAILIAN_API_KEY#'
BAILIAN_API_URL = 'https://dashscope.aliyuncs.com/api/v1/apps/{app_id}/completion'
BAILIAN_WORKSPACE = ''
BAILIAN_TIMEOUT = 15
HUIMAIDAN_AI_LLM_RETRY_TIMES = 1
HUIMAIDAN_AI_LLM_RETRY_SLEEP_MS = 200
HUIMAIDAN_AI_LLM_FAIL_THRESHOLD = 3
HUIMAIDAN_AI_LLM_RECOVERY_SECONDS = 900

DEEPSEEK_API_KEY = ''
DEEPSEEK_API_URL = 'https://api.deepseek.com/chat/completions'
DEEPSEEK_MODEL = 'deepseek-chat'
DEEPSEEK_TIMEOUT = 15

CLAUDE_API_KEY = ''
CLAUDE_API_URL = 'https://api.anthropic.com/v1/messages'
CLAUDE_MODEL = 'claude-3-5-sonnet-latest'
CLAUDE_API_VERSION = '2023-06-01'
CLAUDE_TIMEOUT = 15
