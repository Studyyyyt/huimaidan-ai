VITE_APP_TITLE = '惠买单'
VITE_APP_PORT = 9000

VITE_UNI_APPID = '__UNI__D1E5001'
# 微信小程序 AppID，请替换为你在微信公众平台申请的 AppID
VITE_WX_APPID = '#VITE_WX_APPID#'

# h5部署网站的base，配置到 manifest.config.ts 里的 h5.router.base
# https://uniapp.dcloud.net.cn/collocation/manifest.html#h5-router
VITE_APP_PUBLIC_BASE=/

# 后台请求地址
VITE_SERVER_BASEURL = '#VITE_SERVER_BASEURL#'
# 备注：如果后台带统一前缀，则也要加到后面，eg: https://example.com/api

# 微信小程序请求地址。必须同步配置到微信公众平台 request 合法域名。
VITE_SERVER_BASEURL_WEIXIN_DEVELOP = '#VITE_SERVER_BASEURL_WEIXIN_DEVELOP#'
VITE_SERVER_BASEURL_WEIXIN_TRIAL = '#VITE_SERVER_BASEURL_WEIXIN_TRIAL#'
VITE_SERVER_BASEURL_WEIXIN_RELEASE = '#VITE_SERVER_BASEURL_WEIXIN_RELEASE#'

# h5是否需要配置代理
VITE_APP_PROXY_ENABLE = false
# 下面的不用修改，只要不跟你后台的统一前缀冲突就行。如果修改了，记得修改 nginx 里面的配置
VITE_APP_PROXY_PREFIX = '/fg-api'

# 第二个请求地址 (目前alova中可以使用)
VITE_SERVER_BASEURL_SECONDARY = '#VITE_SERVER_BASEURL_SECONDARY#'

# 认证模式，'single' | 'double' ==> 单token | 双token
VITE_AUTH_MODE = 'single'

# 原生插件资源复制开关，控制是否启用 copy-native-resources 插件
VITE_COPY_NATIVE_RES_ENABLE = false
